{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biomotion/baseline_bl1",
  "title": "Baseline snapshot (bl1)",
  "description": "선수 개인 baseline 메카닉 스냅샷 — axisSlices 연동 전 스키마 샘플",
  "type": "object",
  "required": ["version", "session_date", "established_at"],
  "properties": {
    "version": { "const": "bl1" },
    "player_id": { "type": ["string", "null"] },
    "player_name": { "type": "string" },
    "handedness": { "enum": ["R", "L"] },
    "session_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_session_id": { "type": ["string", "null"] },
    "established_at": { "type": "string", "format": "date-time" },
    "n_sessions_averaged": { "type": "integer", "minimum": 1 },
    "measured_kmh": { "type": "number" },
    "composite_cv": { "type": "number" },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "mech6_summary": {
      "type": "object",
      "additionalProperties": { "enum": ["미흡", "정상", "우수"] }
    },
    "provenance": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["manual_snapshot", "coach_pin", "rolling_median"]
        },
        "note": { "type": "string" }
      }
    }
  },
  "anyOf": [
    { "required": ["stages"] },
    { "required": ["mech6_summary"] }
  ]
}
