  single_leg_sq: { ko:'편측 스쿼트', en:'Single-Leg Squat', desc:'Lead knee 안정성 ↑, knee collapse 예방', cue:'무릎이 발끝 안쪽으로 무너지지 않게', sets:'3세트 × 12회 (양측)', freq:'주 3회' },
  walking_wu:    { ko:'워킹 와인드업', en:'Walking Wind-up', desc:'★ GRF Rear 약점 → 걸으면서 와인드업 → 던지기. 뒷다리 drive', cue:'걸음 → 다리 들기 → 던지기 흐름', sets:'3세트 × 8회', freq:'주 2-3회' },
  slide_step:    { ko:'슬라이드 스텝', en:'Slide Step', desc:'와인드업 없이 슬라이드 스텝. CoG 제동 + 체중이동', cue:'앞다리에 체중이 빠르게, 부드럽게', sets:'3세트 × 10회', freq:'주 3회' },
