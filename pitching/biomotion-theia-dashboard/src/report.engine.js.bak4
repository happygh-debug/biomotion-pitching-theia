const grade = s => s==null?'—':s>=115?'S':s>=100?'A':s>=90?'B':s>=80?'C':s>=70?'D':'F';
const scoreCls = s => s==null?'score-na':s>=100?'score-high':s>=80?'score-mid':'score-low';
// 이모지 제거 (프로 톤) — 라벨 앞 픽토그램/기타 이모지 strip
const _ne = s => (s==null ? s : String(s).replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2B00}-\u{2BFF}\u{FE0F}\u{1F1E6}-\u{1F1FF}]/gu,'').replace(/\s{2,}/g,' ').trim());

