var _focusKey=null;
function _bmFindMetric(key){ var P=(typeof DATA!=='undefined')?DATA.phases:null, r=null; if(P&&P.stages)P.stages.forEach(function(s){(s.metrics||[]).forEach(function(m){if(m.key===key)r={m:m,st:s};});}); return r; }
function _bmFocus(key){
  var hit=_bmFindMetric(key);
  if(!hit || !_FC_SER[key]){ var nav=(CP_NAV[key]||(CONS_NAV&&CONS_NAV[key])); if(nav) _goCp(nav[0],nav[1]); return; }
  _focusKey=key;
  var mt=hit.m, stg=hit.st, nm=BIOMOTION_NORMS[key];
  var band=(nm&&mt.value!=null&&mt.dir)?_bmBandSVG(mt.value,nm,mt.dir):'';
  var s=(nm&&mt.value!=null&&mt.dir)?_bmStat(mt.value,nm,mt.dir):null;
  var zinfo=s?('<span style="color:'+_bmStatusCol(s.status)+';font-weight:700">'+_bmStatusGlyph(s.status)+' '+(s.status==='strong'?'강점':(s.status==='flag'?'교정 대상':'정상 범위'))+' · 엘리트 대비 '+_bmZ(s.z)+'</span>'):'';
  var sb=(mt.score!=null)?' <span class="bm-score-'+_dlScoreBadge(mt.score)+'" style="font-size:14px;padding:2px 9px;border-radius:5px;font-weight:800">'+mt.score+'점</span>':'';
  document.getElementById('bm-focus-head').innerHTML=
    '<div class="card" style="grid-column:1 / -1"><button class="cp-jump" onclick="_bmFocusClose()">← 메카닉으로</button>'
    +'<h2 class="page-title" style="margin-top:10px">'+mt.label+' <span class="sub2">'+stg.label+' · 변인 상세 설명</span></h2>'
    +'<div style="font-size:28px;font-weight:800;margin-top:2px">'+(mt.value!=null?mt.value:'—')+'<span style="font-size:13px;color:var(--fg2);margin-left:3px">'+(mt.unit||'')+'</span>'+sb+'</div>'
    +'<div style="margin:5px 0 6px;font-size:13px">'+zinfo+'</div>'+(band?'<div style="max-width:440px">'+band+'</div>':'')+'</div>';
  var drill=(typeof PHASE_DRILL!=='undefined'&&PHASE_DRILL[key])?PHASE_DRILL[key]:'';
  document.getElementById('bm-focus-info').innerHTML=
    '<div class="card" style="grid-column:1 / -1"><h3>해석 · 코칭</h3>'
    +'<p style="color:var(--fg1);line-height:1.7;margin:6px 0">'+(mt.note||'이 변인의 시계열을 좌측 스틱 재생과 함께 보며 설명하세요.')+(mt.warn?' <b style="color:var(--red)"> '+mt.warn+'</b>':'')+'</p>'
    +(drill?'<div style="margin-top:6px;color:var(--fg1)"><b>권장 드릴</b> '+drill+'</div>':'')
    +'<div class="note" style="margin-top:8px">위 그래프는 이 변인의 시계열입니다. 좌측 스틱을 ▶ 재생하면 흰 커서와 우측 게이지가 동작에 동기화됩니다. 실선=빠른 공 · 점선=느린 공.</div></div>';
  setPage('focus');
}
function _bmFocusClose(){ _focusKey=null; setPage('biomotion'); }
function _renderFocusChart(){
  if(!_focusKey)return; var cfg=_FC_SER[_focusKey]; if(!cfg)return;
  var hit=_bmFindMetric(_focusKey), mt=hit?hit.m:null;
  // 스트라이드 길이·시간 → 예전 지면반력 발모양+COP+COM 궤적 시각화 연결
  if(cfg.copView){ var ft=_fastTrial(); if(ft){ var fi=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:((ft.events&&ft.events.i_br)||0); drawCopGrf(ft,fi,_slowTrial(),'ch-focus',true); } return; }
  var w=cfg.win||{startEv:'i_fc',startOff:-0.3,endEv:'i_br',endOff:0.2};
  var lines=cfg.lines?cfg.lines.map(function(l){return {compute:l.fn,color:l.c,label:l.label,width:2.4};})
    :[{compute:cfg.fn,color:cfg.c,label:(mt&&mt.label)||_focusKey,width:2.6}];
  plotWin('ch-focus',{fast:_fastTrial(),slow:_slowTrial(),startEv:w.startEv,startOff:w.startOff,endEv:w.endEv,endOff:w.endOff,
    left:{label:(mt&&mt.unit)||'',lines:lines}});
}
