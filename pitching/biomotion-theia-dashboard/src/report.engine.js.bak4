        var _col=document.createElement('div'); _col.style.cssText='flex:0 0 360px;display:flex;flex-direction:column;align-items:center';
        var _rd=document.createElement('div'); _rd.id='ed-xf-stk-rd'; _rd.style.cssText='font-size:16px;font-weight:800;color:#e8954e;margin-bottom:3px';
        _col.appendChild(_rd);
