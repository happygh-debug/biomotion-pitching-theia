// ── 진단4 블로킹 전용 화면 (개발문서 v1) — 홈 방향 sign correction 기반 ──
function _blkMass(){ return (DATA.player&&DATA.player.weight_kg)||86; }
function _blkSign(t){ var cv=t.series.COM_Velocity_Y||[],e=t.events||{},iSO=(e.i_kl_peak||0),iFC=e.i_fc||0,s=0,c=0; for(var i=iSO;i<=iFC&&i<cv.length;i++){ if(isFinite(cv[i])){s+=cv[i];c++;} } return (c&&s<0)?-1:1; }
function _blkFwd(t){ var cv=t.series.COM_Velocity_Y||[],sg=_blkSign(t); return cv.map(function(x){return isFinite(x)?sg*x:NaN;}); }       // signed 전진속도(+홈)
function _blkFbrakePct(t){ var ap=t.series.FP2_Y||[],sg=_blkSign(t),BW=_blkMass()*9.81; return ap.map(function(x){return isFinite(x)?Math.max(0,-sg*x)/BW*100:NaN;}); } // 제동력 %BW
function _blkDecel(t){ var f=_blkFwd(t),dt=(t.meta&&t.meta.dt)||0.00333; var sm=f.map(function(v,i){var s=0,c=0;for(var k=-2;k<=2;k++){var j=i+k;if(j>=0&&j<f.length&&isFinite(f[j])){s+=f[j];c++;}}return c?s/c:NaN;}); var o=new Array(f.length); for(var i=0;i<f.length;i++){var d=(i===0||!isFinite(sm[i])||!isFinite(sm[i-1]))?NaN:(sm[i]-sm[i-1])/dt; o[i]=isFinite(d)?Math.max(0,-d):NaN;} return o; }
function _blkFwdKE(t){ var f=_blkFwd(t),m=_blkMass(); return f.map(function(v){return isFinite(v)?0.5*m*v*v:NaN;}); }
function _blkCumImp(t){ var fb=_blkFbrakePct(t),e=t.events||{},iFC=e.i_fc||0,dt=(t.meta&&t.meta.dt)||0.00333,o=new Array(fb.length),acc=0; for(var i=0;i<fb.length;i++){ if(i<iFC){o[i]=0;} else { if(isFinite(fb[i]))acc+=fb[i]*dt; o[i]=acc; } } return o; }
function _blkPelvisAcc(t){ var pv=(t.series.Pelvis_Ang_Vel_Z||[]).map(function(x){return isFinite(x)?Math.abs(x):NaN;}),dt=(t.meta&&t.meta.dt)||0.00333; var sm=pv.map(function(v,i){var s=0,c=0;for(var k=-2;k<=2;k++){var j=i+k;if(j>=0&&j<pv.length&&isFinite(pv[j])){s+=pv[j];c++;}}return c?s/c:NaN;}); var o=new Array(pv.length); for(var i=0;i<pv.length;i++){var d=(i===0||!isFinite(sm[i])||!isFinite(sm[i-1]))?NaN:(sm[i]-sm[i-1])/dt; o[i]=isFinite(d)?Math.abs(d):NaN;} return o; }
function renderEdBlocking(){
  var root=document.getElementById('ed-body-blocking'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, B=X&&X.blocking;
  if(!B){ root.innerHTML='<div class="card"><div class="note">블로킹 데이터가 없습니다 (지면반력 있는 Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  var ab=B.apBrake,im=B.impulse,cd=B.comDecel,cvb=B.comVel,ke=B.comKE,dir=B.direction,vt=B.vertical,pl=B.pelvis,kn=B.knee,ev=B.events,N=B.norm||{};
  // 각 변인 카드 아래 인라인 그래프+폴더(이벤트표·정의) — 진단2 패턴
  var _fbT=(typeof _fastTrial==='function')?_fastTrial():null, _isxB=(B.events&&B.events.idx)||{}, _mB=_blkMass(), _EVTb=_edEvtListG(_isxB,_fbT);
  var _fbBrake=_fbT?_blkFbrakePct(_fbT):null, _fbFwd=_fbT?_blkFwd(_fbT):null, _fbKE=_fbT?_blkFwdKE(_fbT):null, _fbDecel=_fbT?_blkDecel(_fbT):null, _fbCum=_fbT?_blkCumImp(_fbT):null;
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:195px;display:block;margin-top:8px"></canvas>'
    +''
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTb, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function pathB(cid,cap,def){ return '<canvas id="'+cid+'" style="width:100%;height:235px;display:block;margin-top:8px"></canvas>'
    +'<div class="note" style="font-size:11px;margin-top:2px;color:var(--fg2)">'+cap+'</div>'
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _gFwd(f){ return (_fbFwd&&isFinite(_fbFwd[f]))?Math.round(_fbFwd[f]*100)/100:null; }
  function _gBrk(f){ return (_fbBrake&&isFinite(_fbBrake[f]))?Math.round(_fbBrake[f]*10)/10:null; }
  function _gKE(f){ return (_fbKE&&isFinite(_fbKE[f]))?Math.round(_fbKE[f]):null; }
  function _gDecel(f){ return (_fbDecel&&isFinite(_fbDecel[f]))?Math.round(_fbDecel[f]*10)/10:null; }
  function _gCum(f){ return (_fbCum&&isFinite(_fbCum[f]))?Math.round(_fbCum[f]*1000)/1000:null; }
  function _gVgrf(f){ var a=_fbT&&_fbT.series&&_fbT.series.FP2_Z;return (a&&isFinite(a[f]))?Math.round(Math.abs(a[f])/(_mB*9.81)*100*10)/10:null; }
  function _gKnee(f){ return _edSV(_fbT,'Lead_Knee_Angle_X',f,1); }
  function _gPelV(f){ return _edSV(_fbT,'Pelvis_Ang_Vel_Z',f,1,true); }
  var warnHtml=(B.warnings&&B.warnings.length)?('<div class="note" style="margin-top:6px;color:#e8954e"><b>주의:</b> '+B.warnings.join(' · ')+'</div>'):'';
  var _flowBand=_edFlowBand([{label:'① 앞발 제동력',val:(B.apBrake&&B.apBrake.peakPctBW!=null)?B.apBrake.peakPctBW+'%BW':null,state:_flowState(B.apBrake&&B.apBrake.peakPctBW,'apBrake',true)},{label:'② COM 감속',val:(B.comDecel&&B.comDecel.peak!=null)?B.comDecel.peak+'m/s²':null,state:_flowState(B.comDecel&&B.comDecel.peak,'comDecel',true)},{label:'③ 전진에너지→회전에너지 전환',val:(B.comKE&&B.comKE.dropFCtoMin!=null)?B.comKE.dropFCtoMin+'J':null,state:_flowState(B.comKE&&B.comKE.dropFCtoMin,'comKEdrop',true)},{label:'④ 상체 회전 가속',val:(B.functionalScore!=null)?B.functionalScore+'점':null,state:_scoreState(B.functionalScore)}],'앞발이 강하게 제동해 전진을 멈추면(①②) 전진 운동E가 회전E로 전환되어(③) 상체 회전이 가속됩니다(④). 제동이 약하면 몸이 앞으로 밀려 회전으로 전환되지 못합니다.');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">블로킹: 전진 에너지를 얼마나 빠르고 효과적으로 멈췄는가 · <span style="color:var(--cyan)">'+B.typeKo+'</span></div><div style="font-size:13px;font-weight:800">블로킹 역량 '+v(B.capacityScore)+'점 · 기능 전달 '+v(B.functionalScore)+'점</div></div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+B.summary+'</div>'
    +'<div class="note" style="margin-top:5px">블로킹 = <b>수평 제동</b>입니다 — 스트라이드에서 만든 전진 운동량을 앞발이 AP 방향으로 멈춰(제동), 선형 에너지를 골반 회전으로 전환할 기반을 만드는지 평가합니다. 점수·기준은 상동고 <b>코호트 '+(N.n||20)+'명</b> 중앙값/사분위(IQR) 기준입니다. (수직 GRF는 점수가 아니라 다음 단계 무릎전달 bridge)</div>'+warnHtml+'</div>';
  // KPI 카드 묶음
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('FC 전진 KE',v(ke.keFC,'J'),'코호트 중앙 '+v(N.keFC&&N.keFC.med,'J'))
    +kpi('앞발 AP 제동 peak',v(ab.peakPctBW,'%BW'),'중앙 '+v(N.peakBrakePctBW&&N.peakBrakePctBW.med))
    +kpi('FC→제동 peak',v(ab.tFCtoPBGms,'ms'),'이른 제동 목표 ~'+v(N.tFCtoPBG&&N.tFCtoPBG.med,'ms'))
    +kpi('제동 임펄스(FC→PBG)',v(im.fcToPBG,'%BW·s'),'')
    +kpi('COM 감속 peak',v(cd.peak,'m/s²'),'중앙 '+v(N.comDecel&&N.comDecel.med))
    +kpi('전진 KE 감소(FC→PBG)',v(ke.dropPct,'%'),v(ke.dropFCtoPBG,'J'))
    +kpi('제동 방향품질',v(dir.dirQuality),'1=홈방향 집중')
    +kpi('PBG→골반가속 gap',ms(pl.dtPBGtoPPAms),'')
    +kpi('블로킹 역량 점수',v(B.capacityScore),'수직GRF 제외')
    +kpi('기능 전달 점수',v(B.functionalScore),'다음단계 연결 포함')
    +'</div></div>';
  // 상세 카드
  html+=card('무릎 · 지면반력','앞다리 착지(FC)~릴리스(BR) 동안 지면반력(수직·전진·합력)과 앞무릎 각도',
    'FC 전진속도 '+v(cvb.velFC,'m/s')+' · FC 전진 KE '+v(ke.keFC,'J')+' (코호트 중앙 '+v(N.keFC&&N.keFC.med,'J')+')',
    (ke.keFC!=null&&N.keFC&&ke.keFC>=N.keFC.med)?'멈춰야 할 전진 에너지가 충분히 들어와, 제동이 잘 되면 큰 회전 전환 원재료가 됩니다.':'들어온 전진 에너지가 크지 않아, 블로킹보다 스트라이드 전진 운동량 형성이 우선일 수 있습니다(진단3 확인).',
    '스트라이드 전진 운동량(진단3)과 함께 해석',
    vB('ed-blk-1',[{label:'COM 전진속도',unit:'m/s',get:_gFwd},{label:'전진 KE',unit:'J',get:_gKE},{label:'앞발 AP 제동',unit:'%BW',get:_gBrk}],{name:'1. 스트라이드→블로킹 입력',def:'블로킹이 멈출 전진 운동량·운동에너지.',calc:'FC 시 COM 전진속도(m/s)·전진 KE(½mv²).',interp:'클수록 제동으로 회전 전환할 원재료가 많음.',evalm:'FC 전진 KE 코호트 중앙 대비.'}));
  html+=card('제동의 실제 효과 (COM 감속)','전진을 멈추는 수평 지면반력 — 홈 방향 투영·부호보정 후 양수 magnitude',
    '제동 peak <b>'+v(ab.peakPctBW,'%BW')+'</b> ('+v(ab.peakN,'N')+', FC'+ms(ab.tFCtoPBGms)+') · 상승률 '+v(ab.riseRatePctBWs,'%BW/s')+' · (코호트 중앙 '+v(N.peakBrakePctBW&&N.peakBrakePctBW.med,'%BW')+')',
    (ab.peakPctBW!=null&&N.peakBrakePctBW&&ab.peakPctBW>=N.peakBrakePctBW.q1)?'앞발이 전진을 멈추는 수평 제동력은 충분합니다(크기 자체는 병목 아님).':'수평 제동력이 코호트 하위로 약해, 전진 운동량을 멈추는 힘이 부족합니다.',
    'raw 수직힘이 아니라 홈 방향 수평 제동을 키우는 데 집중',
    vB('ed-blk-2',[{label:'앞발 AP 제동',unit:'%BW',get:_gBrk}],{name:'2. 앞발 AP 제동력',def:'앞발이 전진을 멈추는 수평(앞뒤) 제동력.',calc:'앞발 AP 지면반력의 제동 방향 peak(%BW, 홈 방향 부호보정).',interp:'클수록 전진 운동량을 회전으로 강하게 전환.',evalm:'코호트 중앙/사분위 대비.'}));
  html+=card('블로킹 → 상체 회전에너지 전달','제동력이 실제로 COM 전진속도를 줄였나(signed 전진속도의 음의 기울기)',
    'COM 감속 peak <b>'+v(cd.peak,'m/s²')+'</b> (FC'+ms(cd.tPCDms)+') · 전진속도 FC '+v(cvb.velFC,'m/s')+' → PBG '+v(cvb.velPBG,'m/s')+' (감소 '+v(cvb.dropFCtoPBG,'m/s')+')',
    (cd.peak!=null&&N.comDecel&&cd.peak>=N.comDecel.q1)?'제동력이 실제 COM 감속으로 이어져, 전진 운동량이 멈춰지고 있습니다.':'제동 peak는 있어도 COM 감속이 약하면 제동이 실제 효과로 이어지지 못한 것입니다(축/부호 또는 흡수 확인).',
    '제동 peak(PBG)와 COM 감속 peak(PCD) 시점이 가깝게 맞물리도록',
    vB('ed-blk-3',[{label:'COM 감속',unit:'m/s²',get:_gDecel},{label:'앞발 AP 제동',unit:'%BW',get:_gBrk},{label:'COM 전진속도',unit:'m/s',get:_gFwd}],{name:'3. COM 감속',def:'제동력이 실제로 COM 전진속도를 줄인 정도.',calc:'앞으로 가던 속도가 가장 빠르게 줄어드는 정도(m/s²).',interp:'제동력이 실제 효과(감속)로 이어졌는지 확인.',evalm:'PBG와 감속 peak(PCD) 시점이 가까울수록 양호.'}));
  html+=card('앞발 압력 중심 안정성','앞발 위 압력중심(COP) 궤적과 지면반력(수직·전진) 벡터 · 약간 기울인 시점',
    'FC→PBG '+v(im.fcToPBG,'%BW·s')+' · FC→PVGRF '+v(im.fcToPVGRF,'%BW·s')+' · FC→BR '+v(im.fcToBR,'%BW·s'),
    '제동 임펄스는 FC→PBG 구간에 빠르게 형성될수록 좋습니다(늦은 PBG는 임펄스가 커도 전환 지연).',
    '제동을 FC 직후 빠르게 형성(늦게 길게 끌지 않기)',
    vB('ed-blk-4',[{label:'누적 제동 임펄스',unit:'%BW·s',get:_gCum},{label:'앞발 AP 제동',unit:'%BW',get:_gBrk}],{name:'4. 제동 임펄스',def:'제동력을 시간에 대해 누적한 양(∫F dt).',calc:'FC부터 누적한 AP 제동력(%BW·s).',interp:'FC→PBG 구간에 빠르게 형성될수록 전환이 빠름.',evalm:'늦게 길게 끌면 전환 지연.'}));
  html+=card('5. 전진 운동에너지 감소 (선형→회전 전환 준비)','전진 KE가 제동으로 얼마나 제거되었나',
    'FC '+v(ke.keFC,'J')+' → PBG '+v(ke.kePBG,'J')+' (감소 '+v(ke.dropFCtoPBG,'J')+' · '+v(ke.dropPct,'%')+') · 최저 '+v(ke.keMin,'J')+' (전체 감소 '+v(ke.dropFCtoMin,'J')+')',
    '전진 KE가 제거됐다고 모두 회전으로 간 것은 아니므로(골반 가속과 함께 해석), 제거된 선형 에너지가 회전 전환 원재료가 됩니다.',
    '제거된 선형 KE가 골반 회전 가속(아래 8번)으로 이어지는지 확인',
    vB('ed-blk-5',[{label:'전진 KE',unit:'J',get:_gKE},{label:'COM 전진속도',unit:'m/s',get:_gFwd}],{name:'5. 전진 운동에너지 감소',def:'제동으로 제거된 전진 운동에너지.',calc:'FC~PBG 전진 KE 감소(J·%).',interp:'제거된 선형 에너지가 회전 전환 원재료.',evalm:'골반 회전 가속과 함께 해석.'}));
  html+=card('6. 방향 / 측방 누수','제동이 홈 방향 전진을 막는 방향인가, 좌우로 새는가',
    '방향품질 <b>'+v(dir.dirQuality)+'</b> (1=홈방향 집중) · ML 임펄스 '+v(dir.mlImpulse,'%BW·s'),
    (dir.dirQuality!=null&&dir.dirQuality>=0.96)?'제동력이 거의 홈 방향에 집중되어 측방 누수가 작습니다.':'제동력 일부가 좌우로 새고 있어(측방 누수) 전진 제동 효율이 떨어집니다.',
    (dir.dirQuality!=null&&dir.dirQuality<0.96)?'착지 방향·앞발 정렬을 홈 방향으로 교정(진단3 방향오차와 연결)':'현재 방향 정렬 유지',
    (B.copPath&&B.copPath.length)?pathB('ed-blk-path','위에서 본 COM(청록)·앞발(금색) 경로 + PBG 제동 벡터(초록) · 홈 방향=오른쪽 · 좌측 스틱 재생 위치 동기화',{name:'6. 방향 / 측방 누수',def:'제동이 홈 방향 전진을 막는가, 좌우로 새는가.',calc:'제동력 방향품질(1=홈집중)·ML 임펄스(%BW·s)·top-view 경로.',interp:'홈 방향 집중일수록 측방 누수가 작음.',evalm:'방향품질 0.96 이상 양호.'}):'');
  // 블로킹→수직지지 bridge (VGRF는 점수 아님)
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--amber,#e8954e)"><div style="font-size:13px;font-weight:800">7. 블로킹→수직지지 연결 (무릎전달로 넘어가는 연결)</div>'
    +'<div class="note" style="margin-top:4px">수직 GRF peak '+v(vt.peakVGRFpctBW,'%BW')+' · 제동→수직힘 간격 '+ms(vt.dtPBGtoPVGRFms)+'</div>'
    +'<div class="note" style="margin-top:4px"><b>수직 GRF는 블로킹 점수의 핵심 지표가 아니라, 다음 단계인 무릎전달(진단5)로 넘어가는 bridge 지표입니다. 블로킹 자체는 AP 제동과 COM 감속으로 평가합니다.</b></div>'
    +vB('ed-blk-7',[{label:'앞발 AP 제동',unit:'%BW',get:_gBrk},{label:'앞무릎 굴곡각',unit:'°',get:_gKnee},{label:'앞발 수직 GRF',unit:'%BW',get:_gVgrf}],{name:'7. 블로킹→수직지지 연결',def:'앞발 수직 지지력 — 회전축(앞다리)을 세우는 힘.',calc:'앞발판 수직 GRF peak(%BW)·제동→수직 간격(ms).',interp:'수직 GRF는 다음 단계 무릎전달로 넘어가는 bridge.',evalm:'블로킹 점수에는 미포함(무릎전달에서 평가).'})
    +'<div style="margin-top:6px">'+btn('무릎전달 →','ed-knee','var(--cyan)')+'</div></div>';
  // 블로킹→골반 회전 전환
  html+=card('8. 블로킹→골반 회전 전환 (제동이 회전으로?)','멈춘 힘이 골반 회전 가속으로 이어졌나',
    '골반 각가속 peak '+v(pl.angAccPeak,'°/s²')+' (FC'+ms(pl.tPPAms)+') · 골반 각속도 peak '+v(pl.angVelPeak,'°/s')+' (FC'+ms(pl.tPPVms)+') · PBG→골반가속 gap '+ms(pl.dtPBGtoPPAms)+' · 무릎 흡수일 '+v(kn.negWork,'J'),
    (pl.dtPBGtoPPAms!=null&&pl.dtPBGtoPPAms>30)?'제동 후 골반 회전 가속까지 간격이 커, 제동이 회전으로 바로 연결되지 못하고 있습니다(흡수/지연 의심).':'제동 직후 골반 회전 가속이 이어져 선형→회전 전환이 일어납니다.',
    (kn.negWork!=null&&kn.negWork<-30)?'무릎 흡수일이 커 over-brake 가능 — 무릎/고관절 흡수와 VGRF→골반 타이밍 확인(진단5)':'제동→골반 회전 전환 패턴 유지',
    vB('ed-blk-8',[{label:'앞발 AP 제동',unit:'%BW',get:_gBrk},{label:'COM 감속',unit:'m/s²',get:_gDecel},{label:'골반 각속도',unit:'°/s',get:_gPelV}],{name:'8. 블로킹→골반 회전 전환',def:'멈춘 선형 운동량이 골반 회전 가속으로 이어졌나.',calc:'골반 각가속·각속도 peak · PBG→골반가속 gap(ms).',interp:'gap이 작을수록 제동이 곧바로 회전으로 전환.',evalm:'PBG→골반가속 gap 30ms 이하 양호.'}));
  // 유형 분류 카드
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">9. 블로킹 유형: '+B.typeKo+'</div>'
    +'<div class="note" style="margin-top:4px">역량 '+v(B.capacityScore)+'점 · 준비도 '+v(B.readinessScore)+' · 회전전환 '+v(B.conversionScore)+' · 조기열림 패널티 '+v(B.earlyOpenPenalty)+' → 기능 전달 '+v(B.functionalScore)+'점</div>'
    +'<div class="note" style="margin-top:4px">'+B.summary+'</div></div>';
  // 코칭 우선순위
  var coachMsg=(B.type==='late')?'제동 자체보다 <b>제동 시점</b>이 늦습니다 — 앞발 착지 직후 빠르게 제동을 형성하는 데 우선 집중하세요.':(B.type==='weak')?'<b>제동력 자체</b>가 약합니다 — 앞다리로 전진을 멈추는 수평 제동을 키우세요.':(B.type==='momentum_leak')?'전진 에너지는 충분하나 <b>제동·감속이 부족</b>합니다 — 앞발 제동으로 전진을 멈춰 회전으로 전환하세요.':(B.type==='over_brake')?'강하게 멈추지만 <b>회전으로 전환되지 않고 흡수</b>됩니다 — 무릎/고관절 흡수를 줄이고 골반 회전 타이밍을 맞추세요(진단5).':(B.type==='direction_leak')?'제동이 <b>좌우로 샙니다</b> — 착지 방향을 홈 방향으로 교정하세요.':(B.type==='early_open_conflict')?'제동은 되지만 <b>몸통/골반이 먼저 열려</b> 순차 전달이 어렵습니다 — 진단1·2의 닫힘 보존을 우선하세요.':'블로킹이 균형 잡혀 있습니다 — 현재 패턴을 유지하세요.';
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">10. 코칭 우선순위</div><div class="note" style="margin-top:4px">'+coachMsg+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 스트라이드','ed-stride')+btn('무릎전달 ›','ed-knee')+'</div>';
  root.innerHTML=_flowBand+html;
  try{ ['ed-blk-5','ed-blk-6','ed-blk-7','ed-blk-8','ed-blk-path'].forEach(function(id){var c=document.getElementById(id);var cd=c&&c.closest&&c.closest('.card');if(cd)cd.style.display='none';}); }catch(e){}
  try{ _redrawBlkCharts(); }catch(e){}
  try{ if(B.copPath&&B.copPath.length) drawBlkPath('ed-blk-path'); }catch(e){}
}
function _redrawBlkCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, B=X&&X.blocking; if(!B) return;
  if(!document.getElementById('ed-blk-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, mass=_blkMass(), idx=(B.events&&B.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var EVb=[['SO','#7da0c4'],['PBG','#e8954e'],['PCD','#ff4d4d'],['PVGRF','#46c98c'],['PPA','#c084fc'],['PPV','#5bd3ff']];
  // 1. 무릎·지면반력 — FC→BR · 수직/전진/합력 GRF(좌) + 무릎각(우) · 이벤트 FC·MER·BR만
  var _gN=mass*9.81;
  var W1={fast:fast,slow:slow,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.03,
    extraEvents:[{label:'FC',frame:(fast&&fast.events&&fast.events.i_fc),color:'#cfd6e0',width:1.6},{label:'MER',frame:(fast&&fast.events&&fast.events.i_mer),color:'#9aa7b6'},{label:'BR',frame:(fast&&fast.events&&fast.events.i_br),color:'#4a90c8'}].filter(function(e){return e.frame!=null;}),noBuiltinEv:true};
  try{ plotWin('ed-blk-1',Object.assign({noGauge:true,left:{label:'앞발 지면반력 (%BW)',lines:[
    {compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(x){return Math.abs(x)/_gN*100;}):null;},color:'#6db4e6',label:'수직 GRF',width:2.4},
    {compute:function(t){var a=t.series.FP2_Y;return a?a.map(function(x){return Math.abs(x)/_gN*100;}):null;},color:'#46c98c',label:'전진(제동) GRF',width:2.0},
    {compute:function(t){var z=t.series.FP2_Z,y=t.series.FP2_Y;return (z&&y)?z.map(function(v,i){return Math.sqrt(v*v+(y[i]||0)*(y[i]||0))/_gN*100;}):null;},color:'#5bd3ff',label:'합력 GRF',width:2.2}]},
    right:{label:'앞무릎 굴곡각 (°)',lines:[{compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#c084fc',label:'앞무릎 각도',width:2.2}]}},W1)); }catch(e){}
  // 무릎 측면 스틱(앞다리만) — 재생 연동
  try{ var _bx=document.getElementById('ed-blk-1');
    if(_bx){ if(!document.getElementById('ed-blk-1-stk')){ var _rw=document.createElement('div'); _rw.style.cssText='display:flex;gap:14px;align-items:center;margin-top:8px'; _bx.parentNode.insertBefore(_rw,_bx); _bx.style.cssText='flex:1;min-width:0;height:200px;display:block'; _rw.appendChild(_bx); var _scv=document.createElement('canvas'); _scv.id='ed-blk-1-stk'; _scv.style.cssText='flex:0 0 190px;width:190px;height:220px;display:block'; _rw.appendChild(_scv); }
      var _kcf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):null;
      var _kk=(fast&&fast.series&&fast.series.Lead_Knee_Angle_X&&_kcf!=null&&isFinite(fast.series.Lead_Knee_Angle_X[_kcf]))?Math.round(fast.series.Lead_Knee_Angle_X[_kcf]):null;
      var _wf=(fast&&fast.events&&fast.events.i_fc)||0, _wb=(fast&&fast.events&&fast.events.i_br)||0;
      _edCardStick('ed-blk-1-stk',['leadleg'],{view:'side',only:['leadleg'],anchorHeel:true,win:[_wf,_wb],readout:[{txt:'앞무릎 '+(_kk!=null?_kk+'\u00b0':'\u2013'),color:'#c084fc',big:true}]});
    } }catch(e){}
  // 2~8. FC-0.04→BR
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.04,endEv:'i_br',endOff:0.03,extraEvents:ev(EVb)};
  // 2. 제동의 실제 효과(COM 감속) — FC→BR · 제동힘(면적=임펄스)+COM KE · 이벤트 FC·MER·BR · 옆 수직바(속도·KE)
  var _eFMB=[{label:'FC',frame:(fast&&fast.events&&fast.events.i_fc),color:'#cfd6e0',width:1.6},{label:'MER',frame:(fast&&fast.events&&fast.events.i_mer),color:'#9aa7b6'},{label:'BR',frame:(fast&&fast.events&&fast.events.i_br),color:'#4a90c8'}].filter(function(e){return e.frame!=null;});
  var Wfb={fast:fast,slow:slow,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.03,extraEvents:_eFMB,noBuiltinEv:true};
  try{ plotWin('ed-blk-2',Object.assign({noGauge:true,fillToZero:true,left:{label:'앞발 제동힘 (%BW)',lines:[
    {compute:function(t){return _blkFbrakePct(t);},color:'#6db4e6',label:'제동힘(면적=임펄스)',width:2.4}]},
    right:{label:'COM 운동에너지 (J)',lines:[{compute:function(t){return _blkFwdKE(t);},color:'#5bd3ff',label:'COM 운동에너지',width:2.2}]}},Wfb)); }catch(e){}
  // 옆 수직바 게이지: COM 속도 + COM 운동에너지 (재생 연동)
  try{ var _b2=document.getElementById('ed-blk-2');
    if(_b2){ if(!document.getElementById('ed-blk-2-bars')){ var _r2=document.createElement('div'); _r2.style.cssText='display:flex;gap:14px;align-items:center;margin-top:8px'; _b2.parentNode.insertBefore(_r2,_b2); _b2.style.cssText='flex:1;min-width:0;height:210px;display:block'; _r2.appendChild(_b2); var _bc=document.createElement('canvas'); _bc.id='ed-blk-2-bars'; _bc.style.cssText='flex:0 0 150px;width:150px;height:230px;display:block'; _r2.appendChild(_bc); }
      var _vc=document.getElementById('ed-blk-2-bars');
      if(_vc){ var _dp=window.devicePixelRatio||1,_W=_vc.clientWidth||150,_H=_vc.clientHeight||230; _vc.width=_W*_dp;_vc.height=_H*_dp; var _cx=_vc.getContext('2d'); _cx.setTransform(_dp,0,0,_dp,0,0); _cx.clearRect(0,0,_W,_H);
        var _vel=_blkFwd(fast)||[], _ke=_blkFwdKE(fast)||[];
        var _cf2=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):(_vel.length-1);
        function _mx(a){var m=0;for(var i=0;i<a.length;i++){if(isFinite(a[i])&&Math.abs(a[i])>m)m=Math.abs(a[i]);}return m||1;}
        var _bars=[['COM 속도',_vel,_mx(_vel),'#8ea9cf'],['COM KE',_ke,_mx(_ke),'#5bd3ff']];
        var _bw=42,_gp=28,_x0=(_W-(_bw*2+_gp))/2,_bh=_H-56,_by=26;
        _bars.forEach(function(b,i){ var bx=_x0+i*(_bw+_gp); var cv=(_cf2>=0&&_cf2<b[1].length&&isFinite(b[1][_cf2]))?Math.abs(b[1][_cf2]):0; var f=Math.max(0,Math.min(1,cv/b[2]));
          _cx.fillStyle='#243043'; _cx.fillRect(bx,_by,_bw,_bh); _cx.fillStyle=b[3]; _cx.fillRect(bx,_by+_bh*(1-f),_bw,_bh*f);
          _cx.fillStyle=b[3]; _cx.font='bold 13px system-ui'; _cx.textAlign='center'; _cx.textBaseline='bottom'; _cx.fillText(''+(Math.round(cv*10)/10), bx+_bw/2, _by-5);
          _cx.fillStyle='#a9b4c2'; _cx.font='11px system-ui'; _cx.textBaseline='top'; _cx.fillText(b[0], bx+_bw/2, _by+_bh+6); });
      }
    } }catch(e){}
  // 3. 블로킹→골반 회전에너지 전달 — FC→BR · COM 전진 KE + 골반 회전에너지 · 옆 수직바
  try{ plotWin('ed-blk-3',Object.assign({noGauge:true,left:{label:'앞발 제동힘 (%BW)',lines:[
    {compute:function(t){return _blkFbrakePct(t);},color:'#c084fc',label:'제동힘',width:2.2}]},
    right:{label:'세그먼트 에너지 (J)',lines:[
    {compute:function(t){return t.series.Pelvis_ME_X;},color:'#8ea9cf',label:'골반 에너지',width:2.4},
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#86a8d0',label:'몸통 에너지(굴곡+회전)',width:2.4},
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#5bd3ff',label:'팔 에너지(회전)',width:2.4}]}},Wfb)); }catch(e){}
  try{ var _b3=document.getElementById('ed-blk-3');
    if(_b3){ if(!document.getElementById('ed-blk-3-bars')){ var _r3=document.createElement('div'); _r3.style.cssText='display:flex;gap:14px;align-items:center;margin-top:8px'; _b3.parentNode.insertBefore(_r3,_b3); _b3.style.cssText='flex:1;min-width:0;height:210px;display:block'; _r3.appendChild(_b3); var _bc3=document.createElement('canvas'); _bc3.id='ed-blk-3-bars'; _bc3.style.cssText='flex:0 0 150px;width:150px;height:230px;display:block'; _r3.appendChild(_bc3); }
      var _vc3=document.getElementById('ed-blk-3-bars');
      if(_vc3){ var _dp=window.devicePixelRatio||1,_W=_vc3.clientWidth||150,_H=_vc3.clientHeight||230; _vc3.width=_W*_dp;_vc3.height=_H*_dp; var _cx=_vc3.getContext('2d'); _cx.setTransform(_dp,0,0,_dp,0,0); _cx.clearRect(0,0,_W,_H);
        var _pe=(fast&&fast.series&&fast.series.Pelvis_ME_X)||[], _te=(fast&&fast.series&&fast.series.Trunk_ME_X)||[], _ae=(fast&&fast.series&&fast.series.Pitching_Humerus_ME_X)||[];
        var _cf3=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):(_pe.length-1);
        function _mx(a){var m=0;for(var i=0;i<a.length;i++){if(isFinite(a[i])&&Math.abs(a[i])>m)m=Math.abs(a[i]);}return m||1;}
        var _bars=[['골반E',_pe,_mx(_pe),'#8ea9cf'],['몸통E',_te,_mx(_te),'#ff6b9d'],['팔E',_ae,_mx(_ae),'#5bd3ff']];
        var _bw=34,_gp=16,_x0=(_W-(_bw*3+_gp*2))/2,_bh=_H-56,_by=26;
        _bars.forEach(function(b,i){ var bx=_x0+i*(_bw+_gp); var cv=(_cf3>=0&&_cf3<b[1].length&&isFinite(b[1][_cf3]))?Math.abs(b[1][_cf3]):0; var f=Math.max(0,Math.min(1,cv/b[2]));
          _cx.fillStyle='#243043'; _cx.fillRect(bx,_by,_bw,_bh); _cx.fillStyle=b[3]; _cx.fillRect(bx,_by+_bh*(1-f),_bw,_bh*f);
          _cx.fillStyle=b[3]; _cx.font='bold 13px system-ui'; _cx.textAlign='center'; _cx.textBaseline='bottom'; _cx.fillText(''+Math.round(cv), bx+_bw/2, _by-5);
          _cx.fillStyle='#a9b4c2'; _cx.font='11px system-ui'; _cx.textBaseline='top'; _cx.fillText(b[0], bx+_bw/2, _by+_bh+6); });
      }
    } }catch(e){}
  // 4. 앞발 압력 중심 안정성 — COP 궤적 + GRF 벡터(발 위, 기울임)
  try{ drawCopFoot('ed-blk-4'); }catch(e){}
  // 5. 전진 KE 감소(좌) + 전진속도(우)
  try{ plotWin('ed-blk-5',Object.assign({left:{label:'전진 KE (J)',lines:[
    {compute:function(t){return _blkFwdKE(t);},color:'#5bd3ff',label:'전진 KE',width:2.4}]},
    right:{label:'COM 전진속도 (m/s)',lines:[{compute:function(t){return _blkFwd(t);},color:'#8ea9cf',label:'COM 전진속도',width:2.0}]}},W)); }catch(e){}
  // 7. AP제동·무릎각(좌) + 수직GRF bridge(우)
  try{ plotWin('ed-blk-7',Object.assign({left:{label:'AP 제동(%BW)·무릎각(°)',lines:[
    {compute:function(t){return _blkFbrakePct(t);},color:'#46c98c',label:'AP 제동',width:2.2},
    {compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#c084fc',label:'앞무릎 굴곡각',width:1.8}]},
    right:{label:'수직 GRF (%BW)',lines:[{compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(x){return Math.abs(x)/(mass*9.81)*100;}):null;},color:'#6db4e6',label:'수직 GRF(bridge)',width:2.2}]}},W)); }catch(e){}
  // 8. AP제동·COM감속(좌) + 골반 각가속·각속도(우)
  try{ plotWin('ed-blk-8',Object.assign({left:{label:'AP 제동(%BW)·COM 감속(m/s²)',lines:[
    {compute:function(t){return _blkFbrakePct(t);},color:'#46c98c',label:'AP 제동',width:2.2},
    {compute:function(t){return _blkDecel(t);},color:'#4a90c8',label:'COM 감속',width:1.8}]},
    right:{label:'골반 각가속(°/s²)·각속도(°/s)',lines:[
    {compute:function(t){return _blkPelvisAcc(t).map(function(x){return x/100;});},color:'#c084fc',label:'골반 각가속(÷100)',width:2.0},
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'골반 각속도',width:1.8}]}},W)); }catch(e){}
  // 경로(방향/측방 누수)도 현재 재생 프레임 마커와 함께 갱신
  try{ if(B.copPath&&B.copPath.length) drawBlkPath('ed-blk-path'); }catch(e){}
}
// 블로킹 top-view: COM·앞발 경로 + PBG 제동 벡터 (홈 방향=화면 오른쪽, 재생 프레임 마커 동기화)
function drawBlkPath(cid){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, B=X&&X.blocking; var canvas=document.getElementById(cid); if(!canvas||!B||!B.copPath||!B.copPath.length) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h, P=B.copPath;
  // copPath 점 = [FC기준ms, COM_좌우(1), COM_전진(2), 발_좌우(3), 발_전진(4), 제동크기(5), ML제동(6)]
  // 좌표축: 전진(홈)=화면 가로(오른쪽이 홈), 좌우(ML)=화면 세로 (교수 지시 2026-05-27)
  var aps=[],mls=[]; P.forEach(function(p){ aps.push(p[2]); mls.push(p[1]); if(p[3]!=null){aps.push(p[4]);mls.push(p[3]);} });
  var apmin=Math.min.apply(null,aps),apmax=Math.max.apply(null,aps),mlmin=Math.min.apply(null,mls),mlmax=Math.max.apply(null,mls);
  var firstAP=P[0][2], lastAP=P[P.length-1][2], fwdSign=(lastAP>=firstAP)?1:-1;
  var pad=32, sc=Math.min((w-2*pad)/((apmax-apmin)||1),(h-2*pad)/((mlmax-mlmin)||1));
  function gx(ap){ var v=(fwdSign>=0)?(ap-apmin):(apmax-ap); return pad+v*sc; }   // 전진(홈) → x, 오른쪽=홈
  function gy(ml){ return h-pad-(ml-mlmin)*sc; }                                   // 좌우(ML) → y
  // 홈 방향 화살표(오른쪽)
  ctx.strokeStyle='#3a4452';ctx.fillStyle='#7d8898';ctx.lineWidth=1;ctx.font='10px system-ui';ctx.textAlign='right';ctx.textBaseline='bottom';
  ctx.beginPath();ctx.moveTo(pad+6,pad-10);ctx.lineTo(w-16,pad-10);ctx.stroke();ctx.beginPath();ctx.moveTo(w-10,pad-10);ctx.lineTo(w-18,pad-14);ctx.lineTo(w-18,pad-6);ctx.closePath();ctx.fill();ctx.fillText('홈',w-22,pad-4);
  function path(idx,col,wd){ ctx.strokeStyle=col;ctx.lineWidth=wd;ctx.beginPath();var st=true;P.forEach(function(p){var ap=(idx===0)?p[2]:p[4],ml=(idx===0)?p[1]:p[3];if(ap==null||ml==null)return;var x=gx(ap),y=gy(ml);if(st){ctx.moveTo(x,y);st=false;}else ctx.lineTo(x,y);});ctx.stroke(); }
  path(1,'#c9a14a',2.4); path(0,'#5bd3ff',2.6);
  // PBG 제동 벡터(앞발 위치에서 홈 반대=왼쪽) — 제동은 전진을 막는 방향
  var pbgRel=B.events.PBG; var pp=null; P.forEach(function(p){ if(pp==null||Math.abs(p[0]-(pbgRel||0))<Math.abs(pp[0]-(pbgRel||0)))pp=p; });
  if(pp&&pp[3]!=null&&pp[5]!=null){ var bx=gx(pp[4]),by=gy(pp[3]); var L=Math.min(60,pp[5]/20)*fwdSign; // 제동크기 비례 · 홈 반대 방향
    ctx.strokeStyle='#46c98c';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(bx,by);ctx.lineTo(bx-L,by);ctx.stroke(); // 왼쪽(홈 반대=제동)
    ctx.fillStyle='#46c98c';ctx.beginPath();ctx.moveTo(bx-L-4*Math.sign(L||1),by);ctx.lineTo(bx-L+4*Math.sign(L||1),by-4);ctx.lineTo(bx-L+4*Math.sign(L||1),by+4);ctx.closePath();ctx.fill();
    ctx.fillStyle='#46c98c';ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='bottom';ctx.fillText('제동(PBG)',bx-L,by-6); }
  // ── 현재 재생 프레임 마커(좌측 3D 스틱 재생과 동기화) ──
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:null;
  if(cf!=null){ var ft=(typeof _fastTrial==='function')?_fastTrial():null; var ifc=(ft&&ft.events&&ft.events.i_fc)||0, dtv=(ft&&ft.meta&&ft.meta.dt)||0.00333; var curMs=(cf-ifc)*dtv*1000;
    var bp=null,bd=1e9; P.forEach(function(p){ var d=Math.abs(p[0]-curMs); if(d<bd){bd=d;bp=p;} });
    if(bp){ ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.5;
      if(bp[3]!=null){ ctx.fillStyle='#c9a14a';ctx.beginPath();ctx.arc(gx(bp[4]),gy(bp[3]),5,0,7);ctx.fill();ctx.stroke(); }
      ctx.fillStyle='#5bd3ff';ctx.beginPath();ctx.arc(gx(bp[2]),gy(bp[1]),6,0,7);ctx.fill();ctx.stroke(); }
  }
  ctx.fillStyle='#5bd3ff';ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='top';ctx.fillText('● COM (재생 위치)',8,8); ctx.fillStyle='#c9a14a';ctx.fillText('● 앞발',8,21);
}
// ── 진단5 무릎전달 전용 화면 (개발문서 v1) — 각도 클수록 굴곡, Δ<0=신전 ──
function _knVGRFpct(t){ var a=t.series.FP2_Z,m=_blkMass(); return a?a.map(function(x){return isFinite(x)?Math.abs(x)/(m*9.81)*100:NaN;}):null; }
function _knExtVel(t){ var kv=t.series.Lead_Knee_Ang_Vel_X; if(!kv){var ka=t.series.Lead_Knee_Angle_X,dt=(t.meta&&t.meta.dt)||0.00333;kv=ka?ka.map(function(v,i){return(i===0||!isFinite(ka[i])||!isFinite(ka[i-1]))?NaN:(ka[i]-ka[i-1])/dt;}):null;} return kv?kv.map(function(v){return isFinite(v)?Math.max(0,-v):NaN;}):null; }
function _knCumW(t,sign){ var kp=t.series.Lead_Knee_Power_X,e=t.events||{},iFC=e.i_fc||0,dt=(t.meta&&t.meta.dt)||0.00333; if(!kp)return null; var o=new Array(kp.length),acc=0; for(var i=0;i<kp.length;i++){ if(i<iFC){o[i]=0;} else { var p=kp[i]; if(isFinite(p)){ if(sign>0&&p>0)acc+=p*dt; if(sign<0&&p<0)acc+=Math.abs(p)*dt; } o[i]=acc; } } return o; }
function renderEdKnee(){
  var root=document.getElementById('ed-body-knee'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, K=X&&X.knee5;
  if(!K){ root.innerHTML='<div class="card"><div class="note">무릎전달 데이터가 없습니다 (지면반력 있는 Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  var vg=K.vgrf,an=K.angle,ve=K.velocity,wk=K.work,pl=K.pelvis,tm=K.timing,ev=K.events,N=K.norm||{};
  var warnHtml=(K.warnings&&K.warnings.length)?('<div class="note" style="margin-top:6px;color:#e8954e"><b>주의:</b> '+K.warnings.join(' · ')+'</div>'):'';
  // 각 변인 카드 아래 인라인 그래프+폴더(이벤트표·정의) — 진단2 패턴
  var _fkT=(typeof _fastTrial==='function')?_fastTrial():null, _isxK=(K.events&&K.events.idx)||{}, _EVTk=_edEvtListG(_isxK,_fkT);
  var _kVg=_fkT?_knVGRFpct(_fkT):null, _kEx=_fkT?_knExtVel(_fkT):null;
  function vB(cid,evRows,def,extra){ return '<canvas id="'+cid+'" style="width:100%;height:195px;display:block;margin-top:8px"></canvas>'
    +''+(extra||'')
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTk, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function loopB(){ return '<canvas id="ed-kn-loop" style="width:100%;height:235px;display:block;margin-top:10px"></canvas><div class="note" style="font-size:11px;margin-top:2px;color:var(--fg2)">힘-각도 고리 · x=무릎 각속도(+굴곡/−신전) · y=무릎 파워 · 생성(녹)/흡수(주)</div>'; }
  function _kgVg(f){ return (_kVg&&isFinite(_kVg[f]))?Math.round(_kVg[f]*10)/10:null; }
  function _kgKnee(f){ return _edSV(_fkT,'Lead_Knee_Angle_X',f,1); }
  function _kgExt(f){ return (_kEx&&isFinite(_kEx[f]))?Math.round(_kEx[f]):null; }
  function _kgPow(f){ return _edSV(_fkT,'Lead_Knee_Power_X',f,1); }
  function _kgPelV(f){ return _edSV(_fkT,'Pelvis_Ang_Vel_Z',f,1,true); }
  var _flowBand=_edFlowBand([{label:'① 수직 지면반력',val:(K.vgrf&&K.vgrf.peakPctBW!=null)?K.vgrf.peakPctBW+'%BW':null,state:_flowState(K.vgrf&&K.vgrf.peakPctBW,'leadGrf',true)},{label:'② 앞무릎 버팀(붕괴↓)',val:(K.angle&&K.angle.lateCollapse!=null)?K.angle.lateCollapse+'°':null,state:_flowState(K.angle&&K.angle.lateCollapse,'kneeCollapse',false)},{label:'③ 골반 회전 전달',val:(K.pelvis&&K.pelvis.angVelPeak!=null)?K.pelvis.angVelPeak+'°/s':null,state:_flowState(K.pelvis&&K.pelvis.angVelPeak,'pelvisRotV',true)},{label:'④ 회전 가속',val:(K.kneeTransferScore!=null)?K.kneeTransferScore+'점':null,state:_scoreState(K.kneeTransferScore)}],'착지 수직 지면반력을 앞무릎이 흡수·붕괴하지 않고 버텨야(①②) 그 힘이 골반 회전으로 전달되어(③) 회전이 가속됩니다(④).');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">무릎전달: 수직 GRF를 골반 회전으로 연결했는가 · <span style="color:var(--cyan)">'+K.typeKo+'</span></div><div style="font-size:13px;font-weight:800">무릎전달 점수 '+v(K.kneeTransferScore)+'점</div></div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+K.summary+'</div>'
    +'<div class="note" style="margin-top:5px"><b>이 단계에서 보는 것:</b> 수직 GRF가 앞무릎(버팀/신전/흡수)을 통해 골반 회전 가속으로 연결되는가. <b>안 보는 것:</b> 전진속도·AP 제동 충분 여부(진단3·4). · 점수·기준은 상동고 <b>코호트 '+(N.n||20)+'명</b> 중앙값/IQR.</div>'
    +'<div class="note" style="margin-top:4px;color:var(--cyan)">무릎 각도 규약: <b>클수록 굴곡</b> · 각속도 +굴곡/−신전 · 신전 속도는 별도 양수 파생변수. ΔKneeFlexion&lt;0 은 무너짐이 아니라 <b>신전</b>입니다.</div>'+warnHtml+'</div>';
  // KPI
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('앞무릎 유형',K.typeKo,'')
    +kpi('수직 GRF peak',v(vg.peakPctBW,'%BW'),'중앙 '+v(N.peakVGRFpct&&N.peakVGRFpct.med))
    +kpi('PVGRF→골반가속 gap',ms(tm.dtPVGRFtoPPA),'코호트 중앙 '+v(N.dtPVGRFtoPPA&&N.dtPVGRFtoPPA.med,'ms'))
    +kpi('무릎 신전속도 peak',v(ve.peakExtVel,'°/s'),'중앙 '+v(N.peakKEV&&N.peakKEV.med))
    +kpi('무릎 양의 일(FC→BR)',v(wk.posWorkFCtoBR,'J'),'')
    +kpi('무릎 음의 일(FC→BR)',v(wk.negWorkFCtoBR,'J'),'흡수')
    +kpi('흡수 비율',v(wk.absorptionRatio),'중앙 '+v(N.absorptionRatio&&N.absorptionRatio.med))
    +kpi('수직힘 평탄 유지',v(vg.plateauDurMs,'ms'),'CV '+v(vg.plateauCV))
    +kpi('후기 무너짐량',v(an.lateCollapse,'°'),'')
    +kpi('무릎전달 점수',v(K.kneeTransferScore),'수직GRF만 아님')
    +'</div></div>';
  // 무릎 유형 근거 표
  function row(lbl,a,b,c,d){ return '<tr><td style="padding:3px 8px;color:var(--fg2)">'+lbl+'</td><td style="padding:3px 8px;text-align:right">'+a+'</td><td style="padding:3px 8px;text-align:right">'+b+'</td><td style="padding:3px 8px;text-align:right">'+c+'</td><td style="padding:3px 8px;text-align:right">'+d+'</td></tr>'; }
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">무릎 유형 근거 (이벤트별 값) <span class="sub2">FC-BR 단일 차이가 아니라 시계열·속도·일로 판정</span></div>'
    +'<div style="overflow-x:auto"><table style="border-collapse:collapse;font-size:12px;margin-top:6px;width:100%">'
    +'<tr style="border-bottom:1px solid var(--line)"><th style="padding:3px 8px;text-align:left">이벤트</th><th style="padding:3px 8px;text-align:right">무릎 굴곡각(°)</th><th style="padding:3px 8px;text-align:right">FC(ms)</th><th style="padding:3px 8px;text-align:right">수직GRF(%BW)</th><th style="padding:3px 8px;text-align:right">골반각가속</th></tr>'
    +row('FC',v(an.atFC),'0','—','—')
    +row('PVGRF',v(an.atPVGRF),ms(ev.PVGRF),v(vg.peakPctBW),'—')
    +row('PKEV(신전속도peak)',v(an.atFC!=null?'':''),ms(ev.PKEV),'—','—')
    +row('PPA(골반가속peak)',v(an.atPPA),ms(ev.PPA),'—',v(pl.angAccPeak))
    +row('MER',v(an.atMER),ms(ev.MER),'—','—')
    +row('BR',v(an.atBR),ms(ev.BR),'—','—')
    +'</table></div>'
    +'<div class="note" style="margin-top:6px">ΔKneeFlexion FC→MER '+v(an.dFCtoMER,'°')+' · FC→BR '+v(an.dFCtoBR,'°')+' (음수=신전) · FC~MER 최소각 '+v(an.minFCtoMER,'°')+' · 후기 무너짐 '+v(an.lateCollapse,'°')+'</div></div>';
  // 상세 카드
  html+=card('1. 수직 지지 (Vertical Support)','블로킹 이후 골반으로 보낼 수직 힘을 형성했나',
    '수직 GRF peak '+v(vg.peakPctBW,'%BW')+' (FC'+ms(vg.tPVGRFms)+') · 상승률 '+v(vg.riseRatePctBWs,'%BW/s')+' · 임펄스 FC→PPA '+v(vg.impFCtoPPA,'%BW·s')+' · plateau '+v(vg.plateauDurMs,'ms')+'(CV '+v(vg.plateauCV)+')',
    (vg.peakPctBW!=null&&N.peakVGRFpct&&vg.peakPctBW>=N.peakVGRFpct.q1)?'수직 지지력은 충분합니다(다만 크기만으로 좋은 전달은 아님 — 아래 타이밍과 함께 봄).':'수직 지지력이 코호트 하위입니다.',
    '수직 GRF 크기보다 이 힘이 골반 회전으로 연결되는 타이밍이 핵심',
    vB('ed-kn-1',[{label:'앞발 수직 GRF',unit:'%BW',get:_kgVg},{label:'앞무릎 굴곡각',unit:'°',get:_kgKnee}],{name:'1. 수직 지지',def:'앞발이 땅을 누르는 수직 지지력.',calc:'앞발판 수직 GRF peak(%BW)·plateau 지속·CV.',interp:'골반 회전의 단단한 축을 만드는 힘(크기보다 타이밍).',evalm:'코호트 중앙/IQR 대비.'}));
  html+=card('무릎의 역할 — '+K.typeKo+' (흡수 vs 생성·전달)','앞무릎이 버티는지·펴며 전달하는지 — 근거: 무릎 각도 변화·신전속도',
    'FC '+v(an.atFC,'°')+' → PVGRF '+v(an.atPVGRF,'°')+' → MER '+v(an.atMER,'°')+' → BR '+v(an.atBR,'°')+' · 신전속도 peak '+v(ve.peakExtVel,'°/s')+' (신전 시작 FC'+ms(ve.extOnsetMs)+')',
    ({collapse:'앞무릎이 수직 힘을 굴곡·흡수로 잃는 패턴입니다.',bracing:'무릎을 크게 펴지 않고 안정 지지로 전달하는 패턴입니다.',dynamic_extension:'무릎을 동적으로 펴며 신전 파워를 골반 회전으로 전달합니다.',brace_to_extension:'초기 버팀 후 신전으로 추가 전달합니다.',ext_late_collapse:'초기 신전 전달 후 릴리스 직전 다시 무너집니다.',locked:'단단히 고정해 버티지만 전달보다 충격 흡수에 가깝습니다.',indeterminate:'신전·버팀·무너짐 근거가 섞여 있어 영상 확인이 필요합니다(초기 yield 후 후기 신전 등).'})[K.type],
    ({collapse:'FC 이후 리드 레그 지지와 골반 연결 타이밍 개선',bracing:'버팀 유지하며 PVGRF 이후 골반 가속 연결 강화',dynamic_extension:'더 펴기보다 신전 peak를 골반 가속과 맞추기',brace_to_extension:'brace window 유지하며 신전 onset이 늦지 않게',ext_late_collapse:'초기 신전 유지+릴리스 직전 후기 무너짐 줄이기',locked:'고정보다 골반 회전 연결 타이밍 확보',indeterminate:'힘-각도 고리·시계열로 영상 대조 권장'})[K.type],
    vB('ed-kn-2',[{label:'앞무릎 굴곡각',unit:'°',get:_kgKnee},{label:'무릎 신전속도',unit:'°/s',get:_kgExt}],{name:'2. 앞무릎 유형',def:'무릎이 수직 힘을 버텼나/펴며 전달했나/흡수했나.',calc:'FC~릴리스 무릎 굴곡각·신전속도(°/s) 시계열 + 힘-각도 고리.',interp:'신전 전달이면 하체 힘이 골반 회전으로 상승, 무너짐이면 손실.',evalm:'각도 클수록 굴곡 · 신전속도는 양수 파생.'},loopB()));
  html+=card('3. 무릎 일 균형 (Work Balance)','무릎이 에너지를 생성/전달했나, 흡수했나',
    '양의 일 FC→BR '+v(wk.posWorkFCtoBR,'J')+' · 음의 일 '+v(wk.negWorkFCtoBR,'J')+' · 흡수 비율 '+v(wk.absorptionRatio)+' (코호트 중앙 '+v(N.absorptionRatio&&N.absorptionRatio.med)+')',
    '리드 무릎은 본래 흡수(음의 일) 비중이 큽니다(코호트 중앙 흡수비 '+v(N.absorptionRatio&&N.absorptionRatio.med)+'). 흡수가 과도하고 골반 연결이 늦으면 누수입니다.',
    '흡수 자체보다 그 힘이 골반 회전으로 이어지는지(타이밍)와 함께 관리',
    vB('ed-kn-3',[{label:'무릎 파워',unit:'W',get:_kgPow}],{name:'3. 무릎 일 균형',def:'무릎이 에너지를 생성/전달했나, 흡수했나.',calc:'무릎 파워(+생성/−흡수)·누적 양/음의 일(J)·흡수 비율.',interp:'흡수가 과도하고 골반 연결이 늦으면 누수.',evalm:'흡수 비율 코호트 대비.'}));
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">4. VGRF→골반 회전 전달 타이밍 (핵심 KPI)</div>'
    +'<div class="note" style="margin-top:4px">PVGRF→골반가속 gap <b>'+ms(tm.dtPVGRFtoPPA)+'</b> · 연결 겹침 '+v(K.coupling)+' · PVGRF→골반속도 '+ms(tm.dtPVGRFtoPPV)+' · PVGRF→신전속도 '+ms(tm.dtPVGRFtoKEV)+'</div>'
    +'<div class="note" style="margin-top:4px">'+K.summary.replace(/^[^,]+, /,'')+'</div>'
    +'<div class="note" style="margin-top:4px;color:var(--fg2)">참고: 이 코호트는 골반 회전 가속 peak가 수직 GRF peak보다 <b>먼저</b> 오는 것이 정상(중앙 '+v(N.dtPVGRFtoPPA&&N.dtPVGRFtoPPA.med,'ms')+')이라, 절대 부호가 아니라 코호트 분포·연결로 해석합니다.</div>'
    +vB('ed-kn-4',[{label:'앞발 수직 GRF',unit:'%BW',get:_kgVg},{label:'골반 각속도',unit:'°/s',get:_kgPelV}],{name:'4. VGRF→골반 회전 전달 타이밍',def:'수직 GRF peak가 골반 회전 가속으로 이어지는지.',calc:'PVGRF→골반가속(PPA) 간격(ms)·연결 겹침.',interp:'짧을수록 땅 힘이 골반 회전으로 빠르게 전환.',evalm:'코호트 분포·coupling으로 해석(절대 부호 아님).'})+'</div>';
  // 블로킹→무릎 bridge & 무릎→골반 bridge
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">5. 연결 bridge</div>'
    +'<div class="note" style="margin-top:4px">블로킹→무릎: PBG→PVGRF '+ms(tm.dtPBGtoPVGRF)+' (제동에서 수직 지지 형성). 무릎→골반: 골반 각가속 peak '+v(pl.angAccPeak,'°/s²')+' (FC'+ms(pl.tPPAms)+') · 골반 각속도 peak '+v(pl.angVelPeak,'°/s')+' (FC'+ms(pl.tPPVms)+')</div>'
    +'<div style="margin-top:6px">'+btn('‹ 블로킹','ed-blocking')+btn('골반→몸통 ›','ed-pelvistrunk','var(--cyan)')+'</div></div>';
  // 코칭
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">6. 코칭 우선순위</div><div class="note" style="margin-top:4px">'
    +({collapse:'앞무릎이 수직 GRF를 받은 뒤 과도하게 접히지 않도록 리드 레그 지지와 골반 연결 타이밍을 먼저 개선합니다.',bracing:'현재 버팀을 유지하면서 PVGRF 이후 골반 회전 가속 연결을 더 빠르게 합니다.',dynamic_extension:'무릎을 더 펴기보다 신전 peak가 골반 가속과 맞는 타이밍을 다듬습니다.',brace_to_extension:'초기 brace를 유지하고 신전 onset이 PVGRF와 맞물리게 합니다.',ext_late_collapse:'초기 신전은 살리고 릴리스 직전 후기 무너짐을 줄여 마지막까지 지지력을 유지합니다.',locked:'고정 강도보다 골반 회전으로 넘기는 연결을 확보합니다.',indeterminate:'work loop·시계열을 영상과 대조해 유형을 확정한 뒤 우선순위를 정합니다.'})[K.type]+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 블로킹','ed-blocking')+btn('골반→몸통 ›','ed-pelvistrunk')+'</div>';
  root.innerHTML=_flowBand+html;
  try{ _redrawKneeCharts(); }catch(e){}
  try{
    var _k2=document.getElementById('ed-kn-2'), _k2c=_k2&&_k2.closest&&_k2.closest('.card');
    root.querySelectorAll('.card').forEach(function(cd){ if(cd!==_k2c) cd.style.display='none'; });
    if(_k2 && !document.getElementById('lf-kn-bars')){ var _rw=document.createElement('div'); _rw.style.cssText='display:flex;gap:12px;align-items:center;margin-top:8px'; _k2.parentNode.insertBefore(_rw,_k2); _rw.appendChild(_k2); _k2.style.cssText='flex:1;min-width:0;height:210px;display:block'; var _bp=document.createElement('canvas'); _bp.id='lf-kn-bars'; _bp.style.cssText='flex:0 0 150px;width:150px;height:210px;display:block'; _rw.appendChild(_bp); }
    var _lp=document.getElementById('ed-kn-loop'); if(_lp && !document.getElementById('lf-brace-stk')){ var _lw=document.createElement('div'); _lw.style.cssText='display:flex;gap:12px;align-items:center;margin-top:6px'; _lp.parentNode.insertBefore(_lw,_lp); _lp.style.cssText='flex:1;min-width:0;height:235px;display:block'; _lw.appendChild(_lp); var _st=document.createElement('canvas'); _st.id='lf-brace-stk'; _st.style.cssText='flex:0 0 185px;width:185px;height:235px;display:block'; _lw.appendChild(_st); }
    if(_k2c && !document.getElementById('lf-rotseq')){ var _c2=document.createElement('div'); _c2.className='card'; _c2.style.cssText='grid-column:1 / -1'; _c2.innerHTML='<div style="font-size:13px;font-weight:800;color:#46c98c">안정적 버팀 — 누수 방지</div><div class="note" style="margin-top:3px" id="lf-rotseq-lbl">—</div><canvas id="lf-rotseq" style="width:100%;height:215px;display:block;margin-top:8px"></canvas>'; _k2c.parentNode.insertBefore(_c2,_k2c.nextSibling); }
    var _kf=(typeof _fastTrial==='function')?_fastTrial():null, _ks=(typeof _slowTrial==='function')?_slowTrial():null;
    if(_kf){ var _wfc=(_kf.events&&_kf.events.i_fc)||0, _wbr=(_kf.events&&_kf.events.i_br)||0;
      try{ var _kcf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):null; var _ka=_kf.series&&_kf.series.Lead_Knee_Angle_X; var _kv=(_ka&&_kcf!=null&&isFinite(_ka[_kcf]))?Math.round(_ka[_kcf]):null; _edCardStick('lf-brace-stk',['leadleg'],{view:'side',only:['leadleg'],anchorHeel:true,win:[_wfc,_wbr],readout:[{txt:'앞무릎 '+(_kv!=null?_kv+'°':'–'),color:'#5bd3ff',big:true}]}); }catch(e){}
      var _Wk={fast:_kf,slow:_ks,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.03,extraEvents:[{label:'FC',frame:(_kf.events&&_kf.events.i_fc),color:'#cfd6e0',width:1.6},{label:'MER',frame:(_kf.events&&_kf.events.i_mer),color:'#9aa7b6'},{label:'BR',frame:(_kf.events&&_kf.events.i_br),color:'#4a90c8'}].filter(function(e){return e.frame!=null;}),noBuiltinEv:true};
      try{ plotWin('lf-rotseq',Object.assign({noGauge:true,fillToZero:true,left:{label:'앞발 수직 GRF (%BW)',lines:[
        {compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(x){return Math.abs(x)/(((DATA.player&&DATA.player.weight_kg)||86)*9.81)*100;}):null;},color:'#6db4e6',label:'수직 GRF(버팀)',width:2.6},
        {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#86a8d0',label:'몸통',width:2.4},
        {compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'팔',width:2.4}]}},_Wk)); }catch(e){}
      try{ var _dt=(_kf.meta&&_kf.meta.dt)||0.00333; function _pk(nm){var a=_kf.series[nm];if(!a)return null;var bi=null,bv=-1;for(var i=_wfc;i<=_wbr&&i<a.length;i++){if(isFinite(a[i])&&Math.abs(a[i])>bv){bv=Math.abs(a[i]);bi=i;}}return bi;}
        var _pp=_pk('Pelvis_Ang_Vel_Z'),_tp=_pk('Thorax_Ang_Vel_Z'),_ap=_pk('Pitching_Shoulder_Ang_Vel_Z');
        function _rel(x){return (x==null||_pp==null)?'–':(((x-_pp)>=0?'+':'')+Math.round((x-_pp)*_dt*1000)+'ms');}
        var _ok=(_pp!=null&&_tp!=null&&_ap!=null&&_pp<=_tp&&_tp<=_ap);
        var _lab=document.getElementById('lf-rotseq-lbl'); if(_lab) _lab.innerHTML='<b style="color:#ff6b9d;font-size:15px">골반 peak → 몸통 peak '+_rel(_tp)+'</b> <span style="color:var(--fg2)">(몸통 증폭 타이밍)</span> · 팔 '+_rel(_ap)+' · '+(_ok?'<b style="color:#46c98c">✓ 근위→원위 정상</b>':'<b style="color:#ff6b6b">✗ 순서 역전</b>'); }catch(e){}
    }
  }catch(e){}
  try{ _redrawLowerFlow(); }catch(e){}
}
function _redrawLowerFlow(){
  if(!document.getElementById('lf-rotseq')) return;
  var _kf=(typeof _fastTrial==='function')?_fastTrial():null, _ks=(typeof _slowTrial==='function')?_slowTrial():null; if(!_kf) return;
  var _wfc=(_kf.events&&_kf.events.i_fc)||0, _wbr=(_kf.events&&_kf.events.i_br)||0;
  try{ var _kcf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):null; var _ka=_kf.series&&_kf.series.Lead_Knee_Angle_X; var _kv=(_ka&&_kcf!=null&&isFinite(_ka[_kcf]))?Math.round(_ka[_kcf]):null; _edCardStick('lf-brace-stk',['leadleg'],{view:'side',only:['leadleg'],anchorHeel:true,win:[_wfc,_wbr],readout:[{txt:'앞무릎 '+(_kv!=null?_kv+'°':'–'),color:'#5bd3ff',big:true}]}); }catch(e){}
  var _Wk={fast:_kf,slow:_ks,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.03,extraEvents:[{label:'FC',frame:(_kf.events&&_kf.events.i_fc),color:'#cfd6e0',width:1.6},{label:'MER',frame:(_kf.events&&_kf.events.i_mer),color:'#9aa7b6'},{label:'BR',frame:(_kf.events&&_kf.events.i_br),color:'#4a90c8'}].filter(function(e){return e.frame!=null;}),noBuiltinEv:true};
  var _lead=((((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L')?'l_knee':'r_knee');
  function _ctr(arr){ var s=0,nn=0,i; for(i=0;i<arr.length;i++){if(isFinite(arr[i])){s+=arr[i];nn++;}} var m=nn?s/nn:0; return arr.map(function(v){return isFinite(v)?v-m:NaN;}); }
  function _fcRef(arr,t){ var fc=(t&&t.events&&t.events.i_fc)||0; var base=(arr&&isFinite(arr[fc]))?arr[fc]:0; return arr.map(function(v){return isFinite(v)?v-base:NaN;}); }  /* [2026-05-30] FC 시점=0 기준 */
  try{ plotWin('lf-rotseq',Object.assign({noGauge:true,left:{label:'좌우 이동 (mm · FC기준)',lines:[
    {compute:function(t){var hk=(_lead==='l_knee')?'l_heel':'r_heel';var a=(t.frames||[]).map(function(f){var k=f&&f[_lead];var hl=f&&f[hk];return (k&&hl&&isFinite(k[0])&&isFinite(hl[0]))?(k[0]-hl[0]):NaN;});return _fcRef(a,t);},color:'#86a8d0',label:'무릎 좌우(발 기준)',width:2.4}]},
    right:{label:'수직 GRF (%BW)',lines:[{compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(x){return Math.abs(x)/(((DATA.player&&DATA.player.weight_kg)||86)*9.81)*100;}):null;},color:'#6db4e6',label:'수직 GRF',width:2.0}]}},_Wk)); }catch(e){}
  try{ var _rq=document.getElementById('lf-rotseq');
    if(_rq && !document.getElementById('lf-stab-stk')){ var _rr=document.createElement('div'); _rr.style.cssText='display:flex;gap:12px;align-items:center;margin-top:8px'; _rq.parentNode.insertBefore(_rr,_rq); _rq.style.cssText='flex:1;min-width:0;height:215px;display:block'; _rr.appendChild(_rq); var _ss=document.createElement('canvas'); _ss.id='lf-stab-stk'; _ss.style.cssText='flex:0 0 175px;width:175px;height:215px;display:block'; _rr.appendChild(_ss); }
    _edCardStick('lf-stab-stk',['leadleg'],{view:'front',only:['leadleg'],anchorHeel:true,win:[_wfc,_wbr],readout:[{txt:'정면뷰 · 발 고정 · 무릎 좌우',color:'#86a8d0'}]});
  }catch(e){}
  try{ var _S=_kf.series,_cz=_S.FP2_Z,_cx2=_S.FP2_X_2,_cy2=_S.FP2_Y_2,_fc=(_kf.events&&_kf.events.i_fc)||0,_mer=(_kf.events&&_kf.events.i_mer)||((_kf.events&&_kf.events.i_br)||0);
    var _pk2=0;for(var _i=_fc;_cz&&_i<=_mer&&_i<_cz.length;_i++){if(isFinite(_cz[_i])&&Math.abs(_cz[_i])>_pk2)_pk2=Math.abs(_cz[_i]);}
    var _ip=_fc;for(var _i2=_fc;_cz&&_i2<=_mer&&_i2<_cz.length;_i2++){if(Math.abs(_cz[_i2])>=_pk2*0.999){_ip=_i2;break;}}
    var _sum=0,_nn=0;for(var _i3=_ip;_cz&&_i3<=_mer&&_i3<_cz.length;_i3++){if(isFinite(_cz[_i3])){_sum+=Math.abs(_cz[_i3]);_nn++;}}
    var _hold=(_pk2>0&&_nn>0)?Math.round(_sum/_nn/_pk2*100):null;
    function _rng(a){if(!a)return null;var mn=1e9,mx=-1e9;for(var k=_fc;k<=_mer&&k<a.length;k++){if(isFinite(a[k])){if(a[k]<mn)mn=a[k];if(a[k]>mx)mx=a[k];}}return (mx>=mn)?(mx-mn):null;}
    var _copR=_rng(_cx2);_copR=(_copR!=null)?Math.round(_copR):null;
    var _lead2=((((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L')?'l_knee':'r_knee'); var _lead2h=(_lead2==='l_knee')?'l_heel':'r_heel'; var _kx=(_kf.frames||[]).map(function(f){var k=f&&f[_lead2];var hl=f&&f[_lead2h];return (k&&hl&&isFinite(k[0])&&isFinite(hl[0]))?(k[0]-hl[0]):NaN;}); var _knR=_rng(_kx);_knR=(_knR!=null)?Math.round(_knR):null;
    var _stab=(_hold!=null&&_hold>=80&&_knR!=null&&_knR<=40);
    var _lab2=document.getElementById('lf-rotseq-lbl');if(_lab2)_lab2.innerHTML='버팀 유지 <b style="color:#e8954e">'+(_hold!=null?_hold+'%':'–')+'</b> · 무릎 좌우 <b style="color:#ff6b9d">'+(_knR!=null?_knR+'mm':'–')+'</b> · '+(_stab?'<b style="color:#46c98c">✓ 안정 전달</b>':'<b style="color:#ff6b6b">흔들림→누수</b>');
  }catch(e){}
  try{ var _bc=document.getElementById('lf-kn-bars');
    if(_bc){ var _dp=window.devicePixelRatio||1,_BW=_bc.clientWidth||140,_BH=_bc.clientHeight||210; _bc.width=_BW*_dp;_bc.height=_BH*_dp; var _x=_bc.getContext('2d'); _x.setTransform(_dp,0,0,_dp,0,0); _x.clearRect(0,0,_BW,_BH);
      var _ka=_kf.series.Lead_Knee_Angle_X||[], _kp=_kf.series.Lead_Knee_Power_X||[];
      var _cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):(_ka.length-1);
      function _mxv(a){var m=0;for(var i=0;i<a.length;i++){if(isFinite(a[i])&&Math.abs(a[i])>m)m=Math.abs(a[i]);}return m||1;}
      var _bw=38,_gap=30,_x0=20,_bh=_BH-48,_by=26;
      var _av=(_cf<_ka.length&&isFinite(_ka[_cf]))?_ka[_cf]:0,_amx=_mxv(_ka),_af=Math.max(0,Math.min(1,_av/_amx));
      _x.fillStyle='#243043';_x.fillRect(_x0,_by,_bw,_bh);_x.fillStyle='#5bd3ff';_x.fillRect(_x0,_by+_bh*(1-_af),_bw,_bh*_af);
      _x.fillStyle='#5bd3ff';_x.font='bold 12px system-ui';_x.textAlign='center';_x.textBaseline='bottom';_x.fillText(Math.round(_av)+'°',_x0+_bw/2,_by-3);
      _x.fillStyle='#a9b4c2';_x.font='10px system-ui';_x.textBaseline='top';_x.fillText('무릎각',_x0+_bw/2,_by+_bh+5);
      var _px=_x0+_bw+_gap,_pv=(_cf<_kp.length&&isFinite(_kp[_cf]))?_kp[_cf]:0,_pmx=_mxv(_kp),_mid=_by+_bh/2;
      _x.strokeStyle='#3a4452';_x.lineWidth=1;_x.beginPath();_x.moveTo(_px-5,_mid);_x.lineTo(_px+_bw+5,_mid);_x.stroke();
      var _ph=Math.abs(Math.max(-1,Math.min(1,_pv/_pmx)))*(_bh/2);
      if(_pv>=0){_x.fillStyle='#46c98c';_x.fillRect(_px,_mid-_ph,_bw,_ph);}else{_x.fillStyle='#e8954e';_x.fillRect(_px,_mid,_bw,_ph);}
      _x.fillStyle=(_pv>=0?'#46c98c':'#e8954e');_x.font='bold 12px system-ui';_x.textAlign='center';_x.textBaseline='bottom';_x.fillText(Math.round(_pv)+'W',_px+_bw/2,_by-3);
      _x.fillStyle='#46c98c';_x.font='9px system-ui';_x.textBaseline='top';_x.fillText('생성↑',_px+_bw/2,_by+_bh+5);
      _x.fillStyle='#e8954e';_x.fillText('흡수↓',_px+_bw/2,_by+_bh+17);
    } }catch(e){}
  try{ drawKneeLoop('ed-kn-loop'); }catch(e){}
}
function _redrawKneeCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, K=X&&X.knee5; if(!K) return;
  if(!document.getElementById('ed-kn-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, mass=_blkMass(), idx=(K.events&&K.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.04,endEv:'i_br',endOff:0.03};
  // 1. 수직 지지 — 수직 GRF(좌) + 무릎 굴곡각(우) · plateau
  try{ plotWin('ed-kn-1',Object.assign({left:{label:'수직 GRF (%BW)',lines:[
    {compute:function(t){return _knVGRFpct(t);},color:'#6db4e6',label:'수직 GRF',width:2.4}]},
    right:{label:'무릎 굴곡각 (°)',lines:[{compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#5bd3ff',label:'무릎 굴곡각',width:2.0}]},
    extraEvents:ev([['PVGRF','#e8954e'],['PPA','#c084fc']])},W)); }catch(e){}
  // 2. 앞무릎 유형 — 무릎 굴곡각(좌) + 신전속도(우)
  try{ plotWin('ed-kn-2',Object.assign({noGauge:true,left:{label:'무릎 굴곡각 (°)',lines:[
    {compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#5bd3ff',label:'무릎 굴곡각',width:2.4}]},
    right:{label:'무릎 파워 (W) +생성/−흡수',lines:[{compute:function(t){return t.series.Lead_Knee_Power_X;},color:'#4a90c8',label:'무릎 파워(+생성/−흡수)',width:2.4}]},
    extraEvents:ev([['PVGRF','#e8954e'],['PKEV','#8ea9cf'],['MER','#f5c542']])},W)); }catch(e){}
  // 3. 무릎 일 균형 — 무릎 파워(좌) + 누적 양/음의 일(우)
  try{ plotWin('ed-kn-3',Object.assign({left:{label:'무릎 파워 (W)',lines:[
    {compute:function(t){return t.series.Lead_Knee_Power_X;},color:'#5bd3ff',label:'무릎 파워(+생성/−흡수)',width:2.2}]},
    right:{label:'누적 일 (J)',lines:[
    {compute:function(t){return _knCumW(t,1);},color:'#46c98c',label:'누적 양의 일',width:2.0},
    {compute:function(t){return _knCumW(t,-1);},color:'#5fa6c0',label:'누적 음의 일',width:2.0}]},
    extraEvents:ev([['PVGRF','#e8954e'],['PPA','#c084fc'],['MER','#f5c542']])},W)); }catch(e){}
  // 4. VGRF→골반 타이밍 — AP제동·수직GRF(좌) + 골반 각가속·각속도(우)
  try{ plotWin('ed-kn-4',Object.assign({left:{label:'GRF (%BW)',lines:[
    {compute:function(t){return _blkFbrakePct(t);},color:'#46c98c',label:'AP 제동',width:1.8},
    {compute:function(t){return _knVGRFpct(t);},color:'#6db4e6',label:'수직 GRF',width:2.4}]},
    right:{label:'골반 각가속(÷100)·각속도(°/s)',lines:[
    {compute:function(t){return _blkPelvisAcc(t).map(function(x){return x/100;});},color:'#c084fc',label:'골반 각가속(÷100)',width:2.0},
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'골반 각속도',width:1.8}]},
    extraEvents:ev([['PBG','#9aa5b3'],['PVGRF','#e8954e'],['PPA','#c084fc'],['PPV','#5bd3ff']])},W)); }catch(e){}
  // work loop(카드2) 갱신
  try{ drawKneeLoop('ed-kn-loop'); }catch(e){}
}
// 무릎 work loop: x=각속도, y=파워
function drawKneeLoop(cid){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, K=X&&X.knee5; var canvas=document.getElementById(cid); if(!canvas||!K) return;
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t) return; var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var kv=t.series.Lead_Knee_Ang_Vel_X, kp=t.series.Lead_Knee_Power_X, e=t.events||{}, iFC=e.i_fc, iBR=e.i_br;
  if(!kv||!kp||iFC==null||iBR==null){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 무릎 각속도/파워 시계열 없음 —',w/2,h/2); return; }
  var xs=[],ys=[]; for(var i=iFC;i<=iBR&&i<kv.length;i++){ if(isFinite(kv[i])&&isFinite(kp[i])){xs.push(kv[i]);ys.push(kp[i]);} }
  if(!xs.length){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 데이터 없음 —',w/2,h/2); return; }
  var xmin=Math.min.apply(null,xs),xmax=Math.max.apply(null,xs),ymin=Math.min.apply(null,ys),ymax=Math.max.apply(null,ys);
  var pad=44, gx=function(x){return pad+(x-xmin)/((xmax-xmin)||1)*(w-pad-14);}, gy=function(y){return h-26-(y-ymin)/((ymax-ymin)||1)*(h-pad-14);};
  ctx.strokeStyle='#252d3a';ctx.lineWidth=1; var x0=gx(0),y0=gy(0);
  ctx.beginPath();ctx.moveTo(x0,14);ctx.lineTo(x0,h-26);ctx.stroke(); ctx.beginPath();ctx.moveTo(pad,y0);ctx.lineTo(w-14,y0);ctx.stroke();
  ctx.fillStyle='#7d8898';ctx.font='10px system-ui';ctx.textAlign='center';ctx.fillText('각속도 →(+굴곡 / −신전)',w/2,h-8); ctx.save();ctx.translate(12,h/2);ctx.rotate(-Math.PI/2);ctx.fillText('파워 (+생성 / −흡수)',0,0);ctx.restore();
  var _cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):iBR; var _ci=Math.max(0,Math.min(xs.length-1,_cf-iFC));
  for(var i=0;i<_ci;i++){ var p=ys[i]; ctx.strokeStyle=p>=0?'#46c98c':'#e8954e'; ctx.lineWidth=2; ctx.beginPath();ctx.moveTo(gx(xs[i]),gy(ys[i]));ctx.lineTo(gx(xs[i+1]),gy(ys[i+1]));ctx.stroke(); }
  if(_ci>0&&_ci<xs.length){ ctx.fillStyle='#fff';ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(gx(xs[_ci]),gy(ys[_ci]),5,0,7);ctx.fill();ctx.stroke(); }
  ctx.fillStyle='#e8ecf2';ctx.beginPath();ctx.arc(gx(xs[0]),gy(ys[0]),3.5,0,7);ctx.fill(); ctx.fillStyle='#e8ecf2';ctx.textAlign='left';ctx.fillText('FC',gx(xs[0])+5,gy(ys[0]));
  ctx.fillStyle='#46c98c';ctx.textAlign='left';ctx.fillText('● 생성',w-70,18); ctx.fillStyle='#e8954e';ctx.fillText('● 흡수',w-70,31);
}
// ── 진단6 골반→몸통 회전 증폭 전용 화면 (개발문서 v1) ──
function _ptTrkAcc(t){ var a=(t.series.Thorax_Ang_Vel_Z||[]).map(function(x){return isFinite(x)?Math.abs(x):NaN;}),dt=(t.meta&&t.meta.dt)||0.00333; var sm=a.map(function(v,i){var s=0,c=0;for(var k=-2;k<=2;k++){var j=i+k;if(j>=0&&j<a.length&&isFinite(a[j])){s+=a[j];c++;}}return c?s/c:NaN;}); var o=new Array(a.length);for(var i=0;i<a.length;i++){var d=(i===0||!isFinite(sm[i])||!isFinite(sm[i-1]))?NaN:(sm[i]-sm[i-1])/dt;o[i]=isFinite(d)?Math.abs(d):NaN;}return o; }
function renderEdPelvisTrunk(){
  var root=document.getElementById('ed-body-pelvistrunk'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, P=X&&X.pelvistrunk6;
  if(!P){ root.innerHTML='<div class="card"><div class="note">골반→몸통 데이터가 없습니다 (Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  var N=P.norm||{};
  // 각 변인 카드 아래 인라인 그래프+폴더(이벤트표·정의) — 진단2 패턴
  var _fpT=(typeof _fastTrial==='function')?_fastTrial():null, _isxP=(P.events&&P.events.idx)||{}, _EVTp=_edEvtListG(_isxP,_fpT);
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:195px;display:block;margin-top:8px"></canvas>'
    +''
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTp, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _pgPelV(f){ return _edSV(_fpT,'Pelvis_Ang_Vel_Z',f,1,true); }
  function _pgTrkV(f){ return _edSV(_fpT,'Thorax_Ang_Vel_Z',f,1,true); }
  function _pgPelE(f){ return _edSV(_fpT,'Pelvis_ME_X',f,1); }
  function _pgTrkE(f){ return _edSV(_fpT,'Trunk_ME_X',f,1); }
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">골반→몸통 회전 증폭 · <span style="color:var(--cyan)">'+P.typeKo+'</span></div><div style="font-size:13px;font-weight:800">증폭 점수 '+v(P.ampScore)+'점</div></div>'
    +'<div class="note" style="margin-top:3px;font-style:italic">이 단계의 질문: 골반이 몸통을 증폭시켰는가?</div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+P.summary+'</div>'
    +'<div class="note" style="margin-top:5px">골반은 첫 번째 기어, 몸통은 그 힘을 키우는 두 번째 기어입니다. <b>보는 것:</b> 골반→몸통 회전속도 순서·간격, 증폭 gain, 에너지 전달 동기화. <b>안 보는 것:</b> 몸통 자체 에너지 크기(진단7)·팔 전달(진단8). · 코호트 '+(N.n||20)+'명 기준.</div></div>';
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('골반 회전속도 peak',v(P.pelvisVelPeak,'°/s'),'FC'+ms(P.events.PPV))
    +kpi('몸통 회전속도 peak',v(P.trunkVelPeak,'°/s'),'FC'+ms(P.events.TVP))
    +kpi('골반→몸통 간격',ms(P.dtPelvisToTrunkVel),'코호트 중앙 '+v(N.dtVel&&N.dtVel.med,'ms'))
    +kpi('몸통/골반 gain',v(P.trunkOverPelvisGain),'중앙 '+v(N.gain&&N.gain.med))
    +kpi('전달 동기화 overlap',v(P.handoffOverlap),'중앙 '+v(N.handoff&&N.handoff.med))
    +kpi('증폭 점수',v(P.ampScore),'')
    +'</div></div>';
  html+=card('1. 골반 회전 (1단 기어)','하체·무릎에서 올라온 에너지로 골반이 회전했나',
    '골반 회전속도 peak '+v(P.pelvisVelPeak,'°/s')+' (FC'+ms(P.events.PPV)+') · 골반 각가속 peak '+v(P.pelvisAccPeak,'°/s²')+' · 골반 에너지 peak '+v(P.pelvisEnergyPeak,'J')+' (FC'+ms(P.events.PEP)+')',
    (P.pelvisVelPeak!=null&&N.pelvisVel&&P.pelvisVelPeak>=N.pelvisVel.q1)?'골반 회전 자체는 충분히 형성되었습니다.':'골반 회전속도가 코호트 하위로, 증폭 이전에 골반 회전 형성(진단5 무릎전달)을 먼저 봐야 합니다.',
    '골반 회전은 무릎전달(진단5)의 결과 — 함께 해석',
    vB('ed-pt-1',[{label:'골반 회전속도',unit:'°/s',get:_pgPelV},{label:'골반 에너지',unit:'J',get:_pgPelE}],{name:'1. 골반 회전 (1단 기어)',def:'하체·무릎에서 올라온 힘으로 골반이 회전한 정도.',calc:'골반 회전속도 peak(°/s)·각가속·골반 분절 에너지(J).',interp:'골반 회전은 무릎 전달의 결과 — 함께 해석.',evalm:'코호트 대비.'}));
  html+=card('2. 몸통 증폭 배수 (2단 기어)','골반 회전이 몸통 회전으로 커졌나',
    '몸통/골반 회전속도 gain <b>'+v(P.trunkOverPelvisGain)+'</b> (코호트 중앙 '+v(N.gain&&N.gain.med)+') · 몸통 회전속도 peak '+v(P.trunkVelPeak,'°/s'),
    (P.trunkOverPelvisGain!=null&&N.gain&&P.trunkOverPelvisGain>=N.gain.q1)?'골반 회전이 몸통으로 증폭됩니다.':'골반 대비 몸통 회전 증폭이 코호트 하위입니다 — 몸통이 골반 힘을 충분히 키우지 못하면 이후 팔이 더 일해야 할 수 있습니다(다만 엘리트는 전진 운동량 중심 등 다른 전략일 수 있어 단정 금지).',
    'gain을 무리하게 키우기보다 골반→몸통 순서·동기화를 먼저 맞추기',
    vB('ed-pt-2',[{label:'골반 회전속도',unit:'°/s',get:_pgPelV},{label:'몸통 회전속도',unit:'°/s',get:_pgTrkV}],{name:'2. 몸통 증폭 배수 (2단 기어)',def:'골반 회전이 몸통 회전으로 커진 비율.',calc:'몸통 회전속도 peak / 골반 회전속도 peak.',interp:'클수록 골반 힘을 몸통이 잘 증폭(엘리트는 전진 운동량 전략일 수도).',evalm:'코호트 중앙 대비.'}));
  html+=card('3. 골반→몸통 타이밍·순서','골반이 먼저 돌고 몸통이 적절한 간격으로 따라왔나(proximal-to-distal)',
    '회전속도 순서 간격 <b>'+ms(P.dtPelvisToTrunkVel)+'</b> (코호트 중앙 '+v(N.dtVel&&N.dtVel.med,'ms')+') · 회전 가속 간격 '+ms(P.dtPelvisToTrunkAcc)+' (참고, 미분 노이즈 큼)',
    (P.dtPelvisToTrunkVel!=null&&P.dtPelvisToTrunkVel<0)?'몸통 회전속도 peak가 골반보다 먼저 나타나, 골반 힘을 받기 전에 몸통이 먼저 열린 신호입니다(조기 열림).':((P.dtPelvisToTrunkVel!=null&&N.dtVel&&P.dtPelvisToTrunkVel>N.dtVel.q3)?'골반 이후 몸통 반응까지 간격이 코호트보다 길어 전달 지연 가능성이 있습니다.':'골반 먼저, 몸통이 적절한 간격으로 따라오는 순차 회전입니다.'),
    '몸통이 골반보다 먼저 열리지 않게(진단2 X-factor 보존)·너무 늦지 않게',
    vB('ed-pt-3',[{label:'골반 회전속도',unit:'°/s',get:_pgPelV},{label:'몸통 회전속도',unit:'°/s',get:_pgTrkV}],{name:'3. 골반→몸통 타이밍·순서',def:'골반이 먼저 돌고 몸통이 적절히 따라오는지(몸통쪽→손끝쪽).',calc:'몸통 회전속도 peak − 골반 회전속도 peak 간격(ms).',interp:'음수(몸통 먼저)는 조기 열림, 과대 간격은 전달 지연.',evalm:'코호트 중앙 대비.'}));
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">4. 골반→몸통 에너지 전달 동기화 (handoff overlap)</div>'
    +'<div class="note" style="margin-top:4px">overlap <b>'+v(P.handoffOverlap)+'</b> (골반 에너지 방출과 몸통 에너지 생성의 시간 겹침, 코호트 중앙 '+v(N.handoff&&N.handoff.med)+') · 골반E peak '+v(P.pelvisEnergyPeak,'J')+'(FC'+ms(P.events.PEP)+') → 몸통E peak '+v(P.trunkEnergyPeak,'J')+'(FC'+ms(P.events.TEP)+')</div>'
    +'<div class="note" style="margin-top:4px">'+((P.handoffOverlap!=null&&N.handoff&&P.handoffOverlap>=N.handoff.med)?'골반 에너지 방출과 몸통 에너지 상승이 잘 겹쳐 전달이 동기화됩니다.':'골반은 에너지를 냈지만 몸통이 그 타이밍에 충분히 받지 못한 신호입니다(동기화 낮음).')+' (골반 분절 에너지가 몸통보다 작아 overlap 절대값은 낮게 나오므로 코호트 상대로 해석)</div>'
    +vB('ed-pt-4',[{label:'골반 에너지',unit:'J',get:_pgPelE},{label:'몸통 에너지',unit:'J',get:_pgTrkE}],{name:'4. 에너지 넘기기(전달 동기화)',def:'골반 에너지 방출과 몸통 에너지 생성의 시간 겹침.',calc:'골반E 방출 구간과 몸통E 상승 구간의 overlap.',interp:'겹칠수록 골반→몸통 전달이 동기화됨.',evalm:'코호트 중앙 대비(골반E가 작아 절대값은 낮음).'})+'</div>';
  html+=card('5. X-factor 풀림 → 몸통 에너지 bridge','분리각 풀림이 몸통 에너지 상승으로 이어졌나',
    'X-factor 풀림 속도 peak FC'+ms(P.xfReleasePeakMs)+' → 몸통E peak 간격 '+ms(P.dtXReleaseToTrunkE)+' · FC 몸통 열림속도 '+v(P.thoraxOpenVelFC,'°/s')+' · FC까지 분리각 풀림 '+v(P.xfReleasedByFC,'%'),
    (P.thoraxOpenVelFC!=null&&P.thoraxOpenVelFC>600&&P.xfReleasedByFC!=null&&P.xfReleasedByFC>25)?'몸통이 FC 전에 빨리 열려 골반 힘을 순차로 받기 전에 회전이 시작된 신호입니다.':'분리각 풀림이 몸통 에너지 상승으로 이어집니다.',
    '몸통 조기 열림은 진단2(X-factor 보존)·진단1(골반 닫힘)에서 관리',
    vB('ed-pt-5',[{label:'몸통 회전속도',unit:'°/s',get:_pgTrkV},{label:'몸통 에너지',unit:'J',get:_pgTrkE}],{name:'5. X-factor 풀림 → 몸통 연결',def:'분리각 풀림이 몸통 에너지 상승으로 이어지는지.',calc:'풀림 속도 peak → 몸통E peak 간격(ms)·FC 몸통 열림속도.',interp:'몸통 조기 열림이면 골반 힘을 순차로 받기 전에 회전 시작.',evalm:'X-factor 보존·골반 닫힘과 연결.'}));
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">6. 코칭 우선순위</div><div class="note" style="margin-top:4px">'
    +({functional:'골반→몸통 증폭이 잘 됩니다 — 다음은 몸통 에너지가 팔로 넘어가는지(진단8)를 확인하세요.',trunk_gain_low:'골반은 도는데 몸통 회전 증폭이 약합니다 — 몸통 회전을 키우거나(진단7) 골반→몸통 순서·동기화를 맞추세요. (전진 운동량 중심 엘리트 스타일일 수도 있어 영상 병행)',early_trunk_open:'몸통이 골반보다 먼저 열립니다 — 진단1·2의 골반 닫힘·X-factor 보존을 우선하세요.',delayed_trunk:'골반 뒤 몸통 반응이 늦습니다 — 골반 회전 직후 몸통이 따라오는 타이밍을 당기세요.',trunk_self:'몸통 회전은 큰데 골반 에너지로 증폭된 게 아니라 몸통 자체 회전에 의존하는 신호입니다 — 골반→몸통 동기화를 높이세요.'})[P.type]+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 무릎전달','ed-knee')+btn('몸통 에너지 ›','ed-trunk','var(--cyan)')+'</div>';
  root.innerHTML=html;
  try{ root.insertAdjacentHTML('afterbegin','<div id="ed-body-xftiming"></div>'); renderEdXFactorTiming(); _injectVarLabels('xftiming'); }catch(e){}
  try{ _redrawXfCharts(); }catch(e){}
  try{ _redrawPtCharts(); }catch(e){}
}
function _redrawPtCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, P=X&&X.pelvistrunk6; if(!P) return;
  if(!document.getElementById('ed-pt-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, idx=(P.events&&P.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.25,endEv:'i_br',endOff:0.03};
  // 1. 골반 회전 — 골반 회전속도(좌) + 골반 각가속(우)
  try{ plotWin('ed-pt-1',Object.assign({left:{label:'골반 회전속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'골반 회전속도',width:2.4}]},
    right:{label:'골반 각가속 (÷100 °/s²)',lines:[{compute:function(t){return _blkPelvisAcc(t).map(function(x){return x/100;});},color:'#5bb6e6',label:'골반 각가속(÷100)',width:1.8}]},
    extraEvents:ev([['PPV','#5bd3ff'],['PEP','#46c98c']])},W)); }catch(e){}
  // 2. 몸통 증폭 gain — 골반·몸통 회전속도(좌)
  try{ plotWin('ed-pt-2',Object.assign({left:{label:'회전속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'골반 회전속도',width:2.4},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'몸통 회전속도',width:2.4}]},
    extraEvents:ev([['PPV','#5bd3ff'],['TVP','#8ea9cf']])},W)); }catch(e){}
  // 3. 타이밍·순서 — 골반·몸통 회전속도(좌) + 회전 가속(우)
  try{ plotWin('ed-pt-3',Object.assign({left:{label:'회전속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'골반 회전속도',width:2.4},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'몸통 회전속도',width:2.4}]},
    right:{label:'회전 가속 (÷100 °/s²)',lines:[
    {compute:function(t){return _blkPelvisAcc(t).map(function(x){return x/100;});},color:'#5bb6e6',label:'골반 각가속(÷100)',width:1.6},
    {compute:function(t){return _ptTrkAcc(t).map(function(x){return x/100;});},color:'#9aa7b6',label:'몸통 각가속(÷100)',width:1.6}]},
    extraEvents:ev([['PPV','#5bd3ff'],['TVP','#8ea9cf']])},W)); }catch(e){}
  // 4. 에너지 핸드오프 — 골반·몸통 에너지(좌) + 몸통E 생성률(우)
  try{ plotWin('ed-pt-4',Object.assign({left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Pelvis_ME_X;},color:'#5bd3ff',label:'골반 에너지',width:2.4},
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4}]},
    right:{label:'몸통 에너지 생성률 (J/s)',lines:[{compute:function(t){var a=t.series.Trunk_ME_X,dt=(t.meta&&t.meta.dt)||0.00333;if(!a)return null;var o=[];for(var i=0;i<a.length;i++){o[i]=(i===0||!isFinite(a[i])||!isFinite(a[i-1]))?NaN:Math.max(0,(a[i]-a[i-1])/dt);}return o;},color:'#46c98c',label:'몸통E 생성률',width:1.8}]},
    extraEvents:ev([['PEP','#5bd3ff'],['TEP','#c084fc']])},W)); }catch(e){}
  // 5. X-factor 풀림 → 몸통 — 풀림속도·몸통 회전속도(좌) + 몸통E(우)
  try{ plotWin('ed-pt-5',Object.assign({left:{label:'속도 (°/s)',lines:[
    {compute:function(t){return _xfUncoil(t);},color:'#c084fc',label:'X-factor 풀림속도',width:2.2},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'몸통 회전속도',width:2.2}]},
    right:{label:'몸통 에너지 (J)',lines:[{compute:function(t){return t.series.Trunk_ME_X;},color:'#5bd3ff',label:'몸통 에너지',width:2.0}]},
    extraEvents:ev([['TEP','#5bd3ff']])},W)); }catch(e){}
}
// ── 진단7 몸통 회전+굴곡 에너지 전용 화면 (개발문서 v1) ──
function renderEdTrunk(){
  var root=document.getElementById('ed-body-trunk'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, T=X&&X.trunk7;
  if(!T){ root.innerHTML='<div class="card"><div class="note">몸통 에너지 데이터가 없습니다 (Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  function sectionHdr(num,title,desc){ return '<div class="card" style="grid-column:1 / -1;background:var(--bg2);border-left:5px solid var(--cyan)"><div style="font-size:15px;font-weight:800;color:var(--cyan)">'+num+'. '+title+'</div><div class="note" style="margin-top:2px">'+desc+'</div></div>'; }
  var N=T.norm||{};
  var PT=X&&X.pelvistrunk6, AA=X&&X.trunkarm8, AN=(AA&&AA.norm)||{};
  var _ftT=(typeof _fastTrial==='function')?_fastTrial():null, _isxT=(T.events&&T.events.idx)||{}, _EVTt=_edEvtListG(_isxT,_ftT);
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:200px;display:block;margin-top:8px"></canvas>'
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTt, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _tgTrkE(f){ return _edSV(_ftT,'Trunk_ME_X',f,1); }
  function _tgRotV(f){ return _edSV(_ftT,'Thorax_Ang_Vel_Z',f,1,true); }
  function _tgFlexV(f){ return _edSV(_ftT,'Thorax_Ang_Vel_X',f,1,true); }
  // ── FC 자세각(굽힘각·열림각) ──
  var _GN=(typeof BIOMOTION_NORMS!=='undefined'&&BIOMOTION_NORMS)?BIOMOTION_NORMS:{};
  var _iFC=(_ftT&&_ftT.events)?_ftT.events.i_fc:null;
  var _RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L');
  var _lean=null,_open=null;
  if(_ftT&&_iFC!=null){ var _tx=_ftT.series&&_ftT.series.Trunk_Angle_X, _tz=_ftT.series&&_ftT.series.Trunk_Angle_Z;
    if(_tx&&isFinite(_tx[_iFC])) _lean=Math.round(-_tx[_iFC]);
    if(_tz&&isFinite(_tz[_iFC])) _open=Math.round(_RHP?(90-_tz[_iFC]):(_tz[_iFC]-90)); }
  var _flowBand=_edFlowBand([{label:'① 골반→몸통 증폭(받기)',val:(PT&&PT.ampScore!=null)?PT.ampScore+'점':null,state:_scoreState(PT&&PT.ampScore)},{label:'② 회전·굴곡 에너지 생성',val:(T.eTotalPeak!=null)?T.eTotalPeak+'J':null,state:_scoreState(T.prodScore)},{label:'③ 몸통→팔 전달',val:(AA&&AA.trunkArmHandoff!=null)?String(AA.trunkArmHandoff):null,state:_scoreState(AA&&AA.taScore)},{label:'④ 팔로 전달',val:(AA&&AA.armSelfReliance!=null)?'ASR '+AA.armSelfReliance:null,state:_scoreState(AA&&AA.taScore)}],'골반에서 받아(①) 몸통이 회전·굴곡으로 키운 에너지를(②) 팔로 넘깁니다(③④). 전달이 약하면 팔이 스스로 더 만들어야 해 부담이 커집니다(팔 에너지 탭).');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">몸통 — 에너지 생성과 전달 · <span style="color:var(--cyan)">'+T.typeKo+'</span></div><div style="font-size:13px;font-weight:800">에너지 생산 점수 '+v(T.prodScore)+'점</div></div>'
    +'<div class="note" style="margin-top:3px;font-style:italic">몸통은 투구의 가장 큰 엔진입니다 — 얼마나 만들고(A 생성), 골반에서 받아 팔로 넘기는가(B 전달).</div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+T.summary+'</div></div>';
  // ═══════ A. 몸통 에너지 생성 ═══════
  html+=sectionHdr('A','몸통 에너지 생성','몸통이 회전·굴곡으로 만든 에너지와 FC 시 출발 자세. 안 보는 것: 전달(아래 B)·팔 부하(팔 에너지 탭).');
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('합 에너지 peak',v(T.eTotalPeak,'J'),'중앙 '+v(N.eTotal&&N.eTotal.med,'J'))
    +kpi('수직축 회전에너지',v(T.eRotPeak,'J'),v(T.rotShare,'%')+' · '+v(T.rotVelPeak,'°/s'))
    +kpi('굴곡 회전에너지',v(T.eFlexPeak,'J'),v(T.flexShare,'%')+' · '+v(T.flexVelPeak,'°/s'))
    +kpi('에너지 peak 시점',ms(T.tTEPms),'중앙 +'+v(N.tTEP&&N.tTEP.med,'ms'))
    +kpi('에너지 생성률 peak',v(T.energyGainRate,'J/s'),'')
    +'</div></div>';
  // 생성: 합/회전·굴곡/시점 통합 1카드 + 통합 차트(ed-tr-1)
  html+=card('A-1. 몸통 에너지 — 합 · 수직축 회전 · 굴곡 회전 · 시점',
    '몸통이 만든 전체 기계 에너지와, 그것이 수직축 회전에서 나왔는지 앞으로 굴곡하며 나왔는지, 또 언제 정점에 오는지',
    '합 에너지 peak <b>'+v(T.eTotalPeak,'J')+'</b> (FC'+ms(T.tTEPms)+', 코호트 중앙 '+v(N.eTotal&&N.eTotal.med,'J')+') · 수직축 회전 <b>'+v(T.eRotPeak,'J')+' ('+v(T.rotShare,'%')+')</b> · 굴곡 <b>'+v(T.eFlexPeak,'J')+' ('+v(T.flexShare,'%')+')</b> · 생성률 '+v(T.energyGainRate,'J/s'),
    '아래 한 그래프로 본다: <b>보라=몸통 에너지</b>(합), <b>노랑=수직축 회전속도</b>(이른 시점), <b>초록=굴곡속도</b>(릴리스 근처). 회전·굴곡 에너지는 de Leva(1996) 분절관성(질량 0.4346×체중, 회전반경 축회전 0.169·굴곡 0.328)을 ω²에 곱해 산출 — 굴곡축 관성이 ~3.8배라 각속도가 작아도 굴곡 기여가 큼(코호트 회전 중앙 '+v(N.rotShare&&N.rotShare.med,'%')+'). 에너지 peak가 팔 전달과 정렬되는 시점이 중요.',
    (T.eTotalPeak!=null&&N.eTotal&&T.eTotalPeak>=N.eTotal.q1)?'에너지 생산은 충분 — 다음은 이 에너지가 팔로 잘 넘어가는지(B 전달)가 관건.':'합 에너지가 코호트 하위 — 팔을 더 쓰기보다 몸통 에너지(회전·굴곡 조합)를 먼저 키우기.',
    vB('ed-tr-1',[{label:'몸통 에너지',unit:'J',get:_tgTrkE},{label:'몸통 회전속도',unit:'°/s',get:_tgRotV},{label:'몸통 굴곡속도',unit:'°/s',get:_tgFlexV}],{name:'A-1. 몸통 에너지(합·수직축 회전·굴곡·시점)',def:'몸통이 만든 전체 기계 에너지와 회전/굴곡 기여·생성 시점.',calc:'Trunk_ME peak·회전/굴곡 관성×각속도²(de Leva)·peak 시점.',interp:'충분하면 다음은 팔로의 전달이 관건. 회전은 이른 시점, 굴곡은 릴리스 근처.',evalm:'코호트 중앙·IQR 대비.'}));
  // FC 자세 카드
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">A-2. FC 시 몸통 자세 (에너지 생성의 출발 자세)</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> 앞발 착지(FC) 순간 몸통이 얼마나 세워져 있고(굽힘각) 얼마나 닫혀 있는가(열림각) — 이후 회전·굴곡 에너지 생성의 출발 자세입니다.</div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">'
    +kpi('FC 몸통 굽힘각',v(_lean,'°'),'직립=0·뒤로+ · 중앙 '+v(_GN.leanBack&&_GN.leanBack.med,'°'))
    +kpi('FC 수직축 대비 열림각',v(_open,'°'),'정면=0·홈쪽+ · 중앙 '+v(_GN.openAng&&_GN.openAng.med,'°'))
    +'</div>'
    +'<div class="note" style="margin-top:6px"><b>해석:</b> 열림각이 코호트(중앙 '+v(_GN.openAng&&_GN.openAng.med,'°')+')보다 크게 양(+)이면 FC에서 몸통이 일찍 열린(flying open) 것으로 회전 에너지를 미리 흘릴 수 있고, 굽힘각이 음수(앞으로 굽음)면 FC에서 상체가 앞으로 빠진 상태입니다.</div></div>';
  // ═══════ B. 몸통 에너지 전달 ═══════
  html+=sectionHdr('B','몸통 에너지 전달','골반에서 받아(증폭) 팔로 넘기는 흐름. 안 보는 것: 팔 관절 부하(팔 에너지 탭).');
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800;color:#ff6b9d">B-1. 골반 → 몸통 (전달받아 증폭)'+(PT&&PT.typeKo?' · <span style="color:var(--cyan)">'+PT.typeKo+'</span>':'')+(PT&&PT.ampScore!=null?' · 증폭 점수 '+PT.ampScore+'점':'')+'</div>'
    +(PT&&PT.summary?'<div class="note" style="margin-top:3px">'+PT.summary+'</div>':'')
    +'<div class="note" style="margin-top:3px" id="tr-amp-lbl">—</div><canvas id="tr-amp" style="width:100%;height:210px;display:block;margin-top:8px"></canvas>'
    +'<div style="margin-top:6px">'+btn('골반→몸통 자세히 ›','ed-pelvistrunk','var(--cyan)')+'</div></div>';
  // B-2 몸통→팔: 요약(핸드오프 1차트 + KPI + 자세히 버튼) — 상세는 ed-trunkarm
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800;color:#5bd3ff">B-2. 몸통 → 팔 (핸드오프로 전달)'+(AA&&AA.typeKo?' · <span style="color:var(--cyan)">'+AA.typeKo+'</span>':'')+(AA&&AA.taScore!=null?' · 전달 점수 '+AA.taScore+'점':'')+'</div>'
    +'<div class="note" style="margin-top:3px">몸통이 만든 에너지를 팔(어깨 내회전)로 넘기는 타이밍·효율. 아래 한 그래프로: <b>보라=몸통 에너지(방출↓)</b>, <b>주황=팔 에너지(상승↑)</b> — 두 곡선이 시간적으로 겹칠수록 잘 전달된 것.</div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">'
    +kpi('전달 동기화(handoff)',v(AA&&AA.trunkArmHandoff),'중앙 '+v(AN.handoff&&AN.handoff.med))
    +kpi('팔 자체 의존(ASR)',v(AA&&AA.armSelfReliance),'낮을수록 좋음·중앙 '+v(AN.asr&&AN.asr.med))
    +kpi('몸통E→어깨IR 간격',ms(AA&&AA.dtTEPtoShoulderIR),'중앙 '+v(AN.dtTEPtoSIR&&AN.dtTEPtoSIR.med,'ms'))
    +'</div>'
    +'<canvas id="tr-ta-mini" style="width:100%;height:210px;display:block;margin-top:8px"></canvas>'
    +'<div style="margin-top:6px">'+btn('몸통→팔 전달 자세히 ›','ed-trunkarm','var(--cyan)')+btn('팔 에너지 ›','ed-armball')+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 골반→몸통','ed-pelvistrunk')+btn('팔 에너지 ›','ed-armball','var(--cyan)')+'</div>';
  root.innerHTML=_flowBand+html;
  try{ _redrawTrCharts(); }catch(e){}
  try{ _redrawTrunkAmp(); }catch(e){}
}
function _redrawTrunkAmp(){
  if(!document.getElementById('tr-amp')) return;
  var _tf=(typeof _fastTrial==='function')?_fastTrial():null, _ts=(typeof _slowTrial==='function')?_slowTrial():null; if(!_tf) return;
  var _fc=(_tf.events&&_tf.events.i_fc)||0,_br=(_tf.events&&_tf.events.i_br)||0,_dt=(_tf.meta&&_tf.meta.dt)||0.00333;
  function _pk(nm){var a=_tf.series[nm];if(!a)return null;var bi=null,bv=-1;for(var i=_fc;i<=_br&&i<a.length;i++){if(isFinite(a[i])&&Math.abs(a[i])>bv){bv=Math.abs(a[i]);bi=i;}}return bi;}
  var _pp=_pk('Pelvis_Ang_Vel_Z'),_tp=_pk('Thorax_Ang_Vel_Z');
  var _W={fast:_tf,slow:_ts,startEv:'i_fc',startOff:-0.05,endEv:'i_br',endOff:0.03,extraEvents:[{label:'FC',frame:_fc,color:'#cfd6e0',width:1.6},{label:'MER',frame:(_tf.events&&_tf.events.i_mer),color:'#9aa7b6'},{label:'BR',frame:(_tf.events&&_tf.events.i_br),color:'#4a90c8'},{label:'골반P',frame:_pp,color:'#8ea9cf',width:2.2},{label:'몸통P',frame:_tp,color:'#86a8d0',width:2.2}].filter(function(e){return e.frame!=null;}),noBuiltinEv:true};
  try{ plotWin('tr-amp',Object.assign({noGauge:true,left:{label:'회전 속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'골반',width:2.4},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#86a8d0',label:'몸통',width:2.4}]}},_W)); }catch(e){}
  try{ var _g=(_pp!=null&&_tp!=null)?Math.round((_tp-_pp)*_dt*1000):null,_ok=(_pp!=null&&_tp!=null&&_pp<=_tp),_l=document.getElementById('tr-amp-lbl'); if(_l)_l.innerHTML='<b style="color:#ff6b9d;font-size:15px">골반 peak → 몸통 peak '+(_g!=null?('+'+_g+'ms'):'–')+'</b> (몸통 증폭 타이밍) · '+(_ok?'<b style="color:#46c98c">✓ 증폭 정상</b>':'<b style="color:#ff6b6b">✗ 순서 역전</b>'); }catch(e){}
}
function _redrawTrCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, T=X&&X.trunk7; if(!T) return;
  if(!document.getElementById('ed-tr-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, idx=(T.events&&T.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.25,endEv:'i_br',endOff:0.03};
  // 몸통→팔 요약 미니차트(B-2): 몸통E vs 팔E 핸드오프
  try{ plotWin('tr-ta-mini',Object.assign({noGauge:true,left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4},
    {compute:function(t){return (typeof _taArmE==='function')?_taArmE(t):null;},color:'#4a90c8',label:'팔 에너지',width:2.4}]}},W)); }catch(e){}
  // 1. 몸통 총 에너지 — 몸통E(좌) + 회전·굴곡속도(우)
  try{ plotWin('ed-tr-1',Object.assign({left:{label:'몸통 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 총 에너지',width:2.4}]},
    right:{label:'각속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'회전속도',width:2.0},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#46c98c',label:'굴곡속도',width:2.0}]},
    extraEvents:ev([['TEP','#c084fc'],['TRotP','#8ea9cf'],['TFlexP','#46c98c']])},W)); }catch(e){}
  // 2. 회전/굴곡 기여 — 회전속도·굴곡속도(좌)
  try{ plotWin('ed-tr-2',Object.assign({left:{label:'각속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'회전속도',width:2.4},
    {compute:function(t){var a=t.series.Thorax_Ang_Vel_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#46c98c',label:'굴곡속도',width:2.4}]},
    extraEvents:ev([['TRotP','#8ea9cf'],['TFlexP','#46c98c']])},W)); }catch(e){}
  // 3. 에너지 생성 시점 — 몸통E(좌) + 생성률(우)
  try{ plotWin('ed-tr-3',Object.assign({left:{label:'몸통 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4}]},
    right:{label:'에너지 생성률 (J/s÷20)',lines:[
    {compute:function(t){var a=t.series.Trunk_ME_X,dt=(t.meta&&t.meta.dt)||0.00333;if(!a)return null;var o=[];for(var i=0;i<a.length;i++){o[i]=(i===0||!isFinite(a[i])||!isFinite(a[i-1]))?NaN:Math.max(0,(a[i]-a[i-1])/dt)/20;}return o;},color:'#46c98c',label:'생성률(÷20)',width:1.8}]},
    extraEvents:ev([['TEP','#c084fc']])},W)); }catch(e){}
  // 4. 팔 전달 예고 — 몸통E·상완E(좌) + 어깨 내회전속도(우)
  try{ plotWin('ed-tr-4',Object.assign({left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4},
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#4a90c8',label:'상완 에너지',width:2.2}]},
    right:{label:'어깨 내회전속도 (°/s)',lines:[{compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'어깨 내회전속도',width:1.8}]},
    extraEvents:ev([['TEP','#c084fc'],['SIRP','#5bd3ff']])},W)); }catch(e){}
}
// ── 진단8 몸통→팔 핸드오프 전용 화면 (개발문서 v1 · 핵심) ──
function _taSide(){ return (((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L')?'r':'l'; }
function _taComSpeed(t,prox,dist,r){ var fr=t.frames||[],dt=(t.meta&&t.meta.dt)||0.00333,n=fr.length,o=new Array(n); for(var i=0;i<n;i++){var a=fr[i],b=fr[i-1];if(!a||!b||!a[prox]||!a[dist]||!b[prox]||!b[dist]){o[i]=NaN;continue;}var s=0;for(var k=0;k<3;k++){var c1=a[prox][k]+r*(a[dist][k]-a[prox][k]),c0=b[prox][k]+r*(b[dist][k]-b[prox][k]);s+=(c1-c0)*(c1-c0);}o[i]=Math.sqrt(s)/dt/1000;}return o; }
function _taArmE(t){ var S=t.series||{},side=_taSide(),m=_blkMass(),mfa=0.0162*m,mh=0.0061*m,hum=S.Pitching_Humerus_ME_X||[]; var vfa=_taComSpeed(t,side+'_elbow',side+'_wrist',0.4574),vh=_taComSpeed(t,side+'_wrist',side+'_hand_tip',0.79),n=Math.max(hum.length,vfa.length),o=new Array(n); for(var i=0;i<n;i++){var h=isFinite(hum[i])?hum[i]:0,kfa=isFinite(vfa[i])?0.5*mfa*vfa[i]*vfa[i]:0,kh=isFinite(vh[i])?0.5*mh*vh[i]*vh[i]:0;o[i]=h+kfa+kh;}return o; }
function _taHandSpeed(t){ var side=_taSide(); return _taComSpeed(t,side+'_wrist',side+'_hand_tip',0.79); }
function renderEdTrunkArm(){
  var root=document.getElementById('ed-body-trunkarm'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, A=X&&X.trunkarm8;
  if(!A){ root.innerHTML='<div class="card"><div class="note">몸통→팔 데이터가 없습니다 (Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  var N=A.norm||{};
  // 각 변인 카드 아래 인라인 그래프+폴더(이벤트표·정의) — 진단2 패턴
  var _faT=(typeof _fastTrial==='function')?_fastTrial():null, _isxA=(A.events&&A.events.idx)||{}, _EVTa=_edEvtListG(_isxA,_faT), _aArm=_faT?_taArmE(_faT):null;
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:195px;display:block;margin-top:8px"></canvas>'
    +''
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTa, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _agTrkE(f){ return _edSV(_faT,'Trunk_ME_X',f,1); }
  function _agArmE(f){ return (_aArm&&isFinite(_aArm[f]))?Math.round(_aArm[f]*10)/10:null; }
  function _agSIR(f){ return _edSV(_faT,'Pitching_Shoulder_Ang_Vel_Z',f,1,true); }
  function _agElbP(f){ return _edSV(_faT,'Pitching_Elbow_Power_X',f,1); }
  function _agHand(f){ var hs=_faT?_taHandSpeed(_faT):null; return (hs&&isFinite(hs[f]))?Math.round(hs[f]*10)/10:null; }
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">몸통→팔 핸드오프 · <span style="color:var(--cyan)">'+A.typeKo+'</span></div><div style="font-size:13px;font-weight:800">전달 점수 '+v(A.taScore)+'점</div></div>'
    +'<div class="note" style="margin-top:3px;font-style:italic">이 단계의 질문: 몸통 에너지가 팔로 넘어갔는가? (이 리포트의 핵심 단계)</div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+A.summary+'</div>'
    +'<div class="note" style="margin-top:5px">팔 속도가 높다고 전달이 좋은 게 아닙니다 — 몸통에서 받은 것인지, 팔이 자체로 만든 것인지를 나눕니다. <b>보는 것:</b> 몸통E→팔E 동기화·팔 자체 의존도(ASR)·몸통E→어깨IR 타이밍. <b>안 보는 것:</b> 공 속도·부하(진단9). · 코호트 '+(N.n||20)+'명. 팔 에너지=위팔 역학적 에너지 + 아래팔·손(de Leva 추정).</div></div>';
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('몸통E→어깨IR 간격',ms(A.dtTEPtoShoulderIR),'코호트 중앙 '+v(N.dtTEPtoSIR&&N.dtTEPtoSIR.med,'ms'))
    +kpi('몸통→팔 전달 동기화',v(A.trunkArmHandoff),'중앙 '+v(N.handoff&&N.handoff.med))
    +kpi('팔 자체 의존(ASR)',v(A.armSelfReliance),'낮을수록 좋음·중앙 '+v(N.asr&&N.asr.med))
    +kpi('팔 총 에너지 peak',v(A.armEnergyPeak,'J'),'상완 '+v(A.humerusEnergyPeak,'J')+'+전완·손')
    +kpi('어깨 내회전속도 peak',v(A.shoulderIRpeak,'°/s'),'FC'+ms(A.events.SIRP))
    +kpi('전달 점수',v(A.taScore),'')
    +'</div></div>';
  html+=card('1. 몸통→팔 전달 동기화 (handoff overlap · 핵심)','몸통 에너지 방출과 팔 에너지 상승이 시간적으로 겹쳤나',
    '전달 동기화 <b>'+v(A.trunkArmHandoff)+'</b> (코호트 중앙 '+v(N.handoff&&N.handoff.med)+') · 몸통E peak FC'+ms(A.events.TEP)+' → 팔E peak FC'+ms(A.events.AEP)+' (팔E '+v(A.armEnergyPeak,'J')+')',
    (A.trunkArmHandoff!=null&&N.handoff&&A.trunkArmHandoff>=N.handoff.q1)?'몸통 에너지 방출과 팔 에너지 상승이 잘 겹쳐, 몸통 힘을 팔이 받아 던집니다.':'몸통 에너지 방출과 팔 에너지 상승의 타이밍이 어긋나, 몸통 힘이 팔로 충분히 넘어가지 못한 신호입니다.',
    '몸통을 더 세게 쓰기보다 몸통 peak 직후 팔이 받는 타이밍을 맞추기',
    vB('ed-ta-1',[{label:'몸통 에너지',unit:'J',get:_agTrkE},{label:'팔(상완+전완+손) 에너지',unit:'J',get:_agArmE},{label:'어깨 내회전속도',unit:'°/s',get:_agSIR}],{name:'1. 몸통→팔 전달 동기화',def:'몸통 에너지 방출과 팔 에너지 상승의 시간 겹침(이 리포트의 핵심).',calc:'몸통E peak 구간과 팔E 상승 구간의 overlap.',interp:'겹칠수록 몸통 힘을 팔이 받아 던짐.',evalm:'코호트 IQR 대비.'}));
  html+=card('2. 몸통→어깨 내회전 타이밍','몸통 에너지 peak 이후 어깨 내회전이 적절히 따라왔나',
    '간격 <b>'+ms(A.dtTEPtoShoulderIR)+'</b> (코호트 중앙 '+v(N.dtTEPtoSIR&&N.dtTEPtoSIR.med,'ms')+') · 어깨 내회전속도 peak '+v(A.shoulderIRpeak,'°/s'),
    (A.dtTEPtoShoulderIR!=null&&A.dtTEPtoShoulderIR<0)?'어깨 내회전이 몸통 에너지보다 먼저 작동해 팔이 앞서는 패턴입니다.':((A.dtTEPtoShoulderIR!=null&&N.dtTEPtoSIR&&A.dtTEPtoShoulderIR>N.dtTEPtoSIR.q3)?'몸통 에너지 peak 후 어깨 내회전이 코호트보다 늦게 따라옵니다(팔 자체 보완 커질 수 있음).':'몸통 에너지 후 어깨 내회전이 적절한 간격으로 이어집니다.'),
    '몸통 peak와 어깨 내회전을 코호트 범위 간격으로 정렬',
    vB('ed-ta-2',[{label:'몸통 에너지',unit:'J',get:_agTrkE},{label:'어깨 내회전속도',unit:'°/s',get:_agSIR}],{name:'2. 몸통→어깨 내회전 타이밍',def:'몸통 에너지 peak 이후 어깨 내회전이 따라오는 간격.',calc:'몸통E peak → 어깨 내회전 정점 간격(ms).',interp:'음수(팔 선행)·과대 지연 모두 팔 자체 보완을 키움.',evalm:'코호트 중앙 대비.'}));
  html+=card('3. 팔 자체 의존도 (Arm Self-Reliance)','팔이 몸통 에너지를 받았나, 팔 자체로 만들었나',
    'ASR <b>'+v(A.armSelfReliance)+'</b> (팔 국소 양의 일 '+v(A.armLocalWork,'J')+' vs 핸드오프 추정, 코호트 중앙 '+v(N.asr&&N.asr.med)+')',
    (A.armSelfReliance!=null&&N.asr&&A.armSelfReliance<=N.asr.q3)?'팔이 몸통 에너지를 받아 던지는 의존도(낮음=좋음)로, 팔 부담이 과하지 않습니다.':'팔이 자체적으로 에너지를 많이 만들어, 부족한 몸통 전달분을 팔이 보완하는 경향(팔 부담↑)입니다.',
    'ASR이 높으면 팔을 더 쓰기보다 몸통→팔 전달을 개선해 팔 부담을 낮추기',
    vB('ed-ta-4',[{label:'팔(상완+전완+손) 에너지',unit:'J',get:_agArmE},{label:'팔꿈치 파워',unit:'W',get:_agElbP}],{name:'3. 팔 자체 의존(ASR)',def:'팔 속도를 몸통 전달이 아니라 팔이 스스로 만든 비율.',calc:'팔 에너지 중 몸통 전달분 외 팔 자체 기여 비율(어깨·팔꿈치 파워·토크).',interp:'낮을수록 몸통 주도(좋음), 높으면 팔 부담↑.',evalm:'낮을수록 양호, 코호트 대비.'}));
  html+=card('4. 팔 내부 시퀀스 (어깨IR→팔꿈치→손)','원위부로 순차 가속되는가',
    '어깨 내회전 peak FC'+ms(A.events.SIRP)+' → 팔꿈치 신전 peak FC'+ms(A.events.EEP)+' (간격 '+ms(A.dtSIRtoElbow)+') → 손속도 peak '+v(A.handSpeedPeak,'m/s')+' FC'+ms(A.events.HSP)+' (팔꿈치→손 '+ms(A.dtElbowToHand)+', 손→BR '+ms(A.dtHandToBR)+')',
    '어깨→팔꿈치→손 순서로 짧은 간격 순차 가속이 원위부 전달의 핵심입니다.',
    '시퀀스가 깨지면 진단9의 release 효율과 함께 점검',
    vB('ed-ta-3',[{label:'어깨 내회전속도',unit:'°/s',get:_agSIR},{label:'손 속도',unit:'m/s',get:_agHand}],{name:'4. 팔 내부 시퀀스',def:'어깨 내회전→팔꿈치 신전→손 순으로 손끝쪽으로 가속되는지.',calc:'SIRP→EEP→HSP 간격(ms)·손 속도 peak(m/s).',interp:'짧은 간격 순차 가속이 손끝쪽 전달의 핵심.',evalm:'순서·간격을 코호트 대비.'}));
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--amber,#e8954e)"><div style="font-size:13px;font-weight:800">5. 팔 부하 예고 (bridge → 진단9에서 상세)</div>'
    +'<div class="note" style="margin-top:4px">팔꿈치 토크 peak '+v(A.elbowTorquePeak,'N·m')+' · 어깨 토크 peak '+v(A.shoulderTorquePeak,'N·m')+' · 팔 국소 양의 일 '+v(A.armLocalWork,'J')+'</div>'
    +'<div class="note" style="margin-top:4px">팔 부담(토크·국소 일)은 진단9 output 대비 cost에서 정식 평가합니다.</div>'
    +'<div style="margin-top:6px">'+btn('팔→공 ›','ed-armball','var(--cyan)')+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">6. 코칭 우선순위</div><div class="note" style="margin-top:4px">'
    +({efficient:'몸통 에너지가 팔로 잘 넘어갑니다 — 현재 전달 패턴을 유지하세요.',delayed_arm:'몸통 peak 이후 어깨 내회전을 더 빨리 연결해 몸통 힘이 식기 전에 팔이 받도록 하세요(팔을 더 쓰는 게 아님).',early_arm:'팔이 몸통보다 먼저 움직입니다 — 몸통 회전을 먼저 완성한 뒤 팔이 따라오도록 순서를 잡으세요.',high_e_low_handoff:'몸통 에너지는 충분합니다 — 몸통을 더 쓰기보다 몸통 peak 직후 어깨 내회전 타이밍을 맞춰 전달을 살리세요.',arm_reliant:'팔 자체 부담으로 구속을 만드는 경향 — 몸통→팔 전달을 개선해 같은 구속을 더 낮은 팔 부담으로 만드세요.'})[A.type]+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 몸통 에너지','ed-trunk')+btn('팔→공 ›','ed-armball','var(--cyan)')+'</div>';
  root.innerHTML=html;
  try{ _redrawTaCharts(); }catch(e){}
}
function _redrawTaCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, A=X&&X.trunkarm8; if(!A) return;
  if(!document.getElementById('ed-ta-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, idx=(A.events&&A.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.25,endEv:'i_br',endOff:0.03};
  try{ plotWin('ed-ta-1',Object.assign({left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4},
    {compute:function(t){return _taArmE(t);},color:'#4a90c8',label:'팔 총 에너지(상완+전완·손)',width:2.4}]},
    right:{label:'팔 에너지 생성률 (J/s)',lines:[{compute:function(t){var a=_taArmE(t),dt=(t.meta&&t.meta.dt)||0.00333,o=[];for(var i=0;i<a.length;i++){o[i]=(i===0||!isFinite(a[i])||!isFinite(a[i-1]))?NaN:Math.max(0,(a[i]-a[i-1])/dt);}return o;},color:'#46c98c',label:'팔E 생성률',width:1.8}]},
    extraEvents:ev([['TEP','#c084fc'],['SIRP','#5bd3ff'],['AEP','#ff7a3c']])},W)); }catch(e){}
  try{ plotWin('ed-ta-2',Object.assign({left:{label:'몸통 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4}]},
    right:{label:'어깨 내회전속도 (°/s)',lines:[{compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'어깨 내회전속도',width:2.2}]},
    extraEvents:ev([['TEP','#c084fc'],['SIRP','#5bd3ff']])},W)); }catch(e){}
  try{ plotWin('ed-ta-3',Object.assign({left:{label:'각속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'어깨 내회전',width:2.0},
    {compute:function(t){var a=t.series.Pitching_Elbow_Ang_Vel_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'팔꿈치 신전',width:2.0}]},
    right:{label:'손 속도 (m/s)',lines:[{compute:function(t){return _taHandSpeed(t);},color:'#4a90c8',label:'손 속도',width:2.2}]},
    extraEvents:ev([['SIRP','#5bd3ff'],['EEP','#8ea9cf'],['HSP','#ff7a3c']])},W)); }catch(e){}
  try{ plotWin('ed-ta-4',Object.assign({left:{label:'관절 파워 (W)',lines:[
    {compute:function(t){return t.series.Pitching_Shoulder_Power_X;},color:'#5bd3ff',label:'어깨 파워',width:2.0},
    {compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#46c98c',label:'팔꿈치 파워',width:2.0}]},
    right:{label:'토크 (N·m)',lines:[
    {compute:function(t){var a=t.series.Pitching_Elbow_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5fa6c0',label:'팔꿈치 토크',width:1.8},
    {compute:function(t){var a=t.series.Pitching_Shoulder_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#6db4e6',label:'어깨 토크',width:1.6}]},
    extraEvents:ev([['SIRP','#5bd3ff'],['EEP','#8ea9cf']])},W)); }catch(e){}
}
// ── 진단9 팔→공 방출 효율·부하 전용 화면 (개발문서 v1) ──
// ── 전완 KE(de Leva 분절 운동학 추정) · 손목·공 제외한 팔 에너지(상완+전완) ──
function _taForearmE(t){ var side=_taSide(),m=_blkMass(),mfa=0.0162*m,vfa=_taComSpeed(t,side+'_elbow',side+'_wrist',0.4574),n=vfa.length,o=new Array(n); for(var i=0;i<n;i++){o[i]=isFinite(vfa[i])?0.5*mfa*vfa[i]*vfa[i]:NaN;} return o; }
function _taArmNoHand(t){ var S=t.series||{},hum=S.Pitching_Humerus_ME_X||[],fe=_taForearmE(t),n=Math.max(hum.length,fe.length),o=new Array(n); for(var i=0;i<n;i++){var h=isFinite(hum[i])?hum[i]:0,f=isFinite(fe[i])?fe[i]:0;o[i]=h+f;} return o; }
// ── 팔 에너지 흐름 차트(받기 / 만들기·전달) — 손목·공 분절 제외 ──
function _redrawArmEnergyCharts(){
  if(!document.getElementById('ed-arm-b')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null; if(!fast) return;
  var W={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.1,endEv:'i_br',endOff:0.03,
    extraEvents:[{label:'FC',frame:fast.events.i_fc,color:'#cfd6e0',width:1.6},{label:'MER',frame:fast.events.i_mer,color:'#9aa7b6'},{label:'BR',frame:fast.events.i_br,color:'#4a90c8'}].filter(function(e){return e.frame!=null;}),noBuiltinEv:true};
  // A 받기: 몸통E vs 팔E(상완+전완) 겹침
  try{ plotWin('ed-arm-a',Object.assign({noGauge:true,left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#c084fc',label:'몸통 에너지',width:2.4},
    {compute:function(t){return _taArmNoHand(t);},color:'#4a90c8',label:'팔 에너지(상완+전완)',width:2.4}]}},W)); }catch(e){}
  // B 만들기·전달: 상완E·전완E(좌) + 어깨·팔꿈치 파워(우)
  try{ plotWin('ed-arm-b',Object.assign({noGauge:true,left:{label:'분절 에너지 (J)',lines:[
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#4a90c8',label:'상완 에너지',width:2.4},
    {compute:function(t){return _taForearmE(t);},color:'#5bd3ff',label:'전완 에너지',width:2.4}]},
    right:{label:'관절 파워 (W)',lines:[
    {compute:function(t){return t.series.Pitching_Shoulder_Power_X;},color:'#8ea9cf',label:'어깨 파워',width:1.8},
    {compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#46c98c',label:'팔꿈치 파워(+신전)',width:1.8}]}},W)); }catch(e){}
  // B-2 어깨→전완 전달(팔꿈치 경유): 관절 파워
  try{ plotWin('ed-arm-b2',Object.assign({noGauge:true,left:{label:'관절 파워 (W)',lines:[
    {compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#46c98c',label:'팔꿈치 파워(+신전)',width:2.4},
    {compute:function(t){return t.series.Pitching_Shoulder_Power_X;},color:'#8ea9cf',label:'어깨 파워',width:2.0}]}},W)); }catch(e){}
  // C-2 부담: 팔꿈치 외반토크·어깨 토크
  try{ plotWin('ed-arm-c',Object.assign({noGauge:true,left:{label:'관절 토크 (N·m)',lines:[
    {compute:function(t){var a=t.series.Pitching_Elbow_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5fa6c0',label:'팔꿈치 외반토크',width:2.4},
    {compute:function(t){var a=t.series.Pitching_Shoulder_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#6db4e6',label:'어깨 토크',width:2.0}]}},W)); }catch(e){}
}
// ── ASR(자체 의존도) vs 팔꿈치 토크 4분면 — 우상=자체생성·고부하(부상위험) ──
function drawArmRiskQuad(cid){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, TA=X&&X.trunkarm8, AB=X&&X.armball9; var canvas=document.getElementById(cid); if(!canvas||!TA||!AB) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var dark=(typeof matchMedia!=='undefined'&&matchMedia('(prefers-color-scheme: dark)').matches);
  var txt=dark?'#e8ecf2':'#2c2c2a', mut=dark?'#9aa3ad':'#6b6a66', grid=dark?'#33363c':'#e2e0d8';
  var pad={l:54,r:14,t:14,b:34}, pr={x:pad.l,y:pad.t,w:w-pad.l-pad.r,h:h-pad.t-pad.b};
  var asr=TA.armSelfReliance, et=AB.elbowTorquePeak, AN=TA.norm||{}, BN=AB.norm||{};
  if(asr==null||et==null){ctx.fillStyle=mut;ctx.textAlign='center';ctx.fillText('— 데이터 없음 —',w/2,h/2);return;}
  var aMed=(AN.asr?AN.asr.med:0.17), aq1=(AN.asr?AN.asr.q1:0.12), aq3=(AN.asr?AN.asr.q3:0.2);
  var tMed=(BN.elbowTorque?BN.elbowTorque.med:51), tq1=(BN.elbowTorque?BN.elbowTorque.q1:43), tq3=(BN.elbowTorque?BN.elbowTorque.q3:65);
  var xmin=Math.min(aq1-0.05,asr-0.03), xmax=Math.max(aq3+0.08,asr+0.03), ymin=Math.min(tq1-15,et-10), ymax=Math.max(tq3+25,et+10);
  function gx(x){return pr.x+(x-xmin)/((xmax-xmin)||1)*pr.w;} function gy(y){return pr.y+pr.h-(y-ymin)/((ymax-ymin)||1)*pr.h;}
  var mx=gx(aMed), my=gy(tMed);
  ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='top';ctx.fillStyle=mut;
  ctx.fillText('전달 의존·저부하',pr.x+4,pr.y+4); ctx.textAlign='right'; ctx.fillStyle=dark?'#e07a78':'#b3261e'; ctx.fillText('자체생성·고부하(부상위험)',pr.x+pr.w-4,pr.y+4);
  ctx.textAlign='left';ctx.textBaseline='bottom';ctx.fillStyle=dark?'#46c98c':'#0f6e56'; ctx.fillText('몸통 주도·저부하(이상적)',pr.x+4,pr.y+pr.h-4); ctx.textAlign='right';ctx.fillStyle=mut; ctx.fillText('자체생성·저부하',pr.x+pr.w-4,pr.y+pr.h-4);
  ctx.strokeStyle=grid;ctx.lineWidth=1;ctx.setLineDash([4,4]);ctx.beginPath();ctx.moveTo(mx,pr.y);ctx.lineTo(mx,pr.y+pr.h);ctx.stroke();ctx.beginPath();ctx.moveTo(pr.x,my);ctx.lineTo(pr.x+pr.w,my);ctx.stroke();ctx.setLineDash([]);
  ctx.strokeStyle=mut;ctx.beginPath();ctx.moveTo(pr.x,pr.y);ctx.lineTo(pr.x,pr.y+pr.h);ctx.lineTo(pr.x+pr.w,pr.y+pr.h);ctx.stroke();
  ctx.fillStyle=mut;ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('팔 자체 의존도 ASR →',pr.x+pr.w/2,pr.y+pr.h+16);
  ctx.save();ctx.translate(14,pr.y+pr.h/2);ctx.rotate(-Math.PI/2);ctx.fillText('팔꿈치 토크 (N·m) ↑',0,0);ctx.restore();
  var px=gx(asr),py=gy(et); ctx.fillStyle='#c084fc';ctx.beginPath();ctx.arc(px,py,6,0,7);ctx.fill();ctx.strokeStyle=dark?'#0b0d12':'#fff';ctx.lineWidth=1.5;ctx.stroke();
  ctx.fillStyle=txt;ctx.font='bold 11px system-ui';ctx.textAlign='center';ctx.textBaseline='bottom';ctx.fillText(((X.player&&X.player.name)||'선수')+' ASR '+asr+'·'+et+'N·m',px,py-8);
}
function renderEdArmBall(){
  var root=document.getElementById('ed-body-armball'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, TA=X&&X.trunkarm8, AB=X&&X.armball9;
  if(!TA&&!AB){ root.innerHTML='<div class="card"><div class="note">팔 에너지 데이터가 없습니다 (Theia 분석 필요).</div></div>'; return; }
  TA=TA||{}; AB=AB||{};
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  function kpi(lbl,val,sub){ return '<div style="flex:1 1 130px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px">'+val+'</div>'+(sub?'<div class="note" style="font-size:11px;margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  function sectionHdr(num,title,desc){ return '<div class="card" style="grid-column:1 / -1;background:var(--bg2);border-left:5px solid var(--cyan)"><div style="font-size:15px;font-weight:800;color:var(--cyan)">'+num+'. '+title+'</div><div class="note" style="margin-top:2px">'+desc+'</div></div>'; }
  var TN=TA.norm||{}, BN=AB.norm||{};
  var _faT=(typeof _fastTrial==='function')?_fastTrial():null;
  var _isxB=(AB.events&&AB.events.idx)||(TA.events&&TA.events.idx)||{}, _EVTb=_edEvtListG(_isxB,_faT);
  function _pk(nm){ var a=_faT&&_faT.series&&_faT.series[nm]; if(!a)return null; var fc=(_faT.events&&_faT.events.i_fc)||0,br=(_faT.events&&_faT.events.i_br)||(a.length-1),mx=null; for(var i=fc;i<=br&&i<a.length;i++){if(isFinite(a[i])){var vv=Math.abs(a[i]); if(mx==null||vv>mx)mx=vv;}} return mx==null?null:Math.round(mx); }
  function _pkArr(arr){ if(!arr||!_faT)return null; var fc=(_faT.events&&_faT.events.i_fc)||0,br=(_faT.events&&_faT.events.i_br)||(arr.length-1),mx=null; for(var i=fc;i<=br&&i<arr.length;i++){if(isFinite(arr[i])){if(mx==null||arr[i]>mx)mx=arr[i];}} return mx==null?null:Math.round(mx); }
  var _humP=_pk('Pitching_Humerus_ME_X'), _foreP=_faT?_pkArr(_taForearmE(_faT)):null, _shP=_pk('Pitching_Shoulder_Power_X'), _elP=_pk('Pitching_Elbow_Power_X');
  function vB(cid,evRows,def,extra){ return '<canvas id="'+cid+'" style="width:100%;height:195px;display:block;margin-top:8px"></canvas>'+(extra||'')
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTb, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _bgHumE(f){ return _edSV(_faT,'Pitching_Humerus_ME_X',f,1); }
  function _bgShoP(f){ return _edSV(_faT,'Pitching_Shoulder_Power_X',f,1); }
  function _bgElbP(f){ return _edSV(_faT,'Pitching_Elbow_Power_X',f,1); }
  function _bgForeE(f){ var fe=_faT?_taForearmE(_faT):null; return (fe&&isFinite(fe[f]))?Math.round(fe[f]):null; }
  function _bgTrkE(f){ return _edSV(_faT,'Trunk_ME_X',f,1); }
  function _bgElbT(f){ return _edSV(_faT,'Pitching_Elbow_Moment_X',f,1,true); }
  function _bgShoT(f){ return _edSV(_faT,'Pitching_Shoulder_Moment_X',f,1,true); }
  // 상태 판정(인과 체인)
  var _hand=TA.trunkArmHandoff, _asr=TA.armSelfReliance, _elbT=AB.elbowTorquePeak, _shoT=AB.shoulderTorquePeak;
  var _handOK=(_hand!=null&&TN.handoff&&_hand>=TN.handoff.q1);
  var _asrHigh=(_asr!=null&&TN.asr&&_asr>TN.asr.q3);
  var _torqHigh=(_elbT!=null&&BN.elbowTorque&&_elbT>BN.elbowTorque.q3)||(_shoT!=null&&BN.shoulderTorque&&_shoT>BN.shoulderTorque.q3);
  var _riskHigh=((_handOK?0:1)+(_asrHigh?1:0)+(_torqHigh?1:0))>=2;
  function _col(state){ return state==='good'?'#5bab84':(state==='warn'?'#cb9a4a':'#d65c4d'); }
  function chip(top,val,state){ var c=_col(state); return '<div style="flex:1 1 120px;min-width:110px;text-align:center;background:rgba('+(state==='good'?'74,222,128':(state==='warn'?'255,225,0':'255,77,77'))+',.13);border:1px solid '+c+';border-radius:10px;padding:9px 8px"><div class="note" style="font-size:11px">'+top+'</div><div style="font-size:15px;font-weight:800;color:'+c+';margin-top:2px">'+val+'</div></div>'; }
  function arrow(){ return '<div style="flex:0 0 auto;align-self:center;color:var(--fg2);font-size:18px;font-weight:800">→</div>'; }
  var _causal='<div class="card" style="grid-column:1 / -1;border-left:4px solid '+(_riskHigh?'#e07a78':'#46c98c')+'"><div style="font-size:13px;font-weight:800">핵심 흐름 — 전달이 부족하면 팔 부담이 커진다</div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;align-items:stretch">'
    +chip('① 몸통→팔 전달',v(_hand)+(_handOK?' · 양호':' · 부족'),_handOK?'good':'warn')+arrow()
    +chip('② 팔 자체 의존 ASR',v(_asr)+(_asrHigh?' · 높음':' · 낮음'),_asrHigh?'bad':'good')+arrow()
    +chip('③ 관절 토크',v(_elbT,'N·m')+(_torqHigh?' · 높음':' · 보통'),_torqHigh?'bad':'good')+arrow()
    +chip('④ 부상 위험',_riskHigh?'높음':'관리됨',_riskHigh?'bad':'good')
    +'</div>'
    +'<div class="note" style="margin-top:8px">어깨로부터 에너지 <b>전달이 비효율적</b>이면(①↓), 팔은 빠른 구속을 위해 <b>스스로 더 많이 만들어야 하고</b>(②↑), 그만큼 <b>팔꿈치·어깨 관절 토크가 커져</b>(③↑) <b>부상 위험이 올라갑니다</b>(④). 해법은 팔을 더 쓰는 게 아니라 몸통→팔 전달을 살리는 것입니다.</div></div>';
  // 헤더
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">팔 에너지 — 받기 → 만들기 → 부담</div>'+(AB.ballVelocityKmh!=null?'<div class="note" style="font-size:12px">결과 구속 <b style="color:var(--fg0);font-size:14px">'+AB.ballVelocityKmh+' km/h</b></div>':'')+'</div>'
    +'<div class="note" style="margin-top:3px;font-style:italic">팔이 몸통에서 얼마나 받아(A), 스스로 얼마나 만들어 전완으로 넘기고(B), 그 대가로 관절에 얼마나 부담이 걸리는가(C).</div>'
    +'<div class="note" style="margin-top:5px"><b>안 보는 것:</b> 손목·공 분절(흐름은 전완까지). 팔 에너지=위팔 역학적 에너지 + 아래팔(de Leva 추정). · 코호트 '+(BN.n||TN.n||20)+'명.</div></div>';
  html+=_causal;
  // ═══ A. 받기 ═══
  html+=sectionHdr('A','받기 — 몸통에서 받은 에너지','잘 받으면 팔이 덜 만들어도 됩니다 (몸통 에너지 탭 B-2와 같은 핸드오프를 팔 관점에서).');
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('몸통→팔 전달 동기화',v(TA.trunkArmHandoff),'중앙 '+v(TN.handoff&&TN.handoff.med))
    +kpi('몸통E→어깨IR 간격',ms(TA.dtTEPtoShoulderIR),'중앙 '+v(TN.dtTEPtoSIR&&TN.dtTEPtoSIR.med,'ms'))
    +kpi('받은 결과: 팔 에너지 peak',v(TA.armEnergyPeak,'J'),'상완 '+v(_humP,'J')+'+전완')
    +'</div></div>';
  html+=card('A-1. 몸통→팔 전달 동기화 (handoff)','몸통 에너지 방출과 팔 에너지 상승이 시간적으로 겹쳤나',
    '전달 동기화 <b>'+v(TA.trunkArmHandoff)+'</b> (코호트 중앙 '+v(TN.handoff&&TN.handoff.med)+') · 몸통E→어깨 내회전 간격 '+ms(TA.dtTEPtoShoulderIR),
    (_handOK)?'몸통 에너지가 팔로 잘 넘어옵니다 — 팔이 스스로 많이 만들 필요가 줄어듭니다.':'몸통→팔 전달 타이밍이 어긋나, 팔이 부족분을 자체 생성으로 보완해야 하는 신호입니다(아래 B·C로 이어짐).',
    '몸통을 더 세게 쓰기보다 몸통 peak 직후 팔이 받는 타이밍을 맞추기',
    vB('ed-arm-a',[{label:'몸통 에너지',unit:'J',get:_bgTrkE},{label:'팔 에너지(상완+전완)',unit:'J',get:_bgHumE}],{name:'A-1. 몸통→팔 전달 동기화',def:'몸통 에너지 방출과 팔 에너지 상승의 시간 겹침.',calc:'몸통E peak 구간과 팔E 상승 구간의 overlap.',interp:'겹칠수록 몸통 힘을 팔이 받아 던짐(자체 부담↓).',evalm:'코호트 IQR 대비.'}));
  // ═══ B. 만들기·전달 ═══
  html+=sectionHdr('B','만들기·전달 — 어깨 → 팔꿈치 → 전완','어깨가 만든 에너지를 팔꿈치를 거쳐 전완으로. 손목·공은 흐름에서 제외.');
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('상완 에너지 peak',v(_humP,'J'),'어깨가 만든 분절 에너지')
    +kpi('전완 에너지 peak',v(_foreP,'J'),'de Leva 추정')
    +kpi('어깨 파워 peak',v(_shP,'W'),'어깨 생성')
    +kpi('팔꿈치 파워 peak',v(_elP,'W'),'+신전=전완 공급')
    +'</div></div>';
  html+=card('B-1. 어깨 에너지 생성','어깨가 얼마나 큰 에너지를 만들었나',
    '상완 에너지 peak <b>'+v(_humP,'J')+'</b> · 어깨 파워 peak '+v(_shP,'W'),
    '어깨 내회전·수평내전이 만든 동력이 상완 에너지로 나타납니다. 이 중 상당 부분은 본래 몸통에서 받은 것(A)이어야 하며, A가 약하면 어깨 자체 생성 비중이 커집니다.',
    '어깨 자체 출력을 무리하게 키우기보다 A(전달)로 채우는 것이 부담이 적음',
    vB('ed-arm-b',[{label:'상완 에너지',unit:'J',get:_bgHumE},{label:'전완 에너지',unit:'J',get:_bgForeE},{label:'팔꿈치 파워',unit:'W',get:_bgElbP}],{name:'B-1. 어깨→전완 에너지 흐름',def:'어깨가 만든 상완 에너지가 팔꿈치를 거쳐 전완으로 넘어가는 흐름.',calc:'위팔·아래팔이 가진 에너지와 어깨·팔꿈치가 내는 힘.',interp:'위팔 에너지 peak 후 아래팔 에너지 peak로 이어지면 손끝쪽 전달. 팔꿈치 파워(+)=신전으로 전완에 에너지 공급.',evalm:'peak 순서·크기.'}));
  html+=card('B-2. 어깨 → 전완 전달 (팔꿈치 경유)','어깨 에너지가 팔꿈치를 거쳐 전완으로 넘어갔나',
    '상완 에너지 peak '+v(_humP,'J')+' → 전완 에너지 peak '+v(_foreP,'J')+' · 팔꿈치 파워 peak '+v(_elP,'W')+'(+신전 시 전완으로 공급)',
    '상완 에너지가 정점을 지난 뒤 전완 에너지가 따라 오르면 팔꿈치를 통한 원위 전달이 일어난 것입니다. 팔꿈치가 신전(+파워)하며 전완 속도를 끌어올립니다.',
    '상완→전완 순서가 무너지면 채찍 효과가 약해져 같은 구속에 더 큰 부담이 듭니다',
    '');
  // ═══ C. 릴리스 출력 ═══
  html+=sectionHdr('C','릴리스 출력 — 구속 결과','받아서 만든 에너지가 손끝 구속으로 얼마나 나왔나 (요약 신체맵의 팔 단계와 동일 지표).');
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('릴리스 구속',v(AB.ballVelocityKmh,'km/h'),'결과 출력')
    +kpi('손 속도 peak',v(AB.handSpeedPeak,'m/s'),'중앙 '+v(BN.handSpeed&&BN.handSpeed.med))
    +kpi('어깨 내회전속도',v(TA.shoulderIRpeak,'°/s'),'원위 가속')
    +kpi('전달 효율',v(AB.transferProxy),'공KE/팔E·중앙 '+v(BN.transferProxy&&BN.transferProxy.med))
    +kpi('출력 점수',v(AB.abScore),'output−cost')
    +'</div></div>';
  // ═══ D. 부담 ═══
  html+=sectionHdr('D','부담 — 자체 의존과 부상 위험','전달이 부족할수록 팔이 스스로 만들고(ASR↑) 관절 토크가 커져 부상 위험이 올라갑니다.');
  html+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('팔 자체 의존(ASR)',v(_asr),'낮을수록 좋음·중앙 '+v(TN.asr&&TN.asr.med))
    +kpi('팔꿈치 외반 토크 peak',v(_elbT,'N·m'),'중앙 '+v(BN.elbowTorque&&BN.elbowTorque.med))
    +kpi('어깨 토크 peak',v(_shoT,'N·m'),'중앙 '+v(BN.shoulderTorque&&BN.shoulderTorque.med))
    +(AB.ballPerElbowTorque!=null?kpi('구속/팔꿈치토크',v(AB.ballPerElbowTorque),'높을수록 효율'):'')
    +'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">D-1. 자체 의존도 vs 관절 부하 (한눈에)</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> 팔이 스스로 만든 비율(ASR)과 팔꿈치 토크를 코호트 중앙선 기준 4분면으로. 우상(자체생성·고부하)이 부상 위험 영역입니다.</div>'
    +'<canvas id="ed-arm-quad" style="width:100%;height:255px;display:block;margin-top:8px"></canvas>'
    +'<div class="note" style="font-size:11px;margin-top:2px;color:var(--fg2)">x=ASR(팔 자체 의존도) · y=팔꿈치 토크 · 코호트 중앙선 기준 4분면</div></div>';
  html+=card('D-2. 자체 의존도 (ASR)와 부상 부담','팔이 받았나(좋음), 스스로 만들었나(부담)',
    'ASR <b>'+v(_asr)+'</b> (코호트 중앙 '+v(TN.asr&&TN.asr.med)+', 낮을수록 좋음) · 팔꿈치 외반 토크 '+v(_elbT,'N·m')+' · 어깨 토크 '+v(_shoT,'N·m'),
    (_riskHigh)?'전달이 부족해 팔이 스스로 많이 만들고(ASR↑) 관절 토크도 높습니다 — 부상 위험이 높은 조합입니다.':'팔 자체 의존도와 관절 부하가 관리 범위입니다 — 전달로 부담을 나누고 있습니다.',
    'ASR·토크가 높으면 팔 강화보다 몸통→팔 전달(A)을 우선 개선해 같은 구속을 더 낮은 부담으로',
    '');
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ 몸통 에너지','ed-trunk')+btn('전체 요약','psummary','var(--cyan)')+'</div>';
  root.innerHTML=html;
  try{ _redrawArmEnergyCharts(); }catch(e){}
  try{ drawArmRiskQuad('ed-arm-quad'); }catch(e){}
  try{ _redrawAbCharts(); }catch(e){}
}
function _redrawAbCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, B=X&&X.armball9; if(!B) return;
  if(!document.getElementById('ed-ab-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null;
  var A=(X.trunkarm8)||{}, idx=(A.events&&A.events.idx)||{};
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  var W={fast:fast,slow:slow,startEv:'i_mer',startOff:-0.02,endEv:'i_br',endOff:0.03};
  // 1. Output — 어깨IR·팔꿈치신전(좌) + 손속도(우)
  try{ plotWin('ed-ab-1',Object.assign({left:{label:'각속도 (°/s)',lines:[
    {compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'어깨 내회전',width:2.0},
    {compute:function(t){var a=t.series.Pitching_Elbow_Ang_Vel_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'팔꿈치 신전',width:2.0}]},
    right:{label:'손 속도 (m/s)',lines:[{compute:function(t){return _taHandSpeed(t);},color:'#4a90c8',label:'손 속도',width:2.4}]},
    extraEvents:ev([['SIRP','#5bd3ff'],['EEP','#8ea9cf'],['HSP','#ff7a3c']])},W)); }catch(e){}
  // 2. 전달 효율 — 손속도(좌) + 팔꿈치 파워(우)
  try{ plotWin('ed-ab-2',Object.assign({left:{label:'손 속도 (m/s)',lines:[
    {compute:function(t){return _taHandSpeed(t);},color:'#4a90c8',label:'손 속도',width:2.4}]},
    right:{label:'팔꿈치 파워 (W)',lines:[{compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#46c98c',label:'팔꿈치 파워',width:2.0}]},
    extraEvents:ev([['HSP','#ff7a3c'],['EEP','#8ea9cf']])},W)); }catch(e){}
  // 3. release timing — 손속도(좌) + 어깨IR(우), HSP·BR 마커
  try{ plotWin('ed-ab-3',Object.assign({left:{label:'손 속도 (m/s)',lines:[
    {compute:function(t){return _taHandSpeed(t);},color:'#4a90c8',label:'손 속도',width:2.4}]},
    right:{label:'어깨 내회전속도 (°/s)',lines:[{compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'어깨 내회전',width:1.8}]},
    extraEvents:ev([['HSP','#ff7a3c']])},W)); }catch(e){}
  // 4. Cost — 팔꿈치·어깨 토크(좌) + 손속도(우)
  try{ plotWin('ed-ab-4',Object.assign({left:{label:'토크 (N·m)',lines:[
    {compute:function(t){var a=t.series.Pitching_Elbow_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5fa6c0',label:'팔꿈치 토크',width:2.2},
    {compute:function(t){var a=t.series.Pitching_Shoulder_Moment_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#6db4e6',label:'어깨 토크',width:2.0}]},
    right:{label:'손 속도 (m/s)',lines:[{compute:function(t){return _taHandSpeed(t);},color:'#4a90c8',label:'손 속도',width:2.2}]},
    extraEvents:ev([['HSP','#ff7a3c']])},W)); }catch(e){}
}
// Output vs Cost 2x2: x=공속도, y=팔꿈치토크, 코호트 중앙선
function drawAbQuadrant(cid){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, B=X&&X.armball9; var canvas=document.getElementById(cid); if(!canvas||!B) return;
  var N=B.norm||{}; var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var dark=(typeof matchMedia!=='undefined'&&matchMedia('(prefers-color-scheme: dark)').matches);
  var txt=dark?'#e8ecf2':'#2c2c2a', mut=dark?'#9aa3ad':'#6b6a66', grid=dark?'#33363c':'#e2e0d8';
  var pad={l:54,r:14,t:14,b:34}, pr={x:pad.l,y:pad.t,w:w-pad.l-pad.r,h:h-pad.t-pad.b};
  var bv=B.ballVelocityKmh, et=B.elbowTorquePeak; if(bv==null||et==null){ctx.fillStyle=mut;ctx.textAlign='center';ctx.fillText('— 데이터 없음 —',w/2,h/2);return;}
  var xmin=(N.ballV?N.ballV.q1:130)-6, xmax=(N.ballV?N.ballV.q3:148)+6, ymin=(N.elbowTorque?N.elbowTorque.q1:40)-15, ymax=Math.max((N.elbowTorque?N.elbowTorque.q3:72)+25, et+10);
  function gx(x){return pr.x+(x-xmin)/((xmax-xmin)||1)*pr.w;} function gy(y){return pr.y+pr.h-(y-ymin)/((ymax-ymin)||1)*pr.h;}
  var mx=gx(N.ballV?N.ballV.med:141), my=gy(N.elbowTorque?N.elbowTorque.med:51);
  // 4분면 배경 라벨
  ctx.fillStyle=mut;ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillText('낮은 구속·높은 부하',pr.x+4,pr.y+4); ctx.textAlign='right'; ctx.fillText('높은 구속·높은 부하',pr.x+pr.w-4,pr.y+4);
  ctx.textAlign='left';ctx.textBaseline='bottom'; ctx.fillText('낮은 구속·낮은 부하',pr.x+4,pr.y+pr.h-4); ctx.textAlign='right'; ctx.fillStyle=dark?'#46c98c':'#0f6e56'; ctx.fillText('높은 구속·낮은 부하(이상적)',pr.x+pr.w-4,pr.y+pr.h-4);
  // 중앙선
  ctx.strokeStyle=grid;ctx.lineWidth=1;ctx.setLineDash([4,4]);ctx.beginPath();ctx.moveTo(mx,pr.y);ctx.lineTo(mx,pr.y+pr.h);ctx.stroke();ctx.beginPath();ctx.moveTo(pr.x,my);ctx.lineTo(pr.x+pr.w,my);ctx.stroke();ctx.setLineDash([]);
  // 축
  ctx.strokeStyle=mut;ctx.beginPath();ctx.moveTo(pr.x,pr.y);ctx.lineTo(pr.x,pr.y+pr.h);ctx.lineTo(pr.x+pr.w,pr.y+pr.h);ctx.stroke();
  ctx.fillStyle=mut;ctx.font='10px system-ui';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('공 속도 (km/h) →',pr.x+pr.w/2,pr.y+pr.h+16);
  ctx.save();ctx.translate(14,pr.y+pr.h/2);ctx.rotate(-Math.PI/2);ctx.fillText('팔꿈치 토크 (N·m) ↑',0,0);ctx.restore();
  // 이 선수 점
  var px=gx(bv),py=gy(et); ctx.fillStyle='#c084fc';ctx.beginPath();ctx.arc(px,py,6,0,7);ctx.fill();ctx.strokeStyle=dark?'#0b0d12':'#fff';ctx.lineWidth=1.5;ctx.stroke();
  ctx.fillStyle=txt;ctx.font='bold 11px system-ui';ctx.textAlign='center';ctx.textBaseline='bottom';ctx.fillText(((X.player&&X.player.name)||'선수')+' '+bv+'km/h·'+et+'N·m',px,py-8);
}
// ── etdiag 차트 재그리기 (스틱 재생 프레임마다 호출 → 이동 커서) ──
function _redrawEtCharts(){
  if(!document.getElementById('ef-seq-grf') && !document.getElementById('ef-handoff')) return;
  var _ef=(typeof _fastTrial==='function')?_fastTrial():null, _es=(typeof _slowTrial==='function')?_slowTrial():null, _emass=(DATA.player&&DATA.player.weight_kg)||86;
  try{ plotWin('ef-seq-grf',{fast:_ef,slow:_es,startEv:'i_kl_peak',startOff:0,endEv:'i_br',endOff:0.02,noGauge:true,markPeaks:true,
    left:{label:'각속도 (°/s)',lines:[
      {compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(v){return Math.abs(v);}):null;},color:'#5bd3ff',label:'골반',width:2.4},
      {compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(v){return Math.abs(v);}):null;},color:'#8ea9cf',label:'몸통',width:2.4},
      {compute:function(t){var a=t.series.Pitching_Hand_Ang_Vel_X;return a?a.map(function(v){return Math.abs(v);}):null;},color:'#4a90c8',label:'팔(손)',width:2.4}]},
    right:{label:'앞발 수직 GRF (%BW)',lines:[
      {compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(v){return Math.abs(v)/(_emass*9.81)*100;}):null;},color:'#46c98c',label:'앞발 수직 GRF',width:2.2}]}}); }catch(e){}
  try{ drawHandoff('ef-handoff',_ef,_emass); }catch(e){}
}
// ── Handoff Overlap 차트: 몸통 에너지(Trunk_ME) vs 상완 에너지(Humerus_ME) + 겹침 음영 ──
function drawHandoff(cid,t,mass){
  var canvas=document.getElementById(cid); if(!canvas||!t) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var S=t.series||{}, e=t.events||{}, iFC=e.i_fc, iBR=e.i_br, iKH=e.i_kl_peak, iMER=e.i_mer;
  var tE=S.Trunk_ME_X, aE=S.Pitching_Humerus_ME_X;
  if(!tE||!aE||iFC==null||iBR==null){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 분절 에너지 시계열 없음 —',w/2,h/2); return; }
  var lo=(iKH!=null?iKH:iFC), hi=Math.min(iBR+2, tE.length-1, aE.length-1);
  function pk(a){ var bi=lo,bv=-Infinity; for(var i=lo;i<=hi;i++){ if(isFinite(a[i])&&a[i]>bv){bv=a[i];bi=i;} } return {i:bi,v:bv}; }
  var tp=pk(tE), ap=pk(aE), maxE=Math.max(tp.v,ap.v)||1;
  var ir=S.Pitching_Shoulder_Ang_Vel_Z, iri=null; if(ir){ var irv=-Infinity; for(var i=lo;i<=hi;i++){ var v=Math.abs(ir[i]); if(isFinite(v)&&v>irv){irv=v;iri=i;} } }
  var pr={x:46,y:14,w:Math.max(60,w-60),h:Math.max(10,h-34)};
  function gx(i){ return pr.x+(i-lo)/((hi-lo)||1)*pr.w; }
  function gy(v){ return pr.y+pr.h-(v/maxE)*pr.h; }
  ctx.strokeStyle='#3a4452';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(pr.x,pr.y);ctx.lineTo(pr.x,pr.y+pr.h);ctx.lineTo(pr.x+pr.w,pr.y+pr.h);ctx.stroke();
  // 겹침 음영: 몸통E peak 이후 (몸통E 감소 & 상완E 증가) 구간
  ctx.fillStyle='rgba(192,132,252,0.18)';
  for(var i=tp.i;i<hi;i++){ var dT=tE[i+1]-tE[i], dA=aE[i+1]-aE[i]; if(-dT>0&&dA>0){ ctx.fillRect(gx(i),pr.y,Math.max(1,gx(i+1)-gx(i)),pr.h); } }
  function curve(a,col){ ctx.strokeStyle=col;ctx.lineWidth=2.4;ctx.beginPath();var st=true;for(var i=lo;i<=hi;i++){ if(!isFinite(a[i]))continue; var x=gx(i),y=gy(a[i]); if(st){ctx.moveTo(x,y);st=false;}else ctx.lineTo(x,y); } ctx.stroke(); }
  curve(tE,'#c084fc'); curve(aE,'#ff9a3c');
  function vline(i,col,lab){ if(i==null)return; ctx.strokeStyle=col;ctx.setLineDash([4,3]);ctx.beginPath();ctx.moveTo(gx(i),pr.y);ctx.lineTo(gx(i),pr.y+pr.h);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle=col;ctx.font='10px system-ui';ctx.textAlign='center';ctx.textBaseline='bottom';ctx.fillText(lab,gx(i),pr.y); }
  // 이벤트선 KH·FC·MER·BR (상단 라벨)
  var EVH=[['KH',iKH,'#9aa5b3'],['FC',iFC,'#3b82f6'],['MER',iMER,'#f5c542'],['BR',iBR,'#ff4d4d']];
  ctx.setLineDash([3,3]);ctx.font='9px system-ui';
  EVH.forEach(function(ev){ var i=ev[1]; if(i==null||i<lo||i>hi)return; ctx.strokeStyle=ev[2];ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(gx(i),pr.y);ctx.lineTo(gx(i),pr.y+pr.h);ctx.stroke();ctx.fillStyle=ev[2];ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText(ev[0],gx(i),pr.y+1); });
  ctx.setLineDash([]);
  // 어깨 내회전 속도 peak (전달 타이밍 참고)
  if(iri!=null){ ctx.strokeStyle='#ff7a3c';ctx.setLineDash([2,3]);ctx.globalAlpha=0.7;ctx.beginPath();ctx.moveTo(gx(iri),pr.y);ctx.lineTo(gx(iri),pr.y+pr.h);ctx.stroke();ctx.setLineDash([]);ctx.globalAlpha=1;ctx.fillStyle='#ff7a3c';ctx.font='9px system-ui';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('어깨IR peak',gx(iri),pr.y+12); }
  // 피크 점+값(J): 몸통 에너지(보라)·상완 에너지(주황)
  function pkdot(i,v,col){ if(i==null||!isFinite(v))return; var x=gx(i),y=gy(v); ctx.fillStyle=col;ctx.beginPath();ctx.arc(x,y,3.6,0,2*Math.PI);ctx.fill();ctx.strokeStyle='#0b0d12';ctx.lineWidth=1;ctx.stroke();ctx.fillStyle=col;ctx.font='bold 10px system-ui';ctx.textAlign='center';ctx.textBaseline='bottom';ctx.fillText(Math.round(v)+'J',x,y-4); }
  pkdot(tp.i,tp.v,'#c084fc'); pkdot(ap.i,ap.v,'#ff9a3c');
  // 재생 커서(좌측 스틱 동기화)
  var _cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):null;
  if(_cf!=null && _cf>=lo && _cf<=hi){ ctx.strokeStyle='#e8ecf2';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(gx(_cf),pr.y);ctx.lineTo(gx(_cf),pr.y+pr.h);ctx.stroke(); }
  // 범례
  ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillStyle='#c084fc';ctx.font='10px system-ui';ctx.fillText('몸통 에너지',pr.x+6,pr.y+pr.h-26);
  ctx.fillStyle='#ff9a3c';ctx.fillText('상완 에너지',pr.x+6,pr.y+pr.h-13);
}

// ═══════════════════════════════════════════════════════════════════
// Render: 에너지 흐름 (Energy Flow) — [2026-05-27] 하체→몸통→팔→공 생성·전달·손실 스토리 (Theia/GRF 전용)
//   가이드라인 15.D + 16: "숫자 나열"이 아니라 "에너지 흐름 스토리"를 직관적으로.
// ═══════════════════════════════════════════════════════════════════
function _efStatusHex(s){ return s==='strong'?'#46c98c':(s==='flag'?'#e8954e':'#5bb6e6'); }
// 단계 변인을 key로 1회 수집(여러 단계에 같은 key 없음 가정, 먼저 나온 것 우선)
function _efCollect(P){ var by={}; ((P&&P.stages)||[]).forEach(function(s){ (s.metrics||[]).forEach(function(m){ if(m.key && by[m.key]==null) by[m.key]=m; }); }); return by; }
// 변인 m → 엘리트 규준 대비 상태(강점/정상/교정) + 색/글리프. 규준·dir 없으면 null(중립).
function _efStat(m){
  if(!m || m.value==null) return null;
  var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null;
  if(!nm || !m.dir) return null;
  var s=_bmStat(m.value, nm, m.dir);
  return {status:s.status, z:s.z, col:_efStatusHex(s.status), glyph:_bmStatusGlyph(s.status), nm:nm};
}
function _efLab(st){ return st==='strong'?'강점':(st==='flag'?'교정 필요':'정상'); }
function _efRRect(ctx,x,y,w,h,r){ r=Math.min(r,w/2,h/2); ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }

// ── 흐름 다이어그램: 하체 → 몸통 → 팔 → 공 (생성 J · 전달효율 · 누수) ──
function drawEfFlow(by, fastT){
  var canvas=document.getElementById('ef-flow'); if(!canvas) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  function r0(v){ return (v==null||!isFinite(v))?null:Math.round(v); }
  // 노드 정의 (값/상태)
  var ball=(fastT&&fastT.rapsodo)?fastT.rapsodo:null;
  var nodes=[
    {t:'하체', sub:'드라이브 생성', m:by.driveWork, big:r0(by.driveWork&&by.driveWork.value), unit:'J', desc:'뒷다리 신전 일(KH→FC)'},
    {t:'몸통', sub:'역학에너지', m:by.trunkME, big:r0(by.trunkME&&by.trunkME.value), unit:'J', desc:'회전·굴곡 ME 피크'},
    {t:'팔',   sub:'어깨 에너지 생성', m:by.shGen, big:r0(by.shGen&&by.shGen.value), unit:'J', desc:'FC→BR ∫P dt'},
    {t:'공',   sub:'릴리스', m:null, big:(ball&&ball.velocity_kmh!=null)?Math.round(ball.velocity_kmh*10)/10:null, unit:'km/h', desc:(ball&&ball.total_spin_rpm)?Math.round(ball.total_spin_rpm)+' rpm':'구속'}
  ];
  var nW=120, gap=(w-4*nW)/3;
  if(gap<44){ nW=Math.max(86,Math.floor((w-3*44)/4)); gap=(w-4*nW)/3; }
  var nH=98, ny=Math.round((h-nH)/2)-4;
  // 좌표
  var xs=[]; for(var i=0;i<4;i++){ xs.push(Math.round(i*(nW+gap))); }
  // 화살표 (노드 사이)
  function arrow(x1,x2,yy,col,wdt,lbl,sub){
    ctx.strokeStyle=col; ctx.fillStyle=col; ctx.lineWidth=wdt;
    ctx.beginPath(); ctx.moveTo(x1,yy); ctx.lineTo(x2-9,yy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x2,yy); ctx.lineTo(x2-10,yy-6); ctx.lineTo(x2-10,yy+6); ctx.closePath(); ctx.fill();
    if(lbl){ ctx.fillStyle='#c9d3e0'; ctx.font='bold 11px system-ui'; ctx.textAlign='center'; ctx.textBaseline='bottom'; ctx.fillText(lbl,(x1+x2)/2,yy-7); }
    if(sub){ ctx.fillStyle='#7d8898'; ctx.font='10px system-ui'; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillText(sub,(x1+x2)/2,yy+7); }
  }
  var midY=ny+Math.round(nH/2);
  // ① 하체→몸통 : 블록 전환(comKEdrop) + 누수(kneeAbsE)
  var ke=by.comKEdrop, keS=_efStat(ke), abs=by.kneeAbsE, absS=_efStat(abs);
  var a1col=keS?keS.col:'#5bb6e6';
  arrow(xs[0]+nW, xs[1], midY, a1col, 3.2, '블록 전환', (ke&&ke.value!=null)?(r0(ke.value)+'J 선형→회전'):'선형→회전');
  // 누수 가지(아래로)
  if(abs&&abs.value!=null){
    var lx=Math.round((xs[0]+nW+xs[1])/2), lcol=(absS&&absS.status==='flag')?'#e07a78':'#e8954e';
    ctx.strokeStyle=lcol; ctx.fillStyle=lcol; ctx.lineWidth=2; ctx.setLineDash([4,3]);
    ctx.beginPath(); ctx.moveTo(lx,midY+4); ctx.lineTo(lx,midY+26); ctx.stroke(); ctx.setLineDash([]);
    ctx.beginPath(); ctx.moveTo(lx,midY+30); ctx.lineTo(lx-5,midY+22); ctx.lineTo(lx+5,midY+22); ctx.closePath(); ctx.fill();
    ctx.fillStyle=lcol; ctx.font='10px system-ui'; ctx.textAlign='center'; ctx.textBaseline='top';
    ctx.fillText('누수 '+r0(abs.value)+'J (앞무릎 흡수)', lx, midY+32);
  }
  // ② 몸통→팔 : 채찍비
  var wh=by.whipRatio, whS=_efStat(wh);
  arrow(xs[1]+nW, xs[2], midY, whS?whS.col:'#46c98c', 3.2, '채찍비', (wh&&wh.value!=null)?(wh.value+'× 증폭'):'몸통→팔');
  // ③ 팔→공 : 릴리스
  arrow(xs[2]+nW, xs[3], midY, '#8893a4', 2.6, '릴리스', '');
  // 노드 박스
  nodes.forEach(function(n,idx){
    var st=_efStat(n.m), bcol=st?st.col:'#5b6675';
    var x=xs[idx];
    _efRRect(ctx,x,ny,nW,nH,10); ctx.fillStyle='#161d29'; ctx.fill();
    ctx.lineWidth=2; ctx.strokeStyle=bcol; _efRRect(ctx,x,ny,nW,nH,10); ctx.stroke();
    // 상단 색띠
    ctx.fillStyle=bcol; _efRRect(ctx,x,ny,nW,5,4); ctx.fill(); ctx.fillRect(x,ny+3,nW,3);
    var cx=x+nW/2;
    ctx.textAlign='center'; ctx.fillStyle='#e8ecf2'; ctx.font='bold 14px system-ui'; ctx.textBaseline='top';
    ctx.fillText(n.t, cx, ny+12);
    ctx.fillStyle='#7d8898'; ctx.font='10px system-ui'; ctx.fillText(n.sub, cx, ny+30);
    // 큰 값
    ctx.fillStyle='#e8ecf2'; ctx.font='bold 26px system-ui'; ctx.textBaseline='alphabetic';
    var vtxt=(n.big!=null)?String(n.big):'—';
    ctx.fillText(vtxt, cx, ny+66);
    ctx.fillStyle='#8893a4'; ctx.font='10px system-ui'; ctx.textBaseline='top'; ctx.fillText(n.unit, cx, ny+68);
    // 상태/설명
    if(st){ ctx.fillStyle=st.col; ctx.font='bold 10px system-ui'; ctx.textBaseline='top'; ctx.fillText(st.glyph+' '+_efLab(st.status), cx, ny+82); }
    else { ctx.fillStyle='#7d8898'; ctx.font='10px system-ui'; ctx.textBaseline='top'; ctx.fillText(n.desc, cx, ny+82); }
  });
}

// ── 자동 스토리 해설 (어디서 생성·손실·왜 팔 부담·타이밍) ──
function _efStoryHTML(by){
  function r0(m){ return (m&&m.value!=null)?Math.round(m.value):null; }
  var dr=_efStat(by.driveWork), tr=_efStat(by.trunkME), shS=_efStat(by.shGen), wh=_efStat(by.whipRatio), keS=_efStat(by.comKEdrop), absS=_efStat(by.kneeAbsE);
  var fo=by.xfReleasedPctByFC, sq=by.seqPct;
  // 약한/강한 고리
  var chain=[{n:'하체 생성',s:dr},{n:'몸통 에너지',s:tr},{n:'팔 생성',s:shS},{n:'전달 효율(채찍비)',s:wh}].filter(function(x){return x.s;});
  var head='';
  if(chain.length){
    var weak=chain.slice().sort(function(a,b){return a.s.z-b.s.z;})[0], strong=chain.slice().sort(function(a,b){return b.s.z-a.s.z;})[0];
    head='<div style="font-size:13px;margin-bottom:6px"><b>핵심 고리</b> — 가장 강한 고리: <span style="color:'+strong.s.col+';font-weight:700">'+strong.n+' ('+_bmZ(strong.s.z)+')</span>'
      +' · 가장 약한 고리: <span style="color:'+weak.s.col+';font-weight:700">'+weak.n+' ('+_bmZ(weak.s.z)+')</span></div>';
  }
  var sent=[];
  if(dr) sent.push('하체에서 드라이브 신전 일 <b>'+r0(by.driveWork)+'J</b>를 생성했습니다 ('+_efLab(dr.status)+').');
  if(keS||absS){ var s1='착지 블록이 전진 운동에너지를'; if(by.comKEdrop&&by.comKEdrop.value!=null) s1+=' <b>'+r0(by.comKEdrop)+'J</b>'; s1+=' 회전으로 전환'; if(by.kneeAbsE&&by.kneeAbsE.value!=null){ s1+='했고, 앞무릎이 <b>'+r0(by.kneeAbsE)+'J</b>를 흡수했습니다'; if(absS&&absS.status==='flag') s1+=' — 흡수가 커 <b style="color:#e07a78">에너지 누수</b>가 의심됩니다'; } s1+='.'; sent.push(s1); }
  if(fo&&fo.value!=null){ var fg=fo.value>25?'조기풀림':(fo.value>10?'경계':'정상'); var fc=fo.value>25?'#e07a78':(fo.value>10?'#e8954e':'#46c98c'); sent.push('골반-어깨 분리(X-Factor)는 착지까지 <b>'+fo.value+'%</b> 풀렸습니다 (<span style="color:'+fc+';font-weight:700">'+fg+'</span>). 착지까지 단단히 유지하다 직후 빠르게 푸는 것이 이상적입니다.'); }
  if(tr) sent.push('몸통 역학에너지는 <b>'+r0(by.trunkME)+'J</b> ('+_efLab(tr.status)+').');
  if(wh){ var ws='몸통→팔 전달 효율(채찍비) <b>'+by.whipRatio.value+'×</b> ('+_efLab(wh.status)+').'; if(wh.status==='flag') ws+=' 전달 효율이 낮으면 팔이 부족분을 자체 생성해 <b style="color:#e07a78">팔 부담</b>이 커질 수 있습니다.'; sent.push(ws); }
  if(sq&&sq.value!=null) sent.push('키네매틱 시퀀스(골반→몸통→팔) 정확도 <b>'+sq.value+'%</b> — 피크 순서·타이밍 일관성을 함께 보세요.');
  return '<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">에너지 흐름 스토리 <span class="sub2">생성 → 전달 → 손실 자동 해설</span></h3>'
    + head + '<div class="note" style="line-height:1.7;font-size:12.5px">'+ (sent.length?sent.join(' '):'에너지 변인 데이터가 부족합니다.') +'</div></div>';
}

function renderEnergyFlow(){
  var root=document.getElementById('ef-body'); if(!root) return;
  var P=(typeof DATA!=='undefined')?DATA.phases:null;
  if(!(P&&P.stages&&P.stages.length)){ root.innerHTML='<div class="card"><div class="note">에너지 흐름 데이터가 없습니다 (단계 분석 결과 필요).</div></div>'; return; }
  var by=_efCollect(P);
  var fast=_fastTrial(), slow=_slowTrial();
  // ── KPI 한 줄(블록 전환·채찍비·시퀀스·팔 부담·앞무릎 유형) ──
  function box(title,val,sub,col){ return '<div style="flex:1 1 150px;background:var(--bg2);border-radius:8px;padding:10px 12px;border-top:3px solid '+(col||'var(--line)')+'"><div class="sub2" style="font-size:11px">'+title+'</div><div style="font-size:20px;font-weight:800;margin:2px 0">'+val+'</div><div class="sub2" style="font-size:11px">'+sub+'</div></div>'; }
  var keS=_efStat(by.comKEdrop), whS=_efStat(by.whipRatio);
  var dtV=(by.driveType&&by.driveType.value)?by.driveType.value:'—';
  var armRisk = (whS&&whS.status==='flag')?'주의':(whS?'낮음':'—');
  var armCol = (whS&&whS.status==='flag')?'var(--red)':(whS?'var(--green)':'var(--line)');
  var kpi='<div class="card" style="grid-column:1 / -1"><div style="display:flex;gap:10px;flex-wrap:wrap">'
    + box('블록 전환', (by.comKEdrop&&by.comKEdrop.value!=null)?(Math.round(by.comKEdrop.value)+'J'):'—', '선형→회전'+(keS?(' · '+_efLab(keS.status)):''), keS?keS.col:'var(--cyan)')
    + box('전달 효율(채찍비)', (by.whipRatio&&by.whipRatio.value!=null)?(by.whipRatio.value+'×'):'—', '몸통→팔 증폭'+(whS?(' · '+_efLab(whS.status)):''), whS?whS.col:'var(--green)')
    + box('시퀀스 정확도', (by.seqPct&&by.seqPct.value!=null)?(by.seqPct.value+'%'):'—', '골반→몸통→팔 순서', 'var(--cyan)')
    + box('팔 부담', armRisk, '전달 효율 기반 추정', armCol)
    + box('앞무릎 유형', dtV, '중립 분류(우열 아님)', 'var(--fg2)')
    + '</div></div>';
  // ── 본문 조립 ──
  var html=''
    + '<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--green)"><div class="note"><b>Theia (지면반력 기반) 고신뢰 분석.</b> 하체 생성·블록 전환·관절 에너지는 포스플레이트가 있을 때 산출됩니다. 절대 J 값은 마커리스 역동역학 추정이라 선수 간 절대 비교보다 <b>한 선수 안에서의 균형·약한 고리·타이밍</b>을 보세요. (Uplift 데이터는 추후 별도 지원 예정.)</div></div>'
    + kpi
    + _flyingOpenCardHTML(P)
    + '<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">에너지 흐름도 <span class="sub2">하체 → 몸통 → 팔 → 공 · 박스=각 분절 생성 에너지(J) · 화살표=전달(전환·채찍비) · 아래 가지=누수</span></h3>'
    + '<canvas id="ef-flow" style="width:100%;height:300px;display:block"></canvas>'
    + '<div class="note" style="margin-top:6px">박스 색·테두리는 엘리트 규준 대비 상태(녹=강점·청=정상·주황=교정). 공 박스는 구속(규준 비교 없음).</div></div>'
    + '<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">타이밍 — 언제 전달되는가 <span class="sub2">FC → BR 구간 · 분절 회전 속도 시퀀스(골반→몸통→팔)</span></h3>'
    + '<canvas id="ef-seq" style="width:100%;height:210px;display:block"></canvas>'
    + '<div class="note" style="margin-top:6px">골반이 먼저 정점에 도달하고 몸통·팔이 차례로 따라가야(시간차 핸드오프) 효율적 전달입니다. 정점이 겹치거나 순서가 뒤집히면 누수·플라잉오픈 신호입니다.</div></div>'
    + '<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">에너지 유입·흡수 — 어디서 들어오고 빠지는가 <span class="sub2">FC → BR 구간 · 관절 파워(양=생성/음=흡수)</span></h3>'
    + '<canvas id="ef-power" style="width:100%;height:210px;display:block"></canvas>'
    + '<div class="note" style="margin-top:6px">뒷고관절(하체 생성)→앞무릎(흡수/신전)→어깨(팔 생성) 순으로 파워가 이어집니다. 앞무릎의 큰 음(−) 파워는 흡수(누수), 어깨의 양(+) 파워는 팔로의 에너지 공급입니다.</div></div>'
    + _efStoryHTML(by);
  root.innerHTML=html;
  // ── 캔버스 그리기 (페이지가 보이는 상태에서 호출됨) ──
  try{ drawEfFlow(by, fast); }catch(e){}
  var W={fast:fast, slow:slow, startEv:'i_fc', startOff:0, endEv:'i_br', endOff:0.02, noGauge:true};
  try{ plotWin('ef-seq', Object.assign({left:{label:'각속도 (°/s)', lines:[
    {compute:function(t){return t.series.Pelvis_Ang_Vel_Z;}, color:'#5bd3ff', label:'골반', width:2.4},
    {compute:function(t){return t.series.Thorax_Ang_Vel_Z;}, color:'#8ea9cf', label:'몸통', width:2.4},
    {compute:function(t){return t.series.Pitching_Hand_Ang_Vel_X;}, color:'#4a90c8', label:'팔(손)', width:2.4}
  ]}}, W)); }catch(e){}
  try{ plotWin('ef-power', Object.assign({left:{label:'관절 파워 (W)', lines:[
    {compute:function(t){return t.series.Back_Hip_Power_X;}, color:'#5bb6e6', label:'뒷고관절(하체 생성)', width:2.2},
    {compute:function(t){return t.series.Lead_Knee_Power_X;}, color:'#6db4e6', label:'앞무릎(흡수/신전)', width:2.2},
    {compute:function(t){return t.series.Pitching_Shoulder_Power_X;}, color:'#46c98c', label:'어깨(팔 생성)', width:2.2}
  ]}}, W)); }catch(e){}
}

// ═══════════════════════════════════════════════════════════════════
// Render: 비효율 (Uplift inefficiency flags) — [2026-05-26] 자체 맵으로 대체, 미사용
// ═══════════════════════════════════════════════════════════════════
function renderInefficiency() {
  const root = document.getElementById('inefficiency-body');
  if (!root) return;
  const ie = DATA.inefficiency_summary;
  if (!ie || !ie.flags) { root.innerHTML = '<p style="color:var(--fg2)">inefficiency 데이터가 없습니다 (Uplift 전용).</p>'; return; }
  const n = ie.n_trials || (DATA.trials || []).length || 0;
  const FIGS = (typeof window !== 'undefined' && window.IE_FIGS) || {};
  const byKey = {}; ie.flags.forEach(f => { byKey[f.key] = f; });
  const flaggedCount = ie.flags.filter(f => f.n > 0).length;

  // ─── 요약 배너 ───
  let html = '';
  html += `<div class="card" style="border-left:4px solid ${flaggedCount ? 'var(--amber)' : 'var(--green)'}">`;
  html += `<div style="font-size:14px;font-weight:800;color:${flaggedCount ? 'var(--amber)' : 'var(--green)'}">`;
  html += flaggedCount
    ? ` ${flaggedCount}개 항목에서 비효율(Energy Leak) 검출 — 총 ${n}구 중`
    : `✓ 검출된 비효율 없음 — ${n}구 모두 클린`;
  html += `</div><div class="note" style="margin-top:8px">Uplift 가 투구 동작을 5개 국면으로 나눠 동작별 비효율을 판정합니다. 숫자는 ${n}구 중 해당 항목이 검출된 투구 수 (예: <b>3/${n}구</b>). 일러스트는 이준우 선수 Uplift 리포트 피겨입니다.</div></div>`;

  // ─── 국면별 섹션 ───
  IE_PHASES.forEach(ph => {
    const fig = FIGS[ph.fig];
    const figHTML = fig
      ? `<div class="ie-fig"><img src="${fig}" alt="${ph.en}" loading="lazy"></div>`
      : '';
    const cards = ph.keys.map(key => {
      const def = IE_DEFS[key] || {ko:key, en:key, def:'', good:'', fix:''};
      const f = byKey[key];
      const measured = !!f;                       // 데이터에 키가 있나
      const cnt = measured ? f.n : null;
      const on = measured && cnt > 0;
      const col = !measured ? 'var(--fg2)' : (on ? 'var(--red)' : 'var(--green)');
      const badge = !measured ? '측정 안 됨'
                  : (on ? `${cnt}/${n}구` : `클린 0/${n}구`);
      const note = !measured ? ''
                  : (on
                      ? `<div class="ie-note ie-fix">교정 포인트 · ${def.fix}</div>`
                      : `<div class="ie-note ie-good">✓ Great job · ${def.good}</div>`);
      const trials = on ? `<div class="ie-trials">검출: Trial ${f.trials.join(', ')}</div>` : '';
      return `<div class="ie-card" style="border-left:3px solid ${col}">
        <div class="ie-card-head">
          <span class="ie-card-name">${def.ko} <span class="ie-card-en">${def.en}</span></span>
          <span class="ie-card-badge" style="color:${col}">${badge}</span>
        </div>
        <div class="ie-card-def">${def.def}</div>
        ${note}${trials}
      </div>`;
    }).join('');
    html += `<div class="ie-phase">
      <div class="ie-phase-top">
        ${figHTML}
        <div class="ie-phase-meta">
          <div class="ie-phase-title">${ph.ko} <span class="ie-phase-en">${ph.en}</span></div>
          <div class="ie-phase-desc">${ph.desc}</div>
        </div>
      </div>
      <div class="ie-card-grid">${cards}</div>
    </div>`;
  });
  root.innerHTML = html;
}

// ═══════════════════════════════════════════════════════════════════
// Render: Detail (per-trial table + variability)
// ═══════════════════════════════════════════════════════════════════
function renderDetail(){
  var ph=(DATA.phases&&DATA.phases.stages)?DATA.phases.stages:[];
  var trials=DATA.trials, fast=_fastTrial(), slow=_slowTrial();
  var mets=[]; ph.forEach(function(st){ (st.metrics||[]).forEach(function(m){ if(m.key&&m.allV) mets.push({m:m,stage:st.label}); }); });
  var thead=document.querySelector('#detail-table thead'), tbody=document.querySelector('#detail-table tbody');
  function stat(vs){ var v=(vs||[]).filter(function(x){return x!=null&&isFinite(x);}); if(!v.length)return null; var m=v.reduce(function(a,b){return a+b;},0)/v.length; var sd=Math.sqrt(v.reduce(function(a,b){return a+(b-m)*(b-m);},0)/v.length); return {mean:m,sd:sd,cv:m!==0?Math.abs(sd/m)*100:0}; }
  var r1=function(x){return (x==null||!isFinite(x))?'—':(Math.round(x*10)/10);};
  if(!mets.length){ if(thead)thead.innerHTML=''; if(tbody)tbody.innerHTML='<tr><td>6단계 메카닉 변인 데이터가 없습니다.</td></tr>'; var vb0=document.getElementById('variability-body'); if(vb0)vb0.innerHTML=''; return; }
  if(thead) thead.innerHTML='<tr><th style="text-align:left">변인 (단계 변인)</th>'+trials.map(function(t){var v=t.rapsodo?Math.round(t.rapsodo.velocity_kmh):'';var mk=(t===fast?' ':(t===slow?' ':''));return '<th>'+t.meta.trial_label.replace('Trial ','T')+(v?'<br><span style="font-size:11px;color:var(--fg2)">'+v+'</span>':'')+mk+'</th>';}).join('')+'<th>mean</th><th>SD</th><th>CV</th></tr>';
  if(tbody) tbody.innerHTML=mets.map(function(x){ var vs=x.m.allV, s=stat(vs);
    var cells=vs.map(function(v){return '<td>'+r1(v)+'</td>';}).join('');
    var cls=s?(s.cv>=30?'cv-high':s.cv>=15?'cv-loose':s.cv>=5?'cv-ok':'cv-tight'):'cv-tight';
    return '<tr><td class="evl" style="text-align:left">'+x.m.label+'</td>'+cells+'<td>'+(s?r1(s.mean):'—')+'</td><td>'+(s?r1(s.sd):'—')+'</td><td class="'+cls+'">'+(s?s.cv.toFixed(1)+'%':'—')+'</td></tr>';
  }).join('');
  // 변동성 요약 (CV 큰 순)
  var rows=mets.map(function(x){return {l:x.m.label,st:String(x.stage).replace(/^\d+\.\s*/,''),s:stat(x.m.allV)};}).filter(function(r){return r.s;}).sort(function(a,b){return b.s.cv-a.s.cv;});
  var vb='<table class="var-table"><thead><tr><th>변인</th><th>단계</th><th>mean</th><th>SD</th><th>CV</th><th>level</th></tr></thead><tbody>';
  rows.forEach(function(r){ var cls='cv-tight',lvl='TIGHT'; if(r.s.cv>=30){cls='cv-high';lvl='HIGH ';}else if(r.s.cv>=15){cls='cv-loose';lvl='LOOSE';}else if(r.s.cv>=5){cls='cv-ok';lvl='OK';} vb+='<tr><td>'+r.l+'</td><td style="color:var(--fg2)">'+r.st+'</td><td>'+r1(r.s.mean)+'</td><td>'+r1(r.s.sd)+'</td><td class="'+cls+'">'+r.s.cv.toFixed(1)+'%</td><td class="'+cls+'">'+lvl+'</td></tr>'; });
  vb+='</tbody></table><div class="note">6단계 메카닉 변인의 12구 트라이얼별 수치 + 변동성. =가장 빠른 공 · =가장 느린 공. CV=SD/|mean|×100 (TIGHT&lt;5% · OK&lt;15% · LOOSE&lt;30% · HIGH≥30%). HIGH 변인은 단일 trial 진단 주의.</div>';
  var vbe=document.getElementById('variability-body'); if(vbe) vbe.innerHTML=vb;
}

// ═══════════════════════════════════════════════════════════════════
// Render dispatcher
// ═══════════════════════════════════════════════════════════════════
// ── 제구(Command) 평가 — Rapsodo 로케이션 + 동작 반복성 ──
function _commandHTML(wrap) {
  const c = DATA.command;
  if (!c) return wrap ? '' : '<p style="color:var(--fg2)">제구 데이터가 없습니다 (Rapsodo 로케이션 필요).</p>';
  const sc = v => v==null ? 'var(--fg2)' : v>=85?'var(--green)':v>=70?'var(--cyan)':v>=55?'var(--amber)':'var(--red)';
  const card = (lbl,val,sub) => `<div style="background:var(--bg2);padding:12px;border-radius:8px;border-left:4px solid ${sc(val)}">
    <div style="font-size:11px;color:var(--fg2)">${lbl}</div><div style="font-size:26px;font-weight:bold">${val ?? '—'}</div>
    <div style="font-size:11px;color:var(--fg1)">${sub||''}</div></div>`;
  let inner = `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px">
    ${card('제구 종합', c.score, `${c.n}구 · 스트라이크 ${c.strike_pct ?? '—'}%`)}
    ${card('존 로케이션 일관성', c.location_score, `좌우 SD ${c.side_sd} · 상하 ${c.height_sd}`)}
    ${card('동작 일관성', c.mech_consistency, '릴리즈·타이밍·암슬롯·스트라이드 평균')}
  </div>`;
  const row = (lbl,score,detail) => `<tr><td class="evl">${lbl}</td><td style="text-align:right;font-weight:800;color:${sc(score)}">${score ?? '—'}</td><td style="text-align:right;color:var(--fg2)">${detail}</td></tr>`;
  inner += `<table class="ev-table"><thead><tr><th class="evl">동작 일관성 분해</th><th>점수</th><th>측정 산포</th></tr></thead><tbody>
    ${row('릴리즈 포인트 일관성', c.release_score, `SD ${c.release_sd_mm ?? '—'} mm`)}
    ${row('릴리즈 타이밍 일관성', c.timing_score, `CV ${c.timing_cv ?? '—'}%`)}
    ${row('암 슬롯 일관성', c.arm_score, `SD ${c.arm_slot_sd ?? '—'}°`)}
    ${row('스트라이드 일관성', c.stride_score, `CV ${c.stride_cv ?? '—'}%`)}
  </tbody></table>
  <div class="note" style="margin-top:10px">제구 = <b>결과 일관성</b>(존 로케이션, Rapsodo)과 <b>동작 일관성</b>(릴리즈 포인트·타이밍·암슬롯·스트라이드 반복성)의 평균. 100=완벽 일관, 점수↓=산포 큼. ${c.n}구 기준.</div>`;
  return wrap ? `<div class="card" style="grid-column:1 / -1"><h3>제구 평가 <span class="sub2">결과(존 로케이션)·동작 일관성 종합</span></h3>${inner}</div>` : inner;
}
function renderCommand() {
  const root = document.getElementById('command-body'); if (!root) return;
  root.innerHTML = _commandHTML(false);
}

function renderTrialSpecific(idx, activePage) {
  const trial = DATA.trials[idx]; if (!trial) return;
  activePage = activePage || document.querySelector('.tab.active')?.dataset.page || 'summary';
  if (activePage && activePage.indexOf('ph-')===0) { renderPhaseTab(activePage.slice(3)); return; }
  if (activePage && activePage.indexOf('ed-')===0) { renderEdNode(activePage.slice(3)); return; }
  switch (activePage) {
    case 'summary':   renderSummary(trial); break;
    case 'psummary':  renderPlayerSummary(); break;
    case 'coach-view': renderCoachView(); break;
    case 'coach':     renderCoach(trial); break;
    case 'biomotion': renderBioMotion(); break;
    case 'etdiag': renderEtDiag(); break;
    case 'energyflow': renderEnergyFlow(); break;
    case 'focus': _renderFocusChart(); break;
    case 'command':   renderCommand(); break;
    case 'hpa':       window.renderHPA && window.renderHPA(DATA); break;
    case 'injury':    window.renderInjury && window.renderInjury(DATA); try{ renderInjuryLoadDiag(); }catch(e){} try{ _IG.inject(); }catch(e){} try{ if(document.getElementById('phch-injuryload')) renderPhaseTab('injuryload'); }catch(e){} break;
    case 'grf':       renderGRF(trial); break;
    case 'power':     renderPower(trial); break;
    case 'energy':    renderEnergy(trial); break;
    case 'sequence':  renderSequence(trial); break;
    case 'arm':       renderArm(trial); break;
    case 'lower':     renderLower(trial); break;
    case 'trunk':     renderTrunk(trial); break;
    case 'inefficiency': renderEnergyInefficiency(); break;  // [2026-05-26] 자체 에너지전달 비효율 맵(Uplift 플래그 대체)
    case 'detail':    renderDetail(); break;
    case 'imu-native': renderImuNative(idx); break;

  }
}

// ═══════════════════════════════════════════════════════════════════
// IMU 키네틱 체인 에너지 흐름 분석 (분절 자이로 직접측정 기반)
//  · 시퀀싱(근위→원위 피크 타이밍) · 속도 증폭(채찍) · 분절 에너지 · 릴리스 시 말단 전달 · 진단
// ═══════════════════════════════════════════════════════════════════
function _imuKineticChainHTML(trial){
  if(!trial||!trial.series) return '';
  var _isIMU=(typeof DATA!=='undefined'&&DATA.system&&/IMU/i.test(DATA.system));
  var _kcBadge=_isIMU?'IMU':'마커리스', _kcSrc=_isIMU?'분절 자이로 직접측정':'관절중심 위치 기반 산출(GRF 불필요)';
  var S=trial.series, ev=trial.events||{}, dt=(trial.meta&&trial.meta.dt)||0.004;
  var ikl=ev.i_kl_peak||0, ibr=(ev.i_br!=null?ev.i_br:0), hi=Math.min((S.Trunk_ME_X||[]).length-1, ibr+6);
  if(!(ibr>ikl)) return '';
  // 체인: [라벨, ME키, ω키]  (근위→원위)
  var CH=[['골반','Pelvis_ME_X','Pelvis_Ang_Vel_Z'],['몸통','Trunk_ME_X','Thorax_Ang_Vel_Z'],['상완(어깨 내회전)','Pitching_Humerus_ME_X','Pitching_Shoulder_Ang_Vel_Z'],['전완(팔꿈치)','Pitching_Forearm_ME_X','Pitching_Forearm_Ang_Vel_Z'],['손','Pitching_Hand_ME_X',null]];
  function pkA(a){ var mv=-1e9,mi=ikl; for(var i=ikl;i<=hi&&i<(a||[]).length;i++){ var x=Math.abs(a[i]); if(isFinite(x)&&x>mv){mv=x;mi=i;} } return mv<=-1e9?null:{v:mv,i:mi}; }
  function atv(a,i){ return (a&&isFinite(a[i]))?a[i]:null; }
  var segs=CH.map(function(c){
    var me=S[c[1]]||[], w=c[2]?(S[c[2]]||[]):null;
    var mp=pkA(me), wp=w?pkA(w):null;
    return { lbl:c[0], mePeak:mp?mp.v:null, meBR:atv(me,ibr), wPeak:wp?wp.v:null, wT:wp?Math.round((wp.i-ibr)*dt*1000):null };
  });
  // 손 말단은 선형 속도
  var handSpd=(ev.peak_hand_speed_ms!=null)?ev.peak_hand_speed_ms:null;
  // 시퀀싱: ω 피크 시점(없으면 ME 시점) 근위→원위
  var tseq=segs.map(function(s,i){ return s.wT; });
  var seqLinks=[], seqOK=0, seqN=0;
  for(var k=0;k<segs.length-1;k++){ var a=tseq[k], b=tseq[k+1]; if(a==null||b==null) continue; seqN++; var ok=(a<=b+2); if(ok)seqOK++; seqLinks.push({from:segs[k].lbl,to:segs[k+1].lbl,lag:(b-a),ok:ok}); }
  // 속도 증폭(회전 4분절: 골반→몸통→상완→전완)
  var amp=[];
  for(var j=0;j<4;j++){ var p=segs[j].wPeak, q=segs[j+1].wPeak; if(p&&q) amp.push({from:segs[j].lbl,to:segs[j+1].lbl,r:q/p}); }
  // 릴리스 시 말단(전완+손) 에너지 집중도
  var meBRs=segs.map(function(s){return s.meBR!=null?s.meBR:0;});
  var totBR=meBRs.reduce(function(a,b){return a+Math.max(0,b);},0);
  var distalBR=Math.max(0,meBRs[3])+Math.max(0,meBRs[4]);
  var distalPct=totBR>0?Math.round(distalBR/totBR*100):null;
  // 진단
  var diag=[];
  // 근위 시퀀스(골반→몸통→상완)만 엄격 점검 — 어깨 내회전은 릴리스 전후 피크가 정상이라 전완과의 순서는 알람 제외
  var coreLinks=seqLinks.slice(0,2), coreBad=coreLinks.filter(function(l){return !l.ok;});
  diag.push(coreBad.length===0 ? '<b style="color:var(--green)">✓ 근위 시퀀스 정상</b> — 골반→몸통→상완 순으로 피크(에너지가 근위에서 시작해 원위로 전달).' : '<b style="color:var(--amber)">⚠ 근위 시퀀스 점검</b> — 골반·몸통·상완 피크 순서 이탈(전달 타이밍 비효율).');
  coreBad.forEach(function(l){ diag.push('· '+l.from+'→'+l.to+' 순서 역전 — 에너지 전달 타이밍 누수 가능.'); });
  diag.push('· 어깨 내회전은 릴리스 직전~직후 피크가 정상(채찍 말단) — 전완·손과의 미세 타이밍 차이는 정상 범위.');
  var weak=amp.slice().sort(function(a,b){return a.r-b.r;})[0];
  if(weak) diag.push('· 최약 전환: <b>'+weak.from+'→'+weak.to+'</b> 속도 증폭 '+weak.r.toFixed(2)+'× '+(weak.r<1.0?'(증폭 부족 — 이 구간 채찍 효과 약함, 분절 분리·타이밍 개선 여지)':'(증폭 양호)')+'.');
  if(distalPct!=null) diag.push('· 릴리스 시 말단(전완+손) 에너지 집중도 <b>'+distalPct+'%</b> '+(distalPct>=70?'— 에너지가 손끝으로 잘 전달됨.':'— 말단 전달 미흡(에너지가 근위에 잔류).'));
  if(segs[0].wPeak!=null && segs[0].wPeak<400) diag.push('· 골반 회전속도 '+Math.round(segs[0].wPeak)+'°/s로 낮음(저강도 투구) — 체인 시작 동력이 작아 절대 에너지가 낮습니다. <b>전력 투구 데이터로 재평가 권장.</b>');
  // 렌더
  function num(x,d){ return (x==null||!isFinite(x))?'—':(Math.round(x*(d?Math.pow(10,d):1))/(d?Math.pow(10,d):1)); }
  var nodes=segs.map(function(s,i){
    var isHand=(i===4);
    var spd=isHand&&handSpd!=null?('<div style="font-size:12px;color:var(--accent);font-weight:700">'+num(handSpd,1)+' m/s</div>'):'';
    var wline=(!isHand&&s.wPeak!=null)?('<div style="font-size:12px;color:var(--cyan)">'+num(s.wPeak,0)+' °/s</div>'):'';
    return '<div style="flex:1 1 0;min-width:90px;text-align:center;padding:8px 4px;background:var(--bg2);border-radius:8px">'+
      '<div style="font-weight:700;font-size:12.5px;margin-bottom:3px">'+s.lbl+'</div>'+wline+spd+
      '<div style="font-size:12px;margin-top:3px">피크 <b>'+num(s.mePeak,0)+'</b> J</div>'+
      '<div style="font-size:11px;color:var(--fg2)">릴리스 '+num(s.meBR,0)+' J · '+(s.wT!=null?(s.wT<=0?s.wT+'ms':'+'+s.wT+'ms'):'—')+'</div></div>';
  });
  // 화살표(증폭×/시간차) 삽입
  var flow='<div style="display:flex;align-items:center;gap:4px;flex-wrap:nowrap;overflow-x:auto">';
  for(var n=0;n<nodes.length;n++){ flow+=nodes[n];
    if(n<nodes.length-1){ var ar=amp[n]; var lagL=seqLinks[n]; var mid=(ar?ar.r.toFixed(2)+'×':'')+(lagL?(' · '+(lagL.lag>=0?'+':'')+lagL.lag+'ms'):''); flow+='<div style="flex:0 0 auto;text-align:center;color:var(--fg2);font-size:11px;padding:0 2px">▶<div>'+mid+'</div></div>'; } }
  flow+='</div>';
  return '<div class="card" style="grid-column:1 / -1"><h3>키네틱 체인 에너지 흐름 <span class="badge">'+_kcBadge+'</span> '+
    '<span class="sub2">'+_kcSrc+' — 근위→원위 에너지 생성·전달. 피크 J=분절 생성 에너지, 릴리스 J=릴리스 순간 보유, °/s=피크 각속도, ms=피크 시점(릴리스 기준)</span></h3>'+
    flow+
    '<div style="margin-top:10px;padding:10px;background:var(--bg2);border-radius:8px;font-size:12.5px;line-height:1.6">'+
    '<div style="font-weight:700;margin-bottom:4px">진단 (분절 에너지 전달 분석)</div>'+diag.join('<br>')+'</div>'+
    '<div style="font-size:11px;color:var(--fg2);margin-top:6px">※ 분절 에너지=½mv²+½Iω²(분절 관성·자이로 기반). 분절간 효율은 근육이 각 관절에서 에너지를 추가하므로 단순 비율이 아닌 시퀀싱·증폭·말단 집중도로 평가.</div></div>';
}

// ═══════════════════════════════════════════════════════════════════
// Render: IMU 고유 변인 (Theia 약점·미제공 — IMU 직접측정/추정)
// ═══════════════════════════════════════════════════════════════════
function renderImuNative(idx){
  var root = document.getElementById('imu-native-body'); if (!root) return;
  var trial = DATA.trials[idx] || DATA.trials[(DATA.best_trial_index||1)-1] || DATA.trials[0];
  var S = (trial && trial.scalars) || {};
  function v(x, d){ return (x==null||!isFinite(x)) ? '—' : (Math.round(x*(d?Math.pow(10,d):1))/(d?Math.pow(10,d):1)); }
  function card(label, val, unit, note, detail){
    return '<div class="sm-card" style="border-top:3px solid var(--accent)"><div class="sm-lbl">'+label+'</div>'+
      '<div class="sm-val">'+val+'<span style="font-size:11px"> '+(unit||'')+'</span></div>'+
      (note?'<div style="font-size:11px;color:var(--fg2);line-height:1.35;margin-top:4px">'+note+'</div>':'')+
      (detail?'<details style="margin-top:5px"><summary style="font-size:11px;color:var(--accent);cursor:pointer;list-style:none">▸ 산출·해석</summary><div style="font-size:11px;color:var(--fg2);line-height:1.45;margin-top:4px">'+detail+'</div></details>':'')+'</div>';
  }
  var kin = [
    card('뒷고관절 외회전 (최대)', v(S.back_hip_er_max,1), '°', '스탠스 다리 고관절 외회전 — 코일·적재 깊이. IMU 직접측정',
      '<b>산출</b>: 뒷다리(스탠스) 고관절 외회전 관절각(자이로+세그먼트 자세 기반) 시계열에서 KH 이전 최대값.<br><b>해석</b>: 골반·하체 코일(되감기) 깊이. 클수록 회전 가속에 쓸 탄성·가동범위 여력↑. 마커리스는 골반 내부 회전 추적이 약해 신뢰도 낮음.'),
    card('뒷고관절 회전 각속도 (피크)', v(S.back_hip_rot_vel_peak,0), '°/s', '뒷고관절 내회전 추진 각속도. IMU 직접측정',
      '<b>산출</b>: 위 외회전각 시계열의 수치미분 peak(내회전 방향).<br><b>해석</b>: 뒷다리가 골반을 홈 방향으로 되돌리는(내회전) 추진 속도 — 키네틱 체인 시작 동력.'),
    card('손목 요측편향 (릴리스)', v(S.wrist_radial_br,1), '°', '릴리스 시 손목 요측/척측 편향 — Theia 미약. IMU 직접측정',
      '<b>산출</b>: 손목 요측-척측 편향 관절각 @릴리스(BR) 프레임.<br><b>해석</b>: 릴리스 순간 손목 정렬. 과도한 척측편향은 제구·부하와 연관. 마커리스는 손·손목 소분절 추적이 어려워 미제공.'),
    card('손목 굴곡 (릴리스)', v(S.wrist_flexion_br,1), '°', '릴리스 시 손목 굴곡/신전 — Theia 미약. IMU 직접측정',
      '<b>산출</b>: 손목 굴곡-신전 관절각 @릴리스(BR).<br><b>해석</b>: 공을 채는 손목 스냅 정도(굴곡+). 회전수·릴리스 효율과 연관.')
  ].join('');
  var kinetic = [
    card('팔꿈치 외반 토크', v(S.elbow_valgus_torque,1), 'N·m', '내측 부하 지표(UCL). I·α 추정',
      '<b>산출</b>: 전완 분절관성 × 각가속도(I·α, Newton-Euler) 의 팔꿈치 외반 성분 peak(FC~BR). 직접 측정 아님(IMU 추정).<br><b>해석</b>: 팔꿈치 내측측부인대(UCL) 부하 대용. 클수록 부상 위험↑ — 절대 비교보다 같은 선수 추세로 본다.'),
    card('어깨 내회전 토크', v(S.shoulder_ir_torque,1), 'N·m', '내회전기 부하. I·α 추정',
      '<b>산출</b>: 상완 I·α 의 내회전 성분 peak. IMU 추정.<br><b>해석</b>: 가속기 내회전근 부하. 구속 생성의 동력이자 어깨 부하 지표.'),
    card('어깨 분리력', v(S.shoulder_distraction_N,0), 'N', '관절 견인 부하. m·a 추정',
      '<b>산출</b>: 상완 질량 × 가속도(m·a)로 추정한 어깨 견인(distraction) 힘 peak. IMU 추정.<br><b>해석</b>: 릴리스~팔로스루에서 관절을 잡아당기는 힘 — 관절낭·건 부하.'),
    card('팔꿈치 신전 파워', v(S.elbow_power_peak,0), 'W', '팔꿈치 신전 파워 피크. 추정',
      '<b>산출</b>: 팔꿈치 관절모멘트 × 관절 각속도(M·ω) peak. IMU 추정.<br><b>해석</b>: 팔꿈치 신전으로 공에 전달되는 순간 동력. 양(+)=에너지 생성.'),
    card('어깨 회전 파워', v(S.shoulder_power_peak,0), 'W', '어깨 회전 파워 피크. 추정',
      '<b>산출</b>: 어깨 관절모멘트 × 각속도(M·ω) peak. IMU 추정.<br><b>해석</b>: 어깨 내회전 동력 — 상지 가속의 주 동력원.')
  ].join('');
  var allNull = ['back_hip_er_max','back_hip_rot_vel_peak','elbow_valgus_torque','shoulder_ir_torque'].every(function(k){return S[k]==null;});
  if (allNull){ root.innerHTML='<div class="note">IMU 고유 변인 데이터가 없습니다 (IMU(MR3) 리포트에서만 표시됩니다).</div>'; return; }
  root.innerHTML =
    '<div class="card" style="grid-column:1 / -1"><h3>운동학 — IMU 직접측정 <span class="sub2">자이로·세그먼트 자세 기반, 신뢰 높음 · 마커리스가 약하거나 못 보는 영역</span></h3>'+
    '<div class="sm-grid">'+kin+'</div></div>'+
    '<div class="card" style="grid-column:1 / -1"><h3>키네틱 — <span style="color:var(--amber)">IMU 추정</span> <span class="sub2">분절관성×각가속도(토크)·질량×가속도(분리력) 추정 — 직접 측정값 아님. 상대 비교·추세 참고용</span></h3>'+
    '<div class="sm-grid">'+kinetic+'</div></div>';
}

// ═══════════════════════════════════════════════════════════════════
// Render: Uplift X-Check (Uplift vs Theia cross-validation)
// ═══════════════════════════════════════════════════════════════════
function renderUpliftXCheck(){ /* Uplift 교차검증 제거됨 */ }

// ═══════════════════════════════════════════════════════════════════
// 3D Stick figure (21 landmark — Theia c3d.txt export 한계)
// 마커: r_wrist, r_elbow, r_shoulder (throwing arm) + l_ankle, r_ankle (stance)
// 본: r_shoulder→r_elbow→r_wrist · l_ankle↔r_ankle · r_shoulder↔r_ankle_mid (옅은 dashed reference)
// ═══════════════════════════════════════════════════════════════════
const stick3D = (function() {
  const container = document.getElementById('three');
  const loading = document.getElementById('three-loading');
  if (!container) return { setFrame: () => {}, setFrameB: () => {}, setGhostVisible: () => {}, setGhostOffset: () => {}, updateGRF: () => {}, updateGRFB: () => {}, autoFit: () => {}, resize: () => {}, setTrailData: () => {} , setView: () => {} };

  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x080a0e);

  // Camera
  const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 10, 20000);
  camera.position.set(2000, 1500, 2000);

  // Renderer
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setPixelRatio(devicePixelRatio || 1);
  renderer.setSize(container.clientWidth, container.clientHeight);
  container.appendChild(renderer.domElement);
  if (loading) loading.style.display = 'none';

  // Controls
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.target.set(0, 800, 0);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.update();

  // Lights
  scene.add(new THREE.AmbientLight(0xffffff, 0.6));
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.7);
  dirLight.position.set(1500, 2000, 1500);
  scene.add(dirLight);

  // Ground grid
  const grid = new THREE.GridHelper(4000, 20, 0x2a3340, 0x1a1f2a);
  grid.position.y = 0;
  scene.add(grid);

  // Axis labels: pitching rubber location indicator
  const rubber = new THREE.Mesh(
    new THREE.BoxGeometry(610, 25, 152),   // 장축(610)=폭, 단축(152)=깊이
    new THREE.MeshBasicMaterial({ color: 0xff7a3c, transparent: true, opacity: 0.4 })
  );
  rubber.position.set(0, 13, 0);
  scene.add(rubber);
  // [2026-05-26] 투구판 방향 교정: 장축(610)을 전진(투구)축에 수직(lateral)으로 정렬 + 뒷발 아래 배치.
  //   전진축은 pelvis 변위가 큰 수평축으로 자동검출(X 또는 Z). report.template과 동일 규약.
  (function(){ try{
    var _bt=DATA.trials&&(DATA.trials[(DATA.best_trial_index||1)-1]||DATA.trials[0]);
    var _fr=_bt&&_bt.frames; if(!_fr||!_fr.length) return;
    var a0=[],a2=[]; for(var i=0;i<_fr.length;i++){ var p=_fr[i]&&(_fr[i].pelvis_o||_fr[i].com); if(p){ if(isFinite(p[0]))a0.push(p[0]); if(isFinite(p[2]))a2.push(p[2]); } }
    function rng(a){ return a.length?(Math.max.apply(null,a)-Math.min.apply(null,a)):0; }
    var fwd=(rng(a0)>rng(a2))?0:2;                     // 전진축: 변위 큰 수평축
    rubber.rotation.y = (fwd===2)? 0 : Math.PI/2;       // 전진=Z면 장축 X(기본), 전진=X면 90° 회전→장축 Z
    var f0=_fr[0], rh=f0&&(f0[legRear+'_heel']||f0[legRear+'_toe']||f0.pelvis_o);  // 뒷발(셋업) 아래
    if(rh&&isFinite(rh[0])&&isFinite(rh[2])) rubber.position.set(rh[0],13,rh[2]);
  }catch(e){} })();

  // ── v0.11: 21 LANDMARK 풀바디 스켈레톤 ──
  const COLOR = { THROW: 0xff5a3c, GLOVE: 0xa855f7, SPINE: 0xff3ce0,
                  LEAD: 0x5bd3ff, REAR: 0xffc24d, WHITE: 0xe8ecf2 };
  const _hand = (DATA.player && DATA.player.handedness ? DATA.player.handedness : 'R').toUpperCase();
  const _RHP = _hand !== 'L';
  const armThrow = _RHP ? 'r' : 'l';
  const armGlove = _RHP ? 'l' : 'r';
  const legLead  = _RHP ? 'l' : 'r';
  const legRear  = _RHP ? 'r' : 'l';
  function lmColor(name) {
    if (['pelvis_o','neck','head'].includes(name)) return COLOR.SPINE;
    const isArmJ = /shoulder|elbow|wrist|hand_tip/.test(name);
    const isLegJ = /hip|knee|heel|toe/.test(name);
    if (isArmJ && name[0] === armThrow) return COLOR.THROW;
    if (isArmJ && name[0] === armGlove) return COLOR.GLOVE;
    if (isLegJ && name[0] === legLead)  return COLOR.LEAD;
    if (isLegJ && name[0] === legRear)  return COLOR.REAR;
    return COLOR.WHITE;
  }
  const MARKER_NAMES = ['pelvis_o','neck','head','l_shoulder','r_shoulder',
    'l_elbow','r_elbow','l_wrist','r_wrist','l_hip','r_hip','l_knee','r_knee',
    'l_heel','r_heel','l_toe','r_toe','l_hand_tip','r_hand_tip'];
  function lmRadius(name) {
    if (name === 'head') return 55;
    if (name === 'pelvis_o' || /shoulder|hip/.test(name)) return 38;
    if (/hand_tip|toe/.test(name)) return 22;
    return 30;
  }
  const spheres = {};
  for (const name of MARKER_NAMES) {
    const sph = new THREE.Mesh(
      new THREE.SphereGeometry(lmRadius(name), 16, 16),
      new THREE.MeshLambertMaterial({ color: lmColor(name) })
    );
    scene.add(sph);
    spheres[name] = sph;
  }

  // Bones — cylinders dynamically resized between joints
  function makeBone(color, radius) {
    const mat = new THREE.MeshLambertMaterial({ color });
    const geo = new THREE.CylinderGeometry(radius, radius, 1, 8);
    const mesh = new THREE.Mesh(geo, mat);
    scene.add(mesh);
    return mesh;
  }
  // ── v0.11: 풀바디 본 정의 [from, to, color, radius] ──
  const BONE_DEFS = [
    ['pelvis_o','neck',                COLOR.SPINE, 16],
    ['neck','head',                    COLOR.SPINE, 11],
    ['neck', armThrow+'_shoulder',     COLOR.SPINE, 11],
    ['neck', armGlove+'_shoulder',     COLOR.SPINE, 11],
    [armThrow+'_shoulder', armThrow+'_elbow',   COLOR.THROW, 13],
    [armThrow+'_elbow',    armThrow+'_wrist',   COLOR.THROW, 11],
    [armThrow+'_wrist',    armThrow+'_hand_tip',COLOR.THROW, 8],
    [armGlove+'_shoulder', armGlove+'_elbow',   COLOR.GLOVE, 13],
    [armGlove+'_elbow',    armGlove+'_wrist',   COLOR.GLOVE, 11],
    [armGlove+'_wrist',    armGlove+'_hand_tip',COLOR.GLOVE, 8],
    ['pelvis_o', legLead+'_hip',       COLOR.SPINE, 12],
    ['pelvis_o', legRear+'_hip',       COLOR.SPINE, 12],
    [legLead+'_hip',  legLead+'_knee', COLOR.LEAD, 15],
    [legLead+'_knee', legLead+'_heel', COLOR.LEAD, 13],
    [legLead+'_heel', legLead+'_toe',  COLOR.LEAD, 9],
    [legRear+'_hip',  legRear+'_knee', COLOR.REAR, 15],
    [legRear+'_knee', legRear+'_heel', COLOR.REAR, 13],
    [legRear+'_heel', legRear+'_toe',  COLOR.REAR, 9],
  ];
  const boneList = BONE_DEFS.map(([a,b,c,r]) => ({ from:a, to:b, mesh: makeBone(c, r) }));

  // ── 비교 모드: 두 번째(ghost) 스켈레톤 (트라이얼 B) ──
  // primary 는 컬러풀, ghost 는 단색 반투명(청록)으로 구분.
  const GHOST_COLOR = 0x4fd1ff;
  const ghostGroup = new THREE.Group();
  ghostGroup.visible = false;
  scene.add(ghostGroup);
  // depthTest:false → 오버레이 시 불투명 primary 뒤에 숨지 않고 항상 위에 그려짐
  const ghostSpheres = {};
  for (const name of MARKER_NAMES) {
    const sph = new THREE.Mesh(
      new THREE.SphereGeometry(lmRadius(name), 12, 12),
      new THREE.MeshLambertMaterial({ color: GHOST_COLOR, transparent: true, opacity: 0.7, depthTest: false, depthWrite: false })
    );
    sph.renderOrder = 20;
    ghostGroup.add(sph);
    ghostSpheres[name] = sph;
  }
  const ghostBoneList = BONE_DEFS.map(([a, b, c, r]) => {
    const mat = new THREE.MeshLambertMaterial({ color: GHOST_COLOR, transparent: true, opacity: 0.6, depthTest: false, depthWrite: false });
    const mesh = new THREE.Mesh(new THREE.CylinderGeometry(r, r, 1, 8), mat);
    mesh.renderOrder = 20;
    ghostGroup.add(mesh);
    return { from: a, to: b, mesh };
  });
  function setFrameB(frame) {
    if (!frame) { ghostGroup.visible = false; return; }
    ghostGroup.visible = true;
    for (const name of Object.keys(ghostSpheres)) {
      const pos = frame[name];
      if (pos && pos.every(v => isFinite(v))) {
        ghostSpheres[name].visible = true;
        ghostSpheres[name].position.set(...pos);
      } else {
        ghostSpheres[name].visible = false;
      }
    }
    for (const b of ghostBoneList) positionBone(b.mesh, frame[b.from], frame[b.to]);
  }
  function setGhostVisible(v) { ghostGroup.visible = !!v; }
  // side-by-side: ghost 를 측면(viewer Z)으로 평행이동. overlay: 0.
  function setGhostOffset(z) { ghostGroup.position.set(0, 0, z || 0); }

  // ── v0.13: COM(흰)·골반(연두) 궤적 trail + 현재 위치 점 ──
  function makeTrail(color) {
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(3*2000), 3));
    geo.setDrawRange(0, 0);
    const mat = new THREE.LineBasicMaterial({ color, transparent:true, opacity:0.45 });
    const line = new THREE.Line(geo, mat); scene.add(line); return line;
  }
  const pelvisTrail = makeTrail(0x9be15b);
  const handTrail = makeTrail(0xff5a3c);  // 공 든 손(투구팔 손끝) 얇은 trail
  pelvisTrail.visible=false; handTrail.visible=false;  // 무게중심(COM) 궤적만 표시
  // COM trail = 굵은 tube (v0.14)
  let comTube = null;
  const comTubeMat = new THREE.MeshLambertMaterial({ color:0xffffff, transparent:true, opacity:0.6 });
  function rebuildComTube(uptoIdx) {
    if (comTube) { scene.remove(comTube); comTube.geometry.dispose(); comTube=null; }
    if (!_trailFrames) return;
    const pts=[];
    for (let i=0;i<=uptoIdx && i<_trailFrames.length;i+=2) {
      const p=_trailFrames[i] && _trailFrames[i].com;
      if (p && p.length>=3 && p.every(isFinite)) pts.push(new THREE.Vector3(p[0],p[1],p[2]));
    }
    if (pts.length<2) return;
    const curve = new THREE.CatmullRomCurve3(pts);
    const geo = new THREE.TubeGeometry(curve, Math.min(pts.length*2,200), 9, 6, false);
    comTube = new THREE.Mesh(geo, comTubeMat); scene.add(comTube);
  }
  const comDot = new THREE.Mesh(new THREE.SphereGeometry(26,16,16), new THREE.MeshLambertMaterial({color:0xffffff}));
  const pelvisDot = new THREE.Mesh(new THREE.SphereGeometry(20,16,16), new THREE.MeshLambertMaterial({color:0x9be15b}));
  comDot.visible=false; pelvisDot.visible=false; scene.add(comDot); scene.add(pelvisDot);
  let _trailFrames = null;
  function setTrailData(frames){ _trailFrames = frames; }
  function _fillTrail(line, key, uptoIdx){
    if(!_trailFrames) { line.geometry.setDrawRange(0,0); return; }
    const arr = line.geometry.attributes.position.array;
    let n=0;
    for(let i=0;i<=uptoIdx && i<_trailFrames.length && n<2000;i++){
      const p=_trailFrames[i] && _trailFrames[i][key];
      if(p && p.length>=3 && p.every(isFinite)){ arr[n*3]=p[0]; arr[n*3+1]=p[1]; arr[n*3+2]=p[2]; n++; }
    }
    line.geometry.attributes.position.needsUpdate=true;
    line.geometry.setDrawRange(0,n);
  }

  // ★ v0.4: GRF arrows (FP1 = lead/cyan, FP2 = rear/orange)
  // 화살표 길이 = |F| × FORCE_SCALE (mm/N). v0.11: 스케일 확대 + 굵은 cylinder+cone.
  const FORCE_SCALE = 0.55;  // v0.15: 화살표 길이 축소 (발 근처에 머무름)
  // ghost=true → B 트라이얼용: 반투명 + depthTest 끔 + ghostGroup 소속(좌우보기 offset 따라감)
  function makeForceArrow(color, shaftR, ghost) {
    const g = new THREE.Group();
    g.userData.shaftR = shaftR;
    const matOpts = ghost ? { color, transparent: true, opacity: 0.6, depthTest: false, depthWrite: false } : { color };
    const mat = new THREE.MeshLambertMaterial(matOpts);
    const shaft = new THREE.Mesh(new THREE.CylinderGeometry(shaftR, shaftR, 1, 14), mat);
    shaft.name = 'shaft'; g.add(shaft);
    const head = new THREE.Mesh(new THREE.ConeGeometry(shaftR*2.3, shaftR*5.5, 16), mat);
    head.name = 'head'; g.add(head);
    if (ghost) { shaft.renderOrder = 20; head.renderOrder = 20; }
    g.visible = false;
    (ghost ? ghostGroup : scene).add(g);
    return g;
  }
  function setForceArrow(g, origin, dir, length) {
    if (length < 1) { g.visible = false; return; }
    const shaftR = g.userData.shaftR;
    const headLen = Math.min(length * 0.32, shaftR * 5.5);
    const shaftLen = Math.max(1, length - headLen);
    const o = new THREE.Vector3(origin[0], origin[1], origin[2]);
    const d = dir.clone().normalize();
    const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0,1,0), d);
    const shaft = g.getObjectByName('shaft'), head = g.getObjectByName('head');
    shaft.scale.set(1, shaftLen, 1);
    shaft.position.copy(o).add(d.clone().multiplyScalar(shaftLen/2));
    shaft.quaternion.copy(q);
    head.position.copy(o).add(d.clone().multiplyScalar(shaftLen + headLen/2));
    head.quaternion.copy(q);
    g.visible = true;
  }
  // grfArrowRear = 뒷발 (강조 — 더 굵게), grfArrowLead = 앞발
  const grfArrowRear = makeForceArrow(COLOR.REAR, 16);   // 뒷발 황금, 굵게
  const grfArrowLead = makeForceArrow(COLOR.LEAD, 12);   // 앞발 청록
  // 비교 모드 B 트라이얼 GRF 화살표 (청록 반투명, ghostGroup 소속)
  const grfArrowRearB = makeForceArrow(GHOST_COLOR, 13, true);
  const grfArrowLeadB = makeForceArrow(GHOST_COLOR, 10, true);

  function positionBone(bone, p1, p2) {
    if (!p1 || !p2 || p1.some(v => !isFinite(v)) || p2.some(v => !isFinite(v))) {
      bone.visible = false; return;
    }
    bone.visible = true;
    const v1 = new THREE.Vector3(...p1);
    const v2 = new THREE.Vector3(...p2);
    const mid = v1.clone().add(v2).multiplyScalar(0.5);
    const dir = v2.clone().sub(v1);
    const len = dir.length();
    bone.position.copy(mid);
    bone.scale.set(1, len, 1);
    // Orient cylinder (default Y axis) toward dir
    const up = new THREE.Vector3(0, 1, 0);
    const q = new THREE.Quaternion().setFromUnitVectors(up, dir.clone().normalize());
    bone.quaternion.copy(q);
  }

  function setFrame(frame, frameIdx) {
    if (!frame) return;
    for (const name of Object.keys(spheres)) {
      const pos = frame[name];
      if (pos && pos.every(v => isFinite(v))) {
        spheres[name].visible = true;
        spheres[name].position.set(...pos);
      } else {
        spheres[name].visible = false;
      }
    }
    for (const b of boneList) {
      positionBone(b.mesh, frame[b.from], frame[b.to]);
    }
    // COM·골반 trail + 현재 점
    if (frameIdx != null) {
      rebuildComTube(frameIdx);
      _fillTrail(pelvisTrail, 'pelvis_o', frameIdx);
      const _RHP2 = (DATA.player && DATA.player.handedness ? DATA.player.handedness : 'R').toUpperCase() !== 'L';
      _fillTrail(handTrail, _RHP2 ? 'r_hand_tip' : 'l_hand_tip', frameIdx);
    }
    if (frame.com && frame.com.every(isFinite)) { comDot.position.set(...frame.com); comDot.visible=true; } else comDot.visible=false;
    if (frame.pelvis_o && frame.pelvis_o.every(isFinite)) { pelvisDot.position.set(...frame.pelvis_o); pelvisDot.visible=true; } else pelvisDot.visible=false;
  }

  // ★ v0.4: GRF 화살표 업데이트 — trial + 현재 frame
  // Theia 좌표 → viewer 좌표 변환:
  //   viewer X = (Theia horiz0 - viewer_origin_horiz0) × 1000
  //   viewer Y = (Theia axis_up - ground_y) × 1000
  //   viewer Z = (Theia horiz1 - viewer_origin_horiz1) × 1000
  // Force 는 방향만 의미, 동일 축 mapping 으로 변환 (offset 없음).
  function _drawGRF(trial, frameIdx, arrowRear, arrowLead) {
    if (!trial || frameIdx == null) { arrowRear.visible=false; arrowLead.visible=false; return; }
    const m = trial.meta;
    const ground = m.ground_y_m || 0;
    const ox = m.viewer_origin_horiz0_m || 0;
    const oz = m.viewer_origin_horiz1_m || 0;
    const haxes = m.horiz_axes || ['X', 'Y'];   // Theia 의 horiz 축 이름
    // axis_up = "Z" 가 일반적이므로 force 의 Z 가 vertical, horiz0(X)→viewerX, horiz1(Y)→viewerZ
    const axUp = m.axis_up || 'Z';

    function getF(prefix) {
      const s = trial.series;
      const fx = s[`${prefix}_${haxes[0]}`]?.[frameIdx];
      const fy = s[`${prefix}_${haxes[1]}`]?.[frameIdx];
      const fz = s[`${prefix}_${axUp}`]?.[frameIdx];
      return [fx, fy, fz];   // [horiz0, horiz1, vertical] in Theia units
    }
    function getCOP(prefix) {
      const s = trial.series;
      // COFP columns get "_2" suffix (parser disambiguation)
      const cx = s[`${prefix}_${haxes[0]}_2`]?.[frameIdx];
      const cy = s[`${prefix}_${haxes[1]}_2`]?.[frameIdx];
      const cz = s[`${prefix}_${axUp}_2`]?.[frameIdx];
      return [cx, cy, cz];   // [horiz0, horiz1, vertical] in Theia meters
    }
    function placeArrow(arrow, prefix, fallbackAnkle) {
      const [fx, fy, fz] = getF(prefix);
      if (!isFinite(fx) || !isFinite(fy) || !isFinite(fz)) { arrow.visible = false; return; }
      const mag = Math.sqrt(fx*fx + fy*fy + fz*fz);
      if (mag < 30) { arrow.visible = false; return; }   // <30 N = 거의 0, 숨김
      // v0.12: origin = 발(heel) frame 좌표 우선 — 스틱 본과 같은 상대좌표계로 통일.
      // (COP 는 world 절대좌표라 stick 의 trail-foot 상대좌표와 origin 이 어긋남)
      let originVX, originVY, originVZ;
      if (fallbackAnkle && fallbackAnkle.every(isFinite)) {
        originVX = fallbackAnkle[0]; originVY = fallbackAnkle[1]; originVZ = fallbackAnkle[2];  // v0.15: 발(heel)에 정확히 붙임
      } else {
        let [cx, cy, cz] = getCOP(prefix);
        if (isFinite(cx) && isFinite(cy)) {
          originVX = -(cx - ox) * 1000; originVY = 0; originVZ = (cy - oz) * 1000;
        } else { arrow.visible = false; return; }
      }
      // Force direction (Theia horiz0→viewerX, vertical→viewerY, horiz1→viewerZ)
      // vertical GRF(fz)는 물리적으로 항상 위(+) — 노이즈 음수는 0으로 클램프
      const dirV = new THREE.Vector3(-fx, Math.max(0, fz), fy).normalize();
      setForceArrow(arrow, [originVX, originVY, originVZ], dirV, mag * FORCE_SCALE);
    }
    // v0.11: FP1 = Rear (뒷발), FP2 = Lead (앞발)
    const lead_side = m.glove_side === 'left' ? 'l_heel' : 'r_heel';
    const rear_side = m.throw_side === 'right' ? 'r_heel' : 'l_heel';
    const leadPos = trial.frames[frameIdx]?.[lead_side];
    const rearPos = trial.frames[frameIdx]?.[rear_side];
    placeArrow(arrowRear, 'FP1', rearPos);   // FP1 = 뒷발
    placeArrow(arrowLead, 'FP2', leadPos);   // FP2 = 앞발
  }
  function updateGRF(trial, frameIdx)  { _drawGRF(trial, frameIdx, grfArrowRear,  grfArrowLead);  }
  function updateGRFB(trial, frameIdx) { _drawGRF(trial, frameIdx, grfArrowRearB, grfArrowLeadB); }

  function autoFit(frames, frames2) {
    if (!frames || !frames.length) return;
    // Compute centroid + bbox over all frames (+ optional 2nd skeleton for compare)
    let xMin=Infinity, xMax=-Infinity, yMin=Infinity, yMax=-Infinity, zMin=Infinity, zMax=-Infinity;
    const _scan = (arr) => {
      if (!arr) return;
      for (const f of arr) {
        for (const p of Object.values(f)) {
          if (!p || p.length < 3) continue;
          if (!isFinite(p[0]) || !isFinite(p[1]) || !isFinite(p[2])) continue;
          if (p[0] < xMin) xMin = p[0]; if (p[0] > xMax) xMax = p[0];
          if (p[1] < yMin) yMin = p[1]; if (p[1] > yMax) yMax = p[1];
          if (p[2] < zMin) zMin = p[2]; if (p[2] > zMax) zMax = p[2];
        }
      }
    };
    _scan(frames); _scan(frames2);
    if (!isFinite(xMin)) return;
    const cx = (xMin+xMax)/2, cy = (yMin+yMax)/2, cz = (zMin+zMax)/2;
    const size = Math.max(xMax-xMin, yMax-yMin, zMax-zMin);
    const dist = size * 0.95;
    // 시선점을 피겨 중심보다 위로 올려 스틱을 화면 아래쪽으로 배치
    const cyT = cy - size*0.05;
    camera.position.set(cx + dist*0.7, cy + dist*0.5, cz + dist*0.9);
    controls.target.set(cx, cyT, cz);
    controls.update();
  }

  // ── 프리셋 카메라 뷰 (측면/정면/후면/머리위) ──
  // THREE 씬축: +x=3루(측면), +y=수직, +z=홈(투구방향)
  function setView(name) {
    const T = controls.target.clone();
    let D = camera.position.distanceTo(T);
    if (!isFinite(D) || D < 100) D = 3000;
    camera.up.set(0, 1, 0);
    if (name === 'side')        camera.position.set(T.x - D, T.y, T.z);          // 1루측에서 본 시상면(홈=화면 오른쪽)
    else if (name === 'front')  camera.position.set(T.x, T.y, T.z + D);          // 홈(앞)에서 본 정면
    else if (name === 'rear')   camera.position.set(T.x, T.y, T.z - D);          // 마운드(뒤)에서 본 후면
    else if (name === 'top')  { camera.position.set(T.x, T.y + D, T.z); camera.up.set(0, 0, 1); }  // 머리 위
    else return;
    camera.lookAt(T);
    controls.update();
  }
  (function wireViews() {
    const box = document.getElementById('stick-views');
    if (!box) return;
    box.querySelectorAll('.sview').forEach(b => b.addEventListener('click', () => {
      setView(b.dataset.view);
      box.querySelectorAll('.sview').forEach(x => x.classList.toggle('on', x === b));
    }));
  })();

  function resize() {
    const w = container.clientWidth, h = container.clientHeight;
    if (w === 0 || h === 0) return;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  }

  // Render loop
  function loop() {
    requestAnimationFrame(loop);
    controls.update();
    renderer.render(scene, camera);
  }
  loop();
  window.addEventListener('resize', resize);

  return { setFrame, setFrameB, setGhostVisible, setGhostOffset, updateGRF, updateGRFB, autoFit, resize, setTrailData, setView };
})();

// ═══════════════════════════════════════════════════════════════════
// Playback controls
// ═══════════════════════════════════════════════════════════════════
const playback = (function() {
  const sliderEl = document.getElementById('slider');
  const playBtn  = document.getElementById('btn-play');
  const tDisplay = document.getElementById('t-display');
  const speedBtns = document.querySelectorAll('.speed');
  const jumpBtns = {
    fc:  document.getElementById('btn-fc'),
    mer: document.getElementById('btn-mer'),
    br:  document.getElementById('btn-br'),
  };
  let curFrame = 0, isPlaying = false, speed = 0.1, currentTrial = null;
  let rafId = null, lastTs = 0;
  let _posF = 0;   // float position accumulator (단일: frame, 비교: slider pos)

  // ── 비교 모드 상태 ──
  let cmpOn = false, cmpA = null, cmpB = null, cmpAlign = 'fc';
  let cmpAlignA = 0, cmpAlignB = 0, cmpRelMin = 0, cmpRelMax = 0;
  function _alignFrame(t) { return cmpAlign === 'br' ? (t.events.i_br ?? 0) : (t.events.i_fc ?? 0); }
  function _computeAlign() {
    cmpAlignA = _alignFrame(cmpA);
    cmpAlignB = _alignFrame(cmpB);
    const before = Math.min(cmpAlignA, cmpAlignB);
    const after  = Math.min(cmpA.meta.n_frames - 1 - cmpAlignA, cmpB.meta.n_frames - 1 - cmpAlignB);
    cmpRelMin = -before; cmpRelMax = after;
    sliderEl.min = 0; sliderEl.max = Math.max(1, cmpRelMax - cmpRelMin);
  }

  let _chartRedrawQueued = false;
  function _queueCharts() {
    if (_chartRedrawQueued) return;
    _chartRedrawQueued = true;
    requestAnimationFrame(() => {
      _chartRedrawQueued = false;
      try{ renderLiveChart(); }catch(e){}
      var _fp=document.getElementById('page-focus');
      if (_focusKey && _fp && _fp.classList.contains('visible')) { try{ _renderFocusChart(); }catch(e){} return; }
      const activePage = document.querySelector('.tab.active')?.dataset.page;
      if (activePage && activePage.indexOf('ph-')===0) { try{ _redrawPhaseCharts(); }catch(e){} return; }
      if (activePage === 'injury') { try{ _redrawPhaseCharts(); }catch(e){} return; }  // [2026-05-26] 부상 탭 스틱 동기화(전체 재렌더 회피)
      if (activePage === 'psummary' || activePage === 'coach-view') {
        // [V2] 선수 요약/코칭 뷰 = 인라인 ed-* 모두 동기화 redraw
        try{ if(_reportMode!=='player') _redrawEtCharts(); }catch(e){}
        try{ _redrawWindupCharts && _redrawWindupCharts(); }catch(e){}
        try{ _redrawXfCharts && _redrawXfCharts(); }catch(e){}
        try{ _redrawStrideCharts && _redrawStrideCharts(); }catch(e){}
        try{ _redrawBlkCharts && _redrawBlkCharts(); }catch(e){}
        try{ _redrawKneeCharts && _redrawKneeCharts(); }catch(e){}
        try{ _redrawPtCharts && _redrawPtCharts(); }catch(e){}
        try{ _redrawTrCharts && _redrawTrCharts(); }catch(e){}
        try{ _redrawTaCharts && _redrawTaCharts(); }catch(e){}
        try{ _redrawAbCharts && _redrawAbCharts(); }catch(e){}
        try{ _redrawArmEnergyCharts && _redrawArmEnergyCharts(); }catch(e){}
        try{ drawArmRiskQuad && drawArmRiskQuad('ed-arm-quad'); }catch(e){}
        return;
      }
      if (activePage === 'etdiag') { try{ _redrawEtCharts(); }catch(e){} return; }     // (구) 진단 개요 — 흡수됨, 미사용
      if (activePage === 'ed-windup') { try{ _redrawWindupCharts(); }catch(e){} return; } // 와인드업 로딩 시계열 = 스틱 동기화
      if (activePage === 'ed-xftiming') { try{ _redrawXfCharts(); }catch(e){} return; } // X-factor 시계열 = 스틱 동기화
      if (activePage === 'ed-stride') { try{ _redrawStrideCharts(); }catch(e){} return; } // 스트라이드 시계열 = 스틱 동기화
      if (activePage === 'ed-blocking') { try{ _redrawBlkCharts(); }catch(e){} return; } // 블로킹 시계열 = 스틱 동기화
      if (activePage === 'ed-knee') { try{ _redrawKneeCharts(); }catch(e){} try{ _redrawLowerFlow(); }catch(e){} return; } // 무릎전달 시계열 = 스틱 동기화
      if (activePage === 'ed-pelvistrunk') { try{ _redrawXfCharts(); }catch(e){} try{ _redrawPtCharts(); }catch(e){} return; } // 골반→몸통 시계열 = 스틱 동기화
      if (activePage === 'ed-trunk') { try{ _redrawTrCharts(); }catch(e){} try{ _redrawTaCharts(); }catch(e){} try{ _redrawTrunkAmp(); }catch(e){} return; } // 몸통 에너지 시계열 = 스틱 동기화
      if (activePage === 'ed-trunkarm') { try{ _redrawTaCharts(); }catch(e){} return; } // 몸통→팔 시계열 = 스틱 동기화
      if (activePage === 'ed-armball') { try{ _redrawArmEnergyCharts(); }catch(e){} try{ drawArmRiskQuad('ed-arm-quad'); }catch(e){} try{ _redrawAbCharts(); }catch(e){} return; } // 팔→공 시계열 = 스틱 동기화
      if (activePage && activePage.indexOf('ed-')===0) return;                          // 그 외 단계별 진단 탭 = 정적 카드
      if (activePage === 'coach' || activePage === 'summary') {
        /* 메시지 게이지 패널 삭제됨 — 정적 */
      } else if (activePage && activePage !== 'detail' && activePage !== 'biomotion' && activePage !== 'uplift_x' && activePage !== 'energyflow' && activePage !== 'etdiag') {
        renderTrialSpecific(parseInt(sel.value), activePage);
      }
    });
  }

  function setFrame(f) {
    _posF = f;
    if (cmpOn) {
      if (!cmpA || !cmpB) return;
      const range = cmpRelMax - cmpRelMin;
      const pos = Math.max(0, Math.min(range, Math.round(f)));
      const rel = pos + cmpRelMin;
      const fA = cmpAlignA + rel, fB = cmpAlignB + rel;
      curFrame = fA; _currentFrame = fA; if(typeof window!=='undefined') window._playTrial = cmpA;
      sliderEl.value = pos;
      if (tDisplay) {
        const sec = rel * cmpA.meta.dt;
        tDisplay.textContent = cmpAlign.toUpperCase() + (rel >= 0 ? ' +' : ' ') + sec.toFixed(3) + ' s';
      }
      if (cmpA.frames && cmpA.frames[fA]) stick3D.setFrame(cmpA.frames[fA], fA);
      if (cmpB.frames && cmpB.frames[fB]) stick3D.setFrameB(cmpB.frames[fB]);
      stick3D.updateGRF(cmpA, fA);
      stick3D.updateGRFB(cmpB, fB);
      updateStickHUDCompare(cmpA, fA, cmpB, fB);
      _queueCharts();
      return;
    }
    if (!currentTrial) return;
    curFrame = Math.max(0, Math.min(currentTrial.meta.n_frames - 1, Math.round(f)));
    _currentFrame = curFrame;   // ★ v0.4 전역 동기화
    if(typeof window!=='undefined') window._playTrial = currentTrial;
    sliderEl.value = curFrame;
    if (tDisplay) tDisplay.textContent = (curFrame * currentTrial.meta.dt).toFixed(3) + ' s';
    if (currentTrial.frames && currentTrial.frames[curFrame]) {
      stick3D.setFrame(currentTrial.frames[curFrame], curFrame);
    }
    stick3D.updateGRF(currentTrial, curFrame);
    updateStickHUD(currentTrial, curFrame);
    _queueCharts();
  }
  function setTrial(t) {
    currentTrial = t;
    sliderEl.min = 0; sliderEl.max = t.meta.n_frames - 1;
    stick3D.autoFit(t.frames);
    stick3D.setTrailData(t.frames);
    setFrame(t.events.i_fc ?? 0);
  }
  // ── 비교 모드 on/off + 설정 ──
  function setCompare(on, a, b, align) {
    stopPlay();
    cmpOn = !!on;
    if (a) cmpA = a;
    if (b) cmpB = b;
    if (align) cmpAlign = align;
    if (cmpOn && cmpA && cmpB) {
      stick3D.setGhostVisible(true);
      _computeAlign();
      stick3D.autoFit(cmpA.frames, cmpB.frames);
      stick3D.setTrailData(cmpA.frames);
      setFrame(-cmpRelMin);   // rel=0 (정렬 이벤트) 에서 시작
    } else {
      cmpOn = false;
      stick3D.setGhostVisible(false);
      stick3D.setGhostOffset(0);
      setTrial(DATA.trials[parseInt(sel.value)]);
    }
  }
  function setGhostOffset(z) { stick3D.setGhostOffset(z); }
  function isCompare() { return cmpOn; }
  function compareTrials() { return cmpOn ? [cmpA, cmpB] : null; }

  sliderEl.addEventListener('input', e => { stopPlay(); setFrame(parseInt(e.target.value)); });
  function startPlay() {
    if (isPlaying) return;
    if (!cmpOn && !currentTrial) return;
    isPlaying = true; playBtn.textContent = '❚❚'; lastTs = 0;
    rafId = requestAnimationFrame(tick);
  }
  function stopPlay() {
    isPlaying = false; if (playBtn) playBtn.textContent = '▶';
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  }
  function tick(ts) {
    if (!isPlaying) return;
    if (!lastTs) lastTs = ts;
    const elapsed = (ts - lastTs) / 1000;
    lastTs = ts;
    if (cmpOn && cmpA) {
      const range = cmpRelMax - cmpRelMin;
      const stride = elapsed * speed / cmpA.meta.dt;
      let next = _posF + stride;
      if (next >= range) { next = 0; }
      setFrame(next);
    } else if (currentTrial) {
      const stride = elapsed * speed / currentTrial.meta.dt;
      let next = _posF + stride;
      if (next >= currentTrial.meta.n_frames - 1) { next = 0; }
      setFrame(next);
    }
    rafId = requestAnimationFrame(tick);
  }
  playBtn.addEventListener('click', () => { isPlaying ? stopPlay() : startPlay(); });
  speedBtns.forEach(b => b.addEventListener('click', () => {
    speedBtns.forEach(x => x.classList.remove('on'));
    b.classList.add('on');
    speed = parseFloat(b.dataset.speed);
  }));
  Object.entries(jumpBtns).forEach(([key, btn]) => {
    if (!btn) return;
    btn.addEventListener('click', () => {
      stopPlay();
      if (cmpOn && cmpA) {
        // 비교: A 의 이벤트로 점프 (rel = A_event - alignA)
        const evA = key === 'fc' ? cmpA.events.i_fc :
                    key === 'mer' ? cmpA.events.i_mer : cmpA.events.i_br;
        if (evA != null) setFrame((evA - cmpAlignA) - cmpRelMin);
        return;
      }
      if (!currentTrial) return;
      const ev = key === 'fc' ? currentTrial.events.i_fc :
                 key === 'mer' ? currentTrial.events.i_mer :
                 currentTrial.events.i_br;
      if (ev != null) setFrame(ev);
    });
  });
  return { setTrial, setFrame, setCompare, setGhostOffset, isCompare, compareTrials };
})();

// ═══════════════════════════════════════════════════════════════════
// Boot
// ═══════════════════════════════════════════════════════════════════
(function(){ // 기본=단일 스켈레톤(깔끔). 빠른공 vs 느린공 겹쳐보기는 「두 트라이얼 비교」 패널에서 켜기(opt-in).
  playback.setTrial(DATA.trials[parseInt(sel.value)]);
})();
renderSummary(DATA.trials[parseInt(sel.value)]);
// [2026-05-27] 전용 진단 리포트는 DATA._landing='etdiag' 로 진단 탭에 착지

/* ── 전역 동기화 트랜스포트 — 스크러버 하나로 모든 탭 그래프의 _currentFrame 커서 동기화 ── */
var _gt={playing:false,raf:null,speed:0.5,last:0}; var _gtFocus=false;
function _gtPhases(){ var w=_gtWin(); if(!w)return null; var e=w.e, i0=w.i0, i1=w.i1, KH=(e.i_kl_peak!=null?e.i_kl_peak:i0), FC=(e.i_fc!=null?e.i_fc:i0), MER=(e.i_mer!=null?e.i_mer:i1), BR=(e.i_br!=null?e.i_br:i1);
  return [[i0,KH],[KH,FC],[FC,FC+(MER-FC)*0.34],[FC+(MER-FC)*0.34,FC+(MER-FC)*0.67],[FC+(MER-FC)*0.67,MER],[MER,i1]]; }
function _gtActiveWin(frame){ var ps=_gtPhases(); if(!ps)return null; for(var i=0;i<ps.length;i++){ if(frame>=ps[i][0]&&frame<ps[i][1]) return ps[i]; } return ps[ps.length-1]; }
function _gtWin(){ var t; try{t=_fastTrial();}catch(e){t=null;} if(!t||!t.meta)return null;
  var dt=t.meta.dt, e=t.events||{}, i0=Math.max(0,(e.i_kl_peak||0)-Math.round(0.1/dt)), i1=(t.meta.n_frames||1)-1;
  return {i0:i0,i1:i1,dt:dt,e:e}; }
function _gtSet(f){ var w=_gtWin(); if(!w)return; _currentFrame=Math.max(w.i0,Math.min(w.i1,Math.round(f)));
  var sl=document.getElementById('gt-range'); if(sl&&(+sl.value)!==_currentFrame) sl.value=_currentFrame;
  var tm=document.getElementById('gt-time'); if(tm) tm.textContent=((_currentFrame-(w.e.i_fc||0))*w.dt).toFixed(3)+' s';
  try{_queueCharts();}catch(e){}
  try{ if(typeof playback!=='undefined'&&playback&&playback.setFrame) playback.setFrame(_currentFrame); }catch(e){}
  try{ if(typeof _DG!=='undefined'&&_DG.GA&&document.getElementById('dgcv-'+(_DG.GA[0]&&_DG.GA[0].key)+'-ts')){ _DG.idx=Math.max(_DG.i0,Math.min(_DG.i1,_currentFrame)); _DG.frame(); } }catch(e){}
  try{ var _th=document.getElementById('three'); if(_th){ if(_gtFocus){ var ps=_gtPhases(), idx=ps?ps.length-1:-1; if(ps){ for(var _q=0;_q<ps.length;_q++){ if(_currentFrame>=ps[_q][0]&&_currentFrame<ps[_q][1]){ idx=_q; break; } } } var ef=(typeof _efPhases==='function')?_efPhases():null, stt=(ef&&ef[idx])?ef[idx].status:null, cc=stt?((typeof _efCol==='function')?_efCol(stt):(stt==='good'?'#5bab84':stt==='warn'?'#cb9a4a':'#d65c4d')):null; _th.style.outline=cc?('2px solid '+cc):''; _th.style.outlineOffset=cc?'-2px':''; } else { _th.style.outline=''; } } }catch(e){}
}
function _gtStop(){ _gt.playing=false; if(_gt.raf){cancelAnimationFrame(_gt.raf);_gt.raf=null;} var pb=document.getElementById('gt-play'); if(pb)pb.textContent='▶'; }
function _gtPlay(){ var w=_gtWin(); if(!w)return; _gt.playing=true; var pb=document.getElementById('gt-play'); if(pb)pb.textContent='❚❚'; _gt.last=performance.now();
  (function tick(now){ if(!_gt.playing)return; var d=(now-_gt.last)/1000; _gt.last=now; var step=Math.max(1,Math.round(d*_gt.speed/w.dt));
   var nf=(_currentFrame||w.i0)+step; if(nf>=w.i1){ _gtSet(w.i1); _gtStop(); return; } _gtSet(nf); _gt.raf=requestAnimationFrame(tick); })(performance.now()); }
function _initGlobalTransport(){ try{
  var w=_gtWin(); if(!w) return; if(document.getElementById('gt-bar')) return;
  var evs=[['KH',w.e.i_kl_peak],['FC',w.e.i_fc],['MER',w.e.i_mer],['BR',w.e.i_br]];
  var ticks=evs.map(function(ev){ if(ev[1]==null)return''; var pc=((ev[1]-w.i0)/((w.i1-w.i0)||1)*100);
    return '<span style="position:absolute;top:0;left:'+pc+'%;font-size:11px;color:#9aa7b6;font-weight:700;transform:translateX(-50%);white-space:nowrap">'+ev[0]+'</span><span style="position:absolute;top:15px;left:'+pc+'%;width:1px;height:18px;background:#6d7b8c"></span>'; }).join('');
  var bar=document.createElement('div'); bar.id='gt-bar';
  bar.style.cssText='position:fixed;left:0;right:0;bottom:0;z-index:9000;background:rgba(14,18,24,.96);border-top:1px solid #2a3543;padding:8px 16px 10px';
  bar.innerHTML='<div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:12px">'
   +'<button id="gt-play" title="재생/정지" style="width:38px;height:38px;border-radius:9px;border:none;background:#3f86cf;color:#fff;font-size:15px;cursor:pointer;flex:0 0 auto">▶</button>'
   +'<div style="position:relative;flex:1;height:40px">'+ticks+'<input id="gt-range" type="range" min="'+w.i0+'" max="'+w.i1+'" value="'+w.i0+'" step="1" style="position:absolute;top:16px;left:0;width:100%;accent-color:#3f86cf"></div>'
   +'<div id="gt-spd" style="display:flex;gap:4px;flex:0 0 auto"><button data-v="0.5">0.5×</button><button data-v="1">1×</button><button data-v="2">2×</button></div>'+'<button id="gt-focus" title="집중(시선 유도) — 활성 단계 구간만 강조" style="font-size:12px;font-weight:700;padding:6px 9px;border-radius:7px;border:1px solid #2a3543;background:#1c2430;color:#9aa7b6;cursor:pointer;flex:0 0 auto">집중</button>'
   +'<span id="gt-time" style="font-size:12px;color:#9aa7b6;min-width:74px;text-align:right;flex:0 0 auto;font-variant-numeric:tabular-nums">0.000 s</span>'
   +'<span class="note" style="font-size:11px;color:#6d7b8c;flex:0 0 auto">FC기준</span></div>';
  document.body.appendChild(bar); document.body.style.paddingBottom='66px';
  var sp=bar.querySelectorAll('#gt-spd button'); function paint(){ sp.forEach(function(x){ var on=parseFloat(x.getAttribute('data-v'))===_gt.speed; x.style.cssText='font-size:12px;font-weight:700;padding:6px 9px;border-radius:7px;border:1px solid #2a3543;cursor:pointer;background:'+(on?'#3f86cf':'#1c2430')+';color:'+(on?'#fff':'#9aa7b6'); }); }
  sp.forEach(function(b){ b.addEventListener('click',function(){ _gt.speed=parseFloat(b.getAttribute('data-v')); paint(); }); }); paint();
  document.getElementById('gt-range').addEventListener('input',function(e){ _gtStop(); _gtSet(parseInt(e.target.value,10)); });
  document.getElementById('gt-play').addEventListener('click',function(){ if(_gt.playing)_gtStop(); else _gtPlay(); });
  window.addEventListener('wheel',function(ev){ if(!ev.ctrlKey)return; ev.preventDefault(); _gtStop(); _gtSet((_currentFrame||w.i0)+(ev.deltaY>0?3:-3)); },{passive:false});
  var fb=document.getElementById('gt-focus'); if(fb){ fb.addEventListener('click',function(){ _gtFocus=!_gtFocus; fb.style.background=_gtFocus?'#3f86cf':'#1c2430'; fb.style.color=_gtFocus?'#fff':'#9aa7b6'; try{_gtSet(_currentFrame);}catch(e){} }); }
  window.addEventListener('keydown',function(ev){ var tg=(ev.target&&ev.target.tagName)||''; if(/INPUT|TEXTAREA|SELECT/.test(tg))return; var ww=_gtWin(); if(!ww)return;
    if(ev.code==='Space'){ ev.preventDefault(); if(_gt.playing)_gtStop(); else _gtPlay(); }
    else if(ev.code==='ArrowRight'){ ev.preventDefault(); _gtStop(); _gtSet((_currentFrame||ww.i0)+1); }
    else if(ev.code==='ArrowLeft'){ ev.preventDefault(); _gtStop(); _gtSet((_currentFrame||ww.i0)-1); }
    else if(ev.code==='Home'){ ev.preventDefault(); _gtStop(); _gtSet(ww.i0); }
    else if(ev.code==='End'){ ev.preventDefault(); _gtStop(); _gtSet(ww.i1); } });
  _gtSet(w.i0);
}catch(e){} }

(function(){ try{ if(DATA._landing && document.querySelector('.tab[data-page="'+DATA._landing+'"]')){ setPage(DATA._landing); } }catch(e){} })();
try{ if(typeof requestAnimationFrame!=='undefined') requestAnimationFrame(function(){ _initGlobalTransport(); }); }catch(e){}
(function(){ var lc=document.getElementById('lc-sel'); if(lc){ var SIG=(typeof _liveSignals==='function')?_liveSignals():LC_SIGNALS; var cur=null, og=null; SIG.forEach(function(s,i){ if(s.phase&&s.phase!==cur){ cur=s.phase; og=document.createElement('optgroup'); og.label=s.phase; lc.appendChild(og); } var o=document.createElement('option'); o.value=i; o.textContent=s.label; (og||lc).appendChild(o); }); lc.addEventListener('change', renderLiveChart); } try{ renderLiveChart(); }catch(e){} })();
sel.addEventListener('change', () => {
  if (playback.isCompare()) return;   // 비교 모드 중에는 상단 드롭다운 무시
  playback.setTrial(DATA.trials[parseInt(sel.value)]);
});
window.addEventListener('resize', () => { stick3D.resize(); renderTrialSpecific(parseInt(sel.value)); });

// ── 데이터 없는 탭 자동 숨김 (Uplift = GRF/Power/부상/X-Check 없음) ──
(function hideEmptyTabs() {
  const hideMap = {
    grf:      !HAS_GRF,
    injury:   !(DATA.injury_risk || (DATA.phases && DATA.phases.stages && DATA.phases.stages.some(function(s){return s.key==='injuryload';}))),
    power:    !HAS_POWER,
    'imu-native': !(DATA.system && /IMU/i.test(DATA.system)),
    uplift_x: !(DATA.uplift_xcheck && DATA.uplift_xcheck.available),
    inefficiency: !(DATA.inefficiency_summary && DATA.inefficiency_summary.flags),
    session: !DATA.session_summary,
    'ph-balance': !(DATA.phases && DATA.phases.stages && DATA.phases.stages.some(function(s){return s.key==='balance';})),
    energyflow: !(HAS_GRF && HAS_POWER),   // [2026-05-27] 에너지 흐름 = GRF+관절파워(Theia) 전용. Uplift는 추후 별도 지원.
    etdiag: !(HAS_GRF && HAS_POWER),       // [2026-05-27] 에너지 전달 진단 = GRF+관절파워(Theia) 전용.
    psummary: !(HAS_GRF && HAS_POWER),     // [2026-05-27] 선수 요약 = 9단계 종합(Theia 전용)
    'coach-view': !(HAS_GRF && HAS_POWER), // [2026-05-28] 코칭 뷰 = 5 챕터 스토리(Theia 전용)
    command: !(DATA.command && DATA.command.score!=null), // [2026-05-28] 제구·랩소도 = 랩소도 데이터 있을 때만
  };
  if (typeof _ED_NODES !== 'undefined') _ED_NODES.forEach(function(n){ hideMap['ed-'+n[0]] = !(HAS_GRF && HAS_POWER); }); hideMap['ed-xftiming']=true; hideMap['ed-pelvistrunk']=true; hideMap['ed-trunkarm']=true; /* [2026-05-29] 통합: 하체(무릎+골반몸통+X-factor)·상체(몸통E+몸통팔) */  // 9 단계 진단 탭도 Theia 전용
  for (const [page, hide] of Object.entries(hideMap)) {
    if (!hide) continue;
    document.querySelectorAll(`.tab[data-page="${page}"]`).forEach(el => { el.style.display = 'none'; el.dataset.hidden='1'; });
    const pg = document.getElementById('page-' + page);
    if (pg) { pg.classList.remove('visible'); pg.style.display = 'none'; }
  }
})();

// ── 보기 모드 토글 (UX 재설계 지침 v1): 선수 / 코치 / 연구자 정보 층위 ──
// 선수=요약·9단계 개요만, 코치=+근거(9단계 상세·ph-*·스틱·에너지흐름), 연구자=전체. (Theia 전용 탭은 hideMap이 이미 처리)
var _reportMode = 'coach';
// 선수=요약+개요만. 코치=요약·개요·9단계 진단·메카닉·에너지흐름·부상(증거 ph-*/레거시는 단계 '근거 보기'로 드릴다운). 연구자=전체.
var _RMODE_PLAYER = ['psummary','command'];
var _RMODE_COACH = ['psummary','ed-windup','ed-xftiming','ed-stride','ed-blocking','ed-knee','ed-pelvistrunk','ed-trunk','ed-trunkarm','ed-armball','command','injury','hpa'];
function applyReportMode(m){
  _reportMode = m;
  try{ document.body.setAttribute('data-rmode', m); }catch(e){}
  document.querySelectorAll('.rmode-btn').forEach(function(b){ b.classList.toggle('active', b.dataset.rmode===m); });
  document.querySelectorAll('nav.tabs .tab').forEach(function(t){
    var p=t.dataset.page, show;
    if(t.dataset.hidden==='1') show=false;                                   // 비-Theia 등 hideMap 처리분은 항상 숨김
    else if(m==='player') show = _RMODE_PLAYER.indexOf(p)>=0;
    else show=true;                                                          // coach = 전체(연구자 통합)
    t.style.display = show?'':'none';
  });
  // 그룹 구분선은 전체 표시(코치) 모드에서만 — 선수 모드에선 숨겨 깔끔하게
  document.querySelectorAll('.tab-sep').forEach(function(s){ s.style.display = (m!=='player')?'':'none'; });
  var act=document.querySelector('.tab.active');
  if(!act || act.style.display==='none'){ try{ setPage('psummary'); }catch(e){} }
  else if(act.dataset.page==='psummary'){ try{ renderPlayerSummary(); }catch(e){} }   // 모드 전환 시 통합 요약의 연구자 종합차트 표시/숨김 반영
}
// [2026-05-28] rmode-bar 정리: 보기 모드 라벨/버튼 제거 → 큰 색 박스 범례만 + sticky 고정
(function _injectModeToggle(){
  try{
    var nav=document.querySelector('nav.tabs'); if(!nav) return;
    var bar=document.createElement('div'); bar.className='rmode-bar';
    // sticky 위치는 _stickyTabs IIFE가 nav.style.top 잡아주므로 bar는 nav 바로 위. position sticky로 고정.
    bar.style.cssText='display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:8px 14px;background:var(--bg1);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30';
    var LEGEND=[
      {col:'#9c8cff', l:'저장'},
      {col:'#3b82f6', l:'생성(출력)'},
      {col:'#46c98c', l:'전달(효율)'},
      {col:'#e8954e', l:'부하'}
    ];
    bar.innerHTML=LEGEND.map(function(x){
      return '<span style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:'+x.col+'"><span style="display:inline-block;width:13px;height:13px;background:'+x.col+';border-radius:3px"></span>'+x.l+'</span>';
    }).join('<span style="display:inline-block;width:18px"></span>');
    var _ha=document.querySelector('.header-actions'); if(_ha){ bar.style.cssText='display:inline-flex;align-items:center;gap:14px;flex-wrap:wrap'; _ha.insertBefore(bar, _ha.firstChild); } else { nav.parentNode.insertBefore(bar, nav); }
    // mode 토글은 코드상으로 유지 (자동 default 'coach') — UI는 숨김
  }catch(e){}
})();

// ── Tab 재구성 (DATA.tab_config 있을 때만 — Theia 전용 순서/이름/삭제) ──
(function applyTabConfig() {
  const cfg = (typeof DATA !== 'undefined') && DATA.tab_config;
  if (!cfg || !Array.isArray(cfg.order) || !cfg.order.length) return;
  const first = document.querySelector('.tab[data-page]');
  const nav = first && first.parentElement;
  if (!nav) return;
  // ── 레거시 tab_config 보정: 9단계 진단(ed-*) 탭이 빠진 옛 저장 데이터만 현재 구조로 교체(메카닉·증거 제외) ──
  if (cfg.order.indexOf('ed-windup') < 0 && document.querySelector('.tab[data-page="ed-windup"]')) {
    var ord = ['psummary', 'coach-view', 'ed-windup', 'ed-xftiming', 'ed-stride', 'ed-blocking', 'ed-knee', 'ed-pelvistrunk', 'ed-trunk', 'ed-trunkarm', 'ed-armball'];
    if (DATA.command) ord.push('command');                                                   // 제구·랩소도 있을 때만
    if (DATA.hp_assessment && DATA.hp_assessment.overall_score != null) ord.splice(1, 0, 'hpa'); // 체력 있을 때만
    cfg.order = ord;
    cfg.sep_after = ['psummary', 'ed-armball'];
  }
  // [2026-05-28] coach-view 추가 보정 — 옛 tab_config에 없으면 psummary 뒤에 삽입
  if (cfg.order.indexOf('coach-view') < 0 && document.querySelector('.tab[data-page="coach-view"]')) {
    var _psi = cfg.order.indexOf('psummary');
    cfg.order.splice(_psi >= 0 ? _psi + 1 : 1, 0, 'coach-view');
  }
  // [2026-05-28] command(제구·랩소도) 추가 보정 — 옛 tab_config에 없으면 ed-armball 뒤에 삽입
  if (cfg.order.indexOf('command') < 0 && document.querySelector('.tab[data-page="command"]')) {
    var _abi = cfg.order.indexOf('ed-armball');
    cfg.order.splice(_abi >= 0 ? _abi + 1 : cfg.order.length, 0, 'command');
  }
  const order = cfg.order.filter(function(p){return p!=='coach-view'&&p!=='injury'&&p!=='detail';}), labels = cfg.labels || {}; var _LBLOVR={'ed-knee':'앞무릎 에너지 전달','ed-trunk':'몸통 에너지','ed-armball':'팔 에너지','ed-stride':'스트라이드'}; Object.keys(_LBLOVR).forEach(function(k){ labels[k]=_LBLOVR[k]; }); /* [2026-05-29] 통합 탭 이름 강제 */  // [2026-05-29] 코칭 뷰 탭 제거
  // [FIX 2026-05-25] IMU 리포트면 'IMU 고유' 탭을 순서에 보존(없으면 부상 앞에 삽입)
  if (DATA.system && /IMU/i.test(DATA.system) && order.indexOf('imu-native') < 0) {
    var _ij = order.indexOf('injury'); order.splice(_ij >= 0 ? _ij : order.length, 0, 'imu-native');
  }
  const keep = new Set(order);
  keep.add('coach-view'); // [2026-05-28] 신규 탭 항상 보존(옛 tab_config 우회)
  keep.add('command');    // [2026-05-28] 제구·랩소도 탭도 강제 보존
  // 1) 미포함 탭 + 해당 섹션 제거 (coach-view·command는 강제 보존)
  document.querySelectorAll('.tab[data-page]').forEach(t => {
    const p = t.dataset.page;
    if (p === 'coach-view' || p === 'command') return; // 신규 탭 절대 제거 금지
    if (!keep.has(p)) {
      t.remove();
      const sec = document.getElementById('page-' + p);
      if (sec) sec.remove();
    }
  });
  // 2) 이름 변경 + 순서대로 재배치 (그룹 구분선 삽입)
  const sepAfter = new Set(cfg.sep_after || []);
  order.forEach(p => {
    const t = document.querySelector(`.tab[data-page="${p}"]`);
    if (!t) return;
    if (labels[p]) t.textContent = labels[p];
    nav.appendChild(t);
    if (sepAfter.has(p)) {
      const sep = document.createElement('span');
      sep.className = 'tab-sep';
      // 구분선 앞 탭이 숨겨졌으면 구분선도 숨김
      if (t.style.display === 'none') sep.style.display = 'none';
      nav.appendChild(sep);
    }
  });
  // 3) 첫 탭 활성화 (DATA._landing 우선, 없으면 첫 탭)
  var landId = (typeof DATA!=='undefined' && DATA._landing && document.querySelector('.tab[data-page="'+DATA._landing+'"]')) ? DATA._landing : order.find(p => document.querySelector(`.tab[data-page="${p}"]`));
  if (landId && typeof setPage === 'function') setPage(landId);
})();
// 보기 모드 최종 적용 (tab_config 재배치 이후) — 기본 코치
try{ applyReportMode('coach'); }catch(e){}

// ── 탭 sticky offset = 헤더 실제 높이 (헤더 2단·리사이즈 대응) ──
(function syncTabsOffset() {
  const header = document.querySelector('header');
  const nav = document.querySelector('nav.tabs');
  if (!header || !nav) return;
  const apply = () => { nav.style.top = header.offsetHeight + 'px'; };
  apply();
  window.addEventListener('resize', apply);
})();

// ═══════════════════════════════════════════════════════════════════
// [2026-05-28 C안 Hybrid] 9단계 탭 색 배지 — 출력(생성)/효율(전달)/저장/부하 분류
// ═══════════════════════════════════════════════════════════════════
function _injectTabBadges(){
  try{
    var TAGS={
      'ed-windup':{c:'#9c8cff',l:'저장'},
      'ed-xftiming':{c:'#46c98c',l:'전달(효율)'},
      'ed-stride':{c:'#5bd3ff',l:'생성(출력)'},
      'ed-blocking':{c:'#5bd3ff',l:'생성(출력)'},
      'ed-knee':{c:'#46c98c',l:'전달(효율)'},
      'ed-pelvistrunk':{c:'#46c98c',l:'전달(효율)'},
      'ed-trunk':{c:'#5bd3ff',l:'생성(출력)'},
      'ed-trunkarm':{c:'#e8954e',l:'부하(팔)'},
      'ed-armball':{c:'#e8954e',l:'부하(팔)'},
      'command':{c:'#f5c542',l:'결과(제구·랩소도)'}
    };
    Object.keys(TAGS).forEach(function(key){
      var t=document.querySelector('.tab[data-page="'+key+'"]');
      if(!t) return;
      t.style.borderBottom='none'; // 하단 라인 제거 (rmode-bar에 범례로 대체)
      t.title=TAGS[key].l+' 노드';
      // 작은 점 → 굵은 세로 막대로
      var existing=t.querySelector('.tab-badge');
      if(existing) existing.remove();
      var bar=document.createElement('span');
      bar.className='tab-badge';
      bar.style.cssText='display:inline-block;width:5px;height:16px;background:'+TAGS[key].c+';margin-right:7px;vertical-align:middle;border-radius:2px';
      t.insertBefore(bar,t.firstChild);
    });
    // 기존 범례 한 줄 제거 (rmode-bar 범례 박스로 대체됨)
    var lg=document.getElementById('_tab-badge-legend');
    if(lg) lg.remove();
  }catch(e){console.warn('tab badge',e);}
}
(function(){ setTimeout(function(){ try{_injectTabBadges();}catch(e){} }, 100); })();

// ═══════════════════════════════════════════════════════════════════
// 트라이얼 비교 모드 wiring
// ═══════════════════════════════════════════════════════════════════
(function compareUI() {
  const btn   = document.getElementById('btn-compare');
  const body  = document.getElementById('cmp-body');
  const selA  = document.getElementById('cmp-a');
  const selB  = document.getElementById('cmp-b');
  const auto  = document.getElementById('cmp-auto');
  const viewSeg  = document.getElementById('cmp-view');
  const alignSeg = document.getElementById('cmp-align');
  const varsEl   = document.getElementById('cmp-vars');
  if (!btn || !selA || !selB) return;

  const SIDE_OFFSET = 1600;   // 좌우 보기 시 ghost 측면 이동량(mm)
  let view = 'overlay', align = 'fc';
  const veloOf = t => (t.rapsodo && isFinite(t.rapsodo.velocity_kmh)) ? t.rapsodo.velocity_kmh : null;

  // 드롭다운 채우기
  DATA.trials.forEach((t, i) => {
    const v = veloOf(t);
    const txt = v ? `${t.meta.trial_label} · ${v.toFixed(1)} km/h` : `${t.meta.trial_label} · (구속없음)`;
    [selA, selB].forEach(s => { const o = document.createElement('option'); o.value = i; o.textContent = txt; s.appendChild(o); });
  });
  // 기본: 빠름 vs 느림
  function fastSlow() {
    const withV = DATA.trials.map((t, i) => ({ i, v: veloOf(t) })).filter(x => x.v != null);
    if (withV.length < 2) return [0, Math.min(1, DATA.trials.length - 1)];
    withV.sort((a, b) => a.v - b.v);
    return [withV[withV.length - 1].i, withV[0].i];   // [빠름, 느림]
  }
  const [fi, si] = fastSlow();
  selA.value = fi; selB.value = si;

  function trA() { return DATA.trials[parseInt(selA.value)]; }
  function trB() { return DATA.trials[parseInt(selB.value)]; }

  function applyCompare() {
    window._cmpB = trB();
    playback.setCompare(true, trA(), trB(), align);
    playback.setGhostOffset(view === 'side' ? SIDE_OFFSET : 0);
    // 오른쪽 차트는 트라이얼 A 를 따라가도록 (setTrial 호출 없이 값만 변경)
    sel.value = parseInt(selA.value);
    renderComparePanel(trA(), trB());
    renderTrialSpecific(parseInt(sel.value));
  }

  btn.addEventListener('click', () => {
    const on = !btn.classList.contains('on');
    btn.classList.toggle('on', on);
    body.hidden = !on;
    sel.disabled = on;
    if (on) { applyCompare(); }
    else { playback.setCompare(false); window._cmpB=null; renderTrialSpecific(parseInt(sel.value)); }
  });
  auto.addEventListener('click', () => {
    const [a, b] = fastSlow();
    selA.value = a; selB.value = b;
    if (btn.classList.contains('on')) applyCompare();
  });
  selA.addEventListener('change', () => { if (btn.classList.contains('on')) applyCompare(); });
  selB.addEventListener('change', () => { if (btn.classList.contains('on')) applyCompare(); });
  viewSeg.querySelectorAll('.seg-btn').forEach(b => b.addEventListener('click', () => {
    viewSeg.querySelectorAll('.seg-btn').forEach(x => x.classList.remove('on'));
    b.classList.add('on'); view = b.dataset.view;
    playback.setGhostOffset(view === 'side' ? SIDE_OFFSET : 0);
  }));
  alignSeg.querySelectorAll('.seg-btn').forEach(b => b.addEventListener('click', () => {
    alignSeg.querySelectorAll('.seg-btn').forEach(x => x.classList.remove('on'));
    b.classList.add('on'); align = b.dataset.align;
    if (btn.classList.contains('on')) applyCompare();
  }));

  // 변인 비교표
  function renderComparePanel(a, b) {
    const ka = a.kseq && a.kseq.segments || {}, kb = b.kseq && b.kseq.segments || {};
    const sa = a.scalars || {}, sb = b.scalars || {};
    const rows = [
      ['구속 (km/h)',      veloOf(a),               veloOf(b),               1],
      ['회전수 (rpm)',     a.rapsodo?.total_spin_rpm, b.rapsodo?.total_spin_rpm, 0],
      ['Shoulder ER max (°)', sa.shoulder_er_max,    sb.shoulder_er_max,      1],
      ['X-Factor max (°)', sa.x_factor_max,          sb.x_factor_max,         1],
      ['Stride (m)',       sa.stride_length,         sb.stride_length,        2],
      ['Lead Knee @BR (°)',sa.lead_knee_br,          sb.lead_knee_br,         1],
      ['Pelvis peak (°/s)',ka.pelvis?.peak_abs,      kb.pelvis?.peak_abs,     0],
      ['Trunk peak (°/s)', ka.trunk?.peak_abs,       kb.trunk?.peak_abs,      0],
      ['Arm peak (°/s)',   ka.arm?.peak_abs,         kb.arm?.peak_abs,        0],
      ['GRF Lead (%BW)',   sa.grf_fp2_peak_pct_bw,   sb.grf_fp2_peak_pct_bw,  1],
      ['GRF Rear (%BW)',   sa.grf_fp1_peak_pct_bw,   sb.grf_fp1_peak_pct_bw,  1],
    ];
    const f = (v, d) => (v == null || !isFinite(v)) ? '—' : v.toFixed(d);
    let html = `<table><thead><tr><th>변인</th><th>A·${a.meta.trial_label.replace('Trial ','T')}</th><th>B·${b.meta.trial_label.replace('Trial ','T')}</th><th>Δ(B−A)</th></tr></thead><tbody>`;
    for (const [lbl, va, vb, d] of rows) {
      let dCell = '—', dCls = 'delta';
      if (va != null && vb != null && isFinite(va) && isFinite(vb)) {
        const diff = vb - va;
        const arrow = diff > 0 ? '▲' : (diff < 0 ? '▼' : '');
        dCls += diff > 0 ? ' up' : (diff < 0 ? ' down' : '');
        dCell = `${arrow}${Math.abs(diff).toFixed(d)}`;
      }
      html += `<tr><td>${lbl}</td><td>${f(va, d)}</td><td>${f(vb, d)}</td><td class="${dCls}">${dCell}</td></tr>`;
    }
    html += `</tbody></table>`;
    varsEl.innerHTML = html;
  }
})();
// ═══════════════════════════════════════════════════════════════════
// Render: 에너지 생성·전달 평가 (Theia 전용) — Phase 1
//  관절 파워 → 일(work, 생성/흡수) → 전신 전진 KE → peak power 시퀀싱
// ═══════════════════════════════════════════════════════════════════
function _enWork(arr, dt, lo, hi) {
  // 구간 [lo,hi] 의 일(work)=∫P dt. 양수=에너지 생성(concentric), 음수=흡수(eccentric).
  let pos = 0, neg = 0;
  if (!arr) return { pos: null, neg: null, net: null };
  const a = Math.max(0, lo), b = Math.min(arr.length - 1, hi);
  for (let i = a; i <= b; i++) {
    const p = arr[i]; if (!isFinite(p)) continue;
    const w = p * dt; if (w >= 0) pos += w; else neg += w;
  }
  return { pos, neg, net: pos + neg };
}
function _enPeak(arr, dt, i_fc, lo, hi) {
  // 구간 내 최대 양(+)파워와 그 시점(ms, FC 기준)
  if (!arr) return { peak: null, t_ms: null };
  let pk = -Infinity, pi = -1;
  const a = Math.max(0, lo), b = Math.min(arr.length - 1, hi);
  for (let i = a; i <= b; i++) { const p = arr[i]; if (isFinite(p) && p > pk) { pk = p; pi = i; } }
  return { peak: pi >= 0 ? pk : null, t_ms: pi >= 0 ? (pi - i_fc) * dt * 1000 : null };
}

// ── 2단계: per-axis 관절 파워 (계산 · ΣM·ω) ──
function _enDeriv(a, dt) {            // 각도(deg) 시계열 → 각속도(rad/s), 중앙차분
  if (!a) return null;
  const w = new Array(a.length).fill(NaN);
  for (let i = 1; i < a.length - 1; i++)
    if (isFinite(a[i+1]) && isFinite(a[i-1])) w[i] = (a[i+1] - a[i-1]) / (2*dt) * Math.PI / 180;
  return w;
}
function _enCorr(a, b, lo, hi) {
  let n=0, sa=0, sb=0, saa=0, sbb=0, sab=0;
  for (let i=Math.max(0,lo); i<=hi && i<a.length && i<b.length; i++) {
    const x=a[i], y=b[i]; if (!isFinite(x)||!isFinite(y)) continue;
    n++; sa+=x; sb+=y; saa+=x*x; sbb+=y*y; sab+=x*y;
  }
  if (n<4) return NaN;
  const cov=sab-sa*sb/n, va=saa-sa*sa/n, vb=sbb-sb*sb/n;
  return (va>0&&vb>0) ? cov/Math.sqrt(va*vb) : NaN;
}
// 관절 per-axis 파워 = M_축 × ω_축. net 파워와 부호 정렬(상관 음수면 전체 반전) + 검증 corr 반환.
function _enAxisPower(trial, momPrefix, angPrefix, netKey) {
  const S=trial.series||{}, dt=trial.meta.dt, ev=trial.events||{};
  const P={};
  for (const ax of ['X','Y','Z']) {
    const M=S[momPrefix+'_'+ax], w=_enDeriv(S[angPrefix+'_'+ax], dt);
    if (!M||!w) { P[ax]=null; continue; }
    const n=Math.min(M.length, w.length), arr=new Array(n);
    for (let i=0;i<n;i++) arr[i]=(isFinite(M[i])&&isFinite(w[i])) ? M[i]*w[i] : NaN;
    P[ax]=arr;
  }
  const axes=['X','Y','Z'].filter(a=>P[a]);
  let summed=null;
  if (axes.length) {
    const n=Math.min(...axes.map(a=>P[a].length)); summed=new Array(n);
    for (let i=0;i<n;i++){ let s=0,ok=false; for(const a of axes){const v=P[a][i]; if(isFinite(v)){s+=v;ok=true;}} summed[i]=ok?s:NaN; }
  }
  const net=S[netKey]; let corr=NaN, flipped=false;
  if (net && summed) {
    corr=_enCorr(summed, net, ev.i_kl_peak||0, ev.i_br||(summed.length-1));
    if (isFinite(corr) && corr<0) { flipped=true; for(const a of axes) P[a]=P[a].map(v=>isFinite(v)?-v:v); corr=-corr; }
  }
  return { P, corr, flipped };
}

function renderEnergy(trial){
  var fast=_fastTrial()||trial, slow=_slowTrial();
  var S=fast.series||{}, ev=fast.events||{}, dt=fast.meta.dt;
  var kl=ev.i_kl_peak, fc=ev.i_fc, mer=ev.i_mer, br=ev.i_br;
  var mass=(fast.grf&&fast.grf.body_weight_N)?fast.grf.body_weight_N/9.80665:(fast.meta.weight_kg||80);
  var WEARLY={startEv:'i_fc',startOff:-1.2,endEv:'i_fc',endOff:0};
  var WLATE={startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.2};
  var WME9={startEv:'i_fc',startOff:-0.2,endEv:'i_br',endOff:0.2};
  var keFn=function(t){ var bm=(t.grf&&t.grf.body_weight_N)?t.grf.body_weight_N/9.80665:(t.meta.weight_kg||80); return (t.series.COM_Velocity_Y||[]).map(function(v){return isFinite(v)?0.5*bm*v*v:NaN;}); };
  var dme=function(t,key){ var a=t.series[key]; if(!a)return null; var td=t.meta.dt, w=new Array(a.length).fill(NaN); for(var i=1;i<a.length-1;i++) if(isFinite(a[i+1])&&isFinite(a[i-1])) w[i]=(a[i+1]-a[i-1])/(2*td); return w; };
  var trunkFlexWork=function(t){ var ang=t.series.Trunk_Angle_X, lhm=t.series.L_Hip_Moment_X, rhm=t.series.R_Hip_Moment_X, td=t.meta.dt; if(!ang) return null; var w=_dvel(ang,td,1); var cum=new Array(ang.length).fill(NaN), acc=0; for(var i=0;i<ang.length;i++){ var wr=isFinite(w[i])?w[i]*Math.PI/180:0; var M=((lhm&&isFinite(lhm[i]))?lhm[i]:0)+((rhm&&isFinite(rhm[i]))?rhm[i]:0); acc+=M*wr*td; cum[i]=acc; } return cum; };
  // ① 뒷고관절 파워 (FC-1.2~FC)
  plotWin('ch-e1',Object.assign({fast:fast,slow:slow,left:{label:'관절 파워 (W)',lines:[{compute:function(t){return t.series.Back_Hip_Power_X;},color:'#86a8d0',label:'뒷고관절 파워',width:2.6}]}},WEARLY));
  // ② 앞무릎 파워 (FC~BR+0.2)
  plotWin('ch-e2',Object.assign({fast:fast,slow:slow,left:{label:'관절 파워 (W)',lines:[{compute:function(t){return t.series.Lead_Knee_Power_X;},color:'#5bd3ff',label:'앞무릎 파워',width:2.6}]}},WLATE));
  // ③ 앞고관절·어깨·팔꿈치 파워 (FC-1.2~FC)
  plotWin('ch-e3',Object.assign({fast:fast,slow:slow,left:{label:'관절 파워 (W)',lines:[
    {compute:function(t){return t.series.Lead_Hip_Power_X;},color:'#3ecf8e',label:'앞고관절',width:2.2},
    {compute:function(t){return t.series.Pitching_Shoulder_Power_X;},color:'#c084fc',label:'어깨',width:2.2},
    {compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#86a8d0',label:'팔꿈치',width:2.2}]}},WEARLY));
  // ④ 전신 전진 운동에너지 ½mv² (KL-0.1~BR+0.2)
  plotWin('ch-e4',{fast:fast,slow:slow,startEv:'i_kl_peak',startOff:-0.1,endEv:'i_br',endOff:0.2,left:{label:'전진 KE (J)',lines:[{compute:keFn,color:'#5bd3ff',label:'전신 전진 KE',width:2.6}]}});
  // ⑤ 골반·몸통·팔 회전에너지 = 분절 ME (FC~BR+0.2)
  plotWin('ch-e5',Object.assign({fast:fast,slow:slow,left:{label:'분절 역학에너지 (J)',lines:[
    {compute:function(t){return t.series.Pelvis_ME_X;},color:'#3ecf8e',label:'골반',width:2.2},
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#86a8d0',label:'몸통',width:2.2},
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#c084fc',label:'상완',width:2.2}]}},WLATE));
  // ⑥ 몸통 굴곡 일(누적,근사) + 몸통 전체 역학에너지 (FC~BR+0.2)
  plotWin('ch-e6',Object.assign({fast:fast,slow:slow,left:{label:'에너지 (J)',lines:[
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#86a8d0',label:'몸통 전체 역학에너지',width:2.4},
    {compute:trunkFlexWork,color:'#5bd3ff',label:'몸통 굴곡 일(누적,근사)',width:2.0}]}},WLATE));
  // ⑦ 분절 역학에너지 J (FC~BR+0.2)
  plotWin('ch-e7',Object.assign({fast:fast,slow:slow,left:{label:'분절 역학에너지 (J)',lines:[
    {compute:function(t){return t.series.Pelvis_ME_X;},color:'#3ecf8e',label:'골반',width:2.2},
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#86a8d0',label:'몸통',width:2.2},
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#c084fc',label:'상완',width:2.2}]}},WLATE));
  // ⑧ 분절 파워 dE/dt (FC~BR+0.2)
  plotWin('ch-e8',Object.assign({fast:fast,slow:slow,left:{label:'분절 파워 dE/dt (W)',lines:[
    {compute:function(t){return dme(t,'Pelvis_ME_X');},color:'#3ecf8e',label:'골반',width:2.2},
    {compute:function(t){return dme(t,'Trunk_ME_X');},color:'#86a8d0',label:'몸통',width:2.2},
    {compute:function(t){return dme(t,'Pitching_Humerus_ME_X');},color:'#c084fc',label:'상완',width:2.2}]}},WLATE));
  // ⑨ MECHANICAL ENERGY (FC-0.2~BR+0.2)
  plotWin('ch-e9',Object.assign({fast:fast,slow:slow,left:{label:'역학적 에너지 (J)',lines:[
    {compute:function(t){return t.series.Pelvis_ME_X;},color:'#3ecf8e',label:'골반',width:2.2},
    {compute:function(t){return t.series.Trunk_ME_X;},color:'#86a8d0',label:'몸통',width:2.2},
    {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#c084fc',label:'위팔',width:2.2}]}},WME9));

  // ⑩ 앞다리 무릎 4변인 (각도·각속도·토크·파워) FC~BR+0.2 + ⑪ work loop
  var RHPe=((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L';
  var kneeMom=function(t){ return RHPe?t.series.L_Knee_Moment_X:t.series.R_Knee_Moment_X; };
  var kneeVel=function(t){ return _dvel(t.series.Lead_Knee_Angle_X, t.meta.dt, 1); };
  var kneePw =function(t){ return t.series.Lead_Knee_Power_X; };
  // [2026-05-26] 앞무릎 각도 + 각속도 한 그래프(좌=각도·우=각속도). ⑩-b 별도 차트는 통합 제거.
  plotWin('ch-knee-ang',Object.assign({fast:fast,slow:slow,
    left:{label:'무릎 각도 (°)',lines:[{compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#5bd3ff',label:'앞무릎 각도',width:2.6}]},
    right:{label:'각속도 (°/s)',lines:[{compute:kneeVel,color:'#3ecf8e',label:'앞무릎 각속도',width:2.4}]}},WLATE));
  plotWin('ch-knee-tq',Object.assign({fast:fast,slow:slow,left:{label:'토크 (N·m)',lines:[{compute:kneeMom,color:'#86a8d0',label:'앞무릎 토크',width:2.4}]}},WLATE));
  plotWin('ch-knee-pw',Object.assign({fast:fast,slow:slow,left:{label:'파워 (W)',lines:[{compute:kneePw,color:'#c084fc',label:'앞무릎 파워',width:2.4}]}},WLATE));
  plotLoop('ch-knee-loop',{fast:fast,slow:slow,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0,
    xCompute:kneeVel, yCompute:kneeMom, powCompute:kneePw,
    xLabel:'각속도 (°/s) · +굴곡 / −신전', yLabel:'토크 (N·m)'});

  // ── 표(빠른 공 기준) — 그래프와 매칭 배치 ──
  var f1=function(x,u){return (x==null||!isFinite(x))?'—':x.toFixed(1)+(u||'');};
  var ke=keFn(fast); var keAt=function(i){return (i!=null&&i<ke.length&&isFinite(ke[i]))?ke[i]:null;};
  var kePeak=null; for(var i=0;i<ke.length;i++) if(isFinite(ke[i])&&(kePeak==null||ke[i]>kePeak))kePeak=ke[i];
  var dKE=(keAt(kl)!=null&&keAt(fc)!=null)?(keAt(fc)-keAt(kl)):null;
  var kc=document.getElementById('en-ke-cards');
  if(kc) kc.innerHTML='<div class="stat-card"><div class="lbl">전신 전진 KE peak</div><div class="v">'+f1(kePeak)+' J</div><div class="sub">½·m·v² · m='+f1(mass)+' kg</div></div>'+
    '<div class="stat-card"><div class="lbl">Drive 생성 ΔKE (KL→FC)</div><div class="v">'+f1(dKE)+' J</div><div class="sub">스트라이드 전진 에너지</div></div>'+
    '<div class="stat-card"><div class="lbl">KE @ FC</div><div class="v">'+f1(keAt(fc))+' J</div><div class="sub">앞발 착지 시점</div></div>';
  var joints=[['뒷고관절','Back_Hip_Power_X'],['뒷무릎','Back_Knee_Power_X'],['앞고관절','Lead_Hip_Power_X'],['앞무릎','Lead_Knee_Power_X'],['어깨(투구)','Pitching_Shoulder_Power_X'],['팔꿈치(투구)','Pitching_Elbow_Power_X']];
  var phs=[['Drive (KL→FC)',kl,fc],['Cocking (FC→MER)',fc,mer],['Accel (MER→BR)',mer,br]];
  var wcell=function(w){ if(w==null||!isFinite(w))return '<td style="text-align:right;color:var(--fg2)">—</td>'; var c=w>=0?'var(--green)':'var(--red)'; return '<td style="text-align:right;color:'+c+';font-weight:600">'+(w>=0?'+':'')+w.toFixed(1)+'</td>'; };
  var wt='<table class="ev-table"><thead><tr><th class="evl">관절 · 순(純)일 (J)</th>'+phs.map(function(p){return '<th>'+p[0]+'</th>';}).join('')+'<th>합</th></tr></thead><tbody>';
  joints.forEach(function(j){ var arr=S[j[1]], tot=0, any=false, cells=''; phs.forEach(function(p){ if(arr&&p[1]!=null&&p[2]!=null&&p[2]>p[1]){ var w=_enWork(arr,dt,p[1],p[2]).net; cells+=wcell(w); if(w!=null&&isFinite(w)){tot+=w;any=true;} } else cells+=wcell(null); }); wt+='<tr><td class="evl">'+j[0]+'</td>'+cells+wcell(any?tot:null)+'</tr>'; });
  wt+='</tbody></table><div class="note">순(純)일 = ∫파워 dt (양수=생성/concentric, 음수=흡수/eccentric). 하지는 Drive~Cocking 생성, 상지는 Accel 흡수가 정상.</div>';
  var we=document.getElementById('en-work-table'); if(we) we.innerHTML=wt;
  var seq=joints.map(function(j){ var info=_enPeak(S[j[1]],dt,fc,(kl!=null?kl:0),(br!=null?br:(S[j[1]]?S[j[1]].length-1:0))); return {lbl:j[0],peak:info.peak,t_ms:info.t_ms}; }).filter(function(x){return x.peak!=null;}).sort(function(a,b){return (a.t_ms==null?1e9:a.t_ms)-(b.t_ms==null?1e9:b.t_ms);});
  var stt='<table class="ev-table"><thead><tr><th class="evl">peak power 순서</th><th>peak (W)</th><th>시점 (FC 기준 ms)</th></tr></thead><tbody>';
  seq.forEach(function(x,i){ stt+='<tr><td class="evl">'+(i+1)+'. '+x.lbl+'</td><td style="text-align:right;font-weight:600">'+x.peak.toFixed(0)+'</td><td style="text-align:right;color:var(--fg1)">'+(x.t_ms==null?'—':(x.t_ms>=0?'+':'')+x.t_ms.toFixed(0))+'</td></tr>'; });
  stt+='</tbody></table><div class="note">peak 양(+)파워 발생 순서 = 운동사슬 전달 타이밍. 근위(고관절·무릎)→원위(어깨·팔꿈치) 순서가 이상적.</div>';
  var se=document.getElementById('en-timing-table'); if(se) se.innerHTML=stt;
  // 에너지 흐름 정량(분절 ME peak·타이밍·몸통→팔 전달)
  var ESEG=[['골반','Pelvis_ME_X'],['몸통','Trunk_ME_X'],['상완(투구)','Pitching_Humerus_ME_X']];
  var loi=(kl!=null?kl:0), hii=(br!=null?br:0);
  var pkMax=function(a){ if(!a)return {v:null,i:-1}; var v=-Infinity,bi=-1; for(var i=loi;i<=hii&&i<a.length;i++){var x=a[i]; if(isFinite(x)&&x>v){v=x;bi=i;}} return {v:bi>=0?v:null,i:bi}; };
  var pkSig=function(a){ if(!a)return {v:null,i:-1}; var v=-Infinity,bi=-1; for(var i=loi;i<=hii&&i<a.length;i++){var x=a[i]; if(isFinite(x)&&Math.abs(x)>Math.abs(v)){v=x;bi=i;}} return {v:bi>=0?v:null,i:bi}; };
  var tms=function(i){return (i==null||i<0)?'—':(((i-(fc!=null?fc:0))*dt*1000>=0?'+':'')+((i-(fc!=null?fc:0))*dt*1000).toFixed(0));};
  var rows='', epeak={};
  ESEG.forEach(function(e){ var pe=pkMax(S[e[1]]); epeak[e[1]]=pe; var pp=pkSig(dme(fast,e[1])); rows+='<tr><td class="evl">'+e[0]+'</td><td style="text-align:right">'+(pe.v==null?'—':pe.v.toFixed(0))+' J</td><td style="text-align:right;color:var(--fg1)">'+tms(pe.i)+' ms</td><td style="text-align:right;color:'+(pp.v>=0?'var(--green)':'var(--red)')+'">'+(pp.v==null?'—':(pp.v>=0?'+':'')+pp.v.toFixed(0))+' W</td><td style="text-align:right;color:var(--fg1)">'+tms(pp.i)+' ms</td></tr>'; });
  var Et=S.Trunk_ME_X, Eh=S.Pitching_Humerus_ME_X, tp=epeak.Trunk_ME_X?epeak.Trunk_ME_X.i:-1, hp=epeak.Pitching_Humerus_ME_X?epeak.Pitching_Humerus_ME_X.i:-1, th='';
  if(Et&&Eh&&tp>=0&&hp>tp&&isFinite(Et[tp])&&isFinite(Et[hp])&&isFinite(Eh[tp])&&isFinite(Eh[hp])){ var tl=Et[tp]-Et[hp], ag=Eh[hp]-Eh[tp], r=tl>0?ag/tl*100:null; th='<div class="note"><b>몸통→팔 에너지 핸드오프</b> (몸통 peak '+tms(tp)+'ms → 상완 peak '+tms(hp)+'ms): 몸통 방출 <b>'+tl.toFixed(0)+' J</b> · 상완 획득 <b>'+ag.toFixed(0)+' J</b>'+(r!=null?' · 전달비율 ≈ <b>'+r.toFixed(0)+'%</b>':'')+'.</div>'; }
  var ef=document.getElementById('en-eflow-table');
  if(ef) ef.innerHTML='<table class="ev-table"><thead><tr><th class="evl">분절</th><th>에너지 peak</th><th>시점(FC)</th><th>분절파워 peak</th><th>시점(FC)</th></tr></thead><tbody>'+rows+'</tbody></table>'+th+'<div class="note">dE/dt=분절 파워(양수=유입, 음수=유출/전달). 근위(몸통) 방출 시 원위(상완) 흡수 = 전달(Aguinaldo & Escamilla 2019).</div>';
}
if (typeof window !== 'undefined') window.renderEnergy = renderEnergy;

// 선수용 리포트(buildPlayerHTML)는 modules/player_report.js 단일 출처. 분석 리포트엔 player_report 스크립트가 별도 주입됨(빌더 repl).

/* ── 선수용 PDF 리포트 (리포트 출력 버튼) ── */
function _openPlayerPDF(){
  try{
    var _nm=(DATA.player&&DATA.player.name)||'\uc120\uc218';
    var _SAVE=_EFPAL; var _ex, _bm;
    try{ _EFPAL=_EF_LIGHT; _bm=(typeof _bodyMapHTML==='function')?_bodyMapHTML():''; _ex=(typeof _bmPlayerExtras==='function')?_bmPlayerExtras():{top:'',bottom:''}; }
    finally{ _EFPAL=_SAVE; }
    if(!_bm){ alert('\uc2e0\uccb4 \uc0ac\uc2ac \ub370\uc774\ud130 \uc5c6\uc74c \u2014 \uc9c0\uba74\ubc18\ub825 \uc788\ub294 Theia \ubd84\uc11d \ud544\uc694'); return; }
    var head='<div style="display:flex;align-items:baseline;gap:10px;border-bottom:2px solid #d3dce6;padding-bottom:10px;margin-bottom:16px"><div style="font-size:21px;font-weight:800;color:#16202e">'+_nm+' \uc120\uc218 \ud22c\uad6c \ub9ac\ud3ec\ud2b8</div><div style="font-size:13px;color:#6b7a8c">\uc2e0\uccb4 \uc5d0\ub108\uc9c0 \uc0ac\uc2ac \u00b7 \ub0b4 \ub3d9\uc791 \ud55c\ub208\uc5d0 \ubcf4\uae30</div></div>';
    var html='<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>'+_nm+' \u2014 \uc120\uc218 \ub9ac\ud3ec\ud2b8</title><style>*{box-sizing:border-box}body{margin:0;background:#ffffff;color:#16202e;padding:24px;font-family:-apple-system,\'Malgun Gothic\',sans-serif}@media print{@page{margin:10mm}body{padding:0}.card{break-inside:avoid}}</style></head><body><div style="max-width:920px;margin:0 auto">'+head+_ex.top+_bm+_ex.bottom+'</div></body></html>';
    var w=window.open('','_blank');
    if(!w){ alert('\ud31d\uc5c5 \ucc28\ub2e8\ub428 \u2014 \ud5c8\uc6a9 \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4'); return; }
    w.document.open(); w.document.write(html); w.document.close();
    setTimeout(function(){ try{ w.focus(); w.print(); }catch(e){} }, 500);
  }catch(e){ alert('\uc120\uc218 \ub9ac\ud3ec\ud2b8 \uc0dd\uc131 \uc624\ub958: '+e.message); }
}
if(typeof window!=='undefined') window._openPlayerPDF=_openPlayerPDF;
