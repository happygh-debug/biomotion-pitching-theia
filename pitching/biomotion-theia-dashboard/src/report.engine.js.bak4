  try{ if(document.getElementById('rgcv-trunkflex-ts'))_DG.drawSide({key:'trunkFlexV',color:'#46c98c',emph:'trunk',lead:true},'rgcv-trunkflex-ts',_RG.idx); }catch(e){}
