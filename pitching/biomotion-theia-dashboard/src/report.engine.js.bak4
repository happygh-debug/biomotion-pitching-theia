  try{ if(ft){ var _tfv=(_FC_SER['trunkFlexV']&&_FC_SER['trunkFlexV'].fn)?_FC_SER['trunkFlexV'].fn(ft):null; var tv=_RG.sval(_tfv,_RG.idx); var el2=document.getElementById('rg-now-trunkflex'); if(el2)el2.textContent=(tv==null?'–':Math.round(tv)); } }catch(e){} };
_RG.syncFrame=function(){ if(!_WG.data)return; var w=_RG.win(); _RG.i0=w[0];_RG.i1=w[1]; var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):_RG.i1; _RG.idx=Math.max(_RG.i0,Math.min(_RG.i1,cf)); _RG.frame(); };
_RG.start=function(){ if(!_WG.data)return; var w=_RG.win(); _RG.i0=w[0];_RG.i1=w[1]; _RG.syncFrame(); };
// ══ 에너지 전달(transfer) — 시퀀스 스코어카드 + 앞무릎 유형 + 어깨/팔꿈치 에너지 스틱 ══
var _TG={ idx:0,i0:0,i1:0, contribPct:null, typeStr:'' };
_TG.win=function(){ var T=_WG.data.fast.series.time, ev=_WG.data.fast.series.ev, fc=ev.fc, br=ev.br; var lo=(fc!=null?fc:0)-100, hi=(br!=null?br:T[T.length-1])+60; var i0=0,i1=T.length-1; for(var i=0;i<T.length;i++){if(T[i]>=lo){i0=i;break;}} for(var j=T.length-1;j>=0;j--){if(T[j]<=hi){i1=j;break;}} if(i1<=i0)i1=T.length-1; return [i0,i1]; };
_TG.drawType=function(){ var cv=document.getElementById('tgcv-knetype'); if(!cv)return; var dpr=window.devicePixelRatio||1,W=cv.clientWidth||320,H=200; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var pc=_TG.contribPct, x0=24,x1=W-24,y=H*0.52,span=x1-x0; function X(p){return x0+Math.max(0,Math.min(100,p))/100*span;}
  c.fillStyle='#e8ecf2';c.font='12px system-ui';c.textAlign='center';c.textBaseline='top';c.fillText('무릎 신전 기여 비율(%) — 위치로 유형 판단',W/2,6);
  c.fillStyle='rgba(70,201,140,0.18)';c.fillRect(X(20.6),y-14,X(38.7)-X(20.6),28);
  c.strokeStyle='#3a4452';c.lineWidth=2;c.beginPath();c.moveTo(x0,y);c.lineTo(x1,y);c.stroke();
  c.strokeStyle='rgba(70,201,140,0.85)';c.lineWidth=2;c.beginPath();c.moveTo(X(26.5),y-16);c.lineTo(X(26.5),y+16);c.stroke();
  c.fillStyle='#7d8898';c.font='10px system-ui';c.textAlign='center';c.textBaseline='bottom';c.fillText('코호트 중앙 26.5%',X(26.5),y-20);
  c.fillStyle='#a9b4c2';c.font='11px system-ui';c.textBaseline='top';c.textAlign='left';c.fillText('← 버팀-흡수형',x0,y+22);c.textAlign='right';c.fillText('신전형(밀어올리기) →',x1,y+22);
  if(pc!=null&&isFinite(pc)){ var px=X(pc); c.strokeStyle='#e8954e';c.lineWidth=2;c.beginPath();c.moveTo(px,y-22);c.lineTo(px,y+18);c.stroke(); c.fillStyle='#e8954e';c.beginPath();c.arc(px,y,7,0,7);c.fill(); c.fillStyle='#fff';c.font='bold 12px system-ui';c.textAlign='center';c.textBaseline='bottom';c.fillText(pc+'%',px,y-24); }
  // 선수 비교: 상대 선수 마커(보라) 추가 — 이영하-문서준식 비교
  var cpc=(typeof _cmpOn!=='undefined'&&_cmpOn)?_TG.cmpContribPct:null;
  if(cpc!=null&&isFinite(cpc)){ var qx=X(cpc); c.strokeStyle='#c084fc';c.lineWidth=2;c.beginPath();c.moveTo(qx,y-18);c.lineTo(qx,y+22);c.stroke(); c.fillStyle='#c084fc';c.beginPath();c.arc(qx,y,7,0,7);c.fill(); c.fillStyle='#fff';c.font='bold 11px system-ui';c.textAlign='center';c.textBaseline='top';c.fillText(cpc+'%',qx,y+10);
    c.fillStyle='#c084fc';c.font='10px system-ui';c.textAlign='right';c.textBaseline='top';c.fillText('보라='+(typeof _cmpLabel==='function'?_cmpLabel():'상대'),x1,6); }
  c.fillStyle='#c084fc';c.font='bold 13px system-ui';c.textAlign='center';c.textBaseline='top';c.fillText('판정: '+(_TG.typeStr||'–'),W/2,H-22);
};
_TG.frame=function(){ if(!_WG.data)return;
  try{ if(document.getElementById('tgcv-knetype'))_TG.drawType(); }catch(e){}
  try{ if(document.getElementById('tgcv-knee-ts'))_DG.drawSide({key:'kneeExtROM',color:'#5bb6e6',emph:'leadleg',lead:true},'tgcv-knee-ts',_TG.idx); }catch(e){}
  try{ if(document.getElementById('tgcv-arm-ts'))_DG.drawSide({key:'shGen',color:'#46c98c',emph:'arm',lead:true},'tgcv-arm-ts',_TG.idx); }catch(e){} };
_TG.syncFrame=function(){ if(!_WG.data)return; var w=_TG.win(); _TG.i0=w[0];_TG.i1=w[1]; var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):_TG.i1; _TG.idx=Math.max(_TG.i0,Math.min(_TG.i1,cf)); _TG.frame(); };
_TG.start=function(){ if(!_WG.data)return; var w=_TG.win(); _TG.i0=w[0];_TG.i1=w[1]; _TG.syncFrame(); };
function _seqScorecardHTML(){
  var trials=(typeof DATA!=='undefined'&&DATA.trials)?DATA.trials:[]; if(!trials.length) return '';
  function meFlow(t){ var S=t.series||{},e=t.events||{}; if(e.i_fc==null||e.i_br==null)return null; function pf(a){if(!a)return null;var bi=null,bv=-Infinity;for(var i=e.i_fc;i<=e.i_br&&i<a.length;i++){var v=Math.abs(a[i]);if(isFinite(v)&&v>bv){bv=v;bi=i;}}return bi;} var tp=pf(S.Trunk_ME_X),hp=pf(S.Pitching_Humerus_ME_X); if(tp==null||hp==null)return null; return tp<=hp; }
  var rows='', nSeq=0,nTim=0,nFlow=0,nW=0,sumW=0,nTot=0;
  trials.forEach(function(t,i){ var k=t.kseq||{}; if(!k.deltas)return; nTot++;
    var sok=!!k.sequence_ok, d1=k.deltas.pelvis_to_trunk_ms, d2=k.deltas.trunk_to_arm_ms;
    var tok=(d1!=null&&d2!=null&&d1>0&&d2>0&&d1<=120&&d2<=120);
    var whip=(k.gains&&k.gains.arm_over_trunk!=null)?k.gains.arm_over_trunk:null, fok=meFlow(t);
    if(sok)nSeq++; if(tok)nTim++; if(fok)nFlow++; if(whip!=null){sumW+=whip;nW++;}
    function chip(b){return b==null?'<span style="color:#7d8898">–</span>':(b?'<span style="color:#46c98c;font-weight:700">적합</span>':'<span style="color:#e07a78;font-weight:700">미흡</span>');}
    rows+='<tr><td>'+(i+1)+'</td><td>'+chip(sok)+'</td><td>'+(d1!=null?d1:'–')+' / '+(d2!=null?d2:'–')+'</td><td>'+chip(tok)+'</td><td>'+(whip!=null?whip:'–')+'</td><td>'+chip(fok)+'</td></tr>'; });
  // 선수 비교: 상대 선수 시퀀스 요약 비교 행(평균)
  if(typeof _cmpOn!=='undefined'&&_cmpOn){ var _cp=(typeof _cmpPlayer==='function')?_cmpPlayer():null; var ss=_cp&&_cp.seq_summary; if(ss&&ss.n){ rows+='<tr style="border-top:2px solid var(--line);background:rgba(192,132,252,0.10)"><td style="color:#c084fc;font-weight:700">'+((_cp.name||'상대'))+' 평균('+ss.n+'구)</td><td style="color:#c084fc;font-weight:700">'+ss.seqOk+'/'+ss.n+'</td><td>'+(ss.d1!=null?ss.d1:'–')+' / '+(ss.d2!=null?ss.d2:'–')+'</td><td>—</td><td>'+(ss.whip!=null?ss.whip:'–')+'</td><td style="color:#c084fc;font-weight:700">'+ss.flowOk+'/'+ss.n+'</td></tr>'; } }
  if(!nTot) return '';
  return '<div class="card" style="grid-column:1 / -1"><h3>키네마틱 시퀀스 정확도 — 전 트라이얼('+nTot+'구) <span class="sub2">업리프트식 한눈 요약 · 근위→원위 순서·타이밍·채찍·에너지 흐름</span></h3>'
    +'<div style="display:flex;gap:16px;flex-wrap:wrap;margin:6px 0 10px">'
    +'<div class="sub2">시퀀스 정확 <b style="color:#46c98c">'+nSeq+'/'+nTot+'</b></div><div class="sub2">타이밍 적합 <b style="color:#46c98c">'+nTim+'/'+nTot+'</b></div><div class="sub2">에너지 흐름 적합 <b style="color:#46c98c">'+nFlow+'/'+nTot+'</b></div><div class="sub2">평균 채찍비(팔/몸통) <b style="color:#5bb6e6">'+(nW?(Math.round(sumW/nW*100)/100):'–')+'</b></div></div>'
    +'<table class="bm-mtable" style="width:100%;font-size:12px"><thead><tr><th>구</th><th>시퀀스</th><th>골반→몸통 / 몸통→팔(ms)</th><th>타이밍</th><th>채찍비</th><th>에너지흐름</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}
// ══ 동작 일관성 히트맵 (트라이얼×변인, 셀=평균대비 편차 z) ══
function _consHeatmapHTML(){
  var trials=(typeof DATA!=='undefined'&&DATA.trials)?DATA.trials:[]; if(trials.length<2) return '';
  var CV=[{l:'골반회전',k:'Pelvis_Ang_Vel_Z'},{l:'몸통회전',k:'Thorax_Ang_Vel_Z'},{l:'팔회전',k:'Pitching_Shoulder_Ang_Vel_Z'},{l:'팔꿈치신전',k:'Pitching_Elbow_Ang_Vel_X'},{l:'어깨MER',k:'Pitching_Shoulder_Angle_Z'},{l:'앞발GRF',k:'FP2_Z'},{l:'COM속도',k:'COM_Velocity_Y'},{l:'X-Factor',xf:true},{l:'체중이동(ms)',wtt:true}];
  function pk(t,c){ var e=t.events||{}; if(e.i_fc==null)return null;
    if(c.wtt){ var dt=(t.meta&&t.meta.dt)||((t.setup&&t.setup.dt))||0.00333; var s1=(t.series||{}).FP1_Z, s2=(t.series||{}).FP2_Z; if(!s1||!s2)return null; function pf(a){var bi=null,bv=-Infinity,lo2=Math.max(0,(e.i_kl_peak||0)),hi2=(e.i_br!=null?e.i_br:a.length-1);for(var i=lo2;i<=hi2&&i<a.length;i++){var v=a[i];if(isFinite(v)&&v>bv){bv=v;bi=i;}}return bi;} var f1=pf(s1),f2=pf(s2); return (f1!=null&&f2!=null)?Math.round((f2-f1)*dt*1000):null; }
    var lo=Math.max(0,e.i_fc-90), hi=(e.i_br!=null?e.i_br:lo+200); var a=c.xf?t.x_factor:((t.series||{})[c.k]); if(!a)return null; var m=-Infinity; for(var i=lo;i<=hi&&i<a.length;i++){var v=Math.abs(a[i]); if(isFinite(v)&&v>m)m=v;} return m===-Infinity?null:m; }
  var M=trials.map(function(t){return CV.map(function(c){return pk(t,c);});});
  var stats=CV.map(function(c,ci){ var vals=M.map(function(r){return r[ci];}).filter(function(v){return v!=null&&isFinite(v);}); if(vals.length<2)return {m:null,s:null,cv:null}; var mm=vals.reduce(function(a,b){return a+b;},0)/vals.length; var sd=Math.sqrt(vals.reduce(function(a,b){return a+(b-mm)*(b-mm);},0)/vals.length); return {m:mm,s:sd,cv:mm?Math.round(sd/Math.abs(mm)*1000)/10:null}; });
  function zcol(z){ var az=Math.abs(z); if(az<0.5)return 'rgba(70,201,140,0.30)'; if(az<1)return 'rgba(70,201,140,0.15)'; if(az<1.5)return 'rgba(232,149,78,0.30)'; return 'rgba(224,122,120,0.36)'; }
  var head='<tr><th>구</th>'+CV.map(function(c,ci){var cvp=stats[ci].cv; return '<th>'+c.l+(cvp!=null?('<br><span style="font-weight:400;color:#8b97a8">CV '+cvp+'%</span>'):'')+'</th>';}).join('')+'</tr>';
  var rows=M.map(function(r,ti){ return '<tr><td>'+(ti+1)+'</td>'+r.map(function(v,ci){ var st=stats[ci]; var z=(v!=null&&st.s)?(v-st.m)/st.s:0; var bg=(v!=null&&st.s)?zcol(z):'transparent'; return '<td style="background:'+bg+';text-align:center">'+(v!=null?Math.round(v):'–')+'</td>'; }).join('')+'</tr>'; }).join('');
  return '<div class="card" style="grid-column:1 / -1"><h3>동작 일관성 히트맵 — 전 트라이얼 × 주요 변인 <span class="sub2">셀 색=평균 대비 편차(초록=일관·주황/빨강=벗어남) · 숫자=피크값 · 헤더=CV%</span></h3>'
    +'<div style="overflow-x:auto"><table class="bm-mtable" style="width:100%;font-size:11.5px"><thead>'+head+'</thead><tbody>'+rows+'</tbody></table></div>'
    +'<div class="note" style="margin-top:6px">CV(변동계수)가 낮을수록, 셀이 초록에 가까울수록 투구 간 반복성이 높습니다. 빨강 셀은 그 구·그 변인이 평균에서 크게 벗어난 구간.</div></div>';
}
// ══ 부상 위험 — 부위별 스틱 risk map (어깨·팔꿈치 관절 색=위험도) ══
var _IG={};
_IG.gcol=function(g){return g==='danger'?'#e07a78':(g==='caution'?'#e8954e':(g==='normal'?'#46c98c':'#7d8898'));};
_IG.gradeOf=function(focus){ var ir=(typeof DATA!=='undefined'&&DATA.injury_risk)?DATA.injury_risk:null, byK={}; if(ir&&ir.metrics)ir.metrics.forEach(function(m){byK[m.key]=m;});
  function worse(a,b){var o={normal:1,caution:2,danger:3,unavailable:0}; return (o[a]||0)>=(o[b]||0)?a:b;}
  if(focus==='shoulder'){ var sg=worse(byK.shoulder_ir?byK.shoulder_ir.grade:'unavailable', byK.shoulder_distraction?byK.shoulder_distraction.grade:'unavailable'); return {grade:sg, ms:[byK.shoulder_ir,byK.shoulder_distraction]}; }
  return {grade:(byK.elbow_valgus?byK.elbow_valgus.grade:'unavailable'), ms:[byK.elbow_valgus]}; };
// 어깨·팔꿈치를 따로 확대해 각각 병행 표시(릴리스 피크) — 한 그림에 두 디스크가 겹치던 문제 해결 (#7)
_IG.drawFig=function(cvId, focus){ var cv=document.getElementById(cvId); if(!cv)return;
  if(!_WG.data){try{_WG.data=_WG.build();}catch(e){}} if(!_WG.data)return;
  var dpr=window.devicePixelRatio||1,W=cv.clientWidth||300,H=300; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var D=_WG.data, RHP=_DG.RHP(), fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1, ser=D.fast.series, T=ser.time, ev=ser.ev;
  var brT=(ev.br!=null?ev.br:T[T.length-1]), bi=0,bd=Infinity; for(var i=0;i<T.length;i++){var dd=Math.abs(T[i]-brT); if(dd<bd){bd=dd;bi=i;}}
  var fr=ser.stick[Math.min(bi,ser.stick.length-1)]; if(!fr)return;
  var an=fr.pelvis_o||fr[RHP?'l_heel':'r_heel']; if(!an)return;
  var pitSh=RHP?'r_shoulder':'l_shoulder', pitEl=RHP?'r_elbow':'l_elbow', pitWr=RHP?'r_wrist':'l_wrist';
  // 자동 맞춤: 관절 bbox 를 캔버스에 채움(릴리스 자세가 잘리거나 뭉개지지 않게) — 측면뷰
  var xmn=Infinity,xmx=-Infinity,ymn=Infinity,ymx=-Infinity;
  _WG.BONES.forEach(function(b){ [b[0],b[1]].forEach(function(j){ var p=fr[j]; if(p&&isFinite(p[0])&&isFinite(p[1])){ var x=(p[0]-an[0])*fSign, y=(p[1]-an[1]); if(x<xmn)xmn=x;if(x>xmx)xmx=x;if(y<ymn)ymn=y;if(y>ymx)ymx=y; } }); });
  if(!isFinite(xmn))return;
  var pad=32, S=Math.max(0.02,Math.min((W-2*pad)/((xmx-xmn)||1),(H-2*pad)/((ymx-ymn)||1))), cxF=(xmn+xmx)/2, cyF=(ymn+ymx)/2;
  function P(j){var p=fr[j]; return p?[W/2+((p[0]-an[0])*fSign-cxF)*S, H/2-((p[1]-an[1])-cyF)*S]:null;}
  var gy=H/2-(ymn-cyF)*S; c.strokeStyle='#2a3340';c.lineWidth=1;c.beginPath();c.moveTo(8,gy);c.lineTo(W-8,gy);c.stroke();
  var armPairs=[[pitSh,pitEl],[pitEl,pitWr]];
  c.lineCap='round'; _WG.BONES.forEach(function(b){var a=P(b[0]),d=P(b[1]); if(!a||!d)return; var isArm=armPairs.some(function(p){return (p[0]===b[0]&&p[1]===b[1])||(p[0]===b[1]&&p[1]===b[0]);}); c.strokeStyle=isArm?'#c8d0dc':'#3a4453'; c.lineWidth=isArm?5:2.2; c.beginPath();c.moveTo(a[0],a[1]);c.lineTo(d[0],d[1]);c.stroke();});
  var hd=P('head'); if(hd){c.fillStyle='#3a4453';c.beginPath();c.arc(hd[0],hd[1]-3,5,0,7);c.fill();}
  var gr=_IG.gradeOf(focus), col=_IG.gcol(gr.grade), pt=P(focus==='shoulder'?pitSh:pitEl), lbl=(focus==='shoulder'?'어깨':'팔꿈치');
  if(pt){ c.fillStyle=col;c.globalAlpha=0.9;c.beginPath();c.arc(pt[0],pt[1],18,0,7);c.fill();c.globalAlpha=1; c.strokeStyle='#0b0d12';c.lineWidth=2.5;c.beginPath();c.arc(pt[0],pt[1],18,0,7);c.stroke(); c.fillStyle='#fff';c.font='bold 12px system-ui';c.textAlign='center';c.textBaseline='middle';c.fillText(lbl,pt[0],pt[1]); }
};
_IG.draw=function(){
  if(!_WG.data){try{_WG.data=_WG.build();}catch(e){}} if(!_WG.data)return;
  _IG.drawFig('injrisk-stick-sh','shoulder'); _IG.drawFig('injrisk-stick-el','elbow');
  var gtxt={normal:'정상',caution:'주의',danger:'위험',unavailable:'–'};
  function _load(m){ return (m.value!=null&&m.danger)?(' · 부하 '+Math.round(m.value/m.danger*100)+'%'):''; }
  function capHTML(focus){ var gr=_IG.gradeOf(focus); return gr.ms.filter(Boolean).map(function(m){return m.label.split(' (')[0]+' <b style="color:'+_IG.gcol(m.grade)+'">'+(m.value!=null?m.value+(m.unit||''):'–')+' '+(gtxt[m.grade]||'')+'</b>'+_load(m);}).join('<br>')||'–'; }
  var cs=document.getElementById('injrisk-cap-sh'); if(cs)cs.innerHTML=capHTML('shoulder');
  var ce=document.getElementById('injrisk-cap-el'); if(ce)ce.innerHTML=capHTML('elbow');
  var ir=(typeof DATA!=='undefined'&&DATA.injury_risk)?DATA.injury_risk:null;
  var leg=document.getElementById('injrisk-leg'); if(leg&&ir&&ir.metrics){ leg.innerHTML=ir.metrics.map(function(m){return m.label.split(' (')[0]+' <b style="color:'+_IG.gcol(m.grade)+'">'+(m.value!=null?m.value+(m.unit||''):'–')+' '+(gtxt[m.grade]||'')+'</b>';}).join(' &nbsp;·&nbsp; '); }
};
_IG.inject=function(){ var body=document.getElementById('injury-body'); if(!body)return; if(document.getElementById('injrisk-stick-sh'))return;
  var card=document.createElement('div'); card.className='card'; card.style.marginBottom='12px';
  card.innerHTML='<h3>부상 위험 — 어깨·팔꿈치 분리 스틱 <span class="sub2">관절 색: 초록 정상·주황 주의·빨강 위험(릴리스 피크 기준) · 상세 수치는 아래 표</span></h3>'
    +'<div style="display:flex;gap:12px;flex-wrap:wrap">'
    +'<div style="flex:1 1 280px;min-width:240px"><div class="sub2" style="text-align:center;margin-bottom:2px">어깨 (Shoulder)</div><canvas id="injrisk-stick-sh" style="width:100%;height:300px;display:block"></canvas><div id="injrisk-cap-sh" class="sub2" style="text-align:center;margin-top:4px"></div></div>'
    +'<div style="flex:1 1 280px;min-width:240px"><div class="sub2" style="text-align:center;margin-bottom:2px">팔꿈치 (Elbow)</div><canvas id="injrisk-stick-el" style="width:100%;height:300px;display:block"></canvas><div id="injrisk-cap-el" class="sub2" style="text-align:center;margin-top:4px"></div></div>'
    +'</div><div id="injrisk-leg" class="sub2" style="margin-top:8px"></div>';
  body.insertBefore(card, body.firstChild);
  try{ _IG.draw(); }catch(e){}
};
// ══ 스트라이드 일관성 2D 산점도(길이×방향)+95% 타원 ══
function _strideScatterHTML(){ return ''; }  // [2026-05-26] 스트라이드·체중이동 일관성(발자국 탑뷰) 삭제(교수 지시)
// 발자국 탑뷰: 세로=스트라이드 길이(위=홈 방향), 가로=착지 방향 편차. 발 글리프 + 95% 타원. (#4)
function _drawStrideScatter(cvId){ var cv=document.getElementById(cvId); if(!cv)return; var dpr=window.devicePixelRatio||1,W=cv.clientWidth||320,H=320; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var trials=(typeof DATA!=='undefined'&&DATA.trials)?DATA.trials:[], ht=((DATA.player&&DATA.player.height_m)||1.8);
  var raw=[]; trials.forEach(function(t){ var g=t.grf_metrics||{}; var L=(g.stride_length_m!=null?g.stride_length_m:g.stride_cop_m), A=g.stride_angle_deg; if(L!=null&&isFinite(L)&&A!=null&&isFinite(A))raw.push([L/ht*100,A]); });
  if(raw.length<2){ c.fillStyle='#7d8898';c.textAlign='center';c.textBaseline='middle';c.fillText('스트라이드 데이터 부족',W/2,H/2); return; }
  function mean(a){return a.reduce(function(x,y){return x+y;},0)/a.length;} function sd(a){var m=mean(a);return Math.sqrt(a.reduce(function(s,x){return s+(x-m)*(x-m);},0)/a.length);}
  var Ls=raw.map(function(p){return p[0];}), As=raw.map(function(p){return p[1];}), mA=mean(As);
  // 발자국 평면 좌표: 세로(fwd)=길이, 가로(lat)=평균방향 대비 편차를 길이에 투영
  var pts=raw.map(function(p){ return [p[0]*Math.sin((p[1]-mA)*Math.PI/180), p[0]]; });
  var xs=pts.map(function(p){return p[0];}), ys=pts.map(function(p){return p[1];});
  var mx=mean(xs),my=mean(ys),sx=sd(xs)||0.5,sy=sd(ys)||0.5;
  var halfX=Math.max(sx*2.4, Math.max.apply(null,xs.map(function(v){return Math.abs(v);}))+3, 7);
  var yLo=Math.max(0,Math.min.apply(null,ys)-sy*1.8-4), yHi=Math.max.apply(null,ys)+sy*1.8+4; if(yHi<=yLo)yHi=yLo+1;
  var topPad=24, botPad=34, plotH=H-topPad-botPad, cX=W/2;
  function X(v){return cX + (v/halfX)*(W*0.42);} function Y(v){return (H-botPad)-(v-yLo)/((yHi-yLo)||1)*plotH;}
  // 중앙 기준선 + 홈 방향(↑)
  c.strokeStyle='#2a3340';c.setLineDash([3,4]);c.lineWidth=1;c.beginPath();c.moveTo(cX,topPad);c.lineTo(cX,H-botPad);c.stroke();c.setLineDash([]);
  c.fillStyle='#7d8898';c.font='10px system-ui';c.textAlign='center';c.textBaseline='top';c.fillText('▲ 홈(투구 방향)',cX,4);
  c.textBaseline='bottom';c.fillText('뒷발(셋업)',cX,H-2);
  // 95% 분산 타원
  c.strokeStyle='rgba(91,182,230,0.8)';c.fillStyle='rgba(91,182,230,0.12)';c.lineWidth=1.5;c.beginPath(); for(var a=0;a<=Math.PI*2+0.01;a+=Math.PI/24){var ex=X(mx+2*sx*Math.cos(a)),ey=Y(my+2*sy*Math.sin(a)); if(a===0)c.moveTo(ex,ey);else c.lineTo(ex,ey);} c.closePath();c.fill();c.stroke();
  // 발자국 글리프(앞발) — 세로 타원, 발끝이 홈(위)
  function foot(px,py,col,al){ c.save();c.globalAlpha=al;c.fillStyle=col;c.beginPath(); if(c.ellipse)c.ellipse(px,py,4.2,8,0,0,7); else c.arc(px,py,5,0,7); c.fill();c.restore(); }
  pts.forEach(function(p){ foot(X(p[0]),Y(p[1]),'#e8954e',0.9); });
  // 평균 십자
  var cxm=X(mx),cym=Y(my); c.strokeStyle='#fff';c.lineWidth=1.6;c.beginPath();c.moveTo(cxm-7,cym);c.lineTo(cxm+7,cym);c.moveTo(cxm,cym-7);c.lineTo(cxm,cym+7);c.stroke();
  // 수치
  c.fillStyle='#a9b4c2';c.font='11px system-ui';c.textAlign='left';c.textBaseline='top';
  c.fillText('길이 CV '+(mean(Ls)?Math.round(sd(Ls)/Math.abs(mean(Ls))*1000)/10:'–')+'% · 방향 SD '+(Math.round(sd(As)*10)/10)+'°',10,8);
  // 체중이동(드라이브 타이밍) 일관성 주석
  var gd=[]; trials.forEach(function(t){ var g=t.grf_metrics||{}; if(g.grf_delay_ms!=null&&isFinite(g.grf_delay_ms))gd.push(g.grf_delay_ms); });
  if(gd.length>=2){ c.fillStyle='#7d8898';c.textAlign='right';c.fillText('체중이동 시간 SD '+(Math.round(sd(gd)*10)/10)+' ms',W-10,8); } }
// ══ 랩소도 제구(로케이션 일관성) + 구질 안정성 카드 (있을 때만) ══
function _rapsodoConsHTML(){ var c=(typeof DATA!=='undefined')?DATA.command:null, vs=(typeof DATA!=='undefined')?DATA.velo_summary:null; var h='';
  // 구질 결과 값(구속·회전·구종) — 선수리포트 ③과 동일
  if(vs&&(vs.max_kmh!=null||vs.avg_kmh!=null||vs.avg_spin!=null||(vs.pitch_types&&Object.keys(vs.pitch_types).length))){
    function _qk(l,v,u){ return '<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">'+l+'</div><div style="font-size:22px;font-weight:800">'+(v==null||v===''?'—':v)+(u&&v!=null&&v!==''?'<span style="font-size:12px;font-weight:400;color:var(--fg2)"> '+u+'</span>':'')+'</div></div>'; }
    h+='<div class="card" style="grid-column:1 / -1"><h3>구질 결과 (랩소도 '+(vs.n||0)+'구) <span class="sub2">실측 구속·회전·구종</span></h3>'
      +'<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px">'
      +_qk('구속 최고',(vs.max_kmh!=null?vs.max_kmh:'—'),'km/h')+_qk('구속 평균',(vs.avg_kmh!=null?vs.avg_kmh:'—'),'km/h')
      +_qk('회전수',(vs.avg_spin!=null?vs.avg_spin:'—'),'rpm')+_qk('회전효율',(vs.avg_eff!=null?vs.avg_eff:'—'),'%')
      +_qk('회전축',(vs.spin_dir||'—'),'시계')+_qk('구종',(vs.pitch_types?Object.keys(vs.pitch_types).length:'—'),'종')
      +'</div>'
      +(vs.pitch_types?'<div class="note" style="margin-top:8px">측정 구종: '+Object.keys(vs.pitch_types).map(function(k){return k+' '+vs.pitch_types[k]+'구';}).join(', ')+'</div>':'')
      +'</div>'; }
  if(c){ h+='<div class="card" style="grid-column:1 / -1"><h3>랩소도 제구 — 로케이션 일관성 <span class="sub2">존 산포 기반 · '+(c.n||'')+'구 · 스트라이크 '+(c.strike_pct!=null?c.strike_pct+'%':'—')+' (불펜/존 의도 없으면 참고용)</span></h3>'
    +'<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">제구 종합</div><div style="font-size:22px;font-weight:800">'+(c.score!=null?c.score:'—')+'</div></div>'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">존 로케이션 일관성</div><div style="font-size:22px;font-weight:800">'+(c.location_score!=null?c.location_score:'—')+'</div><div class="sub2">좌우 SD '+(c.side_sd!=null?c.side_sd:'—')+' · 상하 '+(c.height_sd!=null?c.height_sd:'—')+'</div></div>'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">동작 일관성(제구)</div><div style="font-size:22px;font-weight:800">'+(c.mech_consistency!=null?c.mech_consistency:'—')+'</div></div>'
    +'</div></div>'; }
  if(vs&&(vs.velo_cv!=null||vs.spin_cv!=null||vs.eff_sd!=null)){ h+='<div class="card" style="grid-column:1 / -1"><h3>구질 안정성 — 투구 간 변동 <span class="sub2">CV·SD 낮을수록 구질 반복성↑ (제구와 별개 — 구질 자체의 일관성)</span></h3>'
    +'<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">구속 CV</div><div style="font-size:22px;font-weight:800">'+(vs.velo_cv!=null?vs.velo_cv+'%':'—')+'</div><div class="sub2">평균 '+(vs.avg_kmh!=null?vs.avg_kmh+' km/h':'—')+'</div></div>'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">회전수 CV</div><div style="font-size:22px;font-weight:800">'+(vs.spin_cv!=null?vs.spin_cv+'%':'—')+'</div><div class="sub2">평균 '+(vs.avg_spin!=null?vs.avg_spin+' rpm':'—')+'</div></div>'
    +'<div style="background:var(--bg2);padding:10px;border-radius:8px"><div class="sub2">효율/무브먼트 SD</div><div style="font-size:22px;font-weight:800">'+(vs.eff_sd!=null?vs.eff_sd:'—')+'</div></div>'
    +'</div></div>'; }
  return h; }
function _dgGaugeColHTML(G){
  var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[G.key]:null;
  var fpk=(typeof _DG!=='undefined'&&_DG.peak)?_DG.peak(G.key):null, spk=_cmpActive()?_gaugeSlowPeak(G.key,_DG.i0,_DG.i1):null;
  return '<div style="width:200px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">'+(G.cap||G.title)+'</div>'
   +'<canvas id="dgcv-'+G.key+'-ts" style="width:100%;height:210px;display:block"></canvas>'
   +'<canvas id="dgts2-'+G.key+'" style="width:100%;height:62px;display:block;margin-top:6px"></canvas>'
   +'<div style="text-align:center;font-size:11px;color:var(--fg2);margin-top:2px">시계열 · 스크러버와 동기화 (세로선 = 현재 위치)</div>'
   +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:'+G.color+'" id="dg-now-'+G.key+'">–</span> '+(G.unit||'')+'</div>'
   +'<div class="sub2" style="text-align:center;margin-top:2px">빠른공 정점 <b style="color:'+G.color+'">'+(fpk!=null?fpk:'–')+'</b>'+(spk!=null?' · <b style="color:#9aa6b4">'+_cmpLabel()+' '+spk+'</b>':'')+(nm?' · 엘리트 '+nm.p25+'–'+nm.p75+' '+(G.unit||''):'')+'</div></div>';
}
// ── [2026-05-26] 신설 변인 설명(정의·산출·해석) ──
var _NEWVAR_INFO={
  // 하지 키네틱(드라이브②·블로킹③)
  backHipWork:{def:'드라이브 구간 뒷고관절(뒷다리)이 한 양의 일.',calc:'KH→FC 뒷고관절 관절파워(M·ω) 양의 적분 ∫P⁺·dt. Theia 직접 산출.',interp:'뒷다리 추진 동력원. 클수록 능동 추진. 엘리트 중앙 ~53J.'},
  backHipMoment:{def:'드라이브 중 뒷고관절 관절 모멘트 최대(3축 결과 크기).',calc:'√(Mx²+My²+Mz²) 프레임별 → KH→BR 최대.',interp:'추진 토크 크기. 부상보다 동력 지표. 엘리트 중앙 ~285N·m.'},
  leadHipWork:{def:'블록 구간 앞고관절이 한 양의 일.',calc:'FC→BR 앞고관절 관절파워 양의 적분 ∫P⁺·dt.',interp:'앞다리가 회전을 끌어올리는 생성에너지 — 엘리트 변별 큰 변인(능동적 앞다리 활용). 엘리트 중앙 ~15J.'},
  leadHipMoment:{def:'블록 중 앞고관절 모멘트 최대(3축 결과).',calc:'√(Mx²+My²+Mz²) peak FC→BR.',interp:'앞다리 버팀·회전축 토크. 엘리트 중앙 ~321N·m.'},
  leadKneeMoment:{def:'블록 중 앞무릎 모멘트 최대(3축 결과 크기).',calc:'√(Mx²+My²+Mz²) peak FC→BR.',interp:'제동 강성. (③의 "버팀 모멘트"는 단축 버팀값, 이건 3축 결과) 엘리트 중앙 ~194N·m.'},
  leadKneeForce:{def:'블록 중 앞무릎 관절 반력 최대(3축 결과).',calc:'√(Fx²+Fy²+Fz²) peak FC→BR.',interp:'제동 부하·부상 지표. 과도하면 무릎 부담↑. 엘리트 중앙 ~1920N.'},
  // 상지 키네틱(상체 가속⑤)
  elbowMoment:{def:'투구 팔꿈치 관절 모멘트 최대(3축 결과).',calc:'Pitching_Elbow_Moment 3축 결과 peak(FC→BR).',interp:'내측측부인대(UCL) 부하와 직결되는 부상 지표. 높을수록 팔꿈치 위험↑.'},
  shoulderMoment:{def:'투구 어깨 관절 모멘트 최대(3축 결과).',calc:'Pitching_Shoulder_Moment 3축 결과 peak.',interp:'회전근개·관절낭 부하. 부상 지표.'},
  shoulderForce:{def:'투구 어깨 관절 반력 최대 — 분리력(어깨가 빠지듯 당겨지는 힘).',calc:'Pitching_Shoulder_Force 3축 결과 peak.',interp:'견인 부하 부상 지표. 릴리스 직후 감속 시 최대.'},
  elbowForce:{def:'투구 팔꿈치 관절 반력 최대(3축 결과).',calc:'Pitching_Elbow_Force 3축 결과 peak.',interp:'팔꿈치 관절 부하.'},
  gloveShPow:{def:'글러브측 어깨 관절 파워 최대.',calc:'Glove_Shoulder_Power peak(FC→BR).',interp:'글러브팔 능동 사용 — 채찍(글러브 당김) 트리거 기여.'},
  gloveHumME:{def:'글러브측 상완 분절 역학에너지 최대.',calc:'½mv²+½Iω² peak.',interp:'글러브팔 보유 에너지. 글러브팔 액션 강도.'},
  // 코일(와인드업①)
  pelClose:{def:'KH 이전 골반이 셋업 대비 회전으로 꼬인(닫힌) 최대각.',calc:'Pelvis_Angle_Z의 셋업값 대비 KH 이전 최대 절대 편차.',interp:'코일 깊이 — 클수록 탄성 적재↑(꼬임토크 freeMo와 상관). 엘리트 중앙 36.6°(우완 ~24-32, 좌완 ~42-60).'},
  // 좌우 밸런스(⑧) — 글러브팔 액션·대칭·다리·전두면·비대칭
  gAbd:{def:'착지(FC) 글러브 상완 외전각.',calc:'글러브 어깨→팔꿈치 벡터와 연직선 사이각(FC 순간).',interp:'앞쪽 T자세(양팔 벌림). 엘리트 ~78°. 과/소 외전 모두 타이밍 불안정.'},
  gElbFlex:{def:'FC 글러브 팔꿈치 굴곡각.',calc:'글러브 상완·전완 벡터 사이각(FC).',interp:'글러브팔 굳히기(firm-up) 정도.'},
  gHandH:{def:'FC 글러브 손−어깨 수직차.',calc:'글러브 손목.y − 글러브 어깨.y(FC).',interp:'글러브 손 높이(음수=어깨 아래).'},
  glovePullV:{def:'FC→BR 글러브 상완 수평면 회전 최대 각속도.',calc:'글러브 상완 수평각의 시간미분 peak(FC→BR).',interp:'글러브 당김(회전 채찍 트리거). 빠를수록 몸통 회전 가속에 기여. 엘리트 중앙 ~2360°/s.'},
  abdSym:{def:'FC 투구−글러브 외전 차(대칭도).',calc:'투구상완 외전 − 글러브상완 외전(FC).',interp:'양팔 T자세 대칭 — 0에 가까울수록 대칭.'},
  shTilt:{def:'FC 양 어깨 연결선 경사.',calc:'글러브−투구 어깨 벡터의 연직성분 각(FC).',interp:'어깨 기울기(+면 글러브 어깨 높음).'},
  counterAP:{def:'FC 글러브−투구 어깨 전후(AP) 분리.',calc:'글러브 어깨.z − 투구 어깨.z(FC).',interp:'상체 역회전(글러브 앞). 클수록 상하체 분리 적재↑.'},
  leadKneeFlex:{def:'FC 앞다리(블록) 무릎 굴곡각.',calc:'앞 고관절·무릎·발 위치 사이각(FC).',interp:'착지 무릎 굴곡 자세(③ 신전/붕괴와 함께 해석).'},
  backKneeFlex:{def:'FC 뒷다리(드라이브) 무릎 굴곡각.',calc:'뒷 고관절·무릎·발 위치 사이각(FC).',interp:'드라이브 잔여 굴곡.'},
  trunkLat:{def:'착지 시 몸통 좌우 기울기.',calc:'목−골반 벡터의 ML 성분 각(FC).',interp:'좌우 기울기 — 제구(머리 안정성)와 연관. 현장에서 강조하는 지표.'},
  pelObliq:{def:'FC 골반 좌우 기울기.',calc:'좌−우 고관절 수직차 각(FC).',interp:'앞고관절 drop/rise. 골반 수평 유지 정도.'},
  shAbdAsym:{def:'어깨 외전 비대칭 지수.',calc:'(투구−글러브)/(|투구|+|글러브|)×100.',interp:'좌우 비대칭 스크리닝 — 0 근접=대칭.'},
  elbowFlexAsym:{def:'팔꿈치 굴곡 비대칭 지수.',calc:'(투구−글러브)/(합)×100.',interp:'좌우 팔꿈치 굴곡 비대칭.'},
  kneeFlexSym:{def:'무릎 굴곡 비대칭 지수.',calc:'(앞−뒤)/(|앞|+|뒤|)×100.',interp:'블록 다리 vs 드라이브 다리 굴곡 차.'},
  // ── 기존 변인 (와인드업①) ──
  freeMo:{def:'KH 이전 뒷발 지면반력 꼬임 토크(발이 땅을 비트는 힘) 음의 피크 크기.',calc:'뒷발판 자유모멘트 Mz의 KH 이전 음의 peak |값|.',interp:'골반 코일을 만드는 역학적 동력. 클수록 적재↑(양의 토크는 KH 직전 열림). 엘리트 중앙 ~10.6N·m.'},
  hipHinge:{def:'KH 이전 뒷고관절(뒷다리) 앞으로 굽히는 최대 각도.',calc:'Back_Hip_Angle_X(굴곡)의 0→KH peak.',interp:'"뒷고관절에 앉아" 앞으로 굽혀 로딩. 코일 변인과 보완적. 엘리트 중앙 ~27°.'},
  // ── 드라이브② ──
  strideLen:{def:'스트라이드 길이(신장%).',calc:'두 발 사이 거리를 키로 나눈 비율(%).',interp:'길수록 구속↑(문헌). 코호트 중앙 ~83%.'},
  grfDelay:{def:'뒷발·앞발 수직 GRF peak 간격(스트라이드 소요시간 대용).',calc:'FP2_Z peak 시점 − FP1_Z peak 시점(ms).',interp:'드라이브 템포 — 짧을수록 빠른 체중이동.'},
  rearProp:{def:'뒷발 전진(홈쪽) 추진력 peak.',calc:'FP1_Y peak ÷BW ×100(%BW).',interp:'드라이브 추진력. 문헌 pivot 0.65–0.8 BW.'},
  propImpPct:{def:'뒷발 추진 임펄스(%BW·s).',calc:'∫추진력 dt ÷ BW.',interp:'전진 운동량 생성 총량. 클수록 좋음.'},
  hipAbd:{def:'드라이브~릴리스 뒷다리 고관절 내전 방향 peak 각속도.',calc:'Back_Hip_Angle_Y 시간미분(내전방향) peak.',interp:'드라이브 회전 동력(IMU 직접측정).'},
  driveWork:{def:'드라이브 구간 뒷고관절+뒷무릎이 한 양의 일.',calc:'KH→FC ∫(P_hip+P_knee)⁺·dt.',interp:'드라이브가 생성한 관절 에너지(동력원). 마커리스 관절동역학 노이즈 유의. 코호트 중앙 ~123J.'},
  comVel:{def:'무게중심 전진 속도 peak.',calc:'COM_Velocity_Y peak.',interp:'드라이브의 선형 결과(KE). 145km/h+ 상위5%=3.4 m/s.'},
  // ── 블로킹③ ──
  kneeExtROM:{def:'착지~릴리스 앞무릎 신전량.',calc:'Lead_Knee_Angle_X(FC) − (BR). +신전/−굴곡.',interp:'앞무릎 신전 클수록 구속↑(문헌). 굴곡 붕괴량과 함께 해석.'},
  kneeAbs:{def:'앞무릎 버팀(늘어나며 버티는 힘) peak.',calc:'앞무릎 단축 모멘트 |peak|(FC→BR).',interp:'강한 버팀(클수록↑). 부호규약이 데이터셋마다 반대라 절대값 사용. 규준 95p=271N·m.'},
  kneeAbsE:{def:'앞무릎이 착지충격을 흡수한 에너지.',calc:'|∫P⁻·dt|(FC→BR).',interp:'적을수록 단단한 블록(에너지 누수↓→회전 전환). 코호트 중앙 ~43J.'},
  leadGrf:{def:'앞다리 제동 수직 지면반력 peak.',calc:'FP2_Z peak ÷BW ×100(%BW).',interp:'블로킹 제동력. 145km/h+ 상위5%=256%.'},
  apBrake:{def:'앞다리 후방 제동 지면반력 peak.',calc:'FP2_Y(전방+) peak ÷BW ×100.',interp:'선형→회전 에너지 전환. (엘리트 export는 AP 부호규약 상이 — 상동코호트 규준 사용)'},
  comDecel:{def:'착지 직후 무게중심 제동 가속도 peak.',calc:'COM 전진속도 시간미분(음의 기울기) 크기 peak (m/s²).',interp:'앞다리 제동(블로킹) 강도. 클수록 강한 제동=선형→회전 전환.'},
  comKEdrop:{def:'블록이 제거한 COM 선형 운동에너지.',calc:'½m(v_peak² − v_min²).',interp:'강한 제동(선형→회전 전환). 코호트 중앙 ~231J.'},
  kneeCollapse:{def:'착지 후 앞무릎이 추가로 굽은 최대량(붕괴).',calc:'최대굴곡각 − FC 굴곡각(FC→BR).',interp:'작을수록 단단한 버팀(0=무붕괴). 코호트 중앙 ~3°.'},
  // ── 에너지 저장④ ──
  xfPeak:{def:'골반-어깨 최대 분리(X-Factor).',calc:'분절 상대 축회전 Trunk_wrt_Pelvis_Angle_Z(골반·몸통 좌표계 상대 Z회전) KH→BR peak. [2026-05-28] 3D 상대각으로 재정의(글로벌 수평투영은 측면기울기 혼입으로 ~18° 과대).',interp:'탄성 에너지 저장(스트레치). 클수록 좋음. 엘리트 코호트 중앙 ~30°(상동고 29.5°·OBP 32°). ※ 전통 글로벌 투영 정의(50±12°)와는 값이 다름.'},
  xfPeakFromFC:{def:'X-Factor 풀림 시점 (FC 기준).',calc:'최대 분리(peak X-Factor) 프레임 − FC 프레임, ms.',interp:'분리를 착지까지 유지하는지의 타이밍. 엘리트 중앙 +12ms(FC 직후). 음수가 크면 착지 전 조기 풀림 = flying open. FC 검출 정확도에 민감.'},
  xfUnwindV:{def:'X-Factor 풀림 속도.',calc:'peak 이후 BR 까지 |X-Factor| 감소 최대 각속도, °/s.',interp:'상체가 골반을 따라잡는 풀림 속도. 엘리트 중앙 ~330°/s(분절 상대각 기준). 적절히 빨라야 탄성 에너지 전달.'},
  xfReleasedPctByFC:{def:'몸통 조기 열림 — 착지(FC)까지 풀린 비율.',calc:'(최대 X-Factor − FC 시 X-Factor)/최대 ×100, 단 최대가 FC 이전일 때만(이후=0).',interp:'착지 전 분리 누수 정량 지표. 엘리트 중앙 0%·최대 16%. 정상≤10·경계10~25·조기풀림>25%.'},
  xfAtFC:{def:'FC 시 X-Factor.',calc:'착지 시점 |골반-어깨 분리각|(분절 상대각).',interp:'최대 분리(xfPeak) 대비 FC 유지 정도. 엘리트는 최대의 ~90% 유지.'},
  merPk:{def:'팔 들어올리는 시기(코킹) 어깨 최대 외회전(MER).',calc:'Pitching_Shoulder_Angle_Z peak.',interp:'전방관절낭·내회전근 탄성 에너지 저장.'},
  scapLoad:{def:'견갑골 준비(대용 지표: 착지 시 어깨 수평벌림 |각|).',calc:'Pitching_Shoulder_Angle_X |값|(FC).',interp:'팔이 좌우면에서 뒤로 젖혀진 정도(마커리스는 견갑골 직접측정 불가 → 수평외전 대용).'},
  leanBack:{def:'FC 몸통 후방 기울임(직립=0, 뒤로 +).',calc:'Trunk_Angle_X(FC).',interp:'+가 정상. 음수면 FC에서 앞으로 굽음 경고.'},
  openAng:{def:'FC 몸통 열림 각도(정면=0, 홈쪽으로 +).',calc:'Trunk_Angle_Z(FC).',interp:'작을수록 닫힘 유지. 20° 이상이면 조기 오픈(flying open) 누수 경고.'},
  // ── 상체 가속⑤ ──
  pelvisRotV:{def:'FC→BR 골반 회전 각속도 peak.',calc:'Pelvis_Ang_Vel_Z peak.',interp:'근위 회전 동력. 코호트 중앙 ~636°/s.'},
  torsoRotV:{def:'가슴(몸통) 회전 각속도 peak.',calc:'Thorax_Ang_Vel_Z peak.',interp:'145km/h+ 상위5%=1247°/s.'},
  trunkFlexV:{def:'상체 전방 굴곡(시상면) 각속도 peak.',calc:'Trunk_Angle_X 시간미분 peak.',interp:'드라이브측 동력. 문헌 ~300–450°/s.'},
  armRotV:{def:'어깨 내회전 각속도 peak.',calc:'Pitching_Shoulder_Ang_Vel_Z peak.',interp:'145km/h+ 상위5%=5116°/s.'},
  elbowExtV:{def:'팔꿈치(전완 기준) 신전 각속도 peak.',calc:'Pitching_Elbow_Ang_Vel_X peak.',interp:'전완 기준 측정 — OBP/문헌(상완 기준 ~2861°/s)과 좌표계 달라 점수 보류(값만).'},
  trunkME:{def:'몸통 분절 역학에너지 peak.',calc:'½mv² + ½Iω² peak.',interp:'클수록 좋음.'},
  humME:{def:'투구 상완 분절 역학에너지 peak.',calc:'½mv² + ½Iω² peak.',interp:'클수록 좋음.'},
  elbowP:{def:'팔꿈치 신전 시 관절 파워 |peak|.',calc:'M·ω peak(FC→BR, 절대값).',interp:'절대값 클수록 좋음.'},
  // ── 에너지 전달⑥ ──
  shGen:{def:'투구 어깨 관절 에너지 생성.',calc:'∫P⁺·dt(FC→BR).',interp:'어깨 가속 생성. OBP 145km/h+ 상위5%=62J.'},
  elbAbs:{def:'팔꿈치 감속 흡수 에너지.',calc:'|∫P⁻·dt|(FC→BR).',interp:'팔꿈치 감속 부하. OBP 145km/h+ 상위5%=82J.'},
  seqPct:{def:'운동사슬 시퀀스 정확도.',calc:'골반→몸통→팔 peak 순서가 맞은 트라이얼 비율(%).',interp:'높을수록 올바른 근위→원위 순서.'},
  whipRatio:{def:'채찍 효과 비율(팔/몸통).',calc:'팔 peak 각속도 ÷ 몸통 peak 각속도.',interp:'클수록 원위(팔) 가속 증폭(채찍 효과).'},
  chainTiming:{def:'운동사슬 타이밍 점수.',calc:'분절 peak 간 시간 간격 적정성 기반.',interp:'적정 지연일수록 에너지 전달 최적.'},
  driveType:{def:'앞무릎 활용 유형(서술형).',calc:'순 무릎신전(FC→BR)≥13°=신전형(밀어올리기), 미만=버팀-흡수형.',interp:'두 유형 모두 유효 엘리트 패턴(우열 아님). 동작 유형과는 별개의 앞다리 전략.'},
  kneeExtE:{def:'앞무릎 신전이 생성한 에너지.',calc:'∫P⁺·dt(FC→BR).',interp:'무릎을 펴며 들어올리는(생성) 에너지.'},
  kneeContribPct:{def:'무릎 신전 기여 비율.',calc:'신전E ÷ (신전E+흡수E) ×100.',interp:'높을수록 신전(생성) 우세형.'},
  kneeTrunkLag:{def:'무릎 신전–몸통 회전 타이밍 지연.',calc:'무릎 신전속도 peak − 몸통 회전속도 peak(ms).',interp:'+면 무릎이 회전보다 뒤.'},
  // ── 동작 일관성⑦ ──
  relTimingMs:{def:'FC→BR 소요시간.',calc:'(i_br − i_fc) × dt(ms).',interp:'상체 가속 구간 길이.'},
  armSlot:{def:'팔 각도(착지 시 어깨 벌림 각).',calc:'Pitching_Shoulder_Angle_Y(FC).',interp:'릴리스 높이/팔 각도 경향(오버/스리쿼터/사이드).'},
  seqSpan:{def:'운동사슬 총 지연(골반→팔).',calc:'pelvis_to_trunk_ms + trunk_to_arm_ms.',interp:'시퀀스 전개에 걸린 총 시간.'}
};
function _evRound(v){ return (v==null||!isFinite(v))?null:Math.round(v*10)/10; }
// 시계열의 이벤트(KL/FC/MER/BR) 시점값 + 피크 테이블 (빠른공 기준)
function _evValTable(cfg,m){
  if(!cfg||!cfg.fn) return '';
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t) return '';
  var ser=null; try{ ser=cfg.fn(t); }catch(e){} if(!ser||!ser.length) return '';
  var ev=t.events||{}, dt=(t.meta&&t.meta.dt)||(t.setup&&t.setup.dt)||0.004, ifc=ev.i_fc, u=m.unit||'';
  var EV=[['KL','i_kl_peak','다리들기 정점'],['FC','i_fc','착지'],['MER','i_mer','최대 외회전'],['BR','i_br','릴리스']];
  function at(i){ return (i!=null&&isFinite(ser[i]))?_evRound(ser[i]):null; }
  function ms(i){ return (i!=null&&ifc!=null)?Math.round((i-ifc)*dt*1000):null; }
  var i0=ev.i_kl_peak||0, i1=ev.i_br!=null?ev.i_br:ser.length-1, pk=null,pki=null;
  for(var i=i0;i<=i1&&i<ser.length;i++){ if(isFinite(ser[i])&&(pk==null||Math.abs(ser[i])>Math.abs(pk))){pk=ser[i];pki=i;} }
  var rows=EV.map(function(e){ var i=ev[e[1]], v=at(i), t2=ms(i); return '<tr><td style="text-align:left;color:var(--fg2)">'+e[0]+' <span style="font-size:11px">'+e[2]+'</span></td><td style="text-align:right;font-weight:700">'+(v!=null?v+u:'—')+'</td><td style="text-align:right;color:var(--fg2)">'+(t2!=null?(t2>0?'+':'')+t2+'ms':'—')+'</td></tr>'; }).join('');
  var pkRow='<tr style="border-top:1px solid var(--fg2)"><td style="text-align:left;color:var(--amber);font-weight:700">피크</td><td style="text-align:right;font-weight:800;color:var(--amber)">'+(pk!=null?_evRound(pk)+u:'—')+'</td><td style="text-align:right;color:var(--fg2)">'+(pki!=null&&ifc!=null?((pki-ifc)*dt*1000>0?'+':'')+Math.round((pki-ifc)*dt*1000)+'ms':'—')+'</td></tr>';
  return '<div style="margin-top:8px"><table style="border-collapse:collapse;font-size:11px;min-width:240px"><thead><tr><th style="text-align:left;color:var(--fg2);font-weight:600">이벤트</th><th style="text-align:right;color:var(--fg2);font-weight:600">시점값</th><th style="text-align:right;color:var(--fg2);font-weight:600">FC기준</th></tr></thead><tbody>'+rows+pkRow+'</tbody></table><div class="sub2" style="margin-top:2px">빠른공 기준 · FC기준=착지 대비 시간(− 이전/+ 이후)</div></div>';
}
// 신설 변인 설명 블록(접이식)
function _varInfoHTML(key){
  var d=_NEWVAR_INFO[key]; if(!d) return '';
  return '<details style="margin-top:8px"><summary style="cursor:pointer;font-size:12px;font-weight:700;color:var(--cyan)">변인 설명 — 정의·산출·해석 ▾</summary>'
    +'<div style="margin-top:6px;font-size:11.5px;line-height:1.6;color:var(--fg1)">'
    +'<div><b>정의</b> '+d.def+'</div>'
    +'<div style="margin-top:3px"><b>산출방법</b> '+d.calc+'</div>'
    +'<div style="margin-top:3px"><b>해석·평가</b> '+d.interp+'</div>'
    +'</div></details>';
}
// 단계 변인 상세 섹션 — 그 단계 전 변인의 정의·산출·해석 + 이벤트 시점값(빠짐없이)
function _phaseVarDetail(stage){
  var mets=(stage.metrics||[]).filter(function(m){return m.key && m.key!=='_null';});
  if(!mets.length) return '';
  var items=mets.map(function(m){
    var cfg=(typeof _FC_SER!=='undefined')?_FC_SER[m.key]:null;
    var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null, z='';
    if(nm&&m.value!=null&&m.dir){ var s=_bmStat(m.value,nm,m.dir); z=' <span style="color:'+_bmStatusCol(s.status)+';font-weight:700">'+_bmStatusGlyph(s.status)+_bmZ(s.z)+'</span>'; }
    var d=_NEWVAR_INFO[m.key];
    var info=d?('<div style="font-size:11.5px;line-height:1.6;color:var(--fg1)"><div><b>정의</b> '+d.def+'</div><div style="margin-top:3px"><b>산출방법</b> '+d.calc+'</div><div style="margin-top:3px"><b>해석·평가</b> '+d.interp+'</div></div>')
      :(m.note?'<div style="font-size:11.5px;line-height:1.6;color:var(--fg1)">'+m.note+'</div>':'<div class="sub2">설명 준비 중</div>');
    var tbl=cfg?_evValTable(cfg,m):'';
    var elite=nm?'<div class="sub2" style="margin-top:4px">엘리트 '+nm.p25+'~'+nm.p75+(m.unit||'')+' (중앙 '+nm.med+')</div>':'';
    return '<details style="border-top:1px solid var(--bg3);padding:7px 0"><summary style="cursor:pointer;font-weight:700;font-size:12.5px">'+m.label+' <span class="sub2" style="font-weight:600">'+(m.value!=null?m.value+(m.unit||''):'—')+z+'</span></summary><div style="margin-top:6px">'+info+elite+tbl+'</div></details>';
  }).join('');
  return '<div class="card" style="grid-column:1 / -1"><h3>📋 단계 변인 상세 <span class="sub2">전 변인 정의·산출방법·해석·평가 + 이벤트(KL·FC·MER·BR) 시점값 — 항목을 펼쳐보세요</span></h3>'+items+'</div>';
}
// [2026-05-27] 분리(X-Factor) 활용 4박스 카드 — 에너지 전달/비효율/요약 공용.
//   합본(상동고+엘리트 34명) 분석: 분리 크기는 출력과 무관(r≈0.1) / 조기풀림→채찍비 저하(r=−0.26) / 풀림속도→팔속도(r=0.32) / 채찍비→팔속도(r=0.67·최강).
//   따라서 "크기"가 아니라 "형성 → 유지 → 방출 → 전달 효율"의 과정으로 제시. peak X-Factor는 맥락 지표.
function _flyingOpenCardHTML(P){
  var fo=null,xfpk=null,xfFC=null,uw=null,atfc=null,whip=null;
  ((P&&P.stages)||[]).forEach(function(s){ (s.metrics||[]).forEach(function(m){
    if(m.key==='xfReleasedPctByFC')fo=m; if(m.key==='xfPeak')xfpk=m.value; if(m.key==='xfPeakFromFC')xfFC=m.value;
    if(m.key==='xfUnwindV')uw=m.value; if(m.key==='xfAtFC')atfc=m.value; if(m.key==='whipRatio')whip=m.value; }); });
  if(!fo || fo.value==null) return '';
  var acc=fo.value>25?'#e07a78':(fo.value>10?'#e8954e':'#46c98c');
  var st=fo.value>25?'조기풀림':(fo.value>10?'경계':'정상');
  function box(num,title,val,sub,col){ return '<div style="flex:1 1 200px;background:var(--bg2);border-radius:8px;padding:11px 13px;border-top:3px solid '+(col||'var(--line)')+'"><div class="sub2" style="font-size:11px">'+num+' '+title+'</div><div style="font-size:21px;font-weight:800;margin:2px 0">'+val+'</div><div class="sub2" style="font-size:11px">'+sub+'</div></div>'; }
  return '<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">분리(X-Factor) 활용 — 하체→몸통→팔 에너지 전달 <span class="sub2">크기가 아니라 "착지까지 유지하다 제때 빠르게 푸는 것"이 핵심 · 형성 → 유지 → 방출 → 전달 효율</span></h3>'
    +'<div style="display:flex;gap:10px;flex-wrap:wrap">'
    +box('①','분리 형성 (맥락)', (xfpk!=null?xfpk+'°':'—'), '최대 X-Factor · 크기 자체는 출력과 무관(r≈0.1)', 'var(--fg2)')
    +box('②','분리 유지 (flying open)', fo.value+'%', st+' · FC까지 풀린 비율 (엘리트 0%)', acc)
    +box('③','분리 방출', (uw!=null?uw+'°/s':'—'), '풀림 속도 · 시점 '+(xfFC!=null?(xfFC>0?'+':'')+xfFC+'ms':'—')+' (팔속도 r=0.32)', 'var(--cyan)')
    +box('④','전달 효율 (채찍비)', (whip!=null?whip+'×':'—'), '팔/몸통 속도 증폭 · 팔속도와 r=0.67(최강)', 'var(--green)')
    +'</div>'
    +'<div class="note" style="margin-top:8px">이상적 패턴: 분리를 <b>착지까지 단단히 유지</b>(② 0%) → <b>착지 직후 빠르게 방출</b>(③↑) → 높은 <b>전달 효율</b>(④ 채찍비↑). '
    +'합본 34명 분석상 분리 <b>크기</b>(①)는 출력 예측력이 낮고, <b>조기 풀림</b>(②)은 전달 효율을 떨어뜨리며(r=−0.26), <b>풀림 속도</b>(③ r=0.32)와 특히 <b>채찍비</b>(④ r=0.67)가 팔속도와 연결됩니다. 한 선수 내 코칭 레버로 보세요. 키네매틱 시퀀스 그래프의 보라색 점선(X-Factor 최대=풀림 시작)이 골반→몸통→팔 가속과 어떻게 맞물리는지 함께 확인하세요.</div></div>';
}
function renderPhaseTab(phaseKey){
  var P=(typeof DATA!=='undefined')?DATA.phases:null;
  var cont=document.getElementById('phch-'+phaseKey); if(!cont) return;
  var stage=(P&&P.stages)?P.stages.filter(function(s){return s.key===phaseKey;})[0]:null;
  if(!stage){ cont.innerHTML='<div class="note">단계 데이터가 없습니다.</div>'; _phaseCharts=[]; return; }
  var html='', charts=[], _head='';
  if(phaseKey==='windup'){ try{ _WG.data=_WG.build(); }catch(e){ _WG.data=null; } if(_WG.data) _head+='<div class="card" style="grid-column:1 / -1"><div class="note">와인드업 3개 변인은 각 그래프 옆에 해부학 동적 게이지가 함께 표시됩니다. 왼쪽 풀바디 스틱을 재생/이동하면 게이지가 같은 프레임(처음~FC)으로 움직입니다. <span style="color:#46c98c">[빌드 0525-f 게이지숫자]</span></div></div>'; }
  if(phaseKey==='drive'){ try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){} if(_WG.data){ var _dw=_DG.win(); _DG.i0=_dw[0]; _DG.i1=_dw[1]; _head+='<div class="card" style="grid-column:1 / -1"><div class="note">드라이브 게이지는 각 그래프 옆에 표시되며, 왼쪽 풀바디 스틱 재생에 동기화됩니다. 스트라이드는 발자국+CoP 궤적+길이/방향 시각화로 표시됩니다. <span style="color:#46c98c">[빌드 0525-k 블로킹게이지]</span></div></div>'; } }
  if(phaseKey==='blocking'){ try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){} if(_WG.data){ var _bw=_BG.win(); _BG.i0=_bw[0]; _BG.i1=_bw[1]; _head+='<div class="card" style="grid-column:1 / -1"><div class="note">블로킹 변인은 앞다리(lead) 측면 스틱 게이지로 표시되며 왼쪽 풀바디 스틱 재생에 동기화됩니다. 모든 시계열은 FC−0.1초부터. <span style="color:#46c98c">[빌드 0525-k 블로킹게이지]</span></div></div>'; } }
  if(phaseKey==='storage'){ try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){} if(_WG.data){ var _sw=_SG.win(); _SG.i0=_sw[0]; _SG.i1=_sw[1]; _head+='<div class="card" style="grid-column:1 / -1"><div class="note">에너지 저장 변인은 스틱 게이지로 표시됩니다 — X-Factor·견갑골 로딩·몸통 열림=위에서 본 뷰, 어깨 MER·몸통 뒤젖힘=측면 뷰. 왼쪽 풀바디 스틱 재생에 동기화. <span style="color:#46c98c">[빌드 0525-m 부위강조]</span></div></div>'; } }
  if(phaseKey==='release'){ try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){} if(_WG.data){ var _rw=_RG.win(); _RG.i0=_rw[0]; _RG.i1=_rw[1]; _head+='<div class="card" style="grid-column:1 / -1"><div class="note">상체 가속: 회전 속도(골반→몸통→팔)·분절 에너지·관절 모멘트/파워를 함께 봅니다. 왼쪽 풀바디 스틱 재생에 동기화.<br><b>모멘트·관절력이 회전 가속과 맺는 관계:</b> 몸통이 빠르게 회전하면 그 회전을 팔에 전달·제어하기 위해 어깨·팔꿈치에 큰 <b>관절 모멘트(토크)</b>가 발생합니다 — 즉 모멘트는 상체 회전 가속을 만들고 견디는 "내부 힘"입니다. <b>어깨 분리력·팔꿈치 관절력</b>은 빠른 회전·내회전을 감속·정렬시키며 관절을 잡아당기는 부하로, 회전 가속이 클수록 함께 커집니다(부상 부하 지표). 회전 속도 정점과 모멘트·관절력 정점의 타이밍·크기를 함께 보면 가속이 효율적인지, 관절 부하가 과한지 판단할 수 있습니다.</div></div>'; } }
  if(phaseKey==='transfer'){ try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){} if(_WG.data){ var _tw=_TG.win(); _TG.i0=_tw[0]; _TG.i1=_tw[1]; }
    _head+='<div class="card" style="grid-column:1 / -1"><div class="note">에너지 전달: ⓪flying open(분리 풀림) 핵심 지표 ①전 트라이얼 시퀀스 정확도 스코어카드 ②앞무릎 활용 유형 ③어깨 생성·팔꿈치 흡수 파워. <span style="color:#46c98c">[빌드 0525-o 에너지전달]</span></div></div>';
    _head+=_flyingOpenCardHTML(P);
    _head+=_seqScorecardHTML();
    if(stage&&stage.kinematicOnly){ _head+='<div class="card" style="grid-column:1 / -1"><div class="note">동작(마커리스) 데이터 — 분절 운동에너지(½mv²+½Iω²)와 키네매틱 시퀀스는 지면반력 없이 위치·각속도만으로 산출됩니다.</div></div>'; }
    if(stage&&!stage.kinematicOnly){ var _kc=(stage.metrics||[]).filter(function(x){return x.key==='kneeContribPct';})[0], _dt=(stage.metrics||[]).filter(function(x){return x.key==='driveType';})[0], _ke=(stage.metrics||[]).filter(function(x){return x.key==='kneeExtE';})[0], _kl=(stage.metrics||[]).filter(function(x){return x.key==='kneeTrunkLag';})[0];
      _TG.contribPct=_kc?_kc.value:null; _TG.typeStr=_dt?(_dt.value||''):'';
      _TG.cmpContribPct=null; try{ var _cp=(typeof _cmpPlayer==='function')?_cmpPlayer():null; if(_cp&&_cp.phases&&_cp.phases.stages){ var _ts=_cp.phases.stages.filter(function(s){return s.key==='transfer';})[0]; if(_ts){ var _km=(_ts.metrics||[]).filter(function(x){return x.key==='kneeContribPct';})[0]; if(_km)_TG.cmpContribPct=_km.value; } } }catch(e){}
      _head+='<div class="card" style="grid-column:1 / -1"><h3>앞무릎 활용 유형 — '+( _dt?(_dt.value||'') :'')+' <span class="sub2">유형 판단 근거: 무릎 신전 기여 비율 위치 + 측면 스틱(이영하-문서준식 비교 축)</span></h3>'
        +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
        +'<canvas id="tgcv-knetype" style="flex:1 1 320px;min-width:300px;height:200px;display:block"></canvas>'
        +'<div style="width:200px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 앞무릎(측면)</div><canvas id="tgcv-knee-ts" style="width:100%;height:200px;display:block"></canvas>'
        +'<div class="sub2" style="text-align:center;margin-top:4px">신전E '+(_ke&&_ke.value!=null?_ke.value+'J':'–')+' · 기여 '+(_kc&&_kc.value!=null?_kc.value+'%':'–')+' · 타이밍 '+(_kl&&_kl.value!=null?_kl.value+'ms':'–')+'</div></div>'
        +'</div></div>'; } }
  (stage.metrics||[]).forEach(function(m,i){
    var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null, statLine='';
    if(nm&&m.value!=null&&m.dir){ var s=_bmStat(m.value,nm,m.dir); statLine=' · <span style="color:'+_bmStatusCol(s.status)+';font-weight:700">'+_bmStatusGlyph(s.status)+' '+(s.status==='strong'?'강점':(s.status==='flag'?'교정':'정상'))+' · '+_bmZ(s.z)+'</span>'; }
    var valTxt=(m.value!=null?m.value+(m.unit||''):'—');
    // ── [2026-05-26] ⑧ 좌우 밸런스: 카드 + FC순간값 시계열(프레임 추적) + 엘리트 밴드 게이지 ──
    if(phaseKey==='balance'){
      var _bcfg=_FC_SER[m.key], _bcid='chph-balance-'+i;
      var _bband=(nm&&m.value!=null&&m.dir)?_bmBandSVG(m.value,nm,m.dir):'';
      var _belite=nm?('엘리트 '+nm.p25+'~'+nm.p75+(m.unit||'')+' (중앙 '+nm.med+')'):'규준 산출 전';
      // [2026-05-26] 좌우 밸런스: 글러브팔+투구팔을 한 그래프에 오버레이(어깨 외전·팔꿈치 굴곡) + 해석 설명
      var _ovl={gAbd:{key:'tAbd',label:'투구팔 외전'}, gElbFlex:{key:'tElbFlex',label:'투구팔 굴곡'}}[m.key];
      var _gloveLbl={gAbd:'글러브팔 외전', gElbFlex:'글러브팔 굴곡'}[m.key]||m.label;
      var _interp={
        gAbd:'양팔이 비슷한 높이로 벌어지면(좌우 대칭·T자) 회전축이 안정되어 제구·반복성에 유리합니다. 글러브팔(주황)이 투구팔(초록)보다 크게 낮거나 높으면 어깨 정렬이 무너진 신호입니다.',
        gElbFlex:'양 팔꿈치 굽힘이 대칭이면 양팔이 함께 균형을 잡습니다. 글러브 팔꿈치가 과하게 펴지거나 접히면 상체가 한쪽으로 쏠려 좌우 균형이 흔들립니다.',
        shTilt:'양 어깨 연결선의 좌우 기울기입니다. 0에 가까울수록 수평 — 머리·시선이 안정되어 제구에 유리합니다. 글러브 어깨가 과하게 들리면 릴리스가 높아지고 좌우 균형이 무너집니다.'
      }[m.key]||'';
      var _blines=(_bcfg&&_bcfg.fn)?[{compute:_bcfg.fn,color:(_ovl?'#46c98c':_bcfg.c),label:(_ovl?_gloveLbl:m.label),width:2.6}]:null;
      if(_blines && _ovl){ var _ok=_ovl.key, _olbl=_ovl.label; _blines.push({compute:function(t){return _balSer(t,_ok);},color:'#4a90c8',label:_olbl,width:2.4}); }
      // [2026-05-26] 그래프 폭 확대: 차트를 넓히고 스틱+밴드를 우측 한 열로 합침. 어깨 외전·어깨 라인 기울기는 정면(홈) 뷰.
      var _stickCap={gAbd:'양팔 — 어깨 외전(정면)', gElbFlex:'양팔 — 팔꿈치(측면)', shTilt:'몸통·어깨 라인(정면)'}[m.key]||'스틱';
      html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
        +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
        +(_blines?'<canvas class="chart tall" id="'+_bcid+'" style="flex:1 1 460px;min-width:340px"></canvas>'
               :'<div style="flex:1 1 460px;min-width:340px" class="note">착지(FC) 순간 자세값 — 우측 게이지로 엘리트 대비 위치를 확인하세요.</div>')
        +'<div style="width:200px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — '+_stickCap+'</div><canvas id="bal-stick-'+m.key+'" style="width:100%;height:170px;display:block"></canvas>'
        +(_bband||'<div class="note" style="text-align:center;padding:6px 0">'+_belite+'</div>')
        +'<div class="sub2" style="text-align:center;margin-top:4px">현재 <b>'+valTxt+'</b> · '+_belite+'</div></div>'
        +'</div>'
        +(_interp?'<div class="note" style="margin-top:8px"><b>밸런스 해석:</b> '+_interp+'</div>':'')
        +'</div>';
      if(_blines) charts.push({cid:_bcid,lines:_blines,m:m,noGauge:true});
      return;
    }
    // [2026-05-26] 부상 잠재 부하(injuryload): 어깨 모멘트·분리력·팔꿈치 모멘트에 투구팔 측면 스틱 게이지
    if(phaseKey==='injuryload'){
      var _icfg=_FC_SER[m.key], _icid='chph-injuryload-'+i;
      var _iStick=({shoulderMoment:1,shoulderForce:1,elbowMoment:1})[m.key];
      html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
        +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
        +'<canvas class="chart tall" id="'+_icid+'" style="flex:1 1 280px;min-width:260px"></canvas>'
        +(_iStick?'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 투구팔(측면)</div><canvas id="inj-stick-'+m.key+'" style="width:100%;height:200px;display:block"></canvas></div>':'')
        +'</div></div>';
      charts.push({cid:_icid,cfg:_icfg,m:m,noGauge:true});
      return;
    }
    // 드라이브 스트라이드: 길이/시간 그래프 2개 → 발자국+CoP 궤적+스트라이드(길이·방향) 시각화 1개로 대체
    if(phaseKey==='drive' && m.key==='grfDelay') return;
    // [FIX 0525] 드라이브 고관절 내전 속도 그래프에 뒷고관절 회전 각속도(IMU 고유) 오버레이
    if(phaseKey==='drive' && m.key==='hipAbd'){
      var _nogH=(typeof DATA!=='undefined'&&DATA.system&&/Uplift/i.test(DATA.system));
      if(_nogH){
        // [2026-05-26] Uplift: 내전속도는 Uplift 키네마틱(Back_Hip_Angle_Y 미분) 산출 — IMU 아님. 회전각속도(Back_Hip_Rot_Vel_X)는 IMU 전용→빈 선 제거. 스틱은 상단 드라이브 게이지에 동기 표시.
        html+='<div class="card" style="grid-column:1 / -1"><h3>뒷다리 고관절 내전 속도 <span class="sub2">'+valTxt+statLine+' · Uplift 키네마틱 산출(뒷고관절 내전 각속도) · 옆: 측면 스틱(뒷다리)</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-drive-hip" style="flex:1 1 280px;min-width:260px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 뒷다리(측면)</div><canvas id="dgcv-hipAbd-ts" style="width:100%;height:210px;display:block"></canvas>'
          +'<div class="sub2" style="text-align:center;margin-top:4px">왼쪽 풀바디 스틱 재생에 동기화</div></div>'
          +'</div></div>';
        charts.push({cid:'chph-drive-hip', m:{unit:'°/s',label:'고관절 내전속도'}, noGauge:true, lines:[
          {compute:function(t){return _dvel(t.series.Back_Hip_Angle_Y,t.meta.dt,-1);},color:'#46c98c',label:'내전 속도',width:2.2}
        ]});
        return;
      }
      html+='<div class="card" style="grid-column:1 / -1"><h3>뒷다리 고관절 내전 속도 + 회전 각속도 <span class="sub2">'+valTxt+statLine+' · 한 그래프 · IMU 직접측정(자이로). 회전 각속도=뒷고관절 IMU 고유 변인</span></h3><canvas class="chart tall" id="chph-drive-hip" style="width:100%"></canvas></div>';
      charts.push({cid:'chph-drive-hip', m:{unit:'°/s',label:'고관절 각속도'}, noGauge:true, lines:[
        {compute:function(t){return _dvel(t.series.Back_Hip_Angle_Y,t.meta.dt,-1);},color:'#46c98c',label:'내전 속도',width:2.2},
        {compute:function(t){return t.series.Back_Hip_Rot_Vel_X;},color:'#5bb6e6',label:'뒷고관절 회전 각속도',width:2.2}
      ]});
      return;
    }
    if(phaseKey==='drive' && m.key==='strideLen'){
      var _ev=(_WG.data&&_WG.data.fast&&_WG.data.fast.series)?_WG.data.fast.series.ev:null;
      var _dT=(_ev&&_ev.leadPk!=null&&_ev.rearPk!=null)?(_ev.leadPk-_ev.rearPk):null;
      var _NOGRF=(typeof DATA!=='undefined' && DATA.system && /Uplift/i.test(DATA.system));
      if(_NOGRF){ return; }  // [2026-05-26] Uplift: 스트라이드+COM 패널 삭제(교수 지시) — CoP/GRF 없고 COM속도 패널 제거
      html+='<div class="card" style="grid-column:1 / -1"><h3>스트라이드 (길이·방향·시간) <span class="sub2">발자국 위 CoP 궤적 + 체중이동(COM) · 스트라이드 길이/방향'+(_dT!=null?(' · 뒷발→앞발 수직력 피크 '+_dT+' ms'):'')+' · 옆: COM 전진 속도 변화 · 왼쪽 스틱 재생에 동기화</span></h3>'
        +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
        +'<canvas class="chart" id="dgcv-copgrf" style="flex:1 1 360px;min-width:320px;height:320px;display:block"></canvas>'
        +'<canvas class="chart" id="chph-drive-comvelstrip" style="flex:1 1 250px;min-width:230px;height:320px;display:block"></canvas>'
        +'</div></div>';
      charts.push({cid:'chph-drive-comvelstrip',cfg:_FC_SER['comVel'],m:{unit:'m/s',label:'COM 전진 속도',key:'comVel'},noGauge:true});
      return;
    }
    // ── 에너지 전달: 시퀀스/유형은 head에서 처리, 여기선 어깨+팔꿈치 파워 통합차트+팔 스틱 ──
    if(phaseKey==='transfer' && _WG.data){
      if(m.key==='elbAbs'||m.key==='seqPct'||m.key==='whipRatio'||m.key==='chainTiming'||m.key==='driveType'||m.key==='kneeExtE'||m.key==='kneeContribPct'||m.key==='kneeTrunkLag') return;
      if(m.key==='shGen'){
        var _ela=(stage.metrics||[]).filter(function(x){return x.key==='elbAbs';})[0];
        var _exA=(m.value!=null?('어깨 생성 '+m.value+'J'):'')+(_ela&&_ela.value!=null?(' · 팔꿈치 흡수 '+_ela.value+'J'):'');
        html+='<div class="card" style="grid-column:1 / -1"><h3>어깨 생성 + 팔꿈치 흡수 (관절 파워) <span class="sub2">한 그래프 · 어깨=가속 생성(+), 팔꿈치=감속 흡수(−) · 측면 팔 스틱</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-transfer-energy" style="flex:1 1 300px;min-width:280px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 투구팔(측면)</div><canvas id="tgcv-arm-ts" style="width:100%;height:220px;display:block"></canvas>'
          +'<div class="sub2" style="text-align:center;margin-top:4px">'+_exA+'</div></div>'
          +'</div></div>';
        charts.push({cid:'chph-transfer-energy', m:{unit:'W',label:'관절 파워'}, noGauge:true, lines:[
          {compute:function(t){return t.series.Pitching_Shoulder_Power_X;},color:'#46c98c',label:'어깨 파워(생성)',width:2.4},
          {compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#9aa7b6',label:'팔꿈치 파워(흡수)',width:2.4}
        ]});
        return;
      }
    }
    // ── 상체 가속: 회전속도 통합차트+3속도게이지 / ME 통합차트+수직바2 / 팔꿈치파워 스틱 ──
    if(phaseKey==='release' && _WG.data){
      if(m.key==='torsoRotV'||m.key==='armRotV'||m.key==='elbowExtV') return;  // 회전속도 통합차트로 흡수
      if(m.key==='humME') return;  // ME 통합차트로 흡수
      var _abs=function(s){return (s||[]).map(function(x){return isFinite(x)?Math.abs(x):x;});};
      if(m.key==='pelvisRotV'){
        function _segEvalCell(key,nmK){
          var mm=(stage.metrics||[]).filter(function(x){return x.key===key;})[0];
          if(!mm||mm.value==null) return '<div style="flex:1 1 30%;min-width:150px;font-size:12px">'+nmK+' —</div>';
          var s2=_bmStatusOf(mm); var lab=s2==='strong'?'강점':(s2==='flag'?'교정':(s2==='normal'?'정상':''));
          var col=s2?_bmStatusCol(s2):'var(--fg1)';
          var nm2=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[key]:null;
          var elite=nm2?(' <span class="sub2">엘리트 '+nm2.p25+'–'+nm2.p75+'</span>'):'';
          return '<div style="flex:1 1 30%;min-width:150px;font-size:12px">'+nmK+' <b>'+mm.value+'</b>°/s'+(lab?' <span style="color:'+col+';font-weight:700">'+lab+'</span>':'')+elite+'</div>';
        }
        var _segEval=_segEvalCell('pelvisRotV','골반')+_segEvalCell('torsoRotV','몸통')+_segEvalCell('armRotV','팔');
        html+='<div class="card" style="grid-column:1 / -1"><h3>회전 속도 사슬 (골반→몸통→팔) <span class="sub2">한 그래프 · 근위→원위 가속 순서 · 옆: 큰 속도 게이지 3개 · 아래: 분절별 평가</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-release-rot" style="flex:1 1 300px;min-width:280px"></canvas>'
          +'<div style="width:300px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">속도 게이지 — 골반·몸통·팔 (초록=엘리트)</div><canvas id="rgcv-speed3" style="width:100%;height:150px;display:block"></canvas></div>'
          +'</div>'
          +'<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;border-top:1px solid var(--bg3);padding-top:8px"><div style="flex:0 0 100%;font-size:11px;color:var(--fg2)">분절별 회전속도 평가 (엘리트 대비)</div>'+_segEval+'</div>'
          +'</div>';
        charts.push({cid:'chph-release-rot', m:{unit:'°/s',label:'회전 속도'}, noGauge:true, lines:[
          {compute:function(t){return _abs(t.series.Pelvis_Ang_Vel_Z);},color:'#6db4e6',label:'골반',width:2.2},
          {compute:function(t){return _abs(t.series.Thorax_Ang_Vel_Z);},color:'#5bb6e6',label:'몸통',width:2.2},
          {compute:function(t){return _abs(t.series.Pitching_Shoulder_Ang_Vel_Z);},color:'#46c98c',label:'팔',width:2.2}
        ]});
        return;
      }
      if(m.key==='trunkME'){
        html+='<div class="card" style="grid-column:1 / -1"><h3>분절 역학에너지 (몸통 + 상완) <span class="sub2">한 그래프 · 분절이 보유한 운동에너지(½mv²+½Iω²) — 몸통→상완으로 에너지가 차례로 전달·증폭되는지 봅니다. 옆 스틱은 해당 순간의 자세(몸통·상완 강조)</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-release-me" style="flex:1 1 300px;min-width:280px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 분절 에너지(측면·몸통+상완 강조)</div><canvas id="rgcv-me-ts" style="width:100%;height:220px;display:block"></canvas>'
          +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">몸통 <span style="font-size:18px;font-weight:800;color:#5bb6e6" id="rg-now-trunkme">–</span> · 상완 <span style="font-size:18px;font-weight:800;color:#e8954e" id="rg-now-humme">–</span> J</div>'
          +'<div class="sub2" style="text-align:center;margin-top:2px">엘리트 몸통 ~588J · 상완 ~207J</div></div>'
          +'</div></div>';
        charts.push({cid:'chph-release-me', m:{unit:'J',label:'분절 ME'}, noGauge:true, lines:[
          {compute:function(t){return t.series.Trunk_ME_X;},color:'#5bb6e6',label:'몸통 ME',width:2.4},
          {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#6db4e6',label:'상완 ME',width:2.4}
        ]});
        return;
      }
      if(m.key==='elbowP'){
        var _ep=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS.elbowP:null;
        var _epline=(m.value!=null?('정점 <b style="color:#f5c542">'+m.value+'</b> W'+(_ep?(' · 엘리트 '+_ep.p25+'–'+_ep.p75):'')):'');
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-release-elbp" style="flex:1 1 280px;min-width:260px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 팔꿈치 신전 파워(측면·투구팔)</div><canvas id="rgcv-elbowP-ts" style="width:100%;height:220px;display:block"></canvas>'
          +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:#f5c542" id="rg-now-elbowP">–</span> W</div>'
          +'<div class="sub2" style="text-align:center;margin-top:2px">'+_epline+'</div></div>'
          +'</div></div>';
        charts.push({cid:'chph-release-elbp', cfg:_FC_SER['elbowP'], lines:(_FC_SER['elbowP']?null:[{compute:function(t){return t.series.Pitching_Elbow_Power_X;},color:'#9aa7b6',label:m.label,width:2.4}]), m:m, noGauge:true});
        return;
      }
      if(m.key==='trunkFlexV'){  // 몸통 굴곡 속도 → 측면 스틱(몸통 강조) 게이지 (#1)
        var _tf=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS.trunkFlexV:null;
        var _tfl=(m.value!=null?('정점 <b style="color:#46c98c">'+m.value+'</b>°/s'+(_tf?(' · 엘리트 '+_tf.p25+'–'+_tf.p75):'')):'');
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-release-trunkflex" style="flex:1 1 280px;min-width:260px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 몸통 굴곡(측면·몸통 강조)</div><canvas id="rgcv-trunkflex-ts" style="width:100%;height:220px;display:block"></canvas>'
          +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:#46c98c" id="rg-now-trunkflex">–</span> °/s</div>'
          +'<div class="sub2" style="text-align:center;margin-top:2px">'+_tfl+'</div></div>'
          +'</div></div>';
        charts.push({cid:'chph-release-trunkflex', cfg:_FC_SER['trunkFlexV'], m:m, noGauge:true});
        return;
      }
    }
    // ── 에너지 저장: X-Factor·견갑골·몸통열림=탑뷰 / 어깨MER·몸통뒤젖힘=측면 스틱 게이지 ──
    if(phaseKey==='storage' && _WG.data){
      var _sg=_SG.GA.filter(function(g){return g.key===m.key;})[0];
      if(_sg){
        var _cidS='chph-storage-'+i, _scfn=null;
        if(m.key==='xfPeak')_scfn=function(t){return t.x_factor||null;};
        else if(m.key==='merPk')_scfn=function(t){return t.series.Pitching_Shoulder_Angle_Z||null;};
        else if(m.key==='scapLoad')_scfn=function(t){return (t.series.Pitching_Shoulder_Angle_X||[]).map(function(x){return isFinite(x)?Math.abs(x):x;});};
        else if(m.key==='leanBack')_scfn=function(t){return (t.series.Trunk_Angle_X||[]).map(function(x){return isFinite(x)?-x:x;});};
        else if(m.key==='openAng')_scfn=function(t){var R=((t.meta||{}).handedness||'R').toUpperCase()!=='L';return (t.series.Trunk_Angle_Z||[]).map(function(x){return isFinite(x)?(R?90-x:x-90):x;});};
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="'+_cidS+'" style="flex:1 1 280px;min-width:260px"></canvas>'
          +_sgGaugeColHTML(_sg)
          +'</div></div>';
        charts.push({cid:_cidS, lines:(_scfn?[{compute:_scfn,color:_sg.color,label:m.label,width:2.4}]:null), cfg:_FC_SER[m.key], m:m, noGauge:true});
        return;
      }
    }
    // ── 블로킹: 앞무릎/앞발 스틱 게이지로 교체 ──
    if(phaseKey==='blocking' && _WG.data){
      if(m.key==='kneeCollapse') return;  // 차트 삭제 — 신전 게이지에 숫자로 표시
      if(m.key==='apBrake') return;       // 수직 GRF 통합 차트로 흡수
      if(m.key==='comDecel') return;      // [2026-05-26] 제동 가속도는 COM KE 통합 차트(comKEdrop)로 흡수
      if(m.key==='leadKneeVelPk') return; // [2026-05-26] 앞무릎 각속도 peak는 첫 그래프(각도+각속도)에 흡수
      var _bg=_BG.GA.filter(function(g){return g.key===m.key;})[0];
      if(m.key==='leadGrf'){
        var _cidG='chph-blocking-grf';
        var _apb=(stage.metrics||[]).filter(function(x){return x.key==='apBrake';})[0];
        var _exG=_apb?('제동 GRF '+(_apb.value!=null?_apb.value+(_apb.unit||''):'–')):'';
        html+='<div class="card" style="grid-column:1 / -1"><h3>앞발 지면반력 (수직 + 제동) <span class="sub2">'+valTxt+statLine+' · 한 그래프에 수직·제동 · 스틱=합력 벡터</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="'+_cidG+'" style="flex:1 1 280px;min-width:260px"></canvas>'
          +(_bg?_bgGaugeColHTML(_bg,_exG):'')
          +'</div></div>';
        charts.push({cid:_cidG, m:{unit:'힘 (N)',label:'앞발 GRF'}, noGauge:true, lines:[
          {compute:function(t){return t.series.FP2_Z;},color:'#5bd3ff',label:'수직 GRF',width:2.4},
          {compute:function(t){return (t.series.FP2_Y||[]).map(function(x){return isFinite(x)?Math.abs(x):x;});},color:'#86a8d0',label:'제동 GRF',width:2.4}
        ]});
        return;
      }
      if(m.key==='comKEdrop'){
        var _cdm=(stage.metrics||[]).filter(function(x){return x.key==='comDecel';})[0];
        var _cdTxt=(_cdm&&_cdm.value!=null)?('제동 가속도 peak '+_cdm.value+' m/s²'):'';
        var _keTxt=(m.value!=null)?('COM KE 감소 '+m.value+' J'):'';
        var _wkg=((DATA&&DATA.player&&DATA.player.weight_kg)||86);
        html+='<div class="card" style="grid-column:1 / -1"><h3>COM 운동에너지 · 제동 가속도 <span class="sub2">'+[_keTxt,_cdTxt].filter(Boolean).join(' · ')+' · 한 그래프(좌축=KE J, 우축=가속도 m/s²) · 옆 스틱=앞다리 제동 자세 · 재생 동기화<br><b>해석:</b> 드라이브에서 COM 운동에너지가 쌓였다가 착지 직후 앞다리 제동으로 급강하합니다. 같은 순간 제동 가속도는 <b>음(−)</b>의 골(감속)로 가장 커집니다 — 두 곡선의 KE 급강하와 가속도 음의 골이 같은 시점에 맞물리면 선형 에너지가 효율적으로 회전으로 전환된 것입니다.</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="chph-blocking-comke" style="flex:1 1 300px;min-width:280px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">동적 스틱 — 앞다리 제동(측면)</div><canvas id="bgcv-comke-ts" style="width:100%;height:200px;display:block"></canvas></div>'
          +'</div></div>';
        charts.push({cid:'chph-blocking-comke', m:{unit:'J',label:'COM 운동에너지'}, noGauge:true, leftLabel:'COM KE (J)',
          lines:[{compute:function(t){return (t.series.COM_Velocity_Y||[]).map(function(v){return isFinite(v)?0.5*_wkg*v*v:v;});},color:'#5bb6e6',label:'COM 운동에너지',width:2.6}],
          right:{label:'가속도 (m/s²)',lines:[{compute:function(t){return _dvel(t.series.COM_Velocity_Y,t.meta.dt,1);},color:'#4a90c8',label:'제동 가속도(−=감속)',width:2.2}]}});
        return;
      }
      if(_bg){
        var _cid2='chph-blocking-'+i, _ex='';
        var _isKnee=(m.key==='kneeExtROM');
        var _kvpk=null;
        if(_isKnee){ var _c=(stage.metrics||[]).filter(function(x){return x.key==='kneeCollapse';})[0]; if(_c)_ex='굴곡 붕괴량 '+(_c.value!=null?_c.value+(_c.unit||''):'–');
          var _kv=(stage.metrics||[]).filter(function(x){return x.key==='leadKneeVelPk';})[0]; if(_kv&&_kv.value!=null)_kvpk=_kv.value; }
        // [2026-05-26] 블로킹 앞무릎: 굴곡 각도(좌축)와 각속도(우축)를 한 시계열에 함께 표시 + 각속도 peak 값 흡수(교수 지시)
        var _ksub=_isKnee?(valTxt+statLine+(_kvpk!=null?' · 각속도 peak '+_kvpk+'°/s':'')+' · 앞무릎 굴곡 <b>각도</b>(좌축)와 <b>각속도</b>(우축)를 한 그래프에. 착지 후 무릎이 더 굽으면(각도↑·각속도+) 붕괴, 단단히 버티거나 펴면 신전'):(valTxt+statLine+(m.note?' · '+m.note:''));
        var _kcol=_isKnee?(function(){var _c=(stage.metrics||[]).filter(function(x){return x.key==='kneeCollapse';})[0]; return (_c&&_c.value!=null)?_c.value:null;})():null;
        var _kexpl=_isKnee?('<div class="note" style="margin-top:8px"><b>앞무릎 붕괴량: '+(_kcol!=null?_kcol+'°':'–')+'</b> — 착지(FC) 이후 무릎이 추가로 굽은 최대량입니다(0=무붕괴). 붕괴량이 작을수록 앞다리가 단단히 버텨(블록) 선형 운동량을 회전으로 효율적으로 넘깁니다. 그래프에서 각속도가 양(+)으로 크게 튀며 각도가 더 굽으면 붕괴, 각속도가 음(−)으로 가며 각도가 펴지면 신전형입니다. 코호트 중앙 ~3.8°.</div>'):'';
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+(_isKnee?'앞무릎 굴곡 (각도 + 각속도)':m.label)+' <span class="sub2">'+_ksub+(_isKnee&&_kcol!=null?' · 붕괴량 '+_kcol+'°':'')+'</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="'+_cid2+'" style="flex:1 1 280px;min-width:260px"></canvas>'
          +_bgGaugeColHTML(_bg,_ex)
          +'</div>'+_kexpl+'</div>';
        var _kcfg=_FC_SER[m.key], _klines=null;
        if(!_kcfg&&m.key==='kneeAbs')_klines=[{compute:function(t){var R=((t.meta||{}).handedness||'R').toUpperCase()!=='L';return (R?t.series.L_Knee_Moment_X:t.series.R_Knee_Moment_X)||null;},color:_bg.color,label:m.label,width:2.4}];
        var _kright=_isKnee?{label:'각속도 (°/s)',lines:[{compute:function(t){return _dvel(t.series.Lead_Knee_Angle_X,t.meta.dt,1);},color:'#3ecf8e',label:'앞무릎 각속도',width:2.2}]}:undefined;
        var _klines2=_isKnee?[{compute:function(t){return t.series.Lead_Knee_Angle_X;},color:'#5bd3ff',label:'앞무릎 굴곡 각도',width:2.6}]:_klines;
        charts.push({cid:_cid2,cfg:(_isKnee?null:_kcfg),lines:_klines2,m:m,noGauge:true,right:_kright,leftLabel:(_isKnee?'무릎 각도 (°)':null)});
        return;
      }
    }
    // 임펄스: 별도 스틱 게이지 삭제 — 뒷발 추진 그래프 안에 면적(임펄스)+숫자로 표시
    if(phaseKey==='drive' && m.key==='propImpPct') return;
    // 뒷발 추진 GRF: 그래프(면적=임펄스) + 추진 게이지
    if(phaseKey==='drive' && m.key==='rearProp' && _WG.data){
      var _cidR='chph-drive-'+i;
      var _gR=_DG.GA.filter(function(g){return g.key==='rearProp';})[0];
      html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+' · 그래프 면적=추진 임펄스</span></h3>'
        +'<div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">'
        +'<canvas class="chart tall" id="'+_cidR+'" style="flex:1 1 280px;min-width:260px"></canvas>'
        +(_gR?_dgGaugeColHTML(_gR):'')
        +'</div></div>';
      charts.push({cid:_cidR,cfg:_FC_SER['rearProp'],m:m,noGauge:true,fillImpulse:true});
      return;
    }
    var cfg=_FC_SER[m.key];
    if(phaseKey==='consistency'&&(m.key==='strideLen'||m.key==='grfDelay'))cfg=null;  // S자 시계열 대신 아래 발자국 탑뷰로 (#4)
    if(cfg){ var cid='chph-'+phaseKey+'-'+i;
      var _wgG=(phaseKey==='windup'&&_WG.data)?(_WG.GA.filter(function(g){return g.key===m.key;})[0]):null;
      var _dgG=(phaseKey==='drive'&&_WG.data)?(_DG.GA.filter(function(g){return g.key===m.key;})[0]):null;
      var _gG=_wgG||_dgG;
      if(_gG){
        // 와인드업/드라이브 변인: 시계열 그래프 옆에 해부학 동적 게이지 배치
        var _isW=!!_wgG;
        var _gcap=(_gG.cap)?_gG.cap:(_isW?((m.key==='pelClose')?'동적 스틱 — 위에서 본 골반 닫힘':((m.key==='freeMo')?'동적 게이지 — 뒷발 꼬임 토크':'동적 스틱 — 측면 힙 힌지')):'동적 스틱');
        var _gcv=(_isW?'wgcv-':'dgcv-')+m.key+'-ts';
        var _nowId=(_isW?'wg-now-':'dg-now-')+m.key;
        var _gh=_isW?200:210;
        var _gfpk=_isW?((_WG.data.fast.vals||{})[m.key]):_DG.peak(m.key);
        var _gspk=_cmpActive()?(_isW?((_WG.data.slow&&_WG.data.slow.vals)?_WG.data.slow.vals[m.key]:null):_gaugeSlowPeak(m.key,_DG.i0,_DG.i1)):null;
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3>'
          +'<div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">'
          +'<canvas class="chart tall" id="'+cid+'" style="flex:1 1 280px;min-width:260px"></canvas>'
          +'<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">'+_gcap+'</div><canvas id="'+_gcv+'" style="width:100%;height:'+_gh+'px;display:block"></canvas>'
          +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:'+_gG.color+'" id="'+_nowId+'">–</span> '+(_gG.unit||'')+'</div>'
          +'<div class="sub2" style="text-align:center;margin-top:2px">빠른공 정점 <b style="color:'+_gG.color+'">'+(_gfpk!=null?_gfpk:'–')+'</b>'+(_gspk!=null?' · <b style="color:#9aa6b4">'+_cmpLabel()+' '+_gspk+'</b>':'')+(nm?' · 엘리트 '+nm.p25+'–'+nm.p75+' '+(_gG.unit||''):'')+'</div></div>'
          +'</div></div>';
        charts.push({cid:cid,cfg:cfg,m:m,noGauge:true});
      } else {
        html+='<div class="card" style="grid-column:1 / -1"><h3>'+m.label+' <span class="sub2">'+valTxt+statLine+(m.note?' · '+m.note:'')+'</span></h3><canvas class="chart tall" id="'+cid+'"></canvas></div>';
        charts.push({cid:cid,cfg:cfg,m:m});
      }
    } else {
      html+='<div class="card"><h3>'+m.label+'</h3><div style="font-size:20px;font-weight:800">'+valTxt+'</div><div style="margin-top:3px;font-size:11.5px">'+(statLine?statLine.replace(/^ · /,''):'<span style="color:var(--fg2)">규준 없음 · 값만</span>')+'</div>'+(m.note?'<div class="sub2" style="margin-top:3px">'+m.note+'</div>':'')+'</div>';
    }
  });
  if(phaseKey==='consistency'){
    // #3 — 릴리즈 포인트 + 암슬롯 시각화를 릴리즈/타이밍/암슬롯 일관성 카드 바로 아래(위)로 이동
    html+='<div class="card" style="grid-column:1 / -1"><h3>릴리즈 포인트 + 암슬롯 누적 산점도 <span class="sub2">모든 투구 · 어깨관절 공통원점 정렬 · 빠른 공(초록)/느린 공(빨강)/그 외(회색) · 선=암슬롯</span></h3>'
      +'<div class="two"><div><canvas class="chart tall" id="chcons-rel-home"></canvas></div><div><canvas class="chart tall" id="chcons-rel-3b"></canvas></div></div>'
      +'<div class="note" style="margin-top:6px">점=릴리즈 시 손끝 위치(어깨 기준), 선=어깨→손 벡터(암슬롯). 점·선이 모여 있을수록 릴리즈/암슬롯 반복성이 높습니다.</div></div>';
    // #4 — 스트라이드·체중이동 일관성 = 발자국 탑뷰 + 분산 타원
    html+=_strideScatterHTML();
    html+=_consHeatmapHTML();
    // #5 — 제구 평가를 동작 일관성 및 랩소도 탭 안으로 병합(별도 탭 제거)
    html+=_rapsodoConsHTML();
    html+=_commandHTML(true);
    html+='<div class="card" style="grid-column:1 / -1"><div class="note">동작 일관성은 투구 간 반복성(변동계수·표준편차) 지표입니다 — 트라이얼별 수치·변동은 Detail 탭에서 확인하세요.</div></div>';
  }
  _head+=_cmpToggleHTML();
  if(_cmpOn) _head+=_cmpTableHTML(phaseKey);
  // [2026-05-25] Uplift(동작 전용) ⑥ 에너지 전달: 분절 KE 시계열(몸통·상완) — GRF 불필요. 관절 파워 차트 대신 표시.
  if(phaseKey==='transfer' && stage && stage.kinematicOnly){
    html+='<div class="card" style="grid-column:1 / -1"><h3>분절 운동에너지 시계열 — 몸통·상완 <span class="sub2">½mv²+½Iω² (동작 기반 · GRF 불필요) · 근위(몸통)→원위(상완) 에너지 전달 흐름</span></h3>'
      +'<div class="note" style="margin:2px 0 8px">근위 분절(몸통)이 먼저 회전·가속해 만든 운동에너지가 채찍처럼 원위 분절(상완)로 넘어갑니다. <b>해석: ① 몸통 KE가 먼저 정점에 도달하고 그 뒤에 상완 KE가 정점</b>(파란선→보라선 순)이면 근위→원위 전달이 일어난 것. <b>② 상완 KE 정점이 몸통보다 크게 증폭</b>될수록 에너지가 손실 없이 잘 실린 것. 두 곡선이 거의 동시에 오르거나 상완 증폭이 약하면 전달이 끊겨 구속·효율 손실(에너지 누수)입니다.</div>'
      +'<canvas class="chart tall" id="chph-transfer-ke" style="width:100%"></canvas></div>';
    charts.push({cid:'chph-transfer-ke', m:{unit:'J',label:'분절 KE'}, noGauge:true, lines:[
      {compute:function(t){return t.series.Trunk_ME_X;},color:'#5bb6e6',label:'몸통 KE',width:2.4},
      {compute:function(t){return t.series.Pitching_Humerus_ME_X;},color:'#6db4e6',label:'상완 KE',width:2.4}
    ]});
  }
  // [2026-05-26] 릴리스 부근 손목 요측편향+굴곡 (전완·손끝 마커 기반 직접 운동학)
  if(phaseKey==='release'){
    html+='<div class="card" style="grid-column:1 / -1"><h3>손목 요측편향 + 굴곡 (릴리스 부근) <span class="sub2">전완(팔꿈치→손목)·손끝 마커 기반 — <b>굴곡</b>(손바닥 방향 +/배측 −)과 <b>요측편향</b>(엄지 방향 +/척측 −)을 한 그래프에. 릴리스 직전 손목 정렬·채찍 마무리 확인</span></h3>'
      +'<canvas class="chart tall" id="chph-release-wrist" style="width:100%"></canvas></div>';
    charts.push({cid:'chph-release-wrist', m:{unit:'°',label:'손목'}, noGauge:true, leftLabel:'각도 (°)',
      lines:[{compute:function(t){return _wristSer(t,'flex');},color:'#5bb6e6',label:'손목 굴곡(+굴곡/−신전)',width:2.4},
             {compute:function(t){return _wristSer(t,'rad');},color:'#4a90c8',label:'요측편향(+요측/−척측)',width:2.4}]});
  }
  html+=_phaseVarDetail(stage);
  cont.innerHTML=_head+html;
  _phaseCharts=charts;
  // [2026-05-26] 릴리스 IMU 추정 카드(손목 IMU·팔꿈치신전+어깨회전파워·어깨분리력) 완전 삭제(교수 지시).
  //   손목은 위의 전완·손끝 마커 기반 카드로 대체, 부상성 토크/관절력은 '부상 잠재' 탭으로 이동 완료.
  // [FIX 2026-05-25] ⑥ 에너지 전달: IMU 키네틱 체인 에너지 흐름 분석(분절 자이로 기반)
  try{ if(phaseKey==='transfer'){ var _bt2=(DATA.trials&&DATA.trials[(DATA.best_trial_index||1)-1])||(DATA.trials&&DATA.trials[0]); var _kc=(typeof _imuKineticChainHTML==='function')?_imuKineticChainHTML(_bt2):''; if(_kc){ var _tmp=document.createElement('div'); _tmp.innerHTML=_kc; if(_tmp.firstChild) cont.insertBefore(_tmp.firstChild, cont.firstChild); } } }catch(e){}
  // 각 차트 카드에 변인 설명(ⓘ 자세히) + 주요 시점 값 테이블(폴더형) 추가 — 분석가용
  try{ charts.forEach(function(ch){ if(!ch||!ch.cid)return; var cv=document.getElementById(ch.cid); if(!cv)return; var card=cv.closest?cv.closest('.card'):null; if(!card||card.querySelector('.varinfo,.evtbl'))return;
    var extra=_metricInfoHTML(ch.m||{})+_eventTableHTML(ch.m||{}, ch.cfg, ch.lines); if(!extra)return;
    var wrap=document.createElement('div'); wrap.className='card-extra'; wrap.innerHTML=extra; card.appendChild(wrap); }); }catch(e){}
  _curPhaseWin=_phaseWin[phaseKey]||{startEv:'i_fc',startOff:-0.3,endEv:'i_br',endOff:0.2};
  _redrawPhaseCharts();
  if(phaseKey==='consistency'){
    try{ _relScatter('chcons-rel-home',{ix:0,iy:1,xlabel:'좌우 (mm, 어깨기준)',ylabel:'높이 (mm, 어깨기준)',title:'홈플레이트 뷰 (정면) · 어깨관절 정렬'});
         _relScatter('chcons-rel-3b',  {ix:2,iy:1,xlabel:'전후 (mm, 어깨기준)',ylabel:'높이 (mm, 어깨기준)',title:'3루 뷰 (측면) · 어깨관절 정렬'}); }catch(e){}
    try{ _drawStrideScatter('cons-stride'); }catch(e){}
  }
  if(phaseKey==='windup' && _WG.data){ try{ _WG.start(); }catch(e){} }
  if(phaseKey==='drive' && _WG.data){ try{ _DG.start(); }catch(e){} }
  if(phaseKey==='blocking' && _WG.data){ try{ _BG.start(); }catch(e){} }
  if(phaseKey==='storage' && _WG.data){ try{ _SG.start(); }catch(e){} }
  if(phaseKey==='release' && _WG.data){ try{ _RG.start(); }catch(e){} }
  if(phaseKey==='transfer' && _WG.data){ try{ _TG.start(); }catch(e){} }
}
function _redrawPhaseCharts(){
  var fast=_fastTrial(), slow=_slowTrial(), W=_curPhaseWin;
  _phaseCharts.forEach(function(c){ plotWin(c.cid,{fast:fast,slow:slow,startEv:W.startEv,startOff:W.startOff,endEv:W.endEv,endOff:W.endOff,noGauge:c.noGauge,fillToZero:c.fillImpulse,
    left:{label:(c.leftLabel||c.m.unit||''),lines:c.lines||((c.cfg&&c.cfg.fn)?[{compute:c.cfg.fn,color:c.cfg.c,label:c.m.label,width:2.4}]:[])},
    right:c.right||undefined}); });
  // 와인드업 동적 스틱 게이지를 왼쪽 스틱 재생 프레임에 동기화(윈도우 페이지가 보일 때만)
  var _wp=document.getElementById('page-ph-windup');
  if(_WG.data && _wp && _wp.offsetParent!==null && document.getElementById('wgcv-pelClose-ts')){ try{ _WG.syncFrame(); }catch(e){} }
  var _dp=document.getElementById('page-ph-drive');
  if(_WG.data && _dp && _dp.offsetParent!==null && (document.getElementById('dgcv-copgrf')||document.getElementById('dgcv-hipAbd-ts'))){ try{ _DG.syncFrame(); }catch(e){} }
  var _bp=document.getElementById('page-ph-blocking');
  if(_WG.data && _bp && _bp.offsetParent!==null && (document.getElementById('bgcv-combar')||document.getElementById('bgcv-leadGrf-ts')||document.getElementById('bgcv-comke-ts'))){ try{ _BG.syncFrame(); }catch(e){} }
  var _sp=document.getElementById('page-ph-storage');
  if(_WG.data && _sp && _sp.offsetParent!==null && document.getElementById('sgcv-xfPeak-ts')){ try{ _SG.syncFrame(); }catch(e){} }
  var _rp=document.getElementById('page-ph-release');
  if(_WG.data && _rp && _rp.offsetParent!==null && (document.getElementById('rgcv-speed3')||document.getElementById('rgcv-me-ts')||document.getElementById('rgcv-elbowP-ts'))){ try{ _RG.syncFrame(); }catch(e){} }
  var _tp=document.getElementById('page-ph-transfer');
  if(_WG.data && _tp && _tp.offsetParent!==null && (document.getElementById('tgcv-knetype')||document.getElementById('tgcv-arm-ts'))){ try{ _TG.syncFrame(); }catch(e){} }
  // [2026-05-26] 좌우 밸런스·부상 잠재 탭 측면 스틱 게이지를 재생 프레임에 동기화
  var _balp=document.getElementById('page-ph-balance');
  if(_WG.data && _balp && _balp.offsetParent!==null && document.getElementById('bal-stick-gAbd')){ try{ _drawTabSticks([
    {cid:'bal-stick-gAbd',emph:'trunkarm',color:'#46c98c',view:'front'},
    {cid:'bal-stick-gElbFlex',emph:'arm',color:'#46c98c'},
    {cid:'bal-stick-shTilt',emph:'trunk',color:'#9aa7b6',view:'front'}]); }catch(e){} }
  var _injp=document.getElementById('page-injury');
  if(_WG.data && _injp && _injp.offsetParent!==null && document.getElementById('inj-stick-shoulderMoment')){ try{ _drawTabSticks([
    {cid:'inj-stick-shoulderMoment',emph:'arm',color:'#6db4e6'},
    {cid:'inj-stick-shoulderForce',emph:'arm',color:'#5fa6c0'},
    {cid:'inj-stick-elbowMoment',emph:'arm',color:'#5fa6c0'}]); }catch(e){} }
}
// [2026-05-26] 보조 탭(밸런스·부상)용 측면 스틱 — 현재 재생 프레임(빠른공 스틱)에 그림. _DG.drawSide 재사용.
function _drawTabSticks(specs){
  if(!_WG.data||!_WG.data.fast||!_WG.data.fast.series) return;
  var sk=_WG.data.fast.series.stick||[]; if(!sk.length) return;
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):(sk.length-1);
  var idx=Math.max(0,Math.min(sk.length-1,cf));
  specs.forEach(function(s){ if(document.getElementById(s.cid)){ try{ var _fn=(s.view==='front')?_DG.drawFront:_DG.drawSide; _fn({key:s.key||'aux',color:s.color||'#46c98c',emph:s.emph,lead:(s.lead!==false)},s.cid,idx); }catch(e){} } });
}
function _cpJumpBtn(mt){
  if(!mt.key) return '';
  if(typeof _FC_SER!=='undefined' && _FC_SER[mt.key]) return '<button class="cp-jump" onclick="_bmFocus(\''+mt.key+'\')"> 상세 설명</button>';
  var cons = (mt.stageKey==='consistency');
  var nav = cons ? (CONS_NAV[mt.key]||CONS_NAV._null) : (CP_NAV[mt.key]||null);
  if(!nav) return '';
  var label = cons ? ' 시각화 보기' : ' 시계열 보기';
  return '<button class="cp-jump" onclick="_goCp(\''+nav[0]+'\',\''+(nav[1]||'')+'\')">'+label+'</button>';
}

function buildPlayerMessage() {
  const dl = DATA.biomotion, hpa = DATA.hp_assessment, cmd = DATA.command, vs = DATA.velo_summary || {};
  const ph = DATA.phases || {};
  const k = v => (v==null||!isFinite(v)) ? '—' : v.toFixed(1);
  // ── 1) 핵심 지표 (요청 순서: 구속·회전수·구질·체력·메카닉) ──
  const mc = (lbl,val,sub,accent) => `<div class="pm-card" style="border-left:3px solid ${accent}"><div class="pm-lbl">${lbl}</div><div class="pm-val">${val}</div><div class="pm-sub">${sub||''}</div></div>`;
  let html = '<h3 style="margin-top:0">선수 종합 메시지</h3><div class="pm-grid">';
  html += mc('구속 (최고 / 평균)', `${k(vs.max_kmh)}<span class="pm-u"> km/h</span>`, `평균 ${k(vs.avg_kmh)} km/h`, 'var(--amber)');
  html += mc('회전수', `${vs.avg_spin ?? '—'}<span class="pm-u"> rpm</span>`, '평균 spin rate', 'var(--cyan)');
  html += mc('구질 (Rapsodo)', `${Object.keys((vs&&vs.pitch_types)||{}).join(', ')||'—'}`, `회전효율 ${vs.avg_eff ?? '—'}% · 회전축 ${vs.spin_dir ?? '—'}`, 'var(--green)');
  html += mc('체력 점수', `${hpa?.overall_score ?? '—'}<span class="pm-u"> /100 = 145km/h+</span>`, `6축 종합 (악력·최대힘·파워·반응성)`, 'var(--green)');
  const _bms2 = (typeof _bmSummary==='function') ? _bmSummary() : {strong:0,normal:0,flag:0};
  html += mc('메카닉', `<span style="font-size:18px">${_bmCountChip({strong:_bms2.strong,normal:_bms2.normal,flag:_bms2.flag})}</span>`, `엘리트 규준 띠 대비 · 점수 없이 위치로 판정`, 'var(--cyan)');
  // [2026-05-27] flying open — 메카닉 평가 핵심 지표(요약 기본 제시). 하체→몸통→팔 에너지 전달 효율의 대표 지표.
  (function(){
    var _fo=null,_xfpk=null,_xfFC=null;
    for(var _si=0;_si<(ph.stages||[]).length;_si++){ var _ms=ph.stages[_si].metrics||[];
      for(var _mi=0;_mi<_ms.length;_mi++){ var _m=_ms[_mi];
        if(_m.key==='xfReleasedPctByFC')_fo=_m; if(_m.key==='xfPeak')_xfpk=_m.value; if(_m.key==='xfPeakFromFC')_xfFC=_m.value; } }
    if(_fo && _fo.value!=null){
      var _acc=_fo.value>25?'var(--red)':(_fo.value>10?'var(--amber)':'var(--green)');
      var _st=_fo.value>25?'조기풀림(flying open)':(_fo.value>10?'경계':'정상');
      html += mc('flying open (FC 분리 풀림)', `${k(_fo.value)}<span class="pm-u"> %</span>`, `${_st} · 최대 X-Factor ${k(_xfpk)}°` + (_xfFC!=null?` · 풀림 ${_xfFC>0?'+':''}${_xfFC}ms`:''), _acc);
    }
  })();
  html += '</div>';
  html += (typeof _typeSolutions==='function') ? _typeSolutions() : '';

  // ── 2) 메카닉 보완 우선순위 (교정 상태 변인, 편차 큰 순) ──
  const _fzp = function(m){ var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null; return (nm&&m.value!=null&&m.dir)?_bmStat(m.value,nm,m.dir).z:0; };
  const faults = []; const _imuRef = [];
  // [FIX 2026-05-25] IMU 강점 운동학(각도·각속도·X-Factor)은 IMU가 가장 정확. Theia 규준과 정의·축이 달라
  // 교정 대상으로 단정하지 않고 '규준 참고'로 분리(IMU 리포트 한정). 사용자 방침: IMU 값 위주, 규준은 참고만.
  var _IMU_SYS = !!(DATA.system && /IMU/i.test(DATA.system));
  var _imuTrust = {xfPeak:1, pelClose:1, hipHinge:1, hipAbd:1, trunkFlexV:1, leanBack:1, scapLoad:1, openAng:1};
  for (const st of (ph.stages||[])) {
    for (const mt of (st.metrics||[])) {
      const bs = (typeof _bmStatusOf==='function')?_bmStatusOf(mt):null;
      const isFault = (bs==='flag') || (bs===null && (!!mt.warn || !!mt.cmpBad));
      if (mt.value==null) continue;
      if (_IMU_SYS && _imuTrust[mt.key]) { if (isFault) _imuRef.push({...mt, stageLabel:st.label, stageKey:st.key}); continue; }
      if (isFault) faults.push({...mt, stageLabel:st.label, stageKey:st.key});
    }
  }
  faults.sort((a,b)=> _fzp(a) - _fzp(b));
  _imuRef.sort((a,b)=> _fzp(a) - _fzp(b));
  html += '<div style="font-weight:700;color:var(--amber);margin:6px 0 6px">메카닉 체크 포인트 (전체) · 좌측 스틱과 함께 설명</div>';
  if (faults.length) {
    html += '<ol class="pm-pri">';
    for (const mt of faults) {
      const badge = `<span class="pm-pri-score score-low" style="color:var(--amber)">▼ 교정 ${_bmZ(_fzp(mt))}</span>`;
      const _mtR=(typeof _motionType==='function')?_motionType():null;
      const _minorTag=(_mtR&&_motionChainRole(mt.stageKey,_mtR.type)==='minor')?` <span style="color:#7d8898;font-size:11px">(유형상 부차)</span>`:'';
      html += `<li><div class="pm-pri-head"><b>${mt.label}</b> ${badge}${_minorTag} ${_cpJumpBtn(mt)}</div>
        <div class="pm-pri-val">${mt.stageLabel} · 현재 <b>${fmt1(mt.value)}${mt.unit||''}</b></div>
        <div class="pm-pri-tip">${mt.warn || mt.note || '코치와 함께 해당 동작 반복 교정'}</div></li>`;
    }
    html += '</ol>';
  } else html += '<div class="note">엘리트(145km/h+) 기준 대비 뚜렷한 체크 포인트가 없습니다.</div>';

  if (_imuRef.length) {
    html += '<div style="font-weight:700;color:var(--cyan);margin:12px 0 6px">IMU 직접측정 — 규준 참고 <span style="font-size:11px;color:var(--fg2);font-weight:400">(자이로·세그먼트 자세 기반, 신뢰 높음. Theia 마커리스 규준과 정의·축이 달라 z는 참고용 — 교정 대상으로 단정하지 않음)</span></div>';
    html += '<ol class="pm-pri">';
    for (const mt of _imuRef) {
      html += `<li><div class="pm-pri-head"><b>${mt.label}</b> <span class="pm-pri-score" style="color:var(--cyan)">규준 참고 ${_bmZ(_fzp(mt))}</span> ${_cpJumpBtn(mt)}</div>
        <div class="pm-pri-val">${mt.stageLabel} · 현재 <b>${fmt1(mt.value)}${mt.unit||''}</b> <span style="color:var(--fg2);font-size:11px">· IMU 직접측정</span></div></li>`;
    }
    html += '</ol>';
  }

  html += '<div style="font-size:11px;color:var(--fg2);margin-top:8px">※ 부상 위험은 [부상 위험] 탭, 라이브 게이지는 [코칭 메시지] 탭. 자가연습은 단독 수행용 가이드이며, 정밀 교정은 코치와 함께 진행하세요.</div>';
  return html;
}

// ── 메카닉 결함 라이브 게이지 (요약, 스틱 재생 동기화) ──
// phases metric.key → 순시 시계열 게이지 설정. abs=절대값, deriv=각도미분, arr=trial 직속배열, pctbw=force/bw*100
var DEFICIT_TS = {
  merPk:     {key:'Pitching_Shoulder_Angle_Z', abs:true, max:210,  elite:180,  unit:'°',   dec:0, accent:'#ff7a3c', label:'어깨 외회전'},
  xfPeak:    {arr:'x_factor',                   abs:true, max:75,   elite:49,   unit:'°',   dec:0, accent:'#f5c542', label:'X-Factor'},
  comVel:    {key:'COM_Velocity_Y',             abs:true, max:3.5,  elite:3.4,  unit:'m/s', dec:2, accent:'#3ecf8e', label:'COM 전진속도'},
  torsoRotV: {key:'Thorax_Ang_Vel_Z',           abs:true, max:1400, elite:1247, unit:'°/s', dec:0, accent:'#5bd3ff', label:'몸통 회전속도'},
  armRotV:   {key:'Pitching_Shoulder_Ang_Vel_Z',abs:true, max:5600, elite:5116, unit:'°/s', dec:0, accent:'#ff7a3c', label:'팔 회전속도'},
  elbowExtV: {key:'Pitching_Elbow_Ang_Vel_X',   abs:true, max:1500, elite:null, unit:'°/s', dec:0, accent:'#f5c542', label:'팔꿈치 신전속도'},
  trunkFlexV:{deriv:'Trunk_Angle_X', sign:1,    abs:true, max:600,  elite:450,  unit:'°/s', dec:0, accent:'#5bd3ff', label:'몸통 굴곡속도'},
  hipAbd:    {deriv:'Back_Hip_Angle_Y', sign:-1, abs:true, max:600, elite:null, unit:'°/s', dec:0, accent:'#5bd3ff', label:'뒷고관절 외전속도'},
  rearProp:  {key:'FP1_Y', pctbw:true,          abs:false,max:120,  elite:80,   unit:'%BW', dec:0, accent:'#3ecf8e', label:'뒷발 추진력'},
  leadGrf:   {key:'FP2_Z', pctbw:true,          abs:true, max:300,  elite:256,  unit:'%BW', dec:0, accent:'#5bd3ff', label:'앞발 수직GRF'}
};
function _sSeries(trial, g){
  var a;
  if (g.arr) a = trial[g.arr];
  else if (g.deriv) a = _dvel(trial.series[g.deriv], trial.meta.dt, g.sign||1);
  else a = trial.series[g.key];
  if (!a) return null;
  if (g.pctbw){ var bw=(trial.grf&&trial.grf.body_weight_N)||(((DATA.player&&DATA.player.weight_kg)||80)*9.81); a=a.map(function(v){return v/bw*100;}); }
  return a;
}
function _peakAbs(ser, trial){ if(!ser) return 0; var kl=trial.events.i_kl_peak||0, br=trial.events.i_br||(ser.length-1), m=0; for(var i=kl;i<=br&&i<ser.length;i++){var v=ser[i]; if(isFinite(v)&&Math.abs(v)>m)m=Math.abs(v);} return m; }
function _sGauge(g, peakVal, prefix){
  prefix=prefix||'sg-';
  var pp=_gXY(peakVal,g.max,71);
  var pkTxt=g.dec?(peakVal||0).toFixed(g.dec):Math.round(peakVal||0);
  var hasElite=(g.elite!=null&&isFinite(g.elite)), eliteTick='';
  if(hasElite){ var e1=_gXY(g.elite,g.max,78), e2=_gXY(g.elite,g.max,60); eliteTick='<line x1="'+e1[0].toFixed(1)+'" y1="'+e1[1].toFixed(1)+'" x2="'+e2[0].toFixed(1)+'" y2="'+e2[1].toFixed(1)+'" class="cg-elite"/>'; }
  var subHS=hasElite?(' · 엘리트 <b>'+g.elite+'</b>'):'';
  return '<div class="cg-card"><div class="cg-ttl">'+g.label+'</div>'+
    '<svg viewBox="0 0 180 100" class="cg-svg"><path d="M 12 90 A 78 78 0 0 1 168 90" class="cg-trk"/>'+eliteTick+
    '<circle id="'+prefix+g.id+'-pk" cx="'+pp[0].toFixed(1)+'" cy="'+pp[1].toFixed(1)+'" r="3.6" class="cg-pk"/>'+
    '<line id="'+prefix+g.id+'-ndl" x1="90" y1="90" x2="12" y2="90" class="cg-ndl" style="stroke:'+g.accent+'"/>'+
    '<circle cx="90" cy="90" r="5" class="cg-hub"/></svg>'+
    '<div class="cg-val" style="color:'+g.accent+'"><span id="'+prefix+g.id+'-v">—</span><span class="cg-u">'+g.unit+'</span></div>'+
    '<div class="cg-sub">peak <b>'+pkTxt+'</b>'+subHS+'</div></div>';
}
function _deficitList(){
  var ph=(typeof DATA!=='undefined'&&DATA.phases)?DATA.phases:{}, out=[];
  (ph.stages||[]).forEach(function(st){ if(st.key==='consistency') return;
    (st.metrics||[]).forEach(function(m){
      var bad=(m.score!=null && m.score<90) || (m.score==null && (m.warn || m.cmpBad));
      if(bad && m.value!=null) out.push({m:m, stage:st.label});
    });
  });
  return out;
}
function buildDeficitPanel(trial, prefix){ prefix=prefix||'sg-';
  var defs=_deficitList();
  if(!defs.length) return '<div class="note">엘리트(145km/h+) 기준 대비 뚜렷한 시계열 체크 포인트가 없습니다. 좋은 신호입니다.</div>';
  var gauges=[], cards=[];
  defs.forEach(function(d){ var cfg=DEFICIT_TS[d.m.key]; if(cfg){ gauges.push({d:d, g:Object.assign({id:d.m.key},cfg)}); } else { cards.push(d); } });
  var html='';
  if(gauges.length){ html+='<div class="cg-row" style="flex-wrap:wrap">'; gauges.forEach(function(x){ var ser=_sSeries(trial,x.g); html+=_sGauge(x.g,_peakAbs(ser,trial),prefix); }); html+='</div>'; }
  if(cards.length){ html+='<div class="sm-deficit-cards">'; cards.forEach(function(d){ var m=d.m; var tip=m.warn?(' '+m.warn):(m.score!=null?(m.score+'점 · 엘리트 미만'):'체크 포인트(빠른 공에서 악화)'); html+='<div class="pm-card" style="border-left:3px solid #e8731a"><div class="pm-lbl">'+m.label+'</div><div class="pm-val">'+(m.value!=null?m.value:'—')+'<span class="pm-u">'+(m.unit||'')+'</span></div><div class="pm-sub">'+tip+'</div></div>'; }); html+='</div>'; }
  html+='<div class="note" style="margin-top:8px">게이지 = 체크 포인트 관련 시계열 변수. 바늘=현재 프레임(스틱 재생과 동기화) · 점=이 투구 peak · 흰 눈금=엘리트(145km/h+). 카드 = 이벤트 시점 체크 포인트값.</div>';
  return html;
}
function updateDeficitGauges(trial, fi, prefix, containerId){ prefix=prefix||'sg-'; containerId=containerId||'sm-deficit';
  if(!trial || !document.getElementById(containerId)) return;
  _deficitList().forEach(function(d){ var cfg=DEFICIT_TS[d.m.key]; if(!cfg) return;
    var ser=_sSeries(trial,cfg); var v=(ser&&fi!=null&&fi<ser.length&&isFinite(ser[fi]))?(cfg.abs?Math.abs(ser[fi]):ser[fi]):0;
    var xy=_gXY(v,cfg.max,66); var ndl=document.getElementById(prefix+d.m.key+'-ndl'); if(ndl){ndl.setAttribute('x2',xy[0].toFixed(1));ndl.setAttribute('y2',xy[1].toFixed(1));}
    var ve=document.getElementById(prefix+d.m.key+'-v'); if(ve) ve.textContent=cfg.dec?v.toFixed(cfg.dec):Math.round(v);
  });
}

function renderSummary(trial) {
  const dl = DATA.biomotion;
  const vs = DATA.velo_summary || {};
  const svelo = document.getElementById('sm-velo');
  if (svelo) svelo.textContent = vs.max_kmh ?? fmt1(DATA.measured_kmh);
  const vsub = document.getElementById('sm-velo-sub');
  if (vsub) vsub.textContent = vs.avg_kmh ? `평균 ${vs.avg_kmh} · 회전 ${vs.avg_spin||'—'} rpm` : 'Rapsodo';
  const fit = document.getElementById('sm-fitness');
  if (fit) fit.textContent = (DATA.hp_assessment && DATA.hp_assessment.overall_score!=null) ? DATA.hp_assessment.overall_score : '—';
  const cmdEl = document.getElementById('sm-command');
  if (cmdEl) cmdEl.textContent = (DATA.command && DATA.command.score!=null) ? DATA.command.score : '—';
  const cmdSub = document.getElementById('sm-command-sub');
  if (cmdSub && DATA.command) {
    const c = DATA.command;
    cmdSub.textContent = (c.mech_consistency!=null)
      ? `동작일관성 ${c.mech_consistency} · 존 ${c.location_score} · 릴리즈SD ${c.release_sd_mm}mm`
      : `Strike ${c.strike_pct}% · ${c.n}구`;
  }
  const pm = document.getElementById('player-message');
  if (pm) pm.innerHTML = buildPlayerMessage();
  const scomp = document.getElementById('sm-composite');
  if (scomp) scomp.textContent = dl.composite_score ?? '—';
  const inj = DATA.injury_risk || {};
  const _ig = {danger:'#e5484d',caution:'#e8731a',normal:'#2f9e44',unavailable:'var(--fg2)'};
  const _il = {danger:'위험',caution:'주의',normal:'정상',unavailable:'—'};
  const _injEl = document.getElementById('sm-injury');
  if (_injEl) _injEl.innerHTML = (inj.metrics||[]).map(m=>`<div class="sm-card" style="border-top:3px solid ${_ig[m.grade]||'var(--fg2)'}"><div class="sm-lbl">${m.label.split(' (')[0]}</div><div class="sm-val">${m.value!=null?m.value:'—'}<span style="font-size:11px"> ${m.unit||''}</span></div><div style="font-size:11px;color:${_ig[m.grade]||'var(--fg2)'};font-weight:700">${_il[m.grade]||'—'}</div></div>`).join('') || '<div class="note">부상 위험 데이터 없음</div>';
  { const _rs=trial.rapsodo||{}; document.getElementById('trial-summary-tag').textContent =
    _rs.velocity_kmh ? `· ${_rs.velocity_kmh.toFixed(1)} km/h · ${_rs.total_spin_rpm?Math.round(_rs.total_spin_rpm)+' rpm':'회전수 —'}` : (DATA.measured_kmh ? `· 측정 최고 ${DATA.measured_kmh.toFixed(1)} km/h` : `· 구속 미측정`); }
  const _rm = trial.rapsodo || {};
  let _meta;
  if (_rm.velocity_kmh) {
    _meta = `${_rm.velocity_kmh.toFixed(1)} km/h · ${Math.round(_rm.total_spin_rpm)} rpm`;
    if (_rm.spin_eff!=null) _meta += ` · 효율 ${Math.round(_rm.spin_eff)}%`;
    if (_rm.spin_dir) _meta += ` · ${_rm.spin_dir}`;
    if (_rm.pitch_type) _meta += ` · ${_rm.pitch_type}`;
  } else _meta = `${trial.meta.n_frames} frames @ ${trial.meta.fps}Hz`;
  { const _tm = document.getElementById('trial-meta'); if (_tm) _tm.textContent = _meta; }
}

// ═══════════════════════════════════════════════════════════════════
// Render: COACH
// ═══════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════
// Coach: Statcast 스타일 라이브 게이지 대시보드 (재생 동기화)
// ═══════════════════════════════════════════════════════════════════
const COACH_GAUGES = [
  { id:'pelvis', label:'골반 회전', key:'Pelvis_Ang_Vel_Z',        max:800,  elite:510,  unit:'°/s', dec:0, accent:'#5bd3ff' },
  { id:'trunk',  label:'몸통 회전', key:'Thorax_Ang_Vel_Z',        max:1200, elite:900,  unit:'°/s', dec:0, accent:'#5bd3ff' },
  { id:'arm',    label:'팔 회전',   key:'Pitching_Hand_Ang_Vel_X', max:4500, elite:2700, unit:'°/s', dec:0, accent:'#ff7a3c' },
  { id:'com',    label:'COM 전진속도', key:'COM_Velocity_Y',       max:3.5,  elite:2.5,  unit:'m/s', dec:2, accent:'#3ecf8e' },
];
// 리포트별 게이지 재정의 (Uplift 는 팔 지표가 Theia 손속도와 달라 scale/기준 다름). elite:null → 기준선 없음.
if (DATA.coach_gauge_overrides) {
  for (const g of COACH_GAUGES) {
    const o = DATA.coach_gauge_overrides[g.id];
    if (o) Object.assign(g, o);
  }
}
function _gXY(v, max, R) {
  const f = Math.max(0, Math.min(1, Math.abs(v) / (max || 1)));
  const a = Math.PI * (1 - f);   // v=0 → π(왼쪽), v=max → 0(오른쪽)
  return [90 + R*Math.cos(a), 90 - R*Math.sin(a)];
}
function _gaugeSVG(g, peakVal) {
  const [px,py]   = _gXY(peakVal, g.max, 71);
  const pkTxt = g.dec ? peakVal.toFixed(g.dec) : Math.round(peakVal);
  const hasElite = (g.elite != null && isFinite(g.elite));
  let eliteTick = '';
  if (hasElite) {
    const [ex,ey]   = _gXY(g.elite, g.max, 78);
    const [ex2,ey2] = _gXY(g.elite, g.max, 60);
    eliteTick = `<line x1="${ex.toFixed(1)}" y1="${ey.toFixed(1)}" x2="${ex2.toFixed(1)}" y2="${ey2.toFixed(1)}" class="cg-elite"/>`;
  }
  const subHS = hasElite ? ` · HS <b>${g.elite}</b>` : '';
  return `<div class="cg-card">
    <div class="cg-ttl">${g.label}</div>
    <svg viewBox="0 0 180 100" class="cg-svg">
      <path d="M 12 90 A 78 78 0 0 1 168 90" class="cg-trk"/>
      ${eliteTick}
      <circle id="cg-${g.id}-pk" cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="3.6" class="cg-pk"/>
      <line id="cg-${g.id}-ndl" x1="90" y1="90" x2="12" y2="90" class="cg-ndl" style="stroke:${g.accent}"/>
      <circle cx="90" cy="90" r="5" class="cg-hub"/>
    </svg>
    <div class="cg-val" style="color:${g.accent}"><span id="cg-${g.id}-v">—</span><span class="cg-u">${g.unit}</span></div>
    <div class="cg-sub">peak <b>${pkTxt}</b>${subHS}</div>
  </div>`;
}
function renderCoach(trial) {
  trial = trial || DATA.trials[(DATA.best_trial_index||1)-1];
  var briefing=''; try{ briefing = coachBriefingHTML(); }catch(e){ briefing=''; }
  document.getElementById('coach-body').innerHTML = briefing;
}
function updateCoachGauges(trial, fi) {
  if (!trial || !document.getElementById('cg-pelvis-ndl')) return;
  const ser = trial.series || {}, ev = trial.events || {}, m = trial.meta || {};
  for (const g of COACH_GAUGES) {
    const arr = ser[g.key] || [];
    const v = (fi!=null && fi<arr.length && isFinite(arr[fi])) ? Math.abs(arr[fi]) : 0;
    const [x,y] = _gXY(v, g.max, 66);
    const ndl = document.getElementById('cg-'+g.id+'-ndl');
    if (ndl) { ndl.setAttribute('x2', x.toFixed(1)); ndl.setAttribute('y2', y.toFixed(1)); }
    const ve = document.getElementById('cg-'+g.id+'-v');
    if (ve) ve.textContent = g.dec ? v.toFixed(g.dec) : Math.round(v);
  }
  const bw = (trial.grf && trial.grf.body_weight_N) || ((DATA.player.weight_kg||80)*9.81);
  const bar = (id, key) => {
    const arr = ser[key] || [];
    const v = (fi!=null && fi<arr.length && isFinite(arr[fi])) ? Math.abs(arr[fi]) : 0;
    const pct = v / bw * 100;
    const el = document.getElementById(id); if (el) el.style.height = Math.min(100, pct/250*100).toFixed(0)+'%';
    const t = document.getElementById(id+'-v'); if (t) t.textContent = Math.round(pct);
  };
  bar('cg-grf-lead','FP2_Z'); bar('cg-grf-rear','FP1_Z');
  const ph = document.getElementById('cg-phase');
  if (ph) {
    const kl=ev.i_kl_peak, fc=ev.i_fc, mer=ev.i_mer, br=ev.i_br;
    let p='와인드업', c='var(--fg2)';
    if (br!=null && fi>=br) { p='릴리즈·감속'; c='var(--red)'; }
    else if (mer!=null && fi>=mer) { p='가속'; c='var(--amber)'; }
    else if (fc!=null && fi>=fc) { p='암코킹'; c='var(--cyan)'; }
    else if (kl!=null && fi>=kl) { p='드라이브'; c='var(--green)'; }
    ph.textContent = p; ph.style.color = c; ph.style.borderColor = c;
    ['fc','mer','br'].forEach(k => { const el=document.getElementById('cg-ev-'+k); if (el) el.classList.remove('on'); });
    let near=null, best=1e9;
    [['fc',fc],['mer',mer],['br',br]].forEach(([k,idx]) => { if (idx!=null && Math.abs(fi-idx)<best) { best=Math.abs(fi-idx); near=k; } });
    if (near && best<14) { const el=document.getElementById('cg-ev-'+near); if (el) el.classList.add('on'); }
  }
  const tm = document.getElementById('cg-time'); if (tm && m.dt) tm.textContent = (fi*m.dt).toFixed(3)+' s';
}

function coachBriefingHTML() {
  const ph = (typeof DATA!=='undefined' && DATA.phases) ? DATA.phases : {};
  const stages = (ph.stages||[]).filter(function(s){return !s.aux;});
  if(!stages.length) return '<div class="note">6단계 메카닉 데이터가 없습니다.</div>';
  const ms = mechPhaseSummary();
  const lbl = s => (s.label||'').replace(/^\d+\.\s*/,'');
  const _bms = _bmSummary();
  const _bSc = function(st){ var c=_bms.byStage[st.key]||{strong:0,flag:0}; return c.strong-c.flag; };
  const _bFl = function(st){ return (_bms.byStage[st.key]||{flag:0}).flag; };
  const strong = stages.length ? stages.reduce((a,s)=>_bSc(s)>_bSc(a)?s:a) : null;
  const weak   = stages.length ? stages.reduce((a,s)=>_bFl(s)>_bFl(a)?s:a) : null;
  const _fz = function(m){ var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null; return (nm&&m.value!=null&&m.dir)?_bmStat(m.value,nm,m.dir).z:0; };
  const STAGE_META = {
    storage:    {emoji:'', drills:[{ko:'허샤이저 드릴',en:'Hershiser',desc:'골반은 닫고 어깨만 더 열어 상·하체 분리(X-Factor)를 키운다.',cue:'골반 먼저, 어깨는 버텨'},{ko:'리버스 스로우',en:'Reverse Throw',desc:'착지 후 거꾸로 던지며 팔을 끝까지 뒤로 — 외회전·스캡로드 학습.',cue:'끝까지 뒤로'}]},
    drive:      {emoji:'', drills:[{ko:'슬라이드 스텝',en:'Slide Step',desc:'와인드업 없이 체중을 앞발로 빠르게 이동.',cue:'엉덩이 먼저 홈으로'},{ko:'워킹 와인드업',en:'Walking Wind-up',desc:'걸어 들어가며 추진 운동량을 만든다.',cue:'멈추지 말고 흘러'}]},
    blocking:   {emoji:'', drills:[{ko:'리드레그 브레이스',en:'Lead Leg Brace',desc:'착지 순간 앞무릎을 펴 강하게 제동.',cue:'앞벽을 친다'},{ko:'편측 스쿼트 5초 버티기',en:'Single-Leg Squat Hold',desc:'앞다리 무릎으로 제동력 강화.',cue:'흔들리지 않게'}]},
    release:    {emoji:'', drills:[{ko:'메드볼 사이드 토스',en:'Med-ball Side Toss',desc:'발→골반→몸통→팔 순서로 폭발적 회전.',cue:'아래에서 위로'},{ko:'카운터 무브',en:'Counter Move',desc:'머리는 뒤, 공은 앞 — 상·하체 분리 방출.',cue:'머리 남기고 던져'}]},
    transfer:   {emoji:'', drills:[{ko:'시퀀스 점프',en:'Sequence Jump',desc:'발→골반→몸통→팔 순으로 차오르는 타이밍 학습.',cue:'아래부터 차례로'},{ko:'메드볼 회전 던지기',en:'Rotational Med-ball',desc:'분절을 지날수록 빨라지는 채찍 패턴.',cue:'끝이 가장 빠르게'}]},
    consistency:{emoji:'', drills:[{ko:'동일 타겟 반복 릴리즈',en:'Target Repeat',desc:'같은 지점에 반복해 릴리즈 포인트를 고정.',cue:'같은 자리, 또 같은 자리'},{ko:'템포 메트로놈',en:'Tempo Metronome',desc:'일정 템포로 던져 타이밍 변동을 줄인다.',cue:'박자에 맞춰'}]}
  };
  let html = '';
  html += `<div class="coach-headline">`;
  html += `<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px">`;
  html += `<div><div style="font-size:11px;color:var(--fg2);text-transform:uppercase;letter-spacing:.4px;font-weight:700">코치용 종합 진단</div>`;
  html += `<div style="font-size:22px;font-weight:800">${DATA.player.name || ''} <span style="font-size:13px;color:var(--fg2);margin-left:6px">${DATA.player.name_en || ''}</span></div></div>`;
  html += `<div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.04);padding:8px 18px;border-radius:10px;border:1px solid var(--line)">`;
  html += `<span style="font-size:11px;color:var(--fg2);text-transform:uppercase">메카닉 종합 · 6단계</span>`;
  html += `<span style="font-size:17px;font-weight:800">${_bmCountChip({strong:_bms.strong,normal:_bms.normal,flag:_bms.flag})}</span>`;
  html += `</div></div>`;
  html += `<div class="coach-headline-grid">`;
  if(strong){ const e=(STAGE_META[strong.key]||{}).emoji||''; const c=_bms.byStage[strong.key]||{strong:0,flag:0}; html += `<div class="bm-ov-card strength"><div class="bm-ov-head">강점 단계</div><div class="bm-ov-body"><span class="bm-ov-main">${e} ${lbl(strong)}</span><span class="bm-ov-score" style="color:var(--green);font-weight:800">강점 ${c.strong}개</span></div></div>`; }
  if(weak){ const e=(STAGE_META[weak.key]||{}).emoji||''; const c=_bms.byStage[weak.key]||{strong:0,flag:0}; html += `<div class="bm-ov-card weakness"><div class="bm-ov-head">교정 우선 단계</div><div class="bm-ov-body"><span class="bm-ov-main">${e} ${lbl(weak)}</span><span class="bm-ov-score" style="color:var(--amber);font-weight:800">교정 ${c.flag}개</span></div></div>`; }
  html += `</div></div>`;

  const faults=[];
  stages.forEach(st=>{ (st.metrics||[]).forEach(mt=>{ var bs=_bmStatusOf(mt); const isFault=(bs==='flag')||(bs===null&&(!!mt.warn||!!mt.cmpBad)); if(isFault&&mt.value!=null) faults.push(Object.assign({}, mt, {stageKey:st.key, stageLabel:lbl(st)})); }); });
  faults.sort((a,b)=>_fz(a)-_fz(b));
  html += `<h3 style="font-size:14px;color:var(--fg0);border-bottom:2px solid var(--amber);padding-bottom:6px"> 메카닉 체크 포인트별 코칭 (전체 ${faults.length}개)</h3>`;
  if(!faults.length) html += `<div class="coach-strength">✓ 엘리트(145km/h+) 기준 대비 뚜렷한 체크 포인트가 없습니다.</div>`;
  faults.forEach((mt,idx)=>{
    const meta=STAGE_META[mt.stageKey]||{};
    const drills=(meta.drills||[]).map((d,i)=>`<div class="drill-card"><div class="drill-num">${i+1}</div><div><div class="drill-title">${d.ko} <span style="font-size:11px;color:var(--fg2);margin-left:4px">${d.en}</span></div><div class="drill-desc">${d.desc}</div><div class="drill-cue">큐: ${d.cue}</div></div></div>`).join('');
    const badge=`<span class="pri-score score-low" style="color:var(--amber)">▼ 교정 · 엘리트 대비 ${_bmZ(_fz(mt))}</span>`+(mt.warn?` <span class="pri-score score-low"> 경고</span>`:'');
    html += `<div class="priority-card"><div class="pri-head"><span class="pri-rank">#${idx+1}</span><span class="pri-emoji">${meta.emoji||''}</span><span class="pri-title">${mt.label}</span>${badge} ${_cpJumpBtn(mt)}</div>`;
    html += `<div class="pri-summary">${mt.stageLabel} 단계 · ${mt.warn||mt.note||''}</div>`;
    html += `<div class="pri-data"><div class="pri-data-head">측정 근거</div><div class="pri-met-row"><span class="pri-met-label">${mt.label}</span><span class="pri-met-vals"><strong>${fmt1(mt.value)}${mt.unit||''}</strong></span>${mt.score!=null?`<span class="pri-met-score ${scoreCls(mt.score)}">${mt.score}</span>`:''}</div></div>`;
    html += `<div class="pri-drills"><div class="pri-drills-head">코칭 팁 · 권장 드릴</div>${drills}</div></div>`;
  });

  if(strong) html += `<div class="coach-strength"><b>✓ 강점 유지 — ${lbl(strong)} (강점 ${(_bms.byStage[strong.key]||{strong:0}).strong}개)</b><br/>이 단계는 엘리트 규준 띠 안/상단에 안정적으로 위치합니다 — 현재 동작을 유지하며 교정 항목에 집중하세요.</div>`;
  html += `<div class="coach-cv-note"> 단일 trial 신뢰성: composite CV = <b>${DATA.composite_cv != null ? fmt1(DATA.composite_cv) : '1-2'}%</b> · 12구 일관 — 단일 trial 진단 신뢰 가능.</div>`;
  return html;
}

// ═══════════════════════════════════════════════════════════════════
// Render: BIOMOTION
// ═══════════════════════════════════════════════════════════════════
function _biomotionRadarSVG(dl) {
  const __et=(typeof DATA!=='undefined'&&DATA.energy_transfer&&DATA.energy_transfer.score!=null)?DATA.energy_transfer:null;
  const order = Object.keys(dl.models).concat(__et?['__energy']:[]);
  const _sc=(k)=>k==='__energy'?__et.score:dl.models[k].score;
  const SHORT={arm_action:'팔동작',posture:'자세',rotation:'회전',block:'블록',cog:'체중이동',__energy:'에너지 전달'};
  const _lbl=(k)=>SHORT[k]||((MODEL_INFO[k]||{}).ko)||(dl.models[k]?_ne(dl.models[k].label):k);
  const N=Math.max(5,order.length);
  const SZ=360, CX=SZ/2, CY=SZ/2+6, R=128, CAP=100;
  const ang=i=>-Math.PI/2+(2*Math.PI*i/N);
  const pt=(i,score)=>{ const r=Math.max(0,Math.min(CAP,score||0))/CAP*R; return [CX+r*Math.cos(ang(i)),CY+r*Math.sin(ang(i))]; };
  const rings=[25,50,75,100].map(lv=>{ const pts=order.map((_,i)=>pt(i,lv).map(v=>v.toFixed(1)).join(',')).join(' '); const hi=lv===100; return `<polygon points="${pts}" fill="none" stroke="${hi?'#5b6b82':'#2c3442'}" stroke-width="${hi?1.4:1}" ${hi?'':'stroke-dasharray="2 3"'}/>`; }).join('');
  const spokes=order.map((_,i)=>{ const [ex,ey]=pt(i,CAP); return `<line x1="${CX}" y1="${CY}" x2="${ex}" y2="${ey}" stroke="#2c3442"/>`; }).join('');
  const myPts=order.map((k,i)=>pt(i,_sc(k)||0).map(v=>v.toFixed(1)).join(',')).join(' ');
  const myPoly=`<polygon points="${myPts}" fill="rgba(232,140,46,0.30)" stroke="var(--amber)" stroke-width="2.5"/>`;
  const myDots=order.map((k,i)=>{ const sc=_sc(k); if(sc==null) return ''; const [px,py]=pt(i,sc); return `<circle cx="${px}" cy="${py}" r="4" fill="var(--amber)" stroke="#0b0d12" stroke-width="1"/>`; }).join('');
  const labels=order.map((k,i)=>{ const [lx,ly]=pt(i,CAP*1.16); const anchor=Math.abs(lx-CX)<6?'middle':(lx>CX?'start':'end'); const sc=_sc(k); return `<text x="${lx}" y="${ly}" text-anchor="${anchor}" font-size="11" font-weight="700" fill="#e8ecf2">${_lbl(k)}</text><text x="${lx}" y="${ly+13}" text-anchor="${anchor}" font-size="10" fill="#7d8898">${sc!=null?sc+'점':'—'}</text>`; }).join('');
  const comp=dl.composite_score;
  return `<svg viewBox="-70 -10 ${SZ+140} ${SZ+30}" width="100%" style="max-width:460px">${spokes}${rings}${myPoly}${myDots}${labels}<circle cx="${CX}" cy="${CY}" r="30" fill="var(--bg2)" stroke="var(--amber)" stroke-width="2"/><text x="${CX}" y="${CY-1}" text-anchor="middle" font-size="22" font-weight="800" fill="var(--amber)">${comp!=null?comp:'—'}</text><text x="${CX}" y="${CY+13}" text-anchor="middle" font-size="8.5" fill="#7d8898">메카닉 종합</text></svg>`;
}
// ── BioMotion 카드 디자인 (HS-Team-Dashboard 이식 · 검증 컬럼 제거 · Theia 전용) ──
function _dlScoreBadge(s){ if(s==null)return'na'; if(s>=95)return'high'; if(s>=80)return'mid'; return'low'; } /* [CALC-011] 점수는 100 상한이라 110은 도달 불가 → 95 */
function _dlMphCls(v){ if(v==null)return'na'; if(v>0.2)return'pos'; if(v<-0.2)return'neg'; return'neutral'; }
function _dlStatus(s){ if(s==null)return'unknown'; if(s>=95)return'high'; if(s>=80)return'mid'; return'low'; } /* [CALC-011] 110 도달 불가 → 95 */
function _dlBar(m){
  if(m.value==null) return '<div class="bm-pbar empty"><span class="bm-pbar-empty">— no data —</span></div>';
  const me=m.median_elite, per=m.per_1mph, lo=me-3*per, hi=me+3*per;
  const t=Math.max(0,Math.min(1,(m.value-lo)/(hi-lo)));
  return `<div class="bm-pbar status-${_dlStatus(m.score)}"><div class="bm-pbar-track"><div class="bm-pbar-zone bm-pbar-zone-mid"></div><div class="bm-pbar-tick bm-pbar-tick-p50"></div><div class="bm-pbar-marker" style="left:${(t*100).toFixed(1)}%"></div></div><div class="bm-pbar-axis"><span>${fmt1(lo)}</span><span class="mid">elite ${fmt1(me)}</span><span>${fmt1(hi)}</span></div></div>`;
}
function _dlMetricRow(m){
  const val = m.value==null ? '<span class="bm-val-na">—</span>' : `${fmt1(m.value)}<span class="bm-unit">${m.unit||''}</span>`;
  const mph = m.mph_contrib==null ? '<span class="bm-mph-na">—</span>' : `<span class="bm-mph ${_dlMphCls(m.mph_contrib)}">${m.mph_contrib>0?'+':''}${m.mph_contrib.toFixed(2)}</span>`;
  const impTag = `<span class="bm-imp bm-imp-${m.importance}">${m.importance}</span>`;
  return `<div class="bm-row"><div class="bm-row-label">${m.label} ${impTag}</div><div class="bm-row-value">${val}</div><div class="bm-row-bar">${_dlBar(m)}</div><div class="bm-row-mph">${mph} <span class="bm-mph-unit">mph</span></div><div class="bm-row-score bm-score-${_dlScoreBadge(m.score)}">${m.score ?? '—'}</div></div>`;
}
function _dlModelCard(m){
  const dl = DATA.biomotion;
  const isS = dl.strength_model===m.label, isW = dl.weakness_model===m.label;
  const corner = isS?'<span class="bm-corner strength">강점</span>':isW?'<span class="bm-corner weakness">최약</span>':'';
  const rows = m.metrics.map(_dlMetricRow).join('');
  return `<div class="bm-card"><div class="bm-card-head"><div class="bm-card-title"><span class="bm-card-name">${_ne(m.label)}</span><span class="bm-card-desc">${m.sub} · weight ${(m.weight*100).toFixed(0)}%</span></div><div class="bm-card-meta">${corner}<div class="bm-card-mph">${m.mph_contribution!=null?(m.mph_contribution>0?'+':'')+(m.mph_contribution*1.60934).toFixed(1)+' km/h':'—'}</div><div class="bm-card-score bm-score-${_dlScoreBadge(m.score)}">${m.score ?? '—'}</div></div></div><div class="bm-card-body"><div class="bm-row bm-row-header"><div class="bm-row-label">Metric</div><div class="bm-row-value">Player</div><div class="bm-row-bar">vs Elite Median (±3 mph window)</div><div class="bm-row-mph">+mph</div><div class="bm-row-score">Score</div></div>${rows}</div></div>`;
}
function _phaseShort(lbl){ return String(lbl).replace(/^[0-9]+\.\s*/,''); }
function _phaseRadarSVG(stages){
  var N=Math.max(5,stages.length), SZ=360, CX=SZ/2, CY=SZ/2+6, R=128, CAP=100;
  var ang=function(i){return -Math.PI/2+(2*Math.PI*i/N);};
  var pt=function(i,sc){var r=Math.max(0,Math.min(CAP,sc||0))/CAP*R;return [CX+r*Math.cos(ang(i)),CY+r*Math.sin(ang(i))];};
  var rings=[25,50,75,100].map(function(lv){var pts=stages.map(function(_,i){return pt(i,lv).map(function(v){return v.toFixed(1);}).join(',');}).join(' ');var hi=lv===100;return '<polygon points="'+pts+'" fill="none" stroke="'+(hi?'#5b6b82':'#2c3442')+'" stroke-width="'+(hi?1.4:1)+'" '+(hi?'':'stroke-dasharray="2 3"')+'/>';}).join('');
  var spokes=stages.map(function(_,i){var p=pt(i,CAP);return '<line x1="'+CX+'" y1="'+CY+'" x2="'+p[0].toFixed(1)+'" y2="'+p[1].toFixed(1)+'" stroke="#2c3442"/>';}).join('');
  var myPts=stages.map(function(st,i){return pt(i,st.score||0).map(function(v){return v.toFixed(1);}).join(',');}).join(' ');
  var myPoly='<polygon points="'+myPts+'" fill="rgba(232,140,46,0.30)" stroke="var(--amber)" stroke-width="2.5"/>';
  var myDots=stages.map(function(st,i){if(st.score==null)return '';var p=pt(i,st.score);return '<circle cx="'+p[0].toFixed(1)+'" cy="'+p[1].toFixed(1)+'" r="4" fill="var(--amber)" stroke="#0b0d12" stroke-width="1"/>';}).join('');
  var labels=stages.map(function(st,i){var p=pt(i,CAP*1.18);var an=Math.abs(p[0]-CX)<6?'middle':(p[0]>CX?'start':'end');return '<text x="'+p[0].toFixed(1)+'" y="'+p[1].toFixed(1)+'" text-anchor="'+an+'" font-size="11" font-weight="700" fill="#e8ecf2">'+_phaseShort(st.label)+'</text><text x="'+p[0].toFixed(1)+'" y="'+(p[1]+13).toFixed(1)+'" text-anchor="'+an+'" font-size="10" fill="#7d8898">'+(st.score!=null?st.score+'점':'—')+'</text>';}).join('');
  var ss=stages.filter(function(x){return x.score!=null;});
  var comp=ss.length?Math.round(ss.reduce(function(p,x){return p+x.score;},0)/ss.length):null;
  return '<svg viewBox="-70 -10 '+(SZ+140)+' '+(SZ+30)+'" width="100%" style="max-width:480px">'+spokes+rings+myPoly+myDots+labels+'<circle cx="'+CX+'" cy="'+CY+'" r="30" fill="var(--bg2)" stroke="var(--amber)" stroke-width="2"/><text x="'+CX+'" y="'+(CY-1)+'" text-anchor="middle" font-size="22" font-weight="800" fill="var(--amber)">'+(comp!=null?comp:'—')+'</text><text x="'+CX+'" y="'+(CY+13)+'" text-anchor="middle" font-size="8.5" fill="#7d8898">메카닉 종합</text></svg>';
}
function _cmpCell(m){
  if(m.fastV==null) return '<div class="bm-cmp-na">—</div>';
  var cls=m.cmpRaw?'cmp-neu':(m.cmpBad?'cmp-bad':(m.cmpGood?'cmp-good':'cmp-neu'));
  var dd=(m.cmpDelta>0?'+':'')+m.cmpDelta;
  return '<div class="bm-cmp '+cls+'">빠름 <b>'+m.fastV+'</b> <i>vs</i> 느림 <b>'+m.slowV+'</b> <span class="bm-cmp-d">Δ'+dd+'</span></div>';
}
// ── 엘리트 규준 (우수 투수 코호트 n=20 풀드 · 선수별 대표값=트라이얼 중앙값 → p25/중앙/p75) ──
// [2026-05-26] Normative_data 20명으로 재산출·교체. 신설 하지/상지 키네틱·좌우밸런스 키 포함.
//  ※ pelClose: 2026-05-26 골반 닫힘각(Pelvis_Angle_Z excursion)으로 복원·엘리트 재산출(29.2/36.6/61.6).
//  ※ 보존(엘리트 export로 산출 불가→기존 코호트값 유지):
//    apBrake(엘리트 AP 부호규약 상이), 에너지전달-gated(shGen·elbAbs·seqPct·whipRatio·chainTiming·
//    kneeExtE·kneeContribPct·kneeTrunkLag·humMEt — 본 산출 하네스에서 transfer 단계 미생성).
var BIOMOTION_NORMS=(typeof PITCH_NORMS!=='undefined'&&PITCH_NORMS)||{abdSym:{p25:-3.5,med:4.8,p75:14.5,n:20}, apBrake:{p25:106.3,med:121.7,p75:136.3,n:19}, armRotV:{p25:3889.4,med:4055,p75:4250.6,n:20}, armSlot:{p25:74.1,med:81.6,p75:89.7,n:20}, backHipMoment:{p25:176.4,med:284.5,p75:332.6,n:20}, backHipWork:{p25:28.3,med:52.7,p75:91.2,n:20}, backKneeFlex:{p25:47.8,med:51,p75:56.5,n:20}, chainTiming:{p25:40.1,med:72.8,p75:81.6,n:20}, comDecel:{p25:19.3,med:20.9,p75:23,n:20}, comKEdrop:{p25:208.7,med:231.2,p75:276.2,n:20}, comVel:{p25:2.6,med:2.7,p75:2.8,n:20}, counterAP:{p25:276.5,med:288.3,p75:301.9,n:20}, driveWork:{p25:31.8,med:122.5,p75:161.3,n:20}, elbAbs:{p25:19.5,med:25.6,p75:53.1,n:19}, elbowExtV:{p25:1906.5,med:2077.2,p75:2280.3,n:20}, elbowFlexAsym:{p25:9.7,med:17.4,p75:26.2,n:20}, elbowForce:{p25:1056.2,med:1099.2,p75:1178,n:20}, elbowMoment:{p25:126.4,med:140.9,p75:163.3,n:20}, elbowP:{p25:1097.8,med:1598.4,p75:2633.5,n:20}, freeMo:{p25:6.7,med:10.6,p75:15.6,n:20}, gAbd:{p25:72.4,med:77.7,p75:87.5,n:20}, gElbFlex:{p25:63.9,med:73.6,p75:81.2,n:20}, gHandH:{p25:-248.6,med:-198.4,p75:-168.9,n:20}, gloveHumME:{p25:61.3,med:65,p75:69.8,n:20}, glovePullV:{p25:1807.1,med:2362.3,p75:2981.1,n:20}, gloveShPow:{p25:481.3,med:525.2,p75:642.2,n:20}, grfDelay:{p25:253.1,med:295.5,p75:326.3,n:40}, hipAbd:{p25:197.7,med:228.6,p75:272.8,n:20}, hipHinge:{p25:19.2,med:26.9,p75:34.9,n:20}, humME:{p25:145.3,med:154.2,p75:172.1,n:20}, humMEt:{p25:147.9,med:155.7,p75:172.4,n:19}, kneeAbs:{p25:158.8,med:174.3,p75:223,n:20}, kneeAbsE:{p25:29.5,med:43.1,p75:52.2,n:20}, kneeCollapse:{p25:1.1,med:2.8,p75:6.5,n:20}, kneeContribPct:{p25:20.6,med:26.5,p75:38.7,n:20}, kneeExtE:{p25:9.7,med:16.2,p75:26,n:20}, kneeExtROM:{p25:6,med:15.2,p75:23,n:20}, kneeFlexSym:{p25:1.5,med:9.9,p75:11.6,n:20}, kneeTrunkLag:{p25:53.3,med:66.6,p75:100.8,n:20}, leadGrf:{p25:187.7,med:206.6,p75:217.9,n:20}, leadHipMoment:{p25:290.2,med:320.9,p75:393.4,n:20}, leadHipWork:{p25:12.2,med:14.7,p75:19.4,n:20}, leadKneeFlex:{p25:54.7,med:59.4,p75:63.3,n:20}, leadKneeForce:{p25:1612.7,med:1921.2,p75:1979,n:20}, leadKneeMoment:{p25:175.7,med:194.1,p75:249.9,n:20}, leanBack:{p25:0.1,med:2.6,p75:5.7,n:20}, merPk:{p25:179.1,med:184.8,p75:192.2,n:20}, openAng:{p25:4.5,med:11.3,p75:13.6,n:20}, pelClose:{p25:29.2,med:36.6,p75:61.6,n:20}, pelObliq:{p25:-0.3,med:2.5,p75:3.5,n:20}, pelvisRotV:{p25:583,med:636.5,p75:680,n:20}, propImpPct:{p25:22.9,med:23.8,p75:25.9,n:20}, rearProp:{p25:72.5,med:81.9,p75:89.5,n:20}, relTimingMs:{p25:133.2,med:157.3,p75:174,n:20}, scapLoad:{p25:56,med:62.8,p75:74.5,n:20}, seqPct:{p25:77.5,med:95,p75:100,n:20}, seqSpan:{p25:80,med:144.1,p75:170.2,n:20}, shAbdAsym:{p25:-2,med:3.5,p75:8.5,n:20}, shGen:{p25:22.6,med:28.8,p75:34.6,n:19}, shTilt:{p25:0.2,med:4,p75:5.9,n:20}, shoulderForce:{p25:1159.1,med:1233.5,p75:1296.6,n:20}, shoulderMoment:{p25:194.4,med:215.4,p75:251.8,n:20}, strideLen:{p25:80.7,med:82.9,p75:85.9,n:40}, torsoRotV:{p25:855.2,med:907,p75:976.7,n:20}, trunkFlexV:{p25:298.8,med:351.4,p75:381.6,n:20}, trunkLat:{p25:-7,med:-4.7,p75:-0.3,n:20}, trunkME:{p25:462.7,med:480.4,p75:515.9,n:20}, whipRatio:{p25:3,med:3.2,p75:3.7,n:20}, xfPeak:{p25:46.2,med:49.3,p75:54.8,n:20}, xfPeakFromFC:{p25:0,med:13,p75:23,n:20}, xfUnwindV:{p25:709,med:772,p75:853,n:20}, xfReleasedPctByFC:{p25:0,med:0,p75:8,n:20}, xfAtFC:{p25:43,med:47,p75:52,n:20}};
// [2026-05-26 통합] ends/stat/cdf는 pitch_norms.js(PITCH_STATS) 단일 출처로 위임. 미로드 시 동일식 폴백.
function _bmEnds(dir,p25,p75){ if(typeof PITCH_STATS!=='undefined')return PITCH_STATS.ends(dir,p25,p75); if(dir===-1)return{good:p25,bad:p75}; if(dir==='abs')return Math.abs(p75)>=Math.abs(p25)?{good:p75,bad:p25}:{good:p25,bad:p75}; return{good:p75,bad:p25}; }
function _bmStat(v,nm,dir){ if(typeof PITCH_STATS!=='undefined')return PITCH_STATS.stat(v,nm,dir); var e=_bmEnds(dir,nm.p25,nm.p75); var g=(v-e.bad)/((e.good-e.bad)||1); var st=g>=1?'strong':(g<=0?'flag':'normal'); var sig=Math.abs(nm.p75-nm.p25)/1.349||1; var rz=(v-nm.med)/sig; var gh=e.good>e.bad; return {e:e,g:g,status:st,z:rz*(gh?1:-1)}; }
function _bmZ(z){ return (z>=0?'+':'−')+Math.abs(z).toFixed(1)+'σ'; }
function _bmStatusCol(s){ return s==='strong'?'var(--green)':(s==='flag'?'var(--amber)':'var(--cyan)'); }
function _bmStatusGlyph(s){ return s==='strong'?'▲':(s==='flag'?'▼':'●'); }
var _BM_GID=0;
function _bmBandSVG(v,nm,dir,cmpV){
  var s=_bmStat(v,nm,dir), p25=nm.p25,med=nm.med,p75=nm.p75;
  var W=340,padL=14,padR=14,axisY=24;
  var span=Math.abs(p75-p25)||1, aMin=Math.min(p25,p75)-span*1.5, aMax=Math.max(p25,p75)+span*1.5;
  var X=function(x){return padL+(x-aMin)/((aMax-aMin)||1)*(W-padL-padR);};
  var lo=Math.min(p25,p75),hi=Math.max(p25,p75), li=s.e.good<s.e.bad, gid='bmg'+(_BM_GID++);
  var stops=li?'<stop offset="0" stop-color="var(--green)" stop-opacity=".5"/><stop offset="1" stop-color="var(--amber)" stop-opacity=".5"/>':'<stop offset="0" stop-color="var(--amber)" stop-opacity=".5"/><stop offset="1" stop-color="var(--green)" stop-opacity=".5"/>';
  var lL=li?'◀강점':'◀교정', rL=li?'교정▶':'강점▶', lC=li?'var(--green)':'var(--amber)', rC=li?'var(--amber)':'var(--green)';
  var col=_bmStatusCol(s.status), gl=_bmStatusGlyph(s.status);
  var bx=X(lo),bw=X(hi)-X(lo), mx=Math.max(padL+8,Math.min(W-padR-8,X(v)));
  var f=function(x){return (Math.round(x*10)/10);};
  // 비교(빠름-느림) 고스트 마커 + Δ — MODE-01
  var ghost='', dlt='';
  if(cmpV!=null && isFinite(cmpV)){
    var gx=Math.max(padL+8,Math.min(W-padR-8,X(cmpV)));
    ghost='<line x1="'+gx.toFixed(1)+'" y1="'+(axisY-9)+'" x2="'+gx.toFixed(1)+'" y2="'+(axisY+7)+'" stroke="var(--fg2)" stroke-width="1.4" stroke-dasharray="2 2"/>'
      +'<circle cx="'+gx.toFixed(1)+'" cy="'+axisY+'" r="4" fill="var(--bg1)" stroke="var(--fg2)" stroke-width="1.6"/>';
    var d=v-cmpV, gd=(dir==='abs')?(Math.abs(v)-Math.abs(cmpV)):((dir===-1?-1:1)*d);
    var dcol=Math.abs(d)<1e-9?'var(--fg2)':(gd>0?'var(--green)':'var(--amber)');
    var arr=Math.abs(d)<1e-9?'•':(d>0?'▲':'▼');
    dlt='<text x="'+(W/2)+'" y="9" text-anchor="middle" fill="'+dcol+'" style="font-size:11px;font-weight:800">'+arr+' Δ'+(d>0?'+':'')+f(d)+' <tspan fill="var(--fg2)" style="font-weight:600">vs 느림</tspan></text>';
  }
  return '<svg viewBox="0 0 '+W+' 54" preserveAspectRatio="none" style="width:100%;height:54px">'
    +'<defs><linearGradient id="'+gid+'" x1="0" x2="1">'+stops+'</linearGradient></defs>'
    +'<text x="'+padL+'" y="9" fill="'+lC+'" style="font-size:11px;font-weight:700">'+lL+'</text>'
    +(dlt||('<text x="'+(W-padR)+'" y="9" text-anchor="end" fill="'+rC+'" style="font-size:11px;font-weight:700">'+rL+'</text>'))
    +'<line x1="'+padL+'" y1="'+axisY+'" x2="'+(W-padR)+'" y2="'+axisY+'" stroke="var(--line)" stroke-width="1.4"/>'
    +'<rect x="'+bx.toFixed(1)+'" y="'+(axisY-4)+'" width="'+Math.max(2,bw).toFixed(1)+'" height="8" rx="4" fill="url(#'+gid+')"/>'
    +'<line x1="'+X(med).toFixed(1)+'" y1="'+(axisY-8)+'" x2="'+X(med).toFixed(1)+'" y2="'+(axisY+8)+'" stroke="var(--fg2)" stroke-width="1.4" stroke-dasharray="3 2"/>'
    +ghost
    +'<line x1="'+mx.toFixed(1)+'" y1="'+(axisY-11)+'" x2="'+mx.toFixed(1)+'" y2="'+(axisY+7)+'" stroke="'+col+'" stroke-width="2"/>'
    +'<text x="'+mx.toFixed(1)+'" y="'+(axisY-13)+'" text-anchor="middle" fill="'+col+'" style="font-size:11px;font-weight:800">'+gl+'</text>'
    +'<circle cx="'+mx.toFixed(1)+'" cy="'+axisY+'" r="4.5" fill="'+col+'" stroke="var(--bg2)" stroke-width="2"/>'
    +'<text x="'+X(p25).toFixed(1)+'" y="'+(axisY+19)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px">'+f(p25)+'</text>'
    +'<text x="'+X(med).toFixed(1)+'" y="'+(axisY+19)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px">'+f(med)+'</text>'
    +'<text x="'+X(p75).toFixed(1)+'" y="'+(axisY+19)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px">'+f(p75)+'</text>'
    +'<text x="'+X(p25).toFixed(1)+'" y="'+(axisY+27)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px;opacity:.65">p25</text>'
    +'<text x="'+X(med).toFixed(1)+'" y="'+(axisY+27)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px;opacity:.65">중앙</text>'
    +'<text x="'+X(p75).toFixed(1)+'" y="'+(axisY+27)+'" text-anchor="middle" fill="var(--fg2)" style="font-size:11px;opacity:.65">p75</text>'
    +'</svg>';
}
// ── 띠 상태(점수 미사용) 집계 헬퍼 ──
function _bmStatusOf(m){ if(!m||m.normNA||m.neutral||m.value==null||!m.key||!m.dir||typeof BIOMOTION_NORMS==='undefined')return null; var nm=BIOMOTION_NORMS[m.key]; if(!nm)return null; return _bmStat(m.value,nm,m.dir).status; }
function _bmSummary(){
  var P=(typeof DATA!=='undefined')?DATA.phases:null, S={strong:0,normal:0,flag:0,total:0,byStage:{},flagged:[]};
  if(!P||!P.stages) return S;
  P.stages.filter(function(st){return !st.aux;}).forEach(function(st){ var c={strong:0,normal:0,flag:0}; (st.metrics||[]).forEach(function(m){ var s=_bmStatusOf(m); if(!s)return; c[s]++; S[s]++; S.total++; if(s==='flag'){ var nm=BIOMOTION_NORMS[m.key]; S.flagged.push({m:m,stage:st,z:nm?_bmStat(m.value,nm,m.dir).z:0}); } }); S.byStage[st.key]=c; });
  S.flagged.sort(function(a,b){return a.z-b.z;});
  return S;
}
function _bmCountChip(c){ return '<span style="font-size:11.5px;font-weight:700"><span style="color:var(--green)">강점 '+c.strong+'</span> · <span style="color:var(--cyan)">정상 '+c.normal+'</span> · <span style="color:var(--amber)">교정 '+c.flag+'</span></span>'; }
// ── 엘리트 대비 백분위(0–100, 중앙=50) — 띠와 동일 z에서 정규분포 환산 ──
function _normCDF(z){ if(typeof PITCH_STATS!=='undefined')return PITCH_STATS.cdf(z); var t=1/(1+0.2316419*Math.abs(z)), d=0.3989423*Math.exp(-z*z/2); var p=d*t*(0.3193815+t*(-0.3565638+t*(1.781478+t*(-1.821256+t*1.330274)))); return z>0?1-p:p; }
function _bmPctl(m){ if(!m||m.normNA||m.value==null||!m.key||!m.dir||typeof BIOMOTION_NORMS==='undefined')return null; var nm=BIOMOTION_NORMS[m.key]; if(!nm)return null; return Math.round(Math.max(1,Math.min(99,_normCDF(_bmStat(m.value,nm,m.dir).z)*100))); }
function _bmStagePctl(st){ var ps=[]; (st.metrics||[]).forEach(function(m){ if(m.neutral)return; var p=_bmPctl(m); if(p!=null)ps.push(p); }); return ps.length?Math.round(ps.reduce(function(a,b){return a+b;},0)/ps.length):null; }
function _bmCompPctl(){ var P=(typeof DATA!=='undefined')?DATA.phases:null; if(!P||!P.stages)return null; var ps=[]; P.stages.forEach(function(st){ if(st.key==='consistency')return; (st.metrics||[]).forEach(function(m){ if(m.neutral)return; var p=_bmPctl(m); if(p!=null)ps.push(p); }); }); return ps.length?Math.round(ps.reduce(function(a,b){return a+b;},0)/ps.length):null; }
// ── 투구 동작 유형 분류 (드라이브-주도 vs 회전-주도, 임베드 코호트 규준 백분위 기반) ──
function _motionType(){
  var P=(typeof DATA!=='undefined')?DATA.phases:null; if(!P||!P.stages)return null;
  var byKey={}; P.stages.forEach(function(st){ if(st.key==='consistency')return; (st.metrics||[]).forEach(function(m){ if(m.key)byKey[m.key]=m; }); });  // 일관성 단계 제외: strideLen/grfDelay 키가 변동성(CV/SD) 값으로 덮이는 충돌 방지
  function avgPctl(keys){ var ps=[]; keys.forEach(function(k){ var m=byKey[k]; if(m){ var p=_bmPctl(m); if(p!=null)ps.push(p); } }); return ps.length?Math.round(ps.reduce(function(a,b){return a+b;},0)/ps.length):null; }
  var driveIdx=avgPctl(['comVel','driveWork','rearProp','strideLen']);   // 드라이브 지수(하체 선형 추진)
  var rotIdx=avgPctl(['pelvisRotV','torsoRotV','armRotV','xfPeak']);      // 회전 지수(골반·몸통·팔 회전 + 분리)
  if(driveIdx==null||rotIdx==null)return null;
  var diff=driveIdx-rotIdx, type=diff>=12?'드라이브-주도형':(diff<=-12?'회전-주도형':'균형형');
  return {type:type, driveIdx:driveIdx, rotIdx:rotIdx, diff:diff};
}
// 단계가 현재 유형의 핵심 체인인지 (core=핵심 평가 / minor=유형상 부차 / common=공통)
function _motionChainRole(stageKey, type){
  var drive=['drive'], rot=['storage','release','transfer'];
  if(!type||type==='균형형'){ return (drive.indexOf(stageKey)>=0||rot.indexOf(stageKey)>=0)?'core':'common'; }
  if(drive.indexOf(stageKey)>=0) return type==='드라이브-주도형'?'core':'minor';
  if(rot.indexOf(stageKey)>=0) return type==='회전-주도형'?'core':'minor';
  return 'common';
}
function _motionBanner(){
  var mt=_motionType(); if(!mt)return '';
  var col=mt.type==='드라이브-주도형'?'#5bb6e6':(mt.type==='회전-주도형'?'#c084fc':'#46c98c');
  var reason=mt.type==='드라이브-주도형'?'하체 선형 추진(전진속도·뒷다리 드라이브)에서 동력을 만드는 유형입니다. <b>드라이브 체인(② 드라이브)</b>을 핵심으로 평가하고, 회전 단계는 부차적으로 봅니다.'
    :mt.type==='회전-주도형'?'상체 회전(골반·몸통·팔 회전·분리)에서 동력을 만드는 유형입니다. <b>회전 체인(④ 저장·⑤ 상체가속·⑥ 전달)</b>을 핵심으로 평가하고, 드라이브 단계는 부차적으로 봅니다.'
    :'드라이브와 회전 동력이 균형적입니다(차이 '+mt.diff+'p). 두 체인을 모두 핵심으로 평가합니다.';
  return '<div class="card" style="margin-bottom:12px;border-left:5px solid '+col+'">'
    +'<div class="sub2" style="margin-bottom:3px">투구 동작 유형 <span style="font-size:11px">(엘리트 규준 백분위 기반)</span></div>'
    +'<div style="font-size:21px;font-weight:800;color:'+col+'">'+mt.type+'</div>'
    +'<div style="display:flex;gap:18px;margin:7px 0;font-size:12px;color:var(--fg1);flex-wrap:wrap"><span>드라이브 지수 <b style="color:#5bb6e6">'+mt.driveIdx+'p</b></span><span>회전 지수 <b style="color:#c084fc">'+mt.rotIdx+'p</b></span><span class="sub2">전진속도·드라이브일·추진·스트라이드 vs 골반·몸통·팔 회전·X-Factor 백분위 평균</span></div>'
    +'<div style="font-size:12.5px;color:var(--fg1);line-height:1.65">'+reason+'</div>'
    +'<div class="note" style="margin-top:6px">※ 두 유형 모두 유효한 엘리트 패턴 — 우열이 아니라 "어느 동력으로 던지는가"이며, 그 동력 체인의 결함을 우선 평가합니다. 각 단계 카드의 <b> 핵심 / 부차</b> 배지 참고.</div></div>';
}
// 투구 유형별 맞춤 솔루션: 핵심 체인 교정은 강조, 부차 체인 교정은 톤다운, 핵심 강점은 유지·활용
function _typeSolutions(){
  var P=(typeof DATA!=='undefined')?DATA.phases:null; if(!P||!P.stages)return ''; var mt=(typeof _motionType==='function')?_motionType():null; if(!mt)return '';
  var core=[], minor=[], strongCore=[];
  P.stages.forEach(function(st){ if(st.key==='consistency')return; var role=_motionChainRole(st.key, mt.type);
    (st.metrics||[]).forEach(function(m){ if(!m.key||m.normNA||m.neutral||m.value==null||!m.dir)return; var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null; if(!nm)return; var s=_bmStat(m.value,nm,m.dir); if(!s)return;
      if(s.status==='flag'){ (role==='minor'?minor:core).push(m.label); }
      else if(s.status==='strong'&&(role==='core'||role==='common')){ strongCore.push(m.label); } }); });
  var dt=null; var tr=P.stages.filter(function(s){return s.key==='transfer';})[0]; if(tr){ var dm=(tr.metrics||[]).filter(function(x){return x.key==='driveType';})[0]; if(dm)dt=dm.value; }
  var kneeSol=dt?(String(dt).indexOf('신전')>=0?'앞무릎 <b>신전형(밀어올리기·에너지 생성)</b> — 앞무릎을 펴며 만든 신전 에너지를 회전·릴리스로 잇는 패턴. 앞무릎 신전 타이밍·신전일 활용을 극대화하는 드릴 권장.':'앞무릎 <b>버팀-흡수형(강성 버팀)</b> — 굽은 앞다리 축으로 회전하며 흡수하는 패턴. 앞무릎 강성 버팀(붕괴 최소화)·선형→회전 전환 효율을 강조.'):'';
  var focus=mt.type==='드라이브-주도형'?'핵심 = 드라이브·블록 체인(스트라이드·뒷발 추진·신전일·COM 속도·앞발 제동). 회전 변인이 다소 낮아도 "약점"이 아니라 유형 특성일 수 있으니, 드라이브·블록 효율을 끝까지 끌어올리는 데 집중하세요.':mt.type==='회전-주도형'?'핵심 = 분리(X-Factor)·외회전·회전 속도 사슬·시퀀스. 드라이브 변인이 낮아도 부차적이며, 회전 가속·시퀀스 타이밍·채찍 효율 향상에 집중하세요.':'드라이브·회전 동력이 균형적 — 양 체인 모두 핵심. 더 낮은 쪽을 우선 보강하세요.';
  function chips(arr,col){ return arr.length?arr.map(function(l){return '<span style="display:inline-block;background:'+col+'22;color:'+col+';border:1px solid '+col+'66;border-radius:6px;padding:2px 8px;margin:2px;font-size:12px">'+l+'</span>';}).join(''):'<span class="sub2">해당 없음</span>'; }
  return '<div class="card" style="margin-bottom:12px"><h3>유형별 맞춤 솔루션 <span class="sub2">'+mt.type+' 기준 — 핵심 체인 우선 · 부차 체인 톤다운</span></h3>'
    +'<div style="font-size:12.5px;color:var(--fg1);line-height:1.6;margin:4px 0 10px">'+focus+'</div>'
    +'<div style="margin-bottom:8px"><div class="sub2" style="margin-bottom:3px">우선 향상 (핵심 체인 교정 변인)</div>'+chips(core,'#e8954e')+'</div>'
    +'<div style="margin-bottom:8px"><div class="sub2" style="margin-bottom:3px">유형 특성 — 부차(우선순위 낮음)</div>'+chips(minor,'#7d8898')+'</div>'
    +(strongCore.length?'<div style="margin-bottom:8px"><div class="sub2" style="margin-bottom:3px">유지·활용 (핵심 체인 강점)</div>'+chips(strongCore,'#46c98c')+'</div>':'')
    +(kneeSol?'<div class="note" style="margin-top:6px">'+kneeSol+'</div>':'')
    +'<div class="note" style="margin-top:4px">※ 유형은 우열이 아니라 동력 전략입니다. 부차 체인의 낮은 값은 결함이 아닐 수 있으니, 핵심 체인부터 개선하세요.</div></div>';
}
// ── 교정 우선순위 TOP 3 (엘리트 대비 편차 절댓값 상위 — design-handoff ISSUE-03) ──
function _bmPriorityTop3(){
  var s=_bmSummary(); if(!s||!s.flagged||!s.flagged.length) return '';
  var top=s.flagged.slice(0,3);  // flagged 는 z 오름차순(가장 음수=가장 큰 결함) 정렬됨
  var cards=top.map(function(f,i){
    var m=f.m, st=f.stage, nm=BIOMOTION_NORMS[m.key], unit=m.unit||'';
    var val=(m.value!=null)?m.value:'—';
    var note=_bmFlagNote(m,nm);
    return '<div class="bm-pri-card">'
      +'<div class="bm-pri-tag">'+(st.label||'')+' · #'+(i+1)+'</div>'
      +'<div class="bm-pri-name">'+m.label+'</div>'
      +'<div class="bm-pri-val"><span class="num">'+val+'<span class="u">'+unit+'</span></span><span class="bm-pri-z">'+_bmZ(f.z)+'</span></div>'
      +'<div class="bm-pri-note">'+note+'</div></div>';
  }).join('');
  return '<div class="card bm-pri-wrap"><div class="bm-pri-head">'
    +'<span class="bm-pri-kicker">교정 우선순위 TOP 3</span>'
    +'<span class="bm-pri-sub">엘리트 대비 편차(σ)가 가장 큰 변인 — 여기부터 손대면 됩니다</span></div>'
    +'<div class="bm-pri-grid">'+cards+'</div></div>';
}
// 교정 변인 한 줄 코칭 메모(중앙값 대비 방향 자동 생성)
function _bmFlagNote(m,nm){
  if(!nm||m.value==null) return '엘리트 정상 범위를 벗어남 — 우선 보강 필요';
  var goodHigh=(nm.p75>=nm.p25); var med=nm.med, u=m.unit||'';
  var lowGood='작을수록 강점', dir;
  // good 방향 판정: _bmEnds 와 동일 의미. value 가 bad 쪽이면 어디로 가야 하는지 안내
  var s=_bmStat(m.value,nm,m.dir);
  var toward=(s.e.good>=s.e.bad)?'↑ 높여야':'↓ 낮춰야';
  return '엘리트 중앙값 '+(Math.round(med*10)/10)+u+' 대비 '+toward+' 합니다';
}
// 단계 헤더 미니 분포 막대(강점·정상·교정 6px 스택 — ISSUE-06)
function _bmMiniBar(c){
  var tot=(c.strong+c.normal+c.flag)||1;
  return '<div class="bm-mini-bar" title="강점 '+c.strong+' · 정상 '+c.normal+' · 교정 '+c.flag+'">'
    +'<i style="width:'+(c.strong/tot*100)+'%;background:var(--green)"></i>'
    +'<i style="width:'+(c.normal/tot*100)+'%;background:var(--cyan)"></i>'
    +'<i style="width:'+(c.flag/tot*100)+'%;background:var(--amber)"></i></div>';
}
// "읽는 법" 시각 범례 (텍스트 문단 대체 — ISSUE-05)
function _bmReadLegend(){
  var g='<svg viewBox="0 0 60 14" width="60" height="14" style="display:block">';
  // 띠
  var band=g+'<defs><linearGradient id="lgz" x1="0" x2="1"><stop offset="0" stop-color="var(--amber)" stop-opacity=".5"/><stop offset="1" stop-color="var(--green)" stop-opacity=".5"/></linearGradient></defs><rect x="2" y="4" width="56" height="6" rx="3" fill="url(#lgz)"/></svg>';
  var medG=g+'<line x1="2" y1="7" x2="58" y2="7" stroke="var(--line)" stroke-width="1.4"/><line x1="30" y1="2" x2="30" y2="12" stroke="var(--fg2)" stroke-width="1.4" stroke-dasharray="3 2"/></svg>';
  var youG=g+'<line x1="2" y1="7" x2="58" y2="7" stroke="var(--line)" stroke-width="1.4"/><line x1="22" y1="2" x2="22" y2="12" stroke="var(--cyan)" stroke-width="2"/><circle cx="22" cy="7" r="3.5" fill="var(--cyan)" stroke="var(--bg2)" stroke-width="1.5"/></svg>';
  function cell(svg,t){ return '<div class="bm-leg-cell">'+svg+'<span>'+t+'</span></div>'; }
  var statusCell='<div class="bm-leg-cell"><div class="bm-leg-chips">'
    +'<span style="color:var(--green)">▲ 강점</span><span style="color:var(--cyan)">● 정상</span><span style="color:var(--amber)">▼ 교정</span></div>'
    +'<span>띠 기준 위치로 분류</span></div>';
  return '<div class="card bm-legend-card"><div class="bm-legend-grid">'
    +cell(band,'엘리트 25–75% 정상범위')
    +cell(medG,'점선 = 엘리트 중앙값')
    +cell(youG,'세로선·점 = 이 선수 값')
    +statusCell
    +'</div></div>';
}
// ── sticky 페이즈 내비게이션 (점프 + 교정 카운트 배지 + 교정만 필터 — ISSUE-04) ──
function _bmPhaseNav(){
  var P=(typeof DATA!=='undefined')?DATA.phases:null; if(!P||!P.stages||!P.stages.length) return '';
  var s=_bmSummary();
  var chips=P.stages.filter(function(st){return !st.aux;}).map(function(st){
    var c=s.byStage[st.key]||{flag:0};
    var badge=(c.flag>0)?'<span class="bm-nav-badge">'+c.flag+'</span>':'';
    return '<button class="bm-nav-chip" onclick="_bmJump(\'bmph-'+st.key+'\')">'+st.label+badge+'</button>';
  }).join('');
  return '<div class="bm-phase-nav"><div class="bm-nav-chips">'+chips+'</div>'
    +'<button id="bm-filter-flag" class="bm-nav-filter" onclick="_bmFilterFlag(this)">교정만 보기</button></div>';
}
function _bmJump(id){ var el=document.getElementById(id); if(!el)return; var y=el.getBoundingClientRect().top+window.pageYOffset-150; window.scrollTo({top:y,behavior:'smooth'}); }
function _bmFilterFlag(btn){ var b=document.getElementById('bm-body'); if(!b)return; var on=b.classList.toggle('bm-filter-flag'); if(btn){ btn.classList.toggle('on',on); btn.textContent=on?'전체 보기':'교정만 보기'; } }
function _bmTallyBar(){
  var s=_bmSummary(), tot=(s.strong+s.normal+s.flag)||1;
  var bar='<div style="height:9px;border-radius:999px;overflow:hidden;display:flex;background:var(--bg2);margin-top:8px">'
    +'<i style="display:block;height:100%;width:'+(s.strong/tot*100)+'%;background:var(--green)"></i>'
    +'<i style="display:block;height:100%;width:'+(s.normal/tot*100)+'%;background:var(--cyan)"></i>'
    +'<i style="display:block;height:100%;width:'+(s.flag/tot*100)+'%;background:var(--amber)"></i></div>';
  return '<div class="card" style="margin-bottom:12px"><div style="display:flex;gap:22px;flex-wrap:wrap;align-items:baseline">'
    +'<div><span style="font-size:26px;font-weight:800;color:var(--green)">'+s.strong+'</span> <span style="font-size:12px;color:var(--fg2)">강점</span></div>'
    +'<div><span style="font-size:26px;font-weight:800;color:var(--cyan)">'+s.normal+'</span> <span style="font-size:12px;color:var(--fg2)">정상</span></div>'
    +'<div><span style="font-size:26px;font-weight:800;color:var(--amber)">'+s.flag+'</span> <span style="font-size:12px;color:var(--fg2)">교정 대상</span></div>'
    +'<div style="margin-left:auto;font-size:11px;color:var(--fg2)">엘리트 규준 코호트(n=19) 25–75% 띠 대비 · 점수 없이 위치로 판정</div></div>'+bar+'</div>';
}
function _phaseHdr(){ return '<div class="bm-row bm-row-header"><div class="bm-row-label">변인</div><div class="bm-row-value">측정값 · 편차</div><div class="bm-row-bar">엘리트 25–75% 규준 대비</div><div class="bm-row-mph"></div><div class="bm-row-score">상세</div></div>'; }
// ── 분석가용 변인 문서: 각 변인 산출방법(채널·구간). 판단기준은 규준에서 자동, 해석은 note 활용 (C) ──
var _VAR_DOC={
  pelClose:'셋업 대비 KH 시점 골반 회전각(Pelvis_Angle_Z) 변화량 = 홈 반대로 닫힌 양',
  freeMo:'뒷발 지면반력 자유모멘트(FP1_Z) KH 이전 최대 |peak|',
  hipHinge:'뒷고관절 굴곡각(Back_Hip_Angle_X) KH~FC 최대',
  xfPeak:'골반선·어깨선 수평면 분리각(X-Factor) KH→BR peak',
  xfPeakFromFC:'최대 X-Factor 시점 − FC (ms, 음수=조기 풀림/flying open)',
  xfUnwindV:'peak 이후 X-Factor 풀림 최대 각속도(°/s)',
  xfReleasedPctByFC:'flying open — FC까지 풀린 비율(%, 최대 분리 대비)',
  xfAtFC:'FC 시 X-Factor(°)',
  openAng:'FC 시점 몸통 열림(90−Trunk_Angle_Z)',
  leanBack:'몸통 측면 뒤젖힘(−Trunk_Angle_X) peak',
  scapLoad:'견갑 로딩(|Pitching_Shoulder_Angle_X|) FC 부근',
  merPk:'어깨 최대외회전(Pitching_Shoulder_Angle_Z) peak',
  rearProp:'뒷발 수직 GRF/체중(FP1_Y) peak, %BW',
  propImpPct:'KH~FC 뒷발 추진 임펄스 비율(∫FP1_Y/BW)',
  comVel:'COM 전진 속도(COM_Velocity_Y) peak, m/s',
  hipAbd:'뒷고관절 외전 각속도(d Back_Hip_Angle_Y/dt) peak',
  grfDelay:'뒷발→앞발 수직 GRF peak 간격(ms)',
  strideLen:'뒷발~앞발 착지 거리 ÷ 키 ×100, %키',
  driveWork:'KH~FC 뒷고관절+무릎 양(+)의 일 합(∫P·dt), J',
  kneeAbsE:'앞무릎 흡수 에너지(Lead_Knee_Power 음수 적분), J',
  comKEdrop:'FC~릴리스 COM 운동에너지 감소량, J',
  pelvisRotV:'골반 회전 각속도(Pelvis_Ang_Vel_Z) FC~BR peak',
  leadGrf:'앞발 수직 GRF/체중(FP2_Z) peak, %BW',
  comDecel:'FC 이후 COM 전진속도 음의 기울기(감속) peak',
  kneeAbs:'앞무릎 모멘트(Lead Knee_Moment_X) peak',
  kneeCollapse:'FC~릴리스 앞무릎 굴곡 증가량(붕괴), °',
  apBrake:'앞발 전후(AP) 제동력(|FP2_Y|) peak, %BW',
  kneeExtROM:'FC~릴리스 앞무릎 신전 가동범위, °',
  kneeExtE:'앞무릎 신전 양(+)의 일(Lead_Knee_Power+ 적분), J',
  kneeContribPct:'앞무릎 신전 일 ÷ 하체 전체 일 ×100, %',
  kneeTrunkLag:'앞무릎 신전 peak ~ 몸통 회전 peak 지연, ms',
  seqPct:'골반→몸통→팔 peak 순서가 맞는 투구 비율, %',
  whipRatio:'팔 회전 peak ÷ 몸통 회전 peak (채찍 증폭비)',
  chainTiming:'근위→원위 peak 지연이 적정 구간(15~120ms)인 비율, %',
  trunkFlexV:'몸통 시상면 굴곡 각속도(d Trunk_Angle_X/dt) peak',
  trunkME:'몸통 분절 역학에너지(Trunk_ME_X) peak, J',
  torsoRotV:'흉곽 회전 각속도(Thorax_Ang_Vel_Z) peak',
  armRotV:'어깨 내회전 각속도(Pitching_Shoulder_Ang_Vel_Z) peak',
  humME:'상완 분절 역학에너지(Pitching_Humerus_ME_X) peak, J',
  elbowExtV:'전완 신전 각속도(Pitching_Elbow_Ang_Vel_X) peak — 전완 기준',
  elbowP:'팔꿈치 신전 관절파워(Pitching_Elbow_Power_X) |peak|, W',
  shGen:'어깨 생성 에너지(Pitching_Shoulder_Power+ 적분), J',
  elbAbs:'팔꿈치 흡수 에너지(Pitching_Elbow_Power− 적분), J'
};
function _dirDoc(d){ return d===-1?'작을수록 강점(↓)':(d==='abs'?'절댓값 클수록 강점':'클수록 강점(↑)'); }
function _metricInfoHTML(m){
  if(!m||!m.key) return '';
  var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[m.key]:null;
  var calc=(_VAR_DOC[m.key])||m.note||'—';
  var u=m.unit||'';
  var crit = (nm&&!m.normNA) ? ('엘리트 규준(n='+(nm.n||'·')+') p25–p75 <b>'+nm.p25+'–'+nm.p75+'</b> · 중앙 '+nm.med+u+' · '+_dirDoc(m.dir)) : '규준 없음 — 값만 표시(판정 안 함)';
  var interp=m.note||'';
  return '<details class="varinfo"><summary>자세히</summary>'
    +'<div class="vi-row"><b>산출</b> '+calc+'</div>'
    +'<div class="vi-row"><b>판단 기준</b> '+crit+'</div>'
    +(interp?'<div class="vi-row"><b>해석</b> '+interp+'</div>':'')
    +'<div class="vi-row vi-note">상태 판정: 띠(엘리트 p25–p75) 안=정상, 강점쪽 벗어남=강점, 교정쪽 벗어남=교정. σ=중앙 대비 표준화 편차.</div></details>';
}
// ── 그래프 아래 주요 시점별 값 테이블(폴더형) — KH/FC/MER/BR 시점의 변인 값 ──
function _eventTableHTML(m, cfg, lines){
  var ft=(typeof _fastTrial==='function')?_fastTrial():null; if(!ft||!ft.events)return '';
  var dt=(ft.meta&&ft.meta.dt)||0.00333, ev=ft.events;
  var EVS=[['셋업/KH','i_kl_peak'],['착지 FC','i_fc'],['최대외회전 MER','i_mer'],['릴리스 BR','i_br']];
  var cols=[];
  if(lines&&lines.length){ lines.forEach(function(l){ if(l&&l.compute)cols.push({label:l.label||(m&&m.label)||'값', arr:l.compute(ft)}); }); }
  else { var fn=(cfg&&cfg.fn)?cfg.fn:null; cols.push({label:(m&&m.label)||'값', arr:(fn?fn(ft):null)}); }
  cols=cols.filter(function(co){return co.arr&&co.arr.length;}); if(!cols.length)return '';
  function sval(a,i){ if(i==null||i<0||i>=a.length)return null; var v=a[i]; return (v==null||!isFinite(v))?null:Math.round(v*10)/10; }
  var klRef=(ev.i_kl_peak!=null)?ev.i_kl_peak:(ev.i_fc!=null?ev.i_fc:0), rows='';
  EVS.forEach(function(e){ var idx=ev[e[1]]; if(idx==null)return; var tms=Math.round((idx-klRef)*dt*1000);
    var tds=cols.map(function(co){var v=sval(co.arr,idx);return '<td style="text-align:right;font-weight:700">'+(v==null?'–':v)+'</td>';}).join('');
    rows+='<tr><td>'+e[0]+'</td><td style="text-align:right;color:var(--fg2)">'+(tms>0?'+':'')+tms+'ms</td>'+tds+'</tr>'; });
  if(!rows)return '';
  var u=(m&&m.unit)?(' ('+m.unit+')'):'';
  var hd=cols.map(function(co){return '<th style="text-align:right">'+co.label+(cols.length===1?u:'')+'</th>';}).join('');
  return '<details class="evtbl"><summary>주요 시점 값</summary><table class="ev-table" style="margin-top:6px;font-size:11.5px"><thead><tr><th>시점</th><th style="text-align:right">KH 대비</th>'+hd+'</tr></thead><tbody>'+rows+'</tbody></table></details>';
}
function _phaseCard(st){
  var rows=(st.metrics||[]).map(function(m){
    var nm = (m.key && typeof BIOMOTION_NORMS!=='undefined') ? BIOMOTION_NORMS[m.key] : null;
    var btn = _cpJumpBtn(Object.assign({stageKey:st.key}, m));
    var lab = '<div class="bm-row-label">'+m.label+'<div style="font-size:11px;color:var(--fg2)">'+(m.note||'')+'</div>'+(m.warn?'<div style="font-size:11px;color:var(--red);font-weight:700;margin-top:2px"> '+m.warn+'</div>':'')+_metricInfoHTML(m)+'</div>';
    var actCell = '<div class="bm-row-score">'+(btn||'')+'</div>';
    if(nm && m.value!=null && m.dir && m.neutral){
      var pn=_bmPctl(m);
      return '<div class="bm-row" style="border-left:3px solid var(--line)">'+lab
        +'<div class="bm-row-value">'+(m.value!=null?m.value:'—')+(m.unit||'')+'<div style="font-size:11px;color:var(--fg2);margin-top:2px">코호트 '+(pn!=null?pn:'—')+'백분위 · 위치(우열 아님)</div></div>'
        +'<div class="bm-row-bar"><div style="font-size:11px;color:var(--fg2)">코호트 분포 내 위치 — 판정 안 함</div></div><div class="bm-row-mph"></div>'+actCell+'</div>';
    }
    if(nm && m.value!=null && m.dir && !m.normNA){
      var s=_bmStat(m.value,nm,m.dir), col=_bmStatusCol(s.status), gl=_bmStatusGlyph(s.status);
      var word=s.status==='strong'?'강점':(s.status==='flag'?'교정':'정상');
      var zline='<div style="font-size:11px;font-weight:700;color:'+col+';margin-top:2px">'+gl+' '+word+' · '+_bmZ(s.z)+'</div>';
      var _bcmp=(typeof _fsOn!=='undefined'&&_fsOn&&(typeof _cmpOn==='undefined'||!_cmpOn)&&m.slowV!=null)?m.slowV:null;
      return '<div class="bm-row" data-bm="'+s.status+'" style="border-left:3px solid '+col+'">'+lab
        +'<div class="bm-row-value">'+(m.value!=null?m.value:'—')+(m.unit||'')+zline+'</div>'
        +'<div class="bm-row-bar">'+_bmBandSVG(m.value,nm,m.dir,_bcmp)+'</div><div class="bm-row-mph"></div>'+actCell+'</div>';
    }
    return '<div class="bm-row">'+lab+'<div class="bm-row-value">'+(m.value!=null?m.value:'—')+(m.unit||'')+'<div style="font-size:11px;color:var(--fg2);margin-top:2px">규준 없음 · 값만</div></div><div class="bm-row-bar">'+_cmpCell(m)+'</div><div class="bm-row-mph"></div>'+actCell+'</div>';
  }).join('');
  var s=_bmSummary().byStage[st.key]||{strong:0,normal:0,flag:0};
  var _mt=(typeof _motionType==='function')?_motionType():null;
  var _role=(_mt)?_motionChainRole(st.key,_mt.type):'common';
  var _roleBadge = _role==='core' ? '<span style="font-size:11px;font-weight:700;color:#10121a;background:#e8954e;border-radius:5px;padding:2px 8px;margin-right:6px"> 핵심</span>'
    : _role==='minor' ? '<span style="font-size:11px;font-weight:700;color:var(--fg2);background:var(--bg2);border:1px solid var(--line);border-radius:5px;padding:2px 8px;margin-right:6px">유형상 부차</span>' : '';
  return '<div class="bm-card" id="bmph-'+st.key+'"><div class="bm-card-head"><div class="bm-card-title"><span class="bm-card-name">'+st.label+'</span><span class="bm-card-desc">'+(st.sub||'')+'</span></div><div class="bm-card-meta">'+_roleBadge+_bmCountChip(s)+_bmMiniBar(s)+'</div></div><div class="bm-card-body">'+_phaseHdr()+rows+'</div></div>';
}
function _renderBioMotionCards(dl){
  var P=(typeof DATA!=='undefined')?DATA.phases:null;
  if(!P||!P.stages||!P.stages.length) return _renderBioMotionRadar(dl);
  var banner=_motionBanner();
  var tally=_bmTallyBar();
  var dlvNote='';
  if(P.deliveryNonOH){ var _sl=(P.deliverySlot==='UH'?'언더핸드(submarine)':'사이드암'); dlvNote='<div class="card" style="margin-bottom:12px;border-left:5px solid #d4bd62"><b>투구 유형: '+_sl+'</b><div class="note" style="margin-top:4px">엘리트 규준 코호트는 <b>오버핸드</b> 기준입니다. 이 선수는 '+_sl+'이라 자세·몸통·암슬롯 계열 변인(골반 닫힘·몸통 열림/뒤젖힘·몸통 굴곡속도·어깨 MER·견갑 로딩·X-Factor)은 <b>규준 비교에서 제외</b>하고 값만 표시합니다. 하체·지면반력·시퀀스 등 유형 중립 변인만 규준과 비교합니다. (동작 유형 분류도 회전 지표가 유형에 의존하므로 참고만)</div></div>'; }
  return dlvNote + _bmPhaseNav() + _bmPriorityTop3() + tally + _bmReadLegend() + banner + _typeSolutions() + P.stages.filter(function(s){return !s.aux;}).map(_phaseCard).join('');
}
function renderBioMotion() {
  const dl = DATA.biomotion;
  const body = document.getElementById('bm-body');
  if (!body) return;
  // 6단계 phases 데이터가 있으면 우선 phases 카드 (Theia·Uplift 공통). 없을 때만 구 biomotion 레이더/빈 메시지.
  if (DATA.phases && DATA.phases.stages && DATA.phases.stages.length) { body.innerHTML = _renderBioMotionCards(dl); return; }
  if (!dl || !dl.models) { body.innerHTML = '<div class="bm-empty"><strong>메카닉 분석이 없습니다</strong></div>'; return; }
  body.innerHTML = _renderBioMotionRadar(dl);
}
function _renderBioMotionRadar(dl) {
  let html = '';
  const ce = dl.ceiling || {};
  const compCls = scoreCls(dl.composite_score);

  // ── Top: 메카닉 6축 레이더 + 종합 점수 ──
  html += `<div class="bm-top">`;
  html += `<div class="bm-radar-card"><div class="bm-radar-ttl">메카닉 6축</div>${_biomotionRadarSVG(dl)}</div>`;
  html += `<div class="bm-ceil-card">`;
  html += `<div class="bm-comp"><span class="bm-comp-num ${compCls}">${dl.composite_score ?? '—'}</span><div><div class="bm-comp-lbl">메카닉 종합 점수</div><div class="bm-sw"><span class="g">강점 ${dl.strength_model || '—'}</span> · <span class="w">최약 ${dl.weakness_model || '—'}</span></div></div></div>`;
  html += `</div></div>`;

  // Model bars
  html += `<div class="bm-modelbars"><h3>메카닉 영역 점수</h3>`;
  for (const [k, m] of Object.entries(dl.models)) {
    const info = MODEL_INFO[k] || {};
    const s = m.score;
    const pct = s==null ? 0 : Math.max(0, Math.min(100, s)) / 100 * 100;
    const cls = scoreCls(s).replace('score-','');
    const fillColor = cls==='high' ? 'linear-gradient(90deg, rgba(62,207,142,.55), var(--green))' :
                      cls==='mid'  ? 'linear-gradient(90deg, rgba(91,211,255,.55), var(--cyan))' :
                      cls==='low'  ? 'linear-gradient(90deg, rgba(255,138,138,.55), #ff8a8a)' : '#384354';
    html += `<div class="bm-mb-row"><span class="bm-mb-emoji">${info.emoji||''}</span><span class="bm-mb-label">${info.ko||m.label}</span><div class="bm-mb-track"><div class="bm-mb-fill" style="width:${pct.toFixed(1)}%;background:${fillColor}"></div><div class="bm-mb-tick" style="left:66.67%"></div></div><span class="bm-mb-score ${scoreCls(s)}">${s ?? '—'}</span></div>`;
  }
  html += `</div>`;

  // Per-metric table with verification status column
  html += `<div class="card"><h3>전체 metric 비교</h3><table class="bm-mtable"><thead><tr><th>모델</th><th>변인</th><th>값</th><th>elite</th><th>점수</th><th>검증</th></tr></thead><tbody>`;
  for (const [k, m] of Object.entries(dl.models)) {
    const info = MODEL_INFO[k] || {};
    for (const met of m.metrics) {
      const verifyChip = met.verify === 'VERIFIED'
        ? '<span style="font-size:11px;background:rgba(62,207,142,.18);color:#3ecf8e;padding:2px 6px;border-radius:4px;font-weight:700" title="' + (met.verify_note||'') + '">✓ VERIFIED</span>'
        : met.verify === 'DISPUTED'
        ? '<span style="font-size:11px;background:rgba(245,197,66,.18);color:#f5c542;padding:2px 6px;border-radius:4px;font-weight:700" title="' + (met.verify_note||'') + '"> DISPUTED</span>'
        : met.verify === 'UNAVAILABLE'
        ? '<span style="font-size:11px;background:rgba(125,136,152,.18);color:#7d8898;padding:2px 6px;border-radius:4px;font-weight:700">— UNAVAIL</span>'
        : '<span style="font-size:11px;background:rgba(255,138,138,.18);color:#ff8a8a;padding:2px 6px;border-radius:4px;font-weight:700" title="' + (met.verify_note||'') + '"> UNVERIFIED</span>';
      const valStyle = met.verify === 'VERIFIED' ? '' : 'color:#7d8898;font-style:italic';
      html += `<tr><td>${info.emoji||''} ${info.ko||m.label}</td><td><code style="background:#1a1f2a;padding:1px 6px;border-radius:4px;font-size:11px;color:#5bd3ff">${met.key}</code> ${met.label}</td><td style="${valStyle}">${fmt1(met.value)}${met.unit||''}</td><td>${fmt1(met.median_elite)}${met.unit||''}</td><td class="${scoreCls(met.score)}" style="font-weight:800;text-align:center;${valStyle}">${met.score ?? '—'}</td><td>${verifyChip}</td></tr>`;
    }
  }
  html += `</tbody></table>`;
  html += `<div class="note" style="border-left-color:#ff7a3c"><b style="color:#ff7a3c"> 중요:</b> UNVERIFIED 변인의 raw 값과 점수는 부호 / 단위 / 컨벤션이 엘리트 정의와 일치하는지 미확인. 진단 사용 전 연구원 답변 (v2 안내서) 필수. VERIFIED 변인만 코치 추천에 사용됨.</div></div>`;

  document.getElementById('bm-body').innerHTML = html;
}

// ═══════════════════════════════════════════════════════════════════
// Render: GRF analysis (Theia 독점)
// ═══════════════════════════════════════════════════════════════════
function _peakIn(arr,i0,i1){ if(!arr) return {v:null,i:null}; var b=-Infinity,bi=null; for(var i=Math.max(0,i0);i<=i1&&i<arr.length;i++){var v=arr[i]; if(isFinite(v)&&Math.abs(v)>b){b=Math.abs(v);bi=i;}} return {v:bi!=null?arr[bi]:null,i:bi}; }
function _grfWinI(t,ev,off){ var dt=t.meta.dt; var base=(t.events[ev]!=null?t.events[ev]:(t.events.i_fc||0)); return base+Math.round((off||0)/dt); }
function _impulse(t,key,sEv,sOff,eEv,eOff,sign){ var s=t.series[key]; if(!s) return null; var dt=t.meta.dt; var a=Math.max(0,_grfWinI(t,sEv,sOff)), b=Math.min(s.length-1,_grfWinI(t,eEv,eOff)); var sum=0; for(var i=a;i<=b;i++){ var v=s[i]; if(!isFinite(v)) continue; if(sign>0&&v<0)continue; if(sign<0&&v>0)continue; sum+=v*dt; } return sign<0?Math.abs(sum):sum; }
function _impulseRes(t,ky,kz,sEv,sOff,eEv,eOff){ var y=t.series[ky],z=t.series[kz]; if(!y||!z)return null; var dt=t.meta.dt; var a=Math.max(0,_grfWinI(t,sEv,sOff)),b=Math.min(y.length-1,_grfWinI(t,eEv,eOff)); var sum=0; for(var i=a;i<=b;i++){ if(!isFinite(y[i])||!isFinite(z[i]))continue; sum+=Math.sqrt(y[i]*y[i]+z[i]*z[i])*dt; } return sum; }
function _cmpRow(label, fv, sv, unit, dir){
  if(fv==null||sv==null) return '<tr><td class="evl">'+label+'</td><td>'+(fv!=null?fv.toFixed(1):'—')+'</td><td>'+(sv!=null?sv.toFixed(1):'—')+'</td><td>—</td></tr>';
  var f=Math.round(fv*10)/10, s=Math.round(sv*10)/10, d=Math.round((fv-sv)*10)/10;
  var denom=Math.max(Math.abs(fv),Math.abs(sv),1e-6); var cls='cmp-neu';
  if(Math.abs(fv-sv)>=0.05*denom){ var gd=(dir===-1?-1:1)*(fv-sv); cls=gd<0?'cmp-bad':'cmp-good'; }
  return '<tr><td class="evl">'+label+'</td><td>'+f+'<span class="evu">'+unit+'</span></td><td>'+s+'<span class="evu">'+unit+'</span></td><td class="'+cls+'">'+(d>0?'+':'')+d+'</td></tr>';
}
function renderGRF(trial){
  var fast=_fastTrial()||trial, slow=_slowTrial();
  var grf=fast.grf||{};
  // ① 앞발+뒷발 수직 지면반력
  plotWin('ch-grf-z',{fast:fast,slow:slow,startEv:'i_kl_peak',startOff:-0.1,endEv:'i_br',endOff:0.2,
    left:{label:'수직력 (N)',lines:[
      {compute:function(t){return t.series.FP1_Z;},color:'#86a8d0',label:'뒷발(FP1)',width:2.4},
      {compute:function(t){return t.series.FP2_Z;},color:'#5bd3ff',label:'앞발(FP2)',width:2.4}
    ]}});
  // 피크 비율 · 시간 갭 캡션 (빠른/느린)
  (function(){
    function rg(t){ var rp=_peakIn(t.series.FP1_Z, t.events.i_kl_peak||0, t.events.i_br||0); var lp=_peakIn(t.series.FP2_Z, t.events.i_fc||0, t.events.i_br||0);
      var ratio=(rp.v&&lp.v)?Math.abs(lp.v)/Math.abs(rp.v):null; var gap=(rp.i!=null&&lp.i!=null)?(lp.i-rp.i)*t.meta.dt*1000:null;
      return {rear:rp.v,lead:lp.v,ratio:ratio,gap:gap}; }
    var F=rg(fast), S=slow?rg(slow):null;
    var el=document.getElementById('ev-grfz'); if(!el) return;
    function r1(x){return x==null?'—':(Math.round(x*10)/10);}
    el.innerHTML='<table class="ev-table"><thead><tr><th class="evl">수직 GRF 피크</th><th>빠른 공</th>'+(S?'<th>느린 공</th>':'')+'</tr></thead><tbody>'
      +'<tr><td class="evl">뒷발 피크</td><td>'+r1(F.rear)+'<span class="evu">N</span></td>'+(S?'<td>'+r1(S.rear)+'<span class="evu">N</span></td>':'')+'</tr>'
      +'<tr><td class="evl">앞발 피크</td><td>'+r1(F.lead)+'<span class="evu">N</span></td>'+(S?'<td>'+r1(S.lead)+'<span class="evu">N</span></td>':'')+'</tr>'
      +'<tr><td class="evl">앞발/뒷발 비율</td><td>'+r1(F.ratio)+'</td>'+(S?'<td>'+r1(S.ratio)+'</td>':'')+'</tr>'
      +'<tr><td class="evl">피크 시간 갭(뒷→앞)</td><td>'+r1(F.gap)+'<span class="evu">ms</span></td>'+(S?'<td>'+r1(S.gap)+'<span class="evu">ms</span></td>':'')+'</tr>'
      +'</tbody></table>';
  })();
  // ② 뒷발 추진력 + 자유토크 Mz (FC 1.2초 전 ~ FC 0.2초 후)
  plotWin('ch-fp1-xyz',{fast:fast,slow:slow,startEv:'i_fc',startOff:-1.2,endEv:'i_fc',endOff:0.2,
    left:{label:'추진력 (N)',lines:[{compute:function(t){return t.series.FP1_Y;},color:'#3ecf8e',label:'뒷발 추진력(+홈)',width:2.4}]},
    right:{label:'자유토크 Mz (N·m)',lines:[{compute:function(t){return t.series.FP1_Z_3;},color:'#86a8d0',label:'뒷발 토크 Mz',width:2.0}]}});
  // ③ 앞발 수직·전후·좌우 (FC ~ BR 0.2초 후)
  plotWin('ch-fp2-xyz',{fast:fast,slow:slow,startEv:'i_fc',startOff:0,endEv:'i_br',endOff:0.2,
    left:{label:'힘 (N)',lines:[
      {compute:function(t){return t.series.FP2_Z;},color:'#4a90c8',label:'수직(Z)',width:2.4},
      {compute:function(t){return t.series.FP2_Y;},color:'#3ecf8e',label:'전후(Y)',width:2.2},
      {compute:function(t){return t.series.FP2_X;},color:'#5bd3ff',label:'좌우(X)',width:2.2}
    ]}});
  // COP 궤적 (빠른=실선/느린=점선)
  drawCopGrf(fast, (typeof _currentFrame!=="undefined"?_currentFrame:fast.events.i_br), slow);
  // grf-metrics-detail (빠른 공 기준 유지)
  (function(){
    var el=document.getElementById('grf-metrics-detail'); if(!el) return; var g=fast.grf_metrics||{};
    var row=function(lbl,val,unit,hint){ return val==null?'':'<tr><td style="padding:5px 8px;color:var(--fg1)">'+lbl+'</td><td style="padding:5px 8px;text-align:right;color:var(--fg0);font-weight:600">'+val+(unit||'')+'</td><td style="padding:5px 8px;font-size:11px;color:var(--fg2)">'+(hint||'')+'</td></tr>'; };
    el.innerHTML='<details><summary style="cursor:pointer;font-size:12px;color:var(--cyan);font-weight:600"> 스트라이드 · 타이밍 상세 (빠른 공)</summary><table style="width:100%;border-collapse:collapse;font-size:12px;margin-top:8px"><tbody>'
      +row('스트라이드 길이',g.stride_length_m,' m','')+row('스트라이드 방향각',(g.stride_angle_deg!=null?(g.stride_angle_deg>0?'+':'')+g.stride_angle_deg:null),'°','')
      +row('뒷발 피크 GRF → FC',g.rear_peak_to_fc_ms,' ms','')+row('FC → 앞발 피크 GRF',g.fc_to_lead_peak_ms,' ms','')+row('FC → BR',g.fc_to_br_ms,' ms','')+'</tbody></table></details>';
  })();
  // 표: 체중·좌우대칭 + 임펄스(빠른/느린 비교)
  var st=document.getElementById('grf-stats');
  if(st){
    var bw=grf.body_weight_N!=null?grf.body_weight_N:null;
    var asym=null; try{ if(typeof DATA!=='undefined'&&DATA.hp_assessment&&DATA.hp_assessment.asymmetry_flags&&DATA.hp_assessment.asymmetry_flags.length) asym=DATA.hp_assessment.asymmetry_flags.join(', '); }catch(e){}
    var rows='';
    rows+='<tr><td class="evl">체중</td><td colspan="2">'+(bw!=null?(Math.round(bw*10)/10+' N ≈ '+Math.round(bw/9.81*10)/10+' kg'):'—')+'</td><td></td></tr>';
    rows+='<tr><td class="evl">좌우 대칭 (점프)</td><td colspan="2">'+(asym?('비대칭: '+asym):'대칭 양호')+'</td><td></td></tr>';
    rows+=_cmpRow('뒷발 추진 임펄스 (FC−1.2s~FC)', _impulse(fast,'FP1_Y','i_fc',-1.2,'i_fc',0,1), slow?_impulse(slow,'FP1_Y','i_fc',-1.2,'i_fc',0,1):null, ' N·s',1);
    rows+=_cmpRow('앞발 브레이킹 임펄스 (FC~BR)', _impulse(fast,'FP2_Y','i_fc',0,'i_br',0,-1), slow?_impulse(slow,'FP2_Y','i_fc',0,'i_br',0,-1):null, ' N·s',1);
    rows+=_cmpRow('앞발 수직 임펄스 (FC~BR)', _impulse(fast,'FP2_Z','i_fc',0,'i_br',0,1), slow?_impulse(slow,'FP2_Z','i_fc',0,'i_br',0,1):null, ' N·s',1);
    rows+=_cmpRow('브레이킹+수직 합력 임펄스 (FC~BR)', _impulseRes(fast,'FP2_Y','FP2_Z','i_fc',0,'i_br',0), slow?_impulseRes(slow,'FP2_Y','FP2_Z','i_fc',0,'i_br',0):null, ' N·s',1);
    var fk=fast.rapsodo?Math.round(fast.rapsodo.velocity_kmh*10)/10:'—', sk=slow&&slow.rapsodo?Math.round(slow.rapsodo.velocity_kmh*10)/10:'—';
    st.innerHTML='<table class="ev-table"><thead><tr><th class="evl">항목</th><th>빠른 공 '+fk+'</th><th>느린 공 '+sk+'</th><th>Δ</th></tr></thead><tbody>'+rows+'</tbody></table>';
  }
}


function _hudVals(trial, fi) {
  var S = trial.series || {}, ev = trial.events || {}, m = trial.meta || {}, dt = m.dt || (1/300);
  var i_kl = ev.i_kl_peak, i_fc = ev.i_fc;
  var A = function(k){ return S[k] || []; };
  var at = function(a,i){ return (a && i!=null && i<a.length && isFinite(a[i])) ? a[i] : null; };
  var absn = function(x){ return x==null?null:Math.abs(x); };
  var pelvisRotV = absn(at(A('Pelvis_Ang_Vel_Z'), fi));
  var ph = A('PELVIS_O_Z'); var pelH = at(ph, fi); var pelKL = (i_kl!=null)?at(ph, i_kl):null;
  var pelDrop = (pelH!=null && pelKL!=null) ? (pelH - pelKL) : null;
  var comVel = at(A('COM_Velocity_Y'), fi);
  var xf = trial.x_factor || []; var xFactor = at(xf, fi);
  var trunkRotV = absn(at(A('Thorax_Ang_Vel_Z'), fi));
  var armRotV = absn(at(A('Pitching_Shoulder_Ang_Vel_Z'), fi));
  return { pelvisRotV:pelvisRotV, pelDrop:pelDrop, comVel:comVel, xFactor:xFactor, trunkRotV:trunkRotV, armRotV:armRotV,
    preFC:(i_fc==null)||(fi<=i_fc), postFC:(i_fc!=null)&&(fi>=i_fc), drivePhase:(i_kl!=null&&i_fc!=null)&&(fi>=i_kl&&fi<=i_fc) };
}
function updateStickHUD(trial, fi) {
  var el = document.getElementById('stick-hud'); if (!el) return; el.innerHTML=''; return;
  var v = _hudVals(trial, fi);
  var fmt = function(x,d){ return (x==null||!isFinite(x)) ? '—' : x.toFixed(d); };
  el.innerHTML =
    '<div class="hud-panel left '+(v.preFC?'':'dim-panel')+'">'+
      '<div class="hud-sec">하체 드라이브 (~FC)</div>'+
      '<div class="hud-row"><span>골반 내회전 속도</span><b>'+fmt(v.pelvisRotV,0)+'<u>°/s</u></b></div>'+
      '<div class="hud-row"><span>골반 높이 변화</span><b>'+(v.pelDrop!=null?(v.pelDrop>0?'+':'')+fmt(v.pelDrop,3):'—')+'<u> m</u></b></div>'+
      '<div class="hud-row '+(v.drivePhase?'':'dim')+'"><span>전진 속도</span><b>'+fmt(v.comVel,2)+'<u> m/s</u></b></div>'+
    '</div>'+
    '<div class="hud-panel right '+(v.postFC?'':'dim-panel')+'">'+
      '<div class="hud-sec">회전 (FC~BR)</div>'+
      '<div class="hud-row"><span>X-Factor</span><b>'+fmt(v.xFactor,0)+'<u>°</u></b></div>'+
      '<div class="hud-row"><span>몸통 회전 속도</span><b>'+fmt(v.trunkRotV,0)+'<u>°/s</u></b></div>'+
      '<div class="hud-row"><span>팔 회전 속도</span><b>'+fmt(v.armRotV,0)+'<u>°/s</u></b></div>'+
    '</div>';
}
function updateStickHUDCompare(a, fa, b, fb) {
  var el = document.getElementById('stick-hud'); if (!el) return; el.innerHTML=''; return;
  var va = _hudVals(a, fa), vb = _hudVals(b, fb);
  var fmt = function(x,d){ return (x==null||!isFinite(x)) ? '—' : x.toFixed(d); };
  var drop = function(x){ return (x!=null&&isFinite(x)) ? ((x>0?'+':'')+fmt(x,3)) : '—'; };
  var row = function(lbl,ka,kb,d,unit,dim,isDrop){ return '<div class="hud-crow '+(dim?'dim':'')+'"><span class="hl">'+lbl+'</span><b class="va">'+(isDrop?drop(ka):fmt(ka,d))+'</b><b class="vb">'+(isDrop?drop(kb):fmt(kb,d))+'</b><u>'+unit+'</u></div>'; };
  var hdr = '<div class="hud-crow hud-head"><span class="hl"></span><b class="va">빠른 공</b><b class="vb">느린 공</b><u></u></div>';
  el.innerHTML =
    '<div class="hud-panel left '+(va.preFC?'':'dim-panel')+'">'+hdr+'<div class="hud-sec">하체 드라이브 (~FC)</div>'+
      row('골반 내회전 속도',va.pelvisRotV,vb.pelvisRotV,0,'°/s',!va.preFC)+
      row('골반 높이 변화',va.pelDrop,vb.pelDrop,3,'m',!va.preFC,true)+
      row('전진 속도',va.comVel,vb.comVel,2,'m/s',!va.drivePhase)+
    '</div>'+
    '<div class="hud-panel right '+(va.postFC?'':'dim-panel')+'">'+hdr+'<div class="hud-sec">회전 (FC~BR)</div>'+
      row('X-Factor',va.xFactor,vb.xFactor,0,'°',false)+
      row('몸통 회전 속도',va.trunkRotV,vb.trunkRotV,0,'°/s',!va.postFC)+
      row('팔 회전 속도',va.armRotV,vb.armRotV,0,'°/s',!va.postFC)+
    '</div>';
}
function drawCopGrf(trial, frameIdx, forceB, canvasId, showStride) {
  const canvas = document.getElementById(canvasId||'ch-copgrf'); if (!canvas) return;
  const { ctx, w, h } = clearC(canvas);
  const m = trial.meta || {};
  const FZMIN = 60;
  const B = forceB || ((typeof window!=='undefined' && window._cmpB && window._cmpB!==trial) ? window._cmpB : null);
  function mkFeet(t){ const S=t.series||{}; const RHP=((t.meta||{}).handedness||'R').toUpperCase()!=='L';
    const feet=[ { cx:S.FP2_X_2, cy:S.FP2_Y_2, fx:S.FP2_X, fy:S.FP2_Y, fz:S.FP2_Z, color:'#5bd3ff', foot:'lead', side:(RHP?'L':'R') },
                 { cx:S.FP1_X_2, cy:S.FP1_Y_2, fx:S.FP1_X, fy:S.FP1_Y, fz:S.FP1_Z, color:'#86a8d0', foot:'rear', side:(RHP?'R':'L') } ];
    feet.forEach(p=>{ p._ok=[]; const n=(p.cx||[]).length; for(let i=0;i<n;i++){ if(isFinite(p.cx[i])&&isFinite(p.cy[i])&&p.fz&&isFinite(p.fz[i])&&Math.abs(p.fz[i])>FZMIN) p._ok.push(i); } });
    return feet; }
  const feetA = mkFeet(trial);
  const feetB = B ? mkFeet(B) : null;
  let xs=[], ys=[];
  feetA.forEach(p=>p._ok.forEach(i=>{xs.push(p.cx[i]);ys.push(p.cy[i]);}));
  if(feetB) feetB.forEach(p=>p._ok.forEach(i=>{xs.push(p.cx[i]);ys.push(p.cy[i]);}));
  if (xs.length < 2) { ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('COP 데이터 없음', w/2, h/2); return; }
  let xLo=Math.min(...xs),xHi=Math.max(...xs),yLo=Math.min(...ys),yHi=Math.max(...ys);
  const padX=(xHi-xLo)*0.12+0.06, padY=(yHi-yLo)*0.10+0.06; xLo-=padX;xHi+=padX;yLo-=padY;yHi+=padY;
  const worldW=xHi-xLo, worldD=yHi-yLo;
  const elev=58*Math.PI/180, sinE=Math.sin(elev);
  const pad=52, availW=w-2*pad, availH=h-2*pad;
  const sc=Math.min(availW/worldD, availH/(worldW*sinE))*0.98;
  const ox=pad+(availW-worldD*sc)/2, oy=pad+(availH-worldW*sinE*sc)/2;
  const FSC=0.00026;
  function proj(wx,wy,wz){ return [ox+(wy-yLo)*sc, oy+(wx-xLo)*sinE*sc-(wz||0)*sc]; }
  ctx.strokeStyle='rgba(120,136,152,.22)';ctx.lineWidth=1;
  const gx=niceStep(worldW,4),gy=niceStep(worldD,5);
  for(let v=Math.ceil(xLo/gx)*gx;v<=xHi;v+=gx){const a=proj(v,yLo,0),b=proj(v,yHi,0);ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.stroke();}
  for(let v=Math.ceil(yLo/gy)*gy;v<=yHi;v+=gy){const a=proj(xLo,v,0),b=proj(xHi,v,0);ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.stroke();}
  const fiA=(frameIdx==null)?(trial.events.i_br||0):frameIdx;
  const fiB = B ? Math.max(0, Math.min((B.meta.n_frames||1)-1, (B.events.i_fc||0)+(fiA-(trial.events.i_fc||0)))) : null;
  function drawCOM(t,fi,alpha,dash){ const S=t.series||{}; const cx=S.COM_displacement_X,cy=S.COM_displacement_Y; if(!cx||!cy)return;
    const i_kl=t.events.i_kl_peak||0; ctx.save(); ctx.strokeStyle='rgba(255,255,255,'+alpha+')'; ctx.lineWidth=3.4; if(dash)ctx.setLineDash([4,3]); ctx.beginPath(); let st=false;
    for(let i=i_kl;i<=fi&&i<cx.length;i++){if(!isFinite(cx[i])||!isFinite(cy[i]))continue;const p=proj(cx[i],cy[i],0);if(!st){ctx.moveTo(p[0],p[1]);st=true;}else ctx.lineTo(p[0],p[1]);}
    ctx.stroke(); ctx.restore(); }
  function footLocal(side){var sole=[[-0.98,0.02],[-0.90,-0.20],[-0.74,-0.30],[-0.50,-0.35],[-0.22,-0.40],[0.08,-0.46],[0.34,-0.50],[0.52,-0.49],[0.66,-0.42],[0.74,-0.28],[0.78,-0.10],[0.79,0.12],[0.74,0.34],[0.62,0.50],[0.44,0.55],[0.26,0.50],[0.12,0.40],[0.00,0.28],[-0.16,0.18],[-0.34,0.15],[-0.52,0.18],[-0.70,0.24],[-0.86,0.24],[-0.95,0.14]];var toes=[[0.90,0.40,0.15,0.12],[0.97,0.18,0.10,0.09],[0.99,-0.02,0.09,0.085],[0.96,-0.20,0.08,0.075],[0.89,-0.36,0.07,0.065]];if(side==='L'){sole=sole.map(function(p){return [p[0],-p[1]];});toes=toes.map(function(t){return [t[0],-t[1],t[2],t[3]];});}return {sole:sole,toes:toes};} function drawFootPrint(mx,my,hL,hW,dirA,color,alpha,dash,side){var sh=footLocal(side||'R');var cosA=Math.cos(dirA),sinA=Math.sin(dirA);function Wp(nx,ny){var lx=hL*nx,ly=hW*ny;var ex=mx+lx*cosA-ly*sinA,ey=my+lx*sinA+ly*cosA;return proj(ex,ey,0);}ctx.save();ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineJoin='round';if(dash)ctx.setLineDash([4,3]);ctx.beginPath();sh.sole.forEach(function(p,i){var q=Wp(p[0],p[1]);if(i)ctx.lineTo(q[0],q[1]);else ctx.moveTo(q[0],q[1]);});ctx.closePath();ctx.globalAlpha=alpha*0.32;ctx.fill();ctx.globalAlpha=alpha;ctx.lineWidth=1.6;ctx.stroke();sh.toes.forEach(function(t){ctx.beginPath();var first=true;for(var a=0;a<=Math.PI*2+0.01;a+=Math.PI/10){var nx=t[0]+t[2]*Math.cos(a),ny=t[1]+t[3]*Math.sin(a);var q=Wp(nx,ny);if(first){ctx.moveTo(q[0],q[1]);first=false;}else ctx.lineTo(q[0],q[1]);}ctx.closePath();ctx.globalAlpha=alpha*0.32;ctx.fill();ctx.globalAlpha=alpha;ctx.lineWidth=1.3;ctx.stroke();});ctx.globalAlpha=1;ctx.setLineDash([]);ctx.restore();}
  function drawFeet(feet,fi,solid){
    for(const ft of feet){ const ok=ft._ok; if(!ok.length){ft._mx=null;continue;}
      const mx=ok.reduce((a,i)=>a+ft.cx[i],0)/ok.length, my=ok.reduce((a,i)=>a+ft.cy[i],0)/ok.length; ft._mx=mx; ft._my=my;
      const oxs=ok.map(i=>ft.cx[i]),oys=ok.map(i=>ft.cy[i]);
      const spanX=(Math.max(...oxs)-Math.min(...oxs))||0.1, spanY=(Math.max(...oys)-Math.min(...oys))||0.1;
      let dirA,hL,hW;
      if(ft.foot==='rear'){dirA=0;hL=Math.max(0.13,spanX*0.65);hW=Math.max(0.05,spanY*0.5);}else{dirA=Math.PI/2;hL=Math.max(0.17,spanY*0.7);hW=Math.max(0.07,spanX*0.6);}
      drawFootPrint(mx,my,hL,hW,dirA,ft.color,solid?0.55:0.32,!solid,ft.side);
      let prev=null;
      for(const i of ok){ if(i>fi)break; const p=proj(ft.cx[i],ft.cy[i],0);
        if(prev){ctx.save();ctx.strokeStyle=ft.color;ctx.globalAlpha=(solid?0.15:0.07)+(solid?0.85:0.3)*(i/Math.max(1,fi));ctx.lineWidth=solid?2:1.5;if(!solid)ctx.setLineDash([4,3]);ctx.beginPath();ctx.moveTo(prev[0],prev[1]);ctx.lineTo(p[0],p[1]);ctx.stroke();ctx.restore();}
        prev=p; }
      ctx.globalAlpha=1;
      if(solid && fi<ft.cx.length && isFinite(ft.cx[fi]) && isFinite(ft.cy[fi]) && ft.fz && isFinite(ft.fz[fi]) && Math.abs(ft.fz[fi])>FZMIN){
        const cx=ft.cx[fi],cy=ft.cy[fi],fx=(ft.fx&&isFinite(ft.fx[fi]))?ft.fx[fi]:0,fy=(ft.fy&&isFinite(ft.fy[fi]))?ft.fy[fi]:0,fz=(ft.fz&&isFinite(ft.fz[fi]))?ft.fz[fi]:0;
        const fmag=Math.sqrt(fx*fx+fy*fy+fz*fz),bp=proj(cx,cy,0),tp=proj(cx+fx*FSC,cy+fy*FSC,fz*FSC);
        if(fmag>30){ctx.strokeStyle=ft.color;ctx.fillStyle=ft.color;ctx.lineWidth=3.5;ctx.beginPath();ctx.moveTo(bp[0],bp[1]);ctx.lineTo(tp[0],tp[1]);ctx.stroke();
          const a2=Math.atan2(tp[1]-bp[1],tp[0]-bp[0]);ctx.beginPath();ctx.moveTo(tp[0],tp[1]);ctx.lineTo(tp[0]-13*Math.cos(a2-0.4),tp[1]-13*Math.sin(a2-0.4));ctx.lineTo(tp[0]-13*Math.cos(a2+0.4),tp[1]-13*Math.sin(a2+0.4));ctx.closePath();ctx.fill();
          ctx.fillStyle='#fff';ctx.font='bold 11px system-ui';ctx.textAlign='center';ctx.fillText(Math.round(fmag)+' N',tp[0],tp[1]-10);}
        ctx.fillStyle=ft.color;ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(bp[0],bp[1],5,0,Math.PI*2);ctx.fill();ctx.stroke();
      }
    }
  }
  function strideArrow(feet,color,alpha){ const r=feet[1],l=feet[0]; if(r._mx==null||l._mx==null)return null;
    const rp=proj(r._mx,r._my,0),lp=proj(l._mx,l._my,0);
    ctx.save();ctx.strokeStyle=color;ctx.fillStyle=color;ctx.globalAlpha=alpha;ctx.lineWidth=2.2;
    ctx.beginPath();ctx.moveTo(rp[0],rp[1]);ctx.lineTo(lp[0],lp[1]);ctx.stroke();
    const a2=Math.atan2(lp[1]-rp[1],lp[0]-rp[0]);ctx.beginPath();ctx.moveTo(lp[0],lp[1]);ctx.lineTo(lp[0]-14*Math.cos(a2-0.4),lp[1]-14*Math.sin(a2-0.4));ctx.lineTo(lp[0]-14*Math.cos(a2+0.4),lp[1]-14*Math.sin(a2+0.4));ctx.closePath();ctx.fill();ctx.globalAlpha=1;ctx.restore();
    return [(rp[0]+lp[0])/2,Math.min(rp[1],lp[1])]; }
  function strideStr(t){ const gm=t.grf_metrics||{}; const RHP=((t.meta||{}).handedness||'R').toUpperCase()!=='L';
    const len=gm.stride_length_m!=null?gm.stride_length_m+' m':(gm.stride_cop_m!=null?gm.stride_cop_m+' m':'—');
    let sw=''; if(gm.stride_angle_deg!=null&&Math.abs(gm.stride_angle_deg)>=3){let gl=gm.stride_angle_deg<0;if(!RHP)gl=!gl;sw=gl?'글러브측':'투구측';}else if(gm.stride_angle_deg!=null)sw='정면';
    const ang=gm.stride_angle_deg!=null?(gm.stride_angle_deg>0?'+':'')+gm.stride_angle_deg+'°':'';
    return len+(ang?(' / '+ang+(sw?' '+sw:'')):''); }
  if(feetB) drawFeet(feetB,fiB,false);
  drawFeet(feetA,fiA,true);
  drawCOM(trial,fiA,0.98,false);
  if(B) drawCOM(B,fiB,0.74,true);
  if(showStride){ var smid=strideArrow(feetA,'#46c98c',0.95); if(smid){ ctx.save(); ctx.font='bold 12px system-ui'; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillStyle='#9be9c2'; ctx.fillText('스트라이드 '+strideStr(trial), w/2, 26); ctx.restore(); } }
  (function(){ ctx.save(); ctx.font='12px system-ui'; ctx.textAlign='center'; ctx.textBaseline='top';
    var fv=trial.rapsodo?Math.round(trial.rapsodo.velocity_kmh*10)/10:null, sv=(B&&B.rapsodo)?Math.round(B.rapsodo.velocity_kmh*10)/10:null;
    ctx.fillStyle='#e8ecf2'; ctx.fillText('체중이동(COM) 트레이스 — 빠른 공 실선'+(fv?' '+fv:'')+(sv?' · 느린 공 점선 '+sv:'')+' km/h', w/2, 10);
    ctx.restore(); })();
  ctx.font='11px system-ui';ctx.textBaseline='middle';const tsec=(fiA*(m.dt||0)).toFixed(3);
  ctx.fillStyle='#7d8898';ctx.textAlign='right';ctx.fillText('t = '+tsec+' s · frame '+fiA,w-14,17);
}

function renderPower(trial) {
  // 하체 파워: 리드다리 / 백다리 2개로 분리
  plot('ch-pow-lead', trial, [
    {key:'Lead_Hip_Power_X',  color:'#5bd3ff', label:'앞 고관절',  width:2.4},
    {key:'Lead_Knee_Power_X', color:'#3ecf8e', label:'앞무릎', width:2.4},
  ], 'Lead Leg Power (W)');
  plot('ch-pow-back', trial, [
    {key:'Back_Hip_Power_X',  color:'#4a90c8', label:'뒷 고관절',  width:2.4},
    {key:'Back_Knee_Power_X', color:'#9aa7b6', label:'뒷무릎', width:2.4},
  ], 'Back Leg Power (W)');
  plot('ch-pow-upper', trial, [
    {key:'Pitching_Shoulder_Power_X', color:'#4a90c8', label:'어깨'},
    {key:'Pitching_Elbow_Power_X',    color:'#9aa7b6', label:'팔꿈치'},
  ], 'Joint Power (W)');
  plot('ch-me', trial, [
    {key:'Pelvis_ME_X',           color:'#bcc4d0', label:'골반 에너지'},
    {key:'Trunk_ME_X',            color:'#5bd3ff', label:'몸통 에너지'},
    {key:'Pitching_Humerus_ME_X', color:'#4a90c8', label:'위팔 에너지'},
  ], 'Mechanical Energy (J)');
  const setEvP=(id,title,rows)=>{const e=document.getElementById(id); if(e)e.innerHTML=_evCard(trial,title,rows);};
  setEvP('ev-pow-lead','리드다리 파워 (W)',[
    {label:'앞 고관절 파워',  key:'Lead_Hip_Power_X',  unit:'W'},
    {label:'앞무릎 파워', key:'Lead_Knee_Power_X', unit:'W'},
  ]);
  setEvP('ev-pow-back','백다리 파워 (W)',[
    {label:'뒷 고관절 파워',  key:'Back_Hip_Power_X',  unit:'W'},
    {label:'뒷무릎 파워', key:'Back_Knee_Power_X', unit:'W'},
  ]);
  setEvP('ev-pow-upper','상체 파워 (W)',[
    {label:'어깨 파워',  key:'Pitching_Shoulder_Power_X', unit:'W'},
    {label:'팔꿈치 파워',     key:'Pitching_Elbow_Power_X',    unit:'W'},
  ]);
  setEvP('ev-me','역학 에너지 (J)',[
    {label:'골반 에너지',   key:'Pelvis_ME_X',           unit:'J'},
    {label:'몸통 에너지',    key:'Trunk_ME_X',            unit:'J'},
    {label:'위팔 에너지',  key:'Pitching_Humerus_ME_X', unit:'J'},
  ]);
}
// 세션 집계 kseq 시각화 채우기 (순서%·peak bars·gain·delta) — 키네매틱 시퀀스 탭
function _fillKseqViz() {
  const tr = DATA.trials || [];
  const el = document.getElementById('ss-kseq-table'); if (!el) return;
  const lab = {pelvis:'골반',trunk:'몸통',arm:'팔'};
  let rows = '';
  tr.forEach((t,i)=>{
    const k = t.kseq || {}, d = k.deltas || {};
    const pt = d.pelvis_to_trunk_ms, ta = d.trunk_to_arm_ms;
    const ordOk = !!k.sequence_ok;
    const ordStr = (k.peak_order||[]).map(x=>lab[x]||x).join('→') || '—';
    const inBand = v => v!=null && v>=15 && v<=120;
    const timingOk = ordOk && inBand(pt) && inBand(ta);
    const oc = ordOk ? '#2f9e44' : '#e5484d';
    const tc = timingOk ? '#2f9e44' : '#e8731a';
    const no = (t.meta && t.meta.trial_label) ? t.meta.trial_label.replace('Trial ','') : (i+1);
    rows += `<tr><td style="text-align:center">${no}</td><td style="color:${oc};font-weight:700">${ordOk?'정상':'역전'}</td><td style="font-size:11px;color:var(--fg2)">${ordStr}</td><td style="text-align:right">${pt!=null?pt:'—'}</td><td style="text-align:right">${ta!=null?ta:'—'}</td><td style="color:${tc};font-weight:700">${timingOk?'좋음':'주의'}</td></tr>`;
  });
  const okN = tr.filter(t=>t.kseq&&t.kseq.sequence_ok).length;
  el.innerHTML = `<div style="margin-bottom:6px;font-size:13px">순서 정상 <b>${okN}</b>/${tr.length}구 · 올바른 순서 = 골반→몸통→팔</div>`
    + `<table class="ev-table"><thead><tr><th>구</th><th>순서</th><th>peak 순서</th><th>골반→몸통(ms)</th><th>몸통→팔(ms)</th><th>타이밍</th></tr></thead><tbody>${rows}</tbody></table>`
    + `<div style="font-size:11px;color:var(--fg2);margin-top:6px">※ 타이밍 좋음 = 순서 정상 + 골반→몸통·몸통→팔 지연이 모두 양(+)이고 각 지연이 15–120ms(잠정 효율 구간). 구간값은 매뉴얼에서 조정 예정.</div>`;
}
function renderSequence(trial) {
  // [2026-05-27] X-Factor 최대(분리 풀림 시작) 프레임 산출 → 키네매틱 시퀀스 그래프에 오버레이.
  //   골반→몸통→팔 peak 순서 대비 분리가 언제 풀리기 시작하는지(이상적으로 FC 직후·골반 가속 직전~중)를 시각적으로 확인.
  var _xf=trial.x_factor||[], _ev=trial.events||{}, _kl=_ev.i_kl_peak||0, _br=(_ev.i_br!=null?_ev.i_br:_xf.length-1), _xpi=null, _xpv=-Infinity;
  for(var _xi2=_kl; _xi2<=_br && _xi2<_xf.length; _xi2++){ var _xv=Math.abs(_xf[_xi2]); if(isFinite(_xv)&&_xv>_xpv){_xpv=_xv;_xpi=_xi2;} }
  plot('ch-kseq', trial, [
    {key:'Pelvis_Ang_Vel_Z',           color:'#5bd3ff', label:'Pelvis', width:2.6},
    {key:'Thorax_Ang_Vel_Z',           color:'#8ea9cf', label:'Trunk',  width:2.6},
    {key:'Pitching_Hand_Ang_Vel_X',    color:'#4a90c8', label:'팔(손끝)', width:2.6},
  ], 'Angular Velocity (°/s)', {xfPeakFrame:_xpi});
  const elk=document.getElementById('ev-kseq');
  if(elk) elk.innerHTML=_evCard(trial,'각속도 (°/s)',[
    {label:'골반 회전속도', key:'Pelvis_Ang_Vel_Z', unit:'°/s'},
    {label:'몸통 회전속도',  key:'Thorax_Ang_Vel_Z', unit:'°/s'},
    {label:'팔 회전속도',    key:'Pitching_Hand_Ang_Vel_X', unit:'°/s'},
  ]);
  plotXF(trial);
  const elx=document.getElementById('ev-xf');
  if(elx) elx.innerHTML=_evCard(trial,'X-Factor (°)',[{label:'X-Factor', arr:trial.x_factor, unit:'°'}]);
  _fillKseqViz();
}
// ── 릴리즈 포인트 + 암슬롯 산점도 (모든 투구) · ax.ix/iy = 프레임좌표 인덱스(0=좌우,1=상하,2=전후) ──
function _relScatter(canvasId, ax){
  var canvas=document.getElementById(canvasId); if(!canvas) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  if(typeof DATA==='undefined'||!DATA.trials){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 데이터 없음 —',w/2,h/2); return; }
  var RHP=((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L';
  var hk=RHP?'r_hand_tip':'l_hand_tip', sk=RHP?'r_shoulder':'l_shoulder';
  var fast=_fastTrial(), slow=_slowTrial();
  var pts=[];
  DATA.trials.forEach(function(t){ var ibr=t.events.i_br, fr=(t.frames&&ibr!=null)?t.frames[ibr]:null; if(!fr||!fr[hk]||!fr[sk]) return;
    var hx=fr[hk][ax.ix], hy=fr[hk][ax.iy], sx=fr[sk][ax.ix], sy=fr[sk][ax.iy]; if(![hx,hy,sx,sy].every(isFinite)) return;
    pts.push({hx:hx,hy:hy,sx:sx,sy:sy,cls:(t===fast)?'fast':(t===slow)?'slow':'norm'}); });
  if(!pts.length){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 릴리스 데이터 없음 —',w/2,h/2); return; }
  // 어깨 관절을 공통 원점(평균 어깨위치)으로 정렬 → 몸 전체 위치변동 제거, 암슬롯 각도·릴리즈 포인트 일관성만 비교
  var _msx=0,_msy=0; pts.forEach(function(p){_msx+=p.sx;_msy+=p.sy;}); _msx/=pts.length; _msy/=pts.length;
  pts.forEach(function(p){ p.hx=_msx+(p.hx-p.sx); p.hy=_msy+(p.hy-p.sy); p.sx=_msx; p.sy=_msy; });
  var xs=[],ys=[]; pts.forEach(function(p){xs.push(p.hx,p.sx);ys.push(p.hy,p.sy);});
  var xr=autoRange([xs],0.12), yr=autoRange([ys],0.12);
  var pr={x:50,y:18,w:Math.max(10,w-64),h:Math.max(10,h-34)};
  ctx.strokeStyle='#3a4452';ctx.lineWidth=1; ctx.strokeRect(pr.x,pr.y,pr.w,pr.h);
  ctx.font='10px system-ui'; ctx.fillStyle='#a9b4c2';
  function gx(v){return pr.x+(v-xr[0])/(xr[1]-xr[0])*pr.w;} function gy(v){return pr.y+pr.h-(v-yr[0])/(yr[1]-yr[0])*pr.h;}
  // grid ticks
  var xs2=niceStep(xr[1]-xr[0],5), ys2=niceStep(yr[1]-yr[0],5);
  ctx.textAlign='center';ctx.textBaseline='top'; for(var vx=Math.ceil(xr[0]/xs2)*xs2; vx<=xr[1]; vx+=xs2){ var x=gx(vx); ctx.strokeStyle='#252d3a';ctx.beginPath();ctx.moveTo(x,pr.y);ctx.lineTo(x,pr.y+pr.h);ctx.stroke(); ctx.fillStyle='#7d8898';ctx.fillText(Math.round(vx),x,pr.y+pr.h+4); }
  ctx.textAlign='right';ctx.textBaseline='middle'; for(var vy=Math.ceil(yr[0]/ys2)*ys2; vy<=yr[1]; vy+=ys2){ var y=gy(vy); ctx.strokeStyle='#252d3a';ctx.beginPath();ctx.moveTo(pr.x,y);ctx.lineTo(pr.x+pr.w,y);ctx.stroke(); ctx.fillStyle='#7d8898';ctx.fillText(Math.round(vy),pr.x-4,y); }
  // axis labels
  ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.textBaseline='top'; ctx.fillText(ax.xlabel,pr.x+pr.w/2,pr.y+pr.h+16);
  ctx.save();ctx.translate(12,pr.y+pr.h/2);ctx.rotate(-Math.PI/2);ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(ax.ylabel,0,0);ctx.restore();
  ctx.textAlign='left';ctx.textBaseline='top';ctx.fillStyle='#c9d3e0';ctx.font='11px system-ui';ctx.fillText(ax.title,pr.x+2,pr.y-14);
  function col(cl){ return cl==='fast'?'#3ecf8e':cl==='slow'?'#ff6b6b':'rgba(169,180,194,0.55)'; }
  pts.forEach(function(p){ var cc=col(p.cls); ctx.strokeStyle=cc; ctx.globalAlpha=p.cls==='norm'?0.45:1; ctx.lineWidth=p.cls==='norm'?1:2.2; ctx.beginPath(); ctx.moveTo(gx(p.sx),gy(p.sy)); ctx.lineTo(gx(p.hx),gy(p.hy)); ctx.stroke(); ctx.globalAlpha=1; });
  pts.forEach(function(p){ var cc=col(p.cls); ctx.fillStyle=cc; ctx.beginPath(); ctx.arc(gx(p.hx),gy(p.hy), p.cls==='norm'?3:5.5, 0, 2*Math.PI); ctx.fill(); if(p.cls!=='norm'){ ctx.strokeStyle='#0b0d12';ctx.lineWidth=1;ctx.stroke(); } });
  // 어깨 공통 원점 마커 (모든 선의 출발점)
  ctx.strokeStyle='#e8ecf2';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(gx(_msx),gy(_msy),4.5,0,2*Math.PI);ctx.stroke();
  // legend
  ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillStyle='#e8ecf2';ctx.fillText('◯ 어깨(공통원점)',pr.x+pr.w-118,pr.y-12);
  ctx.fillStyle='#3ecf8e';ctx.fillText('● 빠른 공',pr.x+pr.w-118,pr.y+2);
  ctx.fillStyle='#ff6b6b';ctx.fillText('● 느린 공',pr.x+pr.w-118,pr.y+15);
  ctx.fillStyle='#7d8898';ctx.fillText('● 그 외 (선=암슬롯)',pr.x+pr.w-118,pr.y+28);
}

function renderArm(trial){
  var fast=_fastTrial()||trial, slow=_slowTrial();
  var W={startEv:'i_fc',startOff:-0.2,endEv:'i_br',endOff:0.2};
  // ① 어깨 외회전 각도 + 내회전 각속도
  plotWin('ch-sher',Object.assign({fast:fast,slow:slow,
    left:{label:'외회전 각도 (°)', lines:[{compute:function(t){return t.series.Pitching_Shoulder_Angle_Z;}, color:'#5bd3ff', label:'어깨 외회전(ER)', width:2.6}]},
    right:{label:'내회전 각속도 (°/s)', lines:[{compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z; return a?a.map(function(v){return -v;}):null;}, color:'#4a90c8', label:'내회전 각속도', width:2.0}]}},W));
  // ② 견갑골 장전 (수평 외전 = 어깨 수평내전 −부호)
  plotWin('ch-shhad',Object.assign({fast:fast,slow:slow,
    left:{label:'수평 외전 (°)', lines:[{compute:function(t){var a=t.series.Pitching_Shoulder_Angle_X; return a?a.map(function(v){return -v;}):null;}, color:'#3ecf8e', label:'견갑 장전(수평외전 +)', width:2.6}]}},W));
  // ③ 팔꿈치 굴곡-신전 각도 + 각속도
  plotWin('ch-elb',Object.assign({fast:fast,slow:slow,
    left:{label:'굴곡 각도 (°)', lines:[{compute:function(t){return t.series.Pitching_Elbow_Angle_X;}, color:'#5bd3ff', label:'팔꿈치 각도(굴곡+)', width:2.6}]},
    right:{label:'각속도 (°/s)', lines:[{compute:function(t){return t.series.Pitching_Elbow_Ang_Vel_X;}, color:'#4a90c8', label:'팔꿈치 각속도', width:2.0}]}},W));
  // ④ 릴리즈 포인트 + 암슬롯 (모든 투구)
  _relScatter('ch-rel-home',{ix:0,iy:1,xlabel:'좌우 (mm, 어깨기준)',ylabel:'높이 (mm, 어깨기준)',title:'홈플레이트 뷰 (정면) · 어깨관절 정렬'});
  _relScatter('ch-rel-3b',  {ix:2,iy:1,xlabel:'전후 (mm, 어깨기준)',ylabel:'높이 (mm, 어깨기준)',title:'3루 뷰 (측면) · 어깨관절 정렬'});
  var es=document.getElementById('ev-sher');
  if(es) es.innerHTML=_evCard(fast,'어깨(빠른 공)',[
    {label:'외회전 각도', key:'Pitching_Shoulder_Angle_Z', unit:'°'},
    {label:'내회전 각속도', arr:(fast.series.Pitching_Shoulder_Ang_Vel_Z||[]).map(function(v){return -v;}), unit:'°/s'},
  ]);
  var eh=document.getElementById('ev-shhad');
  if(eh) eh.innerHTML=_evCard(fast,'견갑 장전(빠른 공)',[
    {label:'수평 외전', arr:(fast.series.Pitching_Shoulder_Angle_X||[]).map(function(v){return -v;}), unit:'°'},
  ]);
  var ee=document.getElementById('ev-elb');
  if(ee) ee.innerHTML=_evCard(fast,'팔꿈치(빠른 공)',[
    {label:'굴곡 각도', key:'Pitching_Elbow_Angle_X', unit:'°'},
    {label:'각속도', key:'Pitching_Elbow_Ang_Vel_X', unit:'°/s'},
  ]);
}

function _trialByVelo(pickMax){ if(typeof DATA==='undefined'||!DATA.trials||!DATA.trials.length) return null; var ts=DATA.trials.filter(function(t){return t.rapsodo&&t.rapsodo.velocity_kmh!=null;}); if(ts.length){ var best=ts[0]; ts.forEach(function(t){ if(pickMax? t.rapsodo.velocity_kmh>best.rapsodo.velocity_kmh : t.rapsodo.velocity_kmh<best.rapsodo.velocity_kmh) best=t; }); return best; }
  // 폴백: rapsodo(구속) 없으면 COM 전진속도 peak로 빠른/느린 구분 (코호트 등 마커리스 전용)
  function _cv(t){ var a=t.series&&t.series.COM_Velocity_Y; if(!a)return null; var lo=(t.events&&t.events.i_kl_peak)||0, hi=(t.events&&t.events.i_br)||a.length-1, v=-Infinity; for(var i=lo;i<=hi&&i<a.length;i++){ if(isFinite(a[i])&&a[i]>v)v=a[i]; } return v===-Infinity?null:v; }
  var cand=DATA.trials.filter(function(t){return _cv(t)!=null;}); if(!cand.length) return null; var b=cand[0], bv=_cv(b); cand.forEach(function(t){ var v=_cv(t); if(pickMax? v>bv : v<bv){ b=t; bv=v; } }); return b; }
function _fastTrial(){ return _trialByVelo(true); }
function _slowTrial(){ var f=_fastTrial(), s=_trialByVelo(false); return (s&&s!==f)?s:null; }
function _dvel(arr,dt,sign){ if(!arr) return null; sign=sign||1; var o=new Array(arr.length); for(var i=0;i<arr.length;i++){ o[i]=(i===0||!isFinite(arr[i])||!isFinite(arr[i-1]))?NaN:(arr[i]-arr[i-1])/dt*sign; } return o; }
function _yfmt(v,step){ return step<0.1?v.toFixed(2):step<1?v.toFixed(1):String(Math.round(v)); }
// ── 윈도우(이벤트 상대 시간) · 듀얼축(좌/우) · 듀얼trial(빠름 실선/느림 점선) 플롯 ──
// opt: {fast, slow, startEv, startOff, endEv, endOff, left:{label,lines:[{compute(t),color,label,width}]}, right:{...}}
function plotWin(canvasId, opt){
  var canvas=document.getElementById(canvasId); if(!canvas) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var fast=opt.fast, slow=opt.slow;
  if(!fast){ ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('— 구속 데이터 없음 —', w/2, h/2); return; }
  var dt=fast.meta.dt, ffc=(fast.events.i_fc||0);
  function evT(ev){ if(ev==='i_fc')return 0; if(ev==null)return 0; var e=fast.events[ev]; return e==null?0:(e-ffc)*dt; }
  var tMin=evT(opt.startEv)+(opt.startOff||0), tMax=evT(opt.endEv)+(opt.endOff||0);
  if(tMax<=tMin) tMax=tMin+0.1;
  var N=Math.max(2, Math.round((tMax-tMin)/dt)+1);
  function sample(trial, compute){ var arr=null; try{arr=compute(trial);}catch(e){} if(!arr) return null; var tdt=trial.meta.dt, tfc=(trial.events.i_fc||0), out=new Array(N); for(var k=0;k<N;k++){ var t=tMin+k*dt; var idx=Math.round(tfc+t/tdt); out[k]=(idx>=0&&idx<arr.length&&isFinite(arr[idx]))?arr[idx]:NaN; } return out; }
  var groups=[]; if(opt.left) groups.push({g:opt.left,side:'L'}); if(opt.right) groups.push({g:opt.right,side:'R'});
  function _sampleAll(compute){ var trials=(typeof DATA!=='undefined'&&DATA.trials&&DATA.trials.length)?DATA.trials:[fast]; var ser=[]; for(var ti=0;ti<trials.length;ti++){ var s=sample(trials[ti],compute); if(s)ser.push(s); } if(!ser.length)return null; var mean=new Array(N),sd=new Array(N); for(var k=0;k<N;k++){ var vv=[]; for(var j=0;j<ser.length;j++){ var v=ser[j][k]; if(isFinite(v))vv.push(v); } if(!vv.length){mean[k]=NaN;sd[k]=NaN;continue;} var mm=0,a; for(a=0;a<vv.length;a++)mm+=vv[a]; mm/=vv.length; var sq=0,b; for(b=0;b<vv.length;b++)sq+=(vv[b]-mm)*(vv[b]-mm); mean[k]=mm; sd[k]=vv.length>1?Math.sqrt(sq/(vv.length-1)):0; } return {mean:mean,sd:sd,n:ser.length}; }
  var _pcmp=(typeof _cmpOn!=='undefined'&&_cmpOn), _pcmpT=_pcmp?((typeof _cmpTrial==='function')?_cmpTrial():null):null;
  groups.forEach(function(G){ var all=[]; G.series=[]; G.g.lines.forEach(function(ln){ var sf=sample(fast,ln.compute), ss=slow?sample(slow,ln.compute):null; var band=(_tsMode==='band')?_sampleAll(ln.compute):null; G.series.push({ln:ln,fast:sf,slow:ss,band:band}); if(_pcmp&&band){ all.push(band.mean); } else if(_tsMode==='band'&&band){ var up=[],dn=[]; for(var k=0;k<N;k++){ if(isFinite(band.mean[k])){ var e=isFinite(band.sd[k])?band.sd[k]:0; up.push(band.mean[k]+e); dn.push(band.mean[k]-e); } } all.push(up); all.push(dn); } else { if(sf)all.push(sf); if(ss)all.push(ss); }
    // [선수 비교] 상대 선수 곡선도 y범위에 포함 — 크기가 다르면 두 선수 다 보이게 오토스케일
    if(_pcmp&&_pcmpT){ var cs=sample(_pcmpT,ln.compute); if(cs)all.push(cs); }
  }); G.range=autoRange(all); });
  var curves=[]; groups.forEach(function(G){ G.series.forEach(function(s){ curves.push({ln:s.ln, side:G.side, axisLabel:G.g.label, fast:s.fast}); }); });
  var GW = (curves.length && !opt.noGauge) ? (opt.gaugeW||154) : 0;
  var rax = opt.right?50:14;
  var pr={x:52,y:8,w:Math.max(60,w-52-rax-GW),h:Math.max(10,h-30)};
  ctx.strokeStyle='#3a4452'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(pr.x,pr.y); ctx.lineTo(pr.x,pr.y+pr.h); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pr.x,pr.y+pr.h); ctx.lineTo(pr.x+pr.w,pr.y+pr.h); ctx.stroke();
  ctx.font='10px system-ui'; var xStep=niceStep(tMax-tMin,5), tS=Math.ceil(tMin/xStep)*xStep;
  ctx.textAlign='center'; ctx.textBaseline='top';
  for(var t=tS;t<=tMax+xStep*0.01;t+=xStep){ var fr=(t-tMin)/(tMax-tMin), x=pr.x+fr*pr.w; ctx.strokeStyle='#252d3a'; ctx.beginPath(); ctx.moveTo(x,pr.y); ctx.lineTo(x,pr.y+pr.h); ctx.stroke(); ctx.fillStyle=Math.abs(t)<0.01?'#5bd3ff':'#a9b4c2'; ctx.fillText(Math.abs(t)<1e-6?'0':t.toFixed(1),x,pr.y+pr.h+5); }
  ctx.fillStyle='#7d8898'; ctx.textAlign='right'; ctx.textBaseline='bottom'; ctx.fillText('time from FC (s)', pr.x+pr.w, pr.y+pr.h+28);
  function drawY(range,side,label){ var lo=range[0],hi=range[1],step=niceStep(hi-lo,4),st=Math.ceil(lo/step)*step; ctx.textBaseline='middle'; for(var v=st;v<=hi+step*0.01;v+=step){ var y=pr.y+pr.h-(v-lo)/(hi-lo)*pr.h; if(side==='L'){ ctx.strokeStyle='#252d3a'; ctx.beginPath(); ctx.moveTo(pr.x,y); ctx.lineTo(pr.x+pr.w,y); ctx.stroke(); ctx.textAlign='right'; ctx.fillStyle='#a9b4c2'; ctx.fillText(_yfmt(v,step),pr.x-5,y); } else { ctx.textAlign='left'; ctx.fillStyle='#c9a14a'; ctx.fillText(_yfmt(v,step),pr.x+pr.w+5,y); } } if(label){ ctx.save(); if(side==='L'){ctx.translate(12,pr.y+pr.h/2);}else{ctx.translate(pr.x+pr.w+rax-6,pr.y+pr.h/2);} ctx.rotate(-Math.PI/2); ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(label,0,0); ctx.restore(); } }
  groups.forEach(function(G){ drawY(G.range,G.side,G.g.label); });
  // ── 이벤트선 + 라벨(중복 제거 + 겹침 방지 스태거) ──
  var _evBuiltin=[['KH','i_kl_peak','#7d8898'],['FC','i_fc','#3b82f6'],['MER','i_mer','#f5c542'],['BR','i_br','#ff4d4d']];
  var _exSet={}; if(opt.extraEvents){ opt.extraEvents.forEach(function(ev){ if(ev&&ev.label)_exSet[ev.label]=1; }); }
  var _allEv=[];
  if(!opt.noBuiltinEv) _evBuiltin.forEach(function(e){ if(_exSet[e[0]])return; var ei=fast.events[e[1]]; if(ei==null)return; var tt=(ei-ffc)*dt; if(tt<tMin||tt>tMax)return; _allEv.push({label:e[0],x:pr.x+(tt-tMin)/(tMax-tMin)*pr.w,color:e[2]}); });
  if(opt.extraEvents){ opt.extraEvents.forEach(function(ev){ if(ev==null||ev.frame==null)return; var tt=(ev.frame-ffc)*dt; if(tt<tMin||tt>tMax)return; _allEv.push({label:ev.label,x:pr.x+(tt-tMin)/(tMax-tMin)*pr.w,color:ev.color||'#8893a4',width:ev.width,text:ev.text}); }); }
  _allEv.sort(function(a,b){return a.x-b.x;});
  ctx.setLineDash([3,3]); ctx.font='9px system-ui'; ctx.textBaseline='top';
  var _rowR=[-1e9,-1e9,-1e9];
  _allEv.forEach(function(e){
    ctx.lineWidth=e.width||1; ctx.strokeStyle=e.color; ctx.beginPath(); ctx.moveTo(e.x,pr.y); ctx.lineTo(e.x,pr.y+pr.h); ctx.stroke(); ctx.lineWidth=1;
    var _lbl=e.text||e.label; ctx.font=(e.width&&e.width>=2.5)?'bold 10px system-ui':'9px system-ui';
    var tw=ctx.measureText(_lbl).width, row=-1;
    for(var r=0;r<3;r++){ if(e.x-tw/2 >= _rowR[r]+4){ row=r; break; } } if(row<0)row=2;
    _rowR[row]=e.x+tw/2;
    ctx.fillStyle=e.color; ctx.textAlign='center'; ctx.fillText(_lbl, e.x, pr.y+1+row*10);
  });
  ctx.setLineDash([]);
  function dl(arr,color,range,dash,width){ if(!arr)return; var lo=range[0],hi=range[1]; ctx.save(); if(dash){ctx.setLineDash([4,3]); ctx.globalAlpha=0.6;} ctx.strokeStyle=color; ctx.lineWidth=width||2.2; ctx.lineJoin='round'; ctx.beginPath(); var first=true; for(var k=0;k<arr.length;k++){ var v=arr[k]; if(!isFinite(v)){first=true;continue;} var x=pr.x+k/(arr.length-1)*pr.w, y=pr.y+pr.h-(v-lo)/(hi-lo)*pr.h; if(first){ctx.moveTo(x,y);first=false;}else ctx.lineTo(x,y); } ctx.stroke(); ctx.restore(); }
  function _drawBand(band,color,range){ if(!band)return; var lo=range[0],hi=range[1]; ctx.save(); ctx.fillStyle=color; ctx.globalAlpha=0.16; ctx.beginPath(); var started=false,j; for(j=0;j<N;j++){ var m1=band.mean[j]; if(!isFinite(m1))continue; var e=isFinite(band.sd[j])?band.sd[j]:0; var x=pr.x+j/(N-1)*pr.w, y=pr.y+pr.h-((m1+e)-lo)/(hi-lo)*pr.h; if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y); } for(j=N-1;j>=0;j--){ var m2=band.mean[j]; if(!isFinite(m2))continue; var e2=isFinite(band.sd[j])?band.sd[j]:0; var x2=pr.x+j/(N-1)*pr.w, y2=pr.y+pr.h-((m2-e2)-lo)/(hi-lo)*pr.h; ctx.lineTo(x2,y2); } ctx.closePath(); ctx.fill(); ctx.restore(); }
  // [선수 비교] 두 선수 비교 모드에서는 표준편차 띠를 없애고 평균선끼리 비교(디폴트는 평균±SD 띠)
  var _playerCmp=(typeof _cmpOn!=='undefined'&&_cmpOn);
  groups.forEach(function(G){ G.series.forEach(function(s){
    if(_playerCmp&&s.band){ dl(s.band.mean,s.ln.color,G.range,false,(s.ln.width||2.2)+0.6); }                 // 본인 평균선만(SD 띠 제거)
    else if(_tsMode==='band'&&s.band){ _drawBand(s.band,s.ln.color,G.range); dl(s.band.mean,s.ln.color,G.range,false,(s.ln.width||2.2)+0.6); }  // 일관성: 평균±1SD
    else { dl(s.fast,s.ln.color,G.range,false,s.ln.width); dl(s.slow,s.ln.color,G.range,true,s.ln.width); }   // 빠른공 vs 느린공
  }); });
  // ── 두 선수 비교 오버레이: 상대 선수 대표 trial 곡선(보라 점선) ──
  if(_playerCmp){ var _ct=_cmpTrial(); if(_ct){ groups.forEach(function(G){ G.series.forEach(function(s){ var cs=sample(_ct,s.ln.compute); if(cs) dl(cs,_CMP_COL,G.range,true,(s.ln.width||2.2)+0.4); }); }); } }
  // ── 곡선별 의미있는 피크 마커(opt.markPeaks) — 점+값 (윈도우 내 최대) ──
  if(opt.markPeaks){ groups.forEach(function(G){ G.series.forEach(function(s){
    var arr=(_tsMode==='band'&&s.band)?s.band.mean:s.fast; if(!arr) return;
    var bi=null,bv=-Infinity; for(var k=0;k<arr.length;k++){ var v=arr[k]; if(isFinite(v)&&v>bv){bv=v;bi=k;} }
    if(bi==null) return; var lo=G.range[0],hi=G.range[1];
    var x=pr.x+bi/(arr.length-1)*pr.w, y=pr.y+pr.h-(bv-lo)/(hi-lo)*pr.h;
    ctx.fillStyle=s.ln.color; ctx.beginPath(); ctx.arc(x,y,3.6,0,2*Math.PI); ctx.fill(); ctx.strokeStyle='#0b0d12'; ctx.lineWidth=1; ctx.stroke();
    ctx.fillStyle=s.ln.color; ctx.font='bold 10px system-ui'; ctx.textAlign='center'; ctx.textBaseline='bottom'; ctx.fillText(Math.round(bv)+(G.side==='R'?'':''), x, y-4);
  }); }); }
  ctx.font='10px system-ui'; var lx=pr.x+8, ly=pr.y+4;
  groups.forEach(function(G){ G.series.forEach(function(s){ ctx.fillStyle=s.ln.color; ctx.fillRect(lx,ly+4,12,3); ctx.fillStyle='#a9b4c2'; ctx.textAlign='left'; ctx.textBaseline='top'; var lbl=s.ln.label+(G.side==='R'?' (우축)':''); ctx.fillText(lbl,lx+15,ly); lx+=ctx.measureText(lbl).width+28; }); });
  // (가독성) 평균/띠/n·구속 캡션 제거 — 비교 모드일 때만 상대 선수 표기
  if(typeof _cmpOn!=='undefined'&&_cmpOn){ var _cp=_cmpPlayer(); if(_cp){ ctx.fillStyle='#7d8898'; ctx.textAlign='left'; ctx.textBaseline='top'; ctx.fillText('보라 점선='+_cp.name, pr.x+8, ly+13); } }
  // ── 스틱 재생 동기화 세로 커서 ──
  var ptr=(typeof window!=='undefined'&&window._playTrial)?window._playTrial:fast;
  var pfi=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:(ptr.events.i_br||0);
  var ptime=(pfi-(ptr.events.i_fc||0))*((ptr.meta&&ptr.meta.dt)||dt);
  if(ptime>=tMin&&ptime<=tMax){ var cxp=pr.x+(ptime-tMin)/(tMax-tMin)*pr.w; ctx.save(); ctx.strokeStyle='#ffffff'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(cxp,pr.y); ctx.lineTo(cxp,pr.y+pr.h); ctx.stroke(); ctx.restore(); }
  // ── 임펄스: 곡선과 0선 사이 면적을 현재 프레임까지 채움 + 누적 임펄스 숫자 ──
  if(opt.fillToZero && groups.length && groups[0].series.length){
    var _G0=groups[0], _s0=_G0.series[0], _lo=_G0.range[0], _hi=_G0.range[1];
    if(_s0&&_s0.fast){
      var _y0=pr.y+pr.h-(0-_lo)/(_hi-_lo)*pr.h; _y0=Math.max(pr.y,Math.min(pr.y+pr.h,_y0));
      var _kC=Math.round((ptime-tMin)/(tMax-tMin)*(_s0.fast.length-1)); _kC=Math.max(0,Math.min(_s0.fast.length-1,_kC));
      ctx.save(); ctx.fillStyle=_s0.ln.color; ctx.globalAlpha=0.22; ctx.beginPath(); var _st=false,_xc=pr.x;
      for(var _k=0;_k<=_kC;_k++){ var _v=_s0.fast[_k]; if(!isFinite(_v))continue; var _x=pr.x+_k/(_s0.fast.length-1)*pr.w, _y=pr.y+pr.h-(_v-_lo)/(_hi-_lo)*pr.h; if(!_st){ctx.moveTo(_x,_y0);ctx.lineTo(_x,_y);_st=true;}else ctx.lineTo(_x,_y); _xc=_x; }
      if(_st){ ctx.lineTo(_xc,_y0); ctx.closePath(); ctx.fill(); }
      ctx.restore();
      var _imp=null; try{ var _ps=_WG.data.fast.series.propImpPct; if(_ps){ var _pf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):(_ps.length-1); _imp=_ps[Math.max(0,Math.min(_ps.length-1,_pf))]; } }catch(e){}
      if(_imp!=null&&isFinite(_imp)){ ctx.save(); ctx.fillStyle=_s0.ln.color; ctx.font='bold 13px system-ui'; ctx.textAlign='left'; ctx.textBaseline='top'; ctx.fillText('임펄스 '+_imp+' %BW·s', pr.x+10, pr.y+22); ctx.restore(); }
    }
  }
  // ── 곡선별 다이나믹 게이지 (우측 스트립, 재생 동기화) ──
  if(GW>0){
    var sx=pr.x+pr.w+rax, sw=GW-8, n=curves.length, gh=pr.h/n;
    curves.forEach(function(cu,ci){
      var gy0=pr.y+ci*gh+2, ghi=gh-4;
      var arr=null; try{arr=cu.ln.compute(ptr);}catch(e){}
      var val=(arr&&pfi>=0&&pfi<arr.length&&isFinite(arr[pfi]))?arr[pfi]:0;
      var mx=0; if(cu.fast){for(var gi=0;gi<cu.fast.length;gi++){if(isFinite(cu.fast[gi])&&Math.abs(cu.fast[gi])>mx)mx=Math.abs(cu.fast[gi]);}} if(mx<=0)mx=1;
      var col=cu.ln.color||'#5bd3ff', isForce=/\(N\)|%BW|W\)/.test(cu.axisLabel||'');
      ctx.save(); ctx.fillStyle=col; ctx.font='10px system-ui'; ctx.textAlign='left'; ctx.textBaseline='top'; var clbl=cu.ln.label; if(clbl.length>13)clbl=clbl.slice(0,13); ctx.fillText(clbl, sx+2, gy0+1);
      var f=Math.max(0,Math.min(1,Math.abs(val)/mx));
      if(isForce){
        var bx=sx+6, bw=16, bh=Math.max(16,ghi-32), by=gy0+16; ctx.fillStyle='#243043'; ctx.fillRect(bx,by,bw,bh); ctx.fillStyle=col; ctx.fillRect(bx,by+bh*(1-f),bw,bh*f);
        ctx.fillStyle=col; ctx.font='bold 17px system-ui'; ctx.textAlign='left'; ctx.textBaseline='middle'; ctx.fillText(Math.round(val), bx+24, by+bh/2);
      } else {
        var cx2=sx+sw/2, R=Math.min(sw/2-8, ghi/2-4, opt.gaugeW?70:30), cy2=gy0+18+R, ang=Math.PI*(1-f);
        ctx.strokeStyle='#2c3442'; ctx.lineWidth=5; ctx.beginPath(); ctx.arc(cx2,cy2,R,Math.PI,2*Math.PI); ctx.stroke();
        ctx.strokeStyle=col; ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(cx2,cy2); ctx.lineTo(cx2+R*Math.cos(ang),cy2-R*Math.sin(ang)); ctx.stroke();
        ctx.fillStyle=col; ctx.beginPath(); ctx.arc(cx2,cy2,4,0,2*Math.PI); ctx.fill();
        ctx.fillStyle=col; ctx.font='bold 17px system-ui'; ctx.textAlign='center'; ctx.textBaseline='bottom'; ctx.fillText(Math.round(Math.abs(val)), cx2, cy2-2);
      }
      ctx.restore();
    });
  }
}
// ── 위상도(힘-각도 고리): y(토크) vs x(각속도), 파워 부호로 색칠, FC→BR ──
function plotLoop(canvasId, opt){
  var canvas=document.getElementById(canvasId); if(!canvas) return;
  var c=clearC(canvas), ctx=c.ctx, w=c.w, h=c.h;
  var fast=opt.fast, slow=opt.slow;
  if(!fast){ ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('— 구속 데이터 없음 —', w/2, h/2); return; }
  function win(trial,compute){ var dt=trial.meta.dt, fc=(trial.events.i_fc||0);
    function evi(ev,off){ var e=trial.events[ev]; if(e==null)e=fc; return Math.round(e+(off||0)/dt); }
    var i0=evi(opt.startEv,opt.startOff), i1=evi(opt.endEv,opt.endOff); if(i1<i0){var t=i0;i0=i1;i1=t;}
    var arr=null; try{arr=compute(trial);}catch(e){} if(!arr) return null;
    var out=[]; for(var i=i0;i<=i1;i++) out.push((i>=0&&i<arr.length&&isFinite(arr[i]))?arr[i]:NaN); return out; }
  function trip(t){ return {x:win(t,opt.xCompute), y:win(t,opt.yCompute), p:opt.powCompute?win(t,opt.powCompute):null}; }
  var F=trip(fast), Sx=slow?trip(slow):null;
  var xs=[],ys=[]; [F,Sx].forEach(function(T){ if(!T)return; (T.x||[]).forEach(function(v){if(isFinite(v))xs.push(v);}); (T.y||[]).forEach(function(v){if(isFinite(v))ys.push(v);}); });
  if(!xs.length){ ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('— 데이터 없음 —', w/2, h/2); return; }
  var xr=autoRange([xs]), yr=autoRange([ys]);
  if(xr[0]>0)xr[0]=0; if(xr[1]<0)xr[1]=0; if(yr[0]>0)yr[0]=0; if(yr[1]<0)yr[1]=0;
  var pr={x:54,y:10,w:Math.max(60,w-54-16),h:Math.max(10,h-42)};
  var X=function(v){return pr.x+(v-xr[0])/((xr[1]-xr[0])||1)*pr.w;};
  var Y=function(v){return pr.y+pr.h-(v-yr[0])/((yr[1]-yr[0])||1)*pr.h;};
  ctx.font='10px system-ui';
  var xstep=niceStep(xr[1]-xr[0],5), ystep=niceStep(yr[1]-yr[0],4);
  for(var gx=Math.ceil(xr[0]/xstep)*xstep; gx<=xr[1]+1e-6; gx+=xstep){ var px=X(gx); ctx.strokeStyle='#252d3a'; ctx.beginPath(); ctx.moveTo(px,pr.y); ctx.lineTo(px,pr.y+pr.h); ctx.stroke(); ctx.fillStyle='#a9b4c2'; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillText(_yfmt(gx,xstep),px,pr.y+pr.h+4); }
  for(var gy=Math.ceil(yr[0]/ystep)*ystep; gy<=yr[1]+1e-6; gy+=ystep){ var py=Y(gy); ctx.strokeStyle='#252d3a'; ctx.beginPath(); ctx.moveTo(pr.x,py); ctx.lineTo(pr.x+pr.w,py); ctx.stroke(); ctx.fillStyle='#a9b4c2'; ctx.textAlign='right'; ctx.textBaseline='middle'; ctx.fillText(_yfmt(gy,ystep),pr.x-5,py); }
  ctx.strokeStyle='#3a4452'; ctx.lineWidth=1.4;
  if(yr[0]<0&&yr[1]>0){ ctx.beginPath(); ctx.moveTo(pr.x,Y(0)); ctx.lineTo(pr.x+pr.w,Y(0)); ctx.stroke(); }
  if(xr[0]<0&&xr[1]>0){ ctx.beginPath(); ctx.moveTo(X(0),pr.y); ctx.lineTo(X(0),pr.y+pr.h); ctx.stroke(); }
  ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillText(opt.xLabel||'', pr.x+pr.w/2, pr.y+pr.h+18);
  ctx.save(); ctx.translate(12,pr.y+pr.h/2); ctx.rotate(-Math.PI/2); ctx.textBaseline='middle'; ctx.fillStyle='#7d8898'; ctx.fillText(opt.yLabel||'',0,0); ctx.restore();
  function drawTraj(T,dash){ if(!T||!T.x)return; var x=T.x,y=T.y,p=T.p;
    for(var i=1;i<x.length;i++){ if(!isFinite(x[i])||!isFinite(y[i])||!isFinite(x[i-1])||!isFinite(y[i-1]))continue;
      var col=dash?'#6b7480':'#5bd3ff'; if(p&&isFinite(p[i])) col=(p[i]>=0)?'#3ecf8e':'#ff9e4d';
      ctx.strokeStyle=col; ctx.lineWidth=dash?1.5:2.4; ctx.globalAlpha=dash?0.5:1; if(dash)ctx.setLineDash([4,3]);else ctx.setLineDash([]);
      ctx.beginPath(); ctx.moveTo(X(x[i-1]),Y(y[i-1])); ctx.lineTo(X(x[i]),Y(y[i])); ctx.stroke(); }
    ctx.globalAlpha=1; ctx.setLineDash([]);
    var fi=-1,li=-1; for(var a=0;a<x.length;a++){if(isFinite(x[a])&&isFinite(y[a])){fi=a;break;}} for(var b=x.length-1;b>=0;b--){if(isFinite(x[b])&&isFinite(y[b])){li=b;break;}}
    if(fi>=0){ ctx.fillStyle='#3b82f6'; ctx.beginPath(); ctx.arc(X(x[fi]),Y(y[fi]),4,0,2*Math.PI); ctx.fill(); if(!dash){ctx.fillStyle='#cdd6e2';ctx.font='10px system-ui';ctx.textAlign='left';ctx.textBaseline='bottom';ctx.fillText('FC',X(x[fi])+5,Y(y[fi])-3);} }
    if(li>=0){ ctx.fillStyle='#ff4d4d'; ctx.beginPath(); ctx.arc(X(x[li]),Y(y[li]),4,0,2*Math.PI); ctx.fill(); if(!dash){ctx.fillStyle='#cdd6e2';ctx.textAlign='left';ctx.textBaseline='bottom';ctx.fillText('BR',X(x[li])+5,Y(y[li])-3);} }
  }
  if(Sx)drawTraj(Sx,true); drawTraj(F,false);
  // ── 스틱 재생 동기화 현재 프레임 마커 (위상도 트레이스) ──
  var ptr=(typeof window!=='undefined'&&window._playTrial)?window._playTrial:fast;
  var pfi=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:(ptr.events.i_br||0);
  var pfc=(ptr.events.i_fc||0), pbr=(ptr.events.i_br||0);
  if(pfi>=pfc && pfi<=pbr){
    var mxv=NaN,myv=NaN,mpv=NaN;
    try{ var _xa=opt.xCompute(ptr), _ya=opt.yCompute(ptr), _pa=opt.powCompute?opt.powCompute(ptr):null;
      if(_xa&&pfi<_xa.length)mxv=_xa[pfi]; if(_ya&&pfi<_ya.length)myv=_ya[pfi]; if(_pa&&pfi<_pa.length)mpv=_pa[pfi]; }catch(e){}
    if(isFinite(mxv)&&isFinite(myv)){
      var cxp=Math.max(pr.x,Math.min(pr.x+pr.w,X(mxv))), cyp=Math.max(pr.y,Math.min(pr.y+pr.h,Y(myv)));
      var mc=isFinite(mpv)?(mpv>=0?'#3ecf8e':'#ff9e4d'):'#ffffff';
      ctx.save(); ctx.fillStyle=mc; ctx.strokeStyle='#ffffff'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.arc(cxp,cyp,6,0,2*Math.PI); ctx.fill(); ctx.stroke();
      ctx.restore();
    }
  }
  ctx.font='10px system-ui'; ctx.textAlign='left'; ctx.textBaseline='top';
  ctx.fillStyle='#3ecf8e'; ctx.fillText('■ 생성(+)',pr.x+8,pr.y+2);
  ctx.fillStyle='#ff9e4d'; ctx.fillText('■ 흡수(−)',pr.x+70,pr.y+2);
  ctx.fillStyle='#7d8898'; ctx.fillText('실선=빠른 공·점선=느린 공',pr.x+8,pr.y+15);
}
function renderLower(trial){
  var fast=_fastTrial()||trial, slow=_slowTrial();
  // ① 뒷다리 고관절 외전속도 (+ 내회전속도는 IMU 전용 — Uplift 미산출이라 제외)
  var _hipLines=[{compute:function(t){return _dvel(t.series.Back_Hip_Angle_Y,t.meta.dt,-1);}, color:'#5bd3ff', label:'외전 속도', width:2.2}];
  var _nogLower=(typeof DATA!=='undefined'&&DATA.system&&/Uplift/i.test(DATA.system));
  if(!_nogLower) _hipLines.push({compute:function(t){return _dvel(t.series.Back_Hip_Angle_Z,t.meta.dt,1);}, color:'#9aa7b6', label:'내회전 속도', width:2.2});
  plotWin('ch-hip',{ fast:fast, slow:slow, startEv:'i_fc', startOff:-1.5, endEv:'i_fc', endOff:0, left:{ label:'각속도 (°/s)', lines:_hipLines }});
  // ② 앞다리 무릎 각도 + 각속도 (FC 0.2초 전 ~ 릴리스 0.2초 후)
  plotWin('ch-knee',{ fast:fast, slow:slow, startEv:'i_fc', startOff:-0.2, endEv:'i_br', endOff:0.2,
    left:{ label:'무릎 각도 (°)', lines:[
      {compute:function(t){return t.series.Lead_Knee_Angle_X;}, color:'#5bd3ff', label:'앞무릎 각도(굴곡+)', width:2.6}
    ]},
    right:{ label:'각속도 (°/s)', lines:[
      {compute:function(t){return _dvel(t.series.Lead_Knee_Angle_X,t.meta.dt,1);}, color:'#4a90c8', label:'앞무릎 각속도', width:2.0}
    ]}});
  var eh=document.getElementById('ev-hip');
  if(eh) eh.innerHTML=_evCard(fast,'뒷다리 고관절(빠른 공)',[
    {label:'외전 속도', arr:_dvel(fast.series.Back_Hip_Angle_Y,fast.meta.dt,-1), unit:'°/s'},
    {label:'내회전 속도', arr:_dvel(fast.series.Back_Hip_Angle_Z,fast.meta.dt,1), unit:'°/s'},
  ]);
  var ek=document.getElementById('ev-knee');
  if(ek) ek.innerHTML=_evCard(fast,'앞다리 무릎(빠른 공)',[
    {label:'무릎 각도', key:'Lead_Knee_Angle_X', unit:'°'},
    {label:'무릎 각속도', arr:_dvel(fast.series.Lead_Knee_Angle_X,fast.meta.dt,1), unit:'°/s'},
  ]);
}

function renderTrunk(trial){
  var fast=_fastTrial()||trial, slow=_slowTrial();
  var W={startEv:'i_fc',startOff:-0.2,endEv:'i_br',endOff:0.2};
  // ① 골반·몸통 회전 각도 + X-Factor
  plotWin('ch-pelvis',Object.assign({fast:fast,slow:slow,
    left:{label:'각도 (°)', lines:[
      {compute:function(t){return t.series.Pelvis_Angle_Z;}, color:'#5bd3ff', label:'골반 회전', width:2.4},
      {compute:function(t){return t.series.Trunk_Angle_Z;}, color:'#4a90c8', label:'몸통 회전', width:2.4},
      {compute:function(t){return t.series.Trunk_wrt_Pelvis_Angle_Z;}, color:'#9aa7b6', label:'X-Factor', width:2.6}
    ]}},W));
  // ② 골반·몸통 회전 속도
  plotWin('ch-trunk',Object.assign({fast:fast,slow:slow,
    left:{label:'각속도 (°/s)', lines:[
      {compute:function(t){return t.series.Pelvis_Ang_Vel_Z;}, color:'#5bd3ff', label:'골반 회전속도', width:2.4},
      {compute:function(t){return t.series.Thorax_Ang_Vel_Z;}, color:'#4a90c8', label:'몸통 회전속도', width:2.4}
    ]}},W));
  // ③ 몸통 굽힘 각도 + 각속도
  plotWin('ch-twrt',Object.assign({fast:fast,slow:slow,
    left:{label:'굽힘 각도 (°)', lines:[{compute:function(t){return t.series.Trunk_Angle_X;}, color:'#5bd3ff', label:'몸통 굽힘(굴곡+)', width:2.6}]},
    right:{label:'각속도 (°/s)', lines:[{compute:function(t){return _dvel(t.series.Trunk_Angle_X,t.meta.dt,1);}, color:'#4a90c8', label:'굽힘 각속도', width:2.0}]}},W));
  // ④ 몸통 좌우 기울기 각도 + 속도
  plotWin('ch-tlat',Object.assign({fast:fast,slow:slow,
    left:{label:'좌우기울기 (°)', lines:[{compute:function(t){return t.series.Trunk_Angle_Y;}, color:'#3ecf8e', label:'좌우 기울임', width:2.6}]},
    right:{label:'각속도 (°/s)', lines:[{compute:function(t){return _dvel(t.series.Trunk_Angle_Y,t.meta.dt,1);}, color:'#4a90c8', label:'기울임 각속도', width:2.0}]}},W));
  var P=document.getElementById('ev-pelvis');
  if(P) P.innerHTML=_evCard(fast,'회전·X-Factor(빠른 공)',[
    {label:'골반 회전', key:'Pelvis_Angle_Z', unit:'°'},
    {label:'몸통 회전', key:'Trunk_Angle_Z', unit:'°'},
    {label:'X-Factor', key:'Trunk_wrt_Pelvis_Angle_Z', unit:'°'},
  ]);
  var T=document.getElementById('ev-trunk');
  if(T) T.innerHTML=_evCard(fast,'회전 속도(빠른 공)',[
    {label:'골반 회전속도', key:'Pelvis_Ang_Vel_Z', unit:'°/s'},
    {label:'몸통 회전속도', key:'Thorax_Ang_Vel_Z', unit:'°/s'},
  ]);
  var Tw=document.getElementById('ev-twrt');
  if(Tw) Tw.innerHTML=_evCard(fast,'몸통 굽힘(빠른 공)',[
    {label:'굽힘 각도', key:'Trunk_Angle_X', unit:'°'},
    {label:'굽힘 각속도', arr:_dvel(fast.series.Trunk_Angle_X,fast.meta.dt,1), unit:'°/s'},
  ]);
  var Tl=document.getElementById('ev-tlat');
  if(Tl) Tl.innerHTML=_evCard(fast,'좌우 기울기(빠른 공)',[
    {label:'좌우 기울임', key:'Trunk_Angle_Y', unit:'°'},
    {label:'기울임 각속도', arr:_dvel(fast.series.Trunk_Angle_Y,fast.meta.dt,1), unit:'°/s'},
  ]);
}

function _rangeBarHTML(value, ref, big) {
  if (value == null || !isFinite(value)) return `<div class="range-bar empty"><span>— no data —</span></div>`;
  const [lo,hi] = ref.range;
  let status = (value < lo) ? 'below' : (value > hi ? 'above' : 'in');
  const pct = Math.max(0, Math.min(1, (value-lo)/(hi-lo))) * 100;
  const valTxt = value < 10 ? value.toFixed(2) : Math.round(value);
  return `<div class="range-bar ${status} ${big?'big':''}">
    <div class="range-value">${valTxt}<span class="range-unit">${ref.unit}</span></div>
    <div class="range-track"><div class="range-fill" style="width:${pct.toFixed(1)}%"></div><div class="range-marker" style="left:${pct.toFixed(1)}%"></div></div>
    <div class="range-scale"><span>${lo}</span><span class="range-mid">Pro range</span><span>${hi}</span></div>
  </div>`;
}
function renderSession() {
  const ss = DATA.session_summary;
  const set = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  const setH = (id, v) => { const e = document.getElementById(id); if (e) e.innerHTML = v; };
  if (!ss) return;
  const ks = ss.kseq||{}, xf = ss.x_factor||{}, st = ss.stride||{};
  set('ss-seq-pct', `${ks.sequence_pct_correct ?? '—'}%`);
  set('ss-seq-order', ks.most_common_order || 'Pelvis → Trunk → Arm');
  setH('ss-bar-pelvis', _rangeBarHTML(ks.pelvis_avg, REF_RANGES.pelvis_peak));
  setH('ss-bar-trunk',  _rangeBarHTML(ks.trunk_avg,  REF_RANGES.trunk_peak));
  setH('ss-bar-arm',    _rangeBarHTML(ks.arm_avg,    REF_RANGES.arm_peak));
  setH('ss-bar-gain',   _rangeBarHTML(ks.trunk_over_pelvis_gain_avg, REF_RANGES.speed_gain));
  set('ss-dt-pt', ks.pelvis_to_trunk_ms_avg != null ? `${ks.pelvis_to_trunk_ms_avg} ms` : '—');
  set('ss-dt-ta', ks.trunk_to_arm_ms_avg    != null ? `${ks.trunk_to_arm_ms_avg} ms` : '—');
  set('ss-arm-gain', ks.arm_over_trunk_gain_avg != null ? `${ks.arm_over_trunk_gain_avg.toFixed(2)}×` : '—');
  setH('ss-bar-xfactor', _rangeBarHTML(xf.max_avg, REF_RANGES.x_factor_max, true));
  set('ss-xf-sd', xf.max_sd != null ? `± ${xf.max_sd}°` : '');
  setH('ss-bar-stride', _rangeBarHTML(st.pct_height_avg, REF_RANGES.stride_pct, true));
  set('ss-stride-abs', st.length_m_avg != null ? `${st.length_m_avg.toFixed(2)} m` : '—');
  // 비효율 대시보드는 Uplift 전용 (Theia 3D 미산출) → 데이터 없으면 섹션 숨김
  // [2026-05-27] flying open(분리 풀림)을 비효율 첫 항목으로 항상 제시 — 하체→몸통→팔 전달 효율 대표 지표.
  const ieGrid = document.getElementById('ss-inefficiency-grid');
  const _foCard = (typeof _flyingOpenCardHTML==='function') ? _flyingOpenCardHTML(DATA.phases) : '';
  if (!ss.inefficiency_per_pitch || !Object.keys(ss.inefficiency_per_pitch).length) {
    if (ieGrid) {
      ieGrid.innerHTML = _foCard + `<div class="note">그 외 inefficiency flag(스웨이·조기 닫힘 등)는 Theia 3D 측정에서 산출하지 않습니다 (Uplift IMU 전용).</div>`;
      const h = ieGrid.previousElementSibling;
      if (h && h.classList.contains('ss-section-head') && !_foCard) h.style.display = 'none';
    }
    return;
  }
  const phases = ['wind_up','foot_contact','ball_release'];
  const html = phases.map(ph => {
    const cleanPct = (ss.phase_efficiency_pct||{})[ph];
    const keys = Object.keys(INEFFICIENCY_INFO).filter(k => INEFFICIENCY_INFO[k].phase === ph);
    const rows = keys.map(k => {
      const info = INEFFICIENCY_INFO[k];
      const rate = (ss.inefficiency_rates||{})[k] || {};
      const per = (ss.inefficiency_per_pitch||{})[k] || [];
      const flagged = rate.rate_pct && rate.rate_pct > 0;
      const cells = per.map((f,i) => `<span class="ie-cell ${f?'flagged':'clean'}" title="Pitch ${i+1}: ${f?'검출':'정상'}"></span>`).join('');
      return `<div class="ie-row ${flagged?'has-flag':'all-clean'}"><div class="ie-meta"><span class="ie-name">${info.label}</span><span class="ie-desc">${info.description}</span></div><div class="ie-rate">${rate.rate_pct!=null?Math.round(rate.rate_pct)+'%':'—'}</div><div class="ie-heatmap">${cells}</div></div>`;
    }).join('');
    return `<div class="ie-section"><div class="ie-section-head"><h4>${PHASE_LABELS[ph]}</h4><div class="ie-section-clean">${cleanPct ?? '—'}% pitches clean</div></div>${rows}</div>`;
  }).join('');
  setH('ss-inefficiency-grid', _foCard + html);
}

// ═══════════════════════════════════════════════════════════════════
// [2026-05-26] 자체 에너지전달 비효율 맵 (Uplift 플래그 대체) — 운동사슬(골반→몸통→팔) 에너지전달 관점 8요소.
//   앞무릎은 결함 아닌 '사용 유형'(신전/버팀/과굴곡)으로 중립 분류. 임계: 엘리트기준+코호트 상향.
// ═══════════════════════════════════════════════════════════════════
var ENERGY_IE = [
  {key:'seq_order',          label:'시퀀스 순서오류',     desc:'골반→몸통→팔 peak 순서 깨짐'},
  {key:'whip_gain',          label:'속도증폭 부족',       desc:'팔/몸통<3.0 또는 몸통/골반<1.5'},
  {key:'seq_timing',         label:'시퀀스 타이밍 이탈',   desc:'분절 지연이 효율구간 밖(몸통→팔 20~100ms)'},
  {key:'low_separation',     label:'분리 부족(X-Factor)', desc:'최대 X-Factor<30° (Uplift 네이티브 값)'},
  {key:'low_layback',        label:'레이백 부족',         desc:'최대 기하 레이백<165° (전완⊥상완 투영각)'},
  {key:'weak_drive',         label:'드라이브 부족',       desc:'COM 전진속도<2.6 m/s'},
  {key:'poor_distal_transfer',label:'말단 KE전달 부족',   desc:'상완 KE peak가 몸통 KE peak보다 <8프레임 뒤'}
];
function _eieFlags(t){
  var S=t.series||{}, ev=t.events||{}, k=t.kseq||{}, g=k.gains||{}, dl=k.deltas||{};
  var fc=ev.i_fc, br=ev.i_br, kl=ev.i_kl_peak||0;
  // [2026-05-26 FIX] 전역 peak() 미정의(브라우저)로 비효율 탭이 loading에서 멈추던 버그 → 자체 구현(절댓값 peak의 값/인덱스)
  function pkv(a,lo,hi){ a=a||[]; var b=null; for(var i=lo;i<=hi&&i<a.length;i++){ var x=a[i]; if(x!=null&&isFinite(x)&&(b==null||Math.abs(x)>Math.abs(b)))b=x; } return b; }
  function pki(a,lo,hi){ a=a||[]; var b=null,bi=null; for(var i=lo;i<=hi&&i<a.length;i++){ var x=a[i]; if(x!=null&&isFinite(x)&&(b==null||Math.abs(x)>Math.abs(b))){b=x;bi=i;} } return bi; }
  function mx(a,lo,hi){var m=null,i;for(i=lo;i<=hi&&i<(a||[]).length;i++){if(isFinite(a[i])&&(m==null||a[i]>m))m=a[i];}return m;}
  var f={};
  f.seq_order=(k.sequence_ok===false);
  f.whip_gain=((g.arm_over_trunk!=null&&g.arm_over_trunk<3.0)||(g.trunk_over_pelvis!=null&&g.trunk_over_pelvis<1.5));
  var ta=dl.trunk_to_arm_ms, pt=dl.pelvis_to_trunk_ms;
  f.seq_timing=((ta!=null&&(ta<20||ta>100))||(pt!=null&&(pt<10||pt>80)));
  var xf=(t.scalars&&t.scalars.max_x_factor!=null&&isFinite(t.scalars.max_x_factor))?t.scalars.max_x_factor:(function(){var xfa=t.x_factor&&t.x_factor.length?t.x_factor:S.Trunk_wrt_Pelvis_Angle_Z;return pkv(xfa,0,(xfa||[]).length-1);})();
  f.low_separation=(xf!=null&&xf<30);
  var lay=pkv(S.Pitching_Layback_X,fc,br); if(lay==null) lay=pkv(S.Pitching_Shoulder_Angle_Z,fc,br); f.low_layback=(lay!=null&&lay<165);
  var dv=pkv(S.COM_Velocity_Y,kl,br); f.weak_drive=(dv!=null&&dv<2.6);
  var tp=pki(S.Trunk_ME_X,fc,br), hp=pki(S.Pitching_Humerus_ME_X,fc,br);
  f.poor_distal_transfer=(tp!=null&&hp!=null&&(hp-tp)<8);
  var lk=S.Lead_Knee_Angle_X||[], kneeType='—';
  if(lk[fc]!=null&&lk[br]!=null){ var ext=lk[fc]-lk[br], add=mx(lk,fc,br)-lk[fc];
    kneeType=(ext>=13)?'신전형':(add>25?'과굴곡형':'버팀형'); }
  return {f:f, kneeType:kneeType};
}
function renderEnergyInefficiency(){
  var trials=(typeof DATA!=='undefined'&&DATA.trials)||[]; var n=trials.length||0;
  var rows=trials.map(_eieFlags);
  var body=document.getElementById('inefficiency-body');
  if(body){
    var html='<div class="card"><div style="font-size:14px;font-weight:800">운동사슬 에너지전달 비효율 — 자체 산출 (총 '+n+'구)</div>'
      +'<div class="note" style="margin-top:6px">운동사슬(골반→몸통→팔) <b>에너지 전달</b> 관점에서 키네마틱·에너지 변인으로 직접 판정한 비효율 요소입니다. 항목별 검출률:</div>';
    ENERGY_IE.forEach(function(it){ var c=rows.filter(function(r){return r.f[it.key];}).length, pct=n?Math.round(100*c/n):0;
      html+='<div style="display:flex;align-items:center;gap:8px;margin-top:6px"><div style="width:160px;font-size:13px;flex:0 0 160px">'+it.label+'</div>'
        +'<div style="flex:1;background:#1c2430;border-radius:6px;overflow:hidden;height:15px"><div style="width:'+pct+'%;height:100%;background:'+(pct>=50?'#e07a78':pct>=25?'#e8954e':'#46c98c')+'"></div></div>'
        +'<div style="flex:0 0 70px;text-align:right;font-size:12px">'+c+'/'+n+' ('+pct+'%)</div>'
        +'<div class="sub2" style="flex:0 0 auto;margin-left:6px">'+it.desc+'</div></div>';
    });
    var kt={'신전형':0,'버팀형':0,'과굴곡형':0}; rows.forEach(function(r){ if(kt[r.kneeType]!=null)kt[r.kneeType]++; });
    html+='<div class="note" style="margin-top:12px"><b>앞무릎 사용 유형</b> (결함이 아닌 중립 분류 · Theia식): '
      +'<span style="color:#5bb6e6">신전(vault)형 '+kt['신전형']+'</span> · <span style="color:#46c98c">버팀(흡수)형 '+kt['버팀형']+'</span> · <span style="color:#e8954e">과굴곡형 '+kt['과굴곡형']+'</span> 구</div></div>';
    body.innerHTML=html;
  }
  var grid=document.getElementById('ss-inefficiency-grid');
  if(grid){
    function rowHTML(label,cells){ return '<div class="ie-row"><div class="ie-meta"><span class="ie-name">'+label+'</span></div><div class="ie-heatmap">'+cells+'</div></div>'; }
    var h='';
    ENERGY_IE.forEach(function(it){ var cells=rows.map(function(r,i){return '<span class="ie-cell '+(r.f[it.key]?'flagged':'clean')+'" title="구'+(i+1)+': '+(r.f[it.key]?'검출':'정상')+'"></span>';}).join('');
      h+=rowHTML(it.label,cells); });
    var ktC={'신전형':'#5bb6e6','버팀형':'#46c98c','과굴곡형':'#e8954e','—':'#555'};
    var kc=rows.map(function(r,i){return '<span class="ie-cell" style="background:'+ktC[r.kneeType]+'" title="구'+(i+1)+': '+r.kneeType+'"></span>';}).join('');
    h+=rowHTML('무릎 사용 유형 (분류)',kc);
    grid.innerHTML=h;
    var head=grid.previousElementSibling; if(head&&head.classList&&head.classList.contains('ss-section-head')){ head.style.display=''; head.textContent='투구별 현황 · ●검출 ·정상 · 무릎=유형색(신전·버팀·과굴곡)'; }
  }
}

// ═══════════════════════════════════════════════════════════════════
// Render: 에너지 전달 진단 (etdiag) — [2026-05-27] 요청서 v5. 키네틱 체인 병목 진단 + 스토리텔링.
//   첫 화면: 핵심 진단 한 문장 · 9노드 흐름 지도 · Top3 병목 · 단계 카드(저장/생성/전달 태그+스토리) · 상세보기 링크.
// ═══════════════════════════════════════════════════════════════════
function _edCol(s){ return s==='good'?'var(--green)':s==='caution'?'var(--amber)':s==='leak'?'var(--red)':'var(--fg2)'; }
function _edKo(s){ return s==='good'?'양호':s==='caution'?'주의':s==='leak'?'누수':'데이터없음'; }

// ── [2026-05-30] 탭 상단 핵심 흐름 띠 (팔 에너지 인과 띠와 동일 패턴) ──
function _flowState(v,key,hi){ if(v==null)return 'na'; var N=(typeof BIOMOTION_NORMS!=='undefined'&&BIOMOTION_NORMS)?BIOMOTION_NORMS[key]:null; if(!N)return 'na'; if(hi){return v>=N.med?'good':(v>=N.q1?'caution':'leak');} return v<=N.med?'good':(v<=N.q3?'caution':'leak'); }
function _scoreState(sc){ if(sc==null)return 'na'; return sc>=78?'good':(sc>=62?'caution':'leak'); }
function _edFlowBand(steps,msg){
  function col(s){ return s==='good'?'#5bab84':(s==='caution'?'#cb9a4a':(s==='leak'?'#d65c4d':'#7d8898')); }
  function rgb(s){ return s==='good'?'91,171,132':(s==='caution'?'203,154,74':(s==='leak'?'214,92,77':'125,136,152')); }
  function gly(s){ return s==='good'?'●':(s==='caution'?'◐':(s==='leak'?'▲':'·')); }
  function ko(s){ return s==='good'?'양호':(s==='caution'?'주의':(s==='leak'?'누수':'–')); }
  var rank={good:0,caution:1,leak:2,na:-1}, worst='good', worstIdx=-1;
  steps.forEach(function(st,i){ if((rank[st.state]||0)>(rank[worst]||0)){ worst=st.state; worstIdx=i; } });
  var chips=steps.map(function(st,i){ var c=col(st.state); var isW=(i===worstIdx && st.state==='leak');
    var box='<div style="position:relative;flex:1 1 110px;min-width:94px;text-align:center;background:rgba('+rgb(st.state)+',.13);border:1px solid '+c+';border-bottom:3px solid '+c+';border-radius:10px;padding:9px 7px">'+(isW?'<div style="position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:'+c+';color:#0e1218;font-size:11px;font-weight:800;padding:1px 7px;border-radius:20px;white-space:nowrap">▲ 병목</div>':'')+'<div class="note" style="font-size:11px;line-height:1.3">'+st.label+'</div><div style="font-size:15px;font-weight:800;color:'+c+';margin-top:3px">'+(st.val==null?'–':st.val)+'</div><div style="font-size:11px;font-weight:700;color:'+c+';margin-top:2px">'+gly(st.state)+' '+ko(st.state)+'</div></div>';
    return box+(i<steps.length-1?'<div style="flex:0 0 auto;align-self:center;color:var(--fg2);font-size:17px;font-weight:800">&rarr;</div>':''); }).join('');
  return '<div class="card" style="grid-column:1 / -1;border-left:4px solid '+col(worst)+'"><div style="font-size:13px;font-weight:800">핵심 흐름 <span class="sub2" style="font-weight:500">— 원인 → 과정 → 결과 · 칸: <span style="color:#5bab84">● 양호</span> · <span style="color:#cb9a4a">◐ 주의</span> · <span style="color:#d65c4d">▲ 누수</span></span></div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;align-items:stretch">'+chips+'</div>'
    +(msg?'<div class="note" style="margin-top:8px">'+msg+'</div>':'')+'</div>';
}

function _edTagChip(tag){ var T={store:['저장','#5bb6e6'],gen:['생성','#46c98c'],transfer:['전달','#c084fc'],load:['부하','#e8954e'],ctx:['맥락','#8893a4']}[tag]||['','#8893a4']; return '<span style="font-size:11px;font-weight:700;color:'+T[1]+';border:1px solid '+T[1]+';border-radius:4px;padding:1px 6px;margin-left:6px;white-space:nowrap">'+T[0]+'</span>'; }
var _ED_DETAIL={windup:'ph-windup',xftiming:'ph-storage',stride:'ph-drive',blocking:'ph-blocking',knee:'ph-transfer',pelvistrunk:'ph-release',trunk:'ph-release',trunkarm:'ph-transfer',armball:'ph-transfer'};
// 9 흐름 노드 = 각각 별도 진단 탭(ed-*). 순서=키네틱 체인.
var _ED_NODES=[['windup','와인드업·저장'],['xftiming','X-factor'],['stride','스트라이드'],['blocking','블로킹'],['knee','무릎전달'],['pelvistrunk','골반→몸통'],['trunk','몸통에너지'],['trunkarm','몸통→팔'],['armball','팔→공']];
// ── 진단 단계별 인라인 측면 스틱(관련 분절 강조 + 스크러버로 시계열 커서 동기화) ──
var _ED_STICK_SEG={
  windup:{hi:['trunk','pelvis'],label:'몸통·골반(힙힌지 로딩)',desc:'와인드업 로딩 — 몸통-골반 굽힘과 골반 닫힘을 봅니다.'},
  xftiming:{hi:['trunk','pelvis'],label:'골반-몸통 분리(X-factor)',desc:'어깨선과 골반선의 분리각이 FC까지 보존되다 풀리는지 봅니다.'},
  stride:{hi:['leadleg'],label:'앞다리·전진',desc:'앞다리 착지와 COM 전진 운동량 형성을 봅니다.'},
  blocking:{hi:['leadleg'],label:'앞다리 제동',desc:'앞발이 전진을 멈추는 제동(FC~제동 peak)을 봅니다.'},
  knee:{hi:['leadleg'],kneeDot:true,label:'앞무릎',desc:'앞무릎이 버티는지·펴는지·흡수하는지를 봅니다.'},
  pelvistrunk:{hi:['pelvis','trunk'],label:'골반→몸통',desc:'골반 회전이 몸통 회전으로 증폭되는지를 봅니다.'},
  trunk:{hi:['trunk'],label:'몸통 회전·굴곡',desc:'몸통 회전과 앞으로 굴곡하는 에너지 생산을 봅니다.'},
  trunkarm:{hi:['trunk','arm'],label:'몸통→팔',desc:'몸통 에너지가 던지는 팔로 넘어가는지를 봅니다.'},
  armball:{hi:['arm'],label:'팔→공',desc:'어깨 내회전→팔꿈치 신전→손 속도→릴리스 시퀀스를 봅니다.'}
};
function _edStickWin(key,t){ var e=t.events||{}, dt=(t.meta&&t.meta.dt)||0.00333, nF=(t.frames||[]).length-1;
  var KH=e.i_kl_peak||0, FC=e.i_fc||0, BR=(e.i_br!=null?e.i_br:nF), MER=e.i_mer||FC;
  function p(base,ms){ return Math.round(base+ms/1000/dt); }
  var W={windup:[KH,FC],xftiming:[KH,BR],stride:[KH,FC],blocking:[FC,p(FC,150)],knee:[FC,BR],pelvistrunk:[KH,BR],trunk:[KH,BR],trunkarm:[FC,BR],armball:[MER,BR]};
  var w=W[key]||[KH,BR]; return [Math.max(0,Math.min(w[0],nF)),Math.max(0,Math.min(w[1],nF))];
}
function _edStickBones(arm,lead){ return [
  ['head','neck','head'],['neck','MIDHIP','trunk'],['neck',lead+'_shoulder','shoulder'],['neck',arm+'_shoulder','shoulder'],
  [lead+'_hip',arm+'_hip','pelvis'],
  [arm+'_shoulder',arm+'_elbow','arm'],[arm+'_elbow',arm+'_wrist','arm'],[arm+'_wrist',arm+'_hand_tip','arm'],
  [lead+'_shoulder',lead+'_elbow','glove'],[lead+'_elbow',lead+'_wrist','glove'],
  [lead+'_hip',lead+'_knee','leadleg'],[lead+'_knee',lead+'_heel','leadleg'],[lead+'_heel',lead+'_toe','leadleg'],
  [arm+'_hip',arm+'_knee','rearleg'],[arm+'_knee',arm+'_heel','rearleg'],[arm+'_heel',arm+'_toe','rearleg']
]; }
function _edStickDraw(key){
  var cv=document.getElementById('edstk-'+key); if(!cv) return;
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t||!t.frames) return;
  var win=_edStickWin(key,t), e=t.events||{}, dt=(t.meta&&t.meta.dt)||0.00333;
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):win[0];
  cf=Math.max(win[0],Math.min(win[1],cf));
  var fr=t.frames[cf]||{};
  var RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L'), arm=RHP?'r':'l', lead=RHP?'l':'r';
  function J(name){ if(name==='MIDHIP'){ var a=fr[lead+'_hip'],b=fr[arm+'_hip']; return (a&&b)?[(a[2]+b[2])/2,(a[1]+b[1])/2]:null; } var j=fr[name]; return (j&&isFinite(j[2])&&isFinite(j[1]))?[j[2],j[1]]:null; }
  var seg=_ED_STICK_SEG[key]||{hi:[]}, bones=_edStickBones(arm,lead);
  var xs=[],ys=[]; bones.forEach(function(b){ var p1=J(b[0]),p2=J(b[1]); if(p1){xs.push(p1[0]);ys.push(p1[1]);} if(p2){xs.push(p2[0]);ys.push(p2[1]);} });
  var c=clearC(cv),ctx=c.ctx,w=c.w,h=c.h;
  if(!xs.length){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('— 프레임 없음 —',w/2,h/2); return; }
  var xmin=Math.min.apply(null,xs),xmax=Math.max.apply(null,xs),ymin=Math.min.apply(null,ys),ymax=Math.max.apply(null,ys);
  var pad=18, sc=Math.min((w-2*pad)/((xmax-xmin)||1),(h-2*pad)/((ymax-ymin)||1));
  var ox=(w-(xmax-xmin)*sc)/2-xmin*sc, oy=h-pad+ymin*sc;
  function X(p){return ox+p[0]*sc;} function Y(p){return oy-p[1]*sc;}
  // 홈 방향(우측 위) 화살표
  ctx.strokeStyle='#3a4452';ctx.fillStyle='#7d8898';ctx.lineWidth=1;ctx.font='9px system-ui';
  ctx.beginPath();ctx.moveTo(w-14,h-12);ctx.lineTo(w-14,18);ctx.stroke();ctx.beginPath();ctx.moveTo(w-14,12);ctx.lineTo(w-17,19);ctx.lineTo(w-11,19);ctx.closePath();ctx.fill();ctx.fillText('홈',w-24,12);
  bones.forEach(function(b){ var p1=J(b[0]),p2=J(b[1]); if(!p1||!p2)return; var hiOn=seg.hi.indexOf(b[2])>=0; ctx.strokeStyle=hiOn?'#1d9e75':'#8a8f98'; ctx.lineWidth=hiOn?3.4:2; ctx.lineCap='round'; ctx.beginPath();ctx.moveTo(X(p1),Y(p1));ctx.lineTo(X(p2),Y(p2));ctx.stroke(); });
  var hd=J('head'); if(hd){ ctx.fillStyle='#8a8f98';ctx.beginPath();ctx.arc(X(hd),Y(hd),5,0,7);ctx.fill(); }
  if(seg.kneeDot){ var k=J(lead+'_knee'); if(k){ ctx.fillStyle='#D85A30';ctx.beginPath();ctx.arc(X(k),Y(k),5.5,0,7);ctx.fill();ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.3;ctx.stroke(); } }
  var lab=document.getElementById('edstk-t-'+key); if(lab){ var ms=Math.round((cf-(e.i_fc||0))*dt*1000); lab.textContent='FC'+(ms>=0?'+':'')+ms+'ms'; }
}
// 변인 카드용 스틱 게이지 — 현재 프레임(_currentFrame, 좌측 3D 스틱 동기) 측면 자세, 관련 분절(hiArr) 녹색 강조
// 카드 스틱 게이지(측면) — 골반(MIDHIP) 기준 상대좌표 + 윈도우 전체 고정 스케일 → 재생 중 크기·위치 일정.
// opt.win=[w0,w1] 스케일 산출 구간, opt.readout=[{txt,color,big}] 현재 프레임 수치 오버레이.
function _edCardStick(cid, hiArr, opt){
  opt=opt||{};
  var _HZ=(opt.view==='side')?2:0;  /* [2026-05-29] rear/front=정면(x,y) / side=측면(z,y) */
  var _MX=(opt.view==='front')?-1:1;  /* [2026-05-30] front=정면(미러: 투수를 마주봄) */
  var cv=document.getElementById(cid); if(!cv) return;
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t||!t.frames) return;
  var nF=t.frames.length-1;
  var RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L'), arm=RHP?'r':'l', lead=RHP?'l':'r';
  var bones=_edStickBones(arm,lead), hi=hiArr||[]; if(opt.only){ bones=bones.filter(function(b){return opt.only.indexOf(b[2])>=0;}); } var _aj=opt.anchorHeel?(lead+'_heel'):null;
  // 골반 중심(MIDHIP) 기준 상대좌표 — 전진 이동 제거 → 그림이 가운데 고정
  function anc(fr){ if(_aj){var _jj=fr[_aj];return (_jj&&isFinite(_jj[_HZ])&&isFinite(_jj[1]))?[_jj[_HZ],_jj[1]]:null;} var a=fr[lead+'_hip'],b=fr[arm+'_hip']; return (a&&b&&isFinite(a[_HZ])&&isFinite(b[_HZ])&&isFinite(a[1])&&isFinite(b[1]))?[(a[_HZ]+b[_HZ])/2,(a[1]+b[1])/2]:null; }
  function J(fr,name){ var an=anc(fr); if(!an)return null; if(name==='MIDHIP')return [0,0]; var j=fr[name]; return (j&&isFinite(j[_HZ])&&isFinite(j[1]))?[(j[_HZ]-an[0])*_MX, j[1]-an[1]]:null; }
  // 윈도우 전체에서 bbox(상대좌표) → 고정 스케일
  var w0=0,w1=nF; if(opt.win){ w0=Math.max(0,opt.win[0]); w1=Math.min(nF,opt.win[1]); }
  var xmin=1e9,xmax=-1e9,ymin=1e9,ymax=-1e9;
  for(var fi=w0;fi<=w1;fi++){ var f=t.frames[fi]; if(!f)continue; for(var bi=0;bi<bones.length;bi++){ var b=bones[bi]; var p1=J(f,b[0]),p2=J(f,b[1]); [p1,p2].forEach(function(p){ if(p){ if(p[0]<xmin)xmin=p[0]; if(p[0]>xmax)xmax=p[0]; if(p[1]<ymin)ymin=p[1]; if(p[1]>ymax)ymax=p[1]; } }); } }
  var c=clearC(cv),ctx=c.ctx,w=c.w,h=c.h; if(xmin>xmax){ return; }
  var pad=12, sc=Math.min((w-2*pad)/((xmax-xmin)||1),(h-2*pad)/((ymax-ymin)||1));
  var ox=(w-(xmax-xmin)*sc)/2-xmin*sc, oy=(h-(ymax-ymin)*sc)/2+ymax*sc;
  function X(p){return ox+p[0]*sc;} function Y(p){return oy-p[1]*sc;}
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):((t.events&&t.events.i_br)||nF);
  cf=Math.max(0,Math.min(nF,cf)); var fr=t.frames[cf]||{};
  bones.forEach(function(b){ var p1=J(fr,b[0]),p2=J(fr,b[1]); if(!p1||!p2)return; var on=hi.indexOf(b[2])>=0; ctx.strokeStyle=on?'#1d9e75':'#8a8f98'; ctx.lineWidth=on?3.4:1.8; ctx.lineCap='round'; ctx.beginPath();ctx.moveTo(X(p1),Y(p1));ctx.lineTo(X(p2),Y(p2));ctx.stroke(); });
  if(!opt.only){ var hd=J(fr,'head'); if(hd){ ctx.fillStyle='#8a8f98';ctx.beginPath();ctx.arc(X(hd),Y(hd),4,0,7);ctx.fill(); } }
  if(opt.readout) _edStickReadout(cid, opt.readout);
}
// 스틱 게이지 캔버스 좌상단에 현재 프레임 수치 오버레이
function _edStickReadout(cid, lines){
  var cv=document.getElementById(cid); if(!cv||!lines||!lines.length) return;
  var dpr=window.devicePixelRatio||1, ctx=cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.textAlign='left'; ctx.textBaseline='top'; var y=6;
  lines.forEach(function(l){ if(!l)return; ctx.font='bold '+(l.big?15:12)+'px system-ui'; ctx.fillStyle=l.color||'#cdd6e2'; ctx.fillText(l.txt,7,y); y+=(l.big?19:15); });
}
// ── 진단2~9 공통: 폴더용 이벤트 테이블 + 변인 정의 카드(전역) ──
function _edFoldG(label,inner){ return '<details style="margin-top:8px;border:1px solid var(--line);border-radius:8px;background:var(--bg2)"><summary style="cursor:pointer;padding:8px 11px;font-size:12px;font-weight:700;color:var(--cyan)">'+label+'</summary><div style="padding:2px 11px 11px">'+inner+'</div></details>'; }
function _edDefCardG(d){ return '<div class="note" style="line-height:1.85"><b>정의</b> '+(d.def||'')+'<br><b>산출 방법</b> '+(d.calc||'')+'<br><b>결과 해석</b> '+(d.interp||'')+'<br><b>평가 방법</b> '+(d.evalm||'')+'</div>'; }
function _edEvtListG(idxMap, fast){ var ix=idxMap||{}, mer=(fast&&fast.events)?fast.events.i_mer:null; return [['KH',ix.KH],['SO',ix.SO],['FC',ix.FC],['MER',mer],['BR',ix.BR]].filter(function(e){return e[1]!=null&&isFinite(e[1]);}); }
function _edEvtTableG(EVT, rows){ var th='<tr><th style="text-align:left;padding:4px 6px">변인</th>'+EVT.map(function(e){return '<th style="padding:4px 6px;text-align:right">'+e[0]+'</th>';}).join('')+'</tr>';
  var tr=rows.map(function(rw){ return '<tr><td style="text-align:left;padding:4px 6px">'+rw.label+(rw.unit?' <span style="color:var(--fg2)">('+rw.unit+')</span>':'')+'</td>'+EVT.map(function(e){var val=rw.get(e[1]);return '<td style="text-align:right;padding:4px 6px">'+(val==null?'–':val)+'</td>';}).join('')+'</tr>'; }).join('');
  return '<table class="ev-table" style="width:100%;border-collapse:collapse;font-size:11.5px;margin-top:2px">'+th+tr+'</table><div class="note" style="font-size:11px;margin-top:5px;color:var(--fg2)">값 = 각 이벤트 프레임에서의 변인 값 (폴더·기록용). KH 뒷무릎 최고높이 · SO 스트라이드 시작 · FC 앞발 착지 · MER 어깨 최대외회전 · BR 릴리스</div>'; }
// 시리즈 name 의 frame 값(prec 자리, abs 옵션)
function _edSV(fast,name,frame,prec,abs){ var a=fast&&fast.series&&fast.series[name]; if(!a||!isFinite(a[frame]))return null; var v=a[frame]; if(abs)v=Math.abs(v); var p=(prec==null?1:prec); return Math.round(v*p)/p; }
// 한 단계의 폴더 영역(이벤트 표 + 변인 정의) 카드 1개 생성
function _edStageFolds(fast, idxMap, evRows, defRows){
  var EVT=_edEvtListG(idxMap, fast);
  var tbl=(evRows&&evRows.length&&EVT.length)? _edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(EVT, evRows)) : '';
  var def=(defRows&&defRows.length)? _edFoldG('변인 정의·산출·해석·평가 (폴더용)', defRows.map(function(d){return '<div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--line)"><div style="font-size:12px;font-weight:700;color:var(--fg0)">'+d.name+'</div>'+_edDefCardG(d)+'</div>';}).join('')) : '';
  if(!tbl&&!def) return '';
  return '<div class="card" style="grid-column:1 / -1"><div style="font-size:12px;font-weight:800;color:var(--fg1)">변인 데이터·정의 (폴더용)</div>'+tbl+def+'</div>';
}
// 증거(_WG) 탑뷰/뒷발 게이지를 진단 카드 캔버스에 그린다 — 메인 3D 스틱(_currentFrame)에 동기화
function _edWGStick(key, cvId){
  if(!document.getElementById(cvId)) return;
  try{ if(!_WG.data) _WG.data=_WG.build(); }catch(e){}
  if(!_WG.data || !_WG.data.fast || !_WG.data.fast.series) return;
  if(key==='freeMo'){ try{ _WG.initFoot(); }catch(e){} }
  var nF=(_WG.data.fast.series.top||[]).length-1; if(nF<0) return;
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):nF;
  _WG.idx=Math.max(0,Math.min(nF,cf));
  var G={key:key};
  try{ if(key==='freeMo') _WG.drawFoot(G,cvId); else _WG.drawTop(G,cvId); }catch(e){}
}
var _edStickRAF={};
function _edStickAttach(key){
  var root=document.getElementById('ed-body-'+key); if(!root) return;
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t||!t.frames){ return; }
  if(document.getElementById('edstk-wrap-'+key)){ _edStickDraw(key); return; }
  var win=_edStickWin(key,t), seg=_ED_STICK_SEG[key]||{};
  var card=document.createElement('div'); card.className='card'; card.id='edstk-wrap-'+key; card.style.gridColumn='1 / -1';
  card.innerHTML='<div style="font-size:13px;font-weight:800">동작 스틱(측면) · <span style="color:var(--cyan)">'+(seg.label||'')+' 강조</span> <span class="sub2">스크러버로 좌측 시계열 커서와 함께 이동 · 윈도우=단계 구간</span></div>'
    +'<div style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;margin-top:6px"><canvas id="edstk-'+key+'" style="width:300px;height:226px;flex:0 0 300px;display:block"></canvas>'
    +'<div style="flex:1;min-width:220px"><div style="display:flex;align-items:center;gap:8px"><button id="edstk-play-'+key+'" class="bm-focus-btn" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:var(--cyan);border-radius:6px;padding:5px 12px;cursor:pointer">재생</button>'
    +'<input type="range" id="edstk-sl-'+key+'" min="'+win[0]+'" max="'+win[1]+'" value="'+win[0]+'" step="1" style="flex:1"><span id="edstk-t-'+key+'" class="note" style="min-width:64px;text-align:right"></span></div>'
    +'<div class="note" style="margin-top:8px">'+(seg.desc||'')+' 녹색=관련 분절 강조.</div></div></div>';
  root.insertBefore(card, root.firstChild);
  var sl=document.getElementById('edstk-sl-'+key), pb=document.getElementById('edstk-play-'+key);
  sl.addEventListener('input',function(){ _currentFrame=parseInt(sl.value,10); _edStickDraw(key); try{_queueCharts();}catch(e){} });
  pb.addEventListener('click',function(){
    if(_edStickRAF[key]){ cancelAnimationFrame(_edStickRAF[key]); _edStickRAF[key]=null; pb.textContent='재생'; return; }
    pb.textContent='정지'; var last=performance.now();
    (function tick(now){ var d=(now-last)/1000; last=now; var dtt=(t.meta&&t.meta.dt)||0.00833; var step=Math.max(1,Math.round(d/dtt*0.5));
      var nf=(parseInt(sl.value,10)||win[0])+step; if(nf>=win[1])nf=win[0]; sl.value=nf; _currentFrame=nf; _edStickDraw(key); try{_queueCharts();}catch(e){}
      _edStickRAF[key]=requestAnimationFrame(tick); })(last);
  });
  _currentFrame=win[0]; _edStickDraw(key);
}
// ── 선수 요약(UX 재설계 지침 v1): 9단계 종합 → 한 문장·강점·TOP3 병목·우선과제·다음 목표·팔 부담 ──
function _ps9(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null; if(!X) return null;
  var d=[
    ['windup','와인드업','와인드업 로딩 형성',X.windup&&X.windup.composite,0.5,'ed-windup',X.windup&&X.windup.typeKo,X.windup&&X.windup.summary,X.windup&&X.windup.type,'store'],
    ['xftiming','X-factor·풀림 타이밍','X-factor 보존·풀림 타이밍',X.xftiming&&X.xftiming.timingScore,0.9,'ed-xftiming',X.xftiming&&X.xftiming.typeKo,X.xftiming&&X.xftiming.summary,X.xftiming&&X.xftiming.type,'eff'],
    ['stride','스트라이드','스트라이드 전진 에너지',X.stride&&X.stride.momentumScore,0.7,'ed-stride',X.stride&&X.stride.typeKo,X.stride&&X.stride.summary,X.stride&&X.stride.type,'out'],
    ['blocking','앞발 제동','블로킹: 전진 에너지 제동',X.blocking&&X.blocking.functionalScore,0.9,'ed-blocking',X.blocking&&X.blocking.typeKo,X.blocking&&X.blocking.summary,X.blocking&&X.blocking.type,'out'],
    ['knee','무릎-골반','수직 지지·무릎 전달',X.knee5&&X.knee5.kneeTransferScore,1.0,'ed-knee',X.knee5&&X.knee5.typeKo,X.knee5&&X.knee5.summary,X.knee5&&X.knee5.type,'eff'],
    ['pelvistrunk','골반-몸통','골반→몸통 회전 증폭',X.pelvistrunk6&&X.pelvistrunk6.ampScore,1.0,'ed-pelvistrunk',X.pelvistrunk6&&X.pelvistrunk6.typeKo,X.pelvistrunk6&&X.pelvistrunk6.summary,X.pelvistrunk6&&X.pelvistrunk6.type,'eff'],
    ['trunk','몸통 에너지','몸통 회전+굴곡 에너지',X.trunk7&&X.trunk7.prodScore,0.85,'ed-trunk',X.trunk7&&X.trunk7.typeKo,X.trunk7&&X.trunk7.summary,X.trunk7&&X.trunk7.type,'out'],
    ['trunkarm','몸통-팔','몸통→팔 핸드오프',X.trunkarm8&&X.trunkarm8.taScore,1.2,'ed-trunkarm',X.trunkarm8&&X.trunkarm8.typeKo,X.trunkarm8&&X.trunkarm8.summary,X.trunkarm8&&X.trunkarm8.type,'load'],
    ['armball','팔-공','팔→공 방출 효율·부하',X.armball9&&X.armball9.abScore,0.7,'ed-armball',X.armball9&&X.armball9.typeKo,X.armball9&&X.armball9.summary,X.armball9&&X.armball9.type,'load']
  ];
  return d.map(function(x){ var sc=(x[3]==null?null:Math.round(x[3])); var st=sc==null?'na':(sc>=78?'good':(sc>=62?'caution':'bottleneck')); return {key:x[0],pName:x[1],cName:x[2],score:sc,imp:x[4],tab:x[5],typeKo:x[6],summary:x[7],type:x[8],status:st,cat:x[9]}; });
}
// 병목별 다음 측정 목표(선수 언어)
var _PS_GOAL={
  windup:'와인드업 로딩(힙힌지·골반 닫힘)을 FC까지 더 보존',
  xftiming:'X-factor를 FC까지 보존하고 풀림 시작을 FC 직후로 맞추기',
  stride:'홈 방향 전진 운동에너지를 안정적으로 더 만들기',
  blocking:'앞발 제동 peak를 착지 직후로 당겨 COM 감속을 빠르게',
  knee:'수직 GRF가 골반 회전 가속으로 더 빨리 이어지게(흡수↓)',
  pelvistrunk:'골반 회전이 몸통으로 증폭되는 gain·동기화 높이기',
  trunk:'몸통 회전+굴곡 에너지 생산을 더 키우기',
  trunkarm:'몸통→팔 전달 동기화(handoff)를 높이고 어깨 내회전 간격 줄이기',
  armball:'손 속도 peak를 릴리스에 맞추고 같은 구속을 더 낮은 팔 부담으로'
};
var _PS_PRIO={
  windup:'와인드업에서 만든 로딩을 착지까지 유지하는 데 집중',
  xftiming:'분리각을 더 크게 만들기보다 FC까지 유지하고 블로킹 이후 푸는 타이밍 맞추기',
  stride:'전진속도 자체보다 블로킹 가능한 전진 에너지를 홈 방향으로 안정적으로 만들기',
  blocking:'앞발 착지 직후 빠르게 제동을 형성해 전진을 회전으로 전환',
  knee:'앞다리가 받은 수직 힘을 골반 회전으로 즉시 연결(무릎 흡수·지연 줄이기)',
  pelvistrunk:'골반 회전 직후 몸통이 늦지 않게 따라오도록 타이밍 맞추기',
  trunk:'팔을 더 쓰기보다 몸통 회전+굴곡 에너지 생산을 먼저 키우기',
  trunkarm:'몸통 peak 직후 어깨 내회전이 늦지 않게 연결해 몸통 힘을 팔로 넘기기',
  armball:'손 속도 peak를 릴리스에 맞추고 팔 부담 대비 구속 효율 높이기'
};
// 병목을 선수 언어로 자연스럽게 설명(선수전달용 작성가이드 §11). 단계 key + 세부 type별.
function _psNatural(s){
  var t=s.type;
  var M={
    windup:'와인드업에서 만든 로딩(장전 자세)이 착지까지 충분히 유지되지 않습니다. 착지 후 골반 회전에 쓸 준비가 약해질 수 있어, 더 크게 장전하기보다 만든 로딩을 착지까지 유지하는 것이 우선입니다.',
    xftiming:'골반과 몸통의 분리각을 만드는 능력은 있지만, 착지 전에 일부가 먼저 풀립니다. 그러면 앞발 제동 이후 몸통으로 힘을 키울 시간이 줄어듭니다. 더 크게 꼬기보다, 현재 만든 분리각을 착지까지 유지하는 것이 먼저입니다.',
    stride:'와인드업에서 만든 로딩이 앞으로 나가는 운동량으로 충분히 전환되지 않습니다. 그러면 착지 후 앞발 제동과 골반 회전에 쓸 힘의 원재료가 부족해질 수 있습니다.',
    blocking:'착지 순간 앞으로 나가는 에너지는 충분하지만, 앞발이 그 몸을 멈춰 세우는 제동이 늦게 나타납니다. 앞으로 가던 힘을 회전으로 바꾸는 시점이 지연되는 패턴입니다.',
    knee:'앞발에서 받은 수직 힘은 충분하지만, 그 힘이 골반 회전으로 바로 이어지지 않고 무릎에서 일부 흡수되거나 지연됩니다. 무릎을 어떻게 쓰는지보다, 그 힘이 골반으로 연결되는 타이밍이 핵심입니다.',
    pelvistrunk:'골반 회전은 만들지만 몸통 회전으로 충분히 커지지 않습니다. 하체에서 올라온 힘이 몸통에서 증폭되지 않으면, 이후 팔이 더 많은 일을 해야 할 수 있습니다.',
    trunk:'투구에서 가장 큰 엔진인 몸통에서 만들어지는 에너지가 코호트 대비 부족합니다. 팔을 더 쓰기보다, 몸통의 회전과 앞으로 굴곡하는 에너지 생산을 먼저 키우는 것이 중요합니다.',
    trunkarm:'몸통이 만든 힘은 충분하지만 팔로 넘어가는 타이밍이 늦습니다. 그러면 팔이 몸통 힘을 제때 받지 못하고, 부족한 힘을 팔이 스스로 보완하는 패턴이 됩니다.',
    armball:'팔과 손이 만든 속도가 공으로 나가는 효율이 코호트 대비 낮거나, 그 구속을 만드는 팔 부담이 큰 편입니다. 손 속도가 가장 빠른 순간을 릴리스에 맞추고, 같은 구속을 더 낮은 팔 부담으로 만드는 것이 목표입니다.'
  };
  // 세부 type 보정(같은 단계라도 양상이 다를 때)
  if(s.key==='trunkarm'){ if(t==='early_arm') return '팔이 몸통보다 먼저 움직이는 경향이 있습니다. 몸통 회전을 먼저 완성한 뒤 팔이 따라오면, 팔이 덜 힘들게 더 빠른 공을 던질 수 있습니다.'; if(t==='arm_reliant') return '공은 빠르게 던지지만 팔 자체 부담으로 구속을 만드는 경향이 있습니다. 몸통에서 팔로 힘을 더 넘겨받으면 같은 구속을 더 낮은 팔 부담으로 만들 수 있습니다.'; }
  if(s.key==='blocking'){ if(t==='weak') return '앞발이 앞으로 나가는 힘을 멈추는 제동 자체가 약합니다. 앞다리로 단단히 버텨 전진을 멈추면, 그 힘을 회전으로 바꿀 수 있습니다.'; if(t==='momentum_leak') return '앞으로 나가는 에너지는 충분히 만들지만, 앞발 제동이 부족해 그 힘을 회전으로 바꾸지 못하고 앞으로 흘려보내는 패턴입니다.'; if(t==='over_brake') return '앞발로 강하게 멈추지만, 그 힘이 골반 회전으로 전환되지 않고 무릎·고관절에서 흡수되는 경향이 있습니다.'; if(t==='direction_leak') return '앞발 제동력의 일부가 홈 방향이 아니라 좌우로 새어, 전진을 멈추는 효율이 떨어집니다.'; }
  if(s.key==='trunk'){ if(t==='rotation_dominant') return '몸통 회전은 잘 만들지만, 릴리스 방향으로 앞으로 굴곡하며 만드는 에너지 기여가 코호트 대비 적습니다. 회전과 굴곡을 함께 쓰면 전달 효율을 더 높일 수 있습니다.'; if(t==='peak_timing') return '몸통 에너지가 가장 커지는 시점이 팔로 넘기는 타이밍과 잘 맞지 않습니다. 에너지 크기보다 그 시점을 맞추는 것이 우선일 수 있습니다.'; }
  if(s.key==='xftiming'){ if(t==='late_release') return '분리각은 잘 보존하지만 푸는 시점이 다소 늦어, 블로킹된 힘을 회전으로 즉시 잇지 못할 수 있습니다.'; if(t==='no_effective_release') return '분리각과 푸는 속도가 모두 약해 몸통 에너지로 키우기 어렵습니다. 분리각을 만들고 블로킹 이후 빠르게 푸는 연습이 필요합니다.'; }
  return M[s.key]||s.typeKo;
}
// 진단 기반 팔 부담·부하 평가(부상 위험 재판단) — 부상 탭 상단에 패널 주입
function renderInjuryLoadDiag(){
  var pg=document.getElementById('page-injury'); if(!pg) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, I=X&&X.injuryLoad;
  var host=document.getElementById('injload-diag');
  if(!host){ host=document.createElement('div'); host.id='injload-diag'; pg.insertBefore(host, pg.firstChild); }
  if(!I){ host.innerHTML=''; return; }
  var COL={low:'#46c98c',moderate:'#e8954e',high:'#e24b4a'}[I.level]||'#7d8898';
  function v(x,u){return x==null?'–':(x+(u||''));}
  function lvc(l){return l==null?'#7d8898':['#46c98c','#e8954e','#e24b4a'][l];}
  function lvt(l){return l==null?'–':['정상','다소 높음','높음'][l];}
  function btn(lbl,pg2){return '<button class="bm-focus-btn" onclick="setPage(\''+pg2+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:var(--cyan);border-radius:6px;padding:4px 10px;cursor:pointer;margin:2px 4px 2px 0">'+lbl+'</button>';}
  function kpi(lbl,val,col){return '<div style="flex:1 1 150px;background:var(--bg2);border-radius:8px;padding:9px 11px"><div class="note" style="font-size:11px">'+lbl+'</div><div style="font-size:16px;font-weight:800;margin-top:2px;color:'+(col||'inherit')+'">'+val+'</div></div>';}
  var h='<div class="card" style="grid-column:1 / -1;border-left:4px solid '+COL+'">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">진단 기반 팔 부담·부하 평가</div><div style="font-size:13px;font-weight:800;color:'+COL+'">팔 부담 '+I.levelKo+'</div></div>'
    +'<div class="note" style="margin-top:3px">'+I.basis+' · <b>부상 예측이 아니라 "구속을 만드는 팔 부담 비용"</b> 관점입니다.</div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+I.summary+'</div></div>';
  h+='<div class="card" style="grid-column:1 / -1"><div style="display:flex;flex-wrap:wrap;gap:8px">'
    +kpi('팔꿈치 토크 peak',v(I.elbowTorque,' N·m')+' <span style="font-size:11px;color:'+lvc(I.elbowLevel)+'">('+lvt(I.elbowLevel)+')</span>',lvc(I.elbowLevel))
    +kpi('어깨 토크 peak',v(I.shoulderTorque,' N·m')+' <span style="font-size:11px;color:'+lvc(I.shoulderLevel)+'">('+lvt(I.shoulderLevel)+')</span>',lvc(I.shoulderLevel))
    +kpi('팔 혼자 만든 비율',v(I.armSelfReliance)+' <span style="font-size:11px;color:'+lvc(I.asrLevel)+'">('+lvt(I.asrLevel)+')</span>',lvc(I.asrLevel))
    +kpi('구속 비용지수',v(I.velocityCostIndex)+' <span style="font-size:11px;color:var(--fg2)">0근처=평균</span>','')
    +'</div></div>';
  h+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">이 부담을 키우는 진단 근거</div>';
  I.drivers.forEach(function(dv){ h+='<div class="note" style="margin-top:5px">· <b>'+dv.stage+'</b> — '+dv.text+' '+btn('근거 →',dv.tab)+'</div>'; });
  h+='<div class="note" style="margin-top:8px;color:var(--fg2)">아래는 기존 관절 부하 추정(레거시)입니다. 위 진단 기반 평가를 우선 해석하세요.</div></div>';
  host.innerHTML=h;
}
function renderPlayerSummary(){
  // [2026-05-30] 요약 = 신체 에너지 사슬 맵(Body Map) 단독 (디자인 채택안 · 다른 내용 제거)
  var _r=document.getElementById('ed-body-psummary'); if(!_r)return; _r.innerHTML='<div id="bm-root"></div>'; try{ renderBodyMap('bm-root'); }catch(e){}
}
function _renderPlayerSummaryLegacy(){
  var root=document.getElementById('ed-body-psummary'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, S=_ps9();
  var MODE=(typeof _reportMode!=='undefined')?_reportMode:'coach';
  if(!S){ root.innerHTML='<div class="card"><div class="note">진단 요약은 9단계 에너지 전달 진단(지면반력+관절파워 있는 Theia 분석)이 있을 때 표시됩니다.</div></div>'; return; }
  var COL={good:'#46c98c',caution:'#e8954e',bottleneck:'#e24b4a',na:'#7d8898'}, LAB={good:'양호',caution:'주의',bottleneck:'병목',na:'측정 없음'};
  var avail=S.filter(function(s){return s.score!=null;});
  var strengths=avail.filter(function(s){return s.status==='good';}).sort(function(a,b){return b.score-a.score;}).slice(0,2);
  if(!strengths.length) strengths=avail.slice().sort(function(a,b){return b.score-a.score;}).slice(0,2);
  var bottlenecks=avail.filter(function(s){return s.score<75;}).map(function(s){return Object.assign({sev:(100-s.score)*s.imp},s);}).sort(function(a,b){return b.sev-a.sev;}).slice(0,3);
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--cyan)')+';border-radius:6px;padding:5px 11px;cursor:pointer;margin:2px 4px 2px 0">'+lbl+'</button>'; }
  var pl=(DATA.player&&DATA.player.name)||'선수', velo=DATA.measured_kmh?(' · 최고 '+DATA.measured_kmh+'km/h'):'';
  // 헤드라인(강점 먼저 → 최상위 병목)
  var strTxt=strengths.length?strengths.map(function(s){return s.pName;}).join('·'):'기본 동작';
  var top=bottlenecks[0];
  var effect=top?({trunkarm:'팔이 부족한 전달분을 스스로 보완하는 패턴',armball:'팔 부담 대비 구속 효율이 떨어지는 패턴',xftiming:'블로킹 이후 몸통 에너지를 키울 시간이 줄어드는 패턴',blocking:'전진 에너지를 회전으로 바꾸는 시점이 늦는 패턴',knee:'수직 힘이 골반 회전으로 바로 이어지지 못하는 패턴',pelvistrunk:'골반 힘이 몸통에서 충분히 커지지 않는 패턴',trunk:'팔이 더 많은 일을 해야 하는 패턴',stride:'블로킹·회전에 쓸 선형 에너지가 부족해지는 패턴',windup:'착지 후 회전 준비가 약해지는 패턴'})[top.key]:'';
  var headline=top?('이 투수는 '+strTxt+'는 잘 만들지만, <b style="color:'+COL[top.status]+'">'+top.cName+'</b> 단계에서 에너지 전달이 제한되어 '+effect+'입니다.'):('이 투수는 '+strTxt+' 등 전반적으로 에너지가 큰 병목 없이 흐르는 패턴입니다.');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="font-size:12px;color:var(--fg2)">진단 요약 — '+pl+velo+' · 9단계 에너지 전달 종합(코호트 20명 기준)</div>'
    +'<div style="font-size:15px;font-weight:800;line-height:1.6;margin-top:6px">'+headline+'</div>'
    +'<div class="note" style="margin-top:6px">아래는 "무엇을 먼저 고치면 구속이 올라갈까"만 추렸습니다. 자세한 수치·그래프는 각 단계의 근거 보기에서 확인하세요.</div></div>';

  // ── 세 축 요약 카드 (체력 · 메카닉 출력 · 메카닉 효율 → 결과 + 팔 부하)  [2026-05-28 B안]
  //   체력=hpa.overall_score(145km/h+ 100점 기준), 출력=생성노드(stride·blocking·trunk) 평균,
  //   효율=전달노드(knee·pelvistrunk[재보정]·xftiming) 평균. trunkarm은 팔 부하 플래그 전용.
  var _threeAxisHTML=(function(){
    try{
      var hpa=DATA.hp_assessment||{};
      var SM={}; S.forEach(function(s){SM[s.key]={sc:s.score,status:s.status};});
      function _avg(ks){var v=ks.map(function(k){return SM[k]&&SM[k].sc;}).filter(function(x){return x!=null&&isFinite(x);});return v.length?v.reduce(function(a,b){return a+b;},0)/v.length:null;}
      var GEN=['stride','blocking','trunk'], TR=['knee','pelvistrunk','xftiming'];
      var outSc=_avg(GEN), effSc=_avg(TR), fitSc=(hpa.overall_score!=null&&isFinite(hpa.overall_score))?hpa.overall_score:null;
      if(outSc==null&&effSc==null&&fitSc==null) return '';
      var OUT_BL=[53.3,55.7,57.3,58,59,59.7,60.3,61.3,62,62.7,62.7,63,63.3,63.7,63.7,64,65.7,66,66.3,66.3,67,68,70,71.3,71.7,72.3,73.3,73.7,73.7,75.7,76.3,77.7,78.3,82.7];
      var EFF_BL=[53.0,53.5,58.2,58.2,58.8,60.0,60.3,63.5,64.8,65.2,66.2,66.7,69.8,69.8,70.2,70.5,70.7,71.2,71.2,72.5,72.8,73.7,74.8,75.5,76.0,76.0,76.3,77.0,77.3,78.0,79.0,80.0,81.0,85.3];
      var VELO_BL=[110.4,110.6,118.9,119,121,122.3,127.6,128.4,128.5,129.1,129.2,129.2,133.7,134.7,134.8,138.2,138.4,139.6,140.1,140.1,140.8,140.9,141.2,141.5,141.9,143,143.5,144.7,144.7,145.6,146.3,147.7,148.2,150];
      function _pct(arr,v){if(v==null||!isFinite(v))return null;var c=0;for(var i=0;i<arr.length;i++)if(arr[i]<v)c++;return Math.round(100*c/arr.length);}
      var outPct=_pct(OUT_BL,outSc), effPct=_pct(EFF_BL,effSc), veloPct=_pct(VELO_BL, DATA.measured_kmh||(DATA.velo_summary&&DATA.velo_summary.max_kmh));
      // 1순위 과제 = 셋 중 점수 최저
      var axes=[];
      if(fitSc!=null) axes.push({k:'체력',sc:fitSc,col:'#9c8cff',bg:'#2e2845'});
      if(outSc!=null) axes.push({k:'메카닉 출력',sc:outSc,col:'#5bd3ff',bg:'#163245'});
      if(effSc!=null) axes.push({k:'메카닉 효율',sc:effSc,col:'#46c98c',bg:'#143527'});
      axes.sort(function(a,b){return a.sc-b.sc;});
      var prio=axes[0];
      var allGood=axes.length>=2 && axes.every(function(a){return a.sc>=70;});
      var typLabel = allGood
        ? {t:'균형형(완성단계)',d:'세 축 모두 양호 — 현 패턴 유지 + 미세 보완.',c:'#46c98c'}
        : (prio?{t:prio.k+' 1순위 과제형',d:prio.k+'이 가장 큰 개선 여지입니다 (코호트 점수 '+Math.round(prio.sc)+').',c:prio.col}:null);
      // 가장 약한 단계
      function _worst(ks){return ks.map(function(k){return {k:k,sc:SM[k]&&SM[k].sc};}).filter(function(x){return x.sc!=null&&isFinite(x.sc);}).sort(function(a,b){return a.sc-b.sc;});}
      var genWorst=_worst(GEN)[0], effWorst=_worst(TR).slice(0,3);
      var NODE_NAME={stride:'스트라이드',blocking:'블로킹',trunk:'몸통 에너지',knee:'무릎 이용',pelvistrunk:'골반→몸통',xftiming:'X-factor'};
      var armLoad=(X&&X.injuryLoad)||null;
      var armASR=(X&&X.rep&&X.rep.armSelfReliance);
      function _gauge(col,lab,sc,pct){
        return '<div style="margin-top:6px"><div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--fg2)"><span>'+lab+'</span><b style="color:var(--fg)">'+(sc!=null?Math.round(sc):'—')+(pct!=null?' · '+pct+'p':'')+'</b></div><div style="height:8px;background:var(--bg1);border-radius:5px;overflow:hidden;margin-top:3px"><div style="height:100%;background:'+col+';width:'+Math.max(0,Math.min(100,pct!=null?pct:sc||0))+'%"></div></div></div>';
      }
      var h='<div class="card" style="grid-column:1 / -1;padding:0;overflow:hidden">'
        +'<div style="padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline">'
        +'<div><b style="font-size:14px">세 축 진단 요약</b> <span style="font-size:11.5px;color:var(--fg2)">— 체력 · 메카닉 출력 · 메카닉 효율 → 결과(구속)</span></div>'
        +(typLabel?'<span style="font-size:11.5px;font-weight:800;color:'+typLabel.c+';padding:2px 8px;border:1px solid '+typLabel.c+';border-radius:12px">유형: '+typLabel.t+'</span>':'')+'</div>'
        +'<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0">'
        // 체력
        +'<div style="padding:11px 14px;border-right:1px solid var(--line)">'
        +'<div style="font-size:12px;font-weight:800;color:#9c8cff">체력 (엔진 — S&amp;C)</div>'
        +(fitSc==null?'<div class="note" style="color:var(--fg2);margin-top:6px">체력 측정 없음</div>'
          :_gauge('linear-gradient(90deg,#7048e8,#c4b3f3)','점수 · /100=145km/h+',fitSc,null))
        +'<div style="margin-top:6px;font-size:11px;color:#9c8cff">경로: 웨이트·플라이오메트릭</div>'
        +'</div>'
        // 메카닉 출력
        +'<div style="padding:11px 14px;border-right:1px solid var(--line)">'
        +'<div style="font-size:12px;font-weight:800;color:#5bd3ff">메카닉 출력 (생성 단계)</div>'
        +_gauge('linear-gradient(90deg,#1b80c4,#5bd3ff)','점수 · 백분위',outSc,outPct)
        +(genWorst?'<div style="margin-top:6px;font-size:11px"><b style="color:#5bd3ff">생성 약한 곳:</b> '+(NODE_NAME[genWorst.k]||genWorst.k)+' '+genWorst.sc+'점</div>':'')
        +'<div style="margin-top:6px;font-size:11px;color:#5bd3ff">경로: 생성 메카닉 드릴</div>'
        +'</div>'
        // 메카닉 효율
        +'<div style="padding:11px 14px">'
        +'<div style="font-size:12px;font-weight:800;color:#46c98c">메카닉 효율 (전달·시퀀싱)</div>'
        +_gauge('linear-gradient(90deg,#1f7a4d,#46c98c)','점수 · 백분위',effSc,effPct)
        +(effWorst.length?'<div style="margin-top:6px;font-size:11px"><b style="color:#46c98c">전달 병목 3순위:</b><br>'
          +effWorst.map(function(w,i){return (i+1)+'. '+(NODE_NAME[w.k]||w.k)+' '+w.sc+'점';}).join('<br>')+'</div>':'')
        +'<div style="margin-top:6px;font-size:11px;color:#46c98c">경로: 시퀀싱 드릴(불펜)</div>'
        +'</div>'
        +'</div>'
        // 결과 + 팔부하
        +'<div style="padding:9px 14px;border-top:1px solid var(--line);background:var(--bg2);font-size:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">'
        +'<div><b style="color:#e8954e">결과:</b> 최고 구속 '+(DATA.measured_kmh!=null?DATA.measured_kmh.toFixed(1):'—')+' km/h'+(veloPct!=null?' · 코호트 '+veloPct+' 백분위':'')+'</div>'
        +(armLoad?'<div style="color:'+(armLoad.level==='high'?'#e24b4a':(armLoad.level==='moderate'?'#e8954e':'#46c98c'))+'"><b>팔 부하:</b> '+(armLoad.levelKo||armLoad.level||'')+(armASR!=null?' · ASR '+armASR:'')+'</div>':'')
        +'</div>'
        +'<div style="padding:7px 14px;font-size:11px;color:var(--fg2)">출력=생성노드 평균(스트라이드·블로킹·몸통). 효율=전달노드 평균(무릎·골반→몸통[gap 재보정]·X타이밍). 팔→공 자가의존(ASR)은 효율 신호가 아니라 부담 지표라 별도 플래그. 백분위는 엘리트20+상동고14 baseline. 구속 예보 아님 — 세 축 개선 방향 지표.</div>'
        +'</div>';
      return h;
    }catch(e){console.error('three-axis card',e);return '';}
  })();
  html+=_threeAxisHTML;

  // 흐름 지도
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">에너지 전달 흐름 지도</div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">';
  S.forEach(function(s,i){ var c=COL[s.status];
    html+='<div onclick="setPage(\''+s.tab+'\')" title="'+(s.cName)+(s.score==null?'':' · '+s.score+'점')+'" style="flex:1 1 96px;min-width:92px;cursor:pointer;background:var(--bg2);border-radius:8px;border-left:3px solid '+c+';padding:7px 9px">'
      +'<div style="font-size:11px;color:var(--fg2)">'+(i+1)+'. '+s.pName+'</div>'
      +'<div style="font-size:12px;font-weight:800;color:'+c+';margin-top:2px">'+LAB[s.status]+(s.score==null?'':' <span style="color:var(--fg2);font-weight:400">'+s.score+'</span>')+'</div></div>';
  });
  html+='</div><div class="note" style="margin-top:6px">저장 → 보존 → 전진 → 제동 → 무릎전달 → 골반·몸통 증폭 → 몸통생산 → 팔전달 → 공방출 · 칸을 누르면 그 단계 근거로 이동</div></div>';
  // 강점
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid #46c98c"><div style="font-size:13px;font-weight:800">잘되는 부분</div><div class="note" style="margin-top:4px">'
    +(strengths.map(function(s){return '<b style="color:#46c98c">'+s.pName+'</b>('+s.cName+', '+(s.score==null?'–':s.score+'점)');}).join(' · '))
    +' — 이 단계들은 코호트 상위 수준으로, 강점을 유지하면서 아래 병목을 개선하면 됩니다.</div></div>';
  // TOP3 병목
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">구속 향상을 막는 TOP '+(bottlenecks.length||0)+' 병목</div>';
  if(!bottlenecks.length){ html+='<div class="note" style="margin-top:4px">뚜렷한 전달 병목이 없습니다 — 9단계가 코호트 평균 이상으로 균형 잡혀 있습니다.</div>'; }
  bottlenecks.forEach(function(s,i){ var c=COL[s.status];
    html+='<div style="margin-top:8px;background:var(--bg2);border-radius:8px;border-left:3px solid '+c+';padding:9px 11px">'
      +'<div style="font-size:13px;font-weight:800">'+(i+1)+'. '+s.pName+' <span style="font-size:11px;color:var(--fg2);font-weight:400">'+s.cName+' · '+LAB[s.status]+' '+(s.score==null?'':s.score+'점')+'</span></div>'
      +'<div class="note" style="margin-top:4px">'+_psNatural(s)+'</div>'
      +'<div style="margin-top:6px">'+btn('왜 이렇게 판단했나요? (근거 보기) →',s.tab,'var(--cyan)')+'</div></div>';
  });
  html+='</div>';
  // 이번 주 우선과제(1~2)
  var prio=bottlenecks.slice(0,2);
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">이번 주 가장 먼저 고칠 것</div>';
  if(!prio.length){ html+='<div class="note" style="margin-top:4px">현재 패턴을 유지하며 구속·일관성을 다지세요.</div>'; }
  prio.forEach(function(s,i){ html+='<div class="note" style="margin-top:'+(i?'4px':'6px')+'"><b>'+(i===0?'1순위':'2순위')+'</b> — '+(_PS_PRIO[s.key]||s.cName)+'</div>'; });
  html+='</div>';
  // 다음 측정 목표(2~3)
  var goalKeys=bottlenecks.slice(0,3);
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">다음 측정 때 좋아져야 할 지표</div><div class="note" style="margin-top:4px">';
  if(!goalKeys.length){ html+='현재 코호트 평균 이상 — 구속과 일관성 유지가 목표입니다.'; }
  else html+=goalKeys.map(function(s,i){return (i+1)+'. '+(_PS_GOAL[s.key]||s.cName);}).join('<br>');
  html+='</div></div>';
  // 팔 부담 요약
  if(X.armball9){ var ab=X.armball9, N=ab.norm||{}; var hiLoad=(ab.elbowTorquePeak!=null&&N.elbowTorque&&ab.elbowTorquePeak>N.elbowTorque.q3)||(ab.shoulderTorquePeak!=null&&N.shoulderTorque&&ab.shoulderTorquePeak>N.shoulderTorque.q3);
    html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid '+(hiLoad?'#e8954e':'#46c98c')+'"><div style="font-size:13px;font-weight:800">팔 부담 · 출력 효율</div>'
      +'<div class="note" style="margin-top:4px">현재 구속('+(ab.ballVelocityKmh==null?'–':ab.ballVelocityKmh+'km/h')+')을 만들 때 팔꿈치('+(ab.elbowTorquePeak||'–')+'N·m)·어깨('+(ab.shoulderTorquePeak||'–')+'N·m) 부담이 '+(hiLoad?'코호트 상위 수준':'코호트 범위 내')+'입니다. 팔 자체 의존도(ASR) '+(ab.armSelfReliance==null?'–':ab.armSelfReliance)+'.</div>'
      +'<div class="note" style="margin-top:4px">'+(hiLoad?'목표는 더 빠른 공이 아니라, 같은 구속을 더 낮은 팔 부담으로 만드는 것입니다(몸통→팔 전달 효율 개선).':'팔 부담이 과하지 않아, 현재 전달 효율을 유지하면 됩니다.')+'</div>'
      +'<div style="margin-top:6px">'+btn('팔→공 부하 자세히 →','ed-armball')+btn('몸통→팔 전달 →','ed-trunkarm')+'</div></div>';
  }
  // ── 코치(전체) 모드: 전체 사슬 종합 차트 + 신뢰도/한계 (구 「진단 개요」 흡수) ──
  if(MODE!=='player' && X){
    html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--fg2)"><div style="font-size:13px;font-weight:800">종합 진단 <span class="sub2">연구자</span></div>'
      +'<div class="note" style="margin-top:4px">측정 구속 '+(X.measured_kmh!=null?X.measured_kmh.toFixed(1):'—')+' km/h · '+X.consistency.nTrials+'구 · 신뢰도: GRF '+X.confidence.grf+' / 팔에너지 '+X.confidence.armEnergy+' / 반복성 '+X.confidence.consistency+'</div></div>';
    html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">키네틱 시퀀스 + 앞발 지면반력 <span class="sub2">KH→BR · 골반→몸통→팔 각속도(좌축) + 앞발 수직 GRF(우축)</span></h3>'
      +'<canvas id="ef-seq-grf" style="width:100%;height:250px;display:block"></canvas>'
      +'<div class="note" style="margin-top:6px">앞발 GRF(초록)가 오른 뒤 골반→몸통→팔(손) 각속도가 차례로 정점에 도달해야 지면 에너지가 사슬을 타고 전달됩니다. 정점이 겹치거나 순서가 뒤집히면 비효율 신호입니다.</div></div>';
    html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">몸통→팔 Handoff Overlap <span class="sub2">몸통 방출과 상완 상승의 겹침</span></h3>'
      +'<canvas id="ef-handoff" style="width:100%;height:230px;display:block"></canvas>'
      +'<div class="note" style="margin-top:6px">보라=몸통 에너지, 주황=상완 에너지 · 힘 넘기기 겹침=<b>'+(X.rep.trunkArmOverlap==null?'–':X.rep.trunkArmOverlap)+'</b> · Arm Self-Reliance=<b>'+(X.rep.armSelfReliance==null?'–':X.rep.armSelfReliance)+'</b>(낮을수록 몸통 주도, 상완 기준).</div></div>';
    html+='<div class="card" style="grid-column:1 / -1"><div class="note"><b>해석 주의(신뢰도):</b> 골반 분절 에너지가 없어 골반→몸통은 회전속도·가속 타이밍·증폭비로 평가. 팔 에너지=상완 기준(전완·손 분절E 없음). 절대 J는 마커리스 추정이라 선수 간 절대비교보다 한 선수 안의 균형·약한 고리·타이밍으로 해석. 반복성 신뢰도: '+X.confidence.consistency+'.</div></div>';
  }
  html+='<div class="card" style="grid-column:1 / -1"><div class="note">단계별 상세·시계열·스틱 게이지는 각 진단 탭(진단1~9)에서 볼 수 있습니다.'+(MODE==='player'?' 전체 사슬 종합 차트·신뢰도·폴더용 데이터는 <b>코치 모드</b>에서 표시됩니다.':'')+'</div></div>';
  root.innerHTML=html;
  if(MODE!=='player'){ try{ _redrawEtCharts(); }catch(e){} }
}

// ═══════════════════════════════════════════════════════════════════
// 코칭 뷰 (Coach View) — 5 챕터 스토리텔링 + 부록
// [2026-05-28] 출력·전달 분리 narrative · 챕터별 핵심 + 인터랙티브 디테일 점프
// ═══════════════════════════════════════════════════════════════════
// V2 인라인 통합 — ed-body-* 입양(adoption) 상태 보존
var _cvAdopted={};
function _cvRestoreAll(){
  Object.keys(_cvAdopted).forEach(function(key){
    var el=document.getElementById('ed-body-'+key);
    var rec=_cvAdopted[key];
    if(el&&rec&&rec.parent){
      if(rec.nextSibling) rec.parent.insertBefore(el,rec.nextSibling);
      else rec.parent.appendChild(el);
    }
  });
  _cvAdopted={};
}
function _cvAdoptInto(key, slot){
  var el=document.getElementById('ed-body-'+key);
  if(!el||!slot) return false;
  if(!_cvAdopted[key]){
    _cvAdopted[key]={parent:el.parentNode, nextSibling:el.nextSibling};
  }
  slot.appendChild(el);
  try{ renderEdNode(key); }catch(e){console.warn('renderEdNode',key,e);}
  return true;
}
var _KSTRIP_URI="data:image/png;base64,";
// ── [2026-05-30] 신체 에너지 사슬 맵 (디자인 핸드오프 C안 · 바닐라 포팅) ──
// 팔레트(navy 1색 + good/warn/bad), kinetic_strip 배경 = window._KSTRIP_URI
var _EFPAL={bg0:'#0e1218',bg1:'#161c25',bg2:'#1c2430',bg3:'#222c3a',line:'#2a3543',fg0:'#e8edf4',fg1:'#9aa7b6',fg2:'#6d7b8c',navy:'#3f86cf',navyDeep:'#27577f',good:'#5bab84',goodSoft:'rgba(91,171,132,.16)',warn:'#cb9a4a',warnSoft:'rgba(203,154,74,.16)',bad:'#d65c4d',badSoft:'rgba(214,92,77,.16)'};
function _efCol(s){return s==='good'?_EFPAL.good:s==='warn'?_EFPAL.warn:_EFPAL.bad;}
function _efSoft(s){return s==='good'?_EFPAL.goodSoft:s==='warn'?_EFPAL.warnSoft:_EFPAL.badSoft;}
function _efKo(s){return s==='good'?'양호':s==='warn'?'주의':'누수';}
function _efSt(sc){ if(sc==null)return 'warn'; return sc>=75?'good':(sc>=60?'warn':'bad'); }       // 점수→상태(75/60)
function _efSub(state){ return state==='good'?'good':(state==='caution'?'warn':(state==='leak'?'bad':'warn')); } // 플로우상태→good/warn/bad
function _efJosa(w,wb,wo){ if(w==null)return ''; var ch=w.charCodeAt(w.length-1)-0xac00; var b=(ch>=0&&ch<=11171)&&(ch%28!==0); return w+(b?wb:wo); }
function _efV(x,u){ return (x==null)?'–':(x+(u||'')); }
// 6단계 데이터 (ETDIAG 노드 점수 + 플로우 sub) — 김범준 등 실데이터
function _efPhases(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null; if(!X) return null;
  var W=X.windup||{},S=X.stride||{},B=X.blocking||{},K=X.knee5||{},T=X.trunk7||{},PT=X.pelvistrunk6||{},AA=X.trunkarm8||{},AB=X.armball9||{};
  var _ss=(typeof _scoreState==='function')?_scoreState:function(){return null;};
  var _fs=(typeof _flowState==='function')?_flowState:function(){return null;};
  function sub(label,val,state){ return {label:label,val:(val==null?'–':val),status:_efSub(state)}; }
  var ph=[];
  // 1 와인드업
  ph.push({n:1,key:'windup',name:'와인드업',en:'Windup',role:'탄성 저장',score:W.composite,
    flow:'로딩 자세에서 골반을 닫아 탄성을 저장하면 착지 후 회전으로 풀어 씁니다.',sub:[
    sub('힙힌지 로딩',(W.hipHinge&&W.hipHinge.atFC!=null)?W.hipHinge.atFC+'°':null,_ss(W.sub&&W.sub.hipHinge)),
    sub('골반 닫힘 유지',(W.pelvicClosure&&W.pelvicClosure.retainedPct!=null)?W.pelvicClosure.retainedPct+'%':null,_ss(W.sub&&W.sub.pelvicClosure)),
    sub('탄성 저장(X-factor)',(W.xfactor&&W.xfactor.peak!=null)?W.xfactor.peak+'°':null,_ss(W.sub&&W.sub.xftiming)),
    sub('회전 준비',(W.composite!=null)?W.composite+'점':null,_ss(W.composite))]});
  // 2 스트라이드
  ph.push({n:2,key:'stride',name:'스트라이드',en:'Stride',role:'전진 운동량',score:S.momentumScore,
    flow:'뒷다리 추진으로 전진 운동량을 만들어 블로킹에서 회전으로 전환합니다.',sub:[
    sub('뒷다리 추진',(S.rearProp&&S.rearProp.propImpulsePct!=null)?S.rearProp.propImpulsePct+'%':null,_fs(S.rearProp&&S.rearProp.propImpulsePct,'propImpPct',true)),
    sub('무게중심 전진속도',(S.comMom&&S.comMom.velFC!=null)?S.comMom.velFC+'m/s':null,_fs(S.comMom&&S.comMom.velFC,'comVel',true)),
    sub('스트라이드 길이',(S.geometry&&S.geometry.strideLenPct!=null)?S.geometry.strideLenPct+'%':null,_fs(S.geometry&&S.geometry.strideLenPct,'strideLen',true)),
    sub('전진 운동량',(S.momentumScore!=null)?S.momentumScore+'점':null,_ss(S.momentumScore))]});
  // 3 블로킹
  ph.push({n:3,key:'block',name:'블로킹',en:'Blocking',role:'전진→회전 전환',score:B.functionalScore,
    flow:'앞발 제동으로 전진을 멈춰 회전 에너지로 전환합니다.',sub:[
    sub('앞발 제동력',(B.apBrake&&B.apBrake.peakPctBW!=null)?B.apBrake.peakPctBW+'%BW':null,_fs(B.apBrake&&B.apBrake.peakPctBW,'apBrake',true)),
    sub('전진E→회전E',(B.comKE&&B.comKE.dropFCtoMin!=null)?B.comKE.dropFCtoMin+'J':null,_fs(B.comKE&&B.comKE.dropFCtoMin,'comKEdrop',true)),
    sub('상체 회전 가속',(B.functionalScore!=null)?B.functionalScore+'점':null,_ss(B.functionalScore))]});
  // 4 앞무릎
  ph.push({n:4,key:'knee',name:'앞무릎',en:'Front Knee',role:'회전 가속',score:K.kneeTransferScore,
    flow:'수직 지면반력을 앞무릎이 버텨 골반 회전으로 전달합니다.',sub:[
    sub('수직 지면반력',(K.vgrf&&K.vgrf.peakPctBW!=null)?K.vgrf.peakPctBW+'%BW':null,_fs(K.vgrf&&K.vgrf.peakPctBW,'leadGrf',true)),
    sub('앞무릎 버팀(붕괴↓)',(K.angle&&K.angle.lateCollapse!=null)?K.angle.lateCollapse+'°':null,_fs(K.angle&&K.angle.lateCollapse,'kneeCollapse',false)),
    sub('골반 회전 전달',(K.pelvis&&K.pelvis.angVelPeak!=null)?K.pelvis.angVelPeak+'°/s':null,_fs(K.pelvis&&K.pelvis.angVelPeak,'pelvisRotV',true)),
    sub('회전 가속',(K.kneeTransferScore!=null)?K.kneeTransferScore+'점':null,_ss(K.kneeTransferScore))]});
  // 5 몸통
  ph.push({n:5,key:'trunk',name:'몸통',en:'Trunk',role:'회전 증폭',score:T.prodScore,
    flow:'골반에서 받은 에너지를 키워 팔로 넘깁니다.',sub:[
    sub('골반→몸통 증폭',(PT.ampScore!=null)?PT.ampScore+'점':null,_ss(PT.ampScore)),
    sub('회전·굴곡 생성',(T.eTotalPeak!=null)?T.eTotalPeak+'J':null,_ss(T.prodScore)),
    sub('몸통→팔 전달',(AA.trunkArmHandoff!=null)?String(AA.trunkArmHandoff):null,_ss(AA.taScore)),
    sub('팔로 전달',(AA.armSelfReliance!=null)?'ASR '+AA.armSelfReliance:null,_ss(AA.taScore))]});
  // 6 팔 — armball9 내부 norm 기반 상태
  function _nst(v,n,hi){ if(v==null||!n)return null; if(hi)return v>=n.med?'good':(v>=n.q1?'caution':'leak'); return v<=n.med?'good':(v<=n.q3?'caution':'leak'); }
  var ABN=AB.norm||{};
  ph.push({n:6,key:'arm',name:'팔',en:'Arm',role:'릴리스 출력',score:AB.abScore,
    flow:'몸통에서 넘어온 에너지를 손끝 구속으로 풀어냅니다.',sub:[
    sub('어깨 내회전속도',(AA.shoulderIRpeak!=null)?AA.shoulderIRpeak+'°/s':null,_fs(AA.shoulderIRpeak,'armRotV',true)),
    sub('손 속도',(AB.handSpeedPeak!=null)?AB.handSpeedPeak+'m/s':null,_nst(AB.handSpeedPeak,ABN.handSpeed,true)),
    sub('릴리스 구속',(AB.ballVelocityKmh!=null)?AB.ballVelocityKmh+'km/h':null,_nst(AB.ballVelocityKmh,ABN.ballV,true)),
    sub('출력 효율',(AB.abScore!=null)?AB.abScore+'점':null,_ss(AB.abScore))]});
  ph.forEach(function(p){ p.status=_efSt(p.score); p.score=(p.score==null?'–':p.score); });
  return ph;
}
function _efDiagnose(ph){
  var av=ph.filter(function(p){return typeof p.score==='number';});
  var sorted=av.slice().sort(function(a,b){return a.score-b.score;});
  var worst=sorted[0]||ph[0], second=sorted[1]||worst;
  function root(p){ var b=p.sub.filter(function(s){return s.status==='bad';}); return b.length?b[0].label:p.role; }
  var lead='가장 큰 누수는 '+worst.n+'단계 '+worst.name+' ('+worst.score+'점) — '+_efJosa(root(worst),'이','가')+' 약해 '+_efJosa(worst.role,'이','가')+' 새고 있습니다.';
  var follow='이어 '+second.n+'단계 '+second.name+' ('+second.score+'점)에서 '+_efJosa(second.role,'을','를')+' 충분히 넘기지 못합니다.';
  var avg=av.length?Math.round(av.reduce(function(a,p){return a+p.score;},0)/av.length):'–';
  return {worst:worst,second:second,lead:lead,follow:follow,avg:avg};
}
// Catmull-Rom 스무딩
function _efSmooth(pts){ var d='M'+pts[0].x+' '+pts[0].y; for(var i=0;i<pts.length-1;i++){var p0=pts[i-1]||pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]||p2;var c1x=p1.x+(p2.x-p0.x)/6,c1y=p1.y+(p2.y-p0.y)/6,c2x=p2.x-(p3.x-p1.x)/6,c2y=p2.y-(p3.y-p1.y)/6;d+=' C'+c1x.toFixed(1)+' '+c1y.toFixed(1)+' '+c2x.toFixed(1)+' '+c2y.toFixed(1)+' '+p2.x.toFixed(1)+' '+p2.y.toFixed(1);} return d; }
var _BM_NODES=[{x:168,y:196},{x:332,y:214},{x:502,y:210},{x:680,y:220},{x:858,y:210},{x:1028,y:206}], _BM_W=1200,_BM_H=512;
var _BM_PH=null, _BM_SEL=null;
function _bmDrillHTML(p){ var P=_EFPAL,c=_efCol(p.status);
  var subs=p.sub.map(function(s,i){ var sc=_efCol(s.status);
    return '<div style="flex:1 1 0;min-width:0;text-align:center;background:'+P.bg2+';border:1px solid '+P.line+';border-bottom:2px solid '+sc+';border-radius:8px;padding:8px 6px"><div style="font-size:11px;color:'+P.fg1+';line-height:1.3;margin-bottom:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+s.label+'</div><div style="font-size:14.5px;font-weight:800;color:'+sc+'">'+s.val+'</div></div>'+(i<p.sub.length-1?'<div style="flex:0 0 auto;align-self:center;color:'+P.fg2+';font-size:13px;font-weight:800">&rarr;</div>':'');
  }).join('');
  return '<div style="background:'+P.bg1+';border:1px solid '+P.line+';border-radius:10px;padding:12px 14px;min-height:124px;box-sizing:border-box">'
    +'<div style="display:flex;align-items:center;gap:9px;margin-bottom:11px"><span style="width:22px;height:22px;border-radius:6px;background:'+_efSoft(p.status)+';color:'+c+';display:grid;place-items:center;font-size:12px;font-weight:800">'+p.n+'</span>'
    +'<span style="font-size:14px;font-weight:800;color:'+P.fg0+'">'+p.name+'</span><span style="font-size:11.5px;color:'+P.fg2+'">'+p.en+' · '+p.role+'</span>'
    +'<span style="margin-left:auto;font-size:11px;font-weight:700;color:'+c+';background:'+_efSoft(p.status)+';padding:3px 9px;border-radius:20px">'+_efKo(p.status)+' · '+p.score+'점</span></div>'
    +'<div style="display:flex;align-items:stretch;gap:4px">'+subs+'</div>'
    +'<div style="font-size:11.5px;color:'+P.fg2+';margin-top:9px;line-height:1.5">원인 → 과정 → 결과 · '+p.flow+'</div></div>';
}
window._bmHover=function(key){ if(!_BM_PH)return; var p=null; for(var i=0;i<_BM_PH.length;i++)if(_BM_PH[i].key===key)p=_BM_PH[i]; if(!p)return; _BM_SEL=key;
  var dr=document.getElementById('bm-drill'); if(dr)dr.innerHTML=_bmDrillHTML(p);
  for(var j=0;j<_BM_PH.length;j++){ var mk=document.getElementById('bm-mk-'+_BM_PH[j].key); if(mk){var on=_BM_PH[j].key===key;var cc=_efCol(_BM_PH[j].status);mk.style.width=(on?38:32)+'px';mk.style.height=(on?38:32)+'px';mk.style.borderWidth=(on?3.5:3)+'px';mk.style.fontSize=(on?16:14)+'px';mk.parentNode.style.zIndex=on?5:2;} }
};
function _bodyMapHTML(){
  var P=_EFPAL, ph=_efPhases(); if(!ph){ return ''; }
  _BM_PH=ph; var dx=_efDiagnose(ph); _BM_SEL=dx.worst.key;
  var IMG=(typeof _KSTRIP_URI!=='undefined')?_KSTRIP_URI:'';
  var pts=ph.map(function(p,i){return {x:_BM_NODES[i].x,y:_BM_NODES[i].y};});
  var legend='<div style="display:flex;gap:14px;align-items:center">'+[['good','양호'],['warn','주의'],['bad','누수']].map(function(it){return '<div style="display:flex;gap:6px;align-items:center"><span style="font-size:12px;line-height:1;color:'+_efCol(it[0])+'">'+(it[0]==='good'?'●':it[0]==='warn'?'◐':'▲')+'</span><span style="font-size:12px;color:'+P.fg1+'">'+it[1]+'</span></div>';}).join('')+'</div>';
  var sparks=ph.map(function(p,i){return p.status==='bad'?'<circle cx="'+pts[i].x+'" cy="'+pts[i].y+'" r="20" fill="none" stroke="'+P.bad+'" stroke-width="3"><animate attributeName="r" values="14;30;14" dur="2.4s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.75;0;0.75" dur="2.4s" repeatCount="indefinite"/></circle>':'';}).join('');
  var markers=ph.map(function(p,i){ var c=_efCol(p.status),on=p.key===_BM_SEL,left=(_BM_NODES[i].x/_BM_W)*100,topp=(_BM_NODES[i].y/_BM_H)*100;
    return '<div onmouseenter="_bmHover(\''+p.key+'\')" onclick="_bmHover(\''+p.key+'\')" style="position:absolute;left:'+left+'%;top:'+topp+'%;transform:translate(-50%,-50%);cursor:pointer;z-index:'+(on?5:2)+'">'+(p.key===dx.worst.key?'<div style="position:absolute;left:50%;bottom:calc(100% + 7px);transform:translateX(-50%);white-space:nowrap;background:'+P.bad+';color:#fff;font-size:11px;font-weight:800;padding:2px 8px;border-radius:20px;box-shadow:0 2px 8px rgba(0,0,0,.45)">▲ 병목</div>':'')
      +'<div id="bm-mk-'+p.key+'" style="width:'+(on?38:32)+'px;height:'+(on?38:32)+'px;border-radius:50%;background:rgba(14,18,24,.9);border:'+(on?3.5:3)+'px solid '+c+';box-shadow:0 2px 8px rgba(0,0,0,.4)'+(p.status==='bad'?', 0 0 0 4px '+P.badSoft:'')+';display:grid;place-items:center;color:'+c+';font-size:'+(on?16:14)+'px;font-weight:800;transition:all .12s">'+p.n+'</div>'
      +'<div style="position:absolute;left:50%;top:calc(100% + 5px);transform:translateX(-50%);white-space:nowrap;background:rgba(14,18,24,.92);border:1px solid '+c+'66;border-radius:7px;padding:3px 8px;text-align:center"><div style="font-size:11.5px;font-weight:700;color:'+P.fg0+';line-height:1.2">'+p.name+'</div><div style="font-size:13px;font-weight:800;color:'+c+';line-height:1.1">'+(p.status==='good'?'●':p.status==='warn'?'◐':'▲')+' '+p.score+'</div></div></div>';
  }).join('');
  var diag='<div style="display:flex;gap:14px;align-items:flex-start;background:linear-gradient(180deg,'+P.bg2+','+P.bg1+');border:1px solid '+P.line+';border-left:3px solid '+P.bad+';border-radius:10px;padding:13px 16px">'
    +'<div style="flex:0 0 auto;width:30px;height:30px;border-radius:8px;background:'+P.badSoft+';color:'+P.bad+';display:grid;place-items:center;font-size:16px;font-weight:800;line-height:1">!</div>'
    +'<div style="flex:1"><div style="font-size:11px;letter-spacing:.08em;color:'+P.fg2+';font-weight:700;margin-bottom:4px">자동 진단 · 에너지 누수 지점</div>'
    +'<div style="font-size:14px;line-height:1.6;color:'+P.fg0+';font-weight:600">'+dx.lead+'</div><div style="font-size:13px;line-height:1.6;color:'+P.fg1+';margin-top:3px">'+dx.follow+'</div></div>'
    +'<div style="flex:0 0 auto;text-align:right;padding-left:8px"><div style="font-size:11px;color:'+P.fg2+';font-weight:700;letter-spacing:.06em">사슬 평균</div><div style="font-size:26px;font-weight:800;color:'+P.fg0+';line-height:1.05">'+dx.avg+'<span style="font-size:13px;color:'+P.fg2+';font-weight:700"> 점</span></div></div></div>';
  var html='<div class="card" style="grid-column:1 / -1;background:'+P.bg1+';border:1px solid '+P.line+';font-family:-apple-system,Malgun Gothic,sans-serif;color:'+P.fg0+'">'
    +'<div style="display:flex;align-items:baseline;gap:10px;margin-bottom:2px;flex-wrap:wrap"><div style="font-size:18px;font-weight:800;letter-spacing:-.01em">신체 에너지 사슬</div><div style="font-size:12.5px;color:'+P.fg2+'">동작 시퀀스 좌 → 우 · 부위별 누수 지도</div><div style="margin-left:auto">'+legend+'</div></div>'
    +'<div style="font-size:12px;color:'+P.fg2+';margin-bottom:10px">빨간 마커가 켜진 부위에서 다음 단계로 에너지가 덜 넘어갑니다.</div>'
    +'<div style="position:relative;width:100%;aspect-ratio:'+_BM_W+'/'+_BM_H+';border-radius:12px;overflow:hidden;border:1px solid '+P.line+';background:#eef1f4">'
    +(IMG?'<img src="'+IMG+'" alt="투구 연속 동작" style="display:block;width:100%;height:100%">':'')
    +'<div style="position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.4), inset 0 -40px 60px -30px rgba(14,18,24,.5)"></div>'
    +'<svg viewBox="0 0 '+_BM_W+' '+_BM_H+'" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"><defs><linearGradient id="bFlow" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="'+P.navyDeep+'"/><stop offset="1" stop-color="'+P.navy+'"/></linearGradient></defs>'
    +'<path d="'+_efSmooth(pts)+'" fill="none" stroke="#ffffff" stroke-opacity="0.75" stroke-width="7" stroke-linecap="round"/><path d="'+_efSmooth(pts)+'" fill="none" stroke="url(#bFlow)" stroke-width="3.5" stroke-linecap="round"/>'+sparks+'</svg>'
    +markers+'</div>'
    +'<div style="margin-top:14px;margin-bottom:12px">'+diag+'</div>'
    +'<div style="margin-top:6px;display:flex;flex-direction:column;gap:10px">'+ph.map(function(p){return _bmDrillHTML(p);}).join('')+'</div></div>';
  return html;
}
function renderBodyMap(rootId){ var root=document.getElementById(rootId); if(root) root.innerHTML=_bodyMapHTML(); }

var _EF_LIGHT={bg0:'#ffffff',bg1:'#f6f8fb',bg2:'#eef2f7',bg3:'#e3e9f1',line:'#d3dce6',fg0:'#16202e',fg1:'#3f4f63',fg2:'#6b7a8c',navy:'#2f6fb0',navyDeep:'#27577f',good:'#2f9e6e',goodSoft:'rgba(47,158,110,.12)',warn:'#bd7d22',warnSoft:'rgba(189,125,34,.13)',bad:'#cf4636',badSoft:'rgba(207,70,54,.11)'};
// 선수용(출력 PDF) 야구 언어 번역 · 교정 드릴
var _BM_BLANG={windup:'고무줄 감기 — 몸을 비틀어 힘을 저장',stride:'앞으로 힘차게 달려나가기',block:'앞발로 브레이크 밟고 회전으로 전환',knee:'앞다리 펴면서 골반 빠르게 돌리기',trunk:'몸통으로 힘을 더 키우기',arm:'팔을 채찍처럼 휘둘러 던지기'};
var _BM_DRILL={
 windup:{cue:'뒷주머니를 포수에게 보여준다는 느낌으로 골반을 끝까지 닫고 잠깐 버티기',drill:'거울 앞 와인드업 정지 자세 10회 × 3세트'},
 stride:{cue:'뒷발로 땅을 길게 밀어 앞으로 — 보폭은 키의 약 85%까지',drill:'벽 밀기 + 메디신볼 전방 스텝 던지기 8회 × 3세트'},
 block:{cue:'앞발을 땅에 쾅 박고 앞무릎을 더 굽히지 말고 버티기(브레이크)',drill:'박스 스텝다운 착지 정지 8회 × 3세트'},
 knee:{cue:'착지한 앞다리를 펴면서 그 힘으로 골반을 빠르게 돌리기',drill:'앞다리 신전 + 골반 회전 연결 드릴 10회 × 3세트'},
 trunk:{cue:'골반이 먼저 돌고 가슴(몸통)은 살짝 늦게 따라 열기',drill:'골반↔어깨 분리 회전 + 케이블 회전 10회 × 3세트'},
 arm:{cue:'몸통 힘으로 팔이 따라오게 — 팔로 억지로 던지지 않기',drill:'커넥션볼 또는 타월 드릴로 순서 익히기 10회 × 3세트'}
};
function _bmPlayerExtras(){
  var P=_EFPAL, ph=_efPhases(); if(!ph) return {top:'',bottom:''};
  var dx=_efDiagnose(ph), w=dx.worst;
  function num(p){ return (typeof p.score==='number')?p.score:null; }
  function bar(sc,col){ var ww=Math.max(2,Math.min(100,sc||0)); return '<div style="position:relative;height:15px;background:'+P.bg2+';border-radius:8px;overflow:hidden;border:1px solid '+P.line+'"><div style="position:absolute;left:0;top:0;bottom:0;width:'+ww+'%;background:'+col+'"></div><div style="position:absolute;left:75%;top:-2px;bottom:-2px;width:2px;background:'+P.fg2+'"></div></div>'; }
  var wcol=_efCol(w.status);
  var top='<div style="background:'+_efSoft(w.status)+';border:1px solid '+wcol+';border-left:7px solid '+wcol+';border-radius:12px;padding:16px 20px;margin-bottom:16px;font-family:-apple-system,Malgun Gothic,sans-serif">'
    +'<div style="font-size:12px;font-weight:800;letter-spacing:.06em;color:'+P.fg2+'">오늘의 한 줄 결론</div>'
    +'<div style="font-size:19px;font-weight:800;color:'+P.fg0+';margin-top:5px;line-height:1.45"><span style="color:'+wcol+'">'+w.n+'단계 '+w.name+'</span>에서 힘이 가장 많이 샙니다. 여기 한 곳만 고치면 공이 더 빨라집니다.</div>'
    +'<div style="font-size:14px;color:'+P.fg1+';margin-top:7px">쉬운 말로 — '+_BM_BLANG[w.key]+' : 이게 아직 잘 안 되고 있어요.</div></div>';
  var rows=ph.map(function(p){ var sc=num(p),col=_efCol(p.status);
    return '<div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid '+P.line+'">'
      +'<div style="flex:0 0 132px"><div style="font-size:13.5px;font-weight:800;color:'+P.fg0+'">'+p.n+'. '+p.name+'</div><div style="font-size:11px;color:'+P.fg2+';line-height:1.3">'+_BM_BLANG[p.key]+'</div></div>'
      +'<div style="flex:1;min-width:0">'+bar(sc,col)+'</div>'
      +'<div style="flex:0 0 58px;text-align:right;font-size:15px;font-weight:800;color:'+col+'">'+(sc==null?'–':sc)+'<span style="font-size:11px;color:'+P.fg2+';font-weight:600">점</span></div></div>';
  }).join('');
  var cmp='<div style="background:'+P.bg1+';border:1px solid '+P.line+';border-radius:12px;padding:14px 18px;margin-top:16px;font-family:-apple-system,Malgun Gothic,sans-serif">'
    +'<div style="font-size:15px;font-weight:800;color:'+P.fg0+'">또래(엘리트 또래 투수)와 비교</div>'
    +'<div style="font-size:12px;color:'+P.fg2+';margin:3px 0 8px">막대가 길수록 잘하는 것 · 점선(75점)을 넘으면 또래 상위권입니다.</div>'+rows+'</div>';
  var d=_BM_DRILL[w.key]||{cue:'',drill:''};
  var task='<div style="background:'+_efSoft(w.status)+';border:1px solid '+wcol+';border-left:7px solid '+wcol+';border-radius:12px;padding:16px 20px;margin-top:16px;font-family:-apple-system,Malgun Gothic,sans-serif">'
    +'<div style="font-size:12px;font-weight:800;letter-spacing:.05em;color:'+P.fg2+'">가장 먼저 고칠 것 (1가지만)</div>'
    +'<div style="font-size:18px;font-weight:800;color:'+P.fg0+';margin-top:4px">'+w.n+'단계 '+w.name+' <span style="font-size:13px;color:'+wcol+';font-weight:700">'+w.score+'점</span></div>'
    +'<div style="font-size:13.5px;color:'+P.fg1+';margin-top:8px"><b style="color:'+P.fg0+'">왜?</b> '+_efJosa(w.role,'이','가')+' 약해서 다음 단계로 힘이 잘 넘어가지 않아요.</div>'
    +'<div style="font-size:13.5px;color:'+P.fg1+';margin-top:5px"><b style="color:'+P.fg0+'">이렇게 해보기 —</b> '+d.cue+'</div>'
    +'<div style="font-size:13.5px;color:'+P.fg0+';margin-top:5px;font-weight:700"><b style="color:'+wcol+'">훈련:</b> '+d.drill+'</div></div>';
  var chk=ph.map(function(p){ var dd=_BM_DRILL[p.key]||{drill:''};
    return '<div style="display:flex;align-items:flex-start;gap:11px;padding:8px 0;border-bottom:1px dashed '+P.line+'">'
      +'<span style="flex:0 0 auto;width:17px;height:17px;border:2px solid '+P.fg2+';border-radius:4px;margin-top:1px"></span>'
      +'<div style="font-size:13px;color:'+P.fg1+'"><b style="color:'+P.fg0+'">'+p.n+'. '+p.name+'</b> — '+dd.drill+'</div></div>';
  }).join('');
  var check='<div style="background:'+P.bg1+';border:1px solid '+P.line+';border-radius:12px;padding:14px 18px;margin-top:16px;font-family:-apple-system,Malgun Gothic,sans-serif">'
    +'<div style="font-size:15px;font-weight:800;color:'+P.fg0+'">훈련 체크리스트 <span style="font-size:12px;color:'+P.fg2+';font-weight:600">출력해서 들고 다니며 체크하세요</span></div><div style="margin-top:6px">'+chk+'</div></div>';
  return {top:top, bottom:cmp+task+check};
}


function renderCoachView(rootId){
  // [2026-05-28 V2] rootId 인자로 선수 요약(ed-body-psummary)과 코칭 뷰(ed-body-coach-view) 둘 다 지원
  var root=document.getElementById(rootId||'ed-body-coach-view'); if(!root) return;
  // 이미 다른 곳에 입양돼 있으면 먼저 원위치 (재진입 안전성)
  try{ _cvRestoreAll(); }catch(e){}
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null;
  if(!X||!X.stages){ root.innerHTML='<div class="card"><div class="note">코칭 뷰는 9단계 에너지 전달 진단(지면반력+관절파워 있는 Theia 분석)이 있을 때 표시됩니다.</div></div>'; return; }
  var S=_ps9(); if(!S){ root.innerHTML='<div class="card"><div class="note">_ps9 데이터 없음</div></div>'; return; }
  var hpa=DATA.hp_assessment||{}, cmd=DATA.command||{}, vs=DATA.velo_summary||{};
  var pl=(DATA.player&&DATA.player.name)||'선수';
  var measV=DATA.measured_kmh||(vs&&vs.max_kmh)||null;
  var SM={}; S.forEach(function(s){SM[s.key]={sc:s.score,status:s.status,cName:s.cName,pName:s.pName,imp:s.imp,tab:s.tab};});
  function _avg(ks){var v=ks.map(function(k){return SM[k]&&SM[k].sc;}).filter(function(x){return x!=null&&isFinite(x);});return v.length?v.reduce(function(a,b){return a+b;},0)/v.length:null;}
  var GEN=['stride','blocking','trunk'], TR=['knee','pelvistrunk','xftiming'];
  var outSc=_avg(GEN), effSc=_avg(TR), fitSc=(hpa.overall_score!=null&&isFinite(hpa.overall_score))?hpa.overall_score:null;
  var OUT_BL=[53.3,55.7,57.3,58,59,59.7,60.3,61.3,62,62.7,62.7,63,63.3,63.7,63.7,64,65.7,66,66.3,66.3,67,68,70,71.3,71.7,72.3,73.3,73.7,73.7,75.7,76.3,77.7,78.3,82.7];
  var EFF_BL=[53.0,53.5,58.2,58.2,58.8,60.0,60.3,63.5,64.8,65.2,66.2,66.7,69.8,69.8,70.2,70.5,70.7,71.2,71.2,72.5,72.8,73.7,74.8,75.5,76.0,76.0,76.3,77.0,77.3,78.0,79.0,80.0,81.0,85.3];
  var VELO_BL=[110.4,110.6,118.9,119,121,122.3,127.6,128.4,128.5,129.1,129.2,129.2,133.7,134.7,134.8,138.2,138.4,139.6,140.1,140.1,140.8,140.9,141.2,141.5,141.9,143,143.5,144.7,144.7,145.6,146.3,147.7,148.2,150];
  function _pct(arr,v){if(v==null||!isFinite(v))return null;var c=0;for(var i=0;i<arr.length;i++)if(arr[i]<v)c++;return Math.round(100*c/arr.length);}
  var outPct=_pct(OUT_BL,outSc), effPct=_pct(EFF_BL,effSc), veloPct=_pct(VELO_BL,measV);
  // 1순위 과제(세 축)
  var axes=[];
  if(fitSc!=null) axes.push({k:'체력',sc:fitSc,col:'#9c8cff'});
  if(outSc!=null) axes.push({k:'메카닉 출력',sc:outSc,col:'#5bd3ff'});
  if(effSc!=null) axes.push({k:'메카닉 효율',sc:effSc,col:'#46c98c'});
  axes.sort(function(a,b){return a.sc-b.sc;});
  var prio=axes[0];
  var allGood=axes.length>=2 && axes.every(function(a){return a.sc>=70;});
  var typLabel=allGood?{t:'균형형(완성단계)',c:'#46c98c'}:(prio?{t:prio.k+' 1순위 과제형',c:prio.col}:null);
  function _worst(ks){return ks.map(function(k){return {k:k,sc:SM[k]&&SM[k].sc,nm:SM[k]&&SM[k].pName};}).filter(function(x){return x.sc!=null;}).sort(function(a,b){return a.sc-b.sc;});}
  var avail=S.filter(function(s){return s.score!=null;});
  var bottlenecks=avail.filter(function(s){return s.score<75;}).map(function(s){return Object.assign({sev:(100-s.score)*s.imp},s);}).sort(function(a,b){return b.sev-a.sev;}).slice(0,3);
  // 헬퍼: 게이지 + 점프 버튼
  function gauge(col,lab,sc,pct){
    var pp=pct!=null?pct:(sc||0);
    return '<div style="margin:6px 0"><div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--fg2)"><span>'+lab+'</span><b style="color:var(--fg)">'+(sc!=null?Math.round(sc):'—')+(pct!=null?' · '+pct+'p':'')+'</b></div><div style="height:8px;background:var(--bg1);border-radius:5px;overflow:hidden;margin-top:3px"><div style="height:100%;background:'+col+';width:'+Math.max(0,Math.min(100,pp))+'%"></div></div></div>';
  }
  function btn(lbl,pg,col){return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--cyan)')+';border-radius:6px;padding:5px 11px;cursor:pointer;margin:2px 4px 2px 0">'+lbl+'</button>';}
  // 챕터 ↔ ed-* 매핑
  var CHAP={
    'Ch2':{name:'엔진 — 출력',col:'#5bd3ff',bg:'rgba(91,211,255,.08)',pages:[{k:'ed-stride',l:'스트라이드'},{k:'ed-blocking',l:'블로킹'},{k:'ed-trunk',l:'몸통 에너지'}],nodes:GEN},
    'Ch3':{name:'사슬 — 전달',col:'#46c98c',bg:'rgba(70,201,140,.08)',pages:[{k:'ed-knee',l:'무릎 이용'},{k:'ed-pelvistrunk',l:'골반→몸통'},{k:'ed-xftiming',l:'X-factor'},{k:'ed-trunkarm',l:'몸통→팔'}],nodes:TR},
    'Ch4':{name:'결과 — 구속·랩소도·팔 부담',col:'#e8954e',bg:'rgba(232,149,78,.08)',pages:[{k:'ed-armball',l:'팔→공'}],nodes:['armball']}
  };
  // ── 챕터 본문 빌드 ──
  var html='';
  html+=_edFlowBand([{label:'① 와인드업',val:(SM.windup&&SM.windup.sc!=null)?SM.windup.sc+'점':null,state:_scoreState(SM.windup&&SM.windup.sc)},{label:'② 스트라이드',val:(SM.stride&&SM.stride.sc!=null)?SM.stride.sc+'점':null,state:_scoreState(SM.stride&&SM.stride.sc)},{label:'③ 블로킹',val:(SM.blocking&&SM.blocking.sc!=null)?SM.blocking.sc+'점':null,state:_scoreState(SM.blocking&&SM.blocking.sc)},{label:'④ 앞무릎',val:(SM.knee&&SM.knee.sc!=null)?SM.knee.sc+'점':null,state:_scoreState(SM.knee&&SM.knee.sc)},{label:'⑤ 몸통',val:(SM.trunk&&SM.trunk.sc!=null)?SM.trunk.sc+'점':null,state:_scoreState(SM.trunk&&SM.trunk.sc)},{label:'⑥ 팔',val:(SM.armball&&SM.armball.sc!=null)?SM.armball.sc+'점':null,state:_scoreState(SM.armball&&SM.armball.sc)}],'투구 에너지 사슬 한눈 보기 — 저장(와인드업)→전진(스트라이드)→제동·전환(블로킹)→앞무릎 전달→몸통 생성·전달→팔. 빨간 단계가 전체 흐름의 병목입니다.');
  // 상단: 모드 토글 + 챕터 네비
  html+='<div class="card" style="grid-column:1 / -1;background:var(--bg2);padding:10px 14px;position:sticky;top:0;z-index:5">'
    +'<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">'
    +'<div style="font-size:14px;font-weight:800">코칭 뷰 — '+pl+(measV?' · '+measV.toFixed(1)+'km/h':'')+(typLabel?'  <span style="color:'+typLabel.c+';font-size:12px;margin-left:6px">· '+typLabel.t+'</span>':'')+'</div>'
    +'<div style="display:flex;gap:6px;align-items:center;font-size:11px">'
    +'<a href="#cv-ch1" style="color:var(--fg2);text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">Ch1 소개</a>'
    +'<a href="#cv-ch2" style="color:#5bd3ff;text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">Ch2 출력</a>'
    +'<a href="#cv-ch3" style="color:#46c98c;text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">Ch3 전달</a>'
    +'<a href="#cv-ch4" style="color:#e8954e;text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">Ch4 결과</a>'
    +'<a href="#cv-ch5" style="color:#9c8cff;text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">Ch5 우선과제</a>'
    +'<a href="#cv-app" style="color:var(--fg2);text-decoration:none;padding:3px 8px;border-radius:6px;background:var(--bg1)">부록</a>'
    +'<button onclick="_cvToggleMode()" id="cv-mode-btn" style="margin-left:8px;font-size:11px;background:var(--bg1);color:var(--cyan);border:1px solid var(--cyan);border-radius:6px;padding:3px 10px;cursor:pointer">분석 모드</button>'
    +'</div></div></div>';

  // Ch1 — 소개·정체성
  html+='<div class="card" id="cv-ch1" style="grid-column:1 / -1">'
    +'<div style="font-size:11px;color:var(--fg2)">Ch 1 · 소개·정체성</div>'
    +'<div style="font-size:16px;font-weight:800;margin-top:4px">'+pl+' · '+(measV?measV.toFixed(1):'—')+' km/h'+(veloPct!=null?' (코호트 '+veloPct+'p)':'')+'</div>'
    +(typLabel?'<div style="margin-top:6px;font-size:13px"><b style="color:'+typLabel.c+'">유형: '+typLabel.t+'</b> — 세 축 중 가장 낮은 영역이 1순위 과제입니다.</div>':'')
    +'<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px">'
    +'<div style="padding:8px 10px;background:rgba(156,140,232,.1);border-radius:8px">'+gauge('linear-gradient(90deg,#7048e8,#c4b3f3)','체력',fitSc,null)+'</div>'
    +'<div style="padding:8px 10px;background:rgba(91,211,255,.1);border-radius:8px">'+gauge('linear-gradient(90deg,#1b80c4,#5bd3ff)','메카닉 출력',outSc,outPct)+'</div>'
    +'<div style="padding:8px 10px;background:rgba(70,201,140,.1);border-radius:8px">'+gauge('linear-gradient(90deg,#1f7a4d,#46c98c)','메카닉 효율',effSc,effPct)+'</div>'
    +'</div></div>';

  // [V2] 챕터 본문 생성기 — ed-* 콘텐츠 인라인 슬롯 포함
  function chapter(id,chap,desc){
    var worst=_worst(chap.nodes);
    var w0=worst[0];
    // 챕터 카드: 헤더 + 약한 곳 요약
    var h='<div class="card" id="'+id+'" style="grid-column:1 / -1;background:'+chap.bg+';border-left:4px solid '+chap.col+';padding-bottom:4px">'
      +'<div style="font-size:11px;color:var(--fg2)">'+id.replace('cv-ch','Ch ')+'</div>'
      +'<div style="font-size:15px;font-weight:800;margin-top:3px;color:'+chap.col+'">'+chap.name+'</div>'
      +'<div class="note" style="margin-top:6px">'+desc+'</div>'
      +(w0?'<div style="margin-top:8px;font-size:12.5px"><b style="color:'+chap.col+'">이 영역 약한 곳:</b> '+w0.nm+' '+w0.sc+'점</div>':'')
      +'</div>';
    // [V2] 챕터 내 각 ed-* 진단 콘텐츠 인라인 슬롯 (cv-toggle로 스토리/분석 모드에서 펼침 제어)
    chap.pages.forEach(function(p){
      var key=p.k.replace(/^ed-/,'');
      var snm=SM[key]; var sc=snm?snm.sc:null;
      var stc=(snm&&snm.status==='good')?'#46c98c':((snm&&snm.status==='caution')?'#e8954e':'#e24b4a');
      // details(cv-toggle) 안에 슬롯 — 스토리 모드(기본 접힘)/분석 모드(자동 펼침)
      h+='<details class="cv-toggle cv-ed-detail" data-cv-key="'+key+'" style="margin:0 0 8px 0">'
        +'<summary style="cursor:pointer;padding:9px 14px;background:var(--bg2);border-radius:8px;border-left:3px solid '+chap.col+';display:flex;justify-content:space-between;align-items:center">'
        +'<span><b style="color:'+chap.col+'">'+p.l+'</b>'+(sc!=null?'  <span style="color:'+stc+';font-weight:800;margin-left:6px">'+sc+'점</span>':'')+'</span>'
        +'<span style="font-size:11px;color:var(--fg2)">진단 카드 펼침 ▼</span>'
        +'</summary>'
        +'<div class="cv-ed-slot" data-cv-slot="'+key+'" style="padding:8px 0 0 0;min-height:60px"><div class="note" style="padding:10px">로딩 중...</div></div>'
        +'</details>';
    });
    return h;
  }

  // [2026-05-28] Ch2~4 제거 → 에너지 전달 흐름 지도 (9단계 카드, 각 단계 색 바 + 약한 변인 1개)
  var CAT_COL={out:'#5bd3ff',eff:'#46c98c',store:'#9c8cff',load:'#e8954e'};
  var CAT_LBL={out:'출력',eff:'전달',store:'저장',load:'부하'};
  // [2026-05-28 개정] 각 단계의 가장 나쁜 세부 변인 — 정확한 변인명(한국어) + 값 + 짧은 설명.
  //   {name:'...', desc:'...'} 반환. typeKo(야구 유형) 제거 — 너무 모호하다는 사용자 피드백.
  function _weakestVar(stage){
    if(!stage||!X) return null;
    var R=X.rep||{}, key=stage.key;
    var name='', desc='';
    if(key==='windup'){
      var sub=(X.windup&&X.windup.sub)||{};
      var worst=null, worstSc=999;
      Object.keys(sub).forEach(function(k){if(sub[k]!=null&&isFinite(sub[k])&&sub[k]<worstSc){worstSc=sub[k];worst=k;}});
      var WN={hipHinge:['고관절 힌지','뒷고관절을 접어 골반에 힘을 저장하는 자세'],
              pelvicClosure:['골반 닫힘 유지','와인드업~KH 구간 골반이 일찍 열리지 않고 닫혀 있는 정도'],
              xftiming:['X-factor 형성 타이밍','분리각이 형성되기 시작하는 시점'],
              rearHip:['뒷고관절 외회전','뒷다리를 외회전해 골반 회전 준비'],
              rearFoot:['뒷발 토크','뒷발이 마운드를 미는 회전 토크'],
              strideConv:['스트라이드 전환','저장된 로딩이 전진 운동량으로 변환되는 비율']};
      if(worst&&WN[worst]){name=WN[worst][0]+' '+worstSc+'점'; desc=WN[worst][1];}
      else if(X.windup&&X.windup.composite!=null){name='와인드업 종합 '+X.windup.composite+'점'; desc='힙힌지·골반닫힘 등 6개 하위변인 평균';}
    } else if(key==='xftiming'){
      var rs=R.tXfReleaseStart;
      if(rs!=null){name='X-factor 풀림 시점 FC'+(rs>=0?'+':'')+rs+'ms'; desc='분리각이 풀리기 시작한 시점(FC=0 · 적정 -10~+15ms)';}
    } else if(key==='stride'){
      if(R.comVelAtFC!=null){name='FC 전진속도 '+R.comVelAtFC+' m/s'; desc='착지 시점 무게중심 전진 속도(엘리트 ~3.5 m/s)';}
    } else if(key==='blocking'){
      if(R.apBrakePeak!=null){name='앞발 AP 제동 peak '+R.apBrakePeak+' %BW'; desc='앞다리가 전→후방향으로 만드는 제동력 최대값(체중%·엘리트 ~120)';}
    } else if(key==='knee'){
      if(R.kneeNegWork!=null){name='무릎 흡수일 '+R.kneeNegWork+' J'; desc='앞무릎이 받은 에너지 중 흡수돼 회전으로 못 이어진 부분';}
      else if(R.kneeNetExt!=null){name='앞무릎 순신전 '+R.kneeNetExt+'°'; desc='착지 후 앞무릎이 펴진 각도(+면 vault, -면 굴곡)';}
    } else if(key==='pelvistrunk'){
      if(R.gapPelvisToTrunkVel!=null){name='골반→몸통 gap '+R.gapPelvisToTrunkVel+' ms'; desc='골반 회전속도 peak에서 몸통 peak까지 시간차(짧을수록 잘 전달 · 적정 30~60ms)';}
      else if(R.trunkOverPelvisGain!=null){name='골반→몸통 증폭비 '+R.trunkOverPelvisGain; desc='몸통 회전속도 ÷ 골반 회전속도(>1.2 적정)';}
    } else if(key==='trunk'){
      if(R.trunkEpeak!=null){name='몸통 에너지 peak '+R.trunkEpeak+' J'; desc='몸통 분절 역학에너지 최댓값(엘리트 중앙 ~500 J)';}
    } else if(key==='trunkarm'){
      if(R.armSelfReliance!=null){name='팔 자가의존 ASR '+R.armSelfReliance; desc='팔 속도 중 몸통 전달 없이 팔이 만든 비율(낮을수록 좋음)';}
      else if(R.trunkArmOverlap!=null){name='핸드오프 겹침 '+R.trunkArmOverlap; desc='몸통 peak와 팔 가속의 시간 겹침(높을수록 동기화 좋음)';}
    } else if(key==='armball'){
      if(R.elbowTorque!=null){name='팔꿈치 내반 토크 peak '+R.elbowTorque+' N·m'; desc='UCL(내측측부인대)에 가해지는 부하 — 높을수록 부상 위험';}
      else if(R.shoulderTorque!=null){name='어깨 내회전 토크 peak '+R.shoulderTorque+' N·m'; desc='어깨 관절에 가해지는 부하';}
    }
    if(!name && stage.status!=='good' && stage.cName){ name=stage.cName; desc=''; }
    return name?{name:name,desc:desc}:null;
  }
  // [2026-05-28 개정] 메카닉 2축 진단 카드 (PDF 디자인 다크 테마 버전) — 흐름지도 바로 위.
  //   체력은 Ch1에서 다루고 여기는 메카닉 직속 출력·효율 2축에 집중.
  var twoAxisH=(function(){
    var o=outSc, e=effSc;
    if(o==null&&e==null) return '';
    var typTxt='', typCol='#7d8898';
    if(o!=null&&e!=null){
      if(o>=70&&e>=70){typTxt='균형형(완성단계)';typCol='#46c98c';}
      else if(o-e>=10){typTxt='출력 강점 · 효율 과제형';typCol='#46c98c';}
      else if(e-o>=10){typTxt='효율 강점 · 출력 과제형';typCol='#e8954e';}
      else{typTxt='출력·효율 동반 과제형';typCol='#e24b4a';}
    }
    // 약한 곳/병목 추출
    var GEN_S=GEN.map(function(k){return {k:k,sc:SM[k]&&SM[k].sc,nm:SM[k]&&SM[k].pName};}).filter(function(x){return x.sc!=null;}).sort(function(a,b){return a.sc-b.sc;});
    var TR_S=TR.map(function(k){return {k:k,sc:SM[k]&&SM[k].sc,nm:SM[k]&&SM[k].pName};}).filter(function(x){return x.sc!=null;}).sort(function(a,b){return a.sc-b.sc;});
    var armLoad=X.injuryLoad||null;
    var armASR=(X.rep&&X.rep.armSelfReliance);
    var h='<div class="card" style="grid-column:1 / -1;padding:0;overflow:hidden">'
      +'<div style="padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px">'
      +'<div><b style="font-size:14px">메카닉 2축 진단 — 출력 · 효율 → 결과</b></div>'
      +(typTxt?'<span style="font-size:11.5px;font-weight:800;color:'+typCol+';padding:2px 8px;border:1px solid '+typCol+';border-radius:12px">유형: '+typTxt+'</span>':'')
      +'</div>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr">'
      // 출력 축
      +'<div style="padding:12px 14px;border-right:1px solid var(--line)">'
      +'<div style="font-size:13px;font-weight:800;color:#5bd3ff;margin-bottom:5px">메카닉 출력 (생성 단계)</div>'
      +'<div style="font-size:12px;color:var(--fg2)">출력 점수 <b style="color:var(--fg)">'+(o!=null?Math.round(o):'—')+'</b>'+(outPct!=null?' · <b>'+outPct+' 백분위</b>':'')+'</div>'
      +'<div style="height:8px;background:var(--bg1);border-radius:5px;overflow:hidden;margin-top:4px"><div style="height:100%;background:linear-gradient(90deg,#1b80c4,#5bd3ff);width:'+(outPct||0)+'%"></div></div>'
      +(GEN_S.length?'<div style="margin-top:8px;font-size:11.5px"><b style="color:#5bd3ff">생성 약한 곳</b><div style="margin-top:3px"><b>'+GEN_S[0].nm+'</b> '+GEN_S[0].sc+'점</div></div>':'')
      +'<div style="margin-top:6px;font-size:11px;color:#5bd3ff">경로: 생성 메카닉 드릴(스트라이드·블로킹·몸통 회전)</div>'
      +'</div>'
      // 효율 축
      +'<div style="padding:12px 14px">'
      +'<div style="font-size:13px;font-weight:800;color:#46c98c;margin-bottom:5px">메카닉 효율 (전달·시퀀싱)</div>'
      +'<div style="font-size:12px;color:var(--fg2)">효율 점수 <b style="color:var(--fg)">'+(e!=null?Math.round(e):'—')+'</b>'+(effPct!=null?' · <b>'+effPct+' 백분위</b>':'')+'</div>'
      +'<div style="height:8px;background:var(--bg1);border-radius:5px;overflow:hidden;margin-top:4px"><div style="height:100%;background:linear-gradient(90deg,#1f7a4d,#46c98c);width:'+(effPct||0)+'%"></div></div>'
      +(TR_S.length?'<div style="margin-top:8px;font-size:11.5px"><b style="color:#46c98c">전달 병목 3순위</b>'
        +TR_S.slice(0,3).map(function(w,i){return '<div style="margin-top:3px"><b>'+(i+1)+'. '+w.nm+'</b> '+w.sc+'점</div>';}).join('')
        +'</div>':'')
      +'<div style="margin-top:6px;font-size:11px;color:#46c98c">경로: 시퀀싱·전달 드릴(불펜)</div>'
      +'</div></div>'
      // 결과 + 팔 부하
      +'<div style="padding:9px 14px;border-top:1px solid var(--line);background:var(--bg2);font-size:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">'
      +'<div><b style="color:#e8954e">결과(2축 산출물):</b> 최고 구속 '+(measV!=null?measV.toFixed(1):'—')+' km/h'+(veloPct!=null?' · 코호트 '+veloPct+' 백분위':'')+'</div>'
      +(armLoad?'<div style="color:'+(armLoad.level==='high'?'#e24b4a':(armLoad.level==='moderate'?'#e8954e':'#46c98c'))+'"><b>팔 부하 플래그:</b> '+(armLoad.levelKo||armLoad.level||'')+(armASR!=null?' · ASR '+armASR:'')+'</div>':'')
      +'</div>'
      +'<div style="padding:7px 14px;font-size:11px;color:var(--fg2)">출력=생성노드(스트라이드·블로킹·몸통) 평균, 효율=전달노드(무릎·골반→몸통[gap 재보정]·X타이밍) 평균. 몸통→팔(ASR)은 효율 신호가 아니라 팔 부담 지표라 별도 플래그. 체력은 ① Ch1에서 별도. 구속 예보 아님 — 2축 개선 방향 지표.</div>'
      +'</div>';
    return h;
  })();
  html+=twoAxisH;
  // 에너지 전달 흐름 지도 카드 (가로 9단계) — 약한 변인은 병목(bottleneck) 단계에만 표시
  var flowH='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800;margin-bottom:10px">에너지 전달 흐름 지도</div>'
    +'<div style="display:grid;grid-template-columns:repeat(9,1fr);gap:8px">';
  S.forEach(function(s,i){
    var c=(s.status==='good'?'#46c98c':(s.status==='caution'?'#e8954e':(s.status==='bottleneck'?'#e24b4a':'#7d8898')));
    var catCol=CAT_COL[s.cat]||'#7d8898';
    var weak=(s.status==='bottleneck')?_weakestVar(s):null;  // [2026-05-28] 병목 단계에만 약한 변인 표시
    flowH+='<div onclick="setPage(\''+s.tab+'\')" title="'+s.cName+(s.score==null?'':' · '+s.score+'점')+'" style="cursor:pointer;background:var(--bg2);border-radius:8px;padding:9px 9px 9px 14px;position:relative">'
      +'<span style="position:absolute;left:0;top:0;bottom:0;width:5px;background:'+catCol+';border-radius:8px 0 0 8px"></span>'
      +'<div style="font-size:11px;color:var(--fg2)">'+(i+1)+'. '+s.pName+'</div>'
      +'<div style="font-size:12.5px;font-weight:800;color:'+c+';margin-top:3px">'+({good:'양호',caution:'주의',bottleneck:'병목',na:'—'})[s.status]+(s.score==null?'':' '+s.score)+'</div>'
      +(weak?'<div style="font-size:11px;color:#e24b4a;margin-top:5px;border-top:1px dashed var(--line);padding-top:4px"><b>'+String(weak.name||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</b>'+(weak.desc?'<div style="color:var(--fg2);font-weight:400;margin-top:2px">'+String(weak.desc).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</div>':'')+'</div>':'')
      +'</div>';
  });
  flowH+='</div></div>';
  html+=flowH;
  // 잘되는 부분 카드
  var strengths=avail.filter(function(s){return s.status==='good';}).sort(function(a,b){return b.score-a.score;}).slice(0,3);
  if(!strengths.length) strengths=avail.slice().sort(function(a,b){return b.score-a.score;}).slice(0,2);
  if(strengths.length){
    html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid #46c98c">'
      +'<div style="font-size:13px;font-weight:800;color:#46c98c">잘되는 부분</div>'
      +'<div style="margin-top:6px;font-size:12.5px">'
      +strengths.map(function(s){return '<b>'+s.pName+'</b>('+s.cName+', '+(s.score==null?'–':s.score+'점)');}).join(' · ')
      +' — 이 단계들은 코호트 상위 수준으로, 강점을 유지하면서 아래 병목을 개선하면 됩니다.</div></div>';
  }

  // Ch5 — 종합 우선과제
  html+='<div class="card" id="cv-ch5" style="grid-column:1 / -1;background:rgba(156,140,232,.08);border-left:4px solid #9c8cff">'
    +'<div style="font-size:11px;color:var(--fg2)">Ch 5 · 종합 우선과제</div>'
    +'<div style="font-size:15px;font-weight:800;margin-top:3px;color:#9c8cff">이번 주 가장 먼저 고칠 것</div>';
  if(bottlenecks.length){
    html+='<ol style="margin-top:8px;padding-left:18px;font-size:12.5px">'
      +bottlenecks.map(function(s,i){return '<li style="margin:4px 0"><b>'+s.pName+'</b> ('+s.cName+', '+s.score+'점) — '+(typeof _PS_PRIO!=='undefined'&&_PS_PRIO[s.key]?_PS_PRIO[s.key]:'개선 드릴 필요')+(s.tab?'  '+btn('자세히 →',s.tab,'#9c8cff'):'')+'</li>';}).join('')
      +'</ol>';
  } else { html+='<div class="note" style="margin-top:8px">뚜렷한 병목이 없습니다 — 현재 패턴 유지 + 미세 보완.</div>'; }
  html+='</div>';

  // 부록
  html+='<details class="cv-toggle" id="cv-app" style="margin-top:14px"><summary style="cursor:pointer;font-size:14px;font-weight:700;padding:10px 14px;background:var(--bg2);border-radius:8px">부록 · 연구원 디테일 (9단계 전체 + 변인 설명) ▼</summary>'
    +'<div style="margin-top:10px">'
    +'<div class="note">9단계 모든 카드와 변인 디테일은 각 진단 페이지(좌측 탭)에서 확인하세요. 이 부록은 빠른 점프용 인덱스입니다.</div>'
    +'<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-top:10px">'
    +S.map(function(s,i){var c=(s.status==='good'?'#46c98c':(s.status==='caution'?'#e8954e':(s.status==='bottleneck'?'#e24b4a':'#7d8898')));
      return '<div onclick="setPage(\''+s.tab+'\')" style="cursor:pointer;padding:9px 11px;background:var(--bg2);border-radius:8px;border-left:3px solid '+c+'"><div style="font-size:11px;color:var(--fg2)">'+(i+1)+'. '+s.pName+'</div><div style="font-size:13px;font-weight:700;color:'+c+';margin-top:2px">'+(s.score!=null?s.score+'점':'—')+'</div><div style="font-size:11px;color:var(--fg2);margin-top:2px">'+s.cName+'</div></div>';
    }).join('')+'</div></div></details>';

  root.innerHTML=html;
  // [V2] ed-* 콘텐츠 슬롯 입양 — 각 슬롯에 해당 ed-body 이동 + 렌더 호출
  try{
    root.querySelectorAll('.cv-ed-slot[data-cv-slot]').forEach(function(slot){
      var key=slot.dataset.cvSlot;
      _cvAdoptInto(key, slot);
    });
    // 스틱 동기 차트 즉시 redraw (페이지 활성화 직후 0×0 상태 회피)
    setTimeout(function(){
      try{ if(typeof _redrawWindupCharts==='function') _redrawWindupCharts(); }catch(e){}
      try{ if(typeof _redrawXfCharts==='function') _redrawXfCharts(); }catch(e){}
      try{ if(typeof _redrawStrideCharts==='function') _redrawStrideCharts(); }catch(e){}
      try{ if(typeof _redrawBlkCharts==='function') _redrawBlkCharts(); }catch(e){}
      try{ if(typeof _redrawKneeCharts==='function') _redrawKneeCharts(); }catch(e){}
      try{ if(typeof _redrawPtCharts==='function') _redrawPtCharts(); }catch(e){}
      try{ if(typeof _redrawTrCharts==='function') _redrawTrCharts(); }catch(e){}
      try{ if(typeof _redrawTaCharts==='function') _redrawTaCharts(); }catch(e){}
      try{ if(typeof _redrawAbCharts==='function') _redrawAbCharts(); }catch(e){}
    }, 50);
  }catch(e){console.warn('cv-slot adoption',e);}
}
// 분석/스토리 모드 토글: 스토리=ed-* 콘텐츠 접힘(요약만), 분석=모두 펼침(인라인 풀 디테일)
function _cvToggleMode(){
  var btn=document.getElementById('cv-mode-btn'); if(!btn)return;
  var isAnalysis=btn.dataset.mode==='analysis';
  var newMode=isAnalysis?'story':'analysis';
  btn.dataset.mode=newMode;
  btn.textContent=newMode==='analysis'?'스토리 모드':'분석 모드';
  document.querySelectorAll('details.cv-toggle').forEach(function(d){d.open=(newMode==='analysis');});
  // 분석 모드 펼침 직후 차트 redraw (캔버스가 hidden→visible 전환)
  if(newMode==='analysis'){
    setTimeout(function(){
      try{ if(typeof _redrawWindupCharts==='function') _redrawWindupCharts(); }catch(e){}
      try{ if(typeof _redrawXfCharts==='function') _redrawXfCharts(); }catch(e){}
      try{ if(typeof _redrawStrideCharts==='function') _redrawStrideCharts(); }catch(e){}
      try{ if(typeof _redrawBlkCharts==='function') _redrawBlkCharts(); }catch(e){}
      try{ if(typeof _redrawKneeCharts==='function') _redrawKneeCharts(); }catch(e){}
      try{ if(typeof _redrawPtCharts==='function') _redrawPtCharts(); }catch(e){}
      try{ if(typeof _redrawTrCharts==='function') _redrawTrCharts(); }catch(e){}
      try{ if(typeof _redrawTaCharts==='function') _redrawTaCharts(); }catch(e){}
      try{ if(typeof _redrawAbCharts==='function') _redrawAbCharts(); }catch(e){}
    }, 50);
  }
}

function renderEtDiag(){
  var root=document.getElementById('etdiag-body'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null;
  if(!X){ root.innerHTML='<div class="card"><div class="note">에너지 전달 진단 데이터가 없습니다 (지면반력+관절파워가 있는 Theia 분석 필요).</div></div>'; return; }
  var html='';
  // ── 핵심 진단 한 문장 ──
  html+='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)"><div class="sub2" style="font-size:11px">오늘의 핵심 진단</div>'
    +'<div style="font-size:16px;font-weight:800;line-height:1.6;margin-top:3px">'+X.headline+'</div>'
    +'<div class="note" style="margin-top:6px">측정 구속 '+(X.measured_kmh!=null?X.measured_kmh.toFixed(1):'—')+' km/h · '+X.consistency.nTrials+'구 · 신뢰도: GRF '+X.confidence.grf+' / 팔에너지 '+X.confidence.armEnergy+' / 반복성 '+X.confidence.consistency+'</div></div>';
  // ── 에너지 흐름 지도 (9노드) ──
  html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">에너지 흐름 지도 <span class="sub2">하체 → 몸통 → 팔 → 공 · 색=상태(녹 양호·주황 주의·빨강 누수)</span></h3>'
    +'<div style="display:flex;flex-wrap:wrap;align-items:stretch;gap:4px">';
  X.stages.forEach(function(s,i){
    var c=_edCol(s.status);
    html+='<div onclick="setPage(\'ed-'+s.key+'\')" title="자세히 보기: '+s.label+'" style="flex:1 1 96px;min-width:92px;background:var(--bg2);border-radius:8px;border-top:3px solid '+c+';padding:8px 7px;text-align:center;cursor:pointer">'
      +'<div style="font-size:11px;color:var(--fg2);min-height:24px">'+s.label.replace(/ \(.*\)/,'')+_edTagChip(s.tag)+'</div>'
      +'<div style="font-size:13px;font-weight:800;color:'+c+';margin-top:3px">'+_edKo(s.status)+'</div>'
      +'<div style="font-size:11px;color:var(--fg2)">'+(s.score==null?'—':s.score)+'</div></div>';
    if(i<X.stages.length-1) html+='<div style="align-self:center;color:var(--fg2);font-size:13px">›</div>';
  });
  html+='</div></div>';
  // ── Top3 병목 ──
  if(X.bottlenecks&&X.bottlenecks.length){
    html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">구속 향상을 막는 Top '+X.bottlenecks.length+' 병목 <span class="sub2">심각도 = 기준이탈 × 단계중요도 × 구속관련도</span></h3>';
    X.bottlenecks.forEach(function(b,i){
      var st=X.stages.filter(function(s){return s.key===b.key;})[0]||{}; var c=_edCol(b.status);
      html+='<div style="background:var(--bg2);border-radius:8px;border-left:4px solid '+c+';padding:11px 13px;margin-bottom:8px">'
        +'<div style="font-size:14px;font-weight:800">'+(i+1)+'순위 · '+b.label+' <span style="color:'+c+'">['+_edKo(b.status)+']</span></div>'
        +'<div class="note" style="margin-top:5px"><b>근거:</b> '+b.rep+'</div>'
        +(st.story?('<div class="note" style="margin-top:3px"><b>에너지 흐름상 의미:</b> '+st.story.meaning+'</div>'
        +'<div class="note" style="margin-top:3px"><b>개선 방향:</b> '+st.story.improve+'</div>'):'')
        +'<button class="bm-focus-btn" onclick="setPage(\'ed-'+b.key+'\')" style="margin-top:6px;font-size:11px;background:var(--bg1);border:1px solid var(--line);color:var(--cyan);border-radius:6px;padding:4px 10px;cursor:pointer">이 단계 진단 자세히 보기 ›</button></div>';
    });
    html+='</div>';
  }
  // (단계별 카드는 각 단계 탭 ed-* 으로 분리됨 — 흐름 지도/Top3 클릭으로 이동)
  html+='<div class="card" style="grid-column:1 / -1"><div class="note">위 <b>에너지 흐름 지도</b>의 각 노드 또는 <b>Top3 병목</b>을 클릭하면 해당 단계의 상세 진단 탭으로 이동합니다. 아래 두 차트는 전체 사슬을 한눈에 보는 종합 그래프입니다.</div></div>';
  // ── 키네틱 시퀀스 + 앞발 지면반력 ──
  html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">키네틱 시퀀스 + 앞발 지면반력 <span class="sub2">KH→BR · 골반→몸통→팔 각속도(좌축) + 앞발 수직 GRF(우축) · KH·FC·MER·BR 이벤트선 + 각 곡선 피크값 표시</span></h3>'
    +'<canvas id="ef-seq-grf" style="width:100%;height:250px;display:block"></canvas>'
    +'<div class="note" style="margin-top:6px">세로 점선 = KH(다리들기 정점)·FC(착지)·MER(최대 외회전)·BR(릴리스). 점=각 곡선의 피크(값 표기). 앞발 수직 GRF(초록)가 오른 뒤 <b>골반 → 몸통 → 팔(손)</b> 각속도가 차례로 정점에 도달해야 지면 에너지가 사슬을 타고 전달됩니다. 정점이 겹치거나 순서가 뒤집히면 전달 비효율 신호입니다.</div></div>';
  // ── Handoff Overlap (몸통→팔) ──
  html+='<div class="card" style="grid-column:1 / -1"><h3 style="margin-top:0">몸통→팔 Handoff Overlap <span class="sub2">몸통 역학에너지 방출과 상완 에너지 상승의 겹침 — 겹칠수록 잘 전달, 안 겹치면 팔 자체 부담↑</span></h3>'
    +'<canvas id="ef-handoff" style="width:100%;height:230px;display:block"></canvas>'
    +'<div class="note" style="margin-top:6px">보라=몸통 에너지, 주황=상완 에너지. 몸통 에너지 peak(보라 세로선) 직후 상완 에너지가 바로 상승하며 음영(겹침)이 크면 좋은 전달입니다. 힘 넘기기 겹침=<b>'+(X.rep.trunkArmOverlap==null?'–':X.rep.trunkArmOverlap)+'</b> · Arm Self-Reliance=<b>'+(X.rep.armSelfReliance==null?'–':X.rep.armSelfReliance)+'</b>(낮을수록 몸통 주도). 상완 기준(전완·손 분절에너지 없음).</div></div>';
  // ── 한계/신뢰도 ──
  html+='<div class="card" style="grid-column:1 / -1"><div class="note"><b>해석 주의(데이터 신뢰도):</b> 골반 분절 에너지가 없어 골반→몸통은 회전속도·가속 타이밍과 증폭비로 평가했습니다. 팔 에너지는 상완 기준(전완·손 분절에너지 없음), Arm Local Work는 어깨+팔꿈치 파워 기준입니다. 절대 J 값은 마커리스 역동역학 추정이라 선수 간 절대비교보다 한 선수 안의 균형·약한 고리·타이밍으로 보세요. 반복성 신뢰도: '+X.confidence.consistency+'.</div></div>';
  root.innerHTML=html;
  try{ _redrawEtCharts(); }catch(e){}   // 차트(시계열+커서) 렌더 — 좌측 스틱 재생과 동기화
}
// ── 단계별 진단 탭 (ed-<key>) — 흐름 노드 하나의 상세 진단 카드 ──
// [2026-05-28 C안] 변인 수준 색 라벨 — 변인명 패턴 → 분류(출력/효율/저장/부하)
var _VAR_CAT_STYLE = {
  out:   {c:'#3b82f6', l:'출력'},
  eff:   {c:'#46c98c', l:'효율'},
  store: {c:'#9c8cff', l:'저장'},
  load:  {c:'#e8954e', l:'부하'}
};
// 변인 표시명 부분문자열 → 분류 (페이지마다 다르게 적용 가능, 우선 매칭이라 구체적인 패턴을 앞에)
var _VAR_CAT_PATTERNS = [
  // ── 부하(load·injury) — 가장 구체적으로 먼저
  ['Arm Self-Reliance','load'],['ASR','load'],['armSelfReliance','load'],
  ['팔꿈치 토크','load'],['elbowTorque','load'],['어깨 토크','load'],['shoulderTorque','load'],
  ['팔 부담','load'],['팔 부하','load'],['관절 부하','load'],['상해 부하','load'],['부상 부하','load'],
  ['손속도→BR','load'],['손속도-BR','load'],['gapHandToBR','load'],['손속도 peak→BR','load'],
  // ── 저장(store)
  ['X-factor 형성','store'],['xfPeak','store'],['xfAtFC','store'],['저장 에너지','store'],['에너지 저장','store'],['로딩','store'],['scap_load','store'],['견갑 로딩','store'],
  // ── 효율(전달·ratio·timing·conversion)
  ['전달비','eff'],['전달율','eff'],['전달효율','eff'],['전달 효율','eff'],
  ['회전 증폭','eff'],['trunkOverPelvisGain','eff'],['증폭비','eff'],['gain','eff'],
  ['타이밍 gap','eff'],['gapPelvisToTrunk','eff'],['gapTrunk','eff'],['피크 타이밍','eff'],['peak gap','eff'],
  ['풀림 시점','eff'],['풀림 타이밍','eff'],['tXfRelease','eff'],['xfReleasedByFC','eff'],['풀림시점','eff'],
  ['blocking 유형','eff'],['무릎 유형','eff'],['kneeType','eff'],['blocking type','eff'],['블로킹 유형','eff'],['스트라이드 유형','eff'],['몸통 유형','eff'],
  ['Handoff overlap','eff'],['trunkArmOverlap','eff'],['handoff','eff'],['핸드오프','eff'],
  ['흡수일','eff'],['kneeNegWork','eff'],['absorption','eff'],['흡수 비율','eff'],
  ['브레이크 임펄스','eff'],['brakeImpulse','eff'],['제동 임펄스','eff'],
  ['방향 품질','eff'],['dirQ','eff'],['방향 오차','eff'],['lateral_leak','eff'],
  ['시퀀스','eff'],['시퀀싱','eff'],['seqOrder','eff'],['키네틱 시퀀스','eff'],['키네마틱 시퀀스','eff'],['키네틱 체인','eff'],
  ['comDecel','eff'],['COM 감속','eff'],['감속력','eff'],['감속 효과','eff'],
  ['전환','eff'],['선형→회전','eff'],['선형-회전','eff'],['conversion','eff'],
  ['풀림 정도','eff'],['xfReleasedPct','eff'],
  // ── 출력(생성·magnitude·force·velocity)
  ['AP 제동','out'],['AP제동','out'],['수평 제동','out'],['앞발 AP','out'],['앞발 제동','out'],
  ['수직 GRF','out'],['vGRF','out'],['vgrf','out'],['VGRF','out'],['수직 지면반력','out'],['지면반력','out'],
  ['전진 속도','out'],['전진속도','out'],['전진 KE','out'],['comVel','out'],['comKE','out'],['전진 운동량','out'],['전진 에너지','out'],['COM 전진','out'],
  ['몸통 ME','out'],['trunkEpeak','out'],['몸통 에너지','out'],['몸통E','out'],
  ['신전 속도','out'],['신전속도','out'],['kneeExtVel','out'],['신전량','out'],['순신전','out'],['kneeNetExt','out'],
  ['양의일','out'],['kneePosWork','out'],['생성일','out'],['posWork','out'],
  ['풀림 속도','out'],['xfReleasePeakVel','out'],
  ['하체 생성','out'],['rhPos','out'],['뒷다리 푸시','out'],['rear_hip','out'],['rear_knee','out'],['lead_knee_extension','out'],
  ['골반 회전속도','out'],['몸통 회전속도','out'],['어깨 IR속도','out'],['어깨 내회전속도','out'],['어깨 내회전 속도','out'],
  ['shoulderIRvelPeak','out'],['pelvisVelPeak','out'],['trunkVelPeak','out'],['kneeExtVelPeak','out'],['elbowExtVelPeak','out'],
  ['shoulderIR','out'],['pelvisV','out'],['trunkV','out'],['손속도 peak','out'],['handSpeed','out']
];
function _injectVarLabels(key){
  var root=document.getElementById('ed-body-'+key);
  if(!root) return;
  // 변인명 검사 대상: 섹션 헤더(h2·h3·h4·strong) + 표 헤드(th) + 라벨(b, .ev-table td.evl)
  try{ var _SC={windup:'#e8954e',stride:'#3b82f6',blocking:'#3b82f6'}, _scol=_SC[key];
    root.querySelectorAll('.card').forEach(function(card){
      var ttl=card.firstElementChild;
      if(ttl && /font-weight:\s*800/.test(ttl.getAttribute('style')||'')){
        if(ttl.childElementCount===0){ ttl.textContent=(ttl.textContent||'').replace(/^\s*\d+\.\s*/,''); if(_scol) ttl.style.color=_scol; }
      }
    });
  }catch(e){}
  try{ root.querySelectorAll('.card').forEach(function(card){
    if(card.querySelector('.cv-desc-fold')) return;
    var notes=[],kids=card.children;
    for(var _k=0;_k<kids.length;_k++){ var n=kids[_k]; if(n.classList&&n.classList.contains('note')){ var t=n.textContent||''; if(/역할:|측정:|에너지 흐름 해석:|코칭:/.test(t)) notes.push(n); } }
    if(notes.length<2) return;
    var det=document.createElement('details'); det.className='cv-desc-fold'; det.style.cssText='margin-top:8px;border:1px solid var(--line);border-radius:8px;background:var(--bg2)';
    var sm=document.createElement('summary'); sm.style.cssText='cursor:pointer;padding:8px 11px;font-size:12px;font-weight:700;color:var(--cyan)'; sm.textContent='설명 (역할·측정·해석·코칭)'; det.appendChild(sm);
    var box=document.createElement('div'); box.style.cssText='padding:2px 11px 11px'; notes.forEach(function(n){ box.appendChild(n); }); det.appendChild(box); card.appendChild(det);
  }); }catch(e){}
  var nodes=root.querySelectorAll('h2, h3, h4, b, th, strong, .ev-table td.evl');
  nodes.forEach(function(el){
    if(el.dataset.cvCat) return; // 이미 라벨 달림
    if(el.querySelector('.cv-var-badge')) return;
    var txt=(el.textContent||'').trim();
    if(!txt||txt.length>120) return;
    for(var i=0;i<_VAR_CAT_PATTERNS.length;i++){
      var pat=_VAR_CAT_PATTERNS[i][0], cat=_VAR_CAT_PATTERNS[i][1];
      if(txt.indexOf(pat)>=0){
        var s=_VAR_CAT_STYLE[cat];
        var badge=document.createElement('span');
        badge.className='cv-var-badge';
        badge.title=s.l+' 변인';
        // 굵은 세로 막대 + 라벨 텍스트
        badge.innerHTML='<span style="display:inline-block;width:5px;height:15px;background:'+s.c+';margin-right:5px;vertical-align:middle;border-radius:2px"></span><span style="font-size:11px;font-weight:800;color:'+s.c+';vertical-align:middle;margin-right:6px">'+s.l+'</span>';
        badge.style.cssText='display:inline-block;vertical-align:middle';
        el.insertBefore(badge,el.firstChild);
        el.dataset.cvCat=cat;
        try{ el.style.color=s.c; }catch(_){}   /* [2026-05-29] 변인 이름 텍스트도 역할 색(생성/전달/저장/부하) */
        break;
      }
    }
  });
}
function renderEdNode(key){
  if(key==='windup'){ try{ renderEdWindup(); _injectVarLabels(key); }catch(e){} return; }   // 와인드업 = 로딩 평가 전용 화면
  if(key==='xftiming'){ try{ renderEdXFactorTiming(); _injectVarLabels(key); }catch(e){} return; }  // X-factor = 진단 전용 화면
  if(key==='stride'){ try{ renderEdStride(); _injectVarLabels(key); }catch(e){} return; }   // 스트라이드 = 단계평가 전용 화면
  if(key==='blocking'){ try{ renderEdBlocking(); _injectVarLabels(key); }catch(e){} return; }  // 블로킹 = 단계평가 전용 화면
  if(key==='knee'){ try{ renderEdKnee(); _injectVarLabels(key); }catch(e){} return; }  // 무릎전달 = 단계평가 전용 화면
  if(key==='pelvistrunk'){ try{ renderEdPelvisTrunk(); _injectVarLabels(key); }catch(e){} return; }  // 골반→몸통 = 단계평가 전용 화면
  if(key==='trunk'){ try{ renderEdTrunk(); _injectVarLabels(key); }catch(e){} return; }  // 몸통 에너지 = 단계평가 전용 화면
  if(key==='trunkarm'){ try{ renderEdTrunkArm(); _injectVarLabels(key); }catch(e){} return; }  // 몸통→팔 = 단계평가 전용 화면
  if(key==='armball'){ try{ renderEdArmBall(); _injectVarLabels(key); }catch(e){} return; }  // 팔→공 = 단계평가 전용 화면
  var root=document.getElementById('ed-body-'+key); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null;
  if(!X){ root.innerHTML='<div class="card"><div class="note">에너지 전달 진단 데이터가 없습니다 (지면반력+관절파워가 있는 Theia 분석 필요).</div></div>'; return; }
  var s=null; (X.stages||[]).forEach(function(x){ if(x.key===key) s=x; });
  if(!s){ root.innerHTML='<div class="card"><div class="note">단계 데이터가 없습니다.</div></div>'; return; }
  var c=_edCol(s.status), idx=0, prev=null, next=null;
  for(var i=0;i<_ED_NODES.length;i++){ if(_ED_NODES[i][0]===key){ idx=i; prev=_ED_NODES[i-1]; next=_ED_NODES[i+1]; } }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer">'+lbl+'</button>'; }
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid '+c+'">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px">'
    +'<div style="font-size:17px;font-weight:800">'+(idx+1)+'. '+s.label+_edTagChip(s.tag)+'</div>'
    +'<div style="font-size:13px;font-weight:800;color:'+c+'">'+_edKo(s.status)+(s.score==null?'':' · '+s.score+'점')+'</div></div>'
    +'<div class="note" style="margin-top:8px;font-size:13px">'+s.rep+'</div>';
  if(s.story){
    html+='<div style="margin-top:10px;background:var(--bg2);border-radius:8px;padding:10px 13px;line-height:1.7;font-size:13px">'
      +'<div><b style="color:var(--cyan)">측정</b> — '+s.story.measure+'</div>'
      +'<div style="margin-top:5px"><b style="color:var(--cyan)">에너지 흐름상 의미</b> — '+s.story.meaning+'</div>'
      +'<div style="margin-top:5px"><b style="color:var(--cyan)">개선 방향</b> — '+s.story.improve+'</div></div>';
  }
  html+='<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">'
    + btn('이 단계 스틱·스틱게이지·시계열 자세히 보기 →',(_ED_DETAIL[key]||'biomotion'),'var(--cyan)')
    + btn('← 요약','psummary')
    + (prev?btn('‹ '+prev[1],'ed-'+prev[0]):'')
    + (next?btn(next[1]+' ›','ed-'+next[0]):'')
    + '</div></div>';
  // ── 진단3 스트라이드: Hip Hinge 로딩 보존 브리지 (와인드업 로딩이 FC까지 유지됐나) ──
  if(key==='stride' && X.windup){ var Wp=X.windup, hh=Wp.hipHinge, pc=Wp.pelvicClosure;
    var rp=(hh.trunkPelvisRetainedPct);
    html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">로딩 보존 브리지 — Hip Hinge (와인드업→스트라이드)</div>'
      +'<div class="note" style="margin-top:4px">와인드업에서 만든 힙힌지(몸통-골반 굽힘) 로딩이 FC까지 보존됐는지 봅니다. 힙힌지 peak '+(hh.trunkPelvisPeak==null?'–':hh.trunkPelvisPeak+'°')+' → <b>FC '+(hh.trunkPelvisAtFC==null?'–':hh.trunkPelvisAtFC+'°')+' · 보존율 '+(rp==null?'–':rp+'%')+'</b> · (참고) 골반 닫힘 유지 '+(pc.retainedPct==null?'–':pc.retainedPct+'%')+'</div>'
      +'<div class="note" style="margin-top:4px">'+((rp!=null&&rp<50)?'와인드업 로딩이 스트라이드 중 풀려 FC까지 잘 보존되지 못했습니다 — 착지 후 회전에 쓸 로딩이 줄어듭니다.':'로딩이 FC까지 비교적 보존되어 착지 후 전환 준비가 됩니다.')+' (FC 이후 몸통 전방 굴곡은 힙힌지가 아니라 몸통 굴곡 에너지로 진단7에서 평가)</div></div>';
  }
  // ── 진단7 몸통 에너지: FC 이후 몸통 굴곡 = trunk flexion energy 분리 안내 ──
  if(key==='trunk' && X.windup){
    html+='<div class="card" style="grid-column:1 / -1"><div class="note"><b>참고(힙힌지와 구분):</b> FC <b>이후</b> 몸통이 앞으로 굴곡하는 동작은 와인드업의 힙힌지(로딩)가 아니라 <b>몸통 굴곡 에너지(trunk flexion)</b>입니다. 즉 와인드업 힙힌지(진단1)는 로딩, 여기 진단7의 몸통 굴곡은 릴리스를 향한 에너지 생성으로 분리해 평가합니다.</div></div>';
  }
  root.innerHTML=html;
}
// ── 와인드업 로딩 진단 전용 화면 (개발문서 v1) ──
function renderEdWindup(){
  var root=document.getElementById('ed-body-windup'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, W=X&&X.windup;
  if(!W){ root.innerHTML='<div class="card"><div class="note">와인드업 로딩 데이터가 없습니다 (지면반력 있는 Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function r0(x){return (x==null||!isFinite(x))?null:Math.round(x);} function r1(x){return (x==null||!isFinite(x))?null:Math.round(x*10)/10;} function r2(x){return (x==null||!isFinite(x))?null:Math.round(x*100)/100;}
  var fastT=(typeof _fastTrial==='function')?_fastTrial():null; try{ if(!_WG.data)_WG.data=_WG.build(); }catch(e){}
  function S_(n){ return (fastT&&fastT.series&&fastT.series[n])?fastT.series[n]:null; }
  function W_(n){ return (_WG.data&&_WG.data.fast&&_WG.data.fast.series&&_WG.data.fast.series[n])?_WG.data.fast.series[n]:null; }
  var _ix=(W.events&&W.events.idx)||{};
  var EVT=[['KH',_ix.KH],['SO',_ix.SO],['MHH',_ix.MHH],['MPC',_ix.MPC],['MzDC',_ix.MzDC],['FC',_ix.FC],['MER',fastT&&fastT.events?fastT.events.i_mer:null],['BR',_ix.BR]].filter(function(e){return e[1]!=null&&isFinite(e[1]);});
  function evtTable(rows){
    var th='<tr><th style="text-align:left;padding:4px 6px">변인</th>'+EVT.map(function(e){return '<th style="padding:4px 6px;text-align:right">'+e[0]+'</th>';}).join('')+'</tr>';
    var tr=rows.map(function(rw){ return '<tr><td style="text-align:left;padding:4px 6px">'+rw.label+(rw.unit?' <span style="color:var(--fg2)">('+rw.unit+')</span>':'')+'</td>'+EVT.map(function(e){var val=rw.get(e[1]);return '<td style="text-align:right;padding:4px 6px">'+(val==null?'–':val)+'</td>';}).join('')+'</tr>'; }).join('');
    return '<table class="ev-table" style="width:100%;border-collapse:collapse;font-size:11.5px;margin-top:2px">'+th+tr+'</table><div class="note" style="font-size:11px;margin-top:5px;color:var(--fg2)">값 = 각 이벤트 프레임에서의 변인 값 (폴더·기록용). 이벤트 약어는 상단 설명 참고.</div>';
  }
  function fold(label,inner){ return '<details style="margin-top:8px;border:1px solid var(--line);border-radius:8px;background:var(--bg2)"><summary style="cursor:pointer;padding:8px 11px;font-size:12px;font-weight:700;color:var(--cyan)">'+label+'</summary><div style="padding:2px 11px 11px">'+inner+'</div></details>'; }
  function defCard(d){ return '<div class="note" style="line-height:1.85"><b>정의</b> '+d.def+'<br><b>산출 방법</b> '+d.calc+'<br><b>결과 해석</b> '+d.interp+'<br><b>평가 방법</b> '+d.evalm+'</div>'; }
  function card(title,role,vals,meaning,coach,chartId,evtRows,defObj){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div>'
    +'<div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div>'
    +'<div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'
    +(chartId?'<div style="display:flex;gap:12px;align-items:stretch;margin-top:8px"><canvas id="'+chartId+'" style="flex:1;min-width:0;height:208px;display:block"></canvas><canvas id="'+chartId+'-stk" style="flex:0 0 220px;width:220px;height:270px;display:block"></canvas></div>':'')
    +(evtRows?fold('이벤트별 데이터 표 (폴더용)',evtTable(evtRows)):'')
    +(defObj?fold('변인 정의·산출·해석·평가 (폴더용)',defCard(defObj)):'')
    +'</div>'; }
  var hh=W.hipHinge, pc=W.pelvicClosure, xf=W.xfactor, rh=W.rearHipER, mz=W.rearFootMz, cv=W.conversion, pl=W.preload, ev=W.events;
  // 개조식 요약 — 형성/병목을 짧은 구로
  var _wIssue=(function(){ var pc2=W.pelvicClosure||{}, xf2=W.xfactor||{}, cv2=W.conversion||{}, pl2=W.preload||{};
    switch(W.type){
      case 'early_open': return 'FC 전 골반 닫힘('+v(pc2.retainedPct,'%')+')·X-factor('+v(xf2.releasedByFC,'% 풀림')+') 조기 해제 → 착지 후 회전 로딩 부족';
      case 'forward_only': return '전진 운동량 충분(FC '+v(cv2.comVelAtFC,'m/s')+') · 골반 닫힘 유지 낮음('+v(pc2.retainedPct,'%')+') → 회전 준비힘 부족';
      case 'loaded_not_converted': return '로딩 형성됨 · 전진속도(FC '+v(cv2.comVelAtFC,'m/s')+') 전환 부족';
      case 'under_loaded': return '와인드업 로딩 부족';
      case 'preserved_delayed': return '로딩 FC까지 보존 · 착지 후 골반 회전 가속 타이밍 늦음('+v(pl2.dtPBGtoPPA,'ms')+')';
      default: return '로딩 형성·보존 → 스트라이드·착지 후 회전으로 잘 연결';
    } })();
  var _wMade=(W.type==='under_loaded')?'로딩 부족':'로딩 형성';
  var _flowBand=_edFlowBand([{label:'① 힙힌지 로딩',val:(W.hipHinge&&W.hipHinge.atFC!=null)?W.hipHinge.atFC+'°':null,state:_scoreState(W.sub&&W.sub.hipHinge)},{label:'② 골반 닫힘 유지',val:(W.pelvicClosure&&W.pelvicClosure.retainedPct!=null)?W.pelvicClosure.retainedPct+'%':null,state:_scoreState(W.sub&&W.sub.pelvicClosure)},{label:'③ 탄성 저장(X-factor)',val:(W.xfactor&&W.xfactor.peak!=null)?W.xfactor.peak+'°':null,state:_scoreState(W.sub&&W.sub.xftiming)},{label:'④ 회전 준비',val:(W.composite!=null)?W.composite+'점':null,state:_scoreState(W.composite)}],'로딩 자세에서 골반을 닫아 X-factor 탄성을 저장하면 착지 후 그 에너지를 회전으로 풀어 씁니다. 빨간 칸은 그 지점에서 저장이 새고 있다는 뜻입니다.');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">와인드업 로딩 · <span style="color:var(--cyan)">'+W.typeKo+'</span></div><div style="font-size:13px;font-weight:800">로딩 효율 '+v(W.composite)+'점</div></div>'
    +'<div style="font-size:13.5px;font-weight:700;line-height:1.7;margin-top:6px"><b>형성</b> '+_wMade+' · <b>병목</b> '+_wIssue+'</div>'
    
    ;
  var _mhhT=(ev.MHH!=null)?((ev.MHH>=0?'+':'')+ev.MHH+'ms'):'–';
  html+=card('<span style="color:#e8954e">힙힌지</span>','고관절에서의 굴곡(뒷고관절에 앉기) → 회전 에너지 로딩 · 요추 중립 유지가 핵심(몸통 굽힘 아님)',
    '<b>힙힌지(고관절 굴곡) peak '+v(hh.rearHipSitPeak,'°')+'</b> · 최대 시점 FC'+_mhhT+' (setup~KH 로딩)',
    '뒷고관절 굴곡 '+v(hh.rearHipSitPeak,'°')+((hh.rearHipSitPeak!=null&&hh.rearHipSitPeak>=27)?' → 충분한 하체 로딩':' → 로딩 보강 여지')+' · 최대 시점 FC'+_mhhT+' · FC 보존은 진단3',
    '뒷고관절에 앉아 고관절에서 접어 로딩(허리 굽힘 대신) · 만든 로딩 FC까지 보존(진단3)','edc-wind-hinge',
    [{label:'고관절 굴곡(힙힌지)',unit:'°',get:function(f){var a=S_('Back_Hip_Angle_X');return (a&&isFinite(a[f]))?r1(a[f]):null;}}],
    {def:'뒷고관절(대퇴-골반)의 굴곡각 = 고관절에서의 hinge. 하체-골반에 앉아 회전 에너지를 로딩하는 동작.',calc:'setup~KH 구간 뒷고관절 시상면 굴곡(Back_Hip_Angle_X) peak. 최대 시점은 FC 기준 ms.',interp:'클수록 고관절에 깊이 앉은 로딩. 요추 굽힘(몸통-골반 상대굴곡)이 아니라 고관절에서 접는 것이 핵심.',evalm:'코호트 20명 분포 대비. FC까지 보존은 진단3에서 평가.'});
  html+=card('2. 골반 닫힘 유지','골반 조기 열림 방지 · 회전 준비힘 형성',
    '최대 닫힘 '+v(pc.peak,'°')+' (MPC '+v(ev.MPC,'ms')+') · FC까지 열림 '+v(pc.openedByFCpct,'%')+' · <b>보존 '+v(pc.retainedPct,'%')+'</b> · 열림 시작 '+v(pc.openingOnsetMs,'ms'),
    (pc.retainedPct!=null&&pc.retainedPct<50)?'FC 전 닫힘 많이 풀림 → 회전 준비힘 부족 (조기 열림)':'FC까지 닫힘 보존 → 회전 전환 preload 준비됨',
    (pc.retainedPct!=null&&pc.retainedPct<50)?'더 닫기보다 현재 닫힘 FC까지 유지 (스트라이드 중 조기 열림 억제)':'현재 닫힘 보존 패턴 유지','edc-wind-closure',
    [{label:'골반 닫힘',unit:'°',get:function(f){var a=W_('pelClose');return (a&&isFinite(a[f]))?r1(a[f]):null;}}],
    {def:'셋업 대비 골반선이 닫힌(회전한) 각.',calc:'골반 수평면각의 셋업 기준 변화량. 보존율 = FC 닫힘 / 최대 닫힘 × 100.',interp:'FC까지 닫힘이 유지되면 착지 후 회전에 쓸 회전 preload가 준비됨(낮으면 조기 열림).',evalm:'보존율을 코호트 IQR 대비 평가.'});
  html+=card('고관절 외회전 / 비틀림 토크','뒷다리 코일(고관절 외회전·지면 비틀림) → 추진·골반 닫힘 기반',
    '회전 로딩 '+v(rh.peak,'°')+' (MRHER '+v(ev.MRHER,'ms')+') · 양의 일 '+v(rh.posWork,'J'),
    (rh.posWork!=null&&rh.posWork>=10)?'뒷고관절 로딩됨 → 추진·골반 유지 기여':'뒷고관절 로딩 약함 → 추진 생성 제한 가능',
    '뒷고관절 외회전 로딩 → 추진(전진속도)으로 연결','edc-wind-rh',
    [{label:'뒷고관절 외회전',unit:'°',get:function(f){var a=S_('Back_Hip_Angle_Z');return (a&&isFinite(a[f]))?r1(a[f]):null;}},{label:'뒷고관절 파워',unit:'W',get:function(f){var a=S_('Back_Hip_Power_X');return (a&&isFinite(a[f]))?r0(a[f]):null;}}],
    {def:'뒷고관절 외회전 로딩(회전 추진의 기반).',calc:'뒷고관절 회전 각. 양의 일 = KH~FC 구간 양의 파워 적분(J).',interp:'로딩되면 뒷다리 추진·골반 닫힘 유지에 기여.',evalm:'회전 로딩·양의 일을 코호트 대비.'});
  // 네비
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('X-factor ›','ed-xftiming')+'</div>';
  root.innerHTML=_flowBand+html;
  try{ _redrawWindupCharts(); }catch(e){}
}
function _redrawWindupCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, W=X&&X.windup; if(!W) return;
  if(!document.getElementById('edc-wind-hinge')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null;
  var RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L'), idx=(W.events&&W.events.idx)||{};
  var EV=[{label:'KH',frame:idx.KH,color:'#9aa5b3'}];
  // 와인드업 윈도우 = KH~FC+0.15s (단계 구간). 게이지 대신 스틱 게이지(우측) 사용 — 메인 3D 스틱 프레임 연동.
  var W0={fast:fast,slow:slow,startEv:'i_fc',startOff:-1.5,endEv:'i_fc',endOff:0.15,extraEvents:EV,noGauge:true};
  // 1 힙힌지: 몸통-골반 전굴(def A)·뒷고관절 sit(def B)
  try{ var _ft=(typeof _fastTrial==='function')?_fastTrial():null, _hhE=[{label:'MER'},{label:'BR'}];
    if(_ft&&_ft.series&&_ft.series.Back_Hip_Angle_X){ var _bh=_ft.series.Back_Hip_Angle_X,_fc=(_ft.events&&_ft.events.i_fc)||_bh.length,_bi=null,_bv=-1e9; for(var _i=0;_i<_fc&&_i<_bh.length;_i++){ if(isFinite(_bh[_i])&&_bh[_i]>_bv){_bv=_bh[_i];_bi=_i;} } if(_bi!=null)var _ts=((_ft.meta&&_ft.meta.dt)||0.004)*(_bi-_fc); _hhE.push({label:'FC'+(_ts>=0?'+':'')+_ts.toFixed(2)+'s',frame:_bi,color:'#46c98c'}); }
    plotWin('edc-wind-hinge',Object.assign({left:{label:'각도 (°)',lines:[
    {compute:function(t){return t.series.Back_Hip_Angle_X;},color:'#46c98c',label:'고관절 굴곡(힙힌지)',width:2.6}]}},W0,{extraEvents:_hhE})); }catch(e){}
  // 2 골반 닫힘 유지 + 열림 속도
  try{ var _cft=(typeof _fastTrial==='function')?_fastTrial():null, _clE=[{label:'MER'},{label:'BR'}];
    if(_cft&&_cft.series&&_cft.series.Pelvis_Angle_Z){ var _pz=_cft.series.Pelvis_Angle_Z,_cfc=(_cft.events&&_cft.events.i_fc)||_pz.length,_ci=null,_cv=-1e9; for(var _j=0;_j<_cfc&&_j<_pz.length;_j++){ var _val=RHP?_pz[_j]:-_pz[_j]; if(isFinite(_val)&&_val>_cv){_cv=_val;_ci=_j;} } if(_ci!=null){ var _cts=((_cft.meta&&_cft.meta.dt)||0.004)*(_ci-_cfc); _clE.push({label:'FC'+(_cts>=0?'+':'')+_cts.toFixed(2)+'s',frame:_ci,color:'#9c8cff'}); } }
    plotWin('edc-wind-closure',Object.assign({left:{label:'골반 닫힘 (°)',lines:[
    {compute:function(t){var pz=t.series.Pelvis_Angle_Z;if(!pz)return null;var n=Math.min(15,(t.events.i_kl_peak||15)),s=0,c=0;for(var i=0;i<=n&&i<pz.length;i++){if(isFinite(pz[i])){s+=(RHP?pz[i]:-pz[i]);c++;}}var b=c?s/c:0;return pz.map(function(x){return isFinite(x)?((RHP?x:-x)-b):NaN;});},color:'#5bb6e6',label:'골반 닫힘(셋업 대비)',width:2.6}]}},W0,{extraEvents:_clE})); }catch(e){}
  // 3 X-factor 형성(분리각)
  // 4 뒷고관절 외회전 로딩 + 파워
  try{ plotWin('edc-wind-rh',Object.assign({left:{label:'고관절 외회전 (°)',lines:[
    {compute:function(t){return t.series.Back_Hip_Angle_Z;},color:'#46c98c',label:'고관절 외회전',width:2.6}]},
    right:{label:'비틀림 토크 Mz (N·m)',lines:[{compute:function(t){var a=t.series.FP1_Z_3;return a?a.map(function(x){return (RHP?-x:x);}):null;},color:'#6db4e6',label:'비틀림 토크(꼬임+)',width:2.0}]}},W0)); }catch(e){}
  // 스틱 게이지(우측) — 메인 3D 스틱 프레임 연동 · 고정 윈도우[w0,w1] 스케일 + 현재 프레임 수치 오버레이
  // 1·4·6: 측면 스틱(관련 분절 녹색 강조) / 2·3: 증거 탑뷰 골반·어깨 스틱 / 5: 증거 뒷발 비틀림 게이지
  var dt=(fast&&fast.meta&&fast.meta.dt)||0.00333, nF=(fast&&fast.frames)?fast.frames.length-1:0;
  var ifc=(fast&&fast.events&&fast.events.i_fc!=null)?fast.events.i_fc:(idx&&idx.FC);
  var w0=(ifc!=null)?Math.max(0,Math.round(ifc-1.5/dt)):0, w1=(ifc!=null)?Math.min(nF,Math.round(ifc+0.15/dt)):nF, WIN=[w0,w1];
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.max(0,Math.min(nF,Math.round(_currentFrame))):(ifc!=null?ifc:nF);
  function r0(x){return (x==null||!isFinite(x))?null:Math.round(x);} function r1(x){return (x==null||!isFinite(x))?null:Math.round(x*10)/10;} function r2(x){return (x==null||!isFinite(x))?null:Math.round(x*100)/100;}
  function sv(name){ var a=fast&&fast.series&&fast.series[name]; return (a&&isFinite(a[cf]))?a[cf]:null; }
  function u(x,uu){ return (x==null)?'–':(x+uu); }
  // 1 힙힌지: 몸통-골반 굽힘 + 뒷고관절 앉기
  var tax=sv('Trunk_Angle_X'), pax=sv('Pelvis_Angle_X'), hingeV=(tax!=null&&pax!=null)?r1(tax-pax):null, bhx=r1(sv('Back_Hip_Angle_X'));
  try{ _edCardStick('edc-wind-hinge-stk',['trunk','pelvis','rearleg'],{win:WIN,view:'rear',readout:[{txt:'뒷고관절(힙힌지) '+u(bhx,'°'),color:'#46c98c',big:true}]}); }catch(e){}
  // 2 골반 닫힘(증거 탑뷰)
  try{ _edWGStick('pelClose','edc-wind-closure-stk'); var cl=(_WG.data&&_WG.data.fast.series.pelClose)?_WG.data.fast.series.pelClose[_WG.idx]:null; _edStickReadout('edc-wind-closure-stk',[{txt:'골반 닫힘 '+u(r1(cl),'°'),color:'#6db4e6',big:true}]); }catch(e){}
  // 3 X-factor(증거 탑뷰 — 골반·어깨 분리)
  // 4+5 병합: 비틀림 게이지(꼬임 주황 / 풀림 파랑)
  try{ _edWGStick('freeMo','edc-wind-rh-stk'); var _mzv=(_WG.data&&_WG.data.fast.series.freeMo)?_WG.data.fast.series.freeMo[_WG.idx]:null; var _coil=(_mzv!=null&&isFinite(_mzv)&&(RHP?-_mzv:_mzv)>=0); _edStickReadout('edc-wind-rh-stk',[{txt:(_coil?'꼬임 ':'풀림 ')+u((_mzv==null||!isFinite(_mzv))?null:r1(Math.abs(_mzv)),' N·m'),color:(_coil?'#e8954e':'#5bd3ff'),big:true}]); }catch(e){}
}
// ── 스트라이드 단계평가 전용 화면 (개발문서 v1) ──
function renderEdStride(){
  var root=document.getElementById('ed-body-stride'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, S=X&&X.stride;
  if(!S){ root.innerHTML='<div class="card"><div class="note">스트라이드 데이터가 없습니다 (지면반력 있는 Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  var rp=S.rearProp,cm=S.comMom,ke=S.comKE,gm=S.geometry,bl=S.balance,ld=S.landing,br=S.bridge,ev=S.events;
  // 각 변인 카드 아래 인라인 그래프+폴더(이벤트표·정의) — 진단2 패턴
  var _fsT=(typeof _fastTrial==='function')?_fastTrial():null, _isx=(S.events&&S.events.idx)||{}, _mS=(DATA.player&&DATA.player.weight_kg)||86, _EVTs=_edEvtListG(_isx,_fsT);
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:190px;display:block;margin-top:8px"></canvas>'
    +''
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTs, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function pathB(cid,cap,def){ return '<canvas id="'+cid+'" style="width:100%;height:240px;display:block;margin-top:8px"></canvas>'
    +'<div class="note" style="font-size:11px;margin-top:2px;color:var(--fg2)">'+cap+'</div>'
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _gVel(f){ return _edSV(_fsT,'COM_Velocity_Y',f,100,true); }
  function _gProp(f){ var a=_fsT&&_fsT.series&&_fsT.series.FP1_Y; return (a&&isFinite(a[f]))?Math.round(Math.abs(a[f])/(_mS*9.81)*100*10)/10:null; }
  function _gHipP(f){ return _edSV(_fsT,'Back_Hip_Power_X',f,1); }
  function _gKE(f){ var a=_fsT&&_fsT.series&&_fsT.series.COM_Velocity_Y; return (a&&isFinite(a[f]))?Math.round(0.5*_mS*a[f]*a[f]):null; }
  function _gDisp(f){ return _edSV(_fsT,'COM_displacement_Y',f,100,true); }
  function _gBrake(f){ var a=_fsT&&_fsT.series&&_fsT.series.FP2_Y; return (a&&isFinite(a[f]))?Math.round(Math.abs(a[f])/(_mS*9.81)*100*10)/10:null; }
  function _gKnee(f){ return _edSV(_fsT,'Lead_Knee_Angle_X',f,1,true); }
  var _flowBand=_edFlowBand([{label:'① 뒷다리 추진',val:(S.rearProp&&S.rearProp.propImpulsePct!=null)?S.rearProp.propImpulsePct+'%':null,state:_flowState(S.rearProp&&S.rearProp.propImpulsePct,'propImpPct',true)},{label:'② COM 전진속도',val:(S.comMom&&S.comMom.velFC!=null)?S.comMom.velFC+'m/s':null,state:_flowState(S.comMom&&S.comMom.velFC,'comVel',true)},{label:'③ 스트라이드 길이',val:(S.geometry&&S.geometry.strideLenPct!=null)?S.geometry.strideLenPct+'%':null,state:_flowState(S.geometry&&S.geometry.strideLenPct,'strideLen',true)},{label:'④ 전진 운동량',val:(S.momentumScore!=null)?S.momentumScore+'점':null,state:_scoreState(S.momentumScore)}],'뒷다리 추진으로 전진속도를 만들고 스트라이드로 전진 운동량을 형성합니다 — 이 운동량이 다음 블로킹에서 회전 에너지로 전환됩니다.');
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">스트라이드 · <span style="color:var(--cyan)">'+S.typeKo+'</span></div><div style="font-size:13px;font-weight:800">전진 운동량 점수 '+v(S.momentumScore)+'</div></div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+S.summary+'</div>'
    +'<div class="note" style="margin-top:5px">스트라이드는 전달이 아니라 <b>전진 운동량 형성 + 블로킹 준비</b> 단계입니다 — 와인드업 로딩을 전진속도로 전환하고, 홈 방향으로 안정적으로 이동하며, FC에서 블로킹 가능한 착지·회전 preload를 만드는지를 봅니다. (X-factor는 점수 제외, 아래 「로딩 보존 브리지」로 표시)</div></div>';
  html+=card('추진 지면반력 · 임펄스','뒷다리가 지면을 밀어 COM을 홈 방향으로',
    'AP 추진 임펄스 '+v(rp.propImpulsePct,'%BW·s')+' (peak '+v(rp.peakMs,'ms')+') · 뒷다리 양의 일 '+v(rp.positiveWork,'J'),
    (rp.propImpulsePct!=null&&rp.propImpulsePct>=22)?'뒷다리 추진이 전진 운동량 형성에 기여합니다.':'뒷다리 추진이 부족해 전진 운동량 형성이 제한될 수 있습니다.','로딩을 뒷발 추진과 COM 이동으로 전환',
    vB('ed-stride-1',[{label:'뒷발 추진 GRF',unit:'%BW',get:_gProp},{label:'뒷고관절 파워',unit:'W',get:_gHipP},{label:'COM 전진속도',unit:'m/s',get:_gVel}],{name:'1. 뒷다리 추진',def:'뒷다리가 지면을 밀어 몸(COM)을 홈 방향으로 보내는 힘.',calc:'AP 추진 임펄스(%BW·s)·뒷다리 양의 일(J).',interp:'클수록 전진 운동량 형성에 기여.',evalm:'추진 임펄스 코호트 대비.'}));
  html+=card('COM 전진 속도','스트라이드의 핵심 결과 — 홈 방향 이동량',
    'FC 전진속도 '+v(cm.velFC,'m/s')+' (SO '+v(cm.velSO,'')+' → gain '+v(cm.velGain,'')+') · peak '+v(cm.velPeak,'m/s')+' · 운동량 '+v(cm.momentumFC,'kg·m/s')+' · KE '+v(ke.keFC,'J'),
    (cm.velFC!=null&&cm.velFC>=2.9)?'FC 전진속도가 충분해 이후 블로킹·회전으로 전환할 원재료가 확보됩니다.':'FC 전진속도가 다소 낮아 전방 운동량 형성을 더 키울 여지가 있습니다.','전진속도 자체보다 FC에서 블로킹 가능한 형태인지 함께 관리',
    vB('ed-stride-2',[{label:'COM 전진속도',unit:'m/s',get:_gVel},{label:'COM 전진변위',unit:'m',get:_gDisp}],{name:'2. COM 전진 운동량',def:'몸 전체가 홈 쪽으로 이동하는 속도·운동량.',calc:'FC 시 COM 전진속도(m/s)·운동량(kg·m/s).',interp:'블로킹으로 제동되어 회전으로 전환할 원재료.',evalm:'FC 전진속도 약 2.9m/s 이상 양호.'}));
  html+=card('뒷다리 고관절 파워','전진 운동량의 에너지 표현(½mv²)',
    'FC '+v(ke.keFC,'J')+' · peak '+v(ke.kePeak,'J'),
    (ke.keFC!=null&&ke.keFC>=500)?'FC 전진 운동에너지가 충분합니다 — 블로킹 제동으로 회전 전환할 선형 에너지 확보.':'FC 전진 운동에너지가 낮아 블로킹·회전에 쓸 선형 에너지가 부족할 수 있습니다.','전진 KE를 블로킹으로 제동해 회전으로 전환(진단4)',
    vB('ed-stride-3',[{label:'COM 전진 KE',unit:'J',get:_gKE}],{name:'3. COM 전진 운동에너지',def:'전진 운동량의 에너지 표현(½mv²).',calc:'½·체중·전진속도².',interp:'블로킹 제동으로 회전 전환할 선형 에너지.',evalm:'FC 전진 KE 약 500J 이상 양호.'}));
  html+=card('스트라이드 길이 · 방향','보폭·폭·방향 — 길수록 좋은 게 아니라 블로킹 가능한 형태',
    '보폭 '+v(gm.strideLenPct,'%키')+' · 폭 '+v(gm.widthPct,'%키')+' · 방향 오차 '+v(gm.dirErrorDeg,'°'),
    (gm.dirErrorDeg!=null&&gm.dirErrorDeg<=8)?'COM 경로가 홈 방향으로 정렬되어 전진 에너지가 홈으로 집중됩니다.':'전진 방향이 홈에서 벗어나 측방 누수 가능성이 있습니다.','보폭은 COM 위치·착지와 함께, 방향은 홈 정렬 유지',
    pathB('ed-stride-path','',{name:'4. 스트라이드 기하',def:'보폭(키 대비 %)·폭·착지 방향 정렬.',calc:'COM·앞발 top-view 경로(홈 방향 기준).',interp:'적절한 보폭+직선 정렬이 안정 전달의 바탕.',evalm:'방향 편차 작을수록 양호.'}));
  html+=card('5. 방향·밸런스 (안정성)','전진 에너지를 보존·전달 가능한 형태로 만드는 안정성',
    'COM 좌우 SD '+v(bl.comMLsd,'mm')+' · 머리 좌우 SD '+v(bl.headMLsd,'mm')+' · 경로 곡률 '+v(bl.pathCurvature),
    (bl.pathCurvature!=null&&bl.pathCurvature<1.15)?'COM이 홈 방향으로 곧게 이동해 흔들림이 작습니다.':'스트라이드 중 좌우 흔들림이 커 전진 에너지가 홈으로 집중되지 못할 수 있습니다.','좌우 흔들림 줄이고 머리·골반·COM 정렬 유지',
    pathB('ed-stride-path2','',{name:'5. 방향·밸런스',def:'전진 중 좌우 흔들림(안정성).',calc:'COM·머리 좌우 SD(mm)·경로 곡률.',interp:'흔들림이 작을수록 전진 에너지가 홈으로 집중.',evalm:'경로 곡률 1.15 미만 양호.'}));
  html+=card('6. 착지 준비 (FC · 블로킹 시작점)','앞발이 블로킹 만들 준비로 착지했나',
    'COM-앞발 AP거리 '+v(ld.comToLeadFootAP,'mm')+' · 앞무릎 굴곡 '+v(ld.leadKneeFlexFC,'°')+' · FC→제동 '+v(ld.dtFCtoPBG,'ms')+' · 제동 peak '+v(ld.peakBrakePct,'%BW'),
    (ld.dtFCtoPBG!=null&&Math.abs(ld.dtFCtoPBG)>110)?'착지 후 AP 제동 peak가 늦게 나타나, 스트라이드가 블로킹으로 즉시 전환되지 못합니다.':'착지 후 빠르게 제동이 올라와 블로킹으로 전환됩니다.','앞다리 제동을 더 빠르게(진단4 블로킹과 연결)',
    vB('ed-stride-6',[{label:'앞발 제동 GRF',unit:'%BW',get:_gBrake},{label:'앞무릎 굴곡',unit:'°',get:_gKnee}],{name:'6. 착지 준비(FC)',def:'앞발이 블로킹 만들 준비로 착지했는지.',calc:'COM-앞발 AP거리·앞무릎 굴곡·FC→제동 peak·제동 peak.',interp:'빠른 제동 전환이면 블로킹으로 즉시 이어짐.',evalm:'FC→제동 peak 간격 짧을수록 양호.'}));
  // 로딩 보존 브리지
  html+='<div class="card" style="grid-column:1 / -1;border-left:3px solid var(--cyan)"><div style="font-size:13px;font-weight:800">로딩 보존 브리지 (스트라이드 중 회전 preload 유지) <span class="sub2">X-factor는 진단2 독립 모듈 · 여기선 보존 상태만</span></div>'
    +'<div class="note" style="margin-top:4px">골반 닫힘 유지 <b>'+v(br.pelvicClosureRetained,'%')+'</b> · 힙힌지(몸통-골반) 보존 '+v(br.hipHingeRetained,'%')+' · X-factor FC까지 풀림 <b>'+v(br.xfReleasedByFC,'%')+'</b> (FC값 '+v(br.xfAtFC,'°')+', 풀림 시작 '+v(br.xfReleaseStartMs,'ms')+') · FC 몸통 열림속도 '+v(br.thoraxOpenVelFC,'°/s')+'</div>'
    +'<div class="note" style="margin-top:4px">'+(((br.xfReleasedByFC!=null&&br.xfReleasedByFC>25)||(br.pelvicClosureRetained!=null&&br.pelvicClosureRetained<45))?'전진 중 분리각/골반 닫힘이 FC 전에 풀려, 앞으로 나가는 힘은 만들었지만 착지 후 회전에 쓸 preload를 보존하지 못한 신호입니다(조기 열림).':'전진하면서도 분리각·골반 닫힘을 FC까지 비교적 보존해 회전 preload를 지켰습니다.')+'</div>'
    +'<div style="margin-top:6px">'+btn('X-factor 자세히 →','ed-xftiming','var(--cyan)')+'</div></div>';
  // 스트라이드→블로킹 브리지
  html+='<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">스트라이드→블로킹 브리지 (다음 단계 전환 확인)</div>'
    +'<div class="note" style="margin-top:4px">FC 전진 KE '+v(ke.keFC,'J')+' · 앞발 제동 peak '+v(ld.peakBrakePct,'%BW')+' · FC→제동 peak '+v(ld.dtFCtoPBG,'ms')+'</div>'
    +'<div class="note" style="margin-top:4px">'+((ld.dtFCtoPBG!=null&&Math.abs(ld.dtFCtoPBG)>110)?'전진 에너지는 만들었지만 FC 이후 제동 반응이 늦습니다 — 문제는 전진속도가 아니라 스트라이드→블로킹 전환 시점입니다.':'전진 에너지가 FC 이후 빠른 제동으로 이어져 블로킹 전환이 양호합니다.')+'</div>'
    +'<div style="margin-top:6px">'+btn('블로킹 자세히 →','ed-blocking','var(--cyan)')+'</div></div>';
  html+='<div class="card" style="grid-column:1 / -1">'+btn('← 요약','psummary')+btn('‹ X-factor','ed-xftiming')+btn('블로킹 ›','ed-blocking')+'</div>';
  root.innerHTML=_flowBand+html;
  try{ ['ed-stride-path2','ed-stride-6'].forEach(function(id){ var c=document.getElementById(id); var cd=c&&c.closest&&c.closest('.card'); if(cd) cd.style.display='none'; }); }catch(e){}
  try{ _redrawStrideCharts(); }catch(e){}
  try{ drawStridePath('ed-stride-path'); }catch(e){}
  try{ drawStridePath('ed-stride-path2'); }catch(e){}
}
function _redrawStrideCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, S=X&&X.stride; if(!S) return;
  if(!document.getElementById('ed-stride-1')) return;
  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, mass=(DATA.player&&DATA.player.weight_kg)||86, idx=(S.events&&S.events.idx)||{};
  var EV=[];
  var Wn={fast:fast,slow:slow,startEv:'i_fc',startOff:-0.8,endEv:'i_fc',endOff:0.1,extraEvents:EV};
  // 1. 뒷다리 추진 — 추진 GRF·뒷고관절 파워(좌) + COM 전진속도(우)
  try{ plotWin('ed-stride-1',Object.assign({fillToZero:true,left:{label:'추진 GRF(%BW)·파워(W)',lines:[
    {compute:function(t){var a=t.series.FP1_Y;return a?a.map(function(x){return Math.abs(x)/(mass*9.81)*100;}):null;},color:'#46c98c',label:'뒷발 AP 추진 GRF',width:2.4}]}},Wn)); }catch(e){}
  // 2. COM 전진 운동량 — 전진속도(좌) + 전진변위(우)
  try{ plotWin('ed-stride-2',Object.assign({markPeaks:true,gaugeW:240,left:{label:'COM 전진속도 (m/s)',lines:[
    {compute:function(t){var a=t.series.COM_Velocity_Y;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#8ea9cf',label:'COM 전진속도',width:2.6}]}},Wn)); }catch(e){}
  // 3. COM 전진 운동에너지
  try{ plotWin('ed-stride-3',Object.assign({markPeaks:true,left:{label:'뒷고관절 파워 (W)',lines:[
    {compute:function(t){return t.series.Back_Hip_Power_X;},color:'#c084fc',label:'뒷고관절 파워',width:2.6}]}},Wn)); }catch(e){}
  // 6. 착지 준비 — 앞발 제동 GRF(좌) + 앞무릎 굴곡(우)
  try{ plotWin('ed-stride-6',Object.assign({left:{label:'앞발 제동 GRF (%BW)',lines:[
    {compute:function(t){var a=t.series.FP2_Y;return a?a.map(function(x){return Math.abs(x)/(mass*9.81)*100;}):null;},color:'#6db4e6',label:'앞발 제동 GRF',width:2.4}]},
    right:{label:'앞무릎 굴곡 (°)',lines:[{compute:function(t){var a=t.series.Lead_Knee_Angle_X;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bd3ff',label:'앞무릎 굴곡',width:2.0}]}},Wn)); }catch(e){}
  // 경로 그림(기하·밸런스)도 현재 재생 프레임 마커와 함께 갱신 — 좌측 스틱 재생과 동기화
  try{ drawStridePath('ed-stride-path'); }catch(e){}
  try{ drawStridePath('ed-stride-path2'); }catch(e){}
}
// ── 스트라이드 top-view 경로 (COM·앞발, 홈 방향=화면 오른쪽, 재생 프레임 마커 동기화) ──
var _STRIDE_FOOT_L='data:image/png;base64,';
var _STRIDE_FOOT_R='data:image/png;base64,';
function drawStridePath(cid){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, S=X&&X.stride;
  var canvas=document.getElementById(cid); if(!canvas) return;
  var cc=clearC(canvas), ctx=cc.ctx, w=cc.w, h=cc.h;
  if(!S||!S.pathTopView||!S.pathTopView.length) return;
  var P=S.pathTopView;
  if(!drawStridePath._iL){ var _a=new Image(); _a.onload=function(){try{drawStridePath(cid);}catch(e){}}; _a.src=_STRIDE_FOOT_L; drawStridePath._iL=_a; }
  if(!drawStridePath._iR){ var _b=new Image(); _b.onload=function(){try{drawStridePath(cid);}catch(e){}}; _b.src=_STRIDE_FOOT_R; drawStridePath._iR=_b; }
  var iL=drawStridePath._iL, iR=drawStridePath._iR, footOK=iL&&iL.complete&&iR&&iR.complete;
  var RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L');
  var aps=[],mls=[]; P.forEach(function(p){ [[2,1],[4,3],[6,5]].forEach(function(ix){ if(p[ix[0]]!=null){aps.push(p[ix[0]]);mls.push(p[ix[1]]);} }); });
  if(!aps.length) return;
  var apmin=Math.min.apply(null,aps),apmax=Math.max.apply(null,aps),mlmin=Math.min.apply(null,mls),mlmax=Math.max.apply(null,mls);
  var fwd=(P[P.length-1][2]>=P[0][2])?1:-1;
  var pad=54, sc=Math.min((w-2*pad)/((apmax-apmin)||1),(h-2*pad-24)/((mlmax-mlmin)||1));
  function gx(ap){return pad+((fwd>=0)?(ap-apmin):(apmax-ap))*sc;}
  function gy(ml){return (h-24)-pad-(ml-mlmin)*sc;}
  function pathL(ai,mi,col,wd){ctx.strokeStyle=col;ctx.lineWidth=wd;ctx.beginPath();var st=true;P.forEach(function(p){if(p[ai]==null||p[mi]==null)return;var x=gx(p[ai]),y=gy(p[mi]);if(st){ctx.moveTo(x,y);st=false;}else ctx.lineTo(x,y);});ctx.stroke();}
  pathL(6,5,'rgba(155,165,180,0.55)',2.0);   // 뒷발 경로(회색)
  pathL(4,3,'rgba(201,161,74,0.6)',2.0);      // 앞발 경로(금색)
  pathL(2,1,'#5bd3ff',2.8);                   // COM(청록)
  var fc=null;P.forEach(function(p){if(fc==null||Math.abs(p[0])<Math.abs(fc[0]))fc=p;});
  var glove=RHP?-1:1, FT=72, mir=RHP?1:-1;
  function drawFt(img,ap,ml,rot){ if(ap==null||ml==null)return; var x=gx(ap),y=gy(ml); ctx.save();ctx.translate(x,y);ctx.scale(mir,1);ctx.rotate(rot);
    if(footOK&&img&&img.naturalWidth){ var iw=img.naturalWidth,ih=img.naturalHeight,s=FT/Math.max(iw,ih); ctx.drawImage(img,-iw*s/2,-ih*s/2,iw*s,ih*s); }
    else { ctx.fillStyle='rgba(255,255,255,0.06)';ctx.strokeStyle='#cfd6e0';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(0,0,FT/2,FT*0.2,0,0,7);ctx.fill();ctx.stroke(); }
    ctx.restore(); }
  var leadAP=RHP?fc[4]:fc[6], leadML=RHP?fc[3]:fc[5], backAP=RHP?fc[6]:fc[4], backML=RHP?fc[5]:fc[3];
  drawFt(iL, backAP,backML, 0);            /* 뒷발 = 왼발.png(발+고무판) 원래 방향 */
  drawFt(iR, leadAP,leadML, glove*0.10);   /* 앞발 = 오른발.png(발끝 홈) */
  // 재생 커서(현재 프레임) — COM·양발에 점
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:null;
  if(cf!=null){var ft=(typeof _fastTrial==='function')?_fastTrial():null;var ifc=(ft&&ft.events&&ft.events.i_fc)||0,dtv=(ft&&ft.meta&&ft.meta.dt)||0.00333;var curMs=(cf-ifc)*dtv*1000;var bp=null,bd=1e9;P.forEach(function(p){var d=Math.abs(p[0]-curMs);if(d<bd){bd=d;bp=p;}});if(bp){ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.5;[[2,1,'#5bd3ff'],[4,3,'#c9a14a'],[6,5,'#9ba5b4']].forEach(function(q){if(bp[q[0]]!=null){ctx.fillStyle=q[2];ctx.beginPath();ctx.arc(gx(bp[q[0]]),gy(bp[q[1]]),5,0,7);ctx.fill();ctx.stroke();}});}}
  // 범례
  ctx.font='11px system-ui';ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillStyle='#5bd3ff';ctx.fillText('● COM',8,8); ctx.fillStyle='#c9a14a';ctx.fillText('● 앞발',8,22); ctx.fillStyle='#9ba5b4';ctx.fillText('● 뒷발',8,36);
  // 길이·방향 텍스트
  var dAP=Math.abs(leadAP-backAP),dML=Math.abs(leadML-backML),sl=Math.sqrt(dAP*dAP+dML*dML);if(sl>10)sl/=1000;
  var dirDeg=Math.abs(Math.atan2(dML,dAP||1)*180/Math.PI);
  ctx.fillStyle='#e8ecf2';ctx.font='bold 14px system-ui';ctx.textAlign='center';ctx.textBaseline='bottom';
  ctx.fillText('스트라이드 길이 '+(sl?sl.toFixed(2)+' m':'–')+'   ·   방향 홈→글러브 쪽 '+(isFinite(dirDeg)?Math.round(dirDeg):'–')+'°',w/2,h-6);
}
function drawCopFoot(cid){
  var canvas=document.getElementById(cid); if(!canvas) return;
  var cc=clearC(canvas), ctx=cc.ctx, w=cc.w, h=cc.h;
  var t=(typeof _fastTrial==='function')?_fastTrial():null; if(!t||!t.series){return;}
  var S=t.series, cpx=S.FP2_X_2, cpy=S.FP2_Y_2, fz=S.FP2_Z, fy=S.FP2_Y;
  if(!cpx||!cpy||!fz){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('앞발 COP 데이터 없음',w/2,h/2); return; }
  var e=t.events||{}, i0=e.i_fc||0, i1=(e.i_br!=null?e.i_br:cpx.length-1);
  var mass=(typeof _blkMass==='function')?_blkMass():86, gN=mass*9.81;
  var xs=[],ys=[]; for(var i=i0;i<=i1&&i<cpx.length;i++){ if(isFinite(cpx[i])&&isFinite(cpy[i])&&isFinite(fz[i])&&Math.abs(fz[i])>20){xs.push(cpx[i]);ys.push(cpy[i]);} }
  if(xs.length<2){ ctx.fillStyle='#7d8898';ctx.textAlign='center';ctx.fillText('앞발 접지 데이터 부족',w/2,h/2); return; }
  var xmin=Math.min.apply(null,xs),xmax=Math.max.apply(null,xs),ymin=Math.min.apply(null,ys),ymax=Math.max.apply(null,ys);
  if(!drawCopFoot._img && typeof _STRIDE_FOOT_R!=='undefined'){ var im=new Image(); im.onload=function(){try{drawCopFoot(cid);}catch(e){}}; im.src=_STRIDE_FOOT_R; drawCopFoot._img=im; }
  var fimg=drawCopFoot._img;
  var pad=44, fw=Math.min(w-2*pad,250), tilt=0.62, fx=(w-fw)/2, fy0=h*0.22;
  var iar=(fimg&&fimg.naturalWidth)?(fimg.naturalHeight/fimg.naturalWidth):0.45, footH=fw*iar*tilt;
  if(fimg&&fimg.complete&&fimg.naturalWidth){ ctx.save(); ctx.globalAlpha=0.5; ctx.drawImage(fimg,fx,fy0,fw,footH); ctx.restore(); }
  // forward(cpy)→가로(발끝) / lateral(cpx)→세로(발폭) · 발 안쪽 패딩으로 윤곽 내부 유지
  var mxp=fw*0.15, myp=footH*0.20;
  function MX(yf){ return fx+mxp + (ymax>ymin?(yf-ymin)/(ymax-ymin):0.5)*(fw-2*mxp); }
  function MY(xl){ return fy0+myp + (xmax>xmin?(xl-xmin)/(xmax-xmin):0.5)*(footH-2*myp); }
  ctx.strokeStyle='#5bd3ff'; ctx.lineWidth=2.2; ctx.beginPath(); var st=true;
  for(var k=i0;k<=i1&&k<cpx.length;k++){ if(!isFinite(cpx[k])||!isFinite(cpy[k])||Math.abs(fz[k])<20)continue; var X=MX(cpy[k]),Y=MY(cpx[k]); if(st){ctx.moveTo(X,Y);st=false;}else ctx.lineTo(X,Y); } ctx.stroke();
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):i1; cf=Math.max(i0,Math.min(i1,cf));
  if(isFinite(cpx[cf])&&isFinite(cpy[cf])){ var X=MX(cpy[cf]),Y=MY(cpx[cf]);
    var vz=Math.abs(fz[cf])/gN, vy=(fy&&isFinite(fy[cf]))?Math.abs(fy[cf])/gN:0, VS=66;
    function arr(x2,y2,col){ ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=3.4;ctx.beginPath();ctx.moveTo(X,Y);ctx.lineTo(x2,y2);ctx.stroke(); var a=Math.atan2(y2-Y,x2-X); ctx.beginPath();ctx.moveTo(x2,y2);ctx.lineTo(x2-9*Math.cos(a-0.4),y2-9*Math.sin(a-0.4));ctx.lineTo(x2-9*Math.cos(a+0.4),y2-9*Math.sin(a+0.4));ctx.fill(); }
    arr(X-vy*VS, Y-vz*VS, '#ff8c42'); // 합력 GRF(위+뒤=제동)
    ctx.fillStyle='#5bd3ff';ctx.strokeStyle='#0b0d12';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(X,Y,5,0,7);ctx.fill();ctx.stroke();
  }
  ctx.font='11px system-ui';ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillStyle='#5bd3ff';ctx.fillText('● COP 궤적',10,10); ctx.fillStyle='#ff8c42';ctx.fillText('↖ 합력 GRF (제동)',10,26);
}

// ── X-factor 진단 전용 화면 (개발문서 v1) ──
// 한 trial 의 부호화 X-factor 에서 "풀림(uncoil) 속도"(°/s) 시계열 — peak 방향에서 0/반대로 푸는 속도
function _xfUncoil(t){
  var xs=t.x_factor; if(!xs) return null; var dt=(t.meta&&t.meta.dt)||0.00333;
  var iKH=(t.events&&t.events.i_kl_peak)||0, iBR=(t.events&&t.events.i_br)||(xs.length-1);
  var pk=0; for(var i=iKH;i<=iBR&&i<xs.length;i++){ if(isFinite(xs[i])&&Math.abs(xs[i])>Math.abs(pk)) pk=xs[i]; }
  var sgn=pk>=0?1:-1, out=new Array(xs.length);
  for(var k=0;k<xs.length;k++){ var d=(k===0||!isFinite(xs[k])||!isFinite(xs[k-1]))?NaN:(xs[k]-xs[k-1])/dt; out[k]=isFinite(d)?Math.max(0,-sgn*d):NaN; }
  return out;
}
// 부호 정렬된 X-factor (peak 가 양수가 되도록) — 그래프에서 "형성→풀림" 곡선이 위로 솟았다 내려오게
function _xfSigned(t){
  var xs=(t.series&&t.series.Trunk_wrt_Pelvis_Angle_Z)||t.x_factor; if(!xs) return null;  /* [2026-05-29] X-factor=분절 축회전(segAxial) 통일 */
  var iKH=(t.events&&t.events.i_kl_peak)||0, iBR=(t.events&&t.events.i_br)||(xs.length-1);
  var pk=0; for(var i=iKH;i<=iBR&&i<xs.length;i++){ if(isFinite(xs[i])&&Math.abs(xs[i])>Math.abs(pk)) pk=xs[i]; }
  var sgn=pk>=0?1:-1; return xs.map(function(v){ return isFinite(v)?sgn*v:NaN; });
}
function _xfRiskCol(r){ return r==='High'?'#ff4d4d':(r==='Moderate'?'#e8954e':'#46c98c'); }
function renderEdXFactorTiming(){
  var root=document.getElementById('ed-body-xftiming'); if(!root) return;
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, F=X&&X.xftiming;
  if(!F){ root.innerHTML='<div class="card"><div class="note">X-factor 데이터가 없습니다 (지면반력 있는 Theia 분석 필요).</div></div>'; return; }
  function v(x,u){ return (x==null)?'–':(x+(u||'')); }
  function ms(x){ return (x==null)?'–':((x>=0?'+':'')+x+'ms'); }
  function card(title,role,vals,meaning,coach,extra){ return '<div class="card" style="grid-column:1 / -1"><div style="font-size:13px;font-weight:800">'+title+'</div>'
    +'<div class="note" style="margin-top:3px"><b>역할:</b> '+role+'</div><div class="note" style="margin-top:3px"><b>측정:</b> '+vals+'</div>'
    +'<div class="note" style="margin-top:3px"><b>에너지 흐름 해석:</b> '+meaning+'</div><div class="note" style="margin-top:3px"><b>코칭:</b> '+coach+'</div>'+(extra||'')+'</div>'; }
  function btn(lbl,pg,col){ return '<button class="bm-focus-btn" onclick="setPage(\''+pg+'\')" style="font-size:12px;background:var(--bg1);border:1px solid var(--line);color:'+(col||'var(--fg2)')+';border-radius:6px;padding:6px 12px;cursor:pointer;margin-right:6px">'+lbl+'</button>'; }
  var rc=_xfRiskCol(F.flyingOpenRisk), ev=F.events||{};
  // 각 변인 카드 아래에 그래프+게이지 + 폴더용(이벤트표·정의) 인라인
  var _fxT=(typeof _fastTrial==='function')?_fastTrial():null, _ixx=(F.events&&F.events.idx)||{}, _mX=(DATA.player&&DATA.player.weight_kg)||86, _xfA=_fxT?_xfSigned(_fxT):null, _unA=_fxT?_xfUncoil(_fxT):null, _EVTx=_edEvtListG(_ixx,_fxT);
  function vB(cid,evRows,def){ return '<canvas id="'+cid+'" style="width:100%;height:190px;display:block;margin-top:8px"></canvas>'
    +''
    +_edFoldG('이벤트별 데이터 표 (폴더용)', _edEvtTableG(_EVTx, evRows))
    +_edFoldG('변인 정의·산출·해석·평가 (폴더용)', _edDefCardG(def)); }
  function _rXf(f){ return (_xfA&&isFinite(_xfA[f]))?Math.round(_xfA[f]*10)/10:null; }
  function _rUn(f){ return (_unA&&isFinite(_unA[f]))?Math.round(_unA[f]):null; }
  var html='<div class="card" style="grid-column:1 / -1;border-left:4px solid var(--cyan)">'
    +'<div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><div style="font-size:14px;font-weight:800">X-factor · <span style="color:var(--cyan)">'+F.typeKo+'</span></div>'
    +'<div style="font-size:13px;font-weight:800">타이밍 점수 '+v(F.timingScore)+'점 · <span style="color:'+rc+'">플라잉 오픈 위험 '+F.flyingOpenRisk+'</span></div></div>'
    +'<div style="font-size:14px;font-weight:700;line-height:1.6;margin-top:6px">'+F.summary+'</div>'
    +'<div class="note" style="margin-top:5px">X-factor(골반-몸통 분리)는 <b>저장</b>한 회전 에너지입니다 — 핵심은 크기보다 <b>풀리는 시점</b>입니다. FC까지 보존했다가 블로킹(앞발 제동) 이후 빠르게 풀려야 하체→몸통→팔 순차 전달이 됩니다. 너무 일찍 풀리면(플라잉 오픈) 지면에서 받을 에너지를 놓칩니다. (각도=분리 저장 · 각속도=푸는 속도)</div></div>';
  html+=card('<span style="color:#e8954e">X-factor</span> 및 <span style="color:#46c98c">풀림 타이밍</span>','분리각(저장·주황)을 만들어 풀림 시작(전달·녹색) 시점이 적절한가',
    '최대 분리각 <b>'+v(F.segAxialPeakDeg,'°')+'</b> (분절 축회전 Trunk_wrt_Pelvis · MXF '+ms(ev.MXF)+', '+(F.peakSign>=0?'정상 방향':'반대 방향')+') · <b>FC 보존 '+v(F.retainedPct,'%')+'</b>'
      +(F.segAxialPeakDeg!=null?' · <span style="color:var(--fg2)">참고: 글로벌 수평투영 <b>'+v(F.peakDeg,'°')+'</b>(몸통 측면기울기 포함)</span>':''),
    (F.segAxialPeakDeg!=null&&F.segAxialPeakDeg>=30)?'분리각 자체는 충분히 만들어졌습니다 — 저장된 회전 에너지는 확보된 상태입니다.':'분리각이 크지 않아 저장된 회전 에너지가 제한적입니다(다만 타이밍이 좋으면 크기는 보조 지표).'
      +(F.segAxialPeakDeg!=null&&F.peakDeg!=null&&(F.peakDeg-F.segAxialPeakDeg)>=20?' <b>주의:</b> 글로벌 값('+F.peakDeg+'°)이 분절 축비틀림('+F.segAxialPeakDeg+'°)보다 '+Math.round(F.peakDeg-F.segAxialPeakDeg)+'° 큽니다 — 이 차이는 몸통 경사가 수평투영에 섞인 것으로, 순수 축회전 분리는 더 작습니다(분리각 크기를 과대해석 금지).':''),
    '분리각을 무리하게 키우기보다, 만든 분리를 FC까지 보존하고 풀림 시점을 맞추는 데 집중 (크기는 글로벌·분절 정의에 따라 달라지므로 보조 지표로만)',
    vB('ed-xf-1',[{label:'X-factor 분리각',unit:'°',get:_rXf}],{name:'1. X-factor 최대 분리각',def:'골반과 몸통(상체)의 수평 분리각.',calc:'글로벌 수평투영 분리각(분절 축비틀림 값 병기).',interp:'저장된 회전 에너지의 크기 — 크기보다 푸는 시점이 중요.',evalm:'코호트 대비 보조 지표.'}));
  html+=card('2. FC까지 보존 (저장 유지)','조기 풀림(플라잉 오픈) 없이 회전 preload 를 착지까지 지켰나',
    'FC 분리각 '+v(F.atFCdeg,'°')+' · <b>보존 '+v(F.retainedPct,'%')+'</b> · FC까지 풀림 '+v(F.releasedPct,'%'),
    (F.retainedPct!=null&&F.retainedPct>=70)?'분리각을 FC까지 잘 보존해, 착지 후 폭발적으로 풀 회전 에너지가 남아 있습니다.':'FC 이전에 분리각이 많이 풀려(조기 열림) 착지 후 전달에 쓸 회전 에너지가 줄었습니다.',
    (F.retainedPct!=null&&F.retainedPct<70)?'스트라이드 중 골반·몸통 조기 회전을 억제해 FC까지 분리를 보존(진단3 로딩 보존 브리지와 연결)':'현재 보존 패턴 유지',
    vB('ed-xf-2',[{label:'X-factor 분리각',unit:'°',get:_rXf}],{name:'2. FC까지 보존',def:'분리각이 착지(FC)까지 유지된 비율.',calc:'보존% = FC 분리각 / 최대 분리각 × 100.',interp:'FC까지 보존되면 착지 후 폭발적으로 풀 회전 에너지가 남음.',evalm:'70% 이상 양호.'}));
  html+=card('X-factor 풀림 (전달)','분리각을 언제·얼마나 빠르게 풀어 회전 에너지를 전달하나',
    '<b>풀림 시작 FC'+ms(F.releaseStartMs)+'</b> (XRS) · 풀림 속도 '+v(F.releasePeakVel,'°/s'),
    (F.releaseStartMs!=null&&F.releaseStartMs>=-5&&F.releaseStartMs<=30)?'풀림이 FC 직후 시작되어 블로킹으로 제동된 하체 에너지를 몸통 회전으로 잘 이어받습니다.':((F.releaseStartMs!=null&&F.releaseStartMs<-5)?'풀림이 FC 이전에 시작돼(조기 풀림) 지면반력으로 키울 에너지를 일부 놓칩니다.':'풀림 시작이 다소 늦어 블로킹된 에너지를 즉시 회전으로 전환하지 못할 수 있습니다.'),
    '풀림 시작을 FC 직후(0~+30ms) 블로킹 정점과 맞추는 것을 최우선',
    vB('ed-xf-3',[{label:'풀림 속도',unit:'°/s',get:_rUn}],{name:'3. 풀림 시작 타이밍',def:'분리각을 풀기 시작하는 시점(FC 기준).',calc:'풀림 시작 프레임 − FC (ms).',interp:'FC 직후(0~+30ms) 블로킹과 맞물려야 전달 효율 최대.',evalm:'조기 풀림(음수)·지연 모두 감점.'}));
  html+=card('4. 풀림 속도 · 양 (전달 강도)','얼마나 빠르고 충분히 푸는가 — 전달되는 회전 에너지의 양',
    '풀림 최대 속도 <b>'+v(F.releasePeakVel,'°/s')+'</b> ('+ms(ev.XRPV)+') · 풀림 양 '+v(F.releaseArea,'°'),
    (F.releasePeakVel!=null&&F.releasePeakVel>=700)?'풀림 속도가 빨라 저장된 분리 에너지가 강하게 몸통으로 전달됩니다.':'풀림 속도가 다소 낮아 분리 에너지가 충분히 전달되지 못할 수 있습니다.',
    '보존이 된 상태에서 풀림 속도를 높이면 전달 효율이 올라감 — 단, 시점이 우선',
    vB('ed-xf-4',[{label:'풀림 속도',unit:'°/s',get:_rUn}],{name:'4. 풀림 속도·양',def:'분리각을 푸는 최대 각속도와 총량.',calc:'풀림 속도 = −sign·d(분리각)/dt 의 양의 peak.',interp:'빠를수록 저장 에너지가 강하게 몸통으로 전달.',evalm:'700°/s 이상 양호(시점 우선).'}));
  html+=card('5. 블로킹 동기화 (전달 연결)','앞발 제동(블로킹) 정점과 풀림 시작이 맞물리나',
    '블로킹 정점(PBG) '+ms(ev.PBG)+' → 풀림 시작 간격 <b>'+ms(F.dPBGtoXRS)+'</b>',
    (F.dPBGtoXRS!=null&&F.dPBGtoXRS>=-5&&F.dPBGtoXRS<=45)?'블로킹으로 하체가 멈추는 시점과 분리 풀림이 잘 맞물려 운동량이 회전으로 전환됩니다.':'블로킹 정점과 풀림 시작이 어긋나 하체 제동 에너지가 회전으로 효율적으로 넘어가지 못할 수 있습니다.',
    '앞발 제동(진단4)과 분리 풀림 시점을 함께 맞추기',
    vB('ed-xf-5',[{label:'풀림 속도',unit:'°/s',get:_rUn},{label:'앞발 수직 GRF',unit:'%BW',get:function(f){var a=_fxT&&_fxT.series&&_fxT.series.FP2_Z;return (a&&isFinite(a[f]))?Math.round(Math.abs(a[f])/(_mX*9.81)*100*10)/10:null;}}],{name:'5. 블로킹 동기화',def:'앞발 제동 정점(PBG)과 풀림 시작의 간격.',calc:'풀림 시작 − PBG (ms).',interp:'맞물리면 하체 제동 운동량이 회전으로 전환.',evalm:'-5~+45ms 양호.'}));
  html+=card('6. 몸통 에너지 전환 (전달 결과)','풀린 분리각이 몸통 에너지 정점으로 이어지나',
    '몸통 에너지 정점(TEP) '+ms(ev.TEP)+' · 풀림 정점→몸통E 간격 '+ms(F.dXRPVtoTEP)+' · 어깨 내회전 정점 '+ms(ev.SIRP)+' (풀림→어깨IR '+ms(F.dXRPVtoSIRP)+')',
    (F.dXRPVtoTEP!=null&&Math.abs(F.dXRPVtoTEP)<=40)?'풀림 직후 몸통 에너지가 정점에 도달해 분리→몸통 전달이 잘 일어납니다.':'풀림과 몸통 에너지 정점의 간격이 커, 분리각이 몸통 회전으로 매끄럽게 이어지지 않을 수 있습니다.',
    '풀림→몸통→팔(어깨 내회전)이 짧은 간격으로 순차 정점을 찍도록 (참고: 몸통 분절 에너지 정점은 일찍 잡히는 경향이 있어 보조 지표로 해석)',
    vB('ed-xf-6',[{label:'풀림 속도',unit:'°/s',get:_rUn},{label:'몸통 에너지',unit:'J',get:function(f){return _edSV(_fxT,'Trunk_ME_X',f,1);}}],{name:'6. 몸통 에너지 전환',def:'풀린 분리각이 몸통 에너지 정점(TEP)으로 이어지는지.',calc:'풀림 정점(XRPV) → TEP 간격(ms).',interp:'간격이 짧으면 분리→몸통 전달이 매끄러움.',evalm:'|간격| ≤ 40ms 양호.'}));
  html+=card('7. 플라잉 오픈 위험 (조기 열림 신호 종합)','골반/몸통이 FC 전에 정면으로 열려버리는 위험',
    'FC 몸통 열림속도 '+v(F.thoraxOpenVelFC,'°/s')+' · FC 골반 열림속도 '+v(F.pelvisOpenVelFC,'°/s')+' · 골반 닫힘 유지 '+v(F.pelvicClosureRetained,'%')+' · <b style="color:'+rc+'">종합 위험 '+F.flyingOpenRisk+'</b>',
    (F.flyingOpenRisk==='Low')?'조기 열림 신호가 적어, 분리각이 FC 이후 풀리는 안정적 패턴입니다.':((F.flyingOpenRisk==='High')?'골반·몸통이 FC 전에 일찍 열리는 신호가 뚜렷합니다(플라잉 오픈) — 지면반력으로 키울 에너지를 크게 놓칩니다.':'일부 조기 열림 신호가 있어 풀림 시점을 더 늦출 여지가 있습니다.'),
    (F.flyingOpenRisk==='Low')?'현재 닫힘·보존 패턴 유지':'와인드업 골반 닫힘 유지(진단1)·스트라이드 조기 회전 억제(진단3)로 FC까지 정면을 닫아두기',
    vB('ed-xf-7',[{label:'몸통 열림속도',unit:'°/s',get:function(f){return _edSV(_fxT,'Thorax_Ang_Vel_Z',f,1,true);}},{label:'골반 열림속도',unit:'°/s',get:function(f){return _edSV(_fxT,'Pelvis_Ang_Vel_Z',f,1,true);}}],{name:'7. 플라잉 오픈 위험',def:'골반·몸통이 FC 전에 정면으로 열리는 위험.',calc:'FC 골반/몸통 열림속도 + 닫힘 보존 종합.',interp:'높으면 지면반력으로 키울 에너지를 크게 놓침.',evalm:'Low/Moderate/High 3등급.'}));
  /* [2026-05-29] 내비 버튼 제거 — 회전(골반→몸통) 탭에 임베드 */
  root.innerHTML=html;
  try{ ['ed-xf-2','ed-xf-3','ed-xf-4','ed-xf-5','ed-xf-6','ed-xf-7'].forEach(function(id){ var c=document.getElementById(id); var card=c&&c.closest&&c.closest('.card'); if(card) card.style.display='none'; }); }catch(e){}  /* [2026-05-29] 중복 풀림속도 그래프 카드 정리 */
  try{ _redrawXfCharts(); }catch(e){}
}
function _redrawXfCharts(){
  var X=(typeof ETDIAG!=='undefined')?ETDIAG:null, F=X&&X.xftiming; if(!F) return;
  if(!document.getElementById('ed-xf-1')) return;
  // [2026-05-29] X-factor 카드1에 탑뷰 스틱(골반선·어깨선 꼬임) 주입 — 피크 시점, 방어적
  try{ if(typeof _WG!=='undefined'){ if(!_WG.data) _WG.data=_WG.build();
    var _xc=document.getElementById('ed-xf-1');
    if(_xc && _WG.data){
      if(!document.getElementById('ed-xf-stk')){
        var _row=document.createElement('div'); _row.style.cssText='display:flex;gap:14px;align-items:center;margin-top:8px';
        _xc.parentNode.insertBefore(_row,_xc);
