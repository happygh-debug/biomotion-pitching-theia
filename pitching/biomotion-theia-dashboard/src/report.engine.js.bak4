  storage:{startEv:'i_fc',startOff:-0.1,endEv:'i_br',endOff:0.2},
  release:{startEv:'i_kl_peak',startOff:0,endEv:'i_br',endOff:0.1},   // [2026-05-26] 상체가속: 니하이~릴리즈+0.1s 로 좁힘
  transfer:{startEv:'i_kl_peak',startOff:0,endEv:'i_br',endOff:0.1},
  balance:{startEv:'i_kl_peak',startOff:-0.1,endEv:'i_br',endOff:0.2},
  injuryload:{startEv:'i_fc',startOff:-0.1,endEv:'i_br',endOff:0.1}   // [2026-05-26] 부상 잠재 부하(상지) — FC-0.1s ~ BR+0.1s (교수 지시)
};
var _curPhaseWin={startEv:'i_fc',startOff:-0.3,endEv:'i_br',endOff:0.2};
// ── 시계열 보기 모드: 'band'=전 투구 평균±1SD(일관성, 디폴트) | 'compare'=빠른공 vs 느린공 2트라이얼 ──
var _tsMode='band';
function _tsSet(m){ if(_tsMode===m)return; _tsMode=m; var ap=document.querySelector('.tab.active'); if(ap&&ap.dataset.page) setPage(ap.dataset.page); }
function _tsToggleHTML(){ var band=(_tsMode==='band');
  var on='background:var(--cyan);color:#06121c', off='background:var(--bg2);color:var(--fg0);border:1px solid var(--line)';
  return '<div class="card" style="grid-column:1 / -1;display:flex;align-items:center;gap:10px;flex-wrap:wrap">'
   +'<b style="font-size:13px">시계열 보기</b>'
   +'<button class="cp-jump" onclick="_tsSet(\'band\')" style="'+(band?on:off)+'"> 일관성 (평균±SD)</button>'
   +'<button class="cp-jump" onclick="_tsSet(\'compare\')" style="'+(band?off:on)+'"> 빠른공 vs 느린공</button>'
   +'<span class="sub2">'+(band?'전 투구 평균(굵은 선) ± 1표준편차(엷은 띠) — 투구 간 반복성을 한눈에':'빠른 공(실선) · 느린 공(점선) 두 트라이얼 비교')+'</span></div>'; }
// ── 두 선수 비교: 빌드 시 임베드된 DATA._compare(슬림 상대 선수들)로 표+시계열 오버레이 ──
var _CMP_COL='#c084fc';
var _cmpOn=false, _cmpIdx=-1;
function _cmpList(){ if(typeof DATA!=='undefined'&&DATA._compare&&DATA._compare.length) return DATA._compare; if(typeof window!=='undefined'&&window.__COHORT_COMPARE&&window.__COHORT_COMPARE.length){ var sn=(typeof DATA!=='undefined'&&DATA.player&&DATA.player.name)||''; return window.__COHORT_COMPARE.filter(function(p){return p&&p.name&&p.name!==sn;}); } return []; }
function _cmpDefault(){ var L=_cmpList(); if(!L.length)return -1; var i; for(i=0;i<L.length;i++){ if((L[i].name||'').indexOf('이영하')>=0)return i; } for(i=0;i<L.length;i++){ if((L[i].name||'').indexOf('문서준')>=0)return i; } return 0; }
function _cmpPlayer(){ var L=_cmpList(); var ix=(_cmpIdx<0)?_cmpDefault():_cmpIdx; return (ix>=0&&ix<L.length)?L[ix]:null; }
function _cmpTrial(){ var p=_cmpPlayer(); return (p&&p.trials&&p.trials[0])?p.trials[0]:null; }
function _cmpSet(i){ _cmpIdx=parseInt(i,10); _cmpOn=true; if(typeof _applyStickCompare==='function')_applyStickCompare(); var ap=document.querySelector('.tab.active'); if(ap&&ap.dataset.page) setPage(ap.dataset.page); }
function _cmpToggle(){ _cmpOn=!_cmpOn; if(_cmpOn&&_cmpIdx<0)_cmpIdx=_cmpDefault(); _applyStickCompare(); var ap=document.querySelector('.tab.active'); if(ap&&ap.dataset.page) setPage(ap.dataset.page); }
// ── 상단 비교 토글: 빠른-느린(같은 선수) / 다른 선수(클라우드 저장). 스틱+그래프+수치 일괄 반영 ──
var _fsOn=false;
function _applyStickCompare(){ try{ _WG.data=null; }catch(e){}  // 게이지 잔상 소스가 바뀌므로 재빌드 강제
  try{
    if(_cmpOn){ var ct=_cmpTrial(); if(ct&&ct.frames&&ct.frames.length){ playback.setCompare(true,_fastTrial(),ct,'fc'); return; } }
    if(_fsOn){ playback.setCompare(true,_fastTrial(),_slowTrial(),'fc'); return; }
    playback.setCompare(false); if(typeof window!=='undefined')window._cmpB=null;
  }catch(e){} }
function _fsCompareToggle(){ _fsOn=!_fsOn; _tsMode=_fsOn?'compare':'band'; _applyStickCompare();
  var b=document.getElementById('btn-fscompare'); if(b){ b.textContent=_fsOn?'빠른-느린 비교 ✓':'빠른-느린 비교'; b.style.background=_fsOn?'#5bb6e6':''; b.style.color=_fsOn?'#06121c':''; b.style.borderColor=_fsOn?'#5bb6e6':''; }
  var ap=document.querySelector('.tab.active'); if(ap&&ap.dataset.page) setPage(ap.dataset.page); }
function _plCompareToggle(){ if(!_cmpList().length){ alert('비교할 다른 선수 데이터가 없습니다 — 저장된 선수가 있어야 합니다.'); return; } _cmpOn=!_cmpOn; if(_cmpOn&&_cmpIdx<0)_cmpIdx=_cmpDefault(); _applyStickCompare();
  var b=document.getElementById('btn-plcompare'); if(b){ b.textContent=_cmpOn?('선수 비교 ✓'+(_cmpPlayer()?(' · '+_cmpPlayer().name):'')):'선수 비교'; b.style.background=_cmpOn?'#c084fc':''; b.style.color=_cmpOn?'#1a0f24':''; b.style.borderColor=_cmpOn?'#c084fc':''; }
  var ap=document.querySelector('.tab.active'); if(ap&&ap.dataset.page) setPage(ap.dataset.page); }
if(typeof window!=='undefined'){ window._fsCompareToggle=_fsCompareToggle; window._plCompareToggle=_plCompareToggle; }
function _cmpToggleHTML(){ var L=_cmpList(); if(!L.length) return ''; var cur=(_cmpIdx<0)?_cmpDefault():_cmpIdx;
  var opts=L.map(function(p,i){ return '<option value="'+i+'"'+(i===cur?' selected':'')+'>'+p.name+'</option>'; }).join('');
  var on='background:'+_CMP_COL+';color:#10121a', off='background:var(--bg2);color:var(--fg0);border:1px solid var(--line)';
  var cp=_cmpPlayer();
  return '<div class="card" style="grid-column:1 / -1;display:flex;align-items:center;gap:10px;flex-wrap:wrap">'
   +'<b style="font-size:13px">두 선수 비교</b>'
   +'<button class="cp-jump" onclick="_cmpToggle()" style="'+(_cmpOn?on:off)+'"> 비교 '+(_cmpOn?'켜짐':'꺼짐')+'</button>'
   +'<span class="sub2">상대 선수</span><select onchange="_cmpSet(this.value)" style="background:var(--bg2);color:var(--fg0);border:1px solid var(--line);border-radius:6px;padding:5px 8px;font-size:13px">'+opts+'</select>'
   +'<span class="sub2">'+(_cmpOn?('현재 선수(실선) vs <b style="color:'+_CMP_COL+'">'+(cp?cp.name:'')+'</b>(보라 점선)'):'버튼을 켜면 상대 선수 곡선을 겹쳐 봅니다')+'</span></div>'; }
function _cmpTableHTML(phaseKey){ if(!_cmpOn) return ''; var cp=_cmpPlayer(); if(!cp||!cp.phases||!cp.phases.stages) return '';
  var P=(typeof DATA!=='undefined')?DATA.phases:null; if(!P||!P.stages) return '';
  var hs=P.stages.filter(function(s){return s.key===phaseKey;})[0]; if(!hs) return '';
  var csg=cp.phases.stages.filter(function(s){return s.key===phaseKey;})[0]; var cmap={}; if(csg)(csg.metrics||[]).forEach(function(m){cmap[m.key]=m;});
  var hostNm=(DATA.player&&DATA.player.name)||'현재 선수';
  function cell(mt,unit){ if(!mt||mt.value==null)return '<td style="text-align:right;color:var(--fg2)">—</td>'; var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[mt.key]:null; var st=(nm&&mt.dir)?_bmStat(mt.value,nm,mt.dir):null; var col=st?_bmStatusCol(st.status):'var(--fg1)'; return '<td style="text-align:right;color:'+col+';font-weight:700">'+mt.value+(unit||'')+(st?' <span style="font-size:11px;color:var(--fg2)">'+_bmZ(st.z)+'</span>':'')+'</td>'; }
  var rows=(hs.metrics||[]).map(function(m){ var cm=cmap[m.key]; return '<tr><td>'+m.label+'</td>'+cell(m,m.unit)+cell(cm,m.unit)+'</tr>'; }).join('');
  return '<div class="card" style="grid-column:1 / -1"><h3>두 선수 비교 — '+hs.label+'</h3>'
   +'<table class="ev-table"><thead><tr><th>변인</th><th style="text-align:right">'+hostNm+'</th><th style="text-align:right;color:'+_CMP_COL+'">'+cp.name+'</th></tr></thead><tbody>'+rows+'</tbody></table>'
   +'<div class="note" style="margin-top:6px">색=엘리트 규준 대비 상태(강점·정상·교정), 괄호=±σ. 아래 시계열에 '+cp.name+' 곡선이 <b style="color:'+_CMP_COL+'">보라 점선</b>으로 겹쳐집니다.</div></div>'; }
// ══════════════════════════════════════════════════════════════════
// 와인드업(에너지 모음) 동적 스틱 게이지 — 프리뷰 통합 (★스틱/해부학 시각 원칙)
//   ① 골반 닫힘각 = 위에서 본(탑뷰) 골반 회전 스틱
//   ② 뒷발 지면반력 꼬임 토크 = 발 외곽선 + 자유모멘트 동적 원
//   ③ 힙 힌지 = 측면(시상면) 스틱(뒷고관절에 앉는 자세)
//   데이터는 _fastTrial()/_slowTrial() 의 .frames(원본 X,Y,Z)+.series 에서 즉석 생성.
// ══════════════════════════════════════════════════════════════════
var _WG = {
  data:null, idx:0, winStart:0, winEnd:0, playing:true, raf:null, acc:0, spIdx:2,
  SPEEDS:[0.1,0.25,0.5,1,2],
  STL:{ strong:['강점','var(--green)','rgba(70,201,140,.16)'],
        normal:['정상','var(--cyan)','rgba(91,182,230,.16)'],
        flag:['교정','var(--amber)','rgba(232,149,78,.16)'] },
  GA:[
    {key:'pelClose',type:'top',  title:'골반 닫힘각', unit:'°',   color:'#6db4e6', note:'위에서 본 골반 회전(우투 기준). 셋업(점선) 대비 골반선이 돌아간 각=닫힘. 초록 부채꼴=엘리트 범위.'},
    {key:'freeMo',  type:'foot', title:'뒷발 지면반력 꼬임 토크', unit:'N·m', color:'#5bb6e6', note:'뒷발(외곽선) 위 자유모멘트(CoP 발 중앙 고정). 원 크기=토크 크기, 색=방향(파랑 꼬임−·주황 열림+). 초록 점선 링=엘리트 코일.'},
    {key:'hipHinge',type:'stick',title:'힙 힌지(뒷고관절 굴곡)', unit:'°',   color:'#46c98c', note:'뒷고관절에 앉는 측면 자세. 굽히면(앉으면) 굴곡↑. 초록 호=엘리트 정상범위.'}
  ],
  BONES:[['head','neck'],['neck','pelvis_o'],['r_shoulder','l_shoulder'],['r_shoulder','r_elbow'],['r_elbow','r_wrist'],['l_shoulder','l_elbow'],['l_elbow','l_wrist'],['pelvis_o','r_hip'],['pelvis_o','l_hip'],['r_hip','r_knee'],['r_knee','r_heel'],['r_heel','r_toe'],['l_hip','l_knee'],['l_knee','l_heel'],['l_heel','l_toe']],
  TBONES:[['head','neck'],['neck','pelvis_o'],['l_shoulder','r_shoulder'],['l_shoulder','l_elbow'],['l_elbow','l_wrist'],['r_shoulder','r_elbow'],['r_elbow','r_wrist'],['l_hip','l_knee'],['l_knee','l_heel'],['r_hip','r_knee'],['r_knee','r_heel']],
  footImg:null, footReady:false
};
_WG.RHP=function(){ return ((_WG.data&&_WG.data.handed)||'R').toUpperCase()!=='L'; };
_WG.ghostOn=function(){ try{ return !!(playback&&playback.isCompare&&playback.isCompare()); }catch(e){ return false; } };  // 느린공 잔상 = 왼쪽 「두 트라이얼 비교」 모드일 때만
_WG.statusOf=function(key,v){ var n=_WG.data.norms[key]; if(v==null||!n)return 'normal'; if(v>=n.p75)return 'strong'; if(v<=n.p25)return 'flag'; return 'normal'; };
_WG.build=function(){
  if(typeof _fastTrial!=='function') return null;
  var fast=_fastTrial(), slow;
  // 게이지 잔상(ghost) 소스: 선수 비교 모드면 상대 선수의 가장 빠른 트라이얼(프레임 포함), 아니면 본인 느린공
  if(typeof _cmpOn!=='undefined' && _cmpOn){ var _ct=(typeof _cmpTrial==='function')?_cmpTrial():null; slow=(_ct&&_ct.frames&&_ct.frames.length)?_ct:((typeof _slowTrial==='function')?_slowTrial():null); }
  else { slow=(typeof _slowTrial==='function')?_slowTrial():null; }
  if(!fast||!fast.frames||!fast.frames.length) return null;
  var RHP=((DATA&&DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L';
  var J=['head','neck','r_shoulder','l_shoulder','r_elbow','l_elbow','r_wrist','l_wrist','pelvis_o','r_hip','l_hip','r_knee','l_knee','r_heel','l_heel','r_toe','l_toe'];
  function sv(a){ for(var i=0;i<a.length;i++) if(isFinite(a[i])) return a[i]; return 0; }
  function dtOf(t){ return (t.setup&&t.setup.dt)||(t.meta&&t.meta.dt)||0.00333; }
  function buildSeries(t){
    var S=t.series||{}, e={kl:(t.events&&t.events.i_kl_peak)||0, fc:(t.events&&t.events.i_fc), br:(t.events&&t.events.i_br)};
    var pz=S.Pelvis_Angle_Z||[], fp=S.FP1_Z_3||[], bh=S.Back_Hip_Angle_X||[], tz=S.Trunk_Angle_Z||[];
    var fpy=S.FP1_Y||[], cvy=S.COM_Velocity_Y||[], bhy=S.Back_Hip_Angle_Y||[], fz1=S.FP1_Z||[], fz2=S.FP2_Z||[], bhp=S.Back_Hip_Power_X||[], bkp=S.Back_Knee_Power_X||[], gly=S.FP2_Y||[];
    var xfs=t.x_factor||[], merS=S.Pitching_Shoulder_Angle_Z||[], scS=S.Pitching_Shoulder_Angle_X||[], txS=S.Trunk_Angle_X||[];
    var W=((DATA&&DATA.player&&DATA.player.weight_kg)||86)*9.81;
    var len=Math.max(pz.length,(t.frames?t.frames.length:0));
    var N=Math.min((e.br!=null?e.br:(e.fc!=null?e.fc:len-1))+10, len-1);
    var ps=sv(pz), ts=sv(tz), dt=dtOf(t), time=[],pelC=[],trC=[],free=[],hinge=[],stick=[],top=[],comF=[],rprop=[],cvel=[],habd=[],impAcc=[],wkAcc=[],_imp=0,_wk=0,lgrf=[],apbk=[],gz2=[],gy2=[],xfv=[],merv=[],scv=[],lbv=[],opv=[];
    // 프레임은 [수평0, 수직(index1), 수평1] Y-up(buildFrames). 측면(시상면) 스틱 = [전진 수평축, 수직축].
    // 전진축 = 수평 2축(0/2) 중 골반 변위 범위가 큰 축(스트라이드=홈 방향). 표준 Z-up 익스포트면 index2(Y).
    var fwdIdx=2, fwdSign=1; (function(){ var a0=[],a2=[]; for(var k=0;k<=N;k++){ var f=t.frames&&t.frames[k]; var pv=f&&(f.pelvis_o||f.com); if(pv){ if(isFinite(pv[0]))a0.push(pv[0]); if(isFinite(pv[2]))a2.push(pv[2]); } } function rng(a){ return a.length?(Math.max.apply(null,a)-Math.min.apply(null,a)):0; } if(rng(a0)>rng(a2)) fwdIdx=0;
      var fst=null,lst=null; for(var k2=0;k2<=N;k2++){ var f2=t.frames&&t.frames[k2]; var pv2=f2&&(f2.pelvis_o||f2.com); if(pv2&&isFinite(pv2[fwdIdx])){ if(fst==null)fst=pv2[fwdIdx]; lst=pv2[fwdIdx]; } } if(fst!=null&&lst!=null&&lst<fst) fwdSign=-1;
    })();
    for(var i=0;i<=N;i++){
      time.push(Math.round((i-e.kl)*dt*1000));
      pelC.push(isFinite(pz[i])?Math.round((RHP?(pz[i]-ps):(ps-pz[i]))*10)/10:null);
      trC.push(isFinite(tz[i])?Math.round((RHP?(tz[i]-ts):(ts-tz[i]))*10)/10:null);
      free.push(isFinite(fp[i])?Math.round(fp[i]*10)/10:null);
      hinge.push(isFinite(bh[i])?Math.round(bh[i]*10)/10:null);
      rprop.push(isFinite(fpy[i])?Math.round(fpy[i]/W*1000)/10:null);
      cvel.push(isFinite(cvy[i])?Math.round(cvy[i]*100)/100:null);
      habd.push((i>0&&isFinite(bhy[i])&&isFinite(bhy[i-1]))?Math.round((bhy[i]-bhy[i-1])/dt):null);
      if(i>=e.kl){ if(isFinite(fpy[i])&&fpy[i]>0)_imp+=(fpy[i]/W*100)*dt; var _pw=(isFinite(bhp[i])?bhp[i]:0)+(isFinite(bkp[i])?bkp[i]:0); if(_pw>0)_wk+=_pw*dt; }
      impAcc.push(Math.round(_imp*100)/100); wkAcc.push(Math.round(_wk*10)/10);
      lgrf.push(isFinite(fz2[i])?Math.round(fz2[i]/W*100*10)/10:null); apbk.push(isFinite(gly[i])?Math.round(Math.abs(gly[i])/W*100*10)/10:null); gz2.push(isFinite(fz2[i])?Math.round(fz2[i]):null); gy2.push(isFinite(gly[i])?Math.round(gly[i]):null);
      xfv.push(isFinite(xfs[i])?Math.round(xfs[i]*10)/10:null); merv.push(isFinite(merS[i])?Math.round(merS[i]):null); scv.push(isFinite(scS[i])?Math.round(Math.abs(scS[i])):null); lbv.push(isFinite(txS[i])?Math.round(-txS[i]):null); opv.push(isFinite(tz[i])?Math.round(RHP?(90-tz[i]):(tz[i]-90)):null);
      var fr=(t.frames&&t.frames[i])||{}, o={}, o2={};
      J.forEach(function(j){ var p=fr[j]; if(p){ if(isFinite(p[fwdIdx])&&isFinite(p[1])) o[j]=[Math.round(p[fwdIdx]),Math.round(p[1])]; if(isFinite(p[0])&&isFinite(p[1])&&isFinite(p[2])) o2[j]=[Math.round(p[0]),Math.round(p[1]),Math.round(p[2])]; } });
      var cm=fr.com; comF.push((cm&&isFinite(cm[0])&&isFinite(cm[1])&&isFinite(cm[2]))?[Math.round(cm[0]),Math.round(cm[1]),Math.round(cm[2])]:null);
      stick.push(o); top.push(o2);
    }
    // ── 스무딩(중앙 이동평균, WIN 프레임) — 마커리스 노이즈 완화 ──
    var WIN=7;
    function _sm(a){ if(!a||a.length<3)return a; var h=WIN>>1,o=a.slice(); for(var i=0;i<a.length;i++){ var s=0,c2=0; for(var k=i-h;k<=i+h;k++){ if(k<0||k>=a.length)continue; var v=a[k]; if(v==null||!isFinite(v))continue; s+=v;c2++; } o[i]=c2?s/c2:a[i]; } return o; }
    function _rnd(a,p){ return a.map(function(v){return (v==null||!isFinite(v))?v:Math.round(v*p)/p;}); }
    function _smF(arr,dim){ var keys={}; arr.forEach(function(o){for(var k in o)keys[k]=1;}); Object.keys(keys).forEach(function(k){ for(var d=0;d<dim;d++){ var ser=arr.map(function(o){return (o[k]&&isFinite(o[k][d]))?o[k][d]:null;}); var sm=_sm(ser); arr.forEach(function(o,i){ if(o[k]&&sm[i]!=null)o[k][d]=Math.round(sm[i]); }); } }); }
    pelC=_rnd(_sm(pelC),10); trC=_rnd(_sm(trC),10); free=_rnd(_sm(free),10); hinge=_rnd(_sm(hinge),10); rprop=_rnd(_sm(rprop),10); cvel=_rnd(_sm(cvel),100); habd=_rnd(_sm(habd),1);
    lgrf=_rnd(_sm(lgrf),10); apbk=_rnd(_sm(apbk),10); gz2=_rnd(_sm(gz2),1); gy2=_rnd(_sm(gy2),1);
    xfv=_rnd(_sm(xfv),10); merv=_rnd(_sm(merv),1); scv=_rnd(_sm(scv),1); lbv=_rnd(_sm(lbv),1); opv=_rnd(_sm(opv),1);
    _smF(stick,2); _smF(top,3);
    for(var ci=0;ci<3;ci++){ var cs=comF.map(function(o){return (o&&isFinite(o[ci]))?o[ci]:null;}); var csm=_sm(cs); comF.forEach(function(o,i){ if(o&&csm[i]!=null)o[ci]=Math.round(csm[i]); }); }
    function _pkIdx(a){ var bi=null,bv=-Infinity; for(var pi=e.kl;pi<=N&&pi<a.length;pi++){var x=a[pi]; if(x==null||!isFinite(x))continue; if(x>bv){bv=x;bi=pi;}} return bi; }
    var _rpI=_pkIdx(fz1), _lpI=_pkIdx(fz2);
    var rearPk=(_rpI!=null)?Math.round((_rpI-e.kl)*dt*1000):null, leadPk=(_lpI!=null)?Math.round((_lpI-e.kl)*dt*1000):null;
    return {ev:{kl:0, fc:(e.fc!=null?Math.round((e.fc-e.kl)*dt*1000):null), br:(e.br!=null?Math.round((e.br-e.kl)*dt*1000):null), rearPk:rearPk, leadPk:leadPk}, time:time, pelClose:pelC, trunkClose:trC, freeMo:free, hipHinge:hinge, stick:stick, top:top, comF:comF, rearProp:rprop, comVel:cvel, hipAbd:habd, propImpPct:impAcc, driveWork:wkAcc, leadGrf:lgrf, apBrake:apbk, gz2:gz2, gy2:gy2, xfPeak:xfv, merPk:merv, scapLoad:scv, leanBack:lbv, openAng:opv, fwd:fwdIdx, fwdSign:fwdSign};
  }
  function peaksOf(ser){
    var kh=ser.time.indexOf(0); if(kh<0) kh=ser.time.length-1;
    function mx(a,neg){ var v=-Infinity; for(var i=0;i<=kh&&i<a.length;i++){ var x=a[i]; if(x==null||!isFinite(x))continue; if(neg)x=-x; if(x>v)v=x; } return v===-Infinity?null:Math.round(v*10)/10; }
    return { pelClose:mx(ser.pelClose,false), freeMo:mx(ser.freeMo,RHP), hipHinge:mx(ser.hipHinge,false) };
  }
  var fsr=buildSeries(fast), ssr=(slow&&slow.frames&&slow.frames.length)?buildSeries(slow):null;
  var NM=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS:{};
  return {
    player:(DATA&&DATA.player&&DATA.player.name)||'', handed:(DATA&&DATA.player&&DATA.player.handedness)||'R',
    norms:{ pelClose:NM.pelClose||{p25:18.6,med:33.4,p75:46}, freeMo:NM.freeMo||{p25:5.5,med:9.6,p75:14.6}, hipHinge:NM.hipHinge||{p25:17.6,med:27.2,p75:33.8}, rearProp:NM.rearProp||{p25:67.5,med:75.4,p75:88.4}, comVel:NM.comVel||{p25:2.6,med:2.7,p75:2.8}, hipAbd:NM.hipAbd||{p25:91.2,med:189.5,p75:294.7}, propImpPct:NM.propImpPct||{p25:8,med:14,p75:20}, driveWork:NM.driveWork||{p25:31.8,med:123.1,p75:162.4}, leadGrf:NM.leadGrf||{p25:226,med:249,p75:272}, apBrake:NM.apBrake||{p25:141,med:163,p75:185}, kneeAbs:NM.kneeAbs||{p25:218,med:271,p75:324}, kneeAbsE:NM.kneeAbsE||{p25:29.6,med:43,p75:51}, kneeExtROM:NM.kneeExtROM||{p25:22,med:33,p75:44} },
    fast:{series:fsr, vals:peaksOf(fsr)},
    slow:ssr?{series:ssr, vals:peaksOf(ssr)}:null
  };
};
_WG.panelHTML=function(){
  var D=_WG.data; if(!D) return '';
  // [2026-05-26] 데이터 없는(예: Uplift=GRF/채널부재로 null) 게이지는 제외. 남는 게 없으면 패널 자체 생략.
  var _ga=_WG.GA.filter(function(G){ return D.fast && D.fast.vals && D.fast.vals[G.key]!=null && D.norms && D.norms[G.key]; });
  if(!_ga.length) return '';
  var h='<div class="card" style="grid-column:1 / -1">'
   +'<h3>동적 스틱 게이지 <span class="sub2">실데이터 · 왼쪽 풀바디 스틱 재생에 동기화</span></h3>'
   +'<div class="note" style="margin:6px 0 12px">왼쪽 풀바디 스틱을 재생/이동하면 이 게이지가 같은 프레임으로 함께 움직입니다(처음~FC 구간). 느린 공 잔상은 왼쪽 「두 트라이얼 비교」를 켜면 나타납니다.</div>'
   +'<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">';
  _ga.forEach(function(G){
    var n=D.norms[G.key], fpk=D.fast.vals[G.key], spk=D.slow?D.slow.vals[G.key]:null;
    var st=_WG.statusOf(G.key,fpk), sl=_WG.STL[st];
    h+='<div style="background:var(--bg2);border:1px solid var(--line);border-left:4px solid '+sl[1]+';border-radius:10px;padding:12px">'
     +'<div style="font-size:14px;font-weight:800;margin-bottom:2px">'+G.title+'</div>'
     +'<div class="sub2" style="min-height:50px;margin-bottom:6px">'+G.note+'</div>'
     +'<canvas id="wgcv-'+G.key+'" style="width:100%;height:200px;display:block"></canvas>'
     +'<div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:6px;font-size:12px;color:var(--fg1)"><span>현재 <span style="font-size:20px;font-weight:800;color:'+G.color+'" id="wg-now-'+G.key+'">–</span> '+G.unit+'</span><span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:'+sl[2]+';color:'+sl[1]+'">'+sl[0]+'</span></div>'
     +'<div class="sub2" style="margin-top:3px">빠른공 정점 <b style="color:'+G.color+'">'+(fpk!=null?fpk:'–')+'</b>'+(spk!=null?' · 느린공 '+spk:'')+' · 엘리트 '+n.p25+'–'+n.p75+' '+G.unit+'</div>'
     +'</div>';
  });
  h+='</div></div>';
  return h;
};
// ── 측면 스틱(힙 힌지) ──
_WG.drawStick=function(G,cvId){
  var D=_WG.data, idx=_WG.idx, RHP=_WG.RHP();
  var cv=document.getElementById(cvId||('wgcv-'+G.key)); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=200;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var BACKB=RHP?{r_hip:1,r_knee:1,r_heel:1,r_toe:1}:{l_hip:1,l_knee:1,l_heel:1,l_toe:1};
  function isBack(b){return BACKB[b[0]]&&BACKB[b[1]];}
  var S_SIDE=0.088, fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1, heelK=RHP?'r_heel':'l_heel';
  function fig(fr,col,lead,alpha,lw){ if(!fr)return; var an=fr[heelK]||fr.pelvis_o; if(!an)return; var ax=W*0.5, ay=H-16;
    function P(j){var p=fr[j]; return p?[ax+(p[0]-an[0])*S_SIDE*fSign, ay-(p[1]-an[1])*S_SIDE]:null;}
    c.globalAlpha=alpha; _WG.BONES.forEach(function(b){var a=P(b[0]),d=P(b[1]); if(!a||!d)return; c.strokeStyle=isBack(b)?col:lead; c.lineWidth=isBack(b)?lw+0.8:lw; c.lineCap='round'; c.beginPath(); c.moveTo(a[0],a[1]); c.lineTo(d[0],d[1]); c.stroke();});
    var hipK=RHP?'r_hip':'l_hip', knK=RHP?'r_knee':'l_knee'; [hipK,knK].forEach(function(j){var p=P(j); if(p){c.fillStyle=col;c.beginPath();c.arc(p[0],p[1],3.2,0,7);c.fill();}});
    var hd=P('head'); if(hd){c.fillStyle=col;c.beginPath();c.arc(hd[0],hd[1]-3,5,0,7);c.fill();}
    var hp=P(hipK),kn=P(knK),nk=P('neck'); if(hp&&kn&&nk){var a1=Math.atan2(nk[1]-hp[1],nk[0]-hp[0]),a2=Math.atan2(kn[1]-hp[1],kn[0]-hp[0]); c.globalAlpha=alpha*0.9;c.strokeStyle=col;c.lineWidth=2;c.beginPath();c.arc(hp[0],hp[1],16,Math.min(a1,a2),Math.max(a1,a2));c.stroke();} c.globalAlpha=1; }
  c.strokeStyle='#2a3340';c.lineWidth=1;c.beginPath();c.moveTo(8,H-16);c.lineTo(W-8,H-16);c.stroke();
  // 느린공 잔상은 비교 모드일 때만(ghostOn). 평소엔 빠른공 단일(깔끔).
  if(_WG.ghostOn()&&D.slow){var sk=D.slow.series.stick;var si=Math.min(idx,sk.length-1);fig(sk[si],'#6b7686','#3a4757',0.5,2.2);}
  fig(D.fast.series.stick[idx],'#46c98c','#5a6678',1,3);
};
// ── 탑뷰 스틱(골반 닫힘) ──
_WG.drawTop=function(G,cvId){
  var D=_WG.data, idx=_WG.idx, RHP=_WG.RHP(), LAT=RHP?-1:1, S_TOP=0.165;
  var cv=document.getElementById(cvId||('wgcv-'+G.key)); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=cv.clientHeight||200;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var cx=W*0.5, cy=H*0.5, n=D.norms.pelClose, tp=D.fast.series.top, T=D.fast.series.time;
  // ── 투수판: 투구 방향을 오른쪽으로 통일(다른 측면 스틱과 일관). 투수 뒤(왼쪽)에 세로 막대.
  (function(){
    c.save();
    var rx=W*0.115, rh=24, rw=8;
    c.fillStyle='rgba(205,214,226,0.16)'; c.strokeStyle='#aeb9c8'; c.lineWidth=1.6;
    if(c.roundRect){ c.beginPath(); c.roundRect(rx-rw/2, cy-rh, rw, rh*2, 2); c.fill(); c.stroke(); }
    else { c.fillRect(rx-rw/2, cy-rh, rw, rh*2); c.strokeRect(rx-rw/2, cy-rh, rw, rh*2); }
    c.fillStyle='#8b97a8'; c.font='9px sans-serif'; c.textAlign='center'; c.textBaseline='top';
    c.fillText('투수판', rx, cy+rh+3);
    c.restore();
  })();
  // ── 전신 2D 스틱 탑뷰 — 골반 중심 고정, 화면 가로=전진(투구 방향=오른쪽), 세로=측방(좌투 미러) ──
  var fwd=(D.fast.series.fwd!=null)?D.fast.series.fwd:2, lat=(fwd===0)?2:0, fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1, LATm=RHP?1:-1;
  // 탑뷰 자동 스케일: 골반 기준 최대 관절 변위(전 프레임)에 맞춰 캔버스를 채운다 → 회전이 작은 선수(예: 이영하)도 점으로 뭉개지지 않음.
  var S=0.085; (function(){ var mx=0, tpA=D.fast.series.top||[]; for(var fi=0;fi<tpA.length;fi++){ var o=tpA[fi]; if(!o||!o.pelvis_o)continue; var an=o.pelvis_o; for(var k in o){ var p=o[k]; if(!p||!isFinite(p[fwd])||!isFinite(p[lat]))continue; var df=Math.abs(p[fwd]-an[fwd]), dl=Math.abs(p[lat]-an[lat]); if(df>mx)mx=df; if(dl>mx)mx=dl; } } if(mx>1){ var target=Math.min(W,H)*0.40; S=Math.max(0.05, Math.min(0.32, target/mx)); } })();
  function P(o,anc){ if(!o||!anc)return null; return [ cx + fSign*(o[fwd]-anc[fwd])*S, cy - (o[lat]-anc[lat])*S*LATm ]; }
  // 셋업 골반선(점선 기준): 현재 골반이 셋업 대비 얼마나 돌아갔는지 비교
  (function(){ var o0=tp[0]; if(!o0||!o0.l_hip||!o0.r_hip||!o0.pelvis_o)return; var lh=P(o0.l_hip,o0.pelvis_o),rh=P(o0.r_hip,o0.pelvis_o); if(!lh||!rh)return; var ang=Math.atan2(rh[1]-lh[1],rh[0]-lh[0]),L=44; c.save(); c.strokeStyle='#5a6678'; c.setLineDash([4,3]); c.lineWidth=1.4; c.beginPath(); c.moveTo(cx-Math.cos(ang)*L,cy-Math.sin(ang)*L); c.lineTo(cx+Math.cos(ang)*L,cy+Math.sin(ang)*L); c.stroke(); c.setLineDash([]); c.restore(); })();
  // 전신 탑뷰 스틱. BONES(얇게) + 골반선(주황 굵게)·어깨선(청록) 강조. 골반_o 중심 고정.
  function body(o2,faint,hipcol,shcol,alpha){ if(!o2)return; var anc=o2.pelvis_o; if(!anc)return; c.globalAlpha=alpha; c.lineCap='round';
    _WG.BONES.forEach(function(b){ var a=P(o2[b[0]],anc), d=P(o2[b[1]],anc); if(!a||!d)return; c.strokeStyle=faint; c.lineWidth=2.2; c.beginPath(); c.moveTo(a[0],a[1]); c.lineTo(d[0],d[1]); c.stroke(); });
    var ls=P(o2.l_shoulder,anc),rs=P(o2.r_shoulder,anc); if(ls&&rs){ c.strokeStyle=shcol; c.lineWidth=4; c.beginPath(); c.moveTo(ls[0],ls[1]); c.lineTo(rs[0],rs[1]); c.stroke(); }
    var lh=P(o2.l_hip,anc),rh=P(o2.r_hip,anc); if(lh&&rh){ var _mx=(lh[0]+rh[0])/2,_my=(lh[1]+rh[1])/2,_K=1.5; var _L=[_mx+(lh[0]-_mx)*_K,_my+(lh[1]-_my)*_K],_R=[_mx+(rh[0]-_mx)*_K,_my+(rh[1]-_my)*_K]; c.strokeStyle=hipcol; c.lineWidth=11; c.beginPath(); c.moveTo(_L[0],_L[1]); c.lineTo(_R[0],_R[1]); c.stroke(); c.fillStyle=hipcol; [_L,_R].forEach(function(p){c.beginPath();c.arc(p[0],p[1],5,0,7);c.fill();}); }
    var hd=P(o2.head,anc); if(hd){ c.fillStyle=hipcol; c.beginPath(); c.arc(hd[0],hd[1],4.5,0,7); c.fill(); }
    c.globalAlpha=1; }
  if(_WG.ghostOn()&&D.slow){ var st=D.slow.series.top; if(st){ var si=Math.min(idx,st.length-1); body(st[si],'#33404f','#9a7a4a','#4a5a6e',0.45); } }
  body(tp[Math.min(idx,tp.length-1)], '#5a6678', '#e8954e','#5bb6e6', 1);
  // 범례(하단 — 좌상단 수치 오버레이와 겹치지 않게)
  c.font='10px system-ui';c.textAlign='left';c.textBaseline='bottom';c.fillStyle='#e8954e';c.fillText('● 골반',6,H-4);c.fillStyle='#5bb6e6';c.fillText('● 어깨',54,H-4);
};
// ── 뒷발(고정 외곽선 SVG) + 자유모멘트 동적 원(꼬임 토크) ──
_WG.twistArrow=function(c,x,y,r,coil,col){
  var a0=-Math.PI*0.5,sweep=Math.PI*1.5,dir=coil?1:-1;
  c.strokeStyle=col;c.lineWidth=2.5;c.beginPath();c.arc(x,y,r,a0,a0+dir*sweep,!coil);c.stroke();
  var ae=a0+dir*sweep,hx=x+r*Math.cos(ae),hy=y+r*Math.sin(ae),tang=ae+dir*Math.PI/2;
  c.fillStyle=col;c.beginPath();c.moveTo(hx,hy);c.lineTo(hx-7*Math.cos(tang-0.4),hy-7*Math.sin(tang-0.4));c.lineTo(hx-7*Math.cos(tang+0.4),hy-7*Math.sin(tang+0.4));c.closePath();c.fill();
};
_WG.FOOT_URI="data:image/svg+xml;base64,";
_WG.initFoot=function(){ if(_WG.footImg) return; var im=new Image(); im.onload=function(){_WG.footReady=true; try{_WG.frame();}catch(e){} try{ if(typeof _redrawWindupCharts==='function' && document.getElementById('edc-wind-mz-stk')) _redrawWindupCharts(); }catch(e){}}; im.src=_WG.FOOT_URI; _WG.footImg=im; };
_WG.drawFoot=function(G,cvId){
  var D=_WG.data, idx=_WG.idx, RHP=_WG.RHP();
  var cv=document.getElementById(cvId||('wgcv-'+G.key)); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=cv.clientHeight||200;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var sw=1400,sh=1000,sc=Math.min(W/sw,H/sh)*0.98,dw=sw*sc,dh=sh*sc,dx=(W-dw)/2,dy=(H-dh)/2;
  // 좌투=뒷발이 왼발 → 오른발 SVG 를 좌우 반전
  if(_WG.footReady&&_WG.footImg){ if(RHP){ c.drawImage(_WG.footImg,dx,dy,dw,dh); } else { c.save(); c.translate(W,0); c.scale(-1,1); c.drawImage(_WG.footImg,dx,dy,dw,dh); c.restore(); } }
  var cpx=RHP?(dx+657*sc):(W-(dx+657*sc)), cpy=dy+537*sc, n=D.norms.freeMo, RS=2.4;
  c.setLineDash([3,3]);[[n.med,'rgba(70,201,140,0.85)'],[n.p75,'rgba(70,201,140,0.5)']].forEach(function(e){c.strokeStyle=e[1];c.lineWidth=1.3;c.beginPath();c.arc(cpx,cpy,e[0]*RS,0,7);c.stroke();});c.setLineDash([]);
  if(_WG.ghostOn()&&D.slow){var sk=D.slow.series.freeMo;var si=Math.min(idx,sk.length-1);var smz=sk[si];if(smz!=null){var sr=Math.min(60,Math.abs(smz)*RS);c.strokeStyle='#8b97a8';c.lineWidth=1.5;c.setLineDash([2,3]);c.beginPath();c.arc(cpx,cpy,sr,0,7);c.stroke();c.setLineDash([]);}}
  var mz=D.fast.series.freeMo[idx];
  if(mz!=null){var mag=Math.abs(mz),r=Math.max(4,Math.min(60,mag*RS)),coil=RHP?(mz<0):(mz>0),col=coil?'#e8954e':'#5bb6e6';
    c.globalAlpha=0.30;c.fillStyle=col;c.beginPath();c.arc(cpx,cpy,r,0,7);c.fill();c.globalAlpha=1;
    c.strokeStyle=col;c.lineWidth=2.6;c.beginPath();c.arc(cpx,cpy,r,0,7);c.stroke();
    _WG.twistArrow(c,cpx,cpy,Math.max(14,r+7),coil,col);
    c.fillStyle='#fff';c.beginPath();c.arc(cpx,cpy,3,0,7);c.fill();
    c.fillStyle=col;c.font='bold 11px sans-serif';c.textAlign='center';c.fillText(coil?'꼬임':'풀림',W*0.5,H-6);c.textAlign='left';
  }
};
// 재생 윈도우 = 처음(프레임0) ~ FC. 왼쪽 풀바디 스틱 재생에 동기화(게이지 자체 재생 컨트롤·rAF 없음).
_WG.fcIdx=function(){ var ser=_WG.data&&_WG.data.fast&&_WG.data.fast.series; if(!ser)return 0; var fc=ser.ev.fc; if(fc==null)return ser.time.length-1; var best=ser.time.length-1,bd=Infinity; for(var i=0;i<ser.time.length;i++){var d=Math.abs(ser.time[i]-fc); if(d<bd){bd=d;best=i;}} return best; };
_WG.frame=function(){
  var D=_WG.data; if(!D) return; var ser=D.fast.series;
  _WG.GA.forEach(function(G){
    var fn=(G.type==='stick')?_WG.drawStick:((G.type==='top')?_WG.drawTop:_WG.drawFoot);
    fn(G);                       // (구)상단 패널 캔버스 wgcv-<key> — 존재 시
    fn(G,'wgcv-'+G.key+'-ts');   // 그래프 옆 캔버스 wgcv-<key>-ts
    var nv=ser[G.key][_WG.idx], el=document.getElementById('wg-now-'+G.key); if(el) el.textContent=(nv==null?'–':nv);
  });
};
// 왼쪽 풀바디 스틱의 현재 프레임(_currentFrame)에 맞춰 그림 — 윈도우 [0, FC] 로 클램프.
_WG.syncFrame=function(){
  var D=_WG.data; if(!D) return; var fc=_WG.fcIdx();
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?_currentFrame:fc;
  _WG.idx=Math.max(0,Math.min(fc,Math.round(cf)));
  _WG.frame();
};
_WG.start=function(){
  if(!_WG.data) return;
  _WG.winStart=0; _WG.winEnd=_WG.fcIdx();
  _WG.initFoot();
  _WG.syncFrame();
};

// ══════════════════════════════════════════════════════════════════
// 드라이브(2단계) 동적 스틱 게이지 — 뒷다리로 몸을 홈 방향 추진 (★스틱 시각)
//   ① 뒷발 추진 GRF = 측면 스틱 + 뒷발에서 홈쪽 전진 화살표(rearProp %BW)
//   ② COM 전진 = 탑뷰 스틱 + COM 전진 궤적 + 속도 화살표(comVel)
//   _WG.data(KH~FC+ 프레임·com·rearProp·comVel) 재사용. 창=KH−0.1s ~ FC+0.1s.
// ══════════════════════════════════════════════════════════════════
var _DG = {
  idx:0, i0:0, i1:0, playing:true, raf:null, acc:0, spIdx:2,
  SPEEDS:[0.1,0.25,0.5,1,2],
  STL:_WG.STL,
  GA:[
    {key:'rearProp', type:'side', title:'뒷발 추진 GRF (전진)', cap:'동적 스틱 — 뒷발 추진(측면)', unit:'%BW', color:'#6db4e6', arrowKey:'rearProp', note:'뒷다리로 몸을 미는 지면반력. 화살표=추진 크기. 초록 눈금=엘리트.'},
    {key:'comVel', type:'side', title:'COM 전진 속도', cap:'동적 스틱 — COM 전진(측면)', unit:'m/s', color:'#5bb6e6', arrowKey:'comVel', note:'무게중심이 홈으로 나아가는 속도. 화살표=속도(홈=오른쪽). 초록 눈금=엘리트.'},
    {key:'hipAbd', type:'side', title:'뒷다리 고관절 외전 속도', cap:'동적 스틱 — 측면(뒷다리)', unit:'°/s', color:'#46c98c', arrowKey:null, note:'뒷다리 고관절 외전 각속도. 측면 스틱으로 드라이브 자세를 함께 표시.'},
    {key:'driveWork',type:'side', title:'뒷다리 신전 일', cap:'동적 스틱 — 뒷다리 신전(측면)', unit:'J', color:'#c98cf0', arrowKey:'driveWork', note:'뒷다리(고관절+무릎) 신전이 만든 일의 누적. 화살표=누적 신전일(홈=오른쪽). 초록 눈금=엘리트.'}
  ]
};
_DG.RHP=function(){ return ((_WG.data&&_WG.data.handed)||'R').toUpperCase()!=='L'; };
_DG.ghostOn=function(){ return (typeof _WG!=='undefined'&&_WG.ghostOn)?_WG.ghostOn():false; };
_DG.statusOf=function(key,v){ var n=_WG.data.norms[key]; if(v==null||!n)return 'normal'; if(v>=n.p75)return 'strong'; if(v<=n.p25)return 'flag'; return 'normal'; };
_DG.win=function(){ var T=_WG.data.fast.series.time, ev=_WG.data.fast.series.ev, fc=ev.fc, lp=ev.leadPk; var lo=-100, hi=(lp!=null?lp:(fc!=null?fc:T[T.length-1]))+60; var i0=0,i1=T.length-1; for(var i=0;i<T.length;i++){ if(T[i]>=lo){i0=i;break;} } for(var j=T.length-1;j>=0;j--){ if(T[j]<=hi){i1=j;break;} } if(i1<=i0)i1=T.length-1; return [i0,i1]; };
_DG.peak=function(key){ var a=_WG.data.fast.series[key]; var v=-Infinity; for(var i=_DG.i0;i<=_DG.i1&&i<a.length;i++){ var x=a[i]; if(x==null||!isFinite(x))continue; if(Math.abs(x)>Math.abs(v)||v===-Infinity)v=x; } return v===-Infinity?null:Math.round(v*100)/100; };
_DG.peakSlow=function(key){ if(!_WG.data.slow)return null; var a=_WG.data.slow.series[key]; if(!a)return null; var v=-Infinity; for(var i=_DG.i0;i<=Math.min(_DG.i1,a.length-1);i++){ var x=a[i]; if(x==null||!isFinite(x))continue; if(Math.abs(x)>Math.abs(v)||v===-Infinity)v=x; } return v===-Infinity?null:Math.round(v*100)/100; };
_DG.panelHTML=function(){
  if(!_WG.data) return '';
  // [2026-05-26] 데이터 없는(예: Uplift GRF/채널부재 null) 게이지 제외, 없으면 패널 생략.
  var _ga=_DG.GA.filter(function(G){ return _DG.peak(G.key)!=null && _WG.data.norms && _WG.data.norms[G.key]; });
  if(!_ga.length) return '';
  var w=_DG.win(); _DG.i0=w[0]; _DG.i1=w[1];
  var h='<div class="card" style="grid-column:1 / -1">'
   +'<h3>동적 스틱 게이지 — 드라이브 <span class="sub2">뒷다리→홈 추진 · 실선=빠른 공·점선=느린 공</span></h3>'
   +'<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:8px 0 12px">'
   +'<button class="cp-jump" id="dg-play">⏸ 일시정지</button>'
   +'<input type="range" id="dg-scrub" min="0" max="100" value="0" style="flex:1;min-width:150px;accent-color:var(--cyan)">'
   +'<span class="sub2" id="dg-tl" style="min-width:118px">KH 기준 0 ms</span>'
   +'<button class="cp-jump" id="dg-speed">속도 0.5×</button>'
   +'<label style="font-size:12px;color:var(--fg1)"><input type="checkbox" id="dg-ghost" checked> 느린공 잔상</label>'
   +'</div>'
   +'<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px">';
  _DG.GA.forEach(function(G){
    var n=_WG.data.norms[G.key], fpk=_DG.peak(G.key), spk=_DG.peakSlow(G.key);
    var st=_DG.statusOf(G.key,fpk), sl=_DG.STL[st];
    h+='<div style="background:var(--bg2);border:1px solid var(--line);border-left:4px solid '+sl[1]+';border-radius:10px;padding:12px">'
     +'<div style="font-size:14px;font-weight:800;margin-bottom:2px">'+G.title+'</div>'
     +'<div class="sub2" style="min-height:50px;margin-bottom:6px">'+G.note+'</div>'
     +'<canvas id="dgcv-'+G.key+'" style="width:100%;height:210px;display:block"></canvas>'
     +'<div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:6px;font-size:12px;color:var(--fg1)"><span>현재 <span style="font-size:20px;font-weight:800;color:'+G.color+'" id="dg-now-'+G.key+'">–</span> '+G.unit+'</span><span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:'+sl[2]+';color:'+sl[1]+'">'+sl[0]+'</span></div>'
     +'<div class="sub2" style="margin-top:3px">빠른공 정점 <b style="color:'+G.color+'">'+(fpk!=null?fpk:'–')+'</b>'+(spk!=null?' · 느린공 '+spk:'')+' · 엘리트 '+n.p25+'–'+n.p75+' '+G.unit+'</div>'
     +'</div>';
  });
  h+='</div></div>';
  return h;
};
// ── ① 측면 스틱 + 전진 GRF 화살표 ──
_DG.drawSide=function(G,cvId,idxArg){
  var D=_WG.data, idx=(idxArg!=null)?idxArg:_DG.idx, RHP=_DG.RHP();
  var cv=document.getElementById(cvId||('dgcv-'+G.key)); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=210;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1;  // 전진(홈)이 화면 오른쪽이 되도록
  // 강조 부위(emph): 변인에 맞춰 backleg/leadleg/trunk/arm 중 하나만 밝게, 나머지는 옅게
  var backLeg=RHP?['r_hip','r_knee','r_heel','r_toe']:['l_hip','l_knee','l_heel','l_toe'];
  var leadLeg=RHP?['l_hip','l_knee','l_heel','l_toe']:['r_hip','r_knee','r_heel','r_toe'];
  var trunkJ=['head','neck','pelvis_o','l_shoulder','r_shoulder'];
  var armP=RHP?[['r_shoulder','r_elbow'],['r_elbow','r_wrist']]:[['l_shoulder','l_elbow'],['l_elbow','l_wrist']];
  var _emph=G.emph||(G.lead?'leadleg':'backleg');
  function _inS(a,j){return a.indexOf(j)>=0;}
  function _isArm(b){ return armP.some(function(p){return (p[0]===b[0]&&p[1]===b[1])||(p[0]===b[1]&&p[1]===b[0]);}); }
  function isBack(b){ if(_emph==='trunkarm')return (_inS(trunkJ,b[0])&&_inS(trunkJ,b[1]))||_isArm(b); if(_emph==='trunk')return _inS(trunkJ,b[0])&&_inS(trunkJ,b[1]); if(_emph==='arm')return _isArm(b); if(_emph==='leadleg')return _inS(leadLeg,b[0])&&_inS(leadLeg,b[1]); return _inS(backLeg,b[0])&&_inS(backLeg,b[1]); }
  var S_SIDE=0.088, heelK=(G.lead||_emph==='leadleg')?(RHP?'l_heel':'r_heel'):(RHP?'r_heel':'l_heel');
  var ax=W*0.30, ay=H-18;
  function fig(fr,col,lead,alpha,lw){ if(!fr)return null; var an=fr[heelK]||fr.pelvis_o; if(!an)return null;
    function P(j){var p=fr[j]; return p?[ax+(p[0]-an[0])*S_SIDE*fSign, ay-(p[1]-an[1])*S_SIDE]:null;}
    c.globalAlpha=alpha; _WG.BONES.forEach(function(b){var a=P(b[0]),d=P(b[1]); if(!a||!d)return; c.strokeStyle=isBack(b)?col:lead; c.lineWidth=isBack(b)?lw+0.8:lw; c.lineCap='round'; c.beginPath(); c.moveTo(a[0],a[1]); c.lineTo(d[0],d[1]); c.stroke();});
    var hd=P('head'); if(hd){c.fillStyle=col;c.beginPath();c.arc(hd[0],hd[1]-3,5,0,7);c.fill();}
    c.globalAlpha=1; return [ax,ay]; }
  c.strokeStyle='#2a3340';c.lineWidth=1;c.beginPath();c.moveTo(8,ay);c.lineTo(W-8,ay);c.stroke();
  if(_DG.ghostOn()&&D.slow){var sk=D.slow.series.stick;var si=Math.min(idx,sk.length-1);fig(sk[si],'#6b7686','#3a4757',0.5,2.2);}
  fig(D.fast.series.stick[idx],'#46c98c','#5a6678',1,3);
  // 전진(홈=오른쪽) 화살표 — G.arrowKey 변인 값에 비례. 엘리트 p25/p75 눈금.
  if(G.arrowKey){ var n=D.norms[G.arrowKey], val=(D.fast.series[G.arrowKey]||[])[idx];
    if(n){ var ARS=70/(n.med||1), ox=ax, oy=ay-4;
      c.setLineDash([2,3]);c.strokeStyle='rgba(70,201,140,0.7)';c.lineWidth=1.2;
      [n.p25,n.p75].forEach(function(p){var L=Math.min(150,Math.abs(p)*ARS);c.beginPath();c.moveTo(ox+L,oy-8);c.lineTo(ox+L,oy+8);c.stroke();});c.setLineDash([]);
      if(val!=null&&isFinite(val)){var L=Math.max(0,Math.min(150,Math.abs(val)*ARS)),tx=ox+L;
        c.strokeStyle=G.color;c.fillStyle=G.color;c.lineWidth=4;c.lineCap='round';c.beginPath();c.moveTo(ox,oy);c.lineTo(tx,oy);c.stroke();
        c.beginPath();c.moveTo(tx,oy);c.lineTo(tx-11,oy-6);c.lineTo(tx-11,oy+6);c.closePath();c.fill();} }
  }
  // GRF 합력 벡터(앞발) — 수직(gz2)+제동(gy2 AP) 합쳐 하나의 화살표로. 앞발 위치(ax,ay)에서.
  if(G.grfVec){
    var gz=(D.fast.series.gz2||[])[idx], gy=(D.fast.series.gy2||[])[idx], FSC=0.05, ox2=ax, oy2=ay;
    if(isFinite(gz)||isFinite(gy)){ var vx=ox2+(isFinite(gy)?gy:0)*FSC*fSign, vy=oy2-(isFinite(gz)?gz:0)*FSC;
      c.strokeStyle=G.color;c.fillStyle=G.color;c.lineWidth=4;c.lineCap='round';c.beginPath();c.moveTo(ox2,oy2);c.lineTo(vx,vy);c.stroke();
      var a3=Math.atan2(vy-oy2,vx-ox2);c.beginPath();c.moveTo(vx,vy);c.lineTo(vx-12*Math.cos(a3-0.4),vy-12*Math.sin(a3-0.4));c.lineTo(vx-12*Math.cos(a3+0.4),vy-12*Math.sin(a3+0.4));c.closePath();c.fill();
      c.fillStyle=G.color;c.font='bold 10px sans-serif';c.textAlign='left';c.textBaseline='bottom';c.fillText('합력',vx+3,vy-1);
    }
  }
};
// [2026-05-26] 정면(홈플레이트) 뷰 스틱 — 좌우 밸런스(어깨 외전·어깨 라인 기울기)용. 3D top 프레임을 [lateral,vertical]로 투영.
_DG.drawFront=function(G,cvId,idxArg){
  var D=_WG.data, idx=(idxArg!=null)?idxArg:_DG.idx, RHP=_DG.RHP();
  var cv=document.getElementById(cvId); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=210;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var top=D.fast.series.top||[]; if(!top.length) return;
  var fwd=(D.fast.series.fwd!=null)?D.fast.series.fwd:2, lat=(fwd===0)?2:0;
  var latSign=RHP?1:-1;  // 좌투는 좌우 반전(정면에서 본 좌우 일관)
  var backLeg=RHP?['r_hip','r_knee','r_heel','r_toe']:['l_hip','l_knee','l_heel','l_toe'];
  var leadLeg=RHP?['l_hip','l_knee','l_heel','l_toe']:['r_hip','r_knee','r_heel','r_toe'];
  var trunkJ=['head','neck','pelvis_o','l_shoulder','r_shoulder'];
  var armP=[['r_shoulder','r_elbow'],['r_elbow','r_wrist'],['l_shoulder','l_elbow'],['l_elbow','l_wrist']];
  var _emph=G.emph||'trunk';
  function _inS(a,j){return a.indexOf(j)>=0;}
  function _isArm(b){ return armP.some(function(p){return (p[0]===b[0]&&p[1]===b[1])||(p[0]===b[1]&&p[1]===b[0]);}); }
  function isHot(b){ if(_emph==='trunkarm')return (_inS(trunkJ,b[0])&&_inS(trunkJ,b[1]))||_isArm(b); if(_emph==='trunk')return _inS(trunkJ,b[0])&&_inS(trunkJ,b[1]); if(_emph==='arm')return _isArm(b); if(_emph==='leadleg')return _inS(leadLeg,b[0])&&_inS(leadLeg,b[1]); return _inS(backLeg,b[0])&&_inS(backLeg,b[1]); }
  var fr=top[Math.min(idx,top.length-1)]; if(!fr) return;
  var an=fr.pelvis_o; if(!an){ for(var kk in fr){ an=fr[kk]; break; } } if(!an) return;
  var S=0.082, ax=W*0.5, ay=H-18;
  function P(j){var p=fr[j]; return p?[ax+(p[lat]-an[lat])*S*latSign, ay-(p[1]-an[1])*S]:null;}
  c.strokeStyle='#2a3340';c.lineWidth=1;c.beginPath();c.moveTo(8,ay);c.lineTo(W-8,ay);c.stroke();
  _WG.BONES.forEach(function(b){var a=P(b[0]),d=P(b[1]); if(!a||!d)return; var hot=isHot(b); c.strokeStyle=hot?(G.color||'#46c98c'):'#5a6678'; c.lineWidth=hot?3.6:2.4; c.lineCap='round'; c.beginPath(); c.moveTo(a[0],a[1]); c.lineTo(d[0],d[1]); c.stroke();});
  var hd=P('head'); if(hd){c.fillStyle=(G.color||'#46c98c');c.beginPath();c.arc(hd[0],hd[1]-3,5,0,7);c.fill();}
  c.fillStyle='#7d8898';c.font='9px sans-serif';c.textAlign='center';c.textBaseline='bottom';c.fillText('정면(홈) 뷰',W/2,H-4);
};
// [FIX 0525] 손/전완 강조 줌 뷰 — 투구 팔의 전완·손만 크게 프레이밍(손목 변인 게이지용)
_DG.drawHandZoom=function(G,cvId,idxArg){
  var D=_WG.data; if(!D) return; var idx=(idxArg!=null)?idxArg:_DG.idx, RHP=_DG.RHP();
  var cv=document.getElementById(cvId); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||210, H=220;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1;
  var sk=D.fast.series.stick||[]; var fr=sk[Math.min(idx,sk.length-1)]; if(!fr) return;
  var sh=RHP?'r_shoulder':'l_shoulder', el=RHP?'r_elbow':'l_elbow', wr=RHP?'r_wrist':'l_wrist', ht=RHP?'r_hand_tip':'l_hand_tip';
  var emph=[el,wr,ht].map(function(k){return fr[k];}).filter(Boolean).map(function(p){return [p[0]*fSign,p[1]];});
  if(emph.length<2) return;
  var xs=emph.map(function(p){return p[0];}), ys=emph.map(function(p){return p[1];});
  var minx=Math.min.apply(null,xs),maxx=Math.max.apply(null,xs),miny=Math.min.apply(null,ys),maxy=Math.max.apply(null,ys);
  var spanx=Math.max(40,maxx-minx),spany=Math.max(40,maxy-miny),pad=42;
  var sc=Math.min((W-2*pad)/spanx,(H-2*pad)/spany); if(!isFinite(sc)||sc<=0)sc=0.5;
  var cxm=(minx+maxx)/2, cym=(miny+maxy)/2;
  function P(k){ var p=fr[k]; if(!p)return null; return [W/2+((p[0]*fSign)-cxm)*sc, H/2-((p[1])-cym)*sc]; }
  c.strokeStyle='#2a3340';c.lineWidth=1;c.beginPath();c.moveTo(8,H-12);c.lineTo(W-8,H-12);c.stroke();
  function seg(a,b,col,lw){ var p=P(a),q=P(b); if(!p||!q)return; c.strokeStyle=col;c.lineWidth=lw;c.lineCap='round';c.beginPath();c.moveTo(p[0],p[1]);c.lineTo(q[0],q[1]);c.stroke(); }
  seg(sh,el,'#5a6678',4);            // 상완(옅게)
  seg(el,wr,G.color||'#5bb6e6',7);   // 전완(강조)
  seg(wr,ht,'#f5c542',10);           // 손(가장 크게 강조)
  [[sh,4,'#5a6678'],[el,6,'#9aa6b5'],[wr,8,(G.color||'#5bb6e6')],[ht,9,'#f5c542']].forEach(function(j){var p=P(j[0]);if(!p)return;c.fillStyle=j[2];c.beginPath();c.arc(p[0],p[1],j[1],0,7);c.fill();});
  c.font='10px sans-serif';c.textAlign='center';c.textBaseline='bottom';
  var pw=P(wr),ph=P(ht),pe=P(el);
  if(pe){c.fillStyle='#9aa6b5';c.fillText('팔꿈치',pe[0],pe[1]-8);}
  if(pw){c.fillStyle=(G.color||'#5bb6e6');c.fillText('손목',pw[0],pw[1]-10);}
  if(ph){c.fillStyle='#f5c542';c.fillText('손끝',ph[0],ph[1]-12);}
};
// ── ② 탑뷰 스틱 + COM 전진 궤적 + 속도 화살표 ──
_DG.drawTopCom=function(G,cvId){
  var D=_WG.data, idx=_DG.idx, RHP=_DG.RHP(), LAT=RHP?-1:1, S_TOP=0.10;
  var cv=document.getElementById(cvId||('dgcv-'+G.key)); if(!cv) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=210;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var ref=D.fast.series.comF[_DG.i0]||D.fast.series.top[_DG.i0]&&D.fast.series.top[_DG.i0].pelvis_o; if(!ref)ref=[0,0,0];
  var cx=W*0.26, cy=H*0.5;
  function projT(p){return [cx+(p[1]-ref[1])*S_TOP, cy-(p[0]-ref[0])*S_TOP*LAT];}
  // 홈 방향 안내(우측)
  c.strokeStyle='#2a3340';c.setLineDash([3,4]);c.lineWidth=1;c.beginPath();c.moveTo(cx,8);c.lineTo(cx,H-8);c.stroke();c.setLineDash([]);
  // (홈 방향 표시 제거)
  // COM 궤적 (i0..idx)
  var comF=D.fast.series.comF;
  c.strokeStyle='#cfe';c.globalAlpha=0.5;c.setLineDash([2,3]);c.lineWidth=1.5;c.beginPath();var started=false;
  for(var k=_DG.i0;k<=idx;k++){var cm=comF[k];if(!cm)continue;var pp=projT(cm);if(!started){c.moveTo(pp[0],pp[1]);started=true;}else c.lineTo(pp[0],pp[1]);}
  c.stroke();c.setLineDash([]);c.globalAlpha=1;
  // 스틱(탑뷰, 어깨·골반 강조)
  function figT(fr,hipcol,faint,alpha){if(!fr)return;
    function P(j){var p=fr[j];return p?projT(p):null;}
    c.globalAlpha=alpha;c.lineCap='round';
    _WG.TBONES.forEach(function(b){var a=P(b[0]),d=P(b[1]);if(!a||!d)return;var sh=(b[0].indexOf('shoulder')>=0&&b[1].indexOf('shoulder')>=0);c.strokeStyle=sh?'#5bb6e6':faint;c.lineWidth=sh?3:2.2;c.beginPath();c.moveTo(a[0],a[1]);c.lineTo(d[0],d[1]);c.stroke();});
    var lh=P('l_hip'),rh=P('r_hip');if(lh&&rh){c.strokeStyle=hipcol;c.lineWidth=6;c.beginPath();c.moveTo(lh[0],lh[1]);c.lineTo(rh[0],rh[1]);c.stroke();}
    c.globalAlpha=1;}
  if(_DG.ghostOn()&&D.slow){var st=D.slow.series.top;var si=Math.min(idx,st.length-1);figT(st[si],'#9a7a4a','#3a4757',0.45);}
  figT(D.fast.series.top[idx],'#e8954e','#5a6678',1);
  // 현재 COM 점 + 전진 속도 화살표
  var cm=comF[idx];
  if(cm){var pp=projT(cm);c.fillStyle='#fff';c.beginPath();c.arc(pp[0],pp[1],4,0,7);c.fill();
    var v=D.fast.series.comVel[idx], n=D.norms.comVel;
    if(v!=null&&isFinite(v)){var VS=46, L=Math.max(0,Math.min(120,v*VS)),tx=pp[0]+L;
      c.strokeStyle=G.color;c.fillStyle=G.color;c.lineWidth=3.5;c.beginPath();c.moveTo(pp[0],pp[1]);c.lineTo(tx,pp[1]);c.stroke();
      c.beginPath();c.moveTo(tx,pp[1]);c.lineTo(tx-10,pp[1]-5);c.lineTo(tx-10,pp[1]+5);c.closePath();c.fill();
      // 엘리트 med 링(반경=med 속도*VS)
      c.setLineDash([3,3]);c.strokeStyle='rgba(70,201,140,0.6)';c.lineWidth=1.2;c.beginPath();c.arc(pp[0],pp[1],n.med*VS,0,7);c.stroke();c.setLineDash([]);}
  }
};
_DG.drawTrace2=function(G){
  try{
  var cv=document.getElementById('dgts2-'+G.key); if(!cv||!_WG.data) return;
  var ser=_WG.data.fast.series, a=ser[G.key]; if(!a) return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=62;
  cv.width=W*dpr; cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var i0=_DG.i0, i1=_DG.i1; if(i1<=i0) i1=a.length-1;
  var lo=Infinity,hi=-Infinity,k; for(k=i0;k<=i1&&k<a.length;k++){ var v=a[k]; if(v==null||!isFinite(v))continue; if(v<lo)lo=v; if(v>hi)hi=v; }
  if(!isFinite(lo)||!isFinite(hi)) return; if(hi-lo<1e-6){hi=lo+1;lo=lo-1;}
  var pL=4,pR=4,pT=8,pB=8, pw=W-pL-pR, ph=H-pT-pB;
  function X(i){ return pL+(i-i0)/((i1-i0)||1)*pw; } function Y(v){ return pT+ph-(v-lo)/((hi-lo)||1)*ph; }
  if(lo<0&&hi>0){ c.strokeStyle='rgba(154,167,182,.28)'; c.lineWidth=1; c.beginPath(); c.moveTo(pL,Y(0)); c.lineTo(W-pR,Y(0)); c.stroke(); }
  var t=ser.time, ev=ser.ev||{}, fc=ev.fc;
  if(t&&fc!=null){ var jb=-1,bd=1e9; for(k=i0;k<=i1&&k<t.length;k++){ var d=Math.abs(t[k]-fc); if(d<bd){bd=d;jb=k;} } if(jb>=0){ c.strokeStyle='rgba(91,211,255,.45)'; c.lineWidth=1; c.setLineDash([2,2]); c.beginPath(); var fx=X(jb); c.moveTo(fx,0); c.lineTo(fx,H); c.stroke(); c.setLineDash([]); } }
  c.strokeStyle=(G.color||'#5bd3ff'); c.lineWidth=1.6; c.lineJoin='round'; c.beginPath(); var st=false;
  for(k=i0;k<=i1&&k<a.length;k++){ var vv=a[k]; if(vv==null||!isFinite(vv)){ st=false; continue; } var x=X(k),y=Y(vv); if(!st){ c.moveTo(x,y); st=true; } else c.lineTo(x,y); }
  c.stroke();
  var ix=Math.max(i0,Math.min(i1,_DG.idx)), cx=X(ix);
  c.strokeStyle='#e8edf4'; c.lineWidth=1.4; c.beginPath(); c.moveTo(cx,0); c.lineTo(cx,H); c.stroke();
  var cvv=a[_DG.idx]; if(cvv!=null&&isFinite(cvv)){ c.fillStyle='#e8edf4'; c.beginPath(); c.arc(cx,Y(cvv),2.6,0,7); c.fill(); }
  }catch(e){}
};
_DG.frame=function(){
  if(!_WG.data) return; var ser=_WG.data.fast.series;
  _DG.GA.forEach(function(G){
    if(G.type==='side')_DG.drawSide(G,'dgcv-'+G.key+'-ts'); else if(G.type==='topcom')_DG.drawTopCom(G,'dgcv-'+G.key+'-ts');
    var _gs=ser[G.key], nv=_gs?_gs[_DG.idx]:null, el=document.getElementById('dg-now-'+G.key); if(el) el.textContent=(nv==null?'–':nv); try{_DG.drawTrace2(G);}catch(e){}
  });
  // 발자국+CoP 궤적+스트라이드(길이·방향) 동적 시각화 — 스트라이드 길이/시간 그래프 대체
  try{ var ft=_fastTrial(); if(ft && document.getElementById('dgcv-copgrf')) drawCopGrf(ft,_DG.idx,(typeof _slowTrial==='function'?_slowTrial():null),'dgcv-copgrf',true); }catch(e){}
};
_DG.syncFrame=function(){
  if(!_WG.data) return; var w=_DG.win(); _DG.i0=w[0]; _DG.i1=w[1];
  var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):_DG.i1;
  _DG.idx=Math.max(_DG.i0,Math.min(_DG.i1,cf));
  _DG.frame();
};
_DG.start=function(){
  if(!_WG.data) return; var w=_DG.win(); _DG.i0=w[0]; _DG.i1=w[1];
  _DG.syncFrame();
};

// ══ 블로킹(착지·제동) 게이지 — 앞다리 측면 스틱(_DG.drawSide 재사용, lead=true) + GRF 합력 + COM 가로바 ══
var _BG={ idx:0, i0:0, i1:0,
  GA:[
    {key:'kneeExtROM', cap:'동적 스틱 — 앞무릎 신전(측면)', unit:'°',   color:'#5bb6e6', lead:true},
    {key:'kneeAbs',    cap:'동적 스틱 — 앞무릎 버팀(측면)', unit:'N·m', color:'#6db4e6', lead:true},
    {key:'kneeAbsE',   cap:'동적 스틱 — 앞무릎 흡수(측면)', unit:'J',   color:'#c084fc', lead:true},
    {key:'leadGrf',    cap:'동적 스틱 — 앞발 GRF 합력(측면)', unit:'%BW', color:'#46c98c', lead:true, grfVec:true}
  ]
};
_BG.win=function(){ var T=_WG.data.fast.series.time, ev=_WG.data.fast.series.ev, fc=ev.fc, br=ev.br; var lo=(fc!=null?fc:0)-100, hi=(br!=null?br:T[T.length-1])+60; var i0=0,i1=T.length-1; for(var i=0;i<T.length;i++){if(T[i]>=lo){i0=i;break;}} for(var j=T.length-1;j>=0;j--){if(T[j]<=hi){i1=j;break;}} if(i1<=i0)i1=T.length-1; return [i0,i1]; };
_BG.peak=function(key){ var a=_WG.data.fast.series[key]; if(!a)return null; var v=-Infinity; for(var i=_BG.i0;i<=_BG.i1&&i<a.length;i++){var x=a[i]; if(x==null||!isFinite(x))continue; if(Math.abs(x)>Math.abs(v)||v===-Infinity)v=x;} return v===-Infinity?null:Math.round(v*100)/100; };
_BG.drawComBar=function(){ var cv=document.getElementById('bgcv-combar'); if(!cv)return; var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=120; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var cvy=_WG.data.fast.series.comVel; if(!cvy)return; var m=((DATA&&DATA.player&&DATA.player.weight_kg)||86);
  var vpk=-Infinity; for(var i=_BG.i0;i<=_BG.i1&&i<cvy.length;i++){var v=cvy[i]; if(isFinite(v)&&v>vpk)vpk=v;} if(vpk===-Infinity)vpk=0;
  var cur=(cvy[_BG.idx]!=null&&isFinite(cvy[_BG.idx]))?cvy[_BG.idx]:vpk; var dP=m*(cur-vpk);
  var cx=W*0.5, cy=H*0.5, maxAbs=(m*vpk)||1, SC=(W*0.44)/maxAbs;
  c.strokeStyle='#3a4452';c.lineWidth=1;c.beginPath();c.moveTo(cx,10);c.lineTo(cx,H-24);c.stroke();
  c.fillStyle='#7d8898';c.font='9px sans-serif';c.textAlign='center';c.textBaseline='top'; c.fillText('감소 ←',cx-W*0.24,H-20); c.fillText('→ 증가',cx+W*0.24,H-20);
  var L=Math.max(-W*0.46,Math.min(W*0.46,dP*SC)); c.fillStyle=L<0?'#e07a78':'#46c98c'; var bx=L<0?cx+L:cx; c.fillRect(bx,cy-15,Math.abs(L),30);
  c.fillStyle='#e8ecf2';c.font='bold 14px sans-serif';c.textAlign='center';c.textBaseline='bottom'; c.fillText(Math.round(dP)+' kg·m/s', cx, cy-19); };
_BG.frame=function(){ if(!_WG.data)return; var ser=_WG.data.fast.series;
  _BG.GA.forEach(function(G){ _DG.drawSide(G,'bgcv-'+G.key+'-ts',_BG.idx); var s=ser[G.key], nv=s?s[_BG.idx]:null, el=document.getElementById('bg-now-'+G.key); if(el)el.textContent=(nv==null?'–':nv); });
  try{ if(document.getElementById('bgcv-combar')) _BG.drawComBar(); }catch(e){}
  try{ if(document.getElementById('bgcv-comke-ts')) _DG.drawSide({key:'comVel',color:'#5bb6e6',emph:'leadleg',lead:true},'bgcv-comke-ts',_BG.idx); }catch(e){} };
_BG.syncFrame=function(){ if(!_WG.data)return; var w=_BG.win(); _BG.i0=w[0]; _BG.i1=w[1]; var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):_BG.i1; _BG.idx=Math.max(_BG.i0,Math.min(_BG.i1,cf)); _BG.frame(); };
_BG.start=function(){ if(!_WG.data)return; var w=_BG.win(); _BG.i0=w[0]; _BG.i1=w[1]; _BG.syncFrame(); };
// 비교 모드(빠른-느린 또는 선수) 여부 + 잔상 라벨 + 느린/상대 피크(게이지 윈도우 기준)
function _cmpActive(){ try{ return !!(playback&&playback.isCompare&&playback.isCompare()); }catch(e){ return false; } }
function _cmpLabel(){ try{ if(typeof _cmpOn!=='undefined'&&_cmpOn){ var p=(typeof _cmpPlayer==='function')?_cmpPlayer():null; return (p&&p.name)?p.name:'상대'; } }catch(e){} return '느린공'; }
function _gaugeSlowPeak(key,i0,i1){ try{ var D=_WG.data; if(!D||!D.slow||!D.slow.series)return null; var a=D.slow.series[key]; if(!a)return null; var v=-Infinity, lo=(i0!=null?i0:0), hi=(i1!=null?i1:a.length-1); for(var i=lo;i<=hi&&i<a.length;i++){var x=a[i]; if(x!=null&&isFinite(x)&&(v===-Infinity||Math.abs(x)>Math.abs(v)))v=x;} return v===-Infinity?null:Math.round(v*100)/100; }catch(e){ return null; } }
function _bgGaugeColHTML(G, extraLine){
  var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[G.key]:null;
  var fpk=(typeof _BG!=='undefined'&&_BG.peak)?_BG.peak(G.key):null, spk=_cmpActive()?_gaugeSlowPeak(G.key,_BG.i0,_BG.i1):null;
  return '<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">'+(G.cap||'')+'</div>'
   +'<canvas id="bgcv-'+G.key+'-ts" style="width:100%;height:230px;display:block"></canvas>'
   +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:'+G.color+'" id="bg-now-'+G.key+'">–</span> '+(G.unit||'')+'</div>'
   +'<div class="sub2" style="text-align:center;margin-top:2px">빠른공 정점 <b style="color:'+G.color+'">'+(fpk!=null?fpk:'–')+'</b>'+(spk!=null?' · <b style="color:#9aa6b4">'+_cmpLabel()+' '+spk+'</b>':'')+(nm?' · 엘리트 '+nm.p25+'–'+nm.p75+' '+(G.unit||''):'')+(extraLine?'<br>'+extraLine:'')+'</div></div>';
}
// ══ 에너지 저장(착지~코킹) 게이지 — 탑뷰(X-Factor·견갑골·몸통열림) + 측면(어깨MER·뒤젖힘) ══
var _SG={ idx:0, i0:0, i1:0,
  GA:[
    {key:'xfPeak',  view:'top',  cap:'동적 스틱 — X-Factor(위에서 봄·골반↔어깨)', unit:'°', color:'#6db4e6'},
    {key:'merPk',   view:'side', cap:'동적 스틱 — 어깨 MER(측면·투구팔)',         unit:'°', color:'#5bb6e6', emph:'arm', lead:true},
    {key:'scapLoad',view:'top',  cap:'동적 스틱 — 견갑골 로딩(위에서 봄·투구팔)', unit:'°', color:'#46c98c', emph:'arm'},
    {key:'leanBack',view:'side', cap:'동적 스틱 — 몸통 뒤젖힘(측면·몸통)',        unit:'°', color:'#9aa7b6', emph:'trunk', lead:true},
    {key:'openAng', view:'top',  cap:'동적 스틱 — 몸통 열림(위에서 봄)',          unit:'°', color:'#c084fc'}
  ]
};
_SG.win=function(){ var T=_WG.data.fast.series.time, ev=_WG.data.fast.series.ev, fc=ev.fc, br=ev.br; var lo=(fc!=null?fc:0)-100, hi=(br!=null?br:T[T.length-1])+60; var i0=0,i1=T.length-1; for(var i=0;i<T.length;i++){if(T[i]>=lo){i0=i;break;}} for(var j=T.length-1;j>=0;j--){if(T[j]<=hi){i1=j;break;}} if(i1<=i0)i1=T.length-1; return [i0,i1]; };
_SG.peak=function(key){ var a=_WG.data.fast.series[key]; if(!a)return null; var v=-Infinity; for(var i=_SG.i0;i<=_SG.i1&&i<a.length;i++){var x=a[i]; if(x==null||!isFinite(x))continue; if(Math.abs(x)>Math.abs(v)||v===-Infinity)v=x;} return v===-Infinity?null:Math.round(v*10)/10; };
// 탑뷰 전신 스틱(골반선·어깨선 강조) — 홈=오른쪽. X-Factor=두 선의 벌어짐, 몸통 열림=어깨선 방향.
_SG.drawTopBody=function(G,cvId,idx){
  var D=_WG.data, RHP=_DG.RHP(); var cv=document.getElementById(cvId); if(!cv)return;
  var dpr=window.devicePixelRatio||1, W=cv.clientWidth||240, H=210; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  var cx=W*0.5, cy=H*0.5, tp=D.fast.series.top;
  var fwd=(D.fast.series.fwd!=null)?D.fast.series.fwd:2, lat=(fwd===0)?2:0, fSign=(D.fast.series.fwdSign!=null)?D.fast.series.fwdSign:1, S=0.085, LATm=RHP?1:-1;
  function P(o,anc){ if(!o||!anc)return null; return [cx+fSign*(o[fwd]-anc[fwd])*S, cy-(o[lat]-anc[lat])*S*LATm]; }
  function body(o2,faint,hipcol,shcol,headcol,alpha){ if(!o2)return; var anc=o2.pelvis_o; if(!anc)return; c.globalAlpha=alpha; c.lineCap='round';
    _WG.BONES.forEach(function(b){var a=P(o2[b[0]],anc),d=P(o2[b[1]],anc); if(!a||!d)return; c.strokeStyle=faint; c.lineWidth=2.2; c.beginPath();c.moveTo(a[0],a[1]);c.lineTo(d[0],d[1]);c.stroke();});
    if(G.emph==='arm'){ var _ap=RHP?[['r_shoulder','r_elbow'],['r_elbow','r_wrist']]:[['l_shoulder','l_elbow'],['l_elbow','l_wrist']]; _ap.forEach(function(pr){var aa=P(o2[pr[0]],anc),dd=P(o2[pr[1]],anc); if(aa&&dd){c.strokeStyle=shcol;c.lineWidth=4.5;c.beginPath();c.moveTo(aa[0],aa[1]);c.lineTo(dd[0],dd[1]);c.stroke();}}); }
    var ls=P(o2.l_shoulder,anc),rs=P(o2.r_shoulder,anc); if(ls&&rs){c.strokeStyle=shcol;c.lineWidth=5;c.beginPath();c.moveTo(ls[0],ls[1]);c.lineTo(rs[0],rs[1]);c.stroke();c.fillStyle=shcol;[ls,rs].forEach(function(p){c.beginPath();c.arc(p[0],p[1],3.2,0,7);c.fill();});}
    var lh=P(o2.l_hip,anc),rh=P(o2.r_hip,anc); if(lh&&rh){c.strokeStyle=hipcol;c.lineWidth=7;c.beginPath();c.moveTo(lh[0],lh[1]);c.lineTo(rh[0],rh[1]);c.stroke();c.fillStyle=hipcol;[lh,rh].forEach(function(p){c.beginPath();c.arc(p[0],p[1],3.5,0,7);c.fill();});}
    var hd=P(o2.head,anc); if(hd){c.fillStyle=headcol;c.beginPath();c.arc(hd[0],hd[1],4.5,0,7);c.fill();}
    c.globalAlpha=1; }
  if(_DG.ghostOn()&&D.slow){var st=D.slow.series.top; if(st){var si=Math.min(idx,st.length-1);body(st[si],'#33404f','#9a7a4a','#4a5a6e','#6b7686',0.45);}}
  body(tp[Math.min(idx,tp.length-1)],'#5a6678','#e8954e','#5bb6e6','#e8954e',1);
  c.font='10px system-ui';c.textAlign='left';c.textBaseline='top';c.fillStyle='#e8954e';c.fillText('● 골반',6,6);c.fillStyle='#5bb6e6';c.fillText('● 어깨',54,6);
};
_SG.frame=function(){ if(!_WG.data)return; var ser=_WG.data.fast.series;
  _SG.GA.forEach(function(G){ if(G.view==='side')_DG.drawSide(G,'sgcv-'+G.key+'-ts',_SG.idx); else _SG.drawTopBody(G,'sgcv-'+G.key+'-ts',_SG.idx); var s=ser[G.key], nv=s?s[_SG.idx]:null, el=document.getElementById('sg-now-'+G.key); if(el)el.textContent=(nv==null?'–':nv); }); };
_SG.syncFrame=function(){ if(!_WG.data)return; var w=_SG.win(); _SG.i0=w[0]; _SG.i1=w[1]; var cf=(typeof _currentFrame!=='undefined'&&_currentFrame!=null)?Math.round(_currentFrame):_SG.i1; _SG.idx=Math.max(_SG.i0,Math.min(_SG.i1,cf)); _SG.frame(); };
_SG.start=function(){ if(!_WG.data)return; var w=_SG.win(); _SG.i0=w[0]; _SG.i1=w[1]; _SG.syncFrame(); };
function _sgGaugeColHTML(G){
  var nm=(typeof BIOMOTION_NORMS!=='undefined')?BIOMOTION_NORMS[G.key]:null;
  var fpk=(typeof _SG!=='undefined'&&_SG.peak)?_SG.peak(G.key):null, spk=_cmpActive()?_gaugeSlowPeak(G.key,_SG.i0,_SG.i1):null;
  return '<div style="width:210px;max-width:100%"><div class="sub2" style="text-align:center;margin-bottom:2px">'+(G.cap||'')+'</div>'
   +'<canvas id="sgcv-'+G.key+'-ts" style="width:100%;height:220px;display:block"></canvas>'
   +'<div style="text-align:center;margin-top:4px;font-size:12px;color:var(--fg1)">현재 <span style="font-size:20px;font-weight:800;color:'+G.color+'" id="sg-now-'+G.key+'">–</span> '+(G.unit||'')+'</div>'
   +'<div class="sub2" style="text-align:center;margin-top:2px">빠른공 정점 <b style="color:'+G.color+'">'+(fpk!=null?fpk:'–')+'</b>'+(spk!=null?' · <b style="color:#9aa6b4">'+_cmpLabel()+' '+spk+'</b>':'')+(nm?' · 엘리트 '+nm.p25+'–'+nm.p75+' '+(G.unit||''):'')+'</div></div>';
}
// ══ 상체 가속(release) 게이지 — 회전속도 3개(가로바) + ME 수직바 2개 + 팔꿈치 파워 스틱 ══
var _RG={ idx:0,i0:0,i1:0 };
_RG.win=function(){ var T=_WG.data.fast.series.time, ev=_WG.data.fast.series.ev, fc=ev.fc, br=ev.br; var lo=(fc!=null?fc:0)-100, hi=(br!=null?br:T[T.length-1])+60; var i0=0,i1=T.length-1; for(var i=0;i<T.length;i++){if(T[i]>=lo){i0=i;break;}} for(var j=T.length-1;j>=0;j--){if(T[j]<=hi){i1=j;break;}} if(i1<=i0)i1=T.length-1; return [i0,i1]; };
_RG.sval=function(arr,idx){ if(!arr)return null; var s=0,n=0; for(var k=idx-3;k<=idx+3;k++){ if(k<0||k>=arr.length)continue; var v=arr[k]; if(v==null||!isFinite(v))continue; s+=Math.abs(v);n++; } return n?s/n:null; };
// 비교 대상 트라이얼(선수 비교=상대 / 빠른-느린=본인 느린공) — 막대 게이지 병기용
function _cmpSlowTrial(){ try{ if(typeof _cmpOn!=='undefined'&&_cmpOn){ var ct=(typeof _cmpTrial==='function')?_cmpTrial():null; return (ct&&ct.series)?ct:null; } if(_cmpActive()&&typeof _slowTrial==='function'){ return _slowTrial(); } }catch(e){} return null; }
_RG.slowVal=function(key,ftFc){ var st=_cmpSlowTrial(); if(!st||!st.series||!st.series[key])return null; var sidx=((st.events&&st.events.i_fc!=null)?st.events.i_fc:0)+(_RG.idx-(ftFc||0)); return _RG.sval(st.series[key],sidx); };
_RG.SPD=[{key:'Pelvis_Ang_Vel_Z',label:'골반',color:'#6db4e6',med:636},{key:'Thorax_Ang_Vel_Z',label:'몸통',color:'#5bb6e6',med:1067},{key:'Pitching_Shoulder_Ang_Vel_Z',label:'팔',color:'#46c98c',med:4628}];
_RG.drawSpeed3=function(ft){ var cv=document.getElementById('rgcv-speed3'); if(!cv)return; var dpr=window.devicePixelRatio||1,W=cv.clientWidth||300,H=150; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H); var S=ft.series||{};
  var cmp=_cmpActive(), ftFc=(ft.events&&ft.events.i_fc)||0;
  _RG.SPD.forEach(function(sp,i){ var v=_RG.sval(S[sp.key],_RG.idx)||0, mx=sp.med*1.5, f=Math.max(0,Math.min(1,v/mx)); var rowH=H/3, bx=58, bw=W-bx-92, by0=i*rowH, fe=Math.max(0,Math.min(1,sp.med/mx));
    c.fillStyle='#a9b4c2';c.font='12px system-ui';c.textAlign='right';c.textBaseline='middle';c.fillText(sp.label,bx-8,by0+rowH*0.42);
    var sv=cmp?_RG.slowVal(sp.key,ftFc):null;
    if(sv!=null){ var bh=rowH*0.24, gap=4, byF=by0+rowH*0.18, byS=byF+bh+gap, sf=Math.max(0,Math.min(1,sv/mx));
      c.fillStyle='#243043';c.fillRect(bx,byF,bw,bh); c.fillStyle=sp.color;c.fillRect(bx,byF,bw*f,bh);
      c.fillStyle='#243043';c.fillRect(bx,byS,bw,bh); c.fillStyle='#9aa6b4';c.fillRect(bx,byS,bw*sf,bh);
      c.strokeStyle='rgba(70,201,140,0.9)';c.lineWidth=2;c.beginPath();c.moveTo(bx+bw*fe,byF-2);c.lineTo(bx+bw*fe,byS+bh+2);c.stroke();
      c.font='bold 12px system-ui';c.textAlign='left';c.textBaseline='middle'; c.fillStyle=sp.color;c.fillText(Math.round(v),bx+bw+6,byF+bh/2); c.fillStyle='#9aa6b4';c.fillText(Math.round(sv),bx+bw+6,byS+bh/2);
    } else { var bh2=rowH*0.32, by=by0+rowH*0.28;
      c.fillStyle='#243043';c.fillRect(bx,by,bw,bh2); c.fillStyle=sp.color;c.fillRect(bx,by,bw*f,bh2);
      c.strokeStyle='rgba(70,201,140,0.9)';c.lineWidth=2;c.beginPath();c.moveTo(bx+bw*fe,by-2);c.lineTo(bx+bw*fe,by+bh2+2);c.stroke();
      c.fillStyle=sp.color;c.font='bold 15px system-ui';c.textAlign='left';c.textBaseline='middle';c.fillText(Math.round(v)+'°/s',bx+bw+6,by+bh2/2);
    }
  }); };
_RG.ME=[{key:'Trunk_ME_X',label:'몸통 ME',color:'#5bb6e6',med:588},{key:'Pitching_Humerus_ME_X',label:'상완 ME',color:'#6db4e6',med:207}];
_RG.drawME2=function(ft){ var cv=document.getElementById('rgcv-me2'); if(!cv)return; var dpr=window.devicePixelRatio||1,W=cv.clientWidth||180,H=230; cv.width=W*dpr;cv.height=H*dpr; var c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H); var S=ft.series||{};
  var cmp=_cmpActive(), ftFc=(ft.events&&ft.events.i_fc)||0;
  _RG.ME.forEach(function(b,i){ var v=_RG.sval(S[b.key],_RG.idx)||0, mx=b.med*1.7, f=Math.max(0,Math.min(1,v/mx)); var cx0=W*(0.27+i*0.46), by=20, bh=H-56, fe=Math.max(0,Math.min(1,b.med/mx));
    var sv=cmp?_RG.slowVal(b.key,ftFc):null;
    if(sv!=null){ var bw=W*0.13, gap=5, bxF=cx0-bw-gap/2, bxS=cx0+gap/2, sf=Math.max(0,Math.min(1,sv/mx));
      c.fillStyle='#243043';c.fillRect(bxF,by,bw,bh); c.fillStyle=b.color;c.fillRect(bxF,by+bh*(1-f),bw,bh*f);
      c.fillStyle='#243043';c.fillRect(bxS,by,bw,bh); c.fillStyle='#9aa6b4';c.fillRect(bxS,by+bh*(1-sf),bw,bh*sf);
      c.strokeStyle='rgba(70,201,140,0.9)';c.setLineDash([3,2]);c.lineWidth=1.4;c.beginPath();c.moveTo(bxF-2,by+bh*(1-fe));c.lineTo(bxS+bw+2,by+bh*(1-fe));c.stroke();c.setLineDash([]);
      c.font='bold 13px system-ui';c.textAlign='center';c.textBaseline='bottom'; c.fillStyle=b.color;c.fillText(Math.round(v),bxF+bw/2,by-2); c.fillStyle='#9aa6b4';c.fillText(Math.round(sv),bxS+bw/2,by-2);
      c.fillStyle='#a9b4c2';c.font='10px system-ui';c.textBaseline='top';c.fillText(b.label,cx0,by+bh+6);
    } else { var bw2=W*0.26, bx=cx0-bw2/2;
      c.fillStyle='#243043';c.fillRect(bx,by,bw2,bh); c.fillStyle=b.color;c.fillRect(bx,by+bh*(1-f),bw2,bh*f);
      c.strokeStyle='rgba(70,201,140,0.9)';c.setLineDash([3,2]);c.lineWidth=1.4;c.beginPath();c.moveTo(bx-3,by+bh*(1-fe));c.lineTo(bx+bw2+3,by+bh*(1-fe));c.stroke();c.setLineDash([]);
      c.fillStyle=b.color;c.font='bold 16px system-ui';c.textAlign='center';c.textBaseline='bottom';c.fillText(Math.round(v),bx+bw2/2,by-2);
      c.fillStyle='#a9b4c2';c.font='10px system-ui';c.textBaseline='top';c.fillText(b.label,bx+bw2/2,by+bh+6);
    }
  }); };
