  } }catch(e){}
  // [2026-05-29] X-factor 풀림 카드(ed-xf-3)에 탑뷰 분리 게이지 주입 — 풀림(분리각 닫힘) 재생 연동
  try{ if(typeof _WG!=='undefined'){ if(!_WG.data) _WG.data=_WG.build();
