        _c3.style.cssText='font-size:11px;text-align:center;color:var(--fg2);margin-top:2px';
        var _rs=(F&&F.releaseStartMs!=null)?('FC'+(F.releaseStartMs>=0?'+':'')+F.releaseStartMs+'ms'):'\u2013';
        var _rv=(F&&F.releasePeakVel!=null)?(Math.round(F.releasePeakVel)+'\u00b0/s'):'\u2013';
        _c3.innerHTML='\ud0d1\ubdf0: \ubd84\ub9ac\uac01\uc774 <b style=\"color:#46c98c\">\ud480\ub9ac\ub294</b> \ubaa8\uc2b5 \u00b7 \ud480\ub9bc \uc2dc\uc791 <b>'+_rs+'</b> \u00b7 \ud480\ub9bc \uc18d\ub3c4 <b>'+_rv+'</b>';
        _s3.parentNode.insertBefore(_c3,_s3.nextSibling);
