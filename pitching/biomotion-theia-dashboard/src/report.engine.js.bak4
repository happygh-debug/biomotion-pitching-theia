// Uplift PDF 피겨(이준우 본인 리포트) — 다크테마용 배경제거본. window.IE_FIGS 로 노출.
window.IE_FIGS = {
  windup: "data:image/png;base64,",
  drive: "data:image/png;base64,",
  footplant: "data:image/png;base64,",
  rotation: "data:image/png;base64,",
  release: "data:image/png;base64,",
};
// ═══════════════════════════════════════════════════════════════════
// BPR Theia v0.3 — Multi-tab + 3D Stick (21 landmark) + Coach + GRF
// self-contained: 전역 THREE(UMD) + THREE.OrbitControls 사용 (import 없음)
// ═══════════════════════════════════════════════════════════════════
const OrbitControls = THREE.OrbitControls;

const DATA = JSON.parse(document.getElementById('bpr-data').textContent);
// 데이터 가용성 플래그 (Uplift 리포트는 GRF/Power/부상모멘트 없음 → 해당 탭/패널 자동 숨김)
const _t0 = (DATA.trials && DATA.trials[0]) || {};
const HAS_GRF = !!_t0.grf;
const HAS_POWER = !!(_t0.series && Object.keys(_t0.series).some(k => /_Power_/.test(k)));
// [2026-05-27] 에너지 전달 진단(etdiag) 계산 — GRF+관절파워(Theia) 있을 때만.
var ETDIAG = null; try { if (typeof etDiag !== 'undefined' && HAS_GRF && HAS_POWER) ETDIAG = etDiag.compute(DATA); } catch (e) { console.warn('etdiag compute', e); }
// [2026-05-26] Uplift Session·비효율 탭용 상수 (이전 빌드에서 미정의 → 탭 클릭 시 크래시하던 버그 수정).
// REF_RANGES=키네매틱 시퀀스 참고범위(리포트 기존 norm과 일관). IE_*/비효율 = 표준 투구 비효율 10분류.
const REF_RANGES = {
  pelvis_peak:  { range:[600,800],  unit:'°/s' },
  trunk_peak:   { range:[900,1200], unit:'°/s' },
  arm_peak:     { range:[4000,5500],unit:'°/s' },
  speed_gain:   { range:[1.3,1.8],  unit:'×' },
  x_factor_max: { range:[24,37],    unit:'°' },
  stride_pct:   { range:[80,90],    unit:'%' }
};
const PHASE_LABELS = { wind_up:'와인드업·다리들기', foot_contact:'착지(Foot Contact)', ball_release:'릴리스(Ball Release)' };
const IE_DEFS = {
  sway:                 { ko:'스웨이', en:'Sway', def:'드라이브 전 체중이 1·3루(측면) 방향으로 흔들려 추진 방향이 어긋남.', good:'축발 위에 안정적으로 적재됨.', fix:'다리 들 때 골반을 포수 방향 수직 위로 유지.' },
  hanging_back:         { ko:'행잉 백', en:'Hanging Back', def:'체중이 뒤에 남아 무게중심 전진·추진이 부족함.', good:'체중이 홈 방향으로 잘 이동함.', fix:'FC까지 무게중심을 홈 방향으로 적극 이동.' },
  closing_front_or_back:{ ko:'조기 닫힘', en:'Closing Early', def:'골반·몸통이 너무 일찍 닫히거나 과도하게 열려 분리 타이밍이 어긋남.', good:'골반-상체 분리 타이밍이 적절함.', fix:'골반을 마지막까지 닫아두고 상체와의 분리를 유지.' },
  flying_open:          { ko:'조기 열림', en:'Flying Open', def:'FC 전 골반·몸통이 홈쪽으로 일찍 열려 X-Factor(분리) 손실.', good:'FC까지 닫힌 자세를 유지함.', fix:'앞발 착지까지 가슴·골반을 닫아 분리 에너지 유지.' },
  late_rise:            { ko:'늦은 팔 상승', en:'Late Arm', def:'FC 시점에 투구팔이 충분히 올라오지 않아 타이밍이 늦음.', good:'FC에 팔이 정상 높이에 위치함.', fix:'드라이브 중 팔을 제때 들어 하체와 타이밍을 맞춤.' },
  getting_out_in_front: { ko:'상체 과전진', en:'Getting Out Front', def:'릴리스 전 상체가 앞으로 과도하게 빠져 회전축이 무너짐.', good:'안정적 회전축을 유지함.', fix:'앞무릎 위에서 회전하고 머리를 앞다리 위로 안정화.' },
  knee_collapse:        { ko:'앞무릎 붕괴', en:'Knee Collapse', def:'착지 후 앞무릎이 무너져 블로킹(제동) 효과가 손실됨.', good:'앞다리를 단단히 버팀.', fix:'앞다리 신전·버팀(블로킹)을 강화.' },
  high_hand:            { ko:'손 높음', en:'High Hand', def:'FC 시 손 위치가 비정상적으로 높아 팔-하체 타이밍이 어긋남.', good:'손 위치·타이밍이 적절함.', fix:'팔 스윙 타이밍을 하체 회전과 동기화.' },
  early_release:        { ko:'조기 릴리스', en:'Early Release', def:'공을 너무 일찍 놓아 말단 가속이 손실됨.', good:'릴리스 타이밍이 적절함.', fix:'레이백·전완 가속을 끝까지 유지한 뒤 릴리스.' },
  forearm_flyout:       { ko:'전완 플라이아웃', en:'Forearm Flyout', def:'레이백에서 전완이 벌어져(과도한 외반) 어깨·팔꿈치 부하가 증가함.', good:'전완 정렬이 양호함.', fix:'팔꿈치 높이·전완 정렬을 유지해 관절 부하를 줄임.' }
};
const IE_PHASES = [
  { key:'wind_up',      ko:'와인드업·다리들기', en:'Wind-up', desc:'축발 적재·코일 — 추진 방향 정렬', fig:'wind_up',      keys:['sway','hanging_back','closing_front_or_back'] },
  { key:'foot_contact', ko:'착지', en:'Foot Contact', desc:'분리 유지·팔 타이밍·앞다리 블로킹', fig:'foot_contact', keys:['flying_open','late_rise','high_hand','knee_collapse'] },
  { key:'ball_release', ko:'릴리스', en:'Ball Release', desc:'말단 가속·전완 정렬·릴리스 타이밍', fig:'ball_release', keys:['getting_out_in_front','early_release','forearm_flyout'] }
];
const INEFFICIENCY_INFO = (function(){ var o={}; IE_PHASES.forEach(function(ph){ ph.keys.forEach(function(k){ var d=IE_DEFS[k]||{}; o[k]={ label:(d.ko||k), description:(d.def||''), phase:ph.key }; }); }); return o; })();
const fmt0 = v => v==null||!isFinite(v) ? '—' : Math.round(v).toString();
const fmt1 = v => v==null||!isFinite(v) ? '—' : v.toFixed(1);
const fmt2 = v => v==null||!isFinite(v) ? '—' : v.toFixed(2);

// ★ v0.4: 차트 ↔ 재생 sync 전역 상태
let _currentFrame = 0;

// ── Trial dropdown ─────────────────────────────────────────────────
const sel = document.getElementById('trial-select');
const _fastIdx = (function(){ let bi=null,bv=-1; DATA.trials.forEach((t,i)=>{ const v=t.rapsodo&&t.rapsodo.velocity_kmh; if(v!=null&&v>bv){bv=v;bi=i;} }); return bi!=null?bi:((DATA.best_trial_index||1)-1); })();
DATA.trials.forEach((t, i) => {
  const o = document.createElement('option');
  o.value = i;
  const _r = t.rapsodo || {};
  let label = _r.velocity_kmh
    ? `${_r.velocity_kmh.toFixed(1)} km/h · ${_r.total_spin_rpm?Math.round(_r.total_spin_rpm)+' rpm':'회전수 —'}`
    : `구속 미측정`;
  if (i === _fastIdx) label += ' ★';
  o.textContent = label;
  sel.appendChild(o);
});
sel.value = _fastIdx;
sel.addEventListener('change', () => { renderTrialSpecific(parseInt(sel.value)); });
// ── 라이브 그래프 (스틱 옆, 재생 동기화) ──
var LC_SIGNALS = [
  {label:'몸통 회전 속도', unit:'각속도 (°/s)', color:'#5bd3ff', compute:function(t){return t.series.Thorax_Ang_Vel_Z;}},
  {label:'골반 회전 속도', unit:'각속도 (°/s)', color:'#3ecf8e', compute:function(t){return t.series.Pelvis_Ang_Vel_Z;}},
  {label:'팔 회전 속도', unit:'각속도 (°/s)', color:'#4a90c8', compute:function(t){var a=t.series.Pitching_Shoulder_Ang_Vel_Z; return a?a.map(function(v){return -v;}):null;}},
  {label:'X-Factor (골반-어깨 분리)', unit:'각도 (°)', color:'#9aa7b6', compute:function(t){return t.x_factor;}},
  {label:'COM 전진 속도', unit:'속도 (m/s)', color:'#3ecf8e', compute:function(t){return t.series.COM_Velocity_Y;}},
  {label:'앞발 수직 GRF', unit:'힘 (N)', color:'#5bd3ff', compute:function(t){return t.series.FP2_Z;}},
  {label:'뒷발 추진력', unit:'힘 (N)', color:'#86a8d0', compute:function(t){return t.series.FP1_Y;}},
  {label:'어깨 외회전(ER)', unit:'각도 (°)', color:'#4a90c8', compute:function(t){return t.series.Pitching_Shoulder_Angle_Z;}},
  {label:'앞무릎 각도', unit:'각도 (°)', color:'#5bd3ff', compute:function(t){return t.series.Lead_Knee_Angle_X;}},
  {label:'팔꿈치 각도', unit:'각도 (°)', color:'#9aa7b6', compute:function(t){return t.series.Pitching_Elbow_Angle_X;}}
];
// 라이브 그래프 신호 목록을 7단계 메카닉 변인에서 자동 생성(단계=optgroup, _FC_SER 시계열 기준).
function _liveSignals(){
  var P=(typeof DATA!=='undefined')?DATA.phases:null, out=[];
  if(P&&P.stages){ P.stages.forEach(function(st){
    if(st.key==='consistency') return;
    (st.metrics||[]).forEach(function(m){
      var cfg=(m.key&&typeof _FC_SER!=='undefined')?_FC_SER[m.key]:null; if(!cfg) return;
      out.push({label:m.label, unit:m.unit||'', color:cfg.c, compute:cfg.fn, lines:cfg.lines, phase:st.label});
    });
  }); }
  return out.length?out:LC_SIGNALS;
}
function renderLiveChart(){
  if(!document.getElementById('lc-canvas')) return;
  var SIG=_liveSignals();
  var lcs=document.getElementById('lc-sel'); var i=lcs?(parseInt(lcs.value)||0):0; var sig=SIG[i]||SIG[0];
  var lines=sig.lines?sig.lines.map(function(l){return {compute:l.fn,color:l.c,label:l.label,width:2.4};})
    :[{compute:sig.compute, color:sig.color, label:sig.label, width:2.6}];
  plotWin('lc-canvas', {fast:_fastTrial(), slow:_slowTrial(), startEv:'i_kl_peak', startOff:-0.1, endEv:'i_br', endOff:0.2,
    left:{label:sig.unit, lines:lines}});
}
if(typeof window!=='undefined'){ window.renderLiveChart=renderLiveChart; window._liveSignals=_liveSignals; }



// ── Tab handler ────────────────────────────────────────────────────
const tabs = document.querySelectorAll('.tab[data-page]');
const pages = document.querySelectorAll('section.page');
function setPage(id) {
  // [2026-05-28 V2] 선수 요약/코칭 뷰 떠날 때 입양된 ed-body 원위치 복원
  if(id!=='psummary'&&id!=='coach-view'){ try{ _cvRestoreAll(); }catch(e){} }
  tabs.forEach(t => t.classList.toggle('active', t.dataset.page === id));
  pages.forEach(p => p.classList.toggle('visible', p.id === 'page-' + id));
  try{ if(typeof _initGlobalTransport==='function') _initGlobalTransport(); }catch(e){}
  // [2026-05-28] 코칭 뷰 → 진단 점프 후 돌아가는 플로팅 버튼 (ed-* 페이지에서만 표시)
  try {
    var back = document.getElementById('_cv_back_btn');
    if (!back) {
      back = document.createElement('button');
      back.id = '_cv_back_btn';
      back.textContent = '← 코칭 뷰로';
      back.onclick = function(){ setPage('coach-view'); };
      back.style.cssText = 'position:fixed;top:96px;right:14px;z-index:120;background:var(--bg2,#1a2030);color:var(--cyan,#5bd3ff);border:1.5px solid var(--cyan,#5bd3ff);border-radius:8px;padding:7px 14px;cursor:pointer;font-size:12px;font-weight:700;box-shadow:0 3px 10px rgba(0,0,0,.4)';
      back.onmouseenter = function(){ this.style.background='var(--cyan,#5bd3ff)'; this.style.color='#06202b'; };
      back.onmouseleave = function(){ this.style.background='var(--bg2,#1a2030)'; this.style.color='var(--cyan,#5bd3ff)'; };
      document.body.appendChild(back);
    }
    back.style.display = 'none';  // [2026-05-29] 코칭 뷰 버튼 삭제
  } catch(e) {}
  // 캔버스 redraw (탭 hidden 일 때는 0×0 이므로)
  renderTrialSpecific(parseInt(sel.value), id);
}
tabs.forEach(t => t.addEventListener('click', () => setPage(t.dataset.page)));

// ═══════════════════════════════════════════════════════════════════
// Chart helpers (axes + events + multi-line)
// ═══════════════════════════════════════════════════════════════════
function clearC(canvas) {
  const dpr = devicePixelRatio || 1;
  const w = canvas.clientWidth, h = canvas.clientHeight;
  canvas.width = w*dpr; canvas.height = h*dpr;
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,w,h);
  return {ctx,w,h};
}
function niceStep(range, target=5) {
  if (range <= 0) return 1;
  const raw = range/target, mag = Math.pow(10, Math.floor(Math.log10(raw))), n = raw/mag;
  return (n<1.5?1:n<3.5?2:n<7.5?5:10) * mag;
}
function plotRect(w, h, axes=true) {
  if (!axes) return {x:0,y:0,w,h};
  return {x:48, y:20, w:Math.max(10, w-56), h:Math.max(10, h-52)};
}
function autoRange(arrays, pad=0.10) {
  let lo=Infinity, hi=-Infinity;
  for (const arr of arrays) { if (!arr) continue; for (const v of arr) if (isFinite(v)) { if(v<lo)lo=v; if(v>hi)hi=v; } }
  if (!isFinite(lo) || lo===hi) { lo-=1; hi+=1; }
  const p=(hi-lo)*pad; return [lo-p, hi+p];
}
function drawAxes(ctx, pr, lo, hi, n, dt, i_fc, yLabel, xLabel) {
  ctx.strokeStyle='#3a4452'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(pr.x, pr.y); ctx.lineTo(pr.x, pr.y+pr.h); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pr.x, pr.y+pr.h); ctx.lineTo(pr.x+pr.w, pr.y+pr.h); ctx.stroke();
  ctx.font='10px system-ui';
  const yStep = niceStep(hi-lo, 4);
  const yStart = Math.ceil(lo/yStep)*yStep;
  ctx.textAlign='right'; ctx.textBaseline='middle';
  for (let v=yStart; v<=hi+yStep*0.01; v+=yStep) {
    const y = pr.y + pr.h - (v-lo)/(hi-lo)*pr.h;
    ctx.strokeStyle='#252d3a'; ctx.beginPath(); ctx.moveTo(pr.x, y); ctx.lineTo(pr.x+pr.w, y); ctx.stroke();
    const lbl = yStep<0.1?v.toFixed(2):yStep<1?v.toFixed(1):Math.round(v);
    ctx.fillStyle = Math.abs(v)<1e-6 ? '#5bd3ff' : '#a9b4c2';
    ctx.fillText(lbl, pr.x-5, y);
  }
  if (dt && i_fc != null) {
    const t0 = -i_fc*dt, t1 = (n-1-i_fc)*dt;
    const xStep = niceStep(t1-t0, 6);
    const tStart = Math.ceil(t0/xStep)*xStep;
    ctx.textAlign='center'; ctx.textBaseline='top';
    for (let t=tStart; t<=t1+xStep*0.01; t+=xStep) {
      const frac = (t-t0)/(t1-t0);
      const x = pr.x + frac*pr.w;
      ctx.strokeStyle='#3a4452'; ctx.beginPath(); ctx.moveTo(x, pr.y+pr.h); ctx.lineTo(x, pr.y+pr.h+3); ctx.stroke();
      ctx.fillStyle = Math.abs(t)<0.01 ? '#5bd3ff' : '#a9b4c2';
      ctx.fillText(Math.abs(t)<1e-6?'0':t.toFixed(1), x, pr.y+pr.h+5);
    }
  }
  if (yLabel) { ctx.save(); ctx.translate(10, pr.y+pr.h/2); ctx.rotate(-Math.PI/2); ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(yLabel, 0, 0); ctx.restore(); }
  if (xLabel) { ctx.fillStyle='#7d8898'; ctx.textAlign='right'; ctx.textBaseline='bottom'; ctx.fillText(xLabel, pr.x+pr.w, pr.y+pr.h+28); }
}
function drawEvents(ctx, pr, n, ev) {
  const lines = [
    {i: ev.i_kl_peak, c:'#7d8898', l:'KL'},
    {i: ev.i_fc,      c:'#3b82f6', l:'FC'},
    {i: ev.i_mer,     c:'#f5c542', l:'MER'},
    {i: ev.i_br,      c:'#ff4d4d', l:'BR'},
  ];
  ctx.setLineDash([3,3]); ctx.lineWidth=1; ctx.font='9px system-ui';
  for (const {i, c, l} of lines) {
    if (i==null) continue;
    const x = pr.x + i/(n-1)*pr.w;
    ctx.strokeStyle=c; ctx.beginPath(); ctx.moveTo(x, pr.y); ctx.lineTo(x, pr.y+pr.h); ctx.stroke();
    ctx.fillStyle=c; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillText(l, x, pr.y-14);
  }
  ctx.setLineDash([]);
}
function drawLine(ctx, pr, arr, color, lo, hi, width) {
  ctx.strokeStyle=color; ctx.lineWidth=width||1.6; ctx.lineJoin='round'; ctx.beginPath();
  let first=true;
  for (let i=0; i<arr.length; i++) {
    const v = arr[i]; if (!isFinite(v)) { first=true; continue; }   // gap → break line (마스킹 구간)
    const x = pr.x + i/(arr.length-1)*pr.w, y = pr.y + pr.h - (v-lo)/(hi-lo)*pr.h;
    if (first) { ctx.moveTo(x,y); first=false; } else ctx.lineTo(x,y);
  }
  ctx.stroke();
}
function _cmpBfor(trial){ return (typeof window!=='undefined' && window._cmpB && window._cmpB!==trial) ? window._cmpB : null; }
function _bArrFor(B, l){ if (l.bArr) return l.bArr(B); if (l.arr && l.arr._mask){ var m=l.arr._mask; return _maskSeries(B, m.key, m.fromEv, m.toEv, m.tf); } if (l.key) return B.series[l.key]; return null; }
function _bRangeArrays(trial, lines){ var B=_cmpBfor(trial); return B?lines.map(function(l){return _bArrFor(B,l);}).filter(Boolean):[]; }
function _drawCmpB(ctx, pr, trial, lines, refDt, evFcAdj, visN, lo, hi){
  var B=_cmpBfor(trial); if(!B) return; var bfc=(B.events.i_fc||0), bdt=(B.meta.dt||refDt);
  ctx.save(); ctx.setLineDash([4,3]); ctx.globalAlpha=0.5;
  for(var li=0; li<lines.length; li++){ var a=_bArrFor(B, lines[li]); if(!a)continue; ctx.strokeStyle=lines[li].color; ctx.lineWidth=lines[li].width||1.6; ctx.beginPath(); var first=true;
    for(var bi=0;bi<a.length;bi++){ var v=a[bi]; if(!isFinite(v)){first=true;continue;} var t=(bi-bfc)*bdt; var j=evFcAdj+t/refDt; if(j<0||j>visN-1){first=true;continue;} var x=pr.x+j/(visN-1)*pr.w, y=pr.y+pr.h-(v-lo)/(hi-lo)*pr.h; if(first){ctx.moveTo(x,y);first=false;}else ctx.lineTo(x,y); } ctx.stroke(); }
  ctx.restore();
}
// 이벤트 구간 마스킹: fromEv~toEv(절대 frame) 밖은 NaN. tf 있으면 값 변환(부호 등).
function _maskSeries(trial, key, fromEv, toEv, tf) {
  const a = trial.series[key]; if (!a) return null;
  const ev = trial.events;
  const f = fromEv ? (ev[fromEv] ?? 0) : 0;
  const t = toEv ? (ev[toEv] ?? a.length-1) : a.length-1;
  const out = a.map((v, i) => (i>=f && i<=t && isFinite(v)) ? (tf ? tf(v) : v) : NaN);
  out._mask = { key: key, fromEv: fromEv || null, toEv: toEv || null, tf: tf || null };
  return out;
}
// 이벤트별 수치 표 (접이식 카드)
function _evIdx(trial){ const e=trial.events; return [['KL',e.i_kl_peak],['FC',e.i_fc],['MER',e.i_mer],['BR',e.i_br]]; }
function _evCard(trial, colTitle, rows){
  const cols=_evIdx(trial);
  const head=cols.map(c=>`<th>${c[0]}</th>`).join('');
  const body=rows.map(r=>{
    const a=r.arr||trial.series[r.key];
    const cells=cols.map(c=>{ let v=(a&&c[1]!=null&&c[1]<a.length)?a[c[1]]:null; if(v!=null&&isFinite(v)&&r.tf)v=r.tf(v);
      return `<td>${(v==null||!isFinite(v))?'—':fmt1(v)}${(v!=null&&isFinite(v)&&r.unit)?`<span class="evu">${r.unit}</span>`:''}</td>`; }).join('');
    return `<tr><td class="evl">${r.label}</td>${cells}</tr>`;
  }).join('');
  return `<details class="ev-card"><summary>이벤트별 수치 (KL · FC · MER · BR)</summary>
    <table class="ev-table"><thead><tr><th class="evl">${colTitle}</th>${head}</tr></thead><tbody>${body}</tbody></table></details>`;
}
function drawCursor(ctx, pr, n, frame) {
  if (frame == null || n < 2) return;
  try{ if (typeof _gtFocus!=='undefined' && _gtFocus && typeof _gtActiveWin==='function'){
    var _cf=(typeof _currentFrame!=='undefined'?_currentFrame:0), _i0=_cf-frame, _aw=_gtActiveWin(_cf);
    if(_aw){ var _a0=pr.x+Math.max(0,Math.min(n-1,_aw[0]-_i0))/(n-1)*pr.w, _a1=pr.x+Math.max(0,Math.min(n-1,_aw[1]-_i0))/(n-1)*pr.w;
      ctx.save();
      ctx.fillStyle='rgba(255,255,255,.045)'; ctx.fillRect(_a0,pr.y,_a1-_a0,pr.h);
      ctx.fillStyle='rgba(14,18,24,.5)'; ctx.fillRect(pr.x,pr.y,Math.max(0,_a0-pr.x),pr.h); ctx.fillRect(_a1,pr.y,Math.max(0,pr.x+pr.w-_a1),pr.h);
      ctx.strokeStyle='rgba(63,134,207,.55)'; ctx.setLineDash([3,3]); ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(_a0,pr.y); ctx.lineTo(_a0,pr.y+pr.h); ctx.moveTo(_a1,pr.y); ctx.lineTo(_a1,pr.y+pr.h); ctx.stroke();
      ctx.restore();
    }
  } }catch(e){}
  const x = pr.x + Math.max(0, Math.min(n-1, frame))/(n-1)*pr.w;
  ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 1.4;
  ctx.beginPath(); ctx.moveTo(x, pr.y); ctx.lineTo(x, pr.y+pr.h); ctx.stroke();
}
function plot(canvasId, trial, lines, yLabel, opts) {
  const canvas = document.getElementById(canvasId); if (!canvas) return;
  const {ctx, w, h} = clearC(canvas);
  const rawArrays = lines.map(l => l.arr || trial.series[l.key]);
  if (!rawArrays.some(Boolean)) { ctx.fillStyle='#7d8898'; ctx.fillText('— no data —', w/2, h/2); return; }
  // v0.17: 가로축을 MaxKneeHeight(KL) 직전(−0.1s)부터 표시
  const dt = trial.meta.dt;
  const i0 = Math.max(0, (trial.events.i_kl_peak||0) - Math.round(0.1/dt));
  const arrays = rawArrays.map(a => a ? a.slice(i0) : null);
  const visN = trial.meta.n_frames - i0;
  const evAdj = {}; for (const k in trial.events) { const v = trial.events[k]; evAdj[k] = (typeof v==='number') ? v-i0 : v; }
  const [lo, hi] = autoRange(arrays.filter(Boolean).concat(_bRangeArrays(trial, lines)));
  const pr = plotRect(w, h, true);
  drawAxes(ctx, pr, lo, hi, visN, dt, evAdj.i_fc, yLabel, 'time from FC (s)');
  drawEvents(ctx, pr, visN, evAdj);
  // [2026-05-27] X-Factor 최대(분리 풀림 시작) 시점 마커 — 키네매틱 시퀀스 그래프에 분리 풀림 타이밍을 함께 표시.
  if (opts && opts.xfPeakFrame != null) {
    var _xi = opts.xfPeakFrame - i0;
    if (_xi >= 0 && _xi < visN) {
      var _xx = pr.x + _xi/(visN-1)*pr.w;
      ctx.save(); ctx.setLineDash([5,3]); ctx.strokeStyle='#c084fc'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(_xx, pr.y); ctx.lineTo(_xx, pr.y+pr.h); ctx.stroke();
      ctx.setLineDash([]); ctx.fillStyle='#c084fc'; ctx.font='9px system-ui'; ctx.textAlign='center'; ctx.textBaseline='bottom';
      ctx.fillText('X-Factor 최대(풀림 시작)', _xx, pr.y+pr.h-2);
      ctx.restore();
    }
  }
  if (lines.length > 1) {
    ctx.font='10px system-ui'; let lx = pr.x+10, ly = pr.y + 6;
    for (const l of lines) {
      ctx.fillStyle = l.color; ctx.fillRect(lx, ly, 10, 3);
      ctx.fillStyle = '#a9b4c2'; ctx.textAlign='left'; ctx.textBaseline='top';
      ctx.fillText(l.label || l.key, lx+14, ly-2);
      lx += ctx.measureText(l.label || l.key).width + 32;
    }
  }
  for (let i=0; i<lines.length; i++) {
    if (arrays[i]) drawLine(ctx, pr, arrays[i], lines[i].color, lo, hi, lines[i].width);
  }
  _drawCmpB(ctx, pr, trial, lines, dt, (evAdj.i_fc||0), visN, lo, hi);
  drawCursor(ctx, pr, visN, _currentFrame - i0);
}
// ── 스트라이드 구간(KL~FC)만 확대해 그리는 플롯 (뒷발 자유모멘트 등) ──
// plot() 과 동일 스타일이나 x축을 스트라이드 윈도우로 줌. FC 직후 약간(0.03s)만 tail 표시.
function plotStride(canvasId, trial, lines, yLabel) {
  const canvas = document.getElementById(canvasId); if (!canvas) return;
  const {ctx, w, h} = clearC(canvas);
  const ev = trial.events, dt = trial.meta.dt;
  const kl = ev.i_kl_peak, fc = ev.i_fc;
  if (kl == null || fc == null || fc <= kl) {
    ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('— 스트라이드 이벤트 없음 —', w/2, h/2); return;
  }
  const tail = Math.round(0.03 / dt);
  const from = Math.max(0, kl);
  const to   = Math.min(trial.meta.n_frames - 1, fc + tail);
  const rawArrays = lines.map(l => l.arr || trial.series[l.key]);
  if (!rawArrays.some(Boolean)) { ctx.fillStyle='#7d8898'; ctx.textAlign='center'; ctx.fillText('— no data —', w/2, h/2); return; }
  const arrays = rawArrays.map(a => a ? a.slice(from, to + 1) : null);
  const visN = to - from + 1;
  const evAdj = { i_kl_peak: kl - from, i_fc: fc - from };
  const [lo, hi] = autoRange(arrays.filter(Boolean).concat(_bRangeArrays(trial, lines)));
  const pr = plotRect(w, h, true);
  drawAxes(ctx, pr, lo, hi, visN, dt, evAdj.i_fc, yLabel, 'time from FC (s)');
  drawEvents(ctx, pr, visN, evAdj);
  if (lines.length >= 1) {
    ctx.font='10px system-ui'; let lx = pr.x + 10, ly = pr.y + 6;
    for (const l of lines) {
      ctx.fillStyle = l.color; ctx.fillRect(lx, ly, 10, 3);
      ctx.fillStyle = '#a9b4c2'; ctx.textAlign='left'; ctx.textBaseline='top';
      ctx.fillText(l.label || l.key, lx + 14, ly - 2);
      lx += ctx.measureText(l.label || l.key).width + 32;
    }
  }
  for (let i = 0; i < lines.length; i++) {
    if (arrays[i]) drawLine(ctx, pr, arrays[i], lines[i].color, lo, hi, lines[i].width);
  }
  _drawCmpB(ctx, pr, trial, lines, dt, (evAdj.i_fc||0), visN, lo, hi);
  drawCursor(ctx, pr, visN, _currentFrame - from);
}
function plotXF(trial) {
  const canvas = document.getElementById('ch-xf'); if (!canvas) return;
  const {ctx, w, h} = clearC(canvas);
  const xfRaw = trial.x_factor;
  if (!xfRaw || !xfRaw.length) return;
  const dt = trial.meta.dt;
  const i0 = Math.max(0, (trial.events.i_kl_peak||0) - Math.round(0.1/dt));
  const xf = xfRaw.slice(i0);
  const visN = trial.meta.n_frames - i0;
  const evAdj = {}; for (const k in trial.events) { const v = trial.events[k]; evAdj[k] = (typeof v==='number') ? v-i0 : v; }
  const xfLines = [{ color:'#5bd3ff', width:1.6, bArr:function(B){ return B.x_factor; } }];
  const [lo, hi] = autoRange([xf].concat(_bRangeArrays(trial, xfLines)));
  const pr = plotRect(w, h, true);
  drawAxes(ctx, pr, lo, hi, visN, dt, evAdj.i_fc, 'X-Factor (°)', 'time from FC (s)');
  drawEvents(ctx, pr, visN, evAdj);
  drawLine(ctx, pr, xf, '#5bd3ff', lo, hi);
  _drawCmpB(ctx, pr, trial, xfLines, dt, (evAdj.i_fc||0), visN, lo, hi);
  drawCursor(ctx, pr, visN, _currentFrame - i0);
}

