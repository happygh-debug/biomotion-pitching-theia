// 메카닉 모델별 간단 자가 연습법 (선수 단독 수행 가능)
const MODEL_SELF = {
  arm_action:'리버스 스로우 — 착지 후 거꾸로 던지며 팔을 끝까지 뒤로 (외회전·스캡로드 학습)',
  posture:'허샤이저 드릴 — 골반은 닫고 어깨만 더 여는 느낌으로 분리 키우기',
  rotation:'메드볼 사이드 토스 — 발→골반→몸통→팔 순서로 폭발적 회전',
  block:'편측 스쿼트/런지 5초 버티기 — 앞다리 무릎으로 제동력 강화',
  cog:'슬라이드 스텝 — 와인드업 없이 체중을 앞발로 빠르게 이동',
};
function mechPhaseSummary(){
  const ph = (typeof DATA!=='undefined' && DATA.phases) ? DATA.phases : {};
  const st = (ph.stages||[]).filter(s=>s.score!=null);
  if(!st.length) return {composite:null, strong:null, weak:null};
  const composite = Math.round(st.reduce((a,s)=>a+s.score,0)/st.length);
  const strong = st.reduce((a,s)=>s.score>a.score?s:a);
  const weak = st.reduce((a,s)=>s.score<a.score?s:a);
  const clean = l => (l||'').replace(/^\d+\.\s*/,'');
  return {composite, strong:{label:clean(strong.label),score:strong.score}, weak:{label:clean(weak.label),score:weak.score}};
}
// 체크포인트 → 탭/그래프(시계열) 또는 시각화 이동
var CP_NAV = {
  merPk:['arm','ch-sher'], xfPeak:['trunk','ch-pelvis'], xfPeakFromFC:['trunk','ch-pelvis'], xfUnwindV:['trunk','ch-pelvis'], xfReleasedPctByFC:['trunk','ch-pelvis'], xfAtFC:['trunk','ch-pelvis'], pelClose:['trunk','ch-pelvis'], freeMo:['grf','ch-fp1-xyz'], hipHinge:['lower','ch-hip'],
  openAng:['trunk','ch-pelvis'], leanBack:['trunk','ch-twrt'],
  rearProp:['grf','ch-fp1-xyz'], propImpPct:['grf','ch-fp1-xyz'], comVel:['energy','ch-e4'], hipAbd:['lower','ch-hip'], grfDelay:['grf','ch-grf-z'],
  leadGrf:['grf','ch-grf-z'], comDecel:['grf','ch-fp2-xyz'], kneeAbs:['energy','ch-e2'],
  kneeCollapse:['lower','ch-knee'], kneeExtE:['energy','ch-e2'], trunkFlexV:['trunk','ch-twrt'], trunkME:['energy','ch-e5'], torsoRotV:['trunk','ch-trunk'],
  armRotV:['arm','ch-sher'], humME:['energy','ch-e5'], elbowExtV:['arm','ch-elb'], elbowP:['energy','ch-e3'],
  shGen:['energy','ch-e3'], elbAbs:['energy','ch-e3'], humMEt:['energy','ch-e5']
};
// 비시계열(동작 일관성) → 시각화 이동
var CONS_NAV = {
  relTimingMs:['ph-consistency',''], armSlot:['ph-consistency',''], strideLen:['ph-consistency',''], grfDelay:['ph-consistency',''], seqSpan:['ph-consistency',''], _null:['ph-consistency','']
};
if (typeof window!=='undefined') window._goCp = function(tab, anchor){
  try { if (typeof setPage==='function') setPage(tab); } catch(e){}
  if (anchor){ setTimeout(function(){ var el=document.getElementById(anchor); if(el&&el.scrollIntoView) el.scrollIntoView({behavior:'smooth',block:'center'}); }, 140); }
};
// ── 변인 상세 화면용 시계열 매핑 (key → 해당 변인의 기저 시계열) ──
function _bmRHP(){ return ((typeof DATA!=='undefined'&&DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L'; }
// [2026-05-26] 손목 굴곡/요측편향 — 전완(팔꿈치→손목)·손끝·상완 마커로 산출. 상완평면 내=굴곡, 평면수직=요/척측. 직접 운동학(추정 아님).
function _wristSer(t,which){
  var fr=t&&t.frames; if(!fr) return null;
  var R=_bmRHP(), pre=R?'r':'l', sh=pre+'_shoulder', el=pre+'_elbow', wr=pre+'_wrist', ht=pre+'_hand_tip';
  function sub(a,b){return[a[0]-b[0],a[1]-b[1],a[2]-b[2]];}
  function dot(a,b){return a[0]*b[0]+a[1]*b[1]+a[2]*b[2];}
  function nrm(a){var m=Math.sqrt(dot(a,a))||1;return[a[0]/m,a[1]/m,a[2]/m];}
  function crs(a,b){return[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];}
  var out=new Array(fr.length);
  for(var i=0;i<fr.length;i++){ var f=fr[i]; if(!f){out[i]=NaN;continue;}
    var S=f[sh],E=f[el],W=f[wr],H=f[ht];
    if(!S||!E||!W||!H){out[i]=NaN;continue;}
    var u=nrm(sub(W,E));                       // 전완 방향
    var w=sub(E,S);                            // 상완 방향
    var efl=sub(w,[u[0]*dot(w,u),u[1]*dot(w,u),u[2]*dot(w,u)]); efl=nrm(efl);  // 굴곡 기준축(전완⊥)
    var erad=nrm(crs(u,efl));                  // 요/척 축
    var v=sub(H,W);                            // 손 방향
    var along=dot(v,u);
    out[i]=(which==='flex')? Math.atan2(dot(v,efl),along)*180/Math.PI : Math.atan2(dot(v,erad),along)*180/Math.PI;
  }
  return out;
}
// 3축 결과(resultant) 크기 시계열 — 모멘트·관절력은 √(X²+Y²+Z²) per frame. (scalars의 _resultPk와 동일 정의)
function _resSer(t,pre){ var S=t.series||{}, x=S[pre+'_X'],y=S[pre+'_Y'],z=S[pre+'_Z']; if(!x)return null; var o=new Array(x.length); for(var i=0;i<x.length;i++){ var vx=x[i],vy=y?y[i]:0,vz=z?z[i]:0; o[i]=isFinite(vx)?Math.sqrt(vx*vx+(isFinite(vy)?vy*vy:0)+(isFinite(vz)?vz*vz:0)):NaN; } return o; }
// ── [2026-05-26] ⑧ 좌우 밸런스 변인의 프레임별 시계열 (frames 위치 기반, phases._balOf와 동일 기하). FC순간 자세값을 전 구간에서 추적. ──
function _balTHGL(t){ var ts=((t.throw_side||(t.meta&&t.meta.handedness)||'').toString().charAt(0).toLowerCase()); var TH=(ts==='l')?'l':((ts==='r')?'r':(_bmRHP()?'r':'l')); return {TH:TH,GL:(TH==='r')?'l':'r'}; }
function _balSer(t,key){
  var fr=t.frames; if(!fr||!fr.length) return null;
  var g=_balTHGL(t), TH=g.TH, GL=g.GL, dt=(t.setup&&t.setup.dt)||(t.meta&&t.meta.dt)||0.004;
  function sub(a,b){return[a[0]-b[0],a[1]-b[1],a[2]-b[2]];}
  function nm2(a){return Math.sqrt(a[0]*a[0]+a[1]*a[1]+a[2]*a[2]);}
  function ang(u,w){var d=(u[0]*w[0]+u[1]*w[1]+u[2]*w[2])/(nm2(u)*nm2(w)||1);return Math.acos(Math.max(-1,Math.min(1,d)))*180/Math.PI;}
  function asym(a,b){return (a!=null&&b!=null&&(Math.abs(a)+Math.abs(b))>1e-6)?((a-b)/(Math.abs(a)+Math.abs(b))*100):null;}
  var down=[0,-1,0], out=new Array(fr.length), prevTh=null;
  for(var i=0;i<fr.length;i++){
    var f=fr[i]; if(!f){ out[i]=NaN; prevTh=null; continue; }
    var gS=f[GL+'_shoulder'],gE=f[GL+'_elbow'],gW=f[GL+'_wrist'],tS=f[TH+'_shoulder'],tE=f[TH+'_elbow'],tW=f[TH+'_wrist'],pel=f.pelvis_o,nk=f.neck,lh=f.l_hip,rh=f.r_hip;
    var lHip=f[GL+'_hip'],lKn=f[GL+'_knee'],lHe=f[GL+'_heel'],bHip=f[TH+'_hip'],bKn=f[TH+'_knee'],bHe=f[TH+'_heel'];
    var v=NaN;
    if(key==='glovePullV'){ if(gS&&gE){ var u=sub(gE,gS); var th=Math.atan2(u[2],u[0])*180/Math.PI; if(prevTh!=null){ var d=Math.abs(th-prevTh); if(d>180)d=360-d; v=d/dt; } prevTh=th; } else prevTh=null; out[i]=v; continue; }
    prevTh=null;
    if(key==='gAbd'){ if(gS&&gE)v=ang(sub(gE,gS),down); }
    else if(key==='tAbd'){ if(tS&&tE)v=ang(sub(tE,tS),down); }                 /* [2026-05-26] 투구팔 외전(양팔 오버레이용) */
    else if(key==='gElbFlex'){ if(gS&&gE&&gW)v=180-ang(sub(gS,gE),sub(gW,gE)); }
    else if(key==='tElbFlex'){ if(tS&&tE&&tW)v=180-ang(sub(tS,tE),sub(tW,tE)); } /* [2026-05-26] 투구팔 팔꿈치 굴곡(양팔 오버레이용) */
    else if(key==='gHandH'){ if(gW&&gS)v=gW[1]-gS[1]; }
    else if(key==='counterAP'){ if(gS&&tS)v=gS[2]-tS[2]; }
    else if(key==='shTilt'){ if(gS&&tS){ var sl=sub(gS,tS); v=Math.atan2(sl[1],Math.hypot(sl[0],sl[2]))*180/Math.PI; } }
    else if(key==='abdSym'){ if(gS&&gE&&tS&&tE)v=ang(sub(tE,tS),down)-ang(sub(gE,gS),down); }
    else if(key==='shAbdAsym'){ if(gS&&gE&&tS&&tE)v=asym(ang(sub(tE,tS),down),ang(sub(gE,gS),down)); }
    else if(key==='leadKneeFlex'){ if(lHip&&lKn&&lHe)v=180-ang(sub(lHip,lKn),sub(lHe,lKn)); }
    else if(key==='backKneeFlex'){ if(bHip&&bKn&&bHe)v=180-ang(sub(bHip,bKn),sub(bHe,bKn)); }
    else if(key==='kneeFlexSym'){ if(lHip&&lKn&&lHe&&bHip&&bKn&&bHe)v=asym(180-ang(sub(lHip,lKn),sub(lHe,lKn)),180-ang(sub(bHip,bKn),sub(bHe,bKn))); }
    else if(key==='elbowFlexAsym'){ if(gS&&gE&&gW&&tS&&tE&&tW)v=asym(180-ang(sub(tS,tE),sub(tW,tE)),180-ang(sub(gS,gE),sub(gW,gE))); }
    else if(key==='trunkLat'){ if(nk&&pel){ var tl=sub(nk,pel); v=Math.atan2(tl[0],tl[1])*180/Math.PI; } }
    else if(key==='pelObliq'){ if(lh&&rh){ var po=sub(lh,rh); v=Math.atan2(po[1],Math.hypot(po[0],po[2]))*180/Math.PI; } }
    out[i]=(v==null?NaN:v);
  }
  return out;
}
