  var fast=(typeof _fastTrial==='function')?_fastTrial():null, slow=(typeof _slowTrial==='function')?_slowTrial():null, mass=(DATA.player&&DATA.player.weight_kg)||86;
  var RHP=(((DATA.player&&DATA.player.handedness)||'R').toUpperCase()!=='L'), idx=(F.events&&F.events.idx)||{};
  var Wn={fast:fast,slow:slow,startEv:'i_kl_peak',startOff:-0.02,endEv:'i_br',endOff:0.03};  /* [2026-05-29] X-factor 윈도우 KH→BR */
  function ev(list){ return list.map(function(e){ return {label:e[0],frame:idx[e[0]],color:e[1],width:e[2],text:e[3]}; }).filter(function(e){return e.frame!=null;}); }
  // 변인별 차트(각 카드 아래) — ed-xf-1..7
  function _xfClose(t){var pz=t.series.Pelvis_Angle_Z;if(!pz)return null;var n=Math.min(15,(t.events.i_kl_peak||15)),s=0,c=0;for(var i=0;i<=n&&i<pz.length;i++){if(isFinite(pz[i])){s+=(RHP?pz[i]:-pz[i]);c++;}}var b=c?s/c:0;return pz.map(function(x){return isFinite(x)?((RHP?x:-x)-b):NaN;});}
  try{ var _xrsLbl=(F.releaseStartMs!=null)?('FC'+(F.releaseStartMs<0?'−':'+')+(Math.abs(F.releaseStartMs)/1000).toFixed(2)+'s'):'풀림 시작'; plotWin('ed-xf-1',Object.assign({left:{label:'분리각 (°)',lines:[{compute:function(t){return _xfSigned(t);},color:'#6db4e6',label:'X-factor 분리각',width:2.8}]},extraEvents:ev([['XRS','#46c98c',3.6,_xrsLbl]]).concat((fast&&fast.events&&fast.events.i_fc!=null)?[{label:'FC',frame:fast.events.i_fc,color:'#cfd6e0',width:1.6}]:[]),noBuiltinEv:true},Wn)); }catch(e){}
  try{ plotWin('ed-xf-2',Object.assign({left:{label:'각도 (°)',lines:[{compute:function(t){return _xfSigned(t);},color:'#c084fc',label:'X-factor 분리각',width:2.4},{compute:_xfClose,color:'#5bb6e6',label:'골반 닫힘',width:2.0}]},right:{label:'몸통 열림 속도 (°/s)',lines:[{compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5fa6c0',label:'몸통 열림 속도',width:1.8}]},extraEvents:ev([['MXF','#c084fc'],['XRS','#46c98c']])},Wn)); }catch(e){}
  try{ plotWin('ed-xf-3',Object.assign({left:{label:'풀림 속도 (°/s)',lines:[{compute:function(t){return _xfUncoil(t);},color:'#8ea9cf',label:'풀림 속도',width:2.4}]},extraEvents:ev([['XRS','#46c98c'],['XRPV','#8ea9cf']])},Wn)); }catch(e){}
  try{ plotWin('ed-xf-4',Object.assign({left:{label:'풀림 속도 (°/s)',lines:[{compute:function(t){return _xfUncoil(t);},color:'#8ea9cf',label:'풀림 속도',width:2.4}]},extraEvents:ev([['XRPV','#8ea9cf']])},Wn)); }catch(e){}
  try{ plotWin('ed-xf-5',Object.assign({left:{label:'풀림 속도 (°/s)',lines:[{compute:function(t){return _xfUncoil(t);},color:'#8ea9cf',label:'풀림 속도',width:2.4}]},right:{label:'앞발 수직 GRF (%BW)',lines:[{compute:function(t){var a=t.series.FP2_Z;return a?a.map(function(x){return Math.abs(x)/(mass*9.81)*100;}):null;},color:'#46c98c',label:'앞발 수직 GRF',width:2.2}]},extraEvents:ev([['XRS','#46c98c'],['PBG','#e8954e']])},Wn)); }catch(e){}
  try{ plotWin('ed-xf-6',Object.assign({left:{label:'풀림 속도 (°/s)',lines:[{compute:function(t){return _xfUncoil(t);},color:'#8ea9cf',label:'풀림 속도',width:2.4}]},right:{label:'몸통 분절 에너지 (J)',lines:[{compute:function(t){return t.series.Trunk_ME_X;},color:'#5bd3ff',label:'몸통 에너지',width:2.2}]},extraEvents:ev([['XRPV','#8ea9cf'],['TEP','#5bd3ff']])},Wn)); }catch(e){}
  try{ plotWin('ed-xf-7',Object.assign({left:{label:'열림 속도 (°/s)',lines:[{compute:function(t){var a=t.series.Thorax_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5fa6c0',label:'몸통 열림속도',width:2.2},{compute:function(t){var a=t.series.Pelvis_Ang_Vel_Z;return a?a.map(function(x){return Math.abs(x);}):null;},color:'#5bb6e6',label:'골반 열림속도',width:2.0}]},extraEvents:ev([['MXF','#c084fc']])},Wn)); }catch(e){}
